# Dependencies are vendored and committed (go mod vendor).
# No network needed after clone.

# Build artifacts
/bin/
/ze
/ze-*
/functional
# Ignore the scratch dir, but track the tmp/go.mod sentinel: it marks tmp/ as a
# nested module so `go list ./...` skips QEMU/Docker Go caches stored under tmp/
# (otherwise `make ze-verify` fails). See scripts/evidence/qemu-run.py.
tmp/*
!tmp/go.mod

# go test -c / benchmark binaries
*.test

# Installer chain build outputs (regenerated by `make -C tools/installer-*`)
tools/installer-initrd/build/
tools/installer-kernel/build/

# credentials database (generated by ze init)
database.zefs
etc/ze/database.zefs*

# MRT data files (large, downloaded)
test/internet/*.gz
test/internet/*.bz2
test/internet/*.tmp

# Research output (large generated files)
docs/research/comparison/
docs/research/ze-vpp-plan.md
*-inlined.html

# Coverage reports
coverage.out
coverage.html

# Mutation testing incremental cache (gomu hardcodes this cwd path)
.gomu_history.json

# Python
__pycache__/

# macOS
.DS_Store

# Obsidian
.obsidian/

# Claude session state (lives in tmp/session/, covered by tmp/ ignore)
# Legacy locations kept for transition period:
.claude/selected-spec
.claude/session-state.md
.claude/session-state-*.md
.claude/.session-*
.claude/.compaction-detected
.claude/.compaction-detected-*
.claude/scheduled_tasks.lock

# Generated AI tool config (canonical sources: ai/skills/, ai/INSTRUCTIONS.md)
# Regenerate with: make ze-ai-sync
CLAUDE.md
AGENTS.md
.claude/skills/
.codex/skills/
.agents/skills/

test/perf/results/
bin/ze-perf-linux

# Runtime / scratch artifacts that leak into the working tree from running ze
/stderr
/stdout
etc/ze/*.tmp
etc/ze/debug.zefs
internal/appliance/tools/installer-kernel/build/
