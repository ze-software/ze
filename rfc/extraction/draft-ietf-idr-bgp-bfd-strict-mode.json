    {
      "id": "4:1",
      "quote": "Optional Attribute Status: If BfdEnabled is FALSE, this event MUST NOT occur.",
      "disposition": "mapped",
      "mapped-to": "DRAFT-IETF-IDR-BGP-BFD-STRICT-MODE-4-1"
    },
    {
      "id": "6:1",
      "quote": "A BGP speaker which supports capabilities advertisement and has BFD strict-mode enabled MUST include the BFD Strict-Mode Capability in its OPEN message.",
      "disposition": "mapped",
      "mapped-to": "DRAFT-IETF-IDR-BGP-BFD-STRICT-MODE-6-1"
    },
    {
      "id": "10:1",
      "quote": "To avoid deadlock when utilizing both BFD hold-down and BFD strict- mode, when strict-mode is enabled for a peer, the BGP FSM MUST be enabled.",
      "disposition": "mapped",
      "mapped-to": "DRAFT-IETF-IDR-BGP-BFD-STRICT-MODE-10-1"
    },
    {
      "id": "10:2",
      "quote": "That is, BFD hold-down procedures MUST NOT prevent BGP from establishing a connection with the remote BGP speaker.",
      "disposition": "mapped",
      "mapped-to": "DRAFT-IETF-IDR-BGP-BFD-STRICT-MODE-10-2"
    }
