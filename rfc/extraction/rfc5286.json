  "sites": [
    {
      "id": "3.1:1",
      "quote": "Alternate next hops used by implementations following this specification MUST conform to at least the loop-freeness condition stated above in Inequality 1.",
      "disposition": "mapped",
      "mapped-to": "RFC5286-x-1"
    },
    {
      "id": "3.5:1",
      "quote": "For computing an alternate, a router MUST NOT use an alternate next- hop that is along a link whose cost or reverse cost is LSInfinity (for OSPF) or the maximum cost (for IS-IS) or that has the overload bit set (for IS-IS).",
      "disposition": "mapped",
      "mapped-to": "RFC5286-x-2"
    },
    {
      "id": "3.5:2",
      "quote": "In the case of OSPF, if all links from router S to a neighbor N_i have a reverse cost of LSInfinity, then router S MUST NOT use N_i as an alternate.",
      "disposition": "mapped",
      "mapped-to": "RFC5286-x-3"
    },
    {
      "id": "3.5:3",
      "quote": "Similarly in the case of IS-IS, if N_i has the overload bit set, then S MUST NOT consider using N_i as an alternate.",
      "disposition": "mapped",
      "mapped-to": "RFC5286-x-4"
    },
    {
      "id": "4:1",
      "quote": "The alternate next-hop MUST be used only for traffic types that are routed according to the shortest path.",
      "disposition": "mapped",
      "mapped-to": "RFC5286-x-5"
    },
    {
      "id": "4.1:1",
      "quote": "A router MUST limit the amount of time an alternate next-hop is used after the primary next-hop has become unavailable.",
      "disposition": "mapped",
      "mapped-to": "RFC5286-x-6"
    }
  ]
}
