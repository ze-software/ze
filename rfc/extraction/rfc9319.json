  "sites": [
    {
      "id": "5:1",
      "quote": "Operators that implement these recommendations and have existing ROAs published in the RPKI system MUST perform a review of such objects, especially where they make use of the maxLength attribute, to ensure that the set of included prefixes is \"minimal\" with respect to the current BGP origination and routing policies.",
      "disposition": "mapped",
      "mapped-to": "RFC9319-5-1"
    },
    {
      "id": "5:2",
      "quote": "Published ROAs MUST be replaced as necessary.",
      "disposition": "mapped",
      "mapped-to": "RFC9319-5-2"
    },
    {
      "id": "5:3",
      "quote": "Such an exercise MUST be repeated whenever the operator makes changes to either policy.",
      "disposition": "mapped",
      "mapped-to": "RFC9319-5-3"
    },
    {
      "id": "6:1",
      "quote": "* Operators providing a means for operators of neighboring autonomous systems to advertise RTDR routes via BGP MUST NOT make the creation of non-minimal ROAs a pre-requisite for its use.",
      "disposition": "mapped",
      "mapped-to": "RFC9319-6-1"
    }
  ]
