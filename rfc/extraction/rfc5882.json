  "sites": [
    {
      "id": "4.1:1",
      "quote": "If the session state on either the local or remote system (if known) is AdminDown, BFD has been administratively disabled, and the establishment of a control protocol adjacency MUST be allowed.",
      "disposition": "mapped",
      "mapped-to": "RFC5882-4.1-1"
    },
    {
      "id": "4.4:1",
      "quote": "If multiple control protocols wish to establish BFD sessions with the same remote system for the same data protocol, all MUST share a single BFD session.",
      "disposition": "mapped",
      "mapped-to": "RFC5882-4.4-1"
    },
    {
      "id": "10.1.3:1",
      "quote": "If it is desired to use BFD for failure detection of OSPF Virtual Links, the mechanism described in [BFD-MULTI] MUST be used, since OSPF Virtual Links may traverse an arbitrary number of hops.",
      "disposition": "mapped",
      "mapped-to": "RFC5882-10.1.3-1"
    }
  ]
