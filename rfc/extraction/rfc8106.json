  "sites": [
    {
      "id": "1.2:1",
      "quote": "Hosts conforming to this specification MUST extract DNS information from RA messages, unless static DNS configuration has been specified by the user.",
      "disposition": "mapped",
      "mapped-to": "RFC8106-1.2-1"
    },
    {
      "id": "1.2:2",
      "quote": "If there is DNS information available from multiple RAs and/or from DHCP, the host MUST maintain an ordered list of this information as specified in Section 5.3.1.",
      "disposition": "mapped",
      "mapped-to": "RFC8106-1.2-2"
    },
    {
      "id": "5.1:1",
      "quote": "A value of zero means that the RDNSS addresses MUST no longer be used.",
      "disposition": "mapped",
      "mapped-to": "RFC8106-5.1-1"
    },
    {
      "id": "5.1:2",
      "quote": "When a resolver sends a DNS query message to an RDNSS identified by a link-local address, it MUST use the corresponding link.",
      "disposition": "mapped",
      "mapped-to": "RFC8106-5.1-2"
    },
    {
      "id": "5.2:1",
      "quote": "A value of zero means that the DNSSL domain names MUST no longer be used.",
      "disposition": "mapped",
      "mapped-to": "RFC8106-5.2-1"
    },
    {
      "id": "5.2:2",
      "quote": "Domain Names of DNS Search List One or more domain names of the DNSSL that MUST be encoded as described in Section 3.1 of [RFC1035].",
      "disposition": "mapped",
      "mapped-to": "RFC8106-5.2-2"
    },
    {
      "id": "5.2:3",
      "quote": "Note that for the simple decoding, the domain names MUST NOT be encoded in the compressed form described in Section 4.1.4 of [RFC1035].",
      "disposition": "mapped",
      "mapped-to": "RFC8106-5.2-3"
    },
    {
      "id": "5.2:4",
      "quote": "Because the size of this field MUST be a multiple of 8 octets, for the minimum multiple including the domain name representations, the remaining octets other than the encoding parts of the domain name representations MUST be padded with zeros.",
      "disposition": "mapped",
      "mapped-to": "RFC8106-5.2-4"
    },
    {
      "id": "5.3.1:1",
      "quote": "Otherwise, the host MUST discard the options.",
      "disposition": "mapped",
      "mapped-to": "RFC8106-5.3.1-1"
    },
    {
      "id": "5.3.1:2",
      "quote": "On the other hand, for DNS options announced by RAs, if some RAs use the Secure Neighbor Discovery (SEND) protocol [RFC3971] for RA security, they MUST be preferred over those that do not use SEND.",
      "disposition": "mapped",
      "mapped-to": "RFC8106-5.3.1-2"
    },
    {
      "id": "5.3.1:3",
      "quote": "Also, DNS options announced by RAs via SEND MUST be preferred over those announced by unauthenticated DHCP [RFC3118].",
      "disposition": "mapped",
      "mapped-to": "RFC8106-5.3.1-3"
    }
  ]
}
