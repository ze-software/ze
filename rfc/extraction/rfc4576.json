  "sites": [
    {
      "id": "4:1",
      "quote": "When a type 3, 5, or 7 LSA is sent from a PE to a CE, the DN bit MUST be set.",
      "disposition": "mapped",
      "mapped-to": "RFC4576-4-1"
    },
    {
      "id": "4:2",
      "quote": "The DN bit MUST be clear in all other LSA types. +-------------------------------------+ | DN | * | DC | EA | N/P | MC | E | * | +-------------------------------------+",
      "disposition": "mapped",
      "mapped-to": "RFC4576-4-2"
    },
    {
      "id": "4:3",
      "quote": "When the PE receives, from a CE router, a type 3, 5, or 7 LSA with the DN bit set, the information from that LSA MUST NOT be used during the OSPF route calculation.",
      "disposition": "mapped",
      "mapped-to": "RFC4576-4-4"
    },
    {
      "id": "4:4",
      "quote": "The DN bit MUST be ignored in all other LSA types.",
      "disposition": "mapped",
      "mapped-to": "RFC4576-4-3"
    }
  ]
