  "sites": [
    {
      "id": "2:1",
      "quote": "All servers and clients who are fully NTPv4-compliant MUST implement the entire suite of algorithms described in this document.",
      "disposition": "mapped",
      "mapped-to": "RFC5905-2-1"
    },
    {
      "id": "2:2",
      "quote": "Alternative algorithms MAY be used, but their output MUST be identical to the algorithms described in this specification.",
      "disposition": "mapped",
      "mapped-to": "RFC5905-2-2"
    },
    {
      "id": "7.4:1",
      "quote": "Recipients of kiss codes MUST inspect them and, in the following cases, take these actions:",
      "disposition": "mapped",
      "mapped-to": "RFC5905-7.4-1"
    },
    {
      "id": "7.4:2",
      "quote": "For kiss codes DENY and RSTR, the client MUST demobilize any associations to that server and stop sending packets to that server;",
      "disposition": "mapped",
      "mapped-to": "RFC5905-7.4-2"
    },
    {
      "id": "7.4:3",
      "quote": "For kiss code RATE, the client MUST immediately reduce its polling interval to that server and continue to reduce it each time it receives a RATE kiss code.",
      "disposition": "mapped",
      "mapped-to": "RFC5905-7.4-3"
    },
    {
      "id": "7.4:4",
      "quote": "Kiss codes beginning with the ASCII character \"X\" are for unregistered experimentation and development and MUST be ignored if not recognized.",
      "disposition": "mapped",
      "mapped-to": "RFC5905-7.4-4"
    },
    {
      "id": "7.4:5",
      "quote": "The Receive Timestamp and the Transmit Timestamp (set by the server) are undefined when in a KoD packet and MUST NOT be relied upon to have valid values and MUST be discarded.",
      "disposition": "mapped",
      "mapped-to": "RFC5905-7.4-5"
    },
    {
      "id": "11.2.3:1",
      "quote": "In this case, the clock is stepped to the correct offset, but since this means all peer data have been invalidated, all associations MUST be reset and the client begins as at initial start.",
      "disposition": "mapped",
      "mapped-to": "RFC5905-11.2.3-1"
    }
  ]
}
