  "sites": [
    {
      "id": "2.1:1",
      "quote": "An SR Policy MUST be identified through the tuple <Headend, Color, Endpoint>.",
      "disposition": "mapped",
      "mapped-to": "RFC9256-2.1-1"
    },
    {
      "id": "2.1:2",
      "quote": "In the context of a specific headend, an SR Policy MUST be identified by the <Color, Endpoint> tuple.",
      "disposition": "mapped",
      "mapped-to": "RFC9256-2.1-2"
    },
    {
      "id": "2.1:3",
      "quote": "The headend is specified as an IPv4 or IPv6 address and MUST resolve to a unique node in the SR domain [RFC8402].",
      "disposition": "mapped",
      "mapped-to": "RFC9256-2.1-3"
    },
    {
      "id": "2.2:1",
      "quote": "* The endpoints of the constituent SR Policies and the parent SR Policy MUST be identical.",
      "disposition": "mapped",
      "mapped-to": "RFC9256-2.2-1"
    },
    {
      "id": "2.2:2",
      "quote": "* The colors of each of the constituent SR Policies and the parent SR Policy MUST be different.",
      "disposition": "mapped",
      "mapped-to": "RFC9256-2.2-2"
    },
    {
      "id": "2.2:3",
      "quote": "* The constituent SR Policies MUST NOT use composite candidate paths.",
      "disposition": "mapped",
      "mapped-to": "RFC9256-2.2-3"
    },
    {
      "id": "2.4:1",
      "quote": "If 2-byte ASNs are in use, the low-order 16 bits MUST be used, and the high-order bits MUST be set to 0.",
      "disposition": "mapped",
      "mapped-to": "RFC9256-2.4-1"
    },
    {
      "id": "2.4:2",
      "quote": "IPv4 addresses MUST be encoded in the lowest 32 bits, and the high-order bits MUST be set to 0.",
      "disposition": "mapped",
      "mapped-to": "RFC9256-2.4-2"
    },
    {
      "id": "2.6:1",
      "quote": "The identity of a candidate path MUST be uniquely established in the context of an SR Policy <Headend, Color, Endpoint> to handle add, delete, or modify operations on them in an unambiguous manner regardless of their source(s).",
      "disposition": "mapped",
      "mapped-to": "RFC9256-2.6-1"
    },
    {
      "id": "2.6:2",
      "quote": "Such symbolic names MUST NOT be considered as identifiers for a candidate path.",
      "disposition": "mapped",
      "mapped-to": "RFC9256-2.6-3"
    },
    {
      "id": "2.9:1",
      "quote": "Whenever a new path is learned or an active path is deleted, the validity of an existing path changes, or an existing path is changed, the selection process MUST be re-executed.",
      "disposition": "mapped",
      "mapped-to": "RFC9256-2.9-1"
    },
    {
      "id": "2.11:1",
      "quote": "Only the active candidate path MUST be used for forwarding traffic that is being steered onto that policy except for certain scenarios such as fast reroute where a backup candidate path may be used as described in Section 9.3.",
      "disposition": "mapped",
      "mapped-to": "RFC9256-2.11-1"
    },
    {
      "id": "4:1",
      "quote": "When building the MPLS label stack or the SRv6 SID list from the segment list, the node instantiating the policy MUST interpret the set of Segments as follows:",
      "disposition": "mapped",
      "mapped-to": "RFC9256-4-6"
    },
    {
      "id": "5.1:1",
      "quote": "A segment list of an explicit candidate path MUST be declared invalid when any of the following is true:",
      "disposition": "mapped",
      "mapped-to": "RFC9256-5.1-2"
    },
    {
      "id": "5.1:2",
      "quote": "Types A or B MUST be used for the SIDs for which the reachability cannot be verified.",
      "disposition": "mapped",
      "mapped-to": "RFC9256-5.1-4"
    },
    {
      "id": "5.1:3",
      "quote": "Note that the first SID MUST always be reachable regardless of its type.",
      "disposition": "mapped",
      "mapped-to": "RFC9256-5.1-5"
    },
    {
      "id": "5.2:1",
      "quote": "If no solution is found to the optimization objective and constraints, then the dynamic candidate path MUST be declared invalid.",
      "disposition": "mapped",
      "mapped-to": "RFC9256-5.2-1"
    },
    {
      "id": "6.1:1",
      "quote": "Candidate paths of different SR Policies MUST NOT have the same BSID.",
      "disposition": "mapped",
      "mapped-to": "RFC9256-6.1-3"
    },
    {
      "id": "6.2:1",
      "quote": "When the specified BSID is not available (optionally is not in the SRLB), an alert message MUST be generated via mechanisms like syslog.",
      "disposition": "mapped",
      "mapped-to": "RFC9256-6.2-4"
    },
    {
      "id": "6.2.3:1",
      "quote": "An alert MUST be triggered for this error via mechanisms like syslog.",
      "disposition": "mapped",
      "mapped-to": "RFC9256-6.2.3-3"
    },
    {
      "id": "6.2.3:2",
      "quote": "Other candidate paths MUST then be evaluated for becoming the active candidate path.",
      "disposition": "mapped",
      "mapped-to": "RFC9256-6.2.3-4"
    },
    {
      "id": "7:1",
      "quote": "The SR Policy state MUST also reflect the reason when a policy and/or its candidate path is not active due to validation errors or not being preferred.",
      "disposition": "mapped",
      "mapped-to": "RFC9256-7-1"
    }
  ]
}
