  "sites": [
    {
      "id": "5.1:1",
      "quote": "Protection of TCP sessions used by BGP is thus NOT REQUIRED even when peerings are established over shared networks where spoofing can be done (like IXPs), but operators are RECOMMENDED to consider the trade-offs and to apply TCP session protection where appropriate.",
      "disposition": "excluded",
      "excluded-kind": "not-a-requirement",
      "reason": "NOT REQUIRED negates a requirement rather than stating one, and the sentence addresses operators, not an implementation: it directs nothing. Its advisory half, operators are RECOMMENDED to consider TCP session protection, is captured as RFC7454-5.1-3, and the NOT REQUIRED clause is recorded at the OPTIONAL level as RFC7454-5.1-2"
    }
  ]
