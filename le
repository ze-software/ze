#!/usr/bin/env python3
"""le -- the Ze build and test entry point.

Run from anywhere in the checkout:

    ./le --help
    ./le setup --check
    ./le lint

Each subprogram also runs on its own, which is what this shim's `sys.path`
entry makes possible without an install step:

    PYTHONPATH=scripts python3 -m le.application.setup --check
"""

from __future__ import annotations

import sys
from pathlib import Path

# scripts/ holds the package and is not itself one, so putting it on the path
# is what makes `import le` work with nothing installed. A checkout is cloned
# and run, never pip-installed, so an editable install would be a step to
# forget rather than a step to take.
sys.path.insert(0, str(Path(__file__).resolve().parent / 'scripts'))

from le.main import main  # noqa: E402  (path must be set before the import)

if __name__ == '__main__':
    sys.exit(main())
