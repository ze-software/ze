From: Thomas Mangin <thomas.mangin@exa.net.uk>
Subject: Close response bodies and use http.NoBody for empty POST/GET requests

Several methods in updater.go leak HTTP response bodies: the resp.Body
is read but never closed on success paths. Go's net/http documentation
requires callers to close the body when done, even on success. Without
this, connections cannot be reused and file descriptors accumulate when
pushing updates to many devices.

Additionally, POST and GET requests pass nil as the body argument
instead of http.NoBody. While functionally equivalent today, http.NoBody
is the documented sentinel for "no body" and makes intent explicit.

Finally, StreamTo and requestFeatures read the full response body from a
remote device with no size limit. A misbehaving or compromised target
could send an unbounded response, exhausting memory on the build host.
Cap both reads with io.LimitReader.

Also replace the manual loop in Supports() with slices.Contains().

--- a/updater.go
+++ b/updater.go
@@ -7,6 +7,7 @@ import (
 	"encoding/hex"
 	"encoding/json"
 	"errors"
+	"slices"
 	"fmt"
 	"hash"
 	"hash/crc32"
@@ -14,7 +15,6 @@ import (
 	"log"
 	"net/http"
 	"net/url"
-	"slices"
 	"strings"
 )

@@ -75,10 +75,7 @@ const (
 // Supports returns whether the target is known to support the specified update
 // protocol feature.
 func (t *Target) Supports(feature ProtocolFeature) bool {
-	for _, f := range t.supports {
-		if f == string(feature) {
-			return true
-		}
-	}
-	return false
+	return slices.Contains(t.supports, string(feature))
 }

@@ -117,10 +114,13 @@ func (t *Target) StreamTo(ctx context.Context, dest string, r io.Reader) error {
 	if err != nil {
 		return err
 	}
+	defer resp.Body.Close()
 	if got, want := resp.StatusCode, http.StatusOK; got != want {
 		body, _ := io.ReadAll(resp.Body)
 		return fmt.Errorf("unexpected HTTP status code: got %v, want %v (body %q)", resp.Status, want, string(body))
 	}
-	remoteHash, err := io.ReadAll(resp.Body)
+	// The response is a hex-encoded hash (tens of bytes); cap reads from the
+	// remote device defensively.
+	remoteHash, err := io.ReadAll(io.LimitReader(resp.Body, 1<<20))
 	if err != nil {
 		return err
 	}
