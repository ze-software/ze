[1967.108246,"o","\u001b[H\u001b[2J\r\n  Recovery and acceptance are different outcomes\r\n  =============================================\r\n\r\n  The unaccepted change restored edge-original on the running router.\r\n  The accepted change stayed edge-confirmed after its deadline.\r\n  History records the revisions. Ze was never restarted.\r\n"]
