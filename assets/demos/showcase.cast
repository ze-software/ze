[1635.63021,"o","\u001b[\u003e4m\u001b[?1049h\u001b[?2004h\u001b[\u003e4;2m\u001b[\u003e1u\u001b[?u\u001b]12;#c0c0c0\u0007\u001b[1 q\u001b[H\u001b[2J\u001b[38;5;62m╭───────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╮\u001b[m\r\n\u001b[38;5;62m│\u001b[menvironment {\u001b[118X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m    ssh {\u001b[122X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m        enabled enable\u001b[109X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m        server {\u001b[115X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m            main 127.0.0.1 2222\u001b[100X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m        }\u001b[122X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m    }\u001b[126X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m}\u001b[130X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[msystem host edge-original\u001b[106X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[mbfd {\u001b[126X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m    enabled enable\u001b[113X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m    profile fast {\u001b[113X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m        detect-multiplier 3\u001b[104X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m        desired-min-tx-us 300000\u001b[99X\u001b[99C\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m        required-min-rx-us 300000\u001b[98X\u001b[98C\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m    }\u001b[126X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m}\u001b[130X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[mbgp {\u001b[126X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m    peer customer {\u001b[112X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m        attach process bgp-adj-rib-in {\u001b[92X\u001b[92C\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m            receive [ update-received state ]\u001b[86X\u001b[86C\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m            send update\u001b[108X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m        }\u001b[122X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m        connection {\u001b[111X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m            local ip 127.0.0.1\u001b[101X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m            remote {\u001b[111X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m\u001b[16X\u001b[28;18Hip 127.0.0.4\u001b[103X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m\u001b[16X\u001b[29;18Hport 1179\u001b[106X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m            }\u001b[118X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m        }\u001b[122X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m        filter {\u001b[115X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m╰───────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╯\u001b[m\r\n\u001b[38;5;226mwelcome to ze, admin!\u001b[m\r\n\u001b[38;5;241mZe Editor [config]  (Tab/?: complete, Enter: execute, Esc: quit)\u001b[m\r\n\u001b[38;5;82mze# \u001b[38;5;240mtype command or Tab for suggestions\u001b[K\u001b[m\u001b[36;5H\u001b[?25h"]
[1639.883536,"o","\u001b[0m\u001b[H\u001b[2J\r\n  Enable bounded byte accounting\r\n  ==============================\r\n\r\n  Enable eBPF traffic accounting with source-IP attribution.\r\n  The export interval is 250 ms, map capacity is 256 entries, and the\r\n  stale-entry timeout is 60000 ms.\r\n\r\n  These are cumulative byte totals, not packet payloads or live rates.\r\n  The bounded maps limit accounting state while the router runs.\r\n"]
