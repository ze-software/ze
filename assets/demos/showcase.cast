[538.731654,"o","\u001b[\u003e4m\u001b[?1049h\u001b[?2004h\u001b[\u003e4;2m\u001b[\u003e1u\u001b[?u\u001b]12;#c0c0c0\u0007\u001b[1 q\u001b[H\u001b[2J\u001b[38;5;62m╭───────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╮\u001b[m\r\n\u001b[38;5;62m│\u001b[menvironment {\u001b[118X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m    ssh {\u001b[122X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m        enabled enable\u001b[109X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m        server {\u001b[115X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m            main 127.0.0.1 2222\u001b[100X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m        }\u001b[122X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m    }\u001b[126X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m}\u001b[130X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[msystem {\u001b[123X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m    host edge-original\u001b[109X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m    irr {\u001b[122X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m        server 127.0.0.1:4343\u001b[102X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m        refresh-interval 3600\u001b[102X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m    }\u001b[126X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m}\u001b[130X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[mbfd {\u001b[126X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m    enabled enable\u001b[113X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m    profile fast {\u001b[113X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m        detect-multiplier 3\u001b[104X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m        desired-min-tx-us 300000\u001b[99X\u001b[99C\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m        required-min-rx-us 300000\u001b[98X\u001b[98C\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m    }\u001b[126X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m}\u001b[130X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[mbgp {\u001b[126X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m    router-id 192.0.2.1\u001b[108X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m    session {\u001b[118X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m        asn local 65000\u001b[108X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m    }\u001b[126X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m    filter {\u001b[119X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m        import {\u001b[115X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m            final accept\u001b[107X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m╰───────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╯\u001b[m\r\n\u001b[38;5;226mwelcome to ze, admin!\u001b[m\r\n\u001b[38;5;241mZe Editor [config]  (Tab/?: complete, Enter: execute, Esc: quit)\u001b[m\r\n\u001b[38;5;82mze# \u001b[38;5;240mtype command or Tab for suggestions\u001b[K\u001b[m\u001b[36;5H\u001b[?25h"]
[540.984084,"o","\u001b[0m\u001b[H\u001b[2J\r\n  Give the router an area\r\n  =======================\r\n\r\n  The router ID identifies Ze in OSPF; it is not a new interface address.\r\n  Area 0.0.0.0 is the backbone shared with FRR.\r\n\r\n  This section enables the OSPF configuration with router ID 192.0.2.1\r\n  and declares a normal area. The next section places frr0 in that area.\r\n"]
[545.987078,"o","\u001b[0m\u001b[H\u001b[2J\u001b[2J\u001b[38;5;62m╭───────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╮\u001b[m\r\n\u001b[38;5;62m│\u001b[menvironment {\u001b[118X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m    ssh {\u001b[122X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m        enabled enable\u001b[109X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m        server {\u001b[115X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m            main 127.0.0.1 2222\u001b[100X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m        }\u001b[122X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m    }\u001b[126X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m}\u001b[130X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[msystem {\u001b[123X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m    host edge-original\u001b[109X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m    irr {\u001b[122X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m        server 127.0.0.1:4343\u001b[102X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m        refresh-interval 3600\u001b[102X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m    }\u001b[126X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m}\u001b[130X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[mbfd {\u001b[126X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m    enabled enable\u001b[113X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m    profile fast {\u001b[113X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m        detect-multiplier 3\u001b[104X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m        desired-min-tx-us 300000\u001b[99X\u001b[99C\u001b[38;5;62m│\u001b[m\r\n\