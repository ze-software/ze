[712.270207,"o","\u001b[H\u001b[2J\r\n  Build the tunnel in one live candidate\r\n  ======================================\r\n\r\n  Load and explain these sections, then compare and commit:\r\n    IKE authenticates the routers\r\n    ESP protects the packets\r\n    Bind the peer and protected networks\r\n    Route through the XFRM interface\r\n\r\n  Then diagnose and repair a controlled mismatch:\r\n    Offer an ESP cipher the far end does not accept\r\n    Restore the shared ESP proposal\r\n"]
