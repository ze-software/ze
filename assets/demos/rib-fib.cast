[43.31737, "o", "unicast \u001b[35m198.51.100.0/24 \u001b[0mvia \u001b[35m127.0.0.1 \u001b[0mdev \u001b[36mlo \u001b[0mproto 250 scope global metric 42 \r\n"]
[43.325785, "o", "\u001b[?2004h$ "]
[50.68589, "o", "\u001b[H\u001b[2J\u001b[3J\u001b[?2004h$ ze-demo card rib-fib recap\r\n\u001b[?2004l\r"]
[50.7143, "o", "\u001b[H\u001b[2J\r\n  ROUTE INSTALLATION PATH\r\n  =======================\r\n\r\n  request bgp rib inject\r\n      -\u003e BGP best path\r\n      -\u003e system RIB\r\n      -\u003e Linux kernel FIB\r\n\r\n  The automated validator also withdrew the prefix and proved kernel removal.\r\n  Control-plane and kernel state came from the running system.\r\n\r\n  Recording complete.\r\n"]
[50.71863, "o", "\u001b[?2004h$ "]
