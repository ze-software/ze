[105.07824, "o", "\r\n\u001b[?2004l\r"]
[107.106125, "o", "\t\t\timport bgp-filter-irr:65001\r\n\t\t\tirr as-set AS-TEST\r\n\t\t\tserver 127.0.0.1:4343\r\n\t\tbgp-filter-irr bgp-filter-irr\r\n"]
