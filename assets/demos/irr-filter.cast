[0.04445, "o", "\u001b[?2004h$ "]
[1.29696, "o", "\u001b[H\u001b[2J\u001b[3J\r\n  Add IRR filtering to an existing BGP peer\r\n  =========================================\r\n\r\n  The stored configuration already has customer-a and Adj-RIB-In, but no\r\n  IRR plugin, IRR server, AS-SET, or import filter.\r\n\r\n  We will pipe the stored configuration through one `ze config set -`\r\n  stage per setting, import the result back into ZeFS, then start Ze\r\n  and prove the generated list filters received routes.\r\n\u001b[?2004h$ "]
[3.05107, "o", "\u001b[H\u001b[2J\u001b[3J\u001b[?2004h$ "]
