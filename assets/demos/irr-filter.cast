[69.728355, "o", "\r\n\u001b[?2004l\r"]
[74.0332, "o", "set plugin internal bgp-filter-irr use bgp-filter-irr\r\n"]
[76.494525, "o", "set bgp policy irr server 127.0.0.1:4343\r\n"]
[78.967665, "o", "set bgp policy irr refresh-interval 3600\r\n"]
[81.569915, "o", "set bgp peer customer-a session irr as-set AS-TEST\r\n"]
