[16.885832,"o","\u001b[\u003e4m\u001b[?1049h\u001b[?2004h\u001b[\u003e4;2m\u001b[\u003e1u\u001b[?u\u001b]12;#c0c0c0\u0007\u001b[1 q\u001b[H\u001b[2J\u001b[38;5;62m╭───────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╮\u001b[m\r\n\u001b[38;5;62m│\u001b[menvironment {\u001b[118X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m    ssh {\u001b[122X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m        enabled enable\u001b[109X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m        server {\u001b[115X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m            main 127.0.0.1 2222\u001b[100X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m        }\u001b[122X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m    }\u001b[126X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m}\u001b[130X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[msystem host edge-original\u001b[106X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[mbgp {\u001b[126X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m    router-id 192.0.2.1\u001b[108X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m    session {\u001b[118X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m        asn local 65000\u001b[108X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m    }\u001b[126X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m    # RFC 8212 Section 3: an EBGP direction with no explicit policy passes\u001b[57X\u001b[57C\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m    # no routes, so this config states that its sessions exchange them all.\u001b[56X\u001b[56C\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m    filter {\u001b[119X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m        import {\u001b[115X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m            final accept\u001b[107X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m        }\u001b[122X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m        export {\u001b[115X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m            final accept\u001b[107X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m        }\u001b[122X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m    }\u001b[126X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m    peer transit {\u001b[113X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m        connection {\u001b[111X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m            local ip 127.0.0.1\u001b[101X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m            remote {\u001b[111X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m\u001b[16X\u001b[30;18Hip 127.0.0.2\u001b[103X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m\u001b[16X\u001b[31;18Hport 1179\u001b[106X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m            }\u001b[118X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m╰───────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╯\u001b[m\r\n\u001b[38;5;226mwelcome to ze, admin!\u001b[m\r\n\u001b[38;5;241mZe Editor [config]  (Tab/?: complete, Enter: execute, Esc: quit)\u001b[m\r\n\u001b[38;5;82mze# \u001b[38;5;240mtype command or Tab for suggestions\u001b[K\u001b[m\u001b[36;5H\u001b[?25h"]
