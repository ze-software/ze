[9.877251,"o","\u001b[H\u001b[2J\r\n  Change a live router with a safety net\r\n  =====================================\r\n\r\n  1. A trial hostname nobody confirms\r\n  2. A confirmed hostname that stays\r\n\r\n  Compare before committing. Watch the first change become active.\r\n  Then deliberately leave it unconfirmed and inspect the rollback.\r\n"]
