[20.714847,"o","\u001b[?25l\u001b[2;2H+ environment {\r\n\u001b[C+     ssh {\r\n\u001b[C+         enabled enable\r\n\u001b[C+         server {\r\n\u001b[C+\u001b[13X\u001b[6;16Hmain 127.0.0.1 2222\r\n\u001b[C+         }\r\n\u001b[C+     }\r\n\u001b[C+ } \r\n\u001b[C+ system host edge-original\r\n\u001b[C+ bgp {\r\n\u001b[C+     router-id 192.0.2.1\r\n\u001b[C+     session {\r\n\u001b[C+         asn local 65000\r\n\u001b[C+     }\r\n\u001b[C+     # RFC 8212 Section 3: an EBGP direction with no explicit policy passes\r\n\u001b[C+     # no routes, so this config states that its sessions exchange them all.\r\n\u001b[C+     filter {\r\n\u001b[C+         import {\r\n\u001b[C+             final accept\r\n\u001b[C+         }\r\n\u001b[C+         export {\r\n\u001b[C+             final accept\r\n\u001b[C+         }\r\n\u001b[C+     }\r\n\u001b[C+     peer transit {\r\n\u001b[C+         connection {\r\n\u001b[C+             local ip 127.0.0.1\r\n\u001b[C+             remote {\r\n\u001b[C+\u001b[17X\u001b[30;20Hip 127.0.0.2\r\n\u001b[C+\u001b[17X\u001b[31;20Hport 1179\r\n\u001b[C+             }\r\n\r\n\u001b[K\r\n\r\n\u001b[5G\u001b[38;5;240mtype command or Tab for suggestions\u001b[K\u001b[m\u001b[36;5H\u001b[?25h"]
[22.96639,"o","\u001b[0m\u001b[H\u001b[2J\r\n  A trial hostname nobody confirms\r\n  ================================\r\n\r\n  Load edge-trial into this candidate and commit confirmed 15.\r\n  We deliberately do not accept it. Ze must restore edge-original.\r\n  This harmless change demonstrates the same safety window as a risky edit.\r\n"]
