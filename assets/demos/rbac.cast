[12.30609, "o", "run {\r\n\tdefault-action allow\r\n\tentry 10 {\r\n\t\taction deny\r\n\t\tmatch debug\r\n\t}\r\n\tentry 20 {\r\n\t\taction deny\r\n\t\tmatch clear\r\n\t}\r\n}\r\nedit default-action deny\r\n"]
