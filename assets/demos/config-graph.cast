[50.476895, "o", "\r\n\u001b[?2004l\r"]
[51.401205, "o", "time=2026-11-20T22:29:41.767Z level=WARN msg=\"peers and dynamic groups declare no RFC 9234 role, so no check a role inserts runs on them\" subsystem=bgp.role peers=2 first=\"upstream-a, upstream-b\" action=\"add `role { import \u003crole\u003e }` to each peer or group that should carry one, or leave it out deliberately\"\r\n"]
[51.411075, "o", "configuration valid: router.conf\r\n"]
