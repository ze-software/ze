[8.659145, "o", "\r\n\u001b[?2004l\r"]
[11.3979, "o", "peer upstream-a {\r\n\tconnection {\r\n\t\tlocal ip 192.0.2.2\r\n\t\tremote ip 192.0.2.1\r\n\t}\r\n}\r\npeer upstream-b {\r\n\tconnection {\r\n\t\tlocal ip 198.51.100.2\r\n\t\tremote ip 198.51.100.1\r\n\t}\r\n}\r\nsession {\r\n\tasn remote 64500\r\n}\r\n"]
