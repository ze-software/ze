[26.358365, "o", "time=2026-10-09T00:35:32.144Z level=WARN msg=\"peers and dynamic groups declare no RFC 9234 role, so no transit-leak filter is required of them\" subsystem=bgp.config peers=2 first=\"upstream-a, upstream-b\"\r\n"]
