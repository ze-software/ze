[42.421775,"o","\u001b[0m\u001b[H\u001b[2J\r\n  Connect the RTR cache\r\n  =====================\r\n\r\n  This isolated lab uses trusted TCP to 127.0.0.3:3323.\r\n  The cache supplies test data, not public RPKI validation.\r\n  Its two-second refresh makes a failed poll visible in this lab.\r\n"]
