[2.17475,"o","\u001b[H\u001b[2J\r\n  Validate routes already on this router\r\n  =====================================\r\n\r\n  Ze peers with transit AS 65001. A local test RTR cache supplies VRPs.\r\n  A VRP names a prefix, maximum length and authorized origin ASN.\r\n  We add RPKI live, without reconnecting transit or restarting Ze.\r\n"]
