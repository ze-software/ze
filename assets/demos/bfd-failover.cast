[19.227155,"o","\u001b[\u003e4m\u001b[?1049h\u001b[?2004h\u001b[\u003e4;2m\u001b[\u003e1u\u001b[?u\u001b]12;#c0c0c0\u0007\u001b[1 q\u001b[H\u001b[2J\u001b[38;5;62m╭───────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╮\u001b[m\r\n\u001b[38;5;62m│\u001b[menvironment {\u001b[118X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m    ssh {\u001b[122X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m        enabled enable\u001b[109X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m        server {\u001b[115X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m            main 127.0.0.1 2222\u001b[100X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m        }\u001b[122X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m    }\u001b[126X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m}\u001b[130X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[msystem host edge-original\u001b[106X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[mbgp {\u001b[126X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m    peer customer {\u001b[112X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m        attach process bgp-adj-rib-in {\u001b[92X\u001b[92C\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m            receive [ update-received state ]\u001b[86X\u001b[86C\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m            send update\u001b[108X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m        }\u001b[122X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m        connection {\u001b[111X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m            local ip 127.0.0.1\u001b[101X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m            remote {\u001b[111X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m\u001b[16X\u001b[20;18Hip 127.0.0.4\u001b[103X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m\u001b[16X\u001b[21;18Hport 1179\u001b[106X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m            }\u001b[118X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m        }\u001b[122X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m        session {\u001b[114X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m            asn {\u001b[114X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m\u001b[16X\u001b[26;18Hlocal 65000\u001b[104X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m\u001b[16X\u001b[27;18Hremote 65001\u001b[103X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m            }\u001b[118X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m            family ipv4/unicast {\u001b[98X\u001b[98C\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m\u001b[16X\u001b[30;18Hprefix maximum 100\u001b[97X\u001b[97C\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m            }\u001b[118X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m        }\u001b[122X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m╰───────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╯\u001b[m\r\n\u001b[38;5;226mwelcome to ze, admin!\u001b[m\r\n\u001b[38;5;241mZe Editor [config]  (Tab/?: complete, Enter: execute, Esc: quit)\u001b[m\r\n\u001b[38;5;82mze# \u001b[38;5;240mtype command or Tab for suggestions\u001b[K\u001b[m\u001b[36;5H\u001b[?25h"]
[19.478001,"o","\u001b[0m\u001b[H\u001b[2J\r\n  Set the BFD detection profile\r\n  =============================\r\n\r\n  BFD exchanges small control packets to detect a failed path before\r\n  BGP's longer hold timer expires. This profile requests 300 ms packets\r\n  and a detection multiplier of three.\r\n\r\n  FRR calls these transmit-interval 300, receive-interval 300 and\r\n  detect-multiplier 3. Ze's desired-min-tx-us and required-min-rx-us\r\n  use microseconds: 300000 is the same requested interval.\r\n"]
