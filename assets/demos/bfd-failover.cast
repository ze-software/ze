[28.48287,"o","\u001b[?25l\u001b[2;2H  environment {\r\n\u001b[6G  ssh {\r\n\u001b[9C  enabled enable\u001b[5;10H  server {\r\n\u001b[14G  main 127.0.0.1 2222\u001b[7;10H  } \r\n\u001b[6G  } \r\n\u001b[C  } \r\n\u001b[C  system host edge-original\r\n\u001b[C+ bfd {\r\n\u001b[C+     enabled enable   \r\n\u001b[C+     profile fast {\r\n\u001b[C+         detect-multiplier 3\r\n\u001b[C+         desired-min-tx-us 300000\r\n\u001b[C+         required-min-rx-us 300000\u001b[39X\r\n\u001b[C+     }\u001b[68X\r\n\u001b[C+ }         \r\n\u001b[4Gbgp {         \r\n\u001b[8Grouter-id 192.0.2.1\r\n\u001b[8Gsession {\u001b[22;10H  asn local 65000\r\n\u001b[8G}\u001b[17X\r\n\u001b[8Gfilter {\r\n\u001b[6G      import final accept\r\n\u001b[6G      export final accept\r\n\u001b[8G}             \r\n\u001b[8Gpeer transit {          \u001b[29;12Hconnection {\u001b[30;16Hlocal ip 127.0.0.1\u001b[31;16Hremote {   \u001b[32;14H      ip 127.0.0.2\r\n\r\n\u001b[38;5;82m► Configuration merged from topics/bfd/1-profile.conf\u001b[m\u001b[35;19H\u001b[38;5;241m [modified]  (Tab/?: complete, Enter: execute, Esc: quit)\u001b[m\u001b[36;5H\u001b[?25h"]
[30.734803,"o","\u001b[0m\u001b[H\u001b[2J\r\n  Bind the existing BGP peer\r\n  ==========================\r\n\r\n  A profile alone protects no session. This section opts the existing\r\n  frr BGP peer into single-hop BFD and selects the fast profile.\r\n\r\n  FRR: neighbor 172.29.0.1 bfd profile fast\r\n  Ze:  bgp peer frr connection bfd { enabled true; profile fast; }\r\n\r\n  The live binding must not replace Ze or reconnect an established BGP\r\n  session merely to enable BFD.\r\n"]
