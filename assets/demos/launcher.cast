[4.16719, "o", "\u001b[>4m\u001b[=0;1u\u001b[?1049h\u001b[?25l\u001b[?5W\u001b[?2004h\u001b[>4;2m\u001b[=1;1u\u001b[?u\u001b[H\u001b[2J\u001b[38;5;205;1mze\u001b[m\r\n\n\u001b[38;5;205;1mOperations (interact with the running daemon)\u001b[m\r\n> \u001b[38;5;73;1mannounce          \u001b[38;5;241;22mAnnounce a route on demand to selected peers\u001b[m\r\n  \u001b[38;5;73mclear\u001b[13X\u001b[5;21H\u001b[38;5;241mReset counters, caches, and operational state with >\u001b[m\r\n  \u001b[38;5;73mcli\u001b[15X\u001b[6;21H\u001b[38;5;241mInteractive CLI for the running daemon\u001b[m\r\n  \u001b[38;5;73mcreate            \u001b[38;5;241mCreate new resources >\u001b[m\r\n  \u001b[38;5;73mdebug\u001b[13X\u001b[8;21H\u001b[38;5;241mOSPF debug LSA injection (spec-ospf-ext-14) >\u001b[m\r\n  \u001b[38;5;73mdelete            \u001b[38;5;241mDelete elements from the running configuration >\u001b[m\r\n  \u001b[38;5;73mhelp\u001b[14X\u001b[10;21H\u001b[38;5;241mShow available commands at this level\u001b[m\r\n  \u001b[38;5;73mmonitor           \u001b[38;5;241mContinuous monitoring commands (Ctrl-C to stop) >\u001b[m\r\n  \u001b[38;5;73mpeer\u001b[14X\u001b[12;21H\u001b[38;5;241mRaw byte injection (testing and conformance only) >\u001b[m\r\n  \u001b[38;5;73mplugin            \u001b[38;5;241mConfigure how events are delivered to your plugin  >\u001b[m\r\n  \u001b[38;5;73mrequest           \u001b[38;5;241mCache operational actions >\u001b[m\r\n  \u001b[38;5;73mresolve           \u001b[38;5;241mDNS, ASN, PeeringDB, and IRR resolution tools >\u001b[m\r\n  \u001b[38;5;73mset\u001b[15X\u001b[16;21H\u001b[38;5;241mModify running configuration parameters >\u001b[m\r\n  \u001b[38;5;73mshow\u001b[14X\u001b[17;21H\u001b[38;5;241mRead-only commands to inspect system, protocol, an >\u001b[m\r\n  \u001b[38;5;73msystem            \u001b[38;5;241mSystem operations >\u001b[m\r\n  \u001b[38;5;73mupdate            \u001b[38;5;241mPull fresh data from external sources or manage fi >\u001b[m\r\n  \u001b[38;5;73mwithdraw          \u001b[38;5;241mWithdraw on-demand announcements\u001b[m\r\n\n\u001b[38;5;205;1mConfiguration (change how the box behaves)\u001b[m\r\n  \u001b[38;5;73mconfig            \u001b[38;5;241mConfiguration editing, formatting, validation, and\u001b[m\r\n  \u001b[38;5;73mdata\u001b[14X\u001b[24;21H\u001b[38;5;241mZeFS blob store management\u001b[m\r\n  \u001b[38;5;73mexabgp            \u001b[38;5;241mExaBGP bridge tools\u001b[m\r\n  \u001b[38;5;73mfirewall          \u001b[38;5;241mFirewall management\u001b[m\r\n  \u001b[38;5;73minterface         \u001b[38;5;241mManage OS network interfaces\u001b[m\r\n  \u001b[38;5;73misis\u001b[14X\u001b[28;21H\u001b[38;5;241mOffline IS-IS wire tools\u001b[m\r\n  \u001b[38;5;73ml2tp\u001b[14X\u001b[29;21H\u001b[38;5;241mL2TP tools\u001b[m\r\n  \u001b[38;5;73mospf\u001b[14X\u001b[30;21H\u001b[38;5;241mOffline OSPF wire tools\u001b[m\r\n  \u001b[38;5;73mpasswd            \u001b[38;5;241mChange stored SSH/HTTP passwords\u001b[m\r\n  \u001b[38;5;73mschema            \u001b[38;5;241mSchema discovery\u001b[m\r\n  \u001b[38;5;73msysctl            \u001b[38;5;241mKernel sysctl helpers\u001b[m\r\n\u001b[38;5;241m  ... more below\u001b[m\r\n\n\u001b[38;5;241m\u2191/\u2193 navigate \u2022 enter select \u2022 esc quit\u001b[m"]
[10.493125, "o", "\r\u001b[14d\u001b[J\u001b[3d> \u001b[38;5;73;1mset\u001b[15X\u001b[3;21H\u001b[38;5;241;22mModify running configuration parameters >\u001b[m\r\n  \u001b[38;5;73mshow\u001b[14X\u001b[4;21H\u001b[38;5;241mRead-only commands to inspect system, protocol, an >\u001b[m\r\n  \u001b[38;5;73msystem            \u001b[38;5;241mSystem operations >\u001b[m\u001b[K\r\n  \u001b[38;5;73mschema            \u001b[38;5;241mSchema discovery\u001b[m\u001b[K\r\n  \u001b[38;5;73msysctl            \u001b[38;5;241mKernel sysctl helpers\u001b[m\u001b[K\r\n  \u001b[38;5;73msignal            \u001b[38;5;241mSend signals to the daemon via SSH\u001b[m\u001b[K\r\n  \u001b[38;5;73mskills            \u001b[38;5;241mAgent skills matched to this Ze version\u001b[m\u001b[K\r\n  \u001b[38;5;73mstart\u001b[13X\u001b[10;21H\u001b[38;5;241mStart the Ze daemon from blob storage config\u001b[m\r\n  \u001b[38;5;73mstatus            \u001b[38;5;241mCheck if daemon is running\u001b[m\u001b[K\r\n  \u001b[38;5;73msupport           \u001b[38;5;241mCollect logs, config, and diagnostics into a suppo\u001b[m\u001b[K\r\n\u001b[K\n\u001b[38;5;241mfilter: s\u001b[m  \u001b[38;5;241m\u2191/\u2193 navigate \u2022 enter select \u2022 esc quit\u001b[m"]
