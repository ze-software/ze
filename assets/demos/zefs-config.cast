[51.639333,"o","\u001b[\u003e4m\u001b[=0;1u\u001b[?1049h\u001b[?2004h\u001b[\u003e4;2m\u001b[=1;1u\u001b[?u\u001b]12;#c0c0c0\u0007\u001b[1 q\u001b[H\u001b[2J\u001b[38;5;62m╭───────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╮\u001b[m\r\n\u001b[38;5;62m│\u001b[menvironment {\u001b[118X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m    ssh {\u001b[122X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m        enabled enable\u001b[109X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m        server {\u001b[115X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m            main 127.0.0.1 2222\u001b[100X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m        }\u001b[122X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m    }\u001b[126X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m}\u001b[130X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[mbgp {\u001b[126X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m    peer edge-a {\u001b[114X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m        connection {\u001b[111X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m            local ip 127.0.0.1\u001b[101X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m            remote {\u001b[111X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m\u001b[16X\u001b[15;18Hip 127.0.0.2\u001b[103X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m\u001b[16X\u001b[16;18Hport 1179\u001b[106X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m            }\u001b[118X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m        }\u001b[122X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m        session {\u001b[114X\u001b[133G\u001b[38;5;62m│\u001b[m\r\n\u001b[38;5;62m│\u001b[m            asn {\u001b