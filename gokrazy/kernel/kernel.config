CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_DYNAMIC_DEBUG=y

# Basic boot support.
CONFIG_IP_PNP=y
CONFIG_IP_PNP_DHCP=y
CONFIG_EXT4_FS=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Squashfs root filesystem.
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_FILE_CACHE=y
CONFIG_SQUASHFS_DECOMP_MULTI_PERCPU=y
CONFIG_SQUASHFS_ZLIB=y
CONFIG_SQUASHFS_FRAGMENT_CACHE_SIZE=3

# Serial console (ttyS0 for x86, ttyAMA0 for arm64).
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# Shared Fintek serial + EFI framebuffer console subset (verified-identical with
# the installer hardware profile). Single-sourced in
# tools/kernel-builder/common/efi-console.config.
# ze-include: efi-console

# Runtime keeps DRM framebuffer emulation local (the installer hardware profile
# uses full DRM instead).
CONFIG_DRM_FBDEV_EMULATION=y

# FUSE for cpu(1).
CONFIG_FUSE_FS=y

# Netlink and xfrm userspace integration.
CONFIG_NETFILTER_NETLINK_QUEUE=y
CONFIG_XFRM_USER=y

# nftables core.
#
# NF_CONNTRACK and NF_NAT are tristate and default to =m. Every nft expression
# that depends on them (NFT_CT, NFT_NAT, NFT_MASQ, NFT_REDIR below) is then
# demoted to =m too, whatever this fragment asks for. A module is unreachable in
# the QEMU functional VM, which boots this kernel beside Alpine's initramfs and
# Alpine's own /lib/modules (internal/le/test/qemu.Run),
# so the ze modules are simply absent. Built in, not modular.
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NF_TABLES=y
# The "inet" family: one dual-stack IPv4+IPv6 table. ze's own control-plane
# policing builds one unconditionally (coppTable, internal/plugins/copp/translate.go,
# Family: firewall.FamilyInet), and ze-firewall-conf.yang offers `inet` as a
# table family an operator can select. Without this symbol the kernel answers
# EOPNOTSUPP, Apply's Flush fails (internal/plugins/firewall/nft/backend_linux.go),
# the firewall plugin fails startup and the daemon exits. IPV4 and IPV6 sit two
# lines below and INET was the enumeration hole between them.
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_PAYLOAD=y
CONFIG_NFT_EXTHDR=y
CONFIG_NFT_META=y
CONFIG_NFT_CT=y
CONFIG_NFT_RBTREE=y
CONFIG_NFT_HASH=y
CONFIG_NFT_COUNTER=y
CONFIG_NFT_LOG=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_COMPAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_REDIR=y
CONFIG_NFT_REJECT=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NFT_REJECT_IPV4=y
CONFIG_NF_TABLES_IPV6=y
# The "arp" family. VRRP's address owner holds its virtual IPv4 address on the
# parent as a real address, so the parent answers ARP for it with the physical
# MAC. ze drops that reply at the arp output hook (ownerFilterTables,
# internal/plugins/vrrp/ownerfilter.go), which RFC 3768 Section 8.2 and RFC 9568
# Section 8.1.2 require: the Master MUST NOT answer with its physical MAC.
# Without this symbol the kernel refuses the table with EOPNOTSUPP.
CONFIG_NF_TABLES_ARP=y
CONFIG_NFT_OBJREF=y
CONFIG_NFT_DUP_IPV4=y
CONFIG_NFT_FIB_IPV4=y
CONFIG_NFT_DUP_IPV6=y
CONFIG_NFT_FIB_IPV6=y
# Flowtables and the flow_offload expression. ze-firewall-conf.yang accepts a
# table `flowtable` and a term `flow-offload` action (parseFlowtable and the
# flow-offload action in internal/component/firewall/config.go), and the nft
# backend sends both (applyFlowtable, internal/plugins/firewall/nft/backend_linux.go).
# Without these symbols the kernel answers ENOENT and refuses the whole table,
# every other rule in it included. In 7.2.9 NF_FLOW_TABLE depends on
# NETFILTER_INGRESS, NF_CONNTRACK and NF_TABLES (all =y above or by default),
# NF_FLOW_TABLE_INET registers the flowtable type for every family (the
# separate IPv4 and IPv6 flowtable symbols no longer exist), and NFT_FLOW_OFFLOAD
# depends on NF_CONNTRACK and NF_FLOW_TABLE (net/netfilter/Kconfig).
CONFIG_NF_FLOW_TABLE=y
CONFIG_NF_FLOW_TABLE_INET=y
CONFIG_NFT_FLOW_OFFLOAD=y

# Conntrack helpers (ALGs), built in and assigned only when listed.
#
# Since Linux 6.0 the kernel never assigns a helper on its own:
# __nf_ct_try_assign_helper (net/netfilter/nf_conntrack_helper.c) assigns only
# from a template an explicit rule set. A helper built in and unassigned
# processes nothing, so the NAT slipstreaming exposure that made automatic
# assignment dangerous is limited to the helpers an operator lists under
# `system conntrack module`, on the ports Ze's assignment rule names
# (internal/component/firewall/conntrack_helpers.go). The list is empty by
# default, which keeps RFC 4787 Section 7 REQ-10.
#
# Built in, not modular, for the same reason as NF_CONNTRACK above. Each NAT
# companion below (NF_NAT_FTP, NF_NAT_H323, NF_NAT_PPTP, NF_NAT_SIP, NF_NAT_TFTP) is
# promptless and defaults on once its helper and NF_NAT are =y; kernel.require
# pins each one so a demotion fails the build. Without the companion the
# helper tracks the data connection and NAT does not rewrite it, so active FTP
# through masquerade still breaks.
CONFIG_NF_CONNTRACK_FTP=y
CONFIG_NF_CONNTRACK_H323=y
CONFIG_NF_CONNTRACK_PPTP=y
CONFIG_NF_CONNTRACK_SIP=y
CONFIG_NF_CONNTRACK_TFTP=y

# The rest of the helpers `system conntrack module` accepts, built in for the
# same reason: every name the leaf-list accepts works on Ze's kernel. sane and
# netbios-ns have no NAT companion; NETBIOS_NS selects NF_CONNTRACK_BROADCAST.
# NF_NAT_IRC and NF_NAT_AMANDA are promptless and default on with their helper;
# NF_NAT_SNMP_BASIC carries a prompt and needs NETFILTER_ADVANCED, so it is
# asked for explicitly.
CONFIG_NF_CONNTRACK_AMANDA=y
CONFIG_NF_CONNTRACK_IRC=y
CONFIG_NF_CONNTRACK_NETBIOS_NS=y
CONFIG_NF_CONNTRACK_SNMP=y
CONFIG_NF_CONNTRACK_SANE=y
CONFIG_NF_NAT_SNMP_BASIC=y

# /proc/config.gz.
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# kexec.
CONFIG_KEXEC_FILE=y

# Linux 6.1+ i915 warnings must not fail the kernel build.
CONFIG_WERROR=n

# zstd keeps the kernel below MBR loader extended-memory limits.
CONFIG_KERNEL_ZSTD=y

# go-landlock sandboxing.
CONFIG_SECURITY_LANDLOCK=y
