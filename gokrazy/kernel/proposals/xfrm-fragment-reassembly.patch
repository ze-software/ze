+/* RFC 4301 Section 7.3: enforce permission before changing inner headers.
+ * This deliberately does not recheck selectors: an ICMP error may already
+ * have been authorized using its reversed quoted flow.
+ */
+static bool xfrm_output_fragment_allowed(const struct xfrm_state *x,
+					 const struct sk_buff *skb)
+{
+	if (xfrm_state_noninitial_allowed(x))
+		return true;
+	if (skb->protocol == htons(ETH_P_IP)) {
+		struct iphdr header, *iph;
+
+		iph = skb_header_pointer(skb, skb_network_offset(skb),
+					 sizeof(header), &header);
+		return iph && !(iph->frag_off & htons(IP_OFFSET));
+	}
+#if IS_ENABLED(CONFIG_IPV6)
+	if (skb->protocol == htons(ETH_P_IPV6)) {
+		struct ipv6hdr header, *ip6h;
+		unsigned int proto;
+		int offset = skb_network_offset(skb);
+
+		ip6h = skb_header_pointer(skb, offset, sizeof(header), &header);
+		if (!ip6h)
+			return false;
+		proto = ip6h->nexthdr;
+		offset += sizeof(header);
+		/* Local parsing avoids a built-in XFRM dependency on modular IPv6. */
+		for (;;) {
+			struct ipv6_opt_hdr option, *opt;
+			unsigned int length;
+
+			if (proto == NEXTHDR_FRAGMENT) {
+				struct frag_hdr fragment, *fh;
+
+				fh = skb_header_pointer(skb, offset,
+							sizeof(fragment), &fragment);
+				return fh && !(fh->frag_off & htons(IP6_OFFSET));
+			}
+			if (proto != NEXTHDR_HOP && proto != NEXTHDR_ROUTING &&
+			    proto != NEXTHDR_AUTH && proto != NEXTHDR_DEST)
+				return true;
+			opt = skb_header_pointer(skb, offset, sizeof(option), &option);
+			if (!opt)
+				return false;
+			length = proto == NEXTHDR_AUTH ? (opt->hdrlen + 2) * 4 :
+				 (opt->hdrlen + 1) * 8;
+			if (length > skb->len - offset)
+				return false;
+			proto = opt->nexthdr;
+			offset += length;
+		}
+	}
+#endif
+	return true;
+}
