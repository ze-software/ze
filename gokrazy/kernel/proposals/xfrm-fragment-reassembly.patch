+/* No namespace, policy, device or socket reference may enter this object.
+ * The live policy MUST own one current generation; each capture MUST own
+ * another reference, released independently of policy/socket destruction.
+ */
+struct xfrm_policy_receipt {
+	refcount_t refs;
+	u32 genid;
+	unsigned int charge;
+	u32 priority;
+	u32 index;
+	u32 if_id;
+	struct xfrm_mark mark;
+	struct xfrm_selector selector;
+	struct xfrm_lifetime_cfg lft;
+	struct xfrm_lifetime_cur curlft;
+	u8 type;
+	u8 action;
+	u8 flags;
+	u8 xfrm_nr;
+	u16 family;
+	struct xfrm_sec_ctx *security;
+	struct xfrm_tmpl xfrm_vec[XFRM_MAX_DEPTH];
+};
+
+void xfrm_policy_receipt_get(struct xfrm_policy_receipt *receipt)
+{
+	if (receipt)
+		refcount_inc(&receipt->refs);
+}
+EXPORT_SYMBOL_GPL(xfrm_policy_receipt_get);
+
+void xfrm_policy_receipt_put(struct xfrm_policy_receipt *receipt)
+{
+	if (receipt && refcount_dec_and_test(&receipt->refs)) {
+		security_xfrm_policy_free(receipt->security);
+		kfree(receipt);
+	}
+}
+EXPORT_SYMBOL_GPL(xfrm_policy_receipt_put);
+
+unsigned int xfrm_policy_receipt_size(const struct xfrm_policy_receipt *receipt)
+{
+	return receipt ? receipt->charge : 0;
+}
+EXPORT_SYMBOL_GPL(xfrm_policy_receipt_size);
+
+/* Caller holds pol->lock for write with BH disabled. The security clone
+ * hook, like the existing socket policy clone, MUST allocate atomically.
+ */
+static struct xfrm_policy_receipt *
+xfrm_policy_receipt_alloc(const struct xfrm_policy *pol)
+{
+	struct xfrm_policy_receipt *receipt;
+	size_t charge;
+	int err;
+
+	if (pol->xfrm_nr > XFRM_MAX_DEPTH)
+		return ERR_PTR(-EINVAL);
+	receipt = kzalloc_obj(struct xfrm_policy_receipt, GFP_ATOMIC);
+	if (!receipt)
+		return ERR_PTR(-ENOMEM);
+	refcount_set(&receipt->refs, 1);
+	err = security_xfrm_policy_clone(pol->security, &receipt->security);
+	if (err)
+		goto fail;
+	charge = ksize(receipt);
+	if (receipt->security &&
+	    check_add_overflow(charge, ksize(receipt->security), &charge)) {
+		err = -EOVERFLOW;
+		goto fail;
+	}
+	if (charge > UINT_MAX) {
+		err = -EOVERFLOW;
+		goto fail;
+	}
+	receipt->charge = charge;
+	receipt->genid = atomic_read(&pol->genid);
+	receipt->priority = pol->priority;
+	receipt->index = pol->index;
+	receipt->if_id = pol->if_id;
+	receipt->mark = pol->mark;
+	receipt->selector = pol->selector;
+	receipt->lft = pol->lft;
+	receipt->curlft = pol->curlft;
+	receipt->type = pol->type;
+	receipt->action = pol->action;
+	receipt->flags = pol->flags;
+	receipt->xfrm_nr = pol->xfrm_nr;
+	receipt->family = pol->family;
+	memcpy(receipt->xfrm_vec, pol->xfrm_vec,
+	       pol->xfrm_nr * sizeof(struct xfrm_tmpl));
+	return receipt;
+fail:
+	xfrm_policy_receipt_put(receipt);
+	return ERR_PTR(err);
+}
+
+/* An absent policy is an explicit NULL receipt, not permission to consult a
+ * later socket. RCU protects the original only until the copy is complete.
+ */
+struct xfrm_policy_receipt *xfrm_policy_receipt_capture(const struct sock *sk)
+{
+	struct xfrm_policy_receipt *receipt = NULL, *old = NULL;
+	struct xfrm_policy *pol;
+
+	rcu_read_lock();
+	pol = rcu_dereference(sk->sk_policy[XFRM_POLICY_OUT]);
+	if (!pol)
+		goto out;
+	write_lock_bh(&pol->lock);
+	receipt = pol->raw_receipt;
+	if (!receipt || receipt->genid != atomic_read(&pol->genid)) {
+		receipt = xfrm_policy_receipt_alloc(pol);
+		if (IS_ERR(receipt))
+			goto unlock;
+		old = pol->raw_receipt;
+		pol->raw_receipt = receipt;
+	}
+	xfrm_policy_receipt_get(receipt);
+unlock:
+	write_unlock_bh(&pol->lock);
+out:
+	rcu_read_unlock();
+	xfrm_policy_receipt_put(old);
+	return receipt;
+}
+EXPORT_SYMBOL_GPL(xfrm_policy_receipt_capture);
+
+/* Fresh, unpublished and dead from birth: no timers, offload, state-cache
+ * links, guard ownership or receipt-owner ref may outlive this lookup.
+ * The bundle MUST take normal ownership, or the caller MUST put the policy.
+ */
+static struct xfrm_policy *
+xfrm_policy_from_receipt(struct net *net,
+			 const struct xfrm_policy_receipt *receipt)
+{
+	struct xfrm_policy *pol = xfrm_policy_alloc(net, GFP_ATOMIC);
+	int err;
+
+	if (!pol)
+		return ERR_PTR(-ENOMEM);
+	pol->walk.dead = 1;
+	pol->detached_receipt = true;
+	err = security_xfrm_policy_clone(receipt->security, &pol->security);
+	if (err) {
+		xfrm_pol_put(pol);
+		return ERR_PTR(err);
+	}
+	atomic_set(&pol->genid, receipt->genid);
+	pol->priority = receipt->priority;
+	pol->index = receipt->index;
+	pol->if_id = receipt->if_id;
+	pol->mark = receipt->mark;
+	pol->selector = receipt->selector;
+	pol->lft = receipt->lft;
+	pol->curlft = receipt->curlft;
+	pol->type = receipt->type;
+	pol->action = receipt->action;
+	pol->flags = receipt->flags;
+	pol->xfrm_nr = receipt->xfrm_nr;
+	pol->family = receipt->family;
+	memcpy(pol->xfrm_vec, receipt->xfrm_vec,
+	       receipt->xfrm_nr * sizeof(struct xfrm_tmpl));
+	return pol;
+}
