new file mode 100644
--- /dev/null
+++ b/net/xfrm/xfrm_fragment.c
@@ -0,0 +1,395 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* RFC 4301 Sections 7.1, 7.3 and 7.4 -- see rfc/short/rfc4301.md. */
+
+#include <linux/init.h>
+#include <linux/netfilter.h>
+#include <linux/netfilter_ipv4.h>
+#include <linux/netfilter_ipv6.h>
+#include <net/ip.h>
+#include <net/ip6_route.h>
+#include <net/ipv6_frag.h>
+#include <net/l3mdev.h>
+#include <net/route.h>
+#include <net/netfilter/ipv4/nf_defrag_ipv4.h>
+#include <net/netfilter/ipv6/nf_defrag_ipv6.h>
+#include <net/xfrm.h>
+
+static bool xfrm_fragment_ready __ro_after_init;
+
+bool xfrm_fragment_guard_ready(void)
+{
+	return READ_ONCE(xfrm_fragment_ready);
+}
+EXPORT_SYMBOL_GPL(xfrm_fragment_guard_ready);
+
+/* A stack capture MUST be released on every send exit. It owns no socket,
+ * namespace or original policy; absence is captured just as explicitly.
+ */
+int xfrm_raw_route_capture(struct xfrm_raw_route *saved, const struct sock *sk,
+			   const void *flow, unsigned short family)
+{
+	struct xfrm_policy_receipt *receipt;
+
+	if (family != AF_INET && family != AF_INET6)
+		return -EAFNOSUPPORT;
+	receipt = xfrm_policy_receipt_capture(sk);
+	if (IS_ERR(receipt))
+		return PTR_ERR(receipt);
+	memset(saved, 0, sizeof(*saved));
+	saved->policy = receipt;
+	saved->sk_mark = READ_ONCE(sk->sk_mark);
+	saved->bound = !!READ_ONCE(sk->sk_bound_dev_if);
+	saved->family = family;
+	if (family == AF_INET) {
+		memcpy(&saved->flow.u.ip4, flow, sizeof(struct flowi4));
+	} else {
+		memcpy(&saved->flow.u.ip6, flow, sizeof(struct flowi6));
+		saved->srcprefs = READ_ONCE(inet6_sk(sk)->srcprefs);
+	}
+	return 0;
+}
+EXPORT_SYMBOL_GPL(xfrm_raw_route_capture);
+
+void xfrm_raw_route_release(struct xfrm_raw_route *saved)
+{
+	xfrm_policy_receipt_put(saved->policy);
+	saved->policy = NULL;
+}
+EXPORT_SYMBOL_GPL(xfrm_raw_route_release);
+
+/* The extension MUST own a reference distinct from the sender's stack.
+ * skb_ext_add initializes new slots and releases inactive reused slots.
+ */
+int xfrm_raw_route_save(struct sk_buff *skb, const struct xfrm_raw_route *seed)
+{
+	struct xfrm_raw_route *saved;
+
+	saved = skb_ext_add(skb, SKB_EXT_XFRM_RAW_ROUTE);
+	if (!saved)
+		return -ENOMEM;
+	xfrm_policy_receipt_get(seed->policy);
+	xfrm_policy_receipt_put(saved->policy);
+	*saved = *seed;
+	return 0;
+}
+EXPORT_SYMBOL_GPL(xfrm_raw_route_save);
+
+/* RFC 4301 Section 7.4: "All implementations MUST support DISCARDing of
+ * fragments using the normal SPD packet classification mechanisms."
+ * xfrm_fragment_local_out applies that classification to the whole packet.
+ */
+static int xfrm_fragment_route(struct sk_buff *skb,
+			       const struct nf_hook_state *state,
+			       unsigned short family)
+{
+	const struct xfrm_raw_route *saved;
+	struct sock *sk = sk_to_full_sk(state->sk);
+	struct net_device *dev = skb_dst_dev(skb);
+	struct dst_entry *dst;
+	struct flowi fl;
+	unsigned int hh_len;
+	u8 proto, flags;
+	int err;
+
+	/* The quote decoder deliberately accepts truncated quoted payloads.
+	 * Here a whole packet MUST contain the full declared IP length.
+	 */
+	if (family == AF_INET) {
+		if (!pskb_may_pull(skb, sizeof(struct iphdr)) ||
+		    ip_hdr(skb)->version != 4 ||
+		    ntohs(ip_hdr(skb)->tot_len) != skb->len ||
+		    ip_is_fragment(ip_hdr(skb)))
+			return -EINVAL;
+	} else {
+		if (!pskb_may_pull(skb, sizeof(struct ipv6hdr)) ||
+		    ipv6_hdr(skb)->version != 6 ||
+		    (ipv6_hdr(skb)->payload_len &&
+		     ntohs(ipv6_hdr(skb)->payload_len) + sizeof(struct ipv6hdr) !=
+		     skb->len))
+			return -EINVAL;
+	}
+	err = xfrm_decode_session_fields(state->net, skb, &fl, family, false);
+	if (err)
+		return err;
+	if (!(fl.flowi_flags & FLOWI_FLAG_XFRM_PROTO))
+		return -EINVAL;
+
+	saved = skb_ext_find(skb, SKB_EXT_XFRM_RAW_ROUTE);
+	if (saved) {
+		if (saved->family != family)
+			return -EINVAL;
+		proto = fl.flowi_proto;
+		flags = fl.flowi_flags;
+		fl.u.__fl_common = saved->flow.u.__fl_common;
+		fl.flowi_proto = proto;
+		fl.flowi_flags |= flags;
+		if (family == AF_INET6)
+			fl.u.ip6.flowlabel = saved->flow.u.ip6.flowlabel;
+	} else {
+		fl.flowi_iif = LOOPBACK_IFINDEX;
+		fl.flowi_oif = sk ? sk->sk_bound_dev_if : 0;
+		fl.flowi_l3mdev = l3mdev_master_ifindex(dev);
+		fl.flowi_uid = sock_net_uid(state->net, sk);
+		fl.flowi_flags |= sk ? inet_sk_flowi_flags(sk) : 0;
+		if (family == AF_INET) {
+			fl.u.ip4.flowi4_scope = RT_SCOPE_UNIVERSE;
+		} else if (!fl.flowi_oif &&
+			   (ipv6_addr_type(&fl.u.ip6.daddr) &
+			    (IPV6_ADDR_MULTICAST | IPV6_ADDR_LINKLOCAL))) {
+			fl.flowi_oif = dev->ifindex;
+		}
+		if (family == AF_INET6)
+			fl.u.ip6.flowlabel = ip6_flowinfo(ipv6_hdr(skb));
+	}
+
+	if (family == AF_INET) {
+		struct rtable *rt;
+
+		rt = ip_route_output_key(state->net, &fl.u.ip4);
+		if (IS_ERR(rt))
+			return PTR_ERR(rt);
+		dst = &rt->dst;
+		/* Match ip_route_output_flow after the preserved oif selected
+		 * the ordinary route: XFRM sees that route's actual interface.
+		 */
+		fl.u.ip4.flowi4_oif = dst->dev->ifindex;
+	} else {
+		if (saved)
+			err = ip6_dst_lookup_params(state->net, &dst, &fl.u.ip6,
+						    saved->bound, saved->srcprefs);
+		else
+			err = ip6_dst_lookup(state->net, sk, &dst, &fl.u.ip6);
+		if (err)
+			return err;
+	}
+	/* Drop even a cached XFRM dst. Only the completed datagram's freshly
+	 * decoded flow can authorize its route. xfrm_lookup consumes dst.
+	 */
+	skb_dst_drop(skb);
+	if (saved)
+		dst = xfrm_lookup_raw(state->net, dst, &fl, saved);
+	else
+		dst = xfrm_lookup(state->net, dst, &fl, sk, 0);
+	if (IS_ERR(dst))
+		return PTR_ERR(dst);
+	skb_dst_set(skb, dst);
+	if (dst->error)
+		return dst->error;
+	hh_len = dst->dev->hard_header_len;
+	if (skb_headroom(skb) < hh_len &&
+	    pskb_expand_head(skb, HH_DATA_ALIGN(hh_len - skb_headroom(skb)),
+			     0, GFP_ATOMIC))
+		return -ENOMEM;
+	/* Exclusive deletion drops this receipt; shared extensions retain theirs. */
+	skb_ext_del(skb, SKB_EXT_XFRM_RAW_ROUTE);
+	return 0;
+}
+
+static bool xfrm_fragment_inbound_allowed(struct sk_buff *skb,
+					 struct net *net)
+{
+	const struct sec_path *sp = skb_sec_path(skb);
+	unsigned int i;
+
+	if (!sp)
+		return true;
+	if (sp->len > XFRM_MAX_DEPTH)
+		goto reject;
+	for (i = 0; i < sp->len; i++)
+		if (!xfrm_state_noninitial_allowed(sp->xvec[i]))
+			goto reject;
+	return true;
+
+reject:
+	XFRM_INC_STATS(net, LINUX_MIB_XFRMINSTATEMISMATCH);
+	return false;
+}
+
+unsigned int xfrm4_fragment_gather(struct sk_buff *skb,
+				 const struct nf_hook_state *state,
+				 bool force, bool *reassembled)
+{
+	u32 user;
+	int err;
+
+	*reassembled = false;
+	if (!force && !atomic_read(&state->net->xfrm.fragment_guard_refs))
+		return NF_ACCEPT;
+	if (!ip_is_fragment(ip_hdr(skb)))
+		return NF_ACCEPT;
+	if ((ip_hdr(skb)->frag_off & htons(IP_OFFSET)) &&
+	    !xfrm_fragment_inbound_allowed(skb, state->net))
+		return NF_DROP;
+
+	/* Preserve the existing direction, bridge and visible zone mapping.
+	 * The disjoint XFRM range never changes conntrack or NOTRACK state.
+	 */
+	user = IP_DEFRAG_XFRM_IN +
+		nf_ct_defrag_user(state->hook, skb) - IP_DEFRAG_CONNTRACK_IN;
+	local_bh_disable();
+	err = ip_defrag(state->net, skb, user);
+	local_bh_enable();
+	if (err)
+		return NF_STOLEN;
+	skb->ignore_df = 1;
+	*reassembled = true;
+	return NF_ACCEPT;
+}
+
+unsigned int xfrm6_fragment_gather(struct sk_buff *skb,
+				 const struct nf_hook_state *state,
+				 bool force, bool *reassembled)
+{
+	struct frag_hdr header, *fh;
+	unsigned int offset = 0;
+	unsigned short fragoff;
+	u32 user;
+	int err;
+
+	*reassembled = false;
+	if (!force && !atomic_read(&state->net->xfrm.fragment_guard_refs))
+		return NF_ACCEPT;
+	err = ipv6_find_hdr(skb, &offset, NEXTHDR_FRAGMENT, &fragoff, NULL);
+	if (err == -ENOENT)
+		return NF_ACCEPT;
+	if (err < 0)
+		return NF_DROP;
+	/* A Fragment header is forbidden in a Jumbo Payload packet. */
+	if (!ipv6_hdr(skb)->payload_len)
+		return NF_DROP;
+	fh = skb_header_pointer(skb, offset, sizeof(header), &header);
+	if (!fh)
+		return NF_DROP;
+	/* Atomic fragments keep the existing continuation without a queue. */
+	if (!(fh->frag_off & htons(IP6_OFFSET | IP6_MF)))
+		return NF_ACCEPT;
+	if (fragoff && !xfrm_fragment_inbound_allowed(skb, state->net))
+		return NF_DROP;
+
+	user = IP6_DEFRAG_XFRM_IN +
+		nf_ct6_defrag_user(state->hook, skb) - IP6_DEFRAG_CONNTRACK_IN;
+	err = nf_ct_frag6_gather(state->net, skb, user);
+	if (err == -EINPROGRESS)
+		return NF_STOLEN;
+	if (err)
+		return NF_DROP;
+	/* Gather also returns zero for malformed-fragment continuation.
+	 * Only a packet whose fragment header was removed is reassembled.
+	 */
+	offset = 0;
+	err = ipv6_find_hdr(skb, &offset, NEXTHDR_FRAGMENT, NULL, NULL);
+	if (err != -ENOENT)
+		return NF_DROP;
+	*reassembled = true;
+	return NF_ACCEPT;
+}
+
+static unsigned int xfrm4_fragment_prerouting(void *priv,
+					     struct sk_buff *skb,
+					     const struct nf_hook_state *state)
+{
+	bool reassembled;
+
+	return xfrm4_fragment_gather(skb, state, false, &reassembled);
+}
+
+static unsigned int xfrm6_fragment_prerouting(void *priv,
+					     struct sk_buff *skb,
+					     const struct nf_hook_state *state)
+{
+	bool reassembled;
+
+	return xfrm6_fragment_gather(skb, state, false, &reassembled);
+}
+
+static unsigned int xfrm_fragment_local_out(struct sk_buff *skb,
+					    const struct nf_hook_state *state,
+					    unsigned short family)
+{
+	bool deferred = skb_ext_exist(skb, SKB_EXT_XFRM_RAW_ROUTE);
+	bool reassembled;
+	unsigned int verdict;
+	int err;
+
+	/* Omitted raw lookup remains owed after the last guard is destroyed. */
+	if (family == AF_INET)
+		verdict = xfrm4_fragment_gather(skb, state, deferred, &reassembled);
+	else
+		verdict = xfrm6_fragment_gather(skb, state, deferred, &reassembled);
+	if (verdict != NF_ACCEPT)
+		return verdict;
+	if (!reassembled && !deferred)
+		return NF_ACCEPT;
+	err = xfrm_fragment_route(skb, state, family);
+	return err ? NF_DROP_ERR(err) : NF_ACCEPT;
+}
+
+static unsigned int xfrm4_fragment_local_out(void *priv, struct sk_buff *skb,
+					    const struct nf_hook_state *state)
+{
+	return xfrm_fragment_local_out(skb, state, AF_INET);
+}
+
+static unsigned int xfrm6_fragment_local_out(void *priv, struct sk_buff *skb,
+					    const struct nf_hook_state *state)
+{
+	return xfrm_fragment_local_out(skb, state, AF_INET6);
+}
+
+static const struct nf_hook_ops xfrm_fragment_ops[] = {
+	{
+		.hook = xfrm4_fragment_prerouting,
+		.pf = NFPROTO_IPV4,
+		.hooknum = NF_INET_PRE_ROUTING,
+		.priority = NF_IP_PRI_CONNTRACK_DEFRAG - 1,
+	},
+	{
+		.hook = xfrm6_fragment_prerouting,
+		.pf = NFPROTO_IPV6,
+		.hooknum = NF_INET_PRE_ROUTING,
+		.priority = NF_IP6_PRI_CONNTRACK_DEFRAG - 1,
+	},
+	{
+		.hook = xfrm4_fragment_local_out,
+		.pf = NFPROTO_IPV4,
+		.hooknum = NF_INET_LOCAL_OUT,
+		.priority = NF_IP_PRI_CONNTRACK_DEFRAG - 1,
+	},
+	{
+		.hook = xfrm6_fragment_local_out,
+		.pf = NFPROTO_IPV6,
+		.hooknum = NF_INET_LOCAL_OUT,
+		.priority = NF_IP6_PRI_CONNTRACK_DEFRAG - 1,
+	},
+};
+
+static int __net_init xfrm_fragment_net_init(struct net *net)
+{
+	return nf_register_net_hooks(net, xfrm_fragment_ops,
+				     ARRAY_SIZE(xfrm_fragment_ops));
+}
+
+static void __net_exit xfrm_fragment_net_exit(struct net *net)
+{
+	nf_unregister_net_hooks(net, xfrm_fragment_ops,
+				ARRAY_SIZE(xfrm_fragment_ops));
+}
+
+static struct pernet_operations xfrm_fragment_net_ops = {
+	.init = xfrm_fragment_net_init,
+	.exit = xfrm_fragment_net_exit,
+};
+
+/* Both built-in defrag families initialize their fqdirs at module_init.
+ * Register later so every namespace has those bounded queues before hooks.
+ * Per-net exit MUST remove the hooks before the earlier fqdir exits run.
+ */
+static int __init xfrm_fragment_init(void)
+{
+	int err = register_pernet_subsys(&xfrm_fragment_net_ops);
+
+	if (!err)
+		WRITE_ONCE(xfrm_fragment_ready, true);
+	return err;
+}
+late_initcall(xfrm_fragment_init);
