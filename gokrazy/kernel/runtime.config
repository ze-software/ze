# Release suffix. `uname -r` reads <version>-ze, so /boot and /lib/modules
# entries never collide with another kernel built from the same upstream
# release; `le setup docker kernel install` refuses a release without it.
CONFIG_LOCALVERSION="-ze"

# Runtime kernel modules. The kernel package carries the module tree this
# build installs. gokrazy's own boot loader inserts only pwm-fan.ko, and this
# file builds pwm-fan in, so gokrazy loads no module; the loadable hardware
# drivers below reach a device only through a loader that inserts them.
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

# USB mass storage.
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_STORAGE=y

# NVMe storage.
CONFIG_NVME_CORE=y
CONFIG_BLK_DEV_NVME=y
CONFIG_NVME_MULTIPATH=y
CONFIG_NVME_HWMON=y
CONFIG_NVME_TARGET_PASSTHRU=y

# Watchdogs and fan control, built in. gokrazy opens the watchdog at boot, and
# gokrazy attempts to load pwm-fan before services.
CONFIG_SP5100_TCO=y
CONFIG_I6300ESB_WDT=y
CONFIG_HWMON=y
CONFIG_PWM=y
CONFIG_SENSORS_PWM_FAN=y

# Physical-hardware drivers are loadable (=m), and so are the facilities no Ze
# feature uses at boot but a host may want; everything else stays built in.
#
# One kernel boots on hardware, under QEMU and under Xen. A driver for a
# physical device is a module, so a guest holds in memory only the drivers of
# the devices it has, and a machine loads a driver only when its device is
# present. A facility Ze never uses (the NFS client, software RAID, device
# mapper; listed after the drivers) is a module for the same reason: a host
# that wants it loads it, and the appliance never does.
#
# Built in, always: every networking feature Ze configures (routing,
# firewall, IPsec, WireGuard, MPLS, traffic control, PPP/L2TP, tunnels), which
# never depends on module loading; virtio; the Xen guest frontends; storage
# (NVMe, SATA/AHCI, SCSI disk, USB host controllers, USB storage); the HID core
# with generic and USB HID for a keyboard; the watchdogs and fan control above;
# KVM; and the console. gokrazy inserts none of these modules, so a device
# whose driver is here, or a facility listed after the drivers, is absent until
# a loader inserts it.
#
# Only drivers with a Kconfig prompt are listed. The promptless helpers they
# select (LIBIE, PHY_PACKAGE, FWNODE_MDIO, ACPI_MDIO, SND_PCM, SND_HDA_CORE,
# DRM_TTM, DRM_BUDDY, DRM_DISPLAY_HELPER, INTEL_GTT) follow their users to =m.
# An =m line cannot demote a symbol a built-in one selects. A symbol an
# architecture lacks (AGP_AMD64, SENSORS_K10TEMP, EEEPC_LAPTOP on arm64) is
# dropped there by Kconfig, as the x86 lines elsewhere in this file are.
#
# Ethernet NICs, the PHY layer and USB network adapters. MLX5_CORE_EN is a bool
# option of the mlx5 module (its Ethernet function), not a driver of its own.
CONFIG_8139TOO=m
CONFIG_BNXT=m
CONFIG_E100=m
CONFIG_E1000=m
CONFIG_E1000E=m
CONFIG_FORCEDETH=m
CONFIG_I40E=m
CONFIG_ICE=m
CONFIG_IGB=m
CONFIG_IGC=m
CONFIG_MLX5_CORE=m
CONFIG_MLX5_CORE_EN=y
CONFIG_MLX5_INFINIBAND=n
CONFIG_R8169=m
CONFIG_SKY2=m
CONFIG_TIGON3=m
CONFIG_PHYLIB=m
CONFIG_REALTEK_PHY=m
CONFIG_USB_NET_DRIVERS=m
# Wireless.
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_RFKILL=m
CONFIG_RTL_CARDS=m
# Sound.
CONFIG_SOUND=m
CONFIG_SND=m
CONFIG_SND_HDA_INTEL=m
CONFIG_SND_HRTIMER=m
CONFIG_SND_SEQUENCER=m
CONFIG_SND_SEQ_DUMMY=m
# Graphics. DRM itself stays built in: efi-console.config asks for
# DRM_SIMPLEDRM=y, the EFI framebuffer console, and DRM_SIMPLEDRM depends on
# DRM. AGP stays built in for the same reason: DRM `depends on (AGP || AGP=n)`
# (drivers/gpu/drm/Kconfig), so AGP=m would cap DRM, and simpledrm with it, at
# =m. virtio-gpu stays built in with the rest of virtio.
CONFIG_DRM_I915=m
CONFIG_AGP_AMD64=m
CONFIG_AGP_INTEL=m
# Sensors (fan control stays built in above).
CONFIG_SENSORS_K10TEMP=m
CONFIG_SENSORS_NCT6683=m
CONFIG_SENSORS_CORSAIR_CPRO=m
# PC Card.
CONFIG_PCCARD=m
CONFIG_PCMCIA=m
CONFIG_YENTA=m
# Vendor-specific HID devices. HID, HID_GENERIC and USB_HID stay built in.
CONFIG_HID_GYRATION=m
CONFIG_HID_NTRIG=m
CONFIG_HID_PANTHERLORD=m
CONFIG_HID_PETALYNX=m
CONFIG_HID_SAMSUNG=m
CONFIG_HID_SONY=m
CONFIG_HID_SUNPLUS=m
CONFIG_HID_TOPSEED=m
# Laptop platform drivers.
CONFIG_EEEPC_LAPTOP=m
#
# Facilities no Ze feature uses at boot, loadable for a host that wants them.
#
# NFS client. Ze never mounts NFS. The defconfig builds the client in; NFS_FS,
# NFS_V3 and NFS_V4 are tristate and are requested as modules. Their bool
# options (NFS_V3_ACL, NFS_V4_0) stay options of the modules, and the layers
# with no prompt of their own (SUNRPC, LOCKD, GRACE_PERIOD, NFS_COMMON,
# NFS_ACL_SUPPORT, the pNFS layouts) follow the modules that use them.
# ROOT_NFS depends on NFS_FS=y, so it drops out: this kernel cannot mount its
# root file system over NFS. Ze's appliance and installer never do, and no
# require manifest names an NFS or RPC symbol.
CONFIG_NFS_FS=m
CONFIG_NFS_V3=m
CONFIG_NFS_V4=m
# Software RAID and device mapper. Ze assembles no array and maps no device.
# The defconfig children (MD_BITMAP, DM_MIRROR, DM_ZERO) follow their parent.
CONFIG_BLK_DEV_MD=m
CONFIG_BLK_DEV_DM=m

# WireGuard and tunnel support.
CONFIG_NET_UDP_TUNNEL=y
CONFIG_WIREGUARD=y
CONFIG_TUN=y

# Traffic shaping and diagnostics.
CONFIG_NET_SCH_TBF=y
CONFIG_INET_DIAG=y

# Virtual and bridged interfaces.
CONFIG_MACVLAN=y
CONFIG_BRIDGE=y
CONFIG_VETH=y

# Virtio drivers for QEMU and evidence VMs.
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_RING=y

# Xen guest support, guest side only, built in like virtio: a Xen guest needs
# its console, disk and network before any loader runs. No Xen boot of this
# kernel has been proven yet.
#
# XEN is "Xen guest support" on x86 (arch/x86/xen/Kconfig, depends on
# PARAVIRT, which x86 defconfig sets) and "Xen guest support on ARM64" on arm64
# (arch/arm64/Kconfig). XEN_PVH is the PVH guest entry and XEN_PVHVM_GUEST the
# HVM guest; both exist on x86 only, so runtime.require cannot name them.
# HVC_XEN is the Xen console (hvc0), XEN_BLKDEV_FRONTEND the xvd disks and
# XEN_NETDEV_FRONTEND the vif NICs the toolstack gives the guest.
CONFIG_XEN=y
CONFIG_XEN_PVH=y
CONFIG_XEN_PVHVM_GUEST=y
CONFIG_HVC_XEN=y
CONFIG_XEN_BLKDEV_FRONTEND=y
CONFIG_XEN_NETDEV_FRONTEND=y
# The host side and legacy PV stay off. XEN_PV is `default y` once XEN is set,
# XEN_DOM0 defaults from XEN_PV and XEN_BACKEND from XEN_DOM0, so each is
# turned off here rather than left to its default. XEN_BACKEND gates every
# backend driver; the block and network backends are named too. XENFS (which
# selects XEN_PRIVCMD), XEN_PRIVCMD, XEN_DEV_EVTCHN, XEN_GNTDEV and
# XEN_GRANT_DEV_ALLOC are the toolstack's userspace devices, which Ze does not
# open; each defaults to y or m (drivers/xen/Kconfig).
CONFIG_XEN_PV=n
CONFIG_XEN_DOM0=n
CONFIG_XEN_BACKEND=n
CONFIG_XEN_BLKDEV_BACKEND=n
CONFIG_XEN_NETDEV_BACKEND=n
CONFIG_XENFS=n
CONFIG_XEN_PRIVCMD=n
CONFIG_XEN_DEV_EVTCHN=n
CONFIG_XEN_GNTDEV=n
CONFIG_XEN_GRANT_DEV_ALLOC=n

# KVM-accelerated nested QEMU VMs.
CONFIG_KVM=y
CONFIG_KVM_INTEL=y
CONFIG_KVM_AMD=y
CONFIG_KVM_AMD_SEV=y

CONFIG_EFIVAR_FS=y

# Ryzen CPUs.
CONFIG_X86_AMD_PLATFORM_DEVICE=y
CONFIG_CPU_FREQ_DEFAULT_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_X86_POWERNOW_K8=y
CONFIG_X86_AMD_FREQ_SENSITIVITY=y

# Include hardware interrupt CPU usage in /proc/stat CPU time reporting.
CONFIG_IRQ_TIME_ACCOUNTING=y

# Container runtimes.
CONFIG_BPF_SYSCALL=y
# eBPF JIT: used by the traffic-usage plugin (eBPF TCX byte accounting) for
# acceptable per-packet performance. TCX link attach itself needs no dedicated
# Kconfig symbol on kernel >= 6.6 (it lives in net/core, gated by CONFIG_NET).
CONFIG_BPF_JIT=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_BPF=y
CONFIG_SOCK_CGROUP_DATA=y
CONFIG_NET_SOCK_MSG=y
CONFIG_OVERLAY_FS=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_NAT=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_MARK=y
CONFIG_CGROUP_PIDS=y

# Containers Ze runs itself (internal/plugins/container). CFS_BANDWIDTH is the
# hard CPU limit of a container's `cpu` statement: without it a control group
# has no cpu.max file. It depends on FAIR_GROUP_SCHED, which defaults to
# CGROUP_SCHED (requested below, with Docker's options) and is requested here
# so the dependency does not rest on a default. The plugin enrols
# CFS_BANDWIDTH as a kernel capability (kernelcap_linux.go), and
# runtime.require declares both, with TMPFS and MEMFD_CREATE, which a
# container's memory-backed mounts and its sealed init binary need.
# MEMFD_CREATE has no prompt: kconfig sets it when TMPFS is set.
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y

# Docker. Every Docker host Ze's labs use runs this kernel (the docker-hosts
# spec, decision D-5), so the options dockerd needs are requested here and
# declared in runtime.require. The list is moby's contrib/check-config.sh at
# commit 9fabd6dfbb926381278c436a866bc8d6ac222274: its "Generally Necessary"
# check_flags for a 5.3+ kernel, plus OVERLAY_FS, USER_NS, SECCOMP,
# SECCOMP_FILTER and CGROUP_PIDS from "Optional Features", which Docker's
# default storage driver and seccomp profile use. Symbols that already sit
# elsewhere in this file or in kernel.config (NAMESPACES, NET_NS,
# CGROUP_FREEZER, CGROUP_BPF, VETH, BRIDGE, IP_NF_NAT, IP_NF_TARGET_MASQUERADE,
# NETFILTER_XT_MARK, NF_NAT, OVERLAY_FS, CGROUP_PIDS) are not repeated, and
# SECCOMP and SECCOMP_FILTER come from the base defconfig. The iptables,
# ip6tables and IPVS parents are requested so the symbols that depend on them
# can be set; runtime.require declares the parents and their dependents alike,
# so the build fails if kconfig drops one. Since Linux 6.17 the iptables
# filter, mangle, raw and nat tables depend on IP_NF_IPTABLES_LEGACY and
# IP6_NF_IPTABLES_LEGACY, which depend on NETFILTER_XTABLES_LEGACY, so those
# three parents are requested too (net/ipv4/netfilter/Kconfig,
# net/ipv6/netfilter/Kconfig, net/netfilter/Kconfig in 7.2.9).
CONFIG_PID_NS=y
CONFIG_IPC_NS=y
CONFIG_UTS_NS=y
CONFIG_USER_NS=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_SCHED=y
CONFIG_CPUSETS=y
CONFIG_MEMCG=y
CONFIG_KEYS=y
CONFIG_POSIX_MQUEUE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_IPTABLES_LEGACY=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP_NF_RAW=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_IPTABLES_LEGACY=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_MANGLE=y
CONFIG_IP6_NF_RAW=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_IP_VS=y
CONFIG_NETFILTER_XT_MATCH_IPVS=y

# What the Docker host itself relies on, beyond Docker. A Linux Docker host
# boots this kernel (D-5), so its interface names and its firewall must come
# up as they did under the distro kernel it replaces, or the host boots with no
# network or no firewall (owner's Ubuntu host, 2026-10-14). `le setup
# docker-kernel install` refuses a kernel lacking one of these for a host that
# relies on it, and a test keeps every option its tables name =y here
# (internal/le/setup/docker/kernel/hostdeps.go).
# An interface named by its PCI slot (ens18 on QEMU and Proxmox) keeps that
# name only when a hotplug driver publishes /sys/bus/pci/slots: acpiphp for
# ACPI slots, pciehp for PCIe root ports. Without them udev names it by path
# (enp0s18) and netplan's config for ens18 matches nothing.
CONFIG_HOTPLUG_PCI=y
CONFIG_HOTPLUG_PCI_ACPI=y
CONFIG_HOTPLUG_PCI_PCIE=y
# Ubuntu's stock UFW rule set: limit and LOG for its logging chains, REJECT
# for its reject policy, recent for `ufw limit`, hl and rt for its ICMPv6 and
# routing-header rules (/usr/share/ufw/iptables/*.rules). multiport, comment,
# addrtype and conntrack are requested above. ufw.service fails with
# "Extension limit revision 0 not supported" on a kernel without them.
# ipv6header and state are not in UFW's stock rules; hand-written ip6tables
# and older iptables rule sets load them, and the defconfig alone set them.
CONFIG_NETFILTER_XT_MATCH_LIMIT=y
CONFIG_NETFILTER_XT_MATCH_RECENT=y
CONFIG_NETFILTER_XT_MATCH_HL=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_IP6_NF_TARGET_REJECT=y
CONFIG_IP6_NF_MATCH_HL=y
CONFIG_IP6_NF_MATCH_RT=y
CONFIG_IP6_NF_MATCH_IPV6HEADER=y
CONFIG_NETFILTER_XT_MATCH_STATE=y

# TCP BBR as default congestion control.
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_BBR=y
CONFIG_DEFAULT_TCP_CONG="bbr"

# TCP-MD5 for configured BGP sessions: setTCPMD5Sig in internal/core/network.
# Linux 7.2 selects CRYPTO_LIB_MD5 and CRYPTO_LIB_UTILS from this bool.
# Without it the runtime kernel rejects TCP_MD5SIG with ENOPROTOOPT.
CONFIG_TCP_MD5SIG=y

# Ze L2TP/PPP/PPPoE deployment support. Keep these built into the runtime kernel.
# L2TP_NETLINK was removed in kernel 7.0 (netlink is always built with L2TP).
# CONFIG_PPPOE provides the AF_PPPOX PX_PROTO_OE session path used by the
# pppoe access concentrator and the ze pppoe-client (RFC 2516); the QEMU
# pppoe-accel evidence test (ze-qemu-pppoe-accel-test) needs it built in.
CONFIG_PPP=y
CONFIG_PPPOL2TP=y
CONFIG_PPPOE=y
CONFIG_L2TP=y
CONFIG_L2TP_V3=y

# Ze IPsec dataplane. kernel.config carries CONFIG_XFRM_USER, which is the netlink
# interface ze installs every Child SA through. ESP is what carries the packets:
# without it the kernel accepts the install and drops the traffic. The appliance
# image holds no iproute2 and no busybox, so `ze doctor` and `show vpn ipsec
# dataplane sa` are the only tools that can report the dataplane, and
# CONFIG_XFRM_STATISTICS is what fills the SAD byte counters they read.
CONFIG_INET_ESP=y
CONFIG_INET6_ESP=y
CONFIG_XFRM_STATISTICS=y

# Atomic MOBIKE migration preserves the existing XFRM sequence and replay state.
CONFIG_XFRM_MIGRATE=y

# Scope admission requires the built-in fragment guard and both family defrag paths.
CONFIG_XFRM_FRAGMENT_GUARD=y

# The kernel transforms Ze's XFRM algorithm tables can install
# (internal/component/ike/dataplane/kernelcap_linux.go, xfrmTransformKernel).
# Each is an enrolled kernel capability, so each is requested here and declared
# in runtime.require.
CONFIG_CRYPTO_CBC=y
CONFIG_CRYPTO_DES=y
CONFIG_CRYPTO_NULL=y
CONFIG_CRYPTO_GCM=y
CONFIG_CRYPTO_CHACHA20POLY1305=y
CONFIG_CRYPTO_SHA1=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA512=y

# AH is the other protocol ze installs, and it was the same enumeration hole as
# CONFIG_INET_ESP one line up. validateIPsecInterface (internal/plugins/ospf/
# config_ipsec.go) accepts `protocol ah` on an OSPFv3 interface and buildIPsecSA
# (internal/plugins/ospf/ipsec_install.go) hands the kernel a Proto 51 state, so
# an operator who configures RFC 4552 AH gets a config ze validated and a kernel
# that refuses the install. Measured in the QEMU guest on 2026-09-14, on ze's own
# 7.2 runtime kernel: `xfrm: state add spi=4543137: protocol not supported`, which
# is EPROTONOSUPPORT from a kernel built with CONFIG_INET6_AH unset. Both families
# are here because the SPD and SAD are one subsystem and an IPv4 AH state is one
# config leaf away.
CONFIG_INET_AH=y
CONFIG_INET6_AH=y

# The XFRM interface is the device an IPsec peer binds to. `set interface xfrm`
# (the xfrm case in ze-iface-conf.yang) reaches CreateXFRM
# (internal/plugins/iface/netlink/xfrm_linux.go), which adds an `ip link add
# type xfrm` device with an if_id, and a `vti bind` peer installs its Child SA
# against that if_id (resolveIfID, internal/component/ike/engine/established.go).
# The symbol was unset, so the kernel answered `xfrm xa: link add: operation not
# supported` to a config ze had validated, and no `vti bind` peer could work on
# the shipped kernel. Measured in the QEMU guest on 2026-09-16, on ze's own 7.2
# runtime kernel, by the first run of test/plugin/show-mtu-oversized-tunnels.ci.
# Kconfig: tristate, `depends on XFRM && IPV6`, both already =y.
CONFIG_XFRM_INTERFACE=y

# Interface kinds ze lets an operator configure, and the policy routing and
# traffic control it programs (added 2026-08-07). Every symbol here has a named
# producer in ze; none is here to satisfy a test. They were missing, so a config
# ze accepts and validates was rejected by the kernel at apply time. The same
# enumeration hole as CONFIG_NF_TABLES_INET in kernel.config, one subsystem over.
#
# Built in, never modular: a QEMU run boots this kernel beside Alpine's own
# /lib/modules, built for another version, so no module of this kernel can load
# (internal/le/test/qemu.Run). CONFIG_VLAN_8021Q,
# CONFIG_NET_SCH_INGRESS and CONFIG_NET_ACT_MIRRED resolved to =m before this.
#
# dummy and 802.1Q sub-interfaces: CreateDummy and CreateVLAN
# (internal/plugins/iface/netlink/manage_linux.go), reached from `list dummy` and
# the VLAN sub-interface form in ze-iface-conf.yang. UpdateVLANQoSMap carries the
# 802.1p maps ze-cos-conf.yang exposes.
CONFIG_DUMMY=y
CONFIG_VLAN_8021Q=y
# Policy routing and multipath: applyIPRules and applyAutoRoutes
# (internal/plugins/policyroute/rules_linux.go) add an ip rule with a mark and a
# table, whose id range ze-policyroute-conf.yang publishes as 1..999|3000..max.
# buildRoute (internal/plugins/static/backend_linux.go) and buildMultiPath
# (internal/plugins/fib/kernel/nexthop_linux.go) need multipath and, for the v6
# named tables ze-static-conf.yang allows, the v6 table set. Without the v6
# symbol the kernel folds every id into the main table and says nothing.
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_IP_ROUTE_MULTIPATH=y
# Traffic control. translateQdisc, translateClass and translateFilter
# (internal/plugins/traffic/netlink/translate_linux.go) have a live case for
# every qdisc-type ze-traffic-control-conf.yang offers, so a value the enum
# accepts and the kernel refuses is the defect this block closes.
CONFIG_NET_SCH_HTB=y
CONFIG_NET_SCH_TBF=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_HFSC=y
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_SFQ=y
CONFIG_NET_SCH_NETEM=y
CONFIG_NET_SCH_PRIO=y
# Classifiers: u32FilterPair for the DSCP and IP-protocol matches, FwFilter for
# mark-based class steering, both in translate_linux.go.
CONFIG_NET_CLS_U32=y
CONFIG_NET_CLS_FW=y
# Port mirroring: setupIngressMirror and setupClsactMirror
# (internal/plugins/iface/netlink/mirror_linux.go) attach a matchall filter with
# a mirred action to an ingress or clsact qdisc, driven by `container mirror` in
# ze-iface-conf.yang. All four symbols are needed; mirred alone does nothing.
CONFIG_NET_SCH_INGRESS=y
CONFIG_NET_CLS_MATCHALL=y
CONFIG_NET_ACT_MIRRED=y
# Subscriber upload policing: shaper.applyTC reaches ingressPolicerFilter
# (internal/plugins/traffic/netlink/policer_linux.go), which installs act_police.
# The shared matchall classifier cannot enforce the rate without this action.
CONFIG_NET_ACT_POLICE=y
# The ingress policer coexistence proof installs a foreign priority-1 filter
# with a gact PIPE action. Keep its kernel prerequisite built in as well.
CONFIG_NET_ACT_GACT=y
# Flow sampling: SetupSampling installs act_sample on the same ingress
# classifier; NewPsampleReader receives its packets through generic netlink.
# Both must be built in so sampling needs no module loader at runtime.
CONFIG_PSAMPLE=y
CONFIG_NET_ACT_SAMPLE=y
# The default nftables logger must accompany kernel.config's NFT_LOG expression.
# Alpine's initramfs cannot load modules from Ze's runtime kernel.
CONFIG_NF_LOG_SYSLOG=y
# Tunnel kinds. ze-iface-conf.yang carries a case for each of gre, gretap,
# ip6gre, ip6gretap, ipip, sit, ip6tnl, ipip6 and vxlan. tunnelKindNames
# (internal/component/iface/tunnel.go) names all nine, and CreateTunnel builds
# the netlink link for each. Eight of the nine had no symbol here, so the kernel
# answered `operation not supported` to a config ze had already validated.
#
# Nine kinds, six symbols and one gate. ip_gre.c registers both "gre" and
# "gretap", and ip6_gre.c registers "ip6gre" and "ip6gretap". ipip6 is ip6tnl
# with the inner protocol set to IPIP, so IPV6_TUNNEL carries that pair. The
# comment on TunnelKindIPIP6 (internal/component/iface/tunnel.go) states it.
#
# NET_IPGRE_DEMUX is a dependency, not a convenience. NET_IPGRE and IPV6_GRE
# both `depends on` it (net/ipv4/Kconfig, net/ipv6/Kconfig in linux 7.1.4), so a
# modular demux caps both of them at =m.
#
# IPV6_SIT was =m. That was its Kconfig `default m` answering, not a request
# from here. A QEMU run boots this kernel beside Alpine's own /lib/modules, so
# no module of this kernel can load and sit was as absent as the other eight.
#
# VXLAN `depends on INET` and selects NET_UDP_TUNNEL. Both are already =y, so
# VXLAN alone completes it. Every other dependency is a promptless helper the
# lines below select: NET_IP_TUNNEL, INET_TUNNEL, INET6_TUNNEL, DST_CACHE,
# GRO_CELLS and IPV6_NDISC_NODETYPE. A fragment line for a symbol with no prompt
# would state what kconfig already derives.
CONFIG_NET_IPGRE_DEMUX=y
CONFIG_NET_IPGRE=y
CONFIG_IPV6_GRE=y
CONFIG_NET_IPIP=y
CONFIG_IPV6_TUNNEL=y
CONFIG_IPV6_SIT=y
CONFIG_VXLAN=y

# MPLS forwarding, because ze programs the kernel's AF_MPLS table itself.
# dumpMPLSRoutes (internal/component/mpls/forwarding_linux.go) reads it with
# netlink.RouteList(nil, netlink.FAMILY_MPLS), and addMPLSSwap / delMPLSSwap
# (internal/plugins/fib/kernel/mplsentry_linux.go) install and remove the
# in-label keyed swap and pop entries LDP and RSVP-TE produce. Without
# MPLS_ROUTING the kernel has no AF_MPLS table, so every one of those calls
# fails on a kernel ze itself ships.
#
# Found 2026-08-24 by moving ze-qemu-ldp-frr-test onto this kernel: FRR's zebra
# logged `Disabling MPLS support (no kernel support)`, rejected `mpls ldp`, and
# no LDP session could form. The lab had run on stock Alpine, which carries
# MPLS, so no run had ever asked this kernel the question. Same class as
# CONFIG_NF_TABLES_INET, the qdisc set and CONFIG_DUMMY.
#
# MPLS is the menu symbol MPLS_ROUTING depends on. MPLS_IPTUNNEL carries the
# RTA_ENCAP label imposition the BGP labeled-unicast push uses, and it depends
# on LWTUNNEL, which this kernel did not have: the first build with the require
# manifest below refused with `CONFIG_MPLS_IPTUNNEL did not resolve to =y`, and
# it refused BEFORE the compile rather than after it. NET_MPLS_GSO is the
# stack's GSO handling for MPLS-encapsulated traffic.
CONFIG_MPLS=y
CONFIG_LWTUNNEL=y
CONFIG_MPLS_ROUTING=y
CONFIG_MPLS_IPTUNNEL=y
CONFIG_NET_MPLS_GSO=y
# Native labeled-IP fragmentation and ICMP use the complete outgoing stack.
CONFIG_MPLS_IP_MTU=y

# SRv6 headend encapsulation, because ze installs every RFC 9252 Service SID
# route as a seg6 lightweight tunnel. buildSEG6Encap
# (internal/plugins/fib/kernel/nexthop_linux.go) builds the encap-mode
# netlink.SEG6Encap and buildRichRoute attaches it to the route. Without
# IPV6_SEG6_LWTUNNEL the kernel has no LWTUNNEL_ENCAP_SEG6 handler, so every
# Service SID route install is refused on a kernel ze itself ships, and the
# BGP SRv6 service never reaches the forwarding plane.
#
# Found 2026-10-30 while researching the inner-TTL defect
# TestFIBServiceSIDEncapsulationOnWire showed on the hosted runner
# (evidence-nightly run 41038783931): that test had only ever run on the stock
# Ubuntu runner kernel, which carries seg6, and this kernel's build config read
# `# CONFIG_IPV6_SEG6_LWTUNNEL is not set`. Same class as MPLS_ROUTING above.
#
# A bool in net/ipv6/Kconfig: depends on IPV6, selects LWTUNNEL, DST_CACHE and
# IPV6_MULTIPLE_TABLES, all already =y here. It also builds seg6_local and the
# seg6 sysctls; net.ipv6.conf.*.seg6_enabled defaults to 0 and ze sets it
# nowhere, so SRH packets addressed to the router are still dropped.
CONFIG_IPV6_SEG6_LWTUNNEL=y
# Forwarded seg6 L3 modes traverse ip_forward/ip6_forward for inner TTL/Hop
# Limit decrement (marker for gokrazy/kernel/patches/0014-seg6-forward-ttl.patch).
CONFIG_IPV6_SEG6_FORWARD_TTL=y
# Forwarded DF-clear IPv4 packets exceeding effective tunnel MTU fragment before
# SRv6 encapsulation (marker for gokrazy/kernel/patches/0015-seg6-forward-df-clear-frag.patch).
CONFIG_IPV6_SEG6_FORWARD_FRAG=y

# Local QEMU/netns evidence path.
CONFIG_NAMESPACES=y
CONFIG_NET_NS=y
CONFIG_ISO9660_FS=y
CONFIG_CDROM=y
CONFIG_BLK_DEV_SR=y
CONFIG_SCSI=y
CONFIG_SCSI_MOD=y
CONFIG_ATA=y
CONFIG_SQUASHFS_XZ=y
CONFIG_TMPFS=y
CONFIG_LOOP=y
CONFIG_9P_FS=y
CONFIG_9P_FS_POSIX_ACL=y
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y

# VPP hugepage reservation (spec-vpp-host-tuning). image.hugepages emits
# hugepages= kernel arguments; HUGETLBFS must be present for the kernel to
# honour them. HUGETLBFS selects HUGETLB_PAGE.
CONFIG_HUGETLBFS=y

# Conntrack netlink, for flow-export's conntrack reader and the DDoS
# classifier that consumes its records.
#
# NF_CONNTRACK itself already arrives implicitly, selected by the NAT options
# above, which is why /proc/sys/net/netfilter/nf_conntrack_acct exists on a
# runtime kernel. The ctnetlink DUMP interface does not: conntrackWorker.Dump
# (internal/plugins/flowexport/conntrack_worker.go) fails with EINVAL without
# it, so the recent-flow ring stays empty and DDoS characterization degrades to
# generic-flood with no discriminating vector -- which is what
# doctor-flowexport-conntrack-unavailable describes and what
# test/plugin/ddos-detect-characterize.ci reports as a rule that stayed coarse.
# Measured on 2026-09-03 in the QEMU VM on runtime kernel 7.2 arm64: the
# ddos-local drop matched `ip daddr` alone after 568000 packets, with
# "flow-export: conntrack dump failed error=invalid argument" logged every second.
#
# NF_CONNTRACK is named explicitly beside it rather than left to the NAT
# options: an implicit select is exactly what a later config change can demote
# without failing the build (ai/rules/platform-linux.md).
#
# The ctnetlink symbol is NF_CT_NETLINK, not NF_CONNTRACK_NETLINK. The second
# spelling is what the interface is called and it is not a Kconfig symbol, so
# Kconfig drops it in silence and the built config carries no line for it at
# all. Only runtime.require sees that, because a symbol that resolves to
# nothing is indistinguishable from one never asked for.
CONFIG_NF_CONNTRACK=y
CONFIG_NF_CT_NETLINK=y

# Kernel crash capture. The kernel writes its own oops or panic log into a
# memory region a warm reboot does not clear, and ze reads it back on the next
# healthy boot (internal/core/crashlog/kernel_linux.go). Without PSTORE there is
# no /sys/fs/pstore to read from, and without PSTORE_RAM nothing binds the
# ramoops backend to the region image.crash-dump reserves: the kernel would
# accept the reserve_mem argument, take the RAM on every boot, and store nothing.
#
# The appliance ships no busybox and no shell, so a kernel panic leaves the
# operator a reboot and no evidence. This is the only capture path that needs no
# code running at the moment of the fault.
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
# The defconfig also keeps every data symbol in the kernel's symbol table
# (KALLSYMS_ALL). That is turned off. CONFIG_KALLSYMS stays, so the backtrace
# in a captured oops or panic still names its functions; only the name of a
# data address is lost. Ze reads the captured log as text and resolves no
# symbol itself.
CONFIG_KALLSYMS_ALL=n

# Ze's docker-host image (gokrazy/docker-host) as a Lima/Colima guest on macOS
# and as the QEMU docker-lab guest. Each option names the consumer that fails
# without it (spec-ze-image-docker-host, AC-4, D-12).
#
# VSOCKETS and VIRTIO_VSOCKETS: the Lima guest agent talks to the host agent
# over vsock (`lima-guestagent daemon --vsock-port`); without them Lima marks
# the instance Degraded after one minute and `colima start` fails.
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y
# INET_UDP_DIAG: the guest agent lists listening ports over NETLINK_SOCK_DIAG
# to forward them to the Mac; INET_DIAG above covers TCP, this covers UDP.
CONFIG_INET_UDP_DIAG=y
# VIRTIO_FS: Colima's virtiofs mounts of the Mac's home directory, which the
# lab bind mounts need at the same absolute path.
CONFIG_VIRTIO_FS=y
# VHOST_NET: VPP labs open /dev/vhost-net
# (plan/spec-lab-kernel-features-in-setup.md, AC-4). Kconfig caps VHOST_NET at
# the value of TAP ("depends on TAP || !TAP"), and TAP is a hidden symbol that
# arm64 defconfig sets to m through MACVTAP=m, so VHOST_NET resolved to m until
# MACVTAP was built in: the 2026-10-21 arm64 build refused with "CONFIG_VHOST_NET
# did not resolve to =y".
CONFIG_MACVTAP=y
CONFIG_VHOST_NET=y
# BINFMT_MISC: Rosetta registers itself through binfmt_misc to run the
# linux/amd64 VPP image on an arm64 Mac.
CONFIG_BINFMT_MISC=y
# VIRTIO_CONSOLE: the vz console is hvc0; arm64 defconfig sets it, amd64 does
# not, and without it a vz or QEMU boot logs nothing.
CONFIG_VIRTIO_CONSOLE=y
