# Runtime kernel modules. Gokrazy loads modules from the kernel package at boot.
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

# USB mass storage.
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_STORAGE=y

# NVMe storage.
CONFIG_NVME_CORE=y
CONFIG_BLK_DEV_NVME=y
CONFIG_NVME_MULTIPATH=y
CONFIG_NVME_HWMON=y
CONFIG_NVME_TARGET_PASSTHRU=y

# Server and appliance NIC drivers.
CONFIG_I40E=y
CONFIG_ICE=y
CONFIG_BNXT=y
CONFIG_MLX5_EN=y
CONFIG_MLX5_CORE=y
CONFIG_MLX5_CORE_EN=y
CONFIG_MLX5_INFINIBAND=n
CONFIG_IGB=y
CONFIG_IGC=y

# Watchdogs and sensors.
CONFIG_SP5100_TCO=y
CONFIG_I6300ESB_WDT=y
CONFIG_SENSORS_K10TEMP=y
CONFIG_SENSORS_NCT6683=y
CONFIG_SENSORS_CORSAIR_CPRO=y

# WireGuard and tunnel support.
CONFIG_NET_UDP_TUNNEL=y
CONFIG_WIREGUARD=y
CONFIG_TUN=y

# Traffic shaping and diagnostics.
CONFIG_NET_SCH_TBF=y
CONFIG_INET_DIAG=y

# Virtual and bridged interfaces.
CONFIG_MACVLAN=y
CONFIG_BRIDGE=y
CONFIG_VETH=y

# Virtio drivers for QEMU and evidence VMs.
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_RING=y

# KVM-accelerated nested QEMU VMs.
CONFIG_KVM=y
CONFIG_KVM_INTEL=y
CONFIG_KVM_AMD=y
CONFIG_KVM_AMD_SEV=y

CONFIG_EFIVAR_FS=y

# Ryzen CPUs.
CONFIG_X86_AMD_PLATFORM_DEVICE=y
CONFIG_CPU_FREQ_DEFAULT_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_X86_POWERNOW_K8=y
CONFIG_X86_AMD_FREQ_SENSITIVITY=y

# Include hardware interrupt CPU usage in /proc/stat CPU time reporting.
CONFIG_IRQ_TIME_ACCOUNTING=y

# Container runtimes.
CONFIG_BPF_SYSCALL=y
# eBPF JIT: used by the traffic-usage plugin (eBPF TCX byte accounting) for
# acceptable per-packet performance. TCX link attach itself needs no dedicated
# Kconfig symbol on kernel >= 6.6 (it lives in net/core, gated by CONFIG_NET).
CONFIG_BPF_JIT=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_BPF=y
CONFIG_SOCK_CGROUP_DATA=y
CONFIG_NET_SOCK_MSG=y
CONFIG_OVERLAY_FS=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_NAT=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_MARK=y
CONFIG_CGROUP_PIDS=y

# TCP BBR as default congestion control.
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_BBR=y
CONFIG_DEFAULT_TCP_CONG="bbr"

# Ze L2TP/PPP/PPPoE deployment support. Keep these built into the runtime kernel.
# L2TP_NETLINK was removed in kernel 7.0 (netlink is always built with L2TP).
# CONFIG_PPPOE provides the AF_PPPOX PX_PROTO_OE session path used by the
# pppoe access concentrator and the ze pppoe-client (RFC 2516); the QEMU
# pppoe-accel evidence test (ze-qemu-pppoe-accel-test) needs it built in.
CONFIG_PPP=y
CONFIG_PPPOL2TP=y
CONFIG_PPPOE=y
CONFIG_L2TP=y
CONFIG_L2TP_V3=y

# Ze IPsec dataplane. kernel.config carries CONFIG_XFRM_USER, which is the netlink
# interface ze installs every Child SA through. ESP is what carries the packets:
# without it the kernel accepts the install and drops the traffic. The appliance
# image holds no iproute2 and no busybox, so `ze doctor` and `show vpn ipsec
# dataplane sa` are the only tools that can report the dataplane, and
# CONFIG_XFRM_STATISTICS is what fills the SAD byte counters they read.
CONFIG_INET_ESP=y
CONFIG_INET6_ESP=y
CONFIG_XFRM_STATISTICS=y

# Interface kinds ze lets an operator configure, and the policy routing and
# traffic control it programs (added 2026-08-07). Every symbol here has a named
# producer in ze; none is here to satisfy a test. They were missing, so a config
# ze accepts and validates was rejected by the kernel at apply time. The same
# enumeration hole as CONFIG_NF_TABLES_INET in kernel.config, one subsystem over.
#
# Built in, never modular: a QEMU run boots this kernel beside Alpine's own
# /lib/modules, built for another version, so no module of this kernel can load
# (scripts/evidence/qemu-run.py, _extract_alpine_initramfs). CONFIG_VLAN_8021Q,
# CONFIG_NET_SCH_INGRESS and CONFIG_NET_ACT_MIRRED resolved to =m before this.
#
# dummy and 802.1Q sub-interfaces: CreateDummy and CreateVLAN
# (internal/plugins/iface/netlink/manage_linux.go), reached from `list dummy` and
# the VLAN sub-interface form in ze-iface-conf.yang. UpdateVLANQoSMap carries the
# 802.1p maps ze-cos-conf.yang exposes.
CONFIG_DUMMY=y
CONFIG_VLAN_8021Q=y
# Policy routing and multipath: applyIPRules and applyAutoRoutes
# (internal/plugins/policyroute/rules_linux.go) add an ip rule with a mark and a
# table, whose id range ze-policyroute-conf.yang publishes as 1..999|3000..max.
# buildRoute (internal/plugins/static/backend_linux.go) and buildMultiPath
# (internal/plugins/fib/kernel/nexthop_linux.go) need multipath and, for the v6
# named tables ze-static-conf.yang allows, the v6 table set. Without the v6
# symbol the kernel folds every id into the main table and says nothing.
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_IP_ROUTE_MULTIPATH=y
# Traffic control. translateQdisc, translateClass and translateFilter
# (internal/plugins/traffic/netlink/translate_linux.go) have a live case for
# every qdisc-type ze-traffic-control-conf.yang offers, so a value the enum
# accepts and the kernel refuses is the defect this block closes.
CONFIG_NET_SCH_HTB=y
CONFIG_NET_SCH_TBF=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_HFSC=y
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_SFQ=y
CONFIG_NET_SCH_NETEM=y
CONFIG_NET_SCH_PRIO=y
# Classifiers: u32FilterPair for the DSCP and IP-protocol matches, FwFilter for
# mark-based class steering, both in translate_linux.go.
CONFIG_NET_CLS_U32=y
CONFIG_NET_CLS_FW=y
# Port mirroring: setupIngressMirror and setupClsactMirror
# (internal/plugins/iface/netlink/mirror_linux.go) attach a matchall filter with
# a mirred action to an ingress or clsact qdisc, driven by `container mirror` in
# ze-iface-conf.yang. All four symbols are needed; mirred alone does nothing.
CONFIG_NET_SCH_INGRESS=y
CONFIG_NET_CLS_MATCHALL=y
CONFIG_NET_ACT_MIRRED=y
# Tunnel kinds. ze-iface-conf.yang carries a case for each of gre, gretap,
# ip6gre, ip6gretap, ipip, sit, ip6tnl, ipip6 and vxlan. tunnelKindNames
# (internal/component/iface/tunnel.go) names all nine, and CreateTunnel builds
# the netlink link for each. Eight of the nine had no symbol here, so the kernel
# answered `operation not supported` to a config ze had already validated.
#
# Nine kinds, six symbols and one gate. ip_gre.c registers both "gre" and
# "gretap", and ip6_gre.c registers "ip6gre" and "ip6gretap". ipip6 is ip6tnl
# with the inner protocol set to IPIP, so IPV6_TUNNEL carries that pair. The
# comment on TunnelKindIPIP6 (internal/component/iface/tunnel.go) states it.
#
# NET_IPGRE_DEMUX is a dependency, not a convenience. NET_IPGRE and IPV6_GRE
# both `depends on` it (net/ipv4/Kconfig, net/ipv6/Kconfig in linux 7.1.4), so a
# modular demux caps both of them at =m.
#
# IPV6_SIT was =m. That was its Kconfig `default m` answering, not a request
# from here. A QEMU run boots this kernel beside Alpine's own /lib/modules, so
# no module of this kernel can load and sit was as absent as the other eight.
#
# VXLAN `depends on INET` and selects NET_UDP_TUNNEL. Both are already =y, so
# VXLAN alone completes it. Every other dependency is a promptless helper the
# lines below select: NET_IP_TUNNEL, INET_TUNNEL, INET6_TUNNEL, DST_CACHE,
# GRO_CELLS and IPV6_NDISC_NODETYPE. A fragment line for a symbol with no prompt
# would state what kconfig already derives.
CONFIG_NET_IPGRE_DEMUX=y
CONFIG_NET_IPGRE=y
CONFIG_IPV6_GRE=y
CONFIG_NET_IPIP=y
CONFIG_IPV6_TUNNEL=y
CONFIG_IPV6_SIT=y
CONFIG_VXLAN=y

# MPLS forwarding, because ze programs the kernel's AF_MPLS table itself.
# dumpMPLSRoutes (internal/component/mpls/forwarding_linux.go) reads it with
# netlink.RouteList(nil, netlink.FAMILY_MPLS), and addMPLSSwap / delMPLSSwap
# (internal/plugins/fib/kernel/mplsentry_linux.go) install and remove the
# in-label keyed swap and pop entries LDP and RSVP-TE produce. Without
# MPLS_ROUTING the kernel has no AF_MPLS table, so every one of those calls
# fails on a kernel ze itself ships.
#
# Found 2026-08-24 by moving ze-qemu-ldp-frr-test onto this kernel: FRR's zebra
# logged `Disabling MPLS support (no kernel support)`, rejected `mpls ldp`, and
# no LDP session could form. The lab had run on stock Alpine, which carries
# MPLS, so no run had ever asked this kernel the question. Same class as
# CONFIG_NF_TABLES_INET, the qdisc set and CONFIG_DUMMY.
#
# MPLS is the menu symbol MPLS_ROUTING depends on. MPLS_IPTUNNEL carries the
# RTA_ENCAP label imposition the BGP labeled-unicast push uses, and it depends
# on LWTUNNEL, which this kernel did not have: the first build with the require
# manifest below refused with `CONFIG_MPLS_IPTUNNEL did not resolve to =y`, and
# it refused BEFORE the compile rather than after it. NET_MPLS_GSO is the
# stack's GSO handling for MPLS-encapsulated traffic.
CONFIG_MPLS=y
CONFIG_LWTUNNEL=y
CONFIG_MPLS_ROUTING=y
CONFIG_MPLS_IPTUNNEL=y
CONFIG_NET_MPLS_GSO=y

# Local QEMU/netns evidence path.
CONFIG_NAMESPACES=y
CONFIG_NET_NS=y
CONFIG_ISO9660_FS=y
CONFIG_CDROM=y
CONFIG_BLK_DEV_SR=y
CONFIG_SCSI=y
CONFIG_SCSI_MOD=y
CONFIG_ATA=y
CONFIG_SQUASHFS_XZ=y
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS=y
CONFIG_LOOP=y
CONFIG_9P_FS=y
CONFIG_9P_FS_POSIX_ACL=y
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y

# VPP hugepage reservation (spec-vpp-host-tuning). image.hugepages emits
# hugepages= kernel arguments; HUGETLBFS must be present for the kernel to
# honour them. HUGETLBFS selects HUGETLB_PAGE.
CONFIG_HUGETLBFS=y
