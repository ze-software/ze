CONFIG_MODULES
CONFIG_PPP
CONFIG_PPPOL2TP
CONFIG_PPPOE
CONFIG_L2TP
CONFIG_L2TP_V3
CONFIG_DEVTMPFS_MOUNT
CONFIG_BLK_DEV_INITRD
CONFIG_VIRTIO_NET
CONFIG_BPF_SYSCALL
CONFIG_BPF_JIT
CONFIG_VETH
CONFIG_MACVLAN
CONFIG_HUGETLBFS
CONFIG_INET_ESP
CONFIG_INET6_ESP
CONFIG_XFRM_STATISTICS

# The interface kinds, policy routing and traffic control ze programs. Each has
# a producer named in runtime.config beside its request. A `=y` line in a
# fragment is a request and kconfig may answer `=m`, which is the same as absent
# in a QEMU run and a surprise on the appliance; only a line here makes that
# answer fail the build.
CONFIG_DUMMY
CONFIG_VLAN_8021Q
CONFIG_IP_MULTIPLE_TABLES
CONFIG_IPV6_MULTIPLE_TABLES
CONFIG_IP_ROUTE_MULTIPATH
CONFIG_NET_SCH_HTB
CONFIG_NET_SCH_TBF
CONFIG_NET_SCH_FQ_CODEL
CONFIG_NET_SCH_HFSC
CONFIG_NET_SCH_FQ
CONFIG_NET_SCH_SFQ
CONFIG_NET_SCH_NETEM
CONFIG_NET_SCH_PRIO
CONFIG_NET_SCH_INGRESS
CONFIG_NET_CLS_U32
CONFIG_NET_CLS_FW
CONFIG_NET_CLS_MATCHALL
CONFIG_NET_ACT_MIRRED

# Every qdisc above is TRISTATE, so a kernel bump can answer =m to a `=y`
# request and nothing else in the tree would notice. The list must therefore
# carry one line per qdisc-type `translateQdisc` has a case for, not just the
# ones a test happens to exercise: HFSC, FQ, SFQ, NETEM and PRIO were requested
# in runtime.config and left unpinned in the first version of this file, which
# is the same enumeration hole this whole change exists to close.
#
# Deliberately NOT pinned:
#   CONFIG_IP_ADVANCED_ROUTER   a bool menu gate. CONFIG_IP_MULTIPLE_TABLES and
#                               CONFIG_IP_ROUTE_MULTIPATH both `depends on` it
#                               and both are pinned, so neither can answer =y
#                               while the gate is off. Pinning the dependents is
#                               strictly stronger than pinning the gate.

# The tunnel kinds ze lets an operator configure. Nine kinds in
# ze-iface-conf.yang and in tunnelKindNames (internal/component/iface/tunnel.go)
# reach the kernel through six symbols and one gate. Every one is TRISTATE, and
# IPV6_SIT carries a Kconfig `default m` that answered =m for as long as nothing
# here required it. The native worker accepts =y alone, so a line here turns a
# silent =m into a failed build.
CONFIG_NET_IPGRE_DEMUX
CONFIG_NET_IPGRE
CONFIG_IPV6_GRE
CONFIG_NET_IPIP
CONFIG_IPV6_TUNNEL
CONFIG_IPV6_SIT
CONFIG_VXLAN
#
# Deliberately NOT pinned:
#   CONFIG_NET_IP_TUNNEL        promptless helpers. Each is `select`ed by a
#   CONFIG_INET_TUNNEL          symbol pinned above, and a select from a =y
#   CONFIG_INET6_TUNNEL         symbol forces =y, so the pinned lines already
#   CONFIG_DST_CACHE            carry them. A line here would pin what kconfig
#   CONFIG_GRO_CELLS            derives, and hide which request produced it.
#   CONFIG_IPV6_NDISC_NODETYPE
#   CONFIG_NET_UDP_TUNNEL       promptless, and CONFIG_VXLAN selects it.

# The AF_MPLS table ze's own forwarding code reads and writes. A `=y` here
# fails the build if MPLS_ROUTING stops resolving, rather than shipping a
# kernel on which LDP and RSVP-TE cannot program a single label.
CONFIG_MPLS
CONFIG_LWTUNNEL
CONFIG_MPLS_ROUTING
CONFIG_MPLS_IPTUNNEL
CONFIG_NET_MPLS_GSO
CONFIG_NF_CONNTRACK
CONFIG_NF_CONNTRACK_NETLINK
