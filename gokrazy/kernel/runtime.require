CONFIG_MODULES
CONFIG_PPP
CONFIG_PPPOL2TP
CONFIG_PPPOE
CONFIG_L2TP
CONFIG_L2TP_V3
CONFIG_DEVTMPFS_MOUNT
CONFIG_BLK_DEV_INITRD
CONFIG_VIRTIO_NET
CONFIG_BPF_SYSCALL
CONFIG_BPF_JIT
CONFIG_VETH
CONFIG_MACVLAN
CONFIG_HUGETLBFS
