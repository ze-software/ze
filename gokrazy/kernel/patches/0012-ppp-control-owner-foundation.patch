From: Ze kernel maintainers
Subject: [PATCH 12] ppp: retain original logical control and packet ownership

PRIVATE SOURCE FOUNDATION. Apply after Linux v7.3 + Ze 0001..0005,
0007..0011 and 0011a. No application, build or native test is claimed.
PPPIOCSOCKETOWNER is reserved but NOT dispatched, and capability bit 9 is
NOT advertised. Phase 13 must complete socket/packet/fragment/multicast
enforcement before activating either. No Go consumer is changed here.

The creator file remains borrowed only for the ioctl. Native sockets retain
one logical PPP object through their control owner, never a creator-file
reference or netdev_hold. Final provider release runs in core-owned work,
after an RCU grace period, with the provider module pinned until it returns.

--- a/include/uapi/linux/ppp-ioctl.h
+++ b/include/uapi/linux/ppp-ioctl.h
@@ -136,4 +136,20 @@
 #define PPPIOCGTRANSPORTOWNER _IOWR('t', 44, struct ppp_transport_owner)
 
+/* Input only; successful ioctl return is a new CLOEXEC|NONBLOCK fd, even 0.
+ * Reserved, NOT dispatched until complete IPv6 producer enforcement lands.
+ */
+struct ppp_control_socket {
+	__u32 abi;
+	__u32 kind;
+	__s32 unit;
+	__s32 ifindex;
+	__u32 flags;
+	__u32 reserved[3];
+};
+
+#define PPP_CONTROL_ICMP6_RAW 1
+#define PPP_CONTROL_UDP6      2
+#define PPPIOCSOCKETOWNER _IOW('t', 43, struct ppp_control_socket)
+
 /*
  * Ioctl definitions.
--- /dev/null
+++ b/include/net/ppp_control.h
@@ -0,0 +1,73 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _NET_PPP_CONTROL_H
+#define _NET_PPP_CONTROL_H
+
+#include <linux/list.h>
+#include <linux/types.h>
+
+struct module;
+struct net;
+struct net_device;
+struct ppp_control_owner;
+struct sk_buff;
+struct sock;
+
+/* Unpublished socket attaches once. Cleanup detaches before freeing sk.
+ * The list owns no socket ref; its lock excludes final socket cleanup.
+ */
+struct ppp_control_binding {
+	struct ppp_control_owner *owner;
+	struct sock *sk;
+	struct list_head link;
+};
+
+enum ppp_control_role {
+	PPP_CONTROL_RX = 1,
+	PPP_CONTROL_TX = 2,
+};
+
+struct ppp_control_receipt {
+	struct ppp_control_owner *owner;
+	enum ppp_control_role role;
+};
+
+/* Caller transfers one logical PPP object ref only on success. release
+ * runs in sleeping context, never under RTNL or a socket/PPP spinlock.
+ * The provider remains pinned until release returns into core code.
+ */
+struct ppp_control_owner *
+ppp_control_owner_create(struct net_device *dev, void *private,
+			 void (*release)(void *), struct module *provider);
+void ppp_control_owner_get(struct ppp_control_owner *owner);
+bool ppp_control_owner_try_get(struct ppp_control_owner *owner);
+void ppp_control_owner_put(struct ppp_control_owner *owner);
+void ppp_control_owner_retire(struct ppp_control_owner *owner);
+bool ppp_control_owner_live(const struct ppp_control_owner *owner,
+			    const struct net_device *dev);
+/* RTNL + live original owner required; returns an owned short net lease,
+ * or NULL. The owner itself MUST NOT pin its unit's namespace lifetime.
+ */
+struct net *ppp_control_owner_net_get(const struct ppp_control_owner *owner);
+bool ppp_control_owner_has_sockets(struct ppp_control_owner *owner);
+int ppp_control_bind(struct ppp_control_binding *binding,
+		     struct ppp_control_owner *owner, struct sock *sk);
+void ppp_control_unbind(struct ppp_control_binding *binding);
+
+/* Borrowed result: the skb's active extension owns its lifetime. A missing
+ * receipt MUST NOT authorize a guarded socket. RX is never a TX restriction.
+ * set takes a ref; it refuses overwriting any different active authority.
+ */
+const struct ppp_control_receipt *
+ppp_control_receipt(const struct sk_buff *skb, enum ppp_control_role role);
+int ppp_control_receipt_set(struct sk_buff *skb,
+			    struct ppp_control_owner *owner,
+			    enum ppp_control_role role);
+void ppp_control_receipt_consume(struct sk_buff *skb);
+bool ppp_control_rx_candidate(const struct sk_buff *skb);
+
+/* Allocation-free scrub: delete other active extensions through their native
+ * deletion paths, retaining the complete PPP receipt and backing ownership.
+ */
+void ppp_control_scrub(struct sk_buff *skb);
+
+#endif
--- /dev/null
+++ b/net/core/ppp_control.c
@@ -0,0 +1,282 @@
+// SPDX-License-Identifier: GPL-2.0
+/* PPP-specific ownership; no device registry, numeric lookup or fd custody.
+ * Design: Ze docs/architecture/l2tp/bng-5-pppoe.md.
+ */
+#include <linux/err.h>
+#include <linux/errno.h>
+#include <linux/icmpv6.h>
+#include <linux/ipv6.h>
+#include <linux/module.h>
+#include <linux/netdevice.h>
+#include <linux/rcupdate.h>
+#include <linux/refcount.h>
+#include <linux/rtnetlink.h>
+#include <linux/skbuff.h>
+#include <linux/slab.h>
+#include <linux/udp.h>
+#include <linux/workqueue.h>
+#include <net/net_namespace.h>
+#include <net/ppp_control.h>
+#include <net/sock.h>
+
+struct ppp_control_owner {
+	refcount_t refs;
+	struct net_device *dev;
+	struct net *net;
+	struct module *provider;
+	void *private;
+	void (*release)(void *);
+	spinlock_t lock;
+	struct list_head sockets;
+	bool retired;
+	struct rcu_head rcu;
+	struct work_struct release_work;
+};
+
+static void ppp_control_release_work(struct work_struct *work)
+{
+	struct ppp_control_owner *owner;
+
+	owner = container_of(work, struct ppp_control_owner, release_work);
+	owner->release(owner->private);
+	/* Provider code has returned. Core owns the remainder of this callback. */
+	module_put(owner->provider);
+	kfree(owner);
+}
+
+static void ppp_control_release_rcu(struct rcu_head *rcu)
+{
+	struct ppp_control_owner *owner;
+
+	owner = container_of(rcu, struct ppp_control_owner, rcu);
+	schedule_work(&owner->release_work);
+}
+
+struct ppp_control_owner *
+ppp_control_owner_create(struct net_device *dev, void *private,
+			 void (*release)(void *), struct module *provider)
+{
+	struct ppp_control_owner *owner;
+
+	ASSERT_RTNL();
+	if (!try_module_get(provider))
+		return ERR_PTR(-ENODEV);
+	owner = kzalloc_obj(struct ppp_control_owner);
+	if (!owner) {
+		module_put(provider);
+		return ERR_PTR(-ENOMEM);
+	}
+	refcount_set(&owner->refs, 1);
+	owner->dev = dev;
+	/* Comparison only: a base-owner net ref would prevent pernet teardown. */
+	owner->net = dev_net(dev);
+	owner->provider = provider;
+	owner->private = private;
+	owner->release = release;
+	spin_lock_init(&owner->lock);
+	INIT_LIST_HEAD(&owner->sockets);
+	INIT_WORK(&owner->release_work, ppp_control_release_work);
+	return owner;
+}
+EXPORT_SYMBOL_GPL(ppp_control_owner_create);
+
+void ppp_control_owner_get(struct ppp_control_owner *owner)
+{
+	refcount_inc(&owner->refs);
+}
+EXPORT_SYMBOL_GPL(ppp_control_owner_get);
+
+bool ppp_control_owner_try_get(struct ppp_control_owner *owner)
+{
+	/* Caller has either an existing reference or RCU-protected publication. */
+	return owner && refcount_inc_not_zero(&owner->refs);
+}
+EXPORT_SYMBOL_GPL(ppp_control_owner_try_get);
+
+void ppp_control_owner_put(struct ppp_control_owner *owner)
+{
+	if (owner && refcount_dec_and_test(&owner->refs))
+		call_rcu(&owner->rcu, ppp_control_release_rcu);
+}
+EXPORT_SYMBOL_GPL(ppp_control_owner_put);
+
+void ppp_control_owner_retire(struct ppp_control_owner *owner)
+{
+	struct ppp_control_binding *binding;
+
+	if (!owner)
+		return;
+	spin_lock_bh(&owner->lock);
+	WRITE_ONCE(owner->retired, true);
+	list_for_each_entry(binding, &owner->sockets, link) {
+		WRITE_ONCE(binding->sk->sk_err, ESTALE);
+		binding->sk->sk_error_report(binding->sk);
+	}
+	spin_unlock_bh(&owner->lock);
+}
+EXPORT_SYMBOL_GPL(ppp_control_owner_retire);
+
+bool ppp_control_owner_live(const struct ppp_control_owner *owner,
+			    const struct net_device *dev)
+{
+	/* Caller protects dev's namespace read with RCU or RTNL. Its allocation
+	 * is retained by the owner's logical PPP reference, not netdev_hold.
+	 */
+	return owner && dev == owner->dev && !READ_ONCE(owner->retired) &&
+		READ_ONCE(dev->reg_state) == NETREG_REGISTERED &&
+		net_eq(owner->net, dev_net(dev));
+}
+EXPORT_SYMBOL_GPL(ppp_control_owner_live);
+
+struct net *ppp_control_owner_net_get(const struct ppp_control_owner *owner)
+{
+	ASSERT_RTNL();
+	if (!ppp_control_owner_live(owner, owner->dev))
+		return NULL;
+	return maybe_get_net(owner->net);
+}
+EXPORT_SYMBOL_GPL(ppp_control_owner_net_get);
+
+bool ppp_control_owner_has_sockets(struct ppp_control_owner *owner)
+{
+	bool present;
+
+	spin_lock_bh(&owner->lock);
+	present = !list_empty(&owner->sockets);
+	spin_unlock_bh(&owner->lock);
+	return present;
+}
+EXPORT_SYMBOL_GPL(ppp_control_owner_has_sockets);
+
+int ppp_control_bind(struct ppp_control_binding *binding,
+		     struct ppp_control_owner *owner, struct sock *sk)
+{
+	int err = -ESTALE;
+
+	ASSERT_RTNL();
+	if (binding->owner)
+		return -EBUSY;
+	spin_lock_bh(&owner->lock);
+	if (!ppp_control_owner_live(owner, owner->dev))
+		goto out;
+	ppp_control_owner_get(owner);
+	binding->sk = sk;
+	INIT_LIST_HEAD(&binding->link);
+	list_add_tail(&binding->link, &owner->sockets);
+	/* Phase 13 reads this immutable binding with acquire semantics. */
+	smp_store_release(&binding->owner, owner);
+	err = 0;
+out:
+	spin_unlock_bh(&owner->lock);
+	return err;
+}
+EXPORT_SYMBOL_GPL(ppp_control_bind);
+
+void ppp_control_unbind(struct ppp_control_binding *binding)
+{
+	struct ppp_control_owner *owner = binding->owner;
+
+	if (!owner)
+		return;
+	spin_lock_bh(&owner->lock);
+	list_del(&binding->link);
+	WRITE_ONCE(binding->owner, NULL);
+	spin_unlock_bh(&owner->lock);
+	ppp_control_owner_put(owner);
+}
+EXPORT_SYMBOL_GPL(ppp_control_unbind);
+
+const struct ppp_control_receipt *
+ppp_control_receipt(const struct sk_buff *skb, enum ppp_control_role role)
+{
+#if IS_ENABLED(CONFIG_PPP)
+	const struct ppp_control_receipt *receipt;
+
+	receipt = skb_ext_find(skb, SKB_EXT_PPP_CONTROL);
+	if (receipt && receipt->owner && receipt->role == role)
+		return receipt;
+#endif
+	return NULL;
+}
+EXPORT_SYMBOL_GPL(ppp_control_receipt);
+
+int ppp_control_receipt_set(struct sk_buff *skb,
+			    struct ppp_control_owner *owner,
+			    enum ppp_control_role role)
+{
+#if IS_ENABLED(CONFIG_PPP)
+	struct ppp_control_receipt *receipt;
+
+	if (!owner || (role != PPP_CONTROL_RX && role != PPP_CONTROL_TX))
+		return -EINVAL;
+	receipt = skb_ext_find(skb, SKB_EXT_PPP_CONTROL);
+	if (receipt && receipt->owner)
+		return receipt->owner == owner && receipt->role == role ? 0 : -EPERM;
+	receipt = skb_ext_add(skb, SKB_EXT_PPP_CONTROL);
+	if (!receipt)
+		return -ENOMEM;
+	ppp_control_owner_get(owner);
+	receipt->owner = owner;
+	receipt->role = role;
+	return 0;
+#else
+	return -EOPNOTSUPP;
+#endif
+}
+EXPORT_SYMBOL_GPL(ppp_control_receipt_set);
+
+void ppp_control_receipt_consume(struct sk_buff *skb)
+{
+#if IS_ENABLED(CONFIG_PPP)
+	skb_ext_del(skb, SKB_EXT_PPP_CONTROL);
+#endif
+}
+EXPORT_SYMBOL_GPL(ppp_control_receipt_consume);
+
+void ppp_control_scrub(struct sk_buff *skb)
+{
+#if IS_ENABLED(CONFIG_PPP)
+	enum skb_ext_id id;
+
+	if (skb_ext_exist(skb, SKB_EXT_PPP_CONTROL)) {
+		for (id = 0; id < SKB_EXT_NUM; id++)
+			if (id != SKB_EXT_PPP_CONTROL)
+				skb_ext_del(skb, id);
+		return;
+	}
+#endif
+	skb_ext_reset(skb);
+}
+EXPORT_SYMBOL_GPL(ppp_control_scrub);
+
+bool ppp_control_rx_candidate(const struct sk_buff *skb)
+{
+	struct ipv6hdr header, *ip6h;
+	struct udphdr udp, *uh;
+	struct icmp6hdr icmp, *ih;
+
+	ip6h = skb_header_pointer(skb, 0, sizeof(header), &header);
+	if (!ip6h || ip6h->version != 6)
+		return false;
+	switch (ip6h->nexthdr) {
+	case IPPROTO_UDP:
+		uh = skb_header_pointer(skb, sizeof(header), sizeof(udp), &udp);
+		return uh && uh->dest == htons(547);
+	case IPPROTO_ICMPV6:
+		ih = skb_header_pointer(skb, sizeof(header), sizeof(icmp), &icmp);
+		return ih && ih->icmp6_type == 133; /* Router Solicitation */
+	case IPPROTO_HOPOPTS:
+	case IPPROTO_ROUTING:
+	case IPPROTO_FRAGMENT:
+	case IPPROTO_ESP:
+	case IPPROTO_AH:
+	case IPPROTO_DSTOPTS:
+		/* Preserve native extension/reassembly/decryption semantics. Later
+		 * fragments cannot reveal their port; do not parse a second stack.
+		 */
+		return true;
+	default:
+		return false;
+	}
+}
+EXPORT_SYMBOL_GPL(ppp_control_rx_candidate);
