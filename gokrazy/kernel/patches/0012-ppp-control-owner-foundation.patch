+/* The core owner consumes this logical ref in sleeping context. */
+static void ppp_control_release(void *private)
+{
+	ppp_release_interface(private);
+}
+
+static struct ppp_control_owner *ppp_control_acquire(struct ppp *ppp)
+{
+	struct ppp_control_owner *owner;
+
+	ASSERT_RTNL();
+	owner = rtnl_dereference(ppp->control_owner);
+	if (!owner) {
+		refcount_inc(&ppp->file.refcnt);
+		owner = ppp_control_owner_create(netdev_from_priv(ppp), ppp,
+					 ppp_control_release, THIS_MODULE);
+		if (IS_ERR(owner)) {
+			ppp_release_interface(ppp);
+			return owner;
+		}
+		rcu_assign_pointer(ppp->control_owner, owner);
+	}
+	ppp_control_owner_get(owner);
+	return owner;
+}
+
+/* Foundation only: Phase 13 must add the dispatcher and positive feature bit.
+ * No faulting user copy, socket release, fput or fd publication runs under RTNL.
+ */
+static long __maybe_unused
+ppp_control_socket_ioctl(struct file *file, void __user *argp)
+{
+	struct ppp_control_socket request;
+	struct ppp_control_owner *owner;
+	struct ppp_file *pf;
+	struct ppp *ppp;
+	struct net_device *dev;
+	struct net *net;
+	struct socket *sock = NULL;
+	struct file *socket_file;
+	int type, protocol, fd, err = -ESTALE;
+
+	if (copy_from_user(&request, argp, sizeof(request)))
+		return -EFAULT;
+	if (request.abi != PPP_OWNER_ABI || request.unit < 0 ||
+	    request.ifindex <= 0 || request.flags || request.reserved[0] ||
+	    request.reserved[1] || request.reserved[2])
+		return -EINVAL;
+	switch (request.kind) {
+	case PPP_CONTROL_ICMP6_RAW:
+		type = SOCK_RAW;
+		protocol = IPPROTO_ICMPV6;
+		break;
+	case PPP_CONTROL_UDP6:
+		type = SOCK_DGRAM;
+		protocol = IPPROTO_UDP;
+		break;
+	default:
+		return -EPROTONOSUPPORT;
+	}
+	rtnl_lock();
+	pf = file->private_data;
+	if (!pf || pf->kind != INTERFACE)
+		goto unlock;
