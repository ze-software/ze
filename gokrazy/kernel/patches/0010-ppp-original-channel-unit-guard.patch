+static int ppp_unbridge_channels(struct channel *pch)
+{
+	struct channel *peer;
+	int err;
+
+	spin_lock(&pch->upl);
+	peer = rcu_dereference_protected(pch->bridge,
+					 lockdep_is_held(&pch->upl));
+	if (peer)
+		refcount_inc(&peer->file.refcnt);
+	spin_unlock(&pch->upl);
+	if (!peer)
