+/* Query the live channel bound to this exact file; no channel-ID lookup. */
+static long ppp_channel_owner_ioctl(struct file *file, void __user *argp)
+{
+	struct ppp_channel_owner owner;
+	struct ppp_file *pf;
+	struct channel *pch;
+	int err = -EBADF;
+
+	if (copy_from_user(&owner, argp, sizeof(owner)))
+		return -EFAULT;
+	if (owner.abi != PPP_OWNER_ABI || owner.features ||
+	    owner.channel || owner.reserved)
+		return -EINVAL;
+
+	mutex_lock(&ppp_mutex);
+	pf = file->private_data;
+	if (!pf || pf->kind != CHANNEL)
+		goto unlock;
+	pch = PF_TO_CHANNEL(pf);
+	spin_lock(&pch->upl);
+	if (READ_ONCE(pch->file.dead) || !pch->chan) {
+		err = -ENOTCONN;
+	} else {
+		owner.features = PPP_OWNER_CONNECT | PPP_OWNER_BRIDGE;
+		owner.channel = pch->file.index;
+		err = 0;
+	}
+	spin_unlock(&pch->upl);
+unlock:
+	mutex_unlock(&ppp_mutex);
+	if (err)
+		return err;
+	return copy_to_user(argp, &owner, sizeof(owner)) ? -EFAULT : 0;
+}
+
+static long ppp_peer_ioctl(struct file *file, unsigned int cmd, void __user *argp)
+{
+	struct ppp_fd_peer request;
+	struct ppp_file *pf, *peer_pf;
+	struct channel *pch, *pchb;
+	struct net_device *dev;
+	struct file *peer;
+	struct ppp *ppp;
+	int err;
+
+	if (copy_from_user(&request, argp, sizeof(request)))
+		return -EFAULT;
+	if (request.abi != PPP_OWNER_ABI || request.flags || request.reserved)
+		return -EINVAL;
+	if (request.fd < 0)
+		return -EBADF;
+	peer = fget(request.fd);
+	if (!peer)
+		return -EBADF;
+	if (peer->f_op != &ppp_device_fops) {
+		err = -EBADF;
+		goto put_file;
+	}
+
+	/* Creation already has a ppp_mutex -> RTNL path. Match newlink's
+	 * RTNL + trylock boundary instead of introducing its inverse.
+	 */
+	rtnl_lock();
+	if (!mutex_trylock(&ppp_mutex)) {
+		err = -EBUSY;
+		goto unlock_rtnl;
+	}
+	pf = file->private_data;
+	peer_pf = peer->private_data;
+	if (!pf || pf->kind != CHANNEL || !peer_pf) {
+		err = -EBADF;
+		goto unlock;
+	}
+	pch = PF_TO_CHANNEL(pf);
+
+	switch (cmd) {
+	case PPPIOCCONNECTOWNER:
+	case PPPIOCDISCONNECTOWNER:
+		if (peer_pf->kind != INTERFACE) {
+			err = -EBADF;
+			break;
+		}
+		ppp = PF_TO_PPP(peer_pf);
+		if (ppp->owner != peer) {
+			err = -ESTALE;
+			break;
+		}
+		if (!net_eq(ppp->ppp_net, pch->chan_net)) {
+			err = -EXDEV;
+			break;
+		}
+		if (cmd == PPPIOCDISCONNECTOWNER) {
+			/* A retired original can still settle its exact attached
+			 * channel. Current netdevice names/indices do not select it.
+			 */
+			err = ppp_disconnect_channel_from(pch, ppp);
+			break;
+		}
+		dev = netdev_from_priv(ppp);
+		err = ppp_validate_owner(dev, peer);
+		if (err)
+			break;
+		if (!net_eq(dev_net(dev), pch->chan_net)) {
+			err = -EXDEV;
+			break;
+		}
+		err = ppp_connect_channel_to(pch, ppp);
+		break;
+
+	case PPPIOCBRIDGEOWNER:
+	case PPPIOCUNBRIDGEOWNER:
+		if (peer_pf->kind != CHANNEL) {
+			err = -EBADF;
+			break;
+		}
+		pchb = PF_TO_CHANNEL(peer_pf);
+		if (pch == pchb) {
+			err = -EINVAL;
+			break;
+		}
+		if (!net_eq(pch->chan_net, pchb->chan_net)) {
+			err = -EXDEV;
+			break;
+		}
+		if (cmd == PPPIOCBRIDGEOWNER)
+			err = ppp_bridge_channels_owned(pch, pchb);
+		else
+			err = ppp_unbridge_channels_owned(pch, pchb);
+		break;
+	default:
+		err = -ENOTTY;
+		break;
+	}
+unlock:
+	mutex_unlock(&ppp_mutex);
+unlock_rtnl:
+	rtnl_unlock();
+put_file:
+	/* Final creator release takes RTNL; never drop it under either lock. */
+	fput(peer);
+	return err;
+}
