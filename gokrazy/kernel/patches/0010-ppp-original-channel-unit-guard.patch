+/* The owner form passes the exact unit pointer with RTNL held. The legacy
+ * wrapper retains its IDR lock while calling this common native producer.
+ */
+static int ppp_connect_channel_to(struct channel *pch, struct ppp *ppp)
+{
+	struct net_device *dev = netdev_from_priv(ppp);
+	int ret = -EINVAL;
+	int hdrlen;
+
+	mutex_lock(&pch->chan_sem);
+	spin_lock(&pch->upl);
+	if (READ_ONCE(pch->file.dead)) {
+		ret = -ENOTCONN;
+		goto outl;
+	}
+	if (rcu_dereference_protected(pch->ppp, lockdep_is_held(&pch->upl)) ||
+	    rcu_dereference_protected(pch->bridge, lockdep_is_held(&pch->upl)))
+		goto outl;
+
+	ppp_lock(ppp);
+	if (ppp->closing) {
+		ppp_unlock(ppp);
+		ret = -ENODEV;
+		goto outl;
+	}
+	spin_lock_bh(&pch->downl);
+	if (!pch->chan) {
+		spin_unlock_bh(&pch->downl);
+		ppp_unlock(ppp);
+		ret = -ENOTCONN;
+		goto outl;
+	}
+	if (pch->chan->direct_xmit)
+		dev->priv_flags |= IFF_NO_QUEUE;
+	else
+		dev->priv_flags &= ~IFF_NO_QUEUE;
+	spin_unlock_bh(&pch->downl);
+	if (pch->file.hdrlen > ppp->file.hdrlen)
+		ppp->file.hdrlen = pch->file.hdrlen;
+	hdrlen = pch->file.hdrlen + 2;
+	if (hdrlen > dev->hard_header_len)
+		dev->hard_header_len = hdrlen;
+	list_add_tail_rcu(&pch->clist, &ppp->channels);
+	++ppp->n_channels;
+	rcu_assign_pointer(pch->ppp, ppp);
+	refcount_inc(&ppp->file.refcnt);
+	ppp_unlock(ppp);
+	ret = 0;
+outl:
+	spin_unlock(&pch->upl);
+	mutex_unlock(&pch->chan_sem);
+	return ret;
+}
