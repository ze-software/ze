+/* Pair operations keep chan_sem through RCU/refcount settlement, using one
+ * address order. Unregister releases its dead-marker upl before entering
+ * these operation locks.
+ */
+static void ppp_lock_channel_pair_ops(struct channel *a, struct channel *b)
+{
+	if ((unsigned long)a < (unsigned long)b) {
+		mutex_lock(&a->chan_sem);
+		mutex_lock_nested(&b->chan_sem, SINGLE_DEPTH_NESTING);
+	} else {
+		mutex_lock(&b->chan_sem);
+		mutex_lock_nested(&a->chan_sem, SINGLE_DEPTH_NESTING);
+	}
+}
+
+static void ppp_unlock_channel_pair_ops(struct channel *a, struct channel *b)
+{
+	if ((unsigned long)a < (unsigned long)b) {
+		mutex_unlock(&b->chan_sem);
+		mutex_unlock(&a->chan_sem);
+	} else {
+		mutex_unlock(&a->chan_sem);
+		mutex_unlock(&b->chan_sem);
+	}
+}
+
+static void ppp_lock_channel_pair(struct channel *a, struct channel *b)
+{
+	if ((unsigned long)a < (unsigned long)b) {
+		spin_lock(&a->upl);
+		spin_lock_nested(&b->upl, SINGLE_DEPTH_NESTING);
+	} else {
+		spin_lock(&b->upl);
+		spin_lock_nested(&a->upl, SINGLE_DEPTH_NESTING);
+	}
+}
+
+static void ppp_unlock_channel_pair(struct channel *a, struct channel *b)
+{
+	if ((unsigned long)a < (unsigned long)b) {
+		spin_unlock(&b->upl);
+		spin_unlock(&a->upl);
+	} else {
+		spin_unlock(&a->upl);
+		spin_unlock(&b->upl);
+	}
+}
+
+static int ppp_bridge_channels_owned(struct channel *a, struct channel *b)
+{
+	struct channel *ab, *ba;
+	int err = 0;
+
+	if (a == b)
+		return -EINVAL;
+	ppp_lock_channel_pair_ops(a, b);
+	ppp_lock_channel_pair(a, b);
+	if (READ_ONCE(a->file.dead) || READ_ONCE(b->file.dead) ||
+	    !a->chan || !b->chan) {
+		err = -ENOTCONN;
+		goto out;
+	}
+	if (rcu_dereference_protected(a->ppp, lockdep_is_held(&a->upl)) ||
+	    rcu_dereference_protected(b->ppp, lockdep_is_held(&b->upl))) {
+		err = -EALREADY;
+		goto out;
+	}
+	ab = rcu_dereference_protected(a->bridge, lockdep_is_held(&a->upl));
+	ba = rcu_dereference_protected(b->bridge, lockdep_is_held(&b->upl));
+	if (ab || ba) {
+		err = -EALREADY;
+		goto out;
+	}
+
+	refcount_inc(&a->file.refcnt);
+	refcount_inc(&b->file.refcnt);
+	rcu_assign_pointer(a->bridge, b);
+	rcu_assign_pointer(b->bridge, a);
+out:
+	ppp_unlock_channel_pair(a, b);
+	ppp_unlock_channel_pair_ops(a, b);
+	return err;
+}
+
+static int ppp_unbridge_channels_owned(struct channel *a, struct channel *b)
+{
+	struct channel *ab, *ba;
+	int err = 0;
+
+	if (a == b)
+		return -EINVAL;
+	ppp_lock_channel_pair_ops(a, b);
+	ppp_lock_channel_pair(a, b);
+	ab = rcu_dereference_protected(a->bridge, lockdep_is_held(&a->upl));
+	ba = rcu_dereference_protected(b->bridge, lockdep_is_held(&b->upl));
+	if ((ab && ab != b) || (ba && ba != a)) {
+		err = -ESTALE;
+		goto out;
+	}
+	/* Retired channels can settle this exact relationship. An absent
+	 * direction is already clean, including unregister's partial unbridge.
+	 */
+	if (ab)
+		RCU_INIT_POINTER(a->bridge, NULL);
+	if (ba)
+		RCU_INIT_POINTER(b->bridge, NULL);
+out:
+	ppp_unlock_channel_pair(a, b);
+	if (!err && (ab || ba)) {
+		synchronize_rcu();
+		if (ab)
+			ppp_release_channel(ab);
+		if (ba)
+			ppp_release_channel(ba);
+	}
+	ppp_unlock_channel_pair_ops(a, b);
+	return err;
+}
