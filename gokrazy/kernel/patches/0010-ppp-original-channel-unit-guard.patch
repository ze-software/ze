+static int ppp_disconnect_channel_from(struct channel *pch, struct ppp *expected)
+{
+	struct ppp *ppp;
+
+	mutex_lock(&pch->chan_sem);
+	spin_lock(&pch->upl);
+	ppp = rcu_dereference_protected(pch->ppp, lockdep_is_held(&pch->upl));
+	if (!ppp) {
+		spin_unlock(&pch->upl);
+		mutex_unlock(&pch->chan_sem);
+		return expected ? 0 : -EINVAL;
+	}
+	if (expected && ppp != expected) {
+		spin_unlock(&pch->upl);
+		mutex_unlock(&pch->chan_sem);
+		return -ESTALE;
+	}
+	RCU_INIT_POINTER(pch->ppp, NULL);
+	spin_unlock(&pch->upl);
+
+	ppp_lock(ppp);
+	list_del_rcu(&pch->clist);
+	if (--ppp->n_channels == 0)
+		wake_up_interruptible(&ppp->file.rwait);
+	ppp_unlock(ppp);
+	synchronize_net();
+	ppp_release_interface(ppp);
+	mutex_unlock(&pch->chan_sem);
+	return 0;
+}
+
+static int
+ppp_disconnect_channel(struct channel *pch)
+{
+	return ppp_disconnect_channel_from(pch, NULL);
