diff --git a/net/ipv4/inet_fragment.c b/net/ipv4/inet_fragment.c
--- a/net/ipv4/inet_fragment.c
+++ b/net/ipv4/inet_fragment.c
@@ -17,12 +17,70 @@
 #include <linux/rtnetlink.h>
 #include <linux/slab.h>
 #include <linux/rhashtable.h>
+#include <linux/overflow.h>
 
 #include <net/sock.h>
 #include <net/inet_frag.h>
 #include <net/inet_ecn.h>
 #include <net/ip.h>
 #include <net/ipv6.h>
+#include <net/xfrm.h>
+
+bool inet_frag_xfrm_context_init(struct xfrm_frag_context *context,
+				 const struct sk_buff *skb)
+{
+#ifdef CONFIG_XFRM
+	const struct sec_path *sp = skb_sec_path(skb);
+	unsigned int i;
+#endif
+	memset(context, 0, sizeof(*context));
+#ifdef CONFIG_XFRM
+	if (!sp)
+		return true;
+	if (sp->len > XFRM_MAX_DEPTH)
+		return false;
+	for (i = 0; i < sp->len; i++) {
+		const struct xfrm_state *x = sp->xvec[i];
+
+		if (!x || !x->scope || x->scope->count > XFRM_STATE_SCOPE_MAX)
+			return false;
+		context->scopes[i] = x->scope;
+	}
+	context->len = sp->len;
+#endif
+	return true;
+}
+EXPORT_SYMBOL_GPL(inet_frag_xfrm_context_init);
+
+/* MUST run before queue publication, balanced by the final destructor. */
+void inet_frag_xfrm_context_get(struct inet_frag_queue *q,
+				const struct xfrm_frag_context *context)
+{
+#ifdef CONFIG_XFRM
+	unsigned int i;
+
+	static_assert(XFRM_MAX_DEPTH *
+		      (sizeof(struct xfrm_state_scope) + XFRM_STATE_SCOPE_MAX *
+		       sizeof(struct xfrm_selector)) <= UINT_MAX);
+	for (i = 0; i < context->len; i++) {
+		xfrm_state_scope_get(context->scopes[i]);
+		q->extra_mem += xfrm_state_scope_size(context->scopes[i]);
+	}
+#endif
+}
+EXPORT_SYMBOL_GPL(inet_frag_xfrm_context_get);
+
+/* MUST balance construction even for empty or unpublished queues. */
+void inet_frag_xfrm_context_put(const struct xfrm_frag_context *context)
+{
+#ifdef CONFIG_XFRM
+	unsigned int i;
+
+	for (i = 0; i < context->len; i++)
+		xfrm_state_scope_put(context->scopes[i]);
+#endif
+}
+EXPORT_SYMBOL_GPL(inet_frag_xfrm_context_put);
 
