+static int ppp_validate_owner(const struct net_device *dev,
+			      const struct file *file)
+{
+	const struct ppp *ppp = netdev_priv(dev);
+
+	ASSERT_RTNL();
+	if (dev->reg_state != NETREG_REGISTERED || ppp->file.dead ||
+	    ppp->owner != file || file->private_data != &ppp->file)
+		return -ESTALE;
+	return 0;
+}
+
+static long ppp_owner_ioctl(struct file *file, void __user *argp)
+{
+	struct ppp_owner owner;
+	struct ppp_file *pf;
+	struct net_device *dev;
+	int err = -ESTALE;
+
+	if (copy_from_user(&owner, argp, sizeof(owner)))
+		return -EFAULT;
+	if (owner.abi != PPP_OWNER_ABI || owner.features || owner.reserved ||
+	    owner.ifindex <= 0 || owner.unit < 0)
+		return -EINVAL;
+
+	/* The ioctl's file reference pins the original open-file description.
+	 * RTNL excludes creation publication, unregister, rename and movement.
+	 */
+	rtnl_lock();
+	pf = file->private_data;
+	if (!pf || pf->kind != INTERFACE)
+		goto unlock;
+	dev = netdev_from_priv(PF_TO_PPP(pf));
+	err = ppp_validate_owner(dev, file);
+	if (err)
+		goto unlock;
+	if (!net_eq(dev_net(dev), current->nsproxy->net_ns)) {
+		err = -EXDEV;
+		goto unlock;
+	}
+	if (owner.ifindex != dev->ifindex || owner.unit != pf->index) {
+		err = -ESTALE;
+		goto unlock;
+	}
+	owner.features = PPP_OWNER_SETLINK;
+	if (IS_BUILTIN(CONFIG_INET))
+		owner.features |= PPP_OWNER_ADDR4;
+	if (IS_BUILTIN(CONFIG_IPV6))
+		owner.features |= PPP_OWNER_ADDR6;
+unlock:
+	rtnl_unlock();
+	if (err)
+		return err;
+	return copy_to_user(argp, &owner, sizeof(owner)) ? -EFAULT : 0;
+}
