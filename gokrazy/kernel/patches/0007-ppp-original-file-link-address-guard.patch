+/* Original creator-file validation; all fields have a fixed compat layout. */
+struct ppp_owner {
+	__u32 abi;
+	__u32 features;
+	__s32 ifindex;
+	__s32 unit;
+	__u32 reserved;
+};
+
+#define PPP_OWNER_ABI 1
+#define PPP_OWNER_SETLINK (1U << 0)
+#define PPP_OWNER_ADDR4   (1U << 1)
+#define PPP_OWNER_ADDR6   (1U << 2)
+#define PPPIOCGOWNER _IOWR('t', 51, struct ppp_owner)
+
+/*
+ * Ioctl definitions.
+ */
 
