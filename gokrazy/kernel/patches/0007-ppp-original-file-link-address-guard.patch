-static const struct nla_policy ifla_policy[IFLA_MAX+1] = {
+/* Drop the held file only after RTNL: final PPP release takes RTNL too. */
+struct file *rtnl_owner_file_get(const struct nlattr *attr)
+{
+	struct file *file;
+	s32 fd;
+
+	if (!attr)
+		return NULL;
+	fd = nla_get_s32(attr);
+	if (fd < 0)
+		return ERR_PTR(-EBADF);
+	file = fget(fd);
+	return file ? file : ERR_PTR(-EBADF);
+}
+EXPORT_SYMBOL_GPL(rtnl_owner_file_get);
+
+int rtnl_owner_validate(struct file *file, struct net_device *dev,
+			struct netlink_ext_ack *extack)
+{
+	const struct rtnl_link_ops *ops;
+
+	ASSERT_RTNL();
+	if (!file)
+		return 0;
+	if (!dev)
+		return -ENODEV;
+	ops = dev->rtnl_link_ops;
+	if (!ops || !ops->validate_owner) {
+		NL_SET_ERR_MSG(extack, "device has no creator-file guard");
+		return -EOPNOTSUPP;
+	}
+	return ops->validate_owner(dev, file);
+}
+EXPORT_SYMBOL_GPL(rtnl_owner_validate);
+
