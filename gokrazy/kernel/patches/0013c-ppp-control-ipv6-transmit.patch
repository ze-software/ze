+static struct inet6_dev *
+ppp_control_mc_idev(struct ppp_control_owner *owner, int ifindex)
+{
+	struct inet6_dev *idev = NULL;
+	struct net_device *dev;
+
+	rcu_read_lock();
+	dev = ppp_control_owner_dev(owner);
+	if (dev && (!ifindex || ifindex == dev->ifindex) &&
