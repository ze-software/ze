 			    const struct net_device *dev)
 {
 	struct net_device *original;
-
-	if (!owner)
-		return false;
-	original = ppp_control_owner_dev(owner);
-	return dev == original && ppp_control_dev_live(owner, original);
+	bool live;
+
+	if (!owner)
+		return false;
+	/* Some native callers precede their own output RCU section. Protect
+	 * the complete original pointer borrow here, including namespace read.
+	 */
+	rcu_read_lock();
+	original = ppp_control_owner_dev(owner);
+	live = dev == original && ppp_control_dev_live(owner, original);
+	rcu_read_unlock();
+	return live;
 }
 EXPORT_SYMBOL_GPL(ppp_control_owner_live);
 
