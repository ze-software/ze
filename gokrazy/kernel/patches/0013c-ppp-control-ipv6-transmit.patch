+static int ppp_control_mc_inc(struct inet6_dev *idev,
+			      struct ppp_control_owner *owner,
+			      const struct in6_addr *addr, unsigned int mode)
+{
+	struct net_device *dev = idev->dev;
+	struct ifmcaddr6 *mc;
+
+	mutex_lock(&idev->mc_lock);
+
+	if (READ_ONCE(idev->dead) ||
+	    (owner && !ppp_control_owner_live(owner, dev))) {
+		mutex_unlock(&idev->mc_lock);
+		in6_dev_put(idev);
+		return -ENODEV;
+	}
+
+	for_each_mc_mclock(idev, mc) {
+		if (ipv6_addr_equal(&mc->mca_addr, addr)) {
+			WRITE_ONCE(mc->mca_users, mc->mca_users + 1);
+			ip6_mc_add_src(idev, &mc->mca_addr, mode, 0, NULL, 0);
+			mutex_unlock(&idev->mc_lock);
+			in6_dev_put(idev);
+			return 0;
+		}
+	}
+
+	mc = mca_alloc(idev, addr, mode);
+	if (!mc) {
+		mutex_unlock(&idev->mc_lock);
+		in6_dev_put(idev);
+		return -ENOMEM;
+	}
+
+	rcu_assign_pointer(mc->next, mc_dereference(idev->mc_list, idev));
+	rcu_assign_pointer(idev->mc_list, mc);
+
+	mld_del_delrec(idev, mc);
+	igmp6_group_added(mc);
+	inet6_ifmcaddr_notify(dev, mc, RTM_NEWMULTICAST);
+	mutex_unlock(&idev->mc_lock);
+
+	return 0;
+}
+
+static int __ipv6_dev_mc_inc(struct net_device *dev,
+			     const struct in6_addr *addr, unsigned int mode)
+{
+	struct inet6_dev *idev = in6_dev_get(dev);
+
+	if (!idev)
+		return -EINVAL;
+	return ppp_control_mc_inc(idev, NULL, addr, mode);
 }
