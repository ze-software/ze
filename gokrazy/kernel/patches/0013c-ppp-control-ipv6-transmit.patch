@@ -330,2 +330,89 @@
 EXPORT_SYMBOL_GPL(ppp_control_receipt_consume);
+
+struct ppp_control_owner *ppp_control_sock_owner(const struct sock *sk)
+{
+#if IS_ENABLED(CONFIG_IPV6)
+	if (sk && sk->sk_family == AF_INET6)
+		return smp_load_acquire(&inet6_sk(sk)->ppp_control.owner);
+#endif
+	return NULL;
+}
+EXPORT_SYMBOL_GPL(ppp_control_sock_owner);
+
+bool ppp_control_sock_dev(const struct sock *sk, const struct net_device *dev)
+{
+	struct ppp_control_owner *owner = ppp_control_sock_owner(sk);
+
+	return !owner || ppp_control_owner_live(owner, dev);
+}
+EXPORT_SYMBOL_GPL(ppp_control_sock_dev);
+
+bool ppp_control_sock_dst(const struct sock *sk, const struct dst_entry *dst)
+{
+	struct ppp_control_owner *owner = ppp_control_sock_owner(sk);
+	bool allowed;
+
+	if (!owner)
+		return true;
+	rcu_read_lock();
+	allowed = dst && ppp_control_owner_live(owner, dst_dev_rcu(dst));
+	rcu_read_unlock();
+	return allowed;
+}
+EXPORT_SYMBOL_GPL(ppp_control_sock_dst);
+
+bool ppp_control_sock_index(const struct sock *sk, int ifindex)
+{
+	struct ppp_control_owner *owner = ppp_control_sock_owner(sk);
+	struct net_device *dev;
+	bool allowed;
+
+	if (!owner)
+		return true;
+	rcu_read_lock();
+	dev = ppp_control_owner_dev(owner);
+	allowed = dev && dev->ifindex == ifindex &&
+		  ppp_control_owner_live(owner, dev);
+	rcu_read_unlock();
+	return allowed;
+}
+EXPORT_SYMBOL_GPL(ppp_control_sock_index);
+
+bool ppp_control_tx_dev(const struct sk_buff *skb, const struct net_device *dev)
+{
+#if IS_ENABLED(CONFIG_PPP)
+	const struct ppp_control_receipt *receipt;
+
+	if (!skb->ppp_control_tx)
+		return true;
+	receipt = ppp_control_receipt(skb, PPP_CONTROL_TX);
+	return receipt && ppp_control_owner_live(receipt->owner, dev);
+#else
+	return true;
+#endif
+}
+EXPORT_SYMBOL_GPL(ppp_control_tx_dev);
+
+int ppp_control_tx_prepare(struct sock *sk, struct sk_buff *skb)
+{
+	struct ppp_control_owner *owner = ppp_control_sock_owner(sk);
+#if IS_ENABLED(CONFIG_PPP)
+	const struct ppp_control_receipt *receipt;
+#endif
+
+	if (owner) {
+		if (!ppp_control_owner_current(owner))
+			return -ESTALE;
+		return ppp_control_receipt_set(skb, owner, PPP_CONTROL_TX);
+	}
+#if IS_ENABLED(CONFIG_PPP)
+	if (skb->ppp_control_tx) {
+		receipt = ppp_control_receipt(skb, PPP_CONTROL_TX);
+		if (!receipt || !ppp_control_owner_current(receipt->owner))
+			return -ESTALE;
+	}
+#endif
+	return 0;
+}
+EXPORT_SYMBOL_GPL(ppp_control_tx_prepare);
 
