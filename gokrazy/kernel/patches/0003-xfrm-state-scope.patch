+#if IS_ENABLED(CONFIG_IPV6)
+/* The XFRM core can be built in while IPv6 is modular. Keep the decoder's
+ * extension classification local rather than linking ipv6_ext_hdr().
+ */
+static bool xfrm_ipv6_extension(unsigned int proto)
+{
+	return proto == NEXTHDR_HOP || proto == NEXTHDR_ROUTING ||
+		proto == NEXTHDR_FRAGMENT || proto == NEXTHDR_AUTH ||
+		proto == NEXTHDR_DEST;
+}
+
+/* A zero payload length permits bytes only with a valid Jumbo Payload option. */
+static int xfrm_jumbo_end(struct sk_buff *skb, int off, int end)
+{
+	struct ipv6_opt_hdr hop, *hdr;
+	u32 length = 0;
+	int pos, limit;
+
+	if (end - off < sizeof(hop))
+		return -EINVAL;
+	hdr = skb_header_pointer(skb, off, sizeof(hop), &hop);
+	if (!hdr || (hdr->hdrlen + 1) * 8 > end - off)
+		return -EINVAL;
+	limit = off + (hdr->hdrlen + 1) * 8;
+	for (pos = off + sizeof(hop); pos < limit;) {
+		u8 opt[2];
+
+		if (skb_copy_bits(skb, pos, opt, 1))
+			return -EINVAL;
+		if (opt[0] == IPV6_TLV_PAD1) {
+			pos++;
+			continue;
+		}
+		if (limit - pos < 2 || skb_copy_bits(skb, pos, opt, 2) ||
+		    opt[1] + 2 > limit - pos)
+			return -EINVAL;
+		if (opt[0] == IPV6_TLV_JUMBO) {
+			__be32 value;
+
+			if (length || opt[1] != 4 || (pos - off) % 4 != 2 ||
+			    skb_copy_bits(skb, pos + 2, &value, sizeof(value)))
+				return -EINVAL;
+			length = ntohl(value);
+			if (length <= IPV6_MAXPLEN)
+				return -EINVAL;
+		}
+		pos += opt[1] + 2;
+	}
+	if (!length)
+		return -EINVAL;
+	return off + min_t(u32, end - off, length);
+}
