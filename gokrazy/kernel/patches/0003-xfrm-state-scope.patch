+/* Decode only bytes present within both the skb and the IP length. A quoted
+ * packet may end before its ports: availability follows it through the same
+ * ordered SPD and state lookup used for complete packets.
+ */
+static int xfrm_packet_flow(struct sk_buff *skb, int start, int end,
+			    unsigned short family, bool reverse,
+			    struct flowi *fl, int *transport)
+{
+	union flowi_uli *uli;
+	unsigned int proto;
+	unsigned int fields = FLOWI_FLAG_XFRM_FIELDS | FLOWI_FLAG_XFRM_PROTO;
+	int off;
+	bool noninitial = false;
+	u8 bytes[4];
+
+	if (start > end)
+		return -EINVAL;
+	/* Callers may pass flowi4_to_flowi/flowi6_to_flowi on a family-sized
+	 * stack object, so clearing sizeof(struct flowi) would overrun it.
+	 */
+	if (family == AF_INET)
+		memset(&fl->u.ip4, 0, sizeof(struct flowi4));
+	else if (family == AF_INET6)
+		memset(&fl->u.ip6, 0, sizeof(struct flowi6));
+	else
+		return -EAFNOSUPPORT;
+	if (family == AF_INET) {
+		struct iphdr header, *ip;
+		unsigned int length;
+
+		if (end - start < sizeof(header))
+			return -EINVAL;
+		ip = skb_header_pointer(skb, start, sizeof(header), &header);
+		if (!ip || ip->version != 4 || ip->ihl < 5)
+			return -EINVAL;
+		length = ntohs(ip->tot_len);
+		off = start + ip->ihl * 4;
+		if (length < ip->ihl * 4 || off > end)
+			return -EINVAL;
+		end = start + min_t(int, end - start, length);
+		proto = ip->protocol;
+		noninitial = !!(ip->frag_off & htons(IP_OFFSET));
+		fl->u.ip4.saddr = reverse ? ip->daddr : ip->saddr;
+		fl->u.ip4.daddr = reverse ? ip->saddr : ip->daddr;
+		fl->u.ip4.flowi4_dscp = inet_dsfield_to_dscp(ip->tos);
+		uli = &fl->u.ip4.uli;
+	} else if (family == AF_INET6) {
+#if IS_ENABLED(CONFIG_IPV6)
+		struct ipv6hdr header, *ip;
+
+		if (end - start < sizeof(header))
+			return -EINVAL;
+		ip = skb_header_pointer(skb, start, sizeof(header), &header);
+		if (!ip || ip->version != 6)
+			return -EINVAL;
+		off = start + sizeof(header);
+		if (ip->payload_len) {
+			end = off + min_t(int, end - off, ntohs(ip->payload_len));
+		} else if (ip->nexthdr == NEXTHDR_HOP) {
+			end = xfrm_jumbo_end(skb, off, end);
+			if (end < 0)
+				return end;
+		} else {
+			end = off;
+		}
+		proto = ip->nexthdr;
+		fl->u.ip6.saddr = reverse ? ip->daddr : ip->saddr;
+		fl->u.ip6.daddr = reverse ? ip->saddr : ip->daddr;
+		uli = &fl->u.ip6.uli;
+		while (xfrm_ipv6_extension(proto)) {
+			struct ipv6_opt_hdr opt, *hdr;
+			unsigned int length;
+
+			if (end - off < sizeof(opt)) {
+				fields &= ~FLOWI_FLAG_XFRM_PROTO;
+				break;
+			}
+			hdr = skb_header_pointer(skb, off, sizeof(opt), &opt);
+			if (!hdr)
+				return -EINVAL;
+			if (proto == NEXTHDR_FRAGMENT) {
+				struct frag_hdr frag, *fh;
+
+				if (end - off < sizeof(frag)) {
+					fields &= ~FLOWI_FLAG_XFRM_PROTO;
+					break;
+				}
+				fh = skb_header_pointer(skb, off, sizeof(frag), &frag);
+				if (!fh)
+					return -EINVAL;
+				noninitial = !!(fh->frag_off & htons(IP6_OFFSET));
+				length = sizeof(frag);
+			} else if (proto == NEXTHDR_AUTH) {
+				length = (hdr->hdrlen + 2) * 4;
+				if (length < 12)
+					return -EINVAL;
+			} else {
+				length = (hdr->hdrlen + 1) * 8;
+			}
+			if (length > end - off) {
+				fields &= ~FLOWI_FLAG_XFRM_PROTO;
+				break;
+			}
+			proto = hdr->nexthdr;
+			off += length;
+			if (noninitial) {
+				if (xfrm_ipv6_extension(proto))
+					fields &= ~FLOWI_FLAG_XFRM_PROTO;
+				break;
+			}
+		}
+#else
+		return -EAFNOSUPPORT;
+#endif
+	} else {
+		return -EAFNOSUPPORT;
+	}
+	fl->flowi_proto = proto;
+	*transport = off;
+	if (noninitial || !(fields & FLOWI_FLAG_XFRM_PROTO))
+		goto done;
+	switch (proto) {
+	case IPPROTO_TCP:
+	case IPPROTO_UDP:
+	case IPPROTO_UDPLITE:
+	case IPPROTO_SCTP:
+		if (end - off >= 2 && skb_copy_bits(skb, off, bytes, 2) == 0) {
+			if (reverse)
+				memcpy(&uli->ports.dport, bytes, 2);
+			else
+				memcpy(&uli->ports.sport, bytes, 2);
+			fields |= reverse ? FLOWI_FLAG_XFRM_DPORT : FLOWI_FLAG_XFRM_SPORT;
+		}
+		if (end - off >= 4 && skb_copy_bits(skb, off + 2, bytes, 2) == 0) {
+			if (reverse)
+				memcpy(&uli->ports.sport, bytes, 2);
+			else
+				memcpy(&uli->ports.dport, bytes, 2);
+			fields |= reverse ? FLOWI_FLAG_XFRM_SPORT : FLOWI_FLAG_XFRM_DPORT;
+		}
+		break;
+	case IPPROTO_ICMP:
+	case IPPROTO_ICMPV6:
+		if (end - off >= 1 && skb_copy_bits(skb, off, bytes, 1) == 0) {
+			uli->icmpt.type = bytes[0];
+			fields |= FLOWI_FLAG_XFRM_SPORT;
+		}
+		if (end - off >= 2 && skb_copy_bits(skb, off + 1, bytes, 1) == 0) {
+			uli->icmpt.code = bytes[0];
+			fields |= FLOWI_FLAG_XFRM_DPORT;
+		}
+		break;
+	case IPPROTO_MH:
+		if (end - off >= 3 && skb_copy_bits(skb, off + 2, bytes, 1) == 0) {
+			uli->mht.type = bytes[0];
+			fields |= FLOWI_FLAG_XFRM_SPORT;
+		}
+		break;
+	case IPPROTO_GRE: {
+		struct gre_base_hdr header, *gre;
+
+		if (end - off < sizeof(header))
+			break;
+		gre = skb_header_pointer(skb, off, sizeof(header), &header);
+		if (!gre || (gre->flags & (GRE_VERSION | GRE_ROUTING)))
+			break;
+		if (!(gre->flags & GRE_KEY)) {
+			uli->gre_key = 0;
+			fields |= FLOWI_FLAG_XFRM_SPORT | FLOWI_FLAG_XFRM_DPORT;
+			break;
+		}
+		off += sizeof(header);
+		if (gre->flags & GRE_CSUM)
+			off += 4;
