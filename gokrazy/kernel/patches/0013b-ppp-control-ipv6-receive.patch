@@ -0,0 +1,99 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _NET_PPP_CONTROL_RX_H
+#define _NET_PPP_CONTROL_RX_H
+
+#include <linux/ipv6.h>
+#include <net/ppp_control.h>
+#include <net/sock.h>
+
+/* The binding is immutable until final inet6 cleanup. Socket RCU readers
+ * protect the final owner put; active syscall references exclude cleanup.
+ * Never reconstruct receive authority from a saved interface number.
+ */
+static inline bool ppp_control_rx_current(const struct sock *sk)
+{
+#if IS_ENABLED(CONFIG_IPV6)
+	const struct ppp_control_owner *owner;
+	bool live;
+
+	if (sk->sk_family != AF_INET6)
+		return true;
+	rcu_read_lock();
+	owner = smp_load_acquire(&inet6_sk(sk)->ppp_control.owner);
+	live = !owner || ppp_control_owner_current(owner);
+	rcu_read_unlock();
+	return live;
+#else
+	return true;
+#endif
+}
+
+/* Before queueing, dev is the actual ingress device. After queueing UDP
+ * overwrites it with accounting scratch, and other queues clear it.
+ * Those readers MUST use the retained native receipt, not dereference dev.
+ */
+static inline bool
+ppp_control_rx_match(const struct sock *sk, const struct sk_buff *skb,
+		     enum ppp_control_role role, bool ingress)
+{
+#if IS_ENABLED(CONFIG_IPV6)
+	const struct ppp_control_receipt *receipt;
+	const struct ppp_control_owner *owner;
+	bool allowed = true;
+
+	if (sk->sk_family != AF_INET6)
+		return true;
+	rcu_read_lock();
+	owner = smp_load_acquire(&inet6_sk(sk)->ppp_control.owner);
+	if (owner) {
+		receipt = skb ? ppp_control_receipt(skb, role) : NULL;
+		allowed = receipt && receipt->owner == owner &&
+			  ppp_control_owner_current(owner);
+		if (allowed && ingress)
+			allowed = skb->dev &&
+				  ppp_control_owner_live(owner, skb->dev);
+	}
+	rcu_read_unlock();
+	return allowed;
+#else
+	return true;
+#endif
+}
+
+static inline bool
+ppp_control_rx_eligible(const struct sock *sk, const struct sk_buff *skb)
+{
+	return ppp_control_rx_match(sk, skb, PPP_CONTROL_RX, true);
+}
+
+/* Fresh locally generated error/PMTU skbs have no ingress packet. The native
+ * caller supplies the original socket; attach its live TX role explicitly.
+ */
+static inline bool
+ppp_control_rx_local_error(struct sock *sk, struct sk_buff *skb)
+{
+#if IS_ENABLED(CONFIG_IPV6)
+	struct ppp_control_owner *owner;
+	bool allowed = true;
+
+	if (sk->sk_family != AF_INET6)
+		return true;
+	rcu_read_lock();
+	owner = smp_load_acquire(&inet6_sk(sk)->ppp_control.owner);
+	if (owner) {
+		if (!ppp_control_owner_try_get(owner)) {
+			allowed = false;
+		} else {
+			allowed = ppp_control_owner_current(owner) &&
+				  !ppp_control_receipt_set(skb, owner, PPP_CONTROL_TX);
+			ppp_control_owner_put(owner);
+		}
+	}
+	rcu_read_unlock();
+	return allowed;
+#else
+	return true;
+#endif
+}
+
+#endif
