@@ -2404,2 +2404,28 @@
+/* The existing unit's receive producer owns its identity. Do not install a
+ * second PPP reader or recover authority from a device name/index.
+ */
+static int ppp_control_rx_stamp(struct ppp *ppp, struct sk_buff *skb)
+{
+	struct ppp_control_owner *owner;
+	int err = 0;
+
+	rcu_read_lock();
+	owner = rcu_dereference(ppp->control_owner);
+	if (!owner || !ppp_control_rx_candidate(skb))
+		goto out;
+	if (!ppp_control_owner_try_get(owner)) {
+		err = -ESTALE;
+		goto out;
+	}
+	if (!ppp_control_owner_live(owner, skb->dev))
+		err = -ESTALE;
+	else
+		err = ppp_control_receipt_set(skb, owner, PPP_CONTROL_RX);
+	ppp_control_owner_put(owner);
+out:
+	rcu_read_unlock();
+	return err;
+}
+
