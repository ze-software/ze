-	if (receipt && receipt->owner && receipt->role == role)
+	if (receipt && receipt->owner &&
+	    (receipt->role == PPP_CONTROL_RX || receipt->role == PPP_CONTROL_TX))
 		return receipt;
 #endif
 	return NULL;
 }
+EXPORT_SYMBOL_GPL(ppp_control_receipt_any);
+
+const struct ppp_control_receipt *
+ppp_control_receipt(const struct sk_buff *skb, enum ppp_control_role role)
+{
+	const struct ppp_control_receipt *receipt = ppp_control_receipt_any(skb);
+
+	return receipt && receipt->role == role ? receipt : NULL;
+}
 EXPORT_SYMBOL_GPL(ppp_control_receipt);
