+/* Both native callers zero the entire comparison key first, including its
+ * padding. Do not copy receipt padding into a byte-compared hash key.
+ */
+static inline bool ip6frag_ppp_key(struct frag_v6_compare_key *key,
+				 const struct sk_buff *skb)
+{
+	const struct ppp_control_receipt *receipt = ppp_control_receipt_any(skb);
+
+	if (!receipt)
+		return true;
+	if (!ppp_control_owner_current(receipt->owner))
+		return false;
+	key->ppp_owner = receipt->owner;
+	key->ppp_role = receipt->role;
+	return true;
+}
+
+/* skb_morph/clone and both fragment paths preserve the original head's
+ * extensions. Verify that custody before exposing a completed datagram.
+ */
+static inline bool ip6frag_ppp_reassembled(const struct inet_frag_queue *q,
+					 const struct sk_buff *skb)
+{
+	const struct ppp_control_receipt *receipt = ppp_control_receipt_any(skb);
+
+	if (!q->key.v6.ppp_owner)
+		return !receipt;
+	return receipt && receipt->owner == q->key.v6.ppp_owner &&
+		receipt->role == q->key.v6.ppp_role &&
+		ppp_control_owner_current(receipt->owner);
+}
+
