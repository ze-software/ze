+ppp_control_receipt_any(const struct sk_buff *skb);
+/* any returns only an active, nonempty RX/TX receipt, borrowed from skb. */
+const struct ppp_control_receipt *
 ppp_control_receipt(const struct sk_buff *skb, enum ppp_control_role role);
--- a/net/core/ppp_control.c
+++ b/net/core/ppp_control.c
@@ -129,4 +129,30 @@
 EXPORT_SYMBOL_GPL(ppp_control_owner_live);
 
+bool ppp_control_owner_current(const struct ppp_control_owner *owner)
+{
+	bool live;
+
+	if (!owner)
+		return false;
+	rcu_read_lock();
+	live = ppp_control_owner_live(owner, owner->dev);
+	rcu_read_unlock();
+	return live;
+}
+EXPORT_SYMBOL_GPL(ppp_control_owner_current);
+
+struct net_device *
+ppp_control_owner_dev(const struct ppp_control_owner *owner)
+{
+	return owner ? owner->dev : NULL;
+}
+EXPORT_SYMBOL_GPL(ppp_control_owner_dev);
+
+unsigned int ppp_control_owner_size(const struct ppp_control_owner *owner)
+{
+	return owner ? ksize(owner) : 0;
+}
+EXPORT_SYMBOL_GPL(ppp_control_owner_size);
+
 struct net *ppp_control_owner_net_get(const struct ppp_control_owner *owner)
 {
