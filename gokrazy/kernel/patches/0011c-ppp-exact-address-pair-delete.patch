+	struct in_ifaddr __rcu **ifap, **match = NULL;
+	struct nlattr *tb[IFA_MAX+1];
+	struct in_device *in_dev;
+	struct ifaddrmsg *ifm;
+	struct in_ifaddr *ifa;
+	struct file *owner;
+	int err;
+
+	err = nlmsg_parse_deprecated(nlh, sizeof(*ifm), tb, IFA_MAX,
+				     ifa_ipv4_policy, extack);
+	if (err < 0)
+		goto out;
+
+	ifm = nlmsg_data(nlh);
+	if (tb[IFA_OWNER_FD] && (!tb[IFA_LOCAL] || !tb[IFA_ADDRESS] ||
+				 ifm->ifa_prefixlen > 32)) {
+		NL_SET_ERR_MSG(extack,
+			"ipv4: Guarded deletion requires an exact local/address/prefix tuple");
+		return -EINVAL;
+	}
+	owner = rtnl_owner_file_get(tb[IFA_OWNER_FD]);
+	if (IS_ERR(owner))
+		return PTR_ERR(owner);
+
+	rtnl_net_lock(net);
+	err = rtnl_owner_validate(owner, __dev_get_by_index(net, ifm->ifa_index), extack);
+	if (err)
+		goto unlock;
+
+	in_dev = inetdev_by_index(net, ifm->ifa_index);
+	if (!in_dev) {
+		NL_SET_ERR_MSG(extack, "ipv4: Device not found");
+		err = -ENODEV;
+		goto unlock;
+	}
+
+	for (ifap = &in_dev->ifa_list;
+	     (ifa = rtnl_net_dereference(net, *ifap)) != NULL;
+	     ifap = &ifa->ifa_next) {
+		if (tb[IFA_LOCAL] &&
+		    ifa->ifa_local != nla_get_in_addr(tb[IFA_LOCAL]))
+			continue;
+
+		if (tb[IFA_LABEL] && nla_strcmp(tb[IFA_LABEL], ifa->ifa_label))
+			continue;
+
+		if (owner) {
+			if (ifm->ifa_prefixlen != ifa->ifa_prefixlen ||
+			    ifa->ifa_address != nla_get_in_addr(tb[IFA_ADDRESS]))
+				continue;
+			if (match) {
+				NL_SET_ERR_MSG(extack, "ipv4: Ambiguous guarded address tuple");
+				err = -EEXIST;
+				goto unlock;
+			}
+			match = ifap;
+			continue;
+		}
+		if (tb[IFA_ADDRESS] &&
+		    (ifm->ifa_prefixlen != ifa->ifa_prefixlen ||
+		    !inet_ifa_match(nla_get_in_addr(tb[IFA_ADDRESS]), ifa)))
+			continue;
+		match = ifap;
+		break;
+	}
+
+	if (!match) {
+		NL_SET_ERR_MSG(extack, "ipv4: Address not found");
+		err = -EADDRNOTAVAIL;
+		goto unlock;
+	}
+	ifa = rtnl_net_dereference(net, *match);
+	if (ipv4_is_multicast(ifa->ifa_address))
+		ip_mc_autojoin_config(net, false, ifa);
+
+	/* Reuse native promotion, notifications and FIB reconstruction without
+	 * changing this device's configuration or deleting its other pairs.
+	 */
+	__inet_del_ifa(in_dev, match, 1, nlh, NETLINK_CB(skb).portid, owner != NULL);
 unlock:
 	rtnl_net_unlock(net);
 	if (owner)
 		fput(owner);
 out:
 	return err;
 }
 
