+		return PTR_ERR(owner);
+	err = rtm_to_fib6_config(skb, nlh, &cfg, extack);
+	if (err < 0)
+		goto out;
+
+	if (owner) {
+		rtnl_net_lock(net);
+		owner_dev = __dev_get_by_index(net, cfg.fc_ifindex);
