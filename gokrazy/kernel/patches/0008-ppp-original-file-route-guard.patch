-EXPORT_SYMBOL_GPL(rtnl_owner_file_get);
+EXPORT_SYMBOL_GPL(rtnl_owner_file_get);
+
+/* Admit only the single-device unicast form. Do this before family parsers:
+ * unsupported LWT and nexthop forms must not reach their own producers.
+ */
+struct file *rtnl_owner_route_get(const struct nlmsghdr *nlh)
+{
+	struct nlattr *owner_attr, *attr;
+	const struct rtmsg *rtm;
+	int remaining, owners = 0;
+	bool has_oif = false;
+
+	if (nlmsg_len(nlh) < sizeof(*rtm))
+		return ERR_PTR(-EINVAL);
+	owner_attr = nlmsg_find_attr(nlh, sizeof(*rtm), RTA_OWNER_FD);
+	if (!owner_attr)
+		return NULL;
+	if (nla_len(owner_attr) != sizeof(s32))
+		return ERR_PTR(-EINVAL);
+	rtm = nlmsg_data(nlh);
+	if ((rtm->rtm_family != AF_INET && rtm->rtm_family != AF_INET6) ||
+	    (rtm->rtm_type != RTN_UNSPEC && rtm->rtm_type != RTN_UNICAST) ||
+	    rtm->rtm_src_len || rtm->rtm_tos || rtm->rtm_flags)
+		return ERR_PTR(-EOPNOTSUPP);
+
+	nlmsg_for_each_attr(attr, nlh, sizeof(*rtm), remaining) {
+		switch (nla_type(attr)) {
+		case RTA_OWNER_FD:
+			if (++owners != 1 || nla_len(attr) != sizeof(s32))
+				return ERR_PTR(-EINVAL);
+			break;
+		case RTA_OIF:
+			if (nla_len(attr) != sizeof(s32) || nla_get_s32(attr) <= 0)
+				return ERR_PTR(-EINVAL);
+			has_oif = true;
+			break;
+		case RTA_DST:
+		case RTA_GATEWAY:
+		case RTA_PRIORITY:
+		case RTA_TABLE:
+		case RTA_PREFSRC:
+		case RTA_METRICS:
+		case RTA_PAD:
+			break;
+		default:
+			return ERR_PTR(-EOPNOTSUPP);
+		}
+	}
+	if (remaining || !has_oif)
+		return ERR_PTR(-EINVAL);
+	return rtnl_owner_file_get(owner_attr);
+}
+EXPORT_SYMBOL_GPL(rtnl_owner_route_get);
 
