-#define PPP_OWNER_ADDR6   (1U << 2)
+#define PPP_OWNER_ADDR6   (1U << 2)
+#define PPP_OWNER_ROUTE4  (1U << 3)
+#define PPP_OWNER_ROUTE6  (1U << 4)
 #define PPPIOCGOWNER _IOWR('t', 51, struct ppp_owner)
 
