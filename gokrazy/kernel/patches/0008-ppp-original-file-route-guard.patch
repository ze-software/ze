+/* Check the whole priority group: replacement, duplicate updates and sibling
+ * insertion can change existing members before the final route pointer write.
+ * The caller holds this table's tb6_lock over both selection and mutation.
+ */
+static int fib6_owner_node_check(struct fib6_node *fn, struct fib6_info *rt,
+				 const struct net_device *owner)
+{
+	struct fib6_info *iter;
+	int err;
+
+	err = fib6_owner_check(rt, owner);
+	if (err || !owner || !fn || !(fn->fn_flags & RTN_RTINFO))
+		return err;
+	for (iter = rcu_dereference_protected(fn->leaf,
+			lockdep_is_held(&rt->fib6_table->tb6_lock));
+	     iter;
+	     iter = rcu_dereference_protected(iter->fib6_next,
+			lockdep_is_held(&rt->fib6_table->tb6_lock))) {
+		if (iter == dev_net(owner)->ipv6.fib6_null_entry ||
+		    iter->fib6_metric != rt->fib6_metric)
+			continue;
+		err = fib6_owner_check(iter, owner);
+		if (err)
+			return err;
+	}
+	return 0;
+}
