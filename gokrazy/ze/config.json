{
    "Hostname": "ze",
    "Update": {},
    "Environment": [
        "GOOS=linux"
    ],
    "Packages": [
        "codeberg.org/thomas-mangin/ze/cmd/ze-serial-shell",
        "codeberg.org/thomas-mangin/ze/cmd/ze"
    ],
    "GokrazyPackages": [
        "github.com/gokrazy/gokrazy/cmd/randomd",
        "github.com/gokrazy/gokrazy/cmd/heartbeat"
    ],
    "PackageConfig": {
        "github.com/gokrazy/gokrazy/cmd/randomd": {
            "ExtraFileContents": {
                "/etc/machine-id": "8c41122ccef146da873e644db09cde89\n"
            }
        },
        "codeberg.org/thomas-mangin/ze/cmd/ze": {
            "CommandLineFlags": [
                "start"
            ],
            "GoBuildTags": ["ze_core", "ze_appliance", "ze_bgp", "ze_bmp", "ze_gnmi", "ze_grpc", "ze_isis", "ze_ldp", "ze_lg", "ze_mcp", "ze_mrt", "ze_ospf", "ze_rest", "ze_rsvpte", "ze_ssh", "ze_telemetry", "ze_vrrp", "ze_web"],
            "Environment": [
                "ze.config.dir=/perm/ze",
                "ze.bgp.api.socketpath=/tmp/ze.socket",
                "ze.bgp.daemon.drop=false",
                "ze.log=info",
                "ze.log.backend=kmsg,stderr",
                "ze.gokrazy.enabled=true"
            ]
        }
    },
    "SerialConsole": "ttyS0,115200",
    "KernelExtraArgs": ["loglevel=8", "printk.devkmsg=on"],
    "KernelPackage": "github.com/rtr7/kernel",
    "FirmwarePackage": "",
    "EEPROMPackage": ""
}
