+# Test: real TCP received-route GR -> LLGR wire.
+# No local static routes are used as retention evidence. Both OPEN directions
+# reach GR. Receipt-store observations release TCP close and EOR via wire markers.
+stdin=source:terminator=EOF_SOURCE
+option=tcp_connections:value=1
+option=timeout:value=40s
+option=linger:value=true
+option=open:value=router-id:id=192.0.2.1
+option=open:value=graceful-restart:restart-time=3:family=ipv4/unicast
+option=open:value=llgr:stale-time=60:family=ipv4/unicast
+# Wait for the observer's destination-ready marker, not merely source readiness.
+expect=bgp:conn=1:seq=1:contains=18C63363
+action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00300200000015400101004002004003040A00000240050400000064180A0000
+action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0037020000001C400101004002004003040A00000240050400000064C00804FFFF0007180A0001
+action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00300200000015400101004002004003040A00000240050400000064180A0002
+# IPv6 is negotiated but absent from both remote retention capabilities.
+action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0046020000002F40010100400200400504000000C8800E1E00020110200100000000000000000000000000110040FC00000100000000
+expect=bgp:conn=1:seq=2:contains=18CB0070
+expect=bgp:conn=1:seq=2:contains=18C63364
+action=close:conn=1:seq=3
+EOF_SOURCE
+
+stdin=control:terminator=EOF_CONTROL
+option=tcp_connections:value=1
+option=timeout:value=40s
+option=linger:value=true
+option=open:value=router-id:id=192.0.2.2
+option=open:value=graceful-restart:restart-time=3
+option=open:value=llgr:stale-time=60
+expect=bgp:conn=1:seq=1:contains=180A0000
+expect=bgp:conn=1:seq=1:contains=180A0001
+expect=bgp:conn=1:seq=1:contains=180A0002
+expect=bgp:conn=1:seq=1:contains=40FC00000100000000
+# A real received ACK fences initial wire delivery before the source can close.
+action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00300200000015400101004002004003040A0000024005040000006418CB0070
+# The nonretained family withdraws at DOWN, while IPv4 survives into LLGR.
+expect=bgp:conn=1:seq=2:contains=00020140FC00000100000000
+expect=bgp:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF001B020004180A00010000
+expect=bgp:conn=1:seq=2:contains=FFFF0006
+action=send:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00300200000015400101004002004003040A0000024005040000006418CB0071
+EOF_CONTROL
+
