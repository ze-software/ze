+# FRR daemons file — shared across all interop scenarios.
+# zebra (routing table), bgpd (BGP), and bfdd (BFD for scenario
+# bfd-frr). bfdd is lightweight and idle when no scenario
+# configures BFD, so enabling it globally keeps the scenario
+# runner simple.
+zebra=yes
+bgpd=yes
+ospfd=yes
+ospf6d=yes
+ripd=no
+ripngd=no
+isisd=yes
+pimd=no
+pim6d=no
+ldpd=yes
+nhrpd=no
+eigrpd=no
+babeld=no
+sharpd=no
+pbrd=no
+bfdd=yes
+fabricd=no
+vrrpd=no
+pathd=no
diff --git a/test/interop/scenarios/ldp-backoff-clear-frr/frr.conf b/test/interop/scenarios/ldp-backoff-clear-frr/frr.conf
new file mode 100644
index 0000000000..d9c12121ae
--- /dev/null
+++ b/test/interop/scenarios/ldp-backoff-clear-frr/frr.conf
@@ -0,0 +1,22 @@
+frr defaults traditional
+hostname frr-ldp-backoff-clear
+log file /tmp/frr.log debugging
+!
+! FRR's transport address (172.30.0.3) is lower than ze's (172.30.0.250), so
+! FRR plays the passive role and ze, which only plays the active one, dials.
+! After the clear FRR waits for ze: ldpd's session_accept closes a connection
+! from a neighbor for which FRR would hold the active role, and FRR dials only
+! when nbr_session_active_role says it holds it.
+!
+! The Hello interval is 1 s because ze dials on each Hello it receives from
+! FRR (processDiscoveryPacket, startSessionForAdj): it is the cadence of ze's
+! redial, and the checker's bound on the redial is derived from it.
+mpls ldp
+ router-id 172.30.0.3
+ !
+ address-family ipv4
+  discovery hello interval 1
+  discovery transport-address 172.30.0.3
+  interface eth0
+ exit-address-family
+!
diff --git a/test/interop/scenarios/ldp-backoff-clear-frr/ze.conf b/test/interop/scenarios/ldp-backoff-clear-frr/ze.conf
new file mode 100644
index 0000000000..2634ea5319
--- /dev/null
+++ b/test/interop/scenarios/ldp-backoff-clear-frr/ze.conf
@@ -0,0 +1,26 @@
+# Ze side of the ldp-backoff-clear-frr interop scenario
+# (spec-single-owner-lifecycle-5-session-end-locals, RFC 5036 Section 2.5.3).
+#
+# Ze forms an LDP session with FRR ldpd over eth0. FRR then clears it with
+# `clear mpls ldp neighbor`, and the checker requires ze to dial again on FRR's
+# next Hello: a session that reached OPERATIONAL leaves no setup backoff
+# behind, so its end is not followed by the 15 s delay a failed setup imposes.
+#
+# The transport address 172.30.0.250 is higher than FRR's, which makes ze the
+# active LSR (RFC 5036 Section 2.5.2): ze plays only the active role, so ze is
+# the side that redials. The checker adds it to eth0 once the lab is up.
+#
+# The ldp subsystem logs at info, so the checker reads ze's own record of the
+# session end and of every setup backoff it records.
+
+environment {
+	log {
+		ldp info
+	}
+}
+
+ldp {
+	lsr-id 172.30.0.2
+	transport-address 172.30.0.250
+	interfaces eth0
+}
diff --git a/test/draft/ldp/ldp-session-end-clears-backoff.ci b/test/draft/ldp/ldp-session-end-clears-backoff.ci
new file mode 100644
index 0000000000..ac653df1e2
--- /dev/null
+++ b/test/draft/ldp/ldp-session-end-clears-backoff.ci
@@ -0,0 +1,69 @@
+# Test: an LDP session that reached operational and then ended leaves no setup
+# backoff, so Ze dials its neighbor again on the neighbor's next Hello, and
+# publishes exactly one session-down for that session.
+#
+# VALIDATES: spec-single-owner-lifecycle-5-session-end-locals AC-1 and AC-2 --
+#            startSessionForAdj's session-end callback deletes the backoff of
+#            a session that reached OPERATIONAL, and publishes one SessionDown
+#            for it, through the daemon on a real link.
+# PREVENTS:  a session that ran for days being redialled only after 15 seconds,
+#            then 30, up to 2 minutes, because its end was recorded as a failed
+#            setup attempt (plan/journal/state-read-after-teardown-reset-it.md,
+#            2026-10-02).
+#
+# WHY A .ci. internal/plugins/ldp/session_end_test.go drives the same callback
+# over net.Pipe with a test dialer. This test answers whether the daemon does it
+# end to end: a multicast Link Hello on a veth link, discovery, Ze's dial to TCP
+# 646, the Initialization exchange, the session end, and the redial a real
+# neighbor sees.
+#
+# HOW. `ldp/neighbor-link` runs the daemon in its own network namespace, joined
+# by a veth pair to a second one that holds the neighbor's link
+# (internal/test/fixture/ldp_neighbor_linux.go says why both are needed). The
+# observer plugin `ldp/session-end-clears-backoff` is the neighbor: it sends
+# Hellos, accepts Ze's session and brings it to operational, then closes it
+# with its Hellos paused. Once `show ldp neighbor` reads `discovered` and the
+# observer holds the session-down, it sends ONE Hello and requires Ze's next
+# session to open within 10 seconds, below the 15-second floor a failed setup
+# waits. The decision log is the second half: a session end recorded as a
+# failed setup logs `session setup failed, next attempt delayed` for the
+# neighbor, rejected below.
+#
+# The observer requires the neighbor's session events to be exactly
+# session-up, session-down, session-up, each naming peer 10.99.0.1 and
+# interface ldpz0. The second session is left operational and ends with the
+# daemon, after the Hellos stop, so nothing dials after it.
+#
+# STATUS: a Linux/QEMU test. The fixture creates network namespaces and a veth
+# pair, which needs root (`./le test qemu ci test test/ldp/ldp-session-end-clears-backoff.ci`).
+option=needs-linux:caps=net-admin
+option=env:var=ze.log.ldp:value=info
+option=timeout:value=90s
+
+tmpfs=ldp.conf:terminator=EOF_CONF
+plugin {
+	external ldp-neighbor {
+		run "le test fixture ldp/session-end-clears-backoff netns zls$PORT-n"
+		encoder json
+	}
+}
+
+ldp {
+	lsr-id 10.99.0.2
+	transport-address 10.99.0.2
+	hello-interval 5
+	hello-hold-time 15
+	keepalive-time 60
+	interfaces ldpz0
+}
+EOF_CONF
+
+cmd=foreground:seq=1:exec=le test fixture ldp/neighbor-link netns zls$PORT run ze start ldp.conf:timeout=85s
+expect=exit:code=0
+expect=stderr:contains=ldp: discovery started on interface
+expect=stderr:contains=OK: Ze dialled 10.99.0.1:0
+expect=stderr:pattern=OK: .*events \[session-up session-down session-up\]
+reject=stderr:pattern=session setup failed, next attempt delayed.*peer=10\.99\.0\.1:0
+reject=stderr:pattern=ZE-OBSERVER-FAIL
+reject=stderr:pattern=panic
+reject=stderr:pattern=fatal error
diff --git a/test/draft/ldp/ldp-setup-failure-publishes-no-session-down.ci b/test/draft/ldp/ldp-setup-failure-publishes-no-session-down.ci
