diff --git a/internal/le/interoplab/bgp/check_ldp_backoff_clear.go b/internal/le/interoplab/bgp/check_ldp_backoff_clear.go
new file mode 100644
index 0000000000..504c07c4e8
--- /dev/null
+++ b/internal/le/interoplab/bgp/check_ldp_backoff_clear.go
@@ -0,0 +1,280 @@
+// Design: docs/architecture/testing/interop.md -- concurrent state validation.
+// Related: check_ldp_init_unknown_tlv.go -- ldpTransportAddressAdd and ldpTransportHost, the active-role transport address this scenario shares.
+// Related: check_ldp_keepalive_expiry.go -- the LDP scenario whose FRR state names this one reads.
+// Related: check_special.go -- specialCheckers registry entry.
+package bgp
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/ze-software/ze/internal/core/textbuf"
+	"github.com/ze-software/ze/internal/le/interoplab"
+)
+
+// ldpBackoffClearScenario proves that an LDP session which reached OPERATIONAL
+// leaves no setup backoff behind when it ends: after FRR clears the session,
+// ze dials again on FRR's next Hello rather than after the 15 s that RFC 5036
+// Section 2.5.3 puts after a NAK'd Initialization.
+const ldpBackoffClearScenario = "ldp-backoff-clear-frr"
+
+const (
+	// ldpClearSettled is how long FRR must report the session OPERATIONAL
+	// before the clear. A session that was never cleared then reports an
+	// upTime at least this much longer than the time since the clear, so a
+	// fresh upTime proves a re-establishment (ldpNeighbor.reestablishedWithin).
+	ldpClearSettled = 3 * time.Second
+	// ldpClearRedialBound is the longest the session may take to be OPERATIONAL
+	// again after the clear. ze dials on each Hello it receives from FRR
+	// (processDiscoveryPacket calls startSessionForAdj), and frr.conf sets
+	// FRR's Hello interval to 1 s, so with the backoff released ze dials within
+	// 1 s of the session end; the TCP connect and the Initialization and
+	// KeepAlive exchange on one bridge take milliseconds, and the probe adds at
+	// most ldpClearPoll and one docker exec. That path lands near 2 s. A session
+	// end that records a setup failure (recordSetupFailure) forbids a dial for
+	// setupRetryDelayMin, 15 s, after the end, so that path lands at 15 s or
+	// later. 8 s leaves 6 s above the first and 7 s below the second.
+	ldpClearRedialBound = 8 * time.Second
+	// ldpClearRecoveryWait outlasts the 15 s backoff with margin, so a red run
+	// reports the measured delay rather than a timeout.
+	ldpClearRecoveryWait = 45 * time.Second
+	ldpClearPoll         = 250 * time.Millisecond
+	// ldpClearEstablishWait covers discovery, ze's first dial and FRR's
+	// handling of it.
+	ldpClearEstablishWait = 120 * time.Second
+	// ldpClearLogLinesMax bounds each read of ze's log. The scenario logs a few
+	// hundred lines, so both reads hold its whole history and the counts
+	// compared in requireLDPBackoffReleased see every line.
+	ldpClearLogLinesMax = 20000
+)
+
+// The messages ze's LDP plugin logs, counted in ze's log before and after the
+// clear. Each is the msg of one call: Session.ReadLoop (Warn) on FRR's fatal
+// Shutdown Notification, runSession (Info) when the session ends, and
+// recordSetupFailure (Info) when it records a setup backoff.
+const (
+	ldpZeFatalNotification = "ldp: fatal notification received, closing the session"
+	ldpZeSessionEnded      = "ldp: session ended"
+	ldpZeSetupFailed       = "ldp: session setup failed, next attempt delayed"
+)
+
+var frrShowLDPNeighborJSON = []string{cmdVtysh, "-c", "show mpls ldp neighbor json"}
+
+// checkLDPBackoffClear brings the LDP session with FRR to OPERATIONAL, has FRR
+// clear it, and requires ze to bring it back within ldpClearRedialBound, with
+// no setup backoff recorded for its end.
+//
+// FRR 10.7.1's `clear mpls ldp neighbor <address>` (ldp_vty_clear_nbr, then
+// nbr_clear_ctl) matches the neighbor's transport address and calls
+// session_shutdown with S_SHUTDOWN: FRR sends a Shutdown Notification and
+// closes the TCP connection, the Hello adjacency and the neighbor survive, and
+// FRR arms no initialization delay of its own. FRR holds the passive role, so
+// the redial measured here is ze's.
+//
+// The proof does not rest on wall time alone. ze's own log must show FRR's
+// Shutdown reaching it and the session ending, and must show no setup backoff
+// recorded for that end. FRR's upTime (show_nbr_msg_json, nbr_to_ctl) is 0
+// outside OPERATIONAL and restarts on each entry to it, so a fresh upTime
+// proves FRR saw the session come back.
+func checkLDPBackoffClear(ctx context.Context, check *interoplab.CheckContext) error {
+	if !check.Network.IPv4.IsValid() {
+		return errors.New("the LDP backoff clear scenario has no selected IPv4 network")
+	}
+	zeTransport := networkHostAddress(check.Network, ldpTransportHost)
+	if _, err := check.Lab.Exec(ctx, "ze", ldpTransportAddressAdd(check.Network), nil); err != nil {
+		return fmt.Errorf("add ze's LDP transport address: %w", err)
+	}
+
+	probe := func(probeCtx context.Context) (string, error) {
+		return check.Lab.Query(probeCtx, peerFRR, frrShowLDPNeighborJSON, nil)
+	}
+	_, _, err := interoplab.Wait(ctx, interoplab.WaitOptions{
+		Timeout:     ldpClearEstablishWait,
+		Interval:    time.Second,
+		Description: "FRR's LDP session with ze OPERATIONAL for 3 s",
+	}, probe, func(output string) bool {
+		neighbor, err := frrLDPNeighborAt(output, zeTransport)
+		return err == nil && neighbor.settled()
+	})
+	if err != nil {
+		return fmt.Errorf("the LDP session with ze never stayed OPERATIONAL for %s: %w", ldpClearSettled, err)
+	}
+
+	before, err := readZeLDPLog(ctx, check.Lab)
+	if err != nil {
+		return fmt.Errorf("read ze's log before the clear: %w", err)
+	}
+
+	var clear textbuf.Buffer
+	clearCommand := []string{cmdVtysh, "-c", clear.Str("clear mpls ldp neighbor ").Str(zeTransport).String()}
+	clearStart := time.Now()
+	if _, err := check.Lab.Exec(ctx, peerFRR, clearCommand, nil); err != nil {
+		return fmt.Errorf("clear FRR's LDP session with ze: %w", err)
+	}
+	_, _, recoveryErr := interoplab.Wait(ctx, interoplab.WaitOptions{
+		Timeout:     ldpClearRecoveryWait,
+		Interval:    ldpClearPoll,
+		Description: "FRR's LDP session with ze OPERATIONAL again after the clear",
+	}, probe, func(output string) bool {
+		neighbor, err := frrLDPNeighborAt(output, zeTransport)
+		return err == nil && neighbor.reestablishedWithin(time.Since(clearStart))
+	})
+	redial := time.Since(clearStart)
+
+	after, err := readZeLDPLog(ctx, check.Lab)
+	if err != nil {
+		return fmt.Errorf("read ze's log after the clear: %w", err)
+	}
+	if err := requireLDPBackoffReleased(countZeLDPLog(before), countZeLDPLog(after)); err != nil {
+		return fmt.Errorf("%w (the probes ended %s after the clear)", err, redial.Round(time.Millisecond))
+	}
+	if recoveryErr != nil {
+		return fmt.Errorf("FRR's LDP session with ze was not OPERATIONAL again within %s of the clear: %w", ldpClearRecoveryWait, recoveryErr)
+	}
+	return requireLDPRedialWithin(redial)
+}
+
+// readZeLDPLog reads ze's log, refusing a log Docker could not read: the
+// setup-backoff count is read for its absence, and an unreadable log holds
+// none.
+func readZeLDPLog(ctx context.Context, lab interoplab.CheckerLab) (string, error) {
+	logs, err := lab.Logs(ctx, "ze", ldpClearLogLinesMax)
+	if err != nil {
+		return "", err
+	}
+	if !logs.Available {
+		return "", errors.New("ze's log is not readable, so the setup backoff it records could not be read")
+	}
+	return logs.Text, nil
+}
+
+// zeLDPLogCounts is how many times ze's log carries each LDP message the
+// scenario judges.
+type zeLDPLogCounts struct {
+	fatalNotifications int
+	sessionsEnded      int
+	setupFailures      int
+}
+
+// countZeLDPLog counts the judged messages in a read of ze's log.
+func countZeLDPLog(zeLog string) zeLDPLogCounts {
+	return zeLDPLogCounts{
+		fatalNotifications: strings.Count(zeLog, ldpZeFatalNotification),
+		sessionsEnded:      strings.Count(zeLog, ldpZeSessionEnded),
+		setupFailures:      strings.Count(zeLog, ldpZeSetupFailed),
+	}
+}
+
+// requireLDPBackoffReleased judges ze's log across the clear. ze must log a
+// new fatal Notification, the Shutdown FRR sent, so the clear reached ze; a
+// new session end at info, so the info lines are read and the next count's
+// absence means something; and no new setup failure, because the session that
+// ended had reached OPERATIONAL.
+func requireLDPBackoffReleased(before, after zeLDPLogCounts) error {
+	if after.fatalNotifications <= before.fatalNotifications {
+		return fmt.Errorf("ze logged no %q after FRR's clear, so FRR's Shutdown Notification never reached ze", ldpZeFatalNotification)
+	}
+	if after.sessionsEnded <= before.sessionsEnded {
+		return fmt.Errorf("ze logged no %q at info after FRR's clear, so the absence of a setup backoff in its log proves nothing: the scenario's ze.conf must keep `environment { log { ldp info } }`", ldpZeSessionEnded)
+	}
+	if after.setupFailures > before.setupFailures {
+		return fmt.Errorf("ze logged %q %d time(s) after FRR cleared a session that had reached OPERATIONAL: its end recorded a setup backoff, which delays the redial by 15 s or more", ldpZeSetupFailed, after.setupFailures-before.setupFailures)
+	}
+	return nil
+}
+
+// requireLDPRedialWithin judges the time from the clear to FRR seeing the
+// session OPERATIONAL again. redial is measured from before the clear was sent
+// to after the probe that saw it, so it never undercounts the real delay.
+func requireLDPRedialWithin(redial time.Duration) error {
+	if redial > ldpClearRedialBound {
+		return fmt.Errorf("FRR's LDP session with ze was OPERATIONAL again %s after the clear, beyond the %s bound: ze dials on each FRR Hello (1 s), so a later redial is a setup backoff left by a session that had reached OPERATIONAL", redial.Round(time.Millisecond), ldpClearRedialBound)
+	}
+	return nil
+}
+
+// frrLDPNeighbors is the answer of FRR's `show mpls ldp neighbor json`:
+// show_nbr_msg_json writes one object per neighbor under "neighbors".
+type frrLDPNeighbors struct {
+	Neighbors []frrLDPNeighborJSON `json:"neighbors"`
+}
+
+type frrLDPNeighborJSON struct {
+	State            string `json:"state"`
+	TransportAddress string `json:"transportAddress"`
+	UpTime           string `json:"upTime"`
+}
+
+// ldpNeighbor is one FRR LDP neighbor with its upTime parsed.
+type ldpNeighbor struct {
+	state  string
+	upTime time.Duration
+}
+
+// frrLDPNeighborAt decodes FRR's neighbor list and answers the neighbor whose
+// transport address is transport. It refuses an answer that does not decode,
+// lists no such neighbor, or carries an upTime it cannot read.
+func frrLDPNeighborAt(output, transport string) (ldpNeighbor, error) {
+	var answer frrLDPNeighbors
+	if err := json.Unmarshal([]byte(output), &answer); err != nil {
+		return ldpNeighbor{}, fmt.Errorf("decode FRR's LDP neighbors: %w", err)
+	}
+	for _, neighbor := range answer.Neighbors {
+		if neighbor.TransportAddress != transport {
+			continue
+		}
+		upTime, err := parseFRRUpTime(neighbor.UpTime)
+		if err != nil {
+			return ldpNeighbor{}, err
+		}
+		return ldpNeighbor{state: neighbor.State, upTime: upTime}, nil
+	}
+	return ldpNeighbor{}, fmt.Errorf("FRR lists no LDP neighbor at transport address %s", transport)
+}
+
+// parseFRRUpTime reads ldpd's log_time form for an age under one day,
+// HH:MM:SS. The day and week forms are refused: no session in this scenario
+// lives that long.
+func parseFRRUpTime(upTime string) (time.Duration, error) {
+	fields := strings.Split(upTime, ":")
+	if len(fields) != 3 {
+		return 0, fmt.Errorf("FRR's LDP upTime %q is not HH:MM:SS", upTime)
+	}
+	var seconds time.Duration
+	for index, unit := range []time.Duration{time.Hour, time.Minute, time.Second} {
+		value, err := strconv.Atoi(fields[index])
+		if err != nil {
+			return 0, fmt.Errorf("FRR's LDP upTime %q is not HH:MM:SS: %w", upTime, err)
+		}
+		if value < 0 {
+			return 0, fmt.Errorf("FRR's LDP upTime %q holds a negative field", upTime)
+		}
+		seconds += time.Duration(value) * unit
+	}
+	return seconds, nil
+}
+
+// settled reports whether the session has been OPERATIONAL for ldpClearSettled.
+func (n ldpNeighbor) settled() bool {
+	if n.state != ldpStateOperational {
+		return false
+	}
+	return n.upTime >= ldpClearSettled
+}
+
+// reestablishedWithin reports whether the session is OPERATIONAL with an
+// upTime no longer than sinceClear, the time since the clear was sent. upTime
+// is whole seconds rounded down, so a session that came back after the clear
+// always passes, and one up since before it, settled for ldpClearSettled, is
+// always at least 2 s too old to.
+func (n ldpNeighbor) reestablishedWithin(sinceClear time.Duration) bool {
+	if n.state != ldpStateOperational {
+		return false
+	}
+	return n.upTime <= sinceClear
+}
diff --git a/internal/le/interoplab/bgp/check_ldp_backoff_clear_test.go b/internal/le/interoplab/bgp/check_ldp_backoff_clear_test.go
new file mode 100644
index 0000000000..e27633714d
--- /dev/null
+++ b/internal/le/interoplab/bgp/check_ldp_backoff_clear_test.go
@@ -0,0 +1,134 @@
+package bgp
+
+import (
+	"strings"
+	"testing"
+	"time"
+)
+
+// frrLDPNeighborsAnswer is composed from the fields FRR 10.7.1's
+// show_nbr_msg_json writes (ldpd/ldp_vty_exec.c) for ze at its transport
+// address and a second neighbor; it is not a capture of a lab run.
+const frrLDPNeighborsAnswer = `{"neighbors":[` +
+	`{"addressFamily":"ipv4","neighborId":"172.30.0.9","state":"OPERATIONAL","transportAddress":"172.30.0.9","upTime":"01:00:00"},` +
+	`{"addressFamily":"ipv4","neighborId":"172.30.0.2","state":"OPERATIONAL","transportAddress":"172.30.0.250","upTime":"00:00:07"}]}`
+
+// VALIDATES: the checker reads the neighbor at ze's transport address, with
+// its state and its HH:MM:SS upTime.
+// PREVENTS: another neighbor's state or upTime judged as ze's, and an
+// unreadable answer read as a neighbor.
+func TestFRRLDPNeighborAt(t *testing.T) {
+	neighbor, err := frrLDPNeighborAt(frrLDPNeighborsAnswer, "172.30.0.250")
+	if err != nil {
+		t.Fatalf("frrLDPNeighborAt: %v", err)
+	}
+	if neighbor.state != ldpStateOperational {
+		t.Fatalf("state = %q, want %q", neighbor.state, ldpStateOperational)
+	}
+	if neighbor.upTime != 7*time.Second {
+		t.Fatalf("upTime = %s, want 7s", neighbor.upTime)
+	}
+	for name, answer := range map[string]string{
+		"absent":     `{"neighbors":[{"state":"OPERATIONAL","transportAddress":"172.30.0.9","upTime":"00:00:07"}]}`,
+		"empty":      `{"neighbors":[]}`,
+		"not json":   `% Unknown command: show mpls ldp neighbor json`,
+		"day form":   `{"neighbors":[{"state":"OPERATIONAL","transportAddress":"172.30.0.250","upTime":"1d02h03m"}]}`,
+		"bad digits": `{"neighbors":[{"state":"OPERATIONAL","transportAddress":"172.30.0.250","upTime":"00:0x:07"}]}`,
+		"negative":   `{"neighbors":[{"state":"OPERATIONAL","transportAddress":"172.30.0.250","upTime":"00:-1:07"}]}`,
+	} {
+		if _, err := frrLDPNeighborAt(answer, "172.30.0.250"); err == nil {
+			t.Errorf("%s: frrLDPNeighborAt accepted %s", name, answer)
+		}
+	}
+}
+
+// VALIDATES: the session counts as settled only OPERATIONAL for 3 s, and as
+// re-established only OPERATIONAL with an upTime no older than the clear.
+// PREVENTS: the session that was never cleared, still OPERATIONAL, passing as
+// the one ze brought back.
+func TestLDPNeighborReestablishedWithin(t *testing.T) {
+	cases := []struct {
+		name       string
+		neighbor   ldpNeighbor
+		sinceClear time.Duration
+		settled    bool
+		back       bool
+	}{
+		{"fresh session after the clear", ldpNeighbor{ldpStateOperational, time.Second}, 2500 * time.Millisecond, false, true},
+		{"uncleared session, rounded down", ldpNeighbor{ldpStateOperational, 5 * time.Second}, 2500 * time.Millisecond, true, false},
+		{"not operational yet", ldpNeighbor{"OPENSENT", 0}, 2500 * time.Millisecond, false, false},
+		{"present after the clear", ldpNeighbor{"PRESENT", 0}, time.Second, false, false},
+		{"settled boundary", ldpNeighbor{ldpStateOperational, ldpClearSettled}, time.Hour, true, true},
+	}
+	for _, c := range cases {
+		if got := c.neighbor.settled(); got != c.settled {
+			t.Errorf("%s: settled = %v, want %v", c.name, got, c.settled)
+		}
+		if got := c.neighbor.reestablishedWithin(c.sinceClear); got != c.back {
+			t.Errorf("%s: reestablishedWithin(%s) = %v, want %v", c.name, c.sinceClear, got, c.back)
+		}
+	}
+}
+
+// The zeLog lines are composed in the form ze's slog text handler writes; the
+// messages are the literals of Session.ReadLoop, runSession and
+// recordSetupFailure.
+const (
+	zeLogFatal  = `time=2026-11-12T00:00:01Z level=WARN msg="ldp: fatal notification received, closing the session" subsystem=ldp status=2147483658 refers-to=0` + "\n"
+	zeLogEnded  = `time=2026-11-12T00:00:01Z level=INFO msg="ldp: session ended" subsystem=ldp peer=172.30.0.3 reason="ldp: peer sent a fatal notification: status 0x8000000a"` + "\n"
+	zeLogFailed = `time=2026-11-12T00:00:01Z level=INFO msg="ldp: session setup failed, next attempt delayed" subsystem=ldp peer=172.30.0.3:0 delay=15s` + "\n"
+)
+
+// VALIDATES: ze's log across the clear passes only with FRR's Shutdown
+// received, the session end logged at info, and no setup backoff recorded.
+// PREVENTS: a run where the clear never reached ze, or where info lines are not
+// logged, passing on the absence of a setup failure; and the unfixed session
+// end, which records a backoff, passing.
+func TestRequireLDPBackoffReleased(t *testing.T) {
+	startup := zeLogFailed // a failed attempt before the first session is not judged
+	before := countZeLDPLog(startup)
+	cases := []struct {
+		name     string
+		after    string
+		refusal  string
+		accepted bool
+	}{
+		{"backoff released", startup + zeLogFatal + zeLogEnded, "", true},
+		{"backoff recorded", startup + zeLogFatal + zeLogEnded + zeLogFailed, "recorded a setup backoff", false},
+		{"clear never reached ze", startup + zeLogEnded, "never reached ze", false},
+		{"info not logged", startup + zeLogFatal, "proves nothing", false},
+	}
+	for _, c := range cases {
+		err := requireLDPBackoffReleased(before, countZeLDPLog(c.after))
+		if c.accepted {
+			if err != nil {
+				t.Errorf("%s: refused: %v", c.name, err)
+			}
+			continue
+		}
+		if err == nil {
+			t.Errorf("%s: accepted", c.name)
+			continue
+		}
+		if !strings.Contains(err.Error(), c.refusal) {
+			t.Errorf("%s: refusal %q does not say %q", c.name, err, c.refusal)
+		}
+	}
+}
+
+// VALIDATES: the redial bound accepts the Hello-cadence redial and refuses
+// the one a 15 s setup backoff produces.
+// PREVENTS: a redial delayed by the backoff passing the wall-time check.
+func TestRequireLDPRedialWithin(t *testing.T) {
+	if err := requireLDPRedialWithin(2 * time.Second); err != nil {
+		t.Fatalf("a 2 s redial was refused: %v", err)
+	}
+	if err := requireLDPRedialWithin(ldpClearRedialBound); err != nil {
+		t.Fatalf("a redial at the bound was refused: %v", err)
+	}
+	// 15 s is setupRetryDelayMin in internal/plugins/ldp/register.go, the first
+	// delay recordSetupFailure imposes.
+	if err := requireLDPRedialWithin(15 * time.Second); err == nil {
+		t.Fatal("a redial after the 15 s setup backoff was accepted")
+	}
+}
diff --git a/internal/component/bgp/reactor/peer_initial_sync_join_test.go.pending b/internal/component/bgp/reactor/peer_initial_sync_join_test.go.pending
new file mode 100644
index 0000000000..6108d994c9
--- /dev/null
+++ b/internal/component/bgp/reactor/peer_initial_sync_join_test.go.pending
@@ -0,0 +1,280 @@
+// Design: docs/architecture/behavior/peer-lifecycle.md -- the initial sync, one goroutine per session, joined when its session ends
+// Related: peer_initial_sync.go -- sendInitialRoutes, the goroutine these tests hold and let go
+// Related: peer_run.go -- runOnce and its session-end defer
+// Related: rfc4271_automatic_start_peer_test.go -- automaticStartNeighbor, the far end each test plays by hand
+// Related: peer_run_backoff_test.go -- backoffCease, the message that ends each session
+
+package reactor
+
+import (
+	"net"
+	"net/netip"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+
+	"github.com/ze-software/ze/internal/core/clock"
+)
+
+// syncJoinProbe is how long a test watches for something that MUST NOT happen
+// while it holds an initial sync: the run loop entering its reconnect wait, or
+// the peer reading as settled. Without the join, either happens within
+// milliseconds of its cause, so the probe sees it on a loaded host. With the
+// join, neither can happen until the test lets the sync go, so the probe can
+// make a test slower and never makes it flaky.
+const syncJoinProbe = 500 * time.Millisecond
+
+// syncJoinClock is the peer clock of these tests. Peer.run's reconnect wait and
+// the peer-up barrier wait (Peer.waitPeerUpBarrier) are the only callers of
+// After on a peer without a reactor. The barrier wait, recognized by its
+// duration peerUpBarrierTimeout, gets a channel only the test fires, so a sync
+// held there stays there until the test says, on any host. Every other After
+// is a reconnect wait: its duration is recorded and it ends when the test
+// releases it. Now, timers and sleeps stay on the real clock, so the session's
+// own timers keep working. Safe for concurrent use.
+type syncJoinClock struct {
+	clock.RealClock
+
+	// waits receives the duration of every reconnect wait, fire ends one.
+	waits chan time.Duration
+	fire  chan time.Time
+
+	// barrierEntered is signalled each time a sync enters the barrier wait,
+	// barrierFire ends that wait as its timeout would.
+	barrierEntered chan struct{}
+	barrierFire    chan time.Time
+}
+
+func newSyncJoinClock() *syncJoinClock {
+	return &syncJoinClock{
+		waits:          make(chan time.Duration, 64),
+		fire:           make(chan time.Time, 1),
+		barrierEntered: make(chan struct{}, 8),
+		barrierFire:    make(chan time.Time, 1),
+	}
+}
+
+// After hands the barrier wait the test's barrier channel, and records every
+// other wait before it hands it the reconnect channel.
+func (c *syncJoinClock) After(d time.Duration) <-chan time.Time {
+	if d == peerUpBarrierTimeout {
+		select {
+		case c.barrierEntered <- struct{}{}:
+		default: // eight barrier waits is more than any test here makes; a dropped signal fails awaitBarrier
+		}
+		return c.barrierFire
+	}
+	select {
+	case c.waits <- d:
+	default: // 64 waits is more than any test here makes; a dropped record fails awaitWait
+	}
+	return c.fire
+}
+
+// awaitWait returns the duration of the next reconnect wait the run loop entered.
+func (c *syncJoinClock) awaitWait(t *testing.T) time.Duration {
+	t.Helper()
+	select {
+	case d := <-c.waits:
+		return d
+	case <-time.After(10 * time.Second):
+		t.Fatal("the peer never entered a reconnect wait")
+		return 0
+	}
+}
+
+// release ends the reconnect wait the run loop is in. MUST be called once per
+// wait awaitWait returned.
+func (c *syncJoinClock) release() {
+	c.fire <- time.Now()
+}
+
+// awaitBarrier returns once a sync has entered the peer-up barrier wait.
+func (c *syncJoinClock) awaitBarrier(t *testing.T) {
+	t.Helper()
+	select {
+	case <-c.barrierEntered:
+	case <-time.After(10 * time.Second):
+		t.Fatal("the initial sync never entered the peer-up barrier wait")
+	}
+}
+
+// fireBarrier ends the barrier wait as its timeout would. It never blocks: a
+// fire still pending is the same release.
+func (c *syncJoinClock) fireBarrier() {
+	select {
+	case c.barrierFire <- time.Now():
+	default: // a release is already pending
+	}
+}
+
+// startSyncJoinNeighbor runs a dial-only Peer on a syncJoinClock against a
+// listener the test accepts on, with the reconnect delay at 5 seconds to one
+// minute (the waits are the clock's, so none is real).
+func startSyncJoinNeighbor(t *testing.T) (*automaticStartNeighbor, *syncJoinClock) {
+	t.Helper()
+	ln, err := (&net.ListenConfig{}).Listen(t.Context(), "tcp4", "127.0.0.1:0")
+	require.NoError(t, err)
+	t.Cleanup(func() { ln.Close() }) //nolint:errcheck // Test cleanup.
+	tcpListener, ok := ln.(*net.TCPListener)
+	require.True(t, ok, "Listen(\"tcp4\") returns a TCPListener")
+	addr, ok := ln.Addr().(*net.TCPAddr)
+	require.True(t, ok, "listener address must be TCP")
+
+	settings := NewPeerSettings(netip.MustParseAddr("127.0.0.1"), 65000, 65001, 0x01010101)
+	settings.Port = uint16(addr.Port) //nolint:gosec // A listener port fits 16 bits.
+	settings.Connection = ConnectionActive
+	peer := NewPeer(settings)
+	clk := newSyncJoinClock()
+	peer.SetClock(clk)
+	peer.setReconnectDelay(5*time.Second, time.Minute)
+	t.Cleanup(startAndStop(t, peer))
+	// Registered after startAndStop, so it runs first: a barrier wait the test
+	// never let go would otherwise hold the stop.
+	t.Cleanup(clk.fireBarrier)
+	return &automaticStartNeighbor{peer: peer, listener: tcpListener}, clk
+}
+
+// staticHold holds the peer's staticMu, the lock the initial sync takes for its
+// static phase (sendInitialRoutes). A sync started while it is held stops at
+// the first statement of that phase and goes no further. Used from the test
+// goroutine only.
+type staticHold struct {
+	peer *Peer
+	held bool
+}
+
+// holdStaticPhase takes staticMu and lets it go at cleanup if the test did not.
+// Registered after startSyncJoinNeighbor's cleanups, so it runs before the stop.
+func holdStaticPhase(t *testing.T, peer *Peer) *staticHold {
+	t.Helper()
+	hold := &staticHold{peer: peer, held: true}
+	peer.staticMu.Lock()
+	t.Cleanup(hold.release)
+	return hold
+}
+
+// release lets the held sync go into its static phase. A second call does
+// nothing.
+func (h *staticHold) release() {
+	if !h.held {
+		return
+	}
+	h.held = false
+	h.peer.staticMu.Unlock()
+}
+
+// awaitSessionsEstablished returns once the peer's FSM history records
+// sessions entries into Established. The record is appended at the end of the
+// Established callback (runOnce), after the peer-up barrier was reset for that
+// session and its initial sync was started, so a test that has seen it may arm
+// the barrier for that sync.
+func awaitSessionsEstablished(t *testing.T, peer *Peer, sessions int) {
+	t.Helper()
+	require.Eventually(t, func() bool {
+		established := 0
+		for _, transition := range peer.fSMHistory() {
+			if transition.Reason == "established" {
+				established++
+			}
+		}
+		return established >= sessions
+	}, 5*time.Second, time.Millisecond, "the Established callback of session %d never finished", sessions)
+}
+
+// TestRunOnceJoinsInitialSyncBeforeReturn is the wiring test of the join, from
+// the FSM callback that starts a session's initial sync to the session-end
+// defer of runOnce that waits for it.
+//
+// VALIDATES: AC-1, its first clause. A session reaches Established while the
+// test holds the static phase of its initial sync, and the far end then ends it
+// with a Cease. runOnce does not return, so Peer.run enters no reconnect wait,
+// until the test lets the sync go. Once it does, the wait follows.
+// PREVENTS: an initial sync that outlives its session. Nothing joined it, so
+// runOnce returned at once and the next session could start while the old
+// goroutine had still to drain the queue and write plugin routes and End-of-RIB
+// on whatever session the peer held by then
+// (plan/journal/late-write-lands-on-the-successor.md, 2026-08-31).
+func TestRunOnceJoinsInitialSyncBeforeReturn(t *testing.T) {
+	n, clk := startSyncJoinNeighbor(t)
+	static := holdStaticPhase(t, n.peer)
+
+	conn := n.accept(t)
+	n.establish(t, conn, 90)
+	awaitSessionsEstablished(t, n.peer, 1)
+	backoffCease(t, conn)
+
+	select {
+	case d := <-clk.waits:
+		t.Fatalf("runOnce returned, and the run loop entered a %s reconnect wait, while the initial sync "+
+			"of the session that ended was still held in its static phase: nothing joins the sync goroutine", d)
+	case <-time.After(syncJoinProbe):
+	}
+
+	static.release()
+	clk.awaitWait(t)
+}
+
+// TestSuccessorPendingSyncUntilOwnMarker pins what `request quiesce` reads
+// across a rapid reconnect: pendingSync, the predicate behind DrainPeerSync
+// (reactor_api.go).
+//
+// VALIDATES: AC-2. The first session's sync is held in the peer-up barrier wait
+// when the far end ends that session with a Cease, and the peer reconnects.
+// While the second session's own sync is held before its static phase, the peer
+// reads as pending for the whole probe; once that sync runs, it reads as
+// settled.
+// PREVENTS: the first session's sync, let go after the second session reached
+// Established, settling the second one. Its last stores cleared the Peer-level
+// queue gate and End-of-RIB-owed fact that the second establishment had set,
+// so `request quiesce` returned before the second session's initial update, and
+// its End-of-RIB went out on the second session's connection.
+func TestSuccessorPendingSyncUntilOwnMarker(t *testing.T) {
+	n, clk := startSyncJoinNeighbor(t)
+
+	// The first sync is held in the barrier wait. The barrier is armed while the
+	// static phase is held, so that sync reads the barrier only once it is armed.
+	first := holdStaticPhase(t, n.peer)
+	firstConn := n.accept(t)
+	n.establish(t, firstConn, 90)
+	awaitSessionsEstablished(t, n.peer, 1)
+	n.peer.SetPeerUpBarrier(1)
+	first.release()
+	clk.awaitBarrier(t)
+
+	// From here on, the second session's sync is held before its static phase.
+	second := holdStaticPhase(t, n.peer)
+	backoffCease(t, firstConn)
+
+	// The first session ends. Without a join the run loop waits at once; with a
+	// join whose barrier wait does not see the session end, it waits only once
+	// the barrier lets the first sync go, which the test then does as the
+	// timeout would.
+	fired := false
+	select {
+	case <-clk.waits:
+	case <-time.After(syncJoinProbe):
+		clk.fireBarrier()
+		fired = true
+		clk.awaitWait(t)
+	}
+	clk.release()
+
+	secondConn := n.accept(t)
+	n.establish(t, secondConn, 90)
+	awaitSessionsEstablished(t, n.peer, 2)
+	if !fired {
+		// Without a join, the first session's sync is still in its barrier wait.
+		// This lets it go while the second session's sync is held.
+		clk.fireBarrier()
+	}
+
+	require.Never(t, func() bool { return !n.peer.pendingSync() }, syncJoinProbe, time.Millisecond,
+		"pendingSync read the peer as settled while the second session's own initial sync had not "+
+			"begun: the first session's sync settled the session that replaced it")
+
+	second.release()
+	require.Eventually(t, func() bool { return !n.peer.pendingSync() }, 5*time.Second, time.Millisecond,
+		"the second session's own initial sync never settled the peer")
+}
diff --git a/test/interop/scenarios/ldp-backoff-clear-frr/daemons b/test/interop/scenarios/ldp-backoff-clear-frr/daemons
