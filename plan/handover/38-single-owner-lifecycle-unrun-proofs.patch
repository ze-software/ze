diff --git a/internal/test/fixture/ldp_neighbor_linux.go b/internal/test/fixture/ldp_neighbor_linux.go
new file mode 100644
index 0000000000..8b0a38f61f
--- /dev/null
+++ b/internal/test/fixture/ldp_neighbor_linux.go
@@ -0,0 +1,830 @@
+//go:build linux
+
+// Design: docs/functional-tests.md -- an LDP neighbor on a veth pair
+// Related: register_ldp_neighbor_linux.go -- the fixture names
+// Related: ldp_session_end_linux.go -- the two scenarios that drive this neighbor
+// Related: plugin_fixture_clamped_path_linux.go -- createTestNetns, configureLink, runInNetns
+
+package fixture
+
+// ldp_neighbor_linux.go plays one LDP neighbor of a Ze daemon over a veth pair:
+// it sends Link Hellos, accepts the TCP session Ze opens on port 646, and either
+// brings that session to operational or rejects Ze's Initialization.
+//
+// WHY TWO NAMESPACES. `ldp/neighbor-link` runs Ze in `<prefix>-z` and keeps the
+// neighbor's link in `<prefix>-n`, joined by one veth pair. Both ends in one
+// namespace do not work: the neighbor's Hello arrives on Ze's link from an
+// address that namespace owns, and Linux drops it as a martian unless
+// accept_local is set. The guest's root namespace, where the ldp suite runs,
+// does not work either: every LDP daemon there binds 224.0.0.2:646, and a socket
+// bound to a group hears that group's datagrams from any link some socket on the
+// host joined it on (IP_MULTICAST_ALL is on by default). A sibling test's daemon
+// would then form an adjacency with this neighbor, and its own empty-neighbor
+// assertion would fail.
+//
+// WHY THE NEIGHBOR IS PASSIVE. RFC 5036 Section 2.5.2: "If A1 > A2, LSR1 plays
+// the active role; otherwise, it is passive." The neighbor's transport address
+// 10.99.0.1 is below Ze's 10.99.0.2, so Ze is the active LSR that dials, which
+// is the only role Ze plays today (startSessionForAdj).
+//
+// WHY ITS OWN CODEC. internal/plugins/ldp is gated by ze_ldp and this package is
+// always-on (feature-gates.txt), so it MUST NOT import it, and most of that
+// package's encoders are unexported. A neighbor written from RFC 5036 also does
+// not share a defect with the encoder it talks to.
+
+import (
+	"context"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"net/netip"
+	"runtime"
+	"sync"
+	"time"
+
+	"github.com/vishvananda/netlink"
+	"github.com/vishvananda/netns"
+	"golang.org/x/net/ipv4"
+)
+
+// The topology `ldp/neighbor-link` builds. The scenarios and the .ci configs
+// name the same values: Ze's link, LSR-ID and transport address, and the
+// neighbor's.
+const (
+	ldpNeighborZeLink     = "ldpz0"
+	ldpNeighborPeerLink   = "ldpn0"
+	ldpNeighborZeCIDR     = "10.99.0.2/24"
+	ldpNeighborPeerCIDR   = "10.99.0.1/24"
+	ldpNeighborLinkMTU    = 1500
+	ldpNeighborZeSuffix   = "-z"
+	ldpNeighborPeerSuffix = "-n"
+	// ldpNeighborIdentifier is the neighbor's LDP Identifier as Ze writes it
+	// (ldp.AdjacencyKey): its LSR-ID and label space 0, the key of every
+	// session event and log line Ze emits about it.
+	ldpNeighborIdentifier = "10.99.0.1:0"
+)
+
+var (
+	ldpNeighborZeLSR   = [4]byte{10, 99, 0, 2}
+	ldpNeighborPeerLSR = [4]byte{10, 99, 0, 1}
+	ldpNeighborGroup   = netip.AddrFrom4([4]byte{224, 0, 0, 2})
+)
+
+// ldpWireVersion is the protocol version, RFC 5036 Section 3.1: "This version
+// of the specification specifies LDP protocol version 1."
+const ldpWireVersion uint16 = 1
+
+// RFC 5036 wire values the neighbor sends or reads (Sections 3.1, 3.3, 3.4.6,
+// 3.5.1 to 3.5.4, 3.9).
+const (
+	ldpWirePort             = 646
+	ldpWirePDUHeaderOctets  = 10
+	ldpWireMessageHdrOctets = 8
+	ldpWireTLVHeaderOctets  = 4
+	// ldpWirePDULengthMax is the largest PDU Length read before the session
+	// negotiated another: RFC 5036 Section 3.1, "Prior to completion of the
+	// negotiation, the maximum allowable length is 4096 bytes."
+	ldpWirePDULengthMax = 4096
+
+	ldpWireNotification   uint16 = 0x0001
+	ldpWireHello          uint16 = 0x0100
+	ldpWireInitialization uint16 = 0x0200
+	ldpWireKeepAlive      uint16 = 0x0201
+	ldpWireTypeMask       uint16 = 0x7fff // clears the U-bit of a message or TLV type
+
+	ldpWireStatusTLV        uint16 = 0x0300
+	ldpWireCommonHelloTLV   uint16 = 0x0400
+	ldpWireIPv4TransportTLV uint16 = 0x0401
+	ldpWireCommonSessionTLV uint16 = 0x0500
+	ldpWireCommonSessionLen        = 14
+
+	// ldpWireStatusFatal is the E-bit of a Status Code (RFC 5036 Section 3.4.6).
+	ldpWireStatusFatal uint32 = 0x80000000
+	// ldpWireRejectedMaxPDU is Session Rejected/Parameters Max PDU Length
+	// (RFC 5036 Section 3.9, 0x00000012).
+	ldpWireRejectedMaxPDU uint32 = 0x00000012
+)
+
+// The neighbor's own session and Hello parameters.
+const (
+	// ldpNeighborHelloHold is the Hello Hold Time the neighbor proposes, in
+	// seconds. Ze holds the adjacency for it, so a scenario that pauses its
+	// Hellos for one step keeps the adjacency.
+	ldpNeighborHelloHold uint16 = 30
+	// ldpNeighborKeepalive is the KeepAlive Time the neighbor proposes, in
+	// seconds. Each scenario ends inside it; the drain worker answers Ze's
+	// KeepAlives besides.
+	ldpNeighborKeepalive uint16 = 60
+	// ldpNeighborHelloEvery is the neighbor's Hello cadence. Ze dials on a
+	// Hello, so this is the granularity of every redial the scenarios observe.
+	ldpNeighborHelloEvery = time.Second
+	// ldpNeighborReadWait bounds one read of a handshake message from Ze.
+	ldpNeighborReadWait = 10 * time.Second
+)
+
+// ldpNeighborLinkDriver is `ldp/neighbor-link netns <prefix> run <argv...>`. It
+// builds `<prefix>-z` and `<prefix>-n`, joins them with a veth pair, runs argv
+// in `<prefix>-z` and removes both namespaces when argv exits. Its exit is
+// argv's.
+func ldpNeighborLinkDriver(ctx context.Context, args []string) error {
+	plan, err := parseNetnsRunArgs(args)
+	if err != nil {
+		return err
+	}
+	if err := refuseLDPNeighborLinkOptions(plan); err != nil {
+		return err
+	}
+	// The thread stays locked for the life of the process: a namespace switch is
+	// per thread, and argv MUST be forked from this thread to inherit Ze's.
+	runtime.LockOSThread()
+	orig, err := netns.Get()
+	if err != nil {
+		return fmt.Errorf("get the current network namespace: %w", err)
+	}
+	defer orig.Close() //nolint:errcheck // best-effort close at exit
+
+	zeSide, err := createTestNetns(plan.prefix+ldpNeighborZeSuffix, orig)
+	if err != nil {
+		return err
+	}
+	defer zeSide.remove()
+
+	peerSide, err := createTestNetns(plan.prefix+ldpNeighborPeerSuffix, orig)
+	if err != nil {
+		return err
+	}
+	defer peerSide.remove()
+
+	if err := wireLDPNeighborLink(zeSide, peerSide); err != nil {
+		return err
+	}
+	return runInNetns(ctx, plan, zeSide, orig)
+}
+
+// refuseLDPNeighborLinkOptions refuses every clamped-path keyword the LDP link
+// has no use for, so a copied line fails before any namespace exists.
+func refuseLDPNeighborLinkOptions(plan *netnsRunPlan) error {
+	const refusal = "ldp/neighbor-link takes only netns <prefix> and run <argv...>"
+	if plan.routeMTU != 0 {
+		return errors.New(refusal + ": route-mtu given")
+	}
+	if len(plan.farDaemons) != 0 {
+		return errors.New(refusal + ": far-daemon given")
+	}
+	if plan.ipv6 {
+		return errors.New(refusal + ": ipv6 given")
+	}
+	if len(plan.peers) != 0 {
+		return errors.New(refusal + ": peer given")
+	}
+	if plan.withoutNetRaw {
+		return errors.New(refusal + ": without-net-raw given")
+	}
+	return nil
+}
+
+// wireLDPNeighborLink creates the veth pair with one end in each namespace,
+// addresses both ends and brings them up.
+func wireLDPNeighborLink(zeSide, peerSide *testNetns) error {
+	pair := &netlink.Veth{
+		LinkAttrs:     netlink.LinkAttrs{Name: ldpNeighborZeLink},
+		PeerName:      ldpNeighborPeerLink,
+		PeerNamespace: netlink.NsFd(int(peerSide.ns)),
+	}
+	if err := zeSide.handle.LinkAdd(pair); err != nil {
+		return fmt.Errorf("create %s/%s: %w", ldpNeighborZeLink, ldpNeighborPeerLink, err)
+	}
+	if err := zeSide.configureLink(ldpNeighborZeLink, ldpNeighborLinkMTU, ldpNeighborZeCIDR); err != nil {
+		return err
+	}
+	return peerSide.configureLink(ldpNeighborPeerLink, ldpNeighborLinkMTU, ldpNeighborPeerCIDR)
+}
+
+// ldpNeighbor is the neighbor: its Hello socket, its session listener, the
+// Hello sender and every session it accepted, all opened in the neighbor's
+// namespace. openLDPNeighbor returns it; close MUST be called, after the daemon
+// stopped, so a session the scenario left operational ends with the daemon and
+// never as a failed setup attempt. Safe for concurrent use.
+type ldpNeighbor struct {
+	listener *net.TCPListener
+	hellos   *ldpHelloer
+
+	mu       sync.Mutex
+	sessions []*ldpNeighborSession
+}
+
+// openLDPNeighbor opens the neighbor's sockets inside namespace and starts its
+// Hello sender, disabled until the scenario enables it.
+func openLDPNeighbor(ctx context.Context, namespace string) (*ldpNeighbor, error) {
+	var hello *net.UDPConn
+	var listener *net.TCPListener
+	err := inNamedNetns(namespace, func() error {
+		var openErr error
+		hello, listener, openErr = openLDPNeighborSockets(ctx)
+		return openErr
+	})
+	if err != nil {
+		return nil, err
+	}
+	return &ldpNeighbor{listener: listener, hellos: startLDPHelloer(hello)}, nil
+}
+
+// openLDPNeighborSockets opens the Hello socket, pinned to the neighbor's link
+// with TTL 1, and the listener on the neighbor's transport address. The calling
+// thread MUST be in the neighbor's namespace.
+func openLDPNeighborSockets(ctx context.Context) (*net.UDPConn, *net.TCPListener, error) {
+	link, err := net.InterfaceByName(ldpNeighborPeerLink)
+	if err != nil {
+		return nil, nil, fmt.Errorf("find %s: %w", ldpNeighborPeerLink, err)
+	}
+	address := netip.AddrFrom4(ldpNeighborPeerLSR)
+	var config net.ListenConfig
+
+	packets, err := config.ListenPacket(ctx, "udp4", netip.AddrPortFrom(address, 0).String())
+	if err != nil {
+		return nil, nil, fmt.Errorf("open the Hello socket: %w", err)
+	}
+	hello, ok := packets.(*net.UDPConn)
+	if !ok {
+		packets.Close() //nolint:errcheck // best-effort close on the error path
+		return nil, nil, fmt.Errorf("the Hello socket is a %T, not a UDP socket", packets)
+	}
+	// RFC 5036 Section 2.4.1: "LDP Link Hellos are sent as UDP packets addressed
+	// to the well-known LDP discovery port for the "all routers on this subnet"
+	// group multicast address."
+	if err := pinLDPHelloSocket(hello, link); err != nil {
+		hello.Close() //nolint:errcheck // best-effort close on the error path
+		return nil, nil, err
+	}
+
+	stream, err := config.Listen(ctx, "tcp4", netip.AddrPortFrom(address, ldpWirePort).String())
+	if err != nil {
+		hello.Close() //nolint:errcheck // best-effort close on the error path
+		return nil, nil, fmt.Errorf("listen on TCP %d: %w", ldpWirePort, err)
+	}
+	listener, ok := stream.(*net.TCPListener)
+	if !ok {
+		stream.Close() //nolint:errcheck // best-effort close on the error path
+		hello.Close()  //nolint:errcheck // best-effort close on the error path
+		return nil, nil, fmt.Errorf("the session listener is a %T, not a TCP listener", stream)
+	}
+	return hello, listener, nil
+}
+
+// pinLDPHelloSocket sends the socket's multicast out link, link-scoped.
+func pinLDPHelloSocket(hello *net.UDPConn, link *net.Interface) error {
+	packets := ipv4.NewPacketConn(hello)
+	if err := packets.SetMulticastInterface(link); err != nil {
+		return fmt.Errorf("send Hellos out %s: %w", link.Name, err)
+	}
+	if err := packets.SetMulticastTTL(1); err != nil {
+		return fmt.Errorf("set the Hello TTL to 1: %w", err)
+	}
+	if err := packets.SetMulticastLoopback(false); err != nil {
+		return fmt.Errorf("keep Hellos off the neighbor's own sockets: %w", err)
+	}
+	return nil
+}
+
+// inNamedNetns runs open on a thread switched into the named namespace, then
+// switches the thread back, so the sockets open creates belong to that
+// namespace for their lifetime. A thread that cannot switch back stays locked,
+// and the goroutine's exit retires it.
+func inNamedNetns(name string, open func() error) error {
+	target, err := netns.GetFromName(name)
+	if err != nil {
+		return fmt.Errorf("open network namespace %s: %w", name, err)
+	}
+	defer target.Close() //nolint:errcheck // best-effort close of a namespace handle
+
+	runtime.LockOSThread()
+	orig, err := netns.Get()
+	if err != nil {
+		runtime.UnlockOSThread()
+		return fmt.Errorf("get the current network namespace: %w", err)
+	}
+	defer orig.Close() //nolint:errcheck // best-effort close of a namespace handle
+
+	if err := netns.Set(target); err != nil {
+		runtime.UnlockOSThread()
+		return fmt.Errorf("enter %s: %w", name, err)
+	}
+	openErr := open()
+	if err := netns.Set(orig); err != nil {
+		return errors.Join(openErr, fmt.Errorf("return from %s: %w", name, err))
+	}
+	runtime.UnlockOSThread()
+	return openErr
+}
+
+// acceptSession waits until deadline for the next TCP connection Ze opens,
+// then reads and checks Ze's Initialization on it.
+func (n *ldpNeighbor) acceptSession(deadline time.Time) (*ldpNeighborSession, error) {
+	if err := n.listener.SetDeadline(deadline); err != nil {
+		return nil, fmt.Errorf("arm the accept deadline: %w", err)
+	}
+	conn, err := n.listener.AcceptTCP()
+	if err != nil {
+		return nil, fmt.Errorf("accept a session on TCP %d: %w", ldpWirePort, err)
+	}
+	session := &ldpNeighborSession{conn: conn}
+	n.mu.Lock()
+	n.sessions = append(n.sessions, session)
+	n.mu.Unlock()
+	if err := session.readInitialization(); err != nil {
+		return nil, err
+	}
+	return session, nil
+}
+
+// close stops the Hello sender, closes every accepted session and both
+// sockets, and returns the first failure of any of them.
+func (n *ldpNeighbor) close() error {
+	failure := n.hellos.stop()
+	n.mu.Lock()
+	sessions := n.sessions
+	n.sessions = nil
+	n.mu.Unlock()
+	for _, session := range sessions {
+		failure = errors.Join(failure, session.close())
+	}
+	if err := n.listener.Close(); err != nil {
+		failure = errors.Join(failure, fmt.Errorf("close the session listener: %w", err))
+	}
+	return failure
+}
+
+// ldpNeighborSession is one TCP connection Ze opened to the neighbor. Once
+// establish succeeds, one drain worker reads it, answering each KeepAlive Ze
+// sends, until close closes the connection and waits for the worker. close
+// MUST be called; ldpNeighbor.close calls it for every session it accepted.
+type ldpNeighborSession struct {
+	conn *net.TCPConn
+	// zeInitID is the Message ID of Ze's Initialization, which a rejection names.
+	zeInitID uint32
+
+	closeOnce sync.Once
+	closeErr  error
+	drained   chan struct{} // nil until establish starts the worker
+	drainErr  error         // written by the worker before it closes drained
+}
+
+// readInitialization reads Ze's first message and requires it to be the
+// Initialization of a session for this neighbor's adjacency.
+func (s *ldpNeighborSession) readInitialization() error {
+	pdu, err := readLDPPDU(s.conn, time.Now().Add(ldpNeighborReadWait))
+	if err != nil {
+		return fmt.Errorf("read Ze's Initialization: %w", err)
+	}
+	if pdu.lsr != ldpNeighborZeLSR {
+		return fmt.Errorf("the session's first PDU names LSR %s, want Ze's %s",
+			netip.AddrFrom4(pdu.lsr), netip.AddrFrom4(ldpNeighborZeLSR))
+	}
+	first := pdu.messages[0]
+	if first.msgType != ldpWireInitialization {
+		return fmt.Errorf("the first message Ze sent is type %#04x, want Initialization %#04x", first.msgType, ldpWireInitialization)
+	}
+	s.zeInitID = first.id
+	return checkLDPInitialization(first.body)
+}
+
+// establish plays the passive role's acceptance and waits for Ze's. RFC 5036
+// Section 2.5.3: "If they are, LSR1 replies with an Initialization message of
+// its own to propose the parameters it wishes to use and a KeepAlive message to
+// signal acceptance of LSR2's parameters." Ze's KeepAlive is its acceptance of
+// the neighbor's; the drain worker then keeps the session read.
+func (s *ldpNeighborSession) establish() error {
+	var initialization [ldpWirePDUHeaderOctets + ldpWireMessageHdrOctets + ldpWireTLVHeaderOctets + ldpWireCommonSessionLen]byte
+	if err := s.write(initialization[:writeLDPInitialization(initialization[:])]); err != nil {
+		return fmt.Errorf("send the neighbor's Initialization: %w", err)
+	}
+	if err := s.sendKeepAlive(); err != nil {
+		return fmt.Errorf("send the neighbor's KeepAlive: %w", err)
+	}
+	if err := s.awaitKeepAlive(); err != nil {
+		return err
+	}
+	s.drained = make(chan struct{})
+	go s.drain()
+	return nil
+}
+
+// awaitKeepAlive reads until Ze's KeepAlive arrives. A fatal Notification is
+// Ze's refusal of the neighbor's parameters, and is reported with its code.
+func (s *ldpNeighborSession) awaitKeepAlive() error {
+	deadline := time.Now().Add(ldpNeighborReadWait)
+	// Bounded by deadline: each pass reads one PDU, and the read fails past it.
+	for {
+		pdu, err := readLDPPDU(s.conn, deadline)
+		if err != nil {
+			return fmt.Errorf("read Ze's KeepAlive: %w", err)
+		}
+		for _, message := range pdu.messages {
+			switch message.msgType {
+			case ldpWireKeepAlive:
+				return nil
+			case ldpWireNotification:
+				return fmt.Errorf("the neighbor's Initialization was answered with %w", ldpNotificationRefusal(message.body))
+			}
+		}
+	}
+}
+
+// reject refuses Ze's Initialization and closes the connection. RFC 5036
+// Section 2.5.3: "If the parameters are not acceptable, LSR1 responds by
+// sending a Session Rejected/Parameters Error Notification message and closing
+// the TCP connection."
+func (s *ldpNeighborSession) reject() error {
+	var notification [ldpWirePDUHeaderOctets + ldpWireMessageHdrOctets + ldpWireTLVHeaderOctets + 10]byte
+	length := writeLDPNotification(notification[:], ldpWireStatusFatal|ldpWireRejectedMaxPDU, s.zeInitID, ldpWireInitialization)
+	writeErr := s.write(notification[:length])
+	if writeErr != nil {
+		writeErr = fmt.Errorf("send the Session Rejected Notification: %w", writeErr)
+	}
+	return errors.Join(writeErr, s.close())
+}
+
+// drain is the session's worker: it reads every PDU Ze sends and answers each
+// KeepAlive with one, until the connection closes.
+func (s *ldpNeighborSession) drain() {
+	defer close(s.drained)
+	// Bounded by the connection: it ends when close closes it or Ze does.
+	for {
+		pdu, err := readLDPPDU(s.conn, time.Time{})
+		if err != nil {
+			s.drainErr = err
+			return
+		}
+		for _, message := range pdu.messages {
+			if message.msgType != ldpWireKeepAlive {
+				continue
+			}
+			if err := s.sendKeepAlive(); err != nil {
+				s.drainErr = err
+				return
+			}
+		}
+	}
+}
+
+// close closes the connection and waits for the drain worker. A drain that
+// ended on anything but the close, or Ze ending the session, is reported.
+func (s *ldpNeighborSession) close() error {
+	s.closeOnce.Do(func() {
+		if err := s.conn.Close(); err != nil {
+			s.closeErr = fmt.Errorf("close the session: %w", err)
+		}
+		if s.drained == nil {
+			return
+		}
+		<-s.drained
+		if s.drainErr == nil {
+			return
+		}
+		if errors.Is(s.drainErr, net.ErrClosed) {
+			return
+		}
+		if errors.Is(s.drainErr, io.EOF) {
+			return
+		}
+		s.closeErr = errors.Join(s.closeErr, fmt.Errorf("read the operational session: %w", s.drainErr))
+	})
+	return s.closeErr
+}
+
+func (s *ldpNeighborSession) sendKeepAlive() error {
+	var keepalive [ldpWirePDUHeaderOctets + ldpWireMessageHdrOctets]byte
+	return s.write(keepalive[:writeLDPKeepAlive(keepalive[:])])
+}
+
+func (s *ldpNeighborSession) write(pdu []byte) error {
+	if err := s.conn.SetWriteDeadline(time.Now().Add(ldpNeighborReadWait)); err != nil {
+		return err
+	}
+	_, err := s.conn.Write(pdu)
+	return err
+}
+
+// ldpHelloer sends the neighbor's Link Hello every ldpNeighborHelloEvery while
+// it is enabled. It owns one goroutine: startLDPHelloer starts it, and stop
+// MUST be called to end it and close the socket. A Hello is sent only under mu,
+// so once setEnabled(false) returns no Hello is in flight. Safe for concurrent
+// use.
+type ldpHelloer struct {
+	conn   *net.UDPConn
+	target *net.UDPAddr
+	quit   chan struct{}
+	done   chan struct{}
+
+	mu      sync.Mutex
+	enabled bool
+	sent    int
+	failure error // the first send that failed
+}
+
+func startLDPHelloer(conn *net.UDPConn) *ldpHelloer {
+	h := &ldpHelloer{
+		conn:   conn,
+		target: net.UDPAddrFromAddrPort(netip.AddrPortFrom(ldpNeighborGroup, ldpWirePort)),
+		quit:   make(chan struct{}),
+		done:   make(chan struct{}),
+	}
+	go h.run()
+	return h
+}
+
+func (h *ldpHelloer) run() {
+	defer close(h.done)
+	ticker := time.NewTicker(ldpNeighborHelloEvery)
+	defer ticker.Stop()
+	// Bounded by stop: it ends when quit closes.
+	for {
+		select {
+		case <-h.quit:
+			return
+		case <-ticker.C:
+			h.mu.Lock()
+			if h.enabled {
+				h.sendLocked() //nolint:errcheck // the failure is recorded for err()
+			}
+			h.mu.Unlock()
+		}
+	}
+}
+
+// setEnabled turns the cadence on or off. Turning it on sends one Hello at
+// once, so Ze does not wait a full interval for the first one.
+func (h *ldpHelloer) setEnabled(enabled bool) {
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	h.enabled = enabled
+	if enabled {
+		h.sendLocked() //nolint:errcheck // the failure is recorded for err()
+	}
+}
+
+// sendOne sends exactly one Hello whatever the cadence, and answers whether it
+// left.
+func (h *ldpHelloer) sendOne() error {
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	return h.sendLocked()
+}
+
+// err answers the first Hello that failed to leave, so a scenario can tell a
+// neighbor that went silent from a Ze that ignored it.
+func (h *ldpHelloer) err() error {
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	return h.failure
+}
+
+// sendLocked sends one Hello. The caller MUST hold mu.
+func (h *ldpHelloer) sendLocked() error {
+	var hello [ldpWirePDUHeaderOctets + ldpWireMessageHdrOctets + 2*(ldpWireTLVHeaderOctets+4)]byte
+	h.sent++
+	length := writeLDPHello(hello[:], uint32(h.sent))
+	_, err := h.conn.WriteToUDP(hello[:length], h.target)
+	if err != nil {
+		err = fmt.Errorf("send Hello %d: %w", h.sent, err)
+		if h.failure == nil {
+			h.failure = err
+		}
+	}
+	return err
+}
+
+// stop ends the worker, closes the socket and answers the first send failure.
+func (h *ldpHelloer) stop() error {
+	close(h.quit)
+	<-h.done
+	failure := h.err()
+	if err := h.conn.Close(); err != nil {
+		failure = errors.Join(failure, fmt.Errorf("close the Hello socket: %w", err))
+	}
+	return failure
+}
+
+// writeLDPPDUHeader writes the LDP PDU header for a body of bodyOctets after it.
+// RFC 5036 Section 3.1: PDU Length is "the total length of this PDU in octets,
+// excluding the Version and PDU Length fields."
+//
+//	0  Version (2)    2  PDU Length (2)
+//	4  LSR-ID (4)     8  Label Space (2)    10 messages
+func writeLDPPDUHeader(buf []byte, bodyOctets int) int {
+	binary.BigEndian.PutUint16(buf[0:2], ldpWireVersion)
+	binary.BigEndian.PutUint16(buf[2:4], uint16(6+bodyOctets))
+	copy(buf[4:8], ldpNeighborPeerLSR[:])
+	binary.BigEndian.PutUint16(buf[8:10], 0)
+	return ldpWirePDUHeaderOctets
+}
+
+// writeLDPMessageHeader writes a message header at off. RFC 5036 Section 3.5:
+// Message Length is the length "in octets, of Message ID, Mandatory Parameters,
+// and Optional Parameters."
+//
+//	0  U|Message Type (2)    2  Message Length (2)    4  Message ID (4)
+func writeLDPMessageHeader(buf []byte, off int, msgType uint16, parameterOctets int, id uint32) int {
+	binary.BigEndian.PutUint16(buf[off:off+2], msgType)
+	binary.BigEndian.PutUint16(buf[off+2:off+4], uint16(4+parameterOctets))
+	binary.BigEndian.PutUint32(buf[off+4:off+8], id)
+	return off + ldpWireMessageHdrOctets
+}
+
+// writeLDPTLVHeader writes a TLV header at off with the U- and F-bits clear.
+//
+//	0  U|F|Type (2)    2  Length (2)    4  Value
+func writeLDPTLVHeader(buf []byte, off int, tlvType uint16, valueOctets int) int {
+	binary.BigEndian.PutUint16(buf[off:off+2], tlvType)
+	binary.BigEndian.PutUint16(buf[off+2:off+4], uint16(valueOctets))
+	return off + ldpWireTLVHeaderOctets
+}
+
+// writeLDPHello writes the neighbor's Link Hello: a Common Hello Parameters TLV
+// with the T- and R-bits clear (RFC 5036 Section 3.5.2, a Link Hello) and an
+// IPv4 Transport Address TLV naming the neighbor's transport address.
+//
+//	10 Hello header (8)    18 Common Hello TLV: Hold Time (2), T|R|Reserved (2)
+//	26 IPv4 Transport TLV: Address (4)    34 end
+func writeLDPHello(buf []byte, id uint32) int {
+	const parameters = 2 * (ldpWireTLVHeaderOctets + 4)
+	off := writeLDPPDUHeader(buf, ldpWireMessageHdrOctets+parameters)
+	off = writeLDPMessageHeader(buf, off, ldpWireHello, parameters, id)
+	off = writeLDPTLVHeader(buf, off, ldpWireCommonHelloTLV, 4)
+	binary.BigEndian.PutUint16(buf[off:off+2], ldpNeighborHelloHold)
+	binary.BigEndian.PutUint16(buf[off+2:off+4], 0)
+	off = writeLDPTLVHeader(buf, off+4, ldpWireIPv4TransportTLV, 4)
+	copy(buf[off:off+4], ldpNeighborPeerLSR[:])
+	return off + 4
+}
+
+// writeLDPInitialization writes the neighbor's Initialization: one Common
+// Session Parameters TLV proposing protocol version 1, ldpNeighborKeepalive,
+// Downstream Unsolicited with loop detection off, the default Max PDU Length,
+// and Ze's LDP Identifier as the Receiver LDP Identifier.
+//
+//	18 Common Session TLV: Protocol Version (2), KeepAlive Time (2),
+//	   A|D|Reserved (1), PVLim (1), Max PDU Length (2),
+//	   Receiver LSR-ID (4), Receiver Label Space (2)    36 end
+func writeLDPInitialization(buf []byte) int {
+	const parameters = ldpWireTLVHeaderOctets + ldpWireCommonSessionLen
+	off := writeLDPPDUHeader(buf, ldpWireMessageHdrOctets+parameters)
+	off = writeLDPMessageHeader(buf, off, ldpWireInitialization, parameters, 1)
+	off = writeLDPTLVHeader(buf, off, ldpWireCommonSessionTLV, ldpWireCommonSessionLen)
+	binary.BigEndian.PutUint16(buf[off:off+2], ldpWireVersion)
+	binary.BigEndian.PutUint16(buf[off+2:off+4], ldpNeighborKeepalive)
+	buf[off+4] = 0
+	buf[off+5] = 0
+	// RFC 5036 Section 3.5.3: "A value of 255 or less specifies the default
+	// maximum length of 4096 octets."
+	binary.BigEndian.PutUint16(buf[off+6:off+8], 0)
+	copy(buf[off+8:off+12], ldpNeighborZeLSR[:])
+	binary.BigEndian.PutUint16(buf[off+12:off+14], 0)
+	return off + ldpWireCommonSessionLen
+}
+
+// writeLDPKeepAlive writes a KeepAlive, which carries no parameter.
+func writeLDPKeepAlive(buf []byte) int {
+	off := writeLDPPDUHeader(buf, ldpWireMessageHdrOctets)
+	return writeLDPMessageHeader(buf, off, ldpWireKeepAlive, 0, 1)
+}
+
+// writeLDPNotification writes a Notification carrying one Status TLV that names
+// the message it answers (RFC 5036 Section 3.4.6).
+//
+//	18 Status TLV: Status Code (4), Message ID (4), Message Type (2)    32 end
+func writeLDPNotification(buf []byte, status, answeredID uint32, answeredType uint16) int {
+	const parameters = ldpWireTLVHeaderOctets + 10
+	off := writeLDPPDUHeader(buf, ldpWireMessageHdrOctets+parameters)
+	off = writeLDPMessageHeader(buf, off, ldpWireNotification, parameters, 1)
+	off = writeLDPTLVHeader(buf, off, ldpWireStatusTLV, 10)
+	binary.BigEndian.PutUint32(buf[off:off+4], status)
+	binary.BigEndian.PutUint32(buf[off+4:off+8], answeredID)
+	binary.BigEndian.PutUint16(buf[off+8:off+10], answeredType)
+	return off + 10
+}
+
+// ldpReceivedMessage is one message of a PDU Ze sent: its type with the U-bit
+// cleared, its Message ID, and the parameters after the Message ID.
+type ldpReceivedMessage struct {
+	msgType uint16
+	id      uint32
+	body    []byte
+}
+
+// ldpReceivedPDU is one PDU Ze sent. messages holds at least one message.
+type ldpReceivedPDU struct {
+	lsr        [4]byte
+	labelSpace uint16
+	messages   []ldpReceivedMessage
+}
+
+// readLDPPDU reads one whole PDU from conn before deadline (none when zero) and
+// splits it into its messages. A PDU longer than the pre-negotiation maximum,
+// or a message that overruns its PDU, is an error.
+func readLDPPDU(conn net.Conn, deadline time.Time) (ldpReceivedPDU, error) {
+	var pdu ldpReceivedPDU
+	if err := conn.SetReadDeadline(deadline); err != nil {
+		return pdu, err
+	}
+	var header [4]byte
+	if _, err := io.ReadFull(conn, header[:]); err != nil {
+		return pdu, err
+	}
+	if version := binary.BigEndian.Uint16(header[0:2]); version != ldpWireVersion {
+		return pdu, fmt.Errorf("PDU version %d, want %d", version, ldpWireVersion)
+	}
+	length := int(binary.BigEndian.Uint16(header[2:4]))
+	if length < 6+ldpWireMessageHdrOctets {
+		return pdu, fmt.Errorf("PDU Length %d holds no message", length)
+	}
+	if length > ldpWirePDULengthMax {
+		return pdu, fmt.Errorf("PDU Length %d exceeds %d", length, ldpWirePDULengthMax)
+	}
+	rest := make([]byte, length)
+	if _, err := io.ReadFull(conn, rest); err != nil {
+		return pdu, err
+	}
+	copy(pdu.lsr[:], rest[0:4])
+	pdu.labelSpace = binary.BigEndian.Uint16(rest[4:6])
+	body := rest[6:]
+	// Bounded by the PDU Length checked above: each pass consumes one message.
+	for len(body) > 0 {
+		if len(body) < ldpWireMessageHdrOctets {
+			return pdu, fmt.Errorf("a %d-octet tail is shorter than a message header", len(body))
+		}
+		messageLength := int(binary.BigEndian.Uint16(body[2:4]))
+		if messageLength < 4 {
+			return pdu, fmt.Errorf("message length %d is shorter than its Message ID", messageLength)
+		}
+		end := 4 + messageLength
+		if end > len(body) {
+			return pdu, fmt.Errorf("message length %d overruns the PDU", messageLength)
+		}
+		pdu.messages = append(pdu.messages, ldpReceivedMessage{
+			msgType: binary.BigEndian.Uint16(body[0:2]) & ldpWireTypeMask,
+			id:      binary.BigEndian.Uint32(body[4:8]),
+			body:    body[8:end],
+		})
+		body = body[end:]
+	}
+	return pdu, nil
+}
+
+// findLDPTLV answers the value of the first TLV of type tlvType in parameters.
+func findLDPTLV(parameters []byte, tlvType uint16) ([]byte, error) {
+	// Bounded by len(parameters): each pass consumes one TLV.
+	for len(parameters) >= ldpWireTLVHeaderOctets {
+		found := binary.BigEndian.Uint16(parameters[0:2]) & 0x3fff
+		length := int(binary.BigEndian.Uint16(parameters[2:4]))
+		end := ldpWireTLVHeaderOctets + length
+		if end > len(parameters) {
+			return nil, fmt.Errorf("TLV %#04x of length %d overruns its message", found, length)
+		}
+		if found == tlvType {
+			return parameters[ldpWireTLVHeaderOctets:end], nil
+		}
+		parameters = parameters[end:]
+	}
+	return nil, fmt.Errorf("no TLV %#04x", tlvType)
+}
+
+// checkLDPInitialization requires Ze's Common Session Parameters to propose
+// protocol version 1 and to name the neighbor's LDP Identifier as the receiver:
+// Ze opened this session for the neighbor's adjacency.
+func checkLDPInitialization(parameters []byte) error {
+	session, err := findLDPTLV(parameters, ldpWireCommonSessionTLV)
+	if err != nil {
+		return fmt.Errorf("the Initialization Ze sent: %w", err)
+	}
+	if len(session) < ldpWireCommonSessionLen {
+		return fmt.Errorf("the Common Session Parameters Ze sent hold %d octets, want %d", len(session), ldpWireCommonSessionLen)
+	}
+	if version := binary.BigEndian.Uint16(session[0:2]); version != ldpWireVersion {
+		return fmt.Errorf("the Initialization Ze sent proposes protocol version %d, want %d", version, ldpWireVersion)
+	}
+	receiver := [4]byte(session[8:12])
+	if receiver != ldpNeighborPeerLSR {
+		return fmt.Errorf("the Initialization Ze sent names receiver %s, want the neighbor %s",
+			netip.AddrFrom4(receiver), netip.AddrFrom4(ldpNeighborPeerLSR))
+	}
+	if space := binary.BigEndian.Uint16(session[12:14]); space != 0 {
+		return fmt.Errorf("the Initialization Ze sent names receiver label space %d, want 0", space)
+	}
+	return nil
+}
+
+// ldpNotificationRefusal describes a Notification Ze sent: its Status Code, or
+// why no Status Code could be read from it.
+func ldpNotificationRefusal(parameters []byte) error {
+	status, err := findLDPTLV(parameters, ldpWireStatusTLV)
+	if err != nil {
+		return fmt.Errorf("a Notification with no readable status: %w", err)
+	}
+	if len(status) < 4 {
+		return fmt.Errorf("a Notification whose Status TLV holds %d octets", len(status))
+	}
+	return fmt.Errorf("a Notification, status %#08x", binary.BigEndian.Uint32(status[0:4]))
+}
diff --git a/internal/test/fixture/ldp_session_end_linux.go b/internal/test/fixture/ldp_session_end_linux.go
new file mode 100644
index 0000000000..e14ef28eb7
--- /dev/null
+++ b/internal/test/fixture/ldp_session_end_linux.go
@@ -0,0 +1,448 @@
+//go:build linux
+
+// Design: docs/functional-tests.md -- an LDP neighbor on a veth pair
+// Related: ldp_neighbor_linux.go -- the neighbor these scenarios drive
+// Related: register_ldp_neighbor_linux.go -- the fixture names
+// Related: routing_fixture.go -- routingRows
+
+package fixture
+
+// ldp_session_end_linux.go holds the two scenarios that judge how Ze treats the
+// end of an LDP session, from outside the daemon: what the neighbor sees on the
+// wire, what `show ldp neighbor` reports, and which `ldp` session events an
+// observer subscribed to the namespace receives.
+//
+// The observer plugin and the neighbor are one process: the plugin is forked by
+// the daemon inside Ze's namespace, and it opens the neighbor's sockets inside
+// the neighbor's namespace (inNamedNetns), so one scenario can order a wire
+// action, a daemon read and an event check without a marker file between two
+// processes.
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"slices"
+	"sync"
+	"time"
+
+	"github.com/ze-software/ze/internal/core/textbuf"
+	"github.com/ze-software/ze/pkg/plugin/rpc"
+	"github.com/ze-software/ze/pkg/plugin/sdk"
+)
+
+const (
+	// ldpObserverName is the fallback plugin name; the daemon assigns the real one.
+	ldpObserverName = "ldp-neighbor"
+	// ldpNeighborStateOperational and ldpNeighborStateDiscovered are the two
+	// `show ldp neighbor` states the scenarios wait on: a session that reached
+	// OPERATIONAL, and an adjacency with no session at all (showNeighbors).
+	ldpNeighborStateOperational = "operational"
+	ldpNeighborStateDiscovered  = "discovered"
+	// ldpFirstDialWait bounds Ze's first dial: daemon start, discovery on the
+	// link, and the neighbor's first Hellos.
+	ldpFirstDialWait = 30 * time.Second
+	// ldpRedialWait bounds the redial after one Hello once an operational
+	// session ended. It sits below the 15 seconds a failed setup waits
+	// (setupRetryDelayMin), so a session end recorded as a failed setup cannot
+	// pass it, and far above the milliseconds a dial takes.
+	ldpRedialWait = 10 * time.Second
+	// ldpSetupBackoffFloor is the least time Ze may wait after a NAK'd
+	// Initialization. RFC 5036 Section 2.5.3: "The session establishment setup
+	// attempt following a NAK'd Initialization message MUST be delayed no less
+	// than 15 seconds, and subsequent delays MUST grow to a maximum delay of no
+	// less than 2 minutes."
+	ldpSetupBackoffFloor = 15 * time.Second
+	// ldpSetupBackoffWait bounds the dial after a rejection: the floor plus a
+	// margin for the Hello cadence and a loaded host.
+	ldpSetupBackoffWait = 40 * time.Second
+	// ldpPollAttempts and ldpPollDelay bound each wait on daemon state or on an
+	// event: 10 seconds.
+	ldpPollAttempts = 100
+	ldpPollDelay    = 100 * time.Millisecond
+)
+
+// ldpSessionEventKind is which `ldp` session event the observer received.
+type ldpSessionEventKind uint8
+
+const (
+	ldpSessionEventUnspecified ldpSessionEventKind = iota
+	ldpSessionEventUp
+	ldpSessionEventDown
+)
+
+func (k ldpSessionEventKind) String() string {
+	switch k {
+	case ldpSessionEventUp:
+		return "session-up"
+	case ldpSessionEventDown:
+		return "session-down"
+	case ldpSessionEventUnspecified:
+		return "unspecified"
+	}
+	panic("BUG: invalid ldpSessionEventKind")
+}
+
+// ldpSessionEventRecord is one session event, as the observer decoded it.
+type ldpSessionEventRecord struct {
+	kind        ldpSessionEventKind
+	peerAddress string
+	identifier  string
+	iface       string
+}
+
+// ldpSessionEventLog records the `ldp` session events the observer receives,
+// in delivery order. Safe for concurrent use: the SDK delivers on its own
+// goroutine and the scenario reads on another.
+type ldpSessionEventLog struct {
+	mu          sync.Mutex
+	records     []ldpSessionEventRecord
+	undecodable []string
+}
+
+// setup subscribes the observer to session-up and session-down, enveloped so
+// each delivery names its event, before the plugin's first stage.
+func (l *ldpSessionEventLog) setup(plugin *sdk.Plugin) error {
+	plugin.SetStartupSubscriptionsIn("ldp", []string{"session-up", "session-down"}, nil, "")
+	plugin.SetEnvelope(true)
+	plugin.OnEvent(l.observe)
+	return nil
+}
+
+// observe records one delivery. One the log cannot read is kept, and fails
+// the scenario's verdict, rather than being skipped.
+func (l *ldpSessionEventLog) observe(event string) error {
+	record, err := decodeLDPSessionEvent(event)
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	if err != nil {
+		l.undecodable = append(l.undecodable, err.Error())
+		return nil
+	}
+	l.records = append(l.records, record)
+	return nil
+}
+
+func decodeLDPSessionEvent(event string) (ldpSessionEventRecord, error) {
+	var record ldpSessionEventRecord
+	envelope, err := rpc.ParseEventEnvelope(event)
+	if err != nil {
+		return record, fmt.Errorf("decode the envelope of %q: %w", event, err)
+	}
+	if envelope.Namespace != "ldp" {
+		return record, fmt.Errorf("event %q from namespace %q, subscribed to ldp only", envelope.Event, envelope.Namespace)
+	}
+	switch envelope.Event {
+	case "session-up":
+		record.kind = ldpSessionEventUp
+	case "session-down":
+		record.kind = ldpSessionEventDown
+	default:
+		return record, fmt.Errorf("event ldp/%s, subscribed to session-up and session-down only", envelope.Event)
+	}
+	var payload struct {
+		PeerAddress   string `json:"peer-address"`
+		LDPIdentifier string `json:"ldp-identifier"`
+		Interface     string `json:"interface"`
+	}
+	if err := json.Unmarshal(envelope.Payload, &payload); err != nil {
+		return record, fmt.Errorf("decode the ldp/%s payload %s: %w", envelope.Event, envelope.Payload, err)
+	}
+	record.peerAddress = payload.PeerAddress
+	record.identifier = payload.LDPIdentifier
+	record.iface = payload.Interface
+	return record, nil
+}
+
+// snapshot answers the neighbor's events so far, and an error for any
+// delivery the log could not read.
+func (l *ldpSessionEventLog) snapshot() ([]ldpSessionEventRecord, error) {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	if len(l.undecodable) != 0 {
+		return nil, fmt.Errorf("the observer received %d event(s) it could not read: %v", len(l.undecodable), l.undecodable)
+	}
+	var mine []ldpSessionEventRecord
+	for _, record := range l.records {
+		if record.identifier == ldpNeighborIdentifier {
+			mine = append(mine, record)
+		}
+	}
+	return mine, nil
+}
+
+// await waits until the observer holds at least count events for the
+// neighbor, and answers them.
+func (l *ldpSessionEventLog) await(ctx context.Context, count int) ([]ldpSessionEventRecord, error) {
+	var records []ldpSessionEventRecord
+	var readErr error
+	reached := Poll(ctx, ldpPollAttempts, ldpPollDelay, func() bool {
+		records, readErr = l.snapshot()
+		return readErr == nil && len(records) >= count
+	})
+	if readErr != nil {
+		return nil, readErr
+	}
+	if !reached {
+		return nil, fmt.Errorf("the observer holds %d ldp session event(s) for %s, want %d: %s",
+			len(records), ldpNeighborIdentifier, count, describeLDPSessionEvents(records))
+	}
+	return records, nil
+}
+
+// requireLDPSessionEvents compares the neighbor's whole event history with
+// want, and checks that every event names the neighbor and Ze's link.
+func requireLDPSessionEvents(records []ldpSessionEventRecord, want ...ldpSessionEventKind) error {
+	kinds := make([]ldpSessionEventKind, 0, len(records))
+	for _, record := range records {
+		kinds = append(kinds, record.kind)
+	}
+	if !slices.Equal(kinds, want) {
+		return fmt.Errorf("the ldp session events for %s are %s, want %v",
+			ldpNeighborIdentifier, describeLDPSessionEvents(records), want)
+	}
+	for _, record := range records {
+		if record.peerAddress != "10.99.0.1" {
+			return fmt.Errorf("%s names peer-address %q, want 10.99.0.1", record.kind, record.peerAddress)
+		}
+		if record.iface != ldpNeighborZeLink {
+			return fmt.Errorf("%s names interface %q, want %s", record.kind, record.iface, ldpNeighborZeLink)
+		}
+	}
+	return nil
+}
+
+func describeLDPSessionEvents(records []ldpSessionEventRecord) string {
+	var line textbuf.Buffer
+	line.Byte('[')
+	for index, record := range records {
+		if index > 0 {
+			line.Byte(' ')
+		}
+		line.Str(record.kind.String())
+	}
+	return line.Byte(']').String()
+}
+
+// ldpNeighborState answers the state `show ldp neighbor` reports for the
+// neighbor, and an error when the daemon reports no such neighbor.
+func ldpNeighborState(ctx context.Context, plugin *sdk.Plugin) (string, error) {
+	rows, err := routingRows(ctx, plugin, "show ldp neighbor", true)
+	if err != nil {
+		return "", err
+	}
+	for _, row := range rows {
+		if row["lsr-id"] != "10.99.0.1" {
+			continue
+		}
+		state, ok := row["state"].(string)
+		if !ok {
+			return "", fmt.Errorf("show ldp neighbor: the row for 10.99.0.1 has no state: %#v", row)
+		}
+		return state, nil
+	}
+	return "", fmt.Errorf("show ldp neighbor holds no row for 10.99.0.1: %#v", rows)
+}
+
+// awaitLDPNeighborState waits until the daemon reports the neighbor in want.
+func awaitLDPNeighborState(ctx context.Context, plugin *sdk.Plugin, want string) error {
+	var state string
+	var readErr error
+	reached := Poll(ctx, ldpPollAttempts, ldpPollDelay, func() bool {
+		state, readErr = ldpNeighborState(ctx, plugin)
+		return readErr == nil && state == want
+	})
+	if reached {
+		return nil
+	}
+	if readErr != nil {
+		return fmt.Errorf("waiting for show ldp neighbor to report %s: %w", want, readErr)
+	}
+	return fmt.Errorf("show ldp neighbor reports 10.99.0.1 %s, want %s", state, want)
+}
+
+// ldpNeighborNamespace reads the scenario arguments, `netns <name>`: the
+// namespace that holds the neighbor's link.
+func ldpNeighborNamespace(args []string) (string, error) {
+	if len(args) != 2 {
+		return "", fmt.Errorf("want netns <name>, got %d argument(s) %q", len(args), args)
+	}
+	if args[0] != "netns" {
+		return "", fmt.Errorf("want netns <name>, got %q", args[0])
+	}
+	return args[1], nil
+}
+
+// runLDPNeighborScenario opens the neighbor, runs scenario as the observer
+// plugin, and closes the neighbor only after the observer stopped, so a
+// session the scenario leaves operational ends with the daemon.
+func runLDPNeighborScenario(ctx context.Context, args []string, scenario func(context.Context, *sdk.Plugin, *ldpNeighbor, *ldpSessionEventLog) error) error {
+	namespace, err := ldpNeighborNamespace(args)
+	if err != nil {
+		return err
+	}
+	neighbor, err := openLDPNeighbor(ctx, namespace)
+	if err != nil {
+		return err
+	}
+	events := &ldpSessionEventLog{}
+	runErr := observeConfigured(ctx, ldpObserverName, &sdk.Registration{}, events.setup,
+		func(ctx context.Context, plugin *sdk.Plugin) error {
+			return scenario(ctx, plugin, neighbor, events)
+		})
+	return errors.Join(runErr, neighbor.close())
+}
+
+// bringUpLDPSession brings an accepted session to operational on both sides,
+// and waits for the daemon and the observer to say so: Ze's state reads
+// operational and the observer holds eventCount events.
+func bringUpLDPSession(ctx context.Context, plugin *sdk.Plugin, session *ldpNeighborSession, events *ldpSessionEventLog, eventCount int) ([]ldpSessionEventRecord, error) {
+	if err := session.establish(); err != nil {
+		return nil, err
+	}
+	if err := awaitLDPNeighborState(ctx, plugin, ldpNeighborStateOperational); err != nil {
+		return nil, err
+	}
+	return events.await(ctx, eventCount)
+}
+
+// endLDPSession stops the Hellos and ends an operational session from the
+// neighbor's side, then waits until the daemon reports the session gone and
+// the observer holds eventCount events. One daemon read passes between the
+// last Hello and the close, so Ze reads that Hello while the session still
+// exists and nothing dials on it after the end.
+func endLDPSession(ctx context.Context, plugin *sdk.Plugin, neighbor *ldpNeighbor, session *ldpNeighborSession, events *ldpSessionEventLog, eventCount int) ([]ldpSessionEventRecord, error) {
+	neighbor.hellos.setEnabled(false)
+	if err := awaitLDPNeighborState(ctx, plugin, ldpNeighborStateOperational); err != nil {
+		return nil, err
+	}
+	if err := session.close(); err != nil {
+		return nil, err
+	}
+	if err := awaitLDPNeighborState(ctx, plugin, ldpNeighborStateDiscovered); err != nil {
+		return nil, fmt.Errorf("after the neighbor closed the operational session: %w", err)
+	}
+	records, err := events.await(ctx, eventCount)
+	if err != nil {
+		return nil, fmt.Errorf("after the neighbor closed the operational session: %w", err)
+	}
+	return records, nil
+}
+
+// ldpSessionEndClearsBackoffDriver is `ldp/session-end-clears-backoff netns
+// <name>`, the observer of test/ldp/ldp-session-end-clears-backoff.ci.
+func ldpSessionEndClearsBackoffDriver(ctx context.Context, args []string) error {
+	return runLDPNeighborScenario(ctx, args, ldpSessionEndClearsBackoff)
+}
+
+// ldpSessionEndClearsBackoff brings a session to operational, ends it from
+// the neighbor's side, and requires Ze to dial again on the first Hello it
+// receives after the daemon reports the session gone.
+//
+// The neighbor's Hellos pause while the session ends, and exactly one Hello is
+// sent once `show ldp neighbor` reads `discovered` and the observer holds the
+// session-down. onDone deletes the session and settles the backoff under one
+// lock, so a daemon that reports `discovered` has already decided the backoff.
+// A session end recorded as a failed setup leaves a 15-second backoff, and
+// that one Hello then opens nothing.
+func ldpSessionEndClearsBackoff(ctx context.Context, plugin *sdk.Plugin, neighbor *ldpNeighbor, events *ldpSessionEventLog) error {
+	neighbor.hellos.setEnabled(true)
+	first, err := neighbor.acceptSession(time.Now().Add(ldpFirstDialWait))
+	if err != nil {
+		return fmt.Errorf("first session: %w", err)
+	}
+	if _, err := bringUpLDPSession(ctx, plugin, first, events, 1); err != nil {
+		return fmt.Errorf("first session: %w", err)
+	}
+	if _, err := endLDPSession(ctx, plugin, neighbor, first, events, 2); err != nil {
+		return err
+	}
+
+	if err := neighbor.hellos.sendOne(); err != nil {
+		return err
+	}
+	helloAt := time.Now()
+	second, err := neighbor.acceptSession(helloAt.Add(ldpRedialWait))
+	if err != nil {
+		return fmt.Errorf("no session from Ze within %s of the first Hello after the operational session ended, "+
+			"so that end left a setup backoff on the adjacency: %w", ldpRedialWait, err)
+	}
+	redial := time.Since(helloAt)
+	neighbor.hellos.setEnabled(true)
+	records, err := bringUpLDPSession(ctx, plugin, second, events, 3)
+	if err != nil {
+		return fmt.Errorf("second session: %w", err)
+	}
+	// The second session stays operational: it ends with the daemon, after the
+	// Hellos stop, so no later dial can follow it.
+	neighbor.hellos.setEnabled(false)
+	if err := requireLDPSessionEvents(records, ldpSessionEventUp, ldpSessionEventDown, ldpSessionEventUp); err != nil {
+		return err
+	}
+	if err := neighbor.hellos.err(); err != nil {
+		return err
+	}
+	netnsSay("OK: Ze dialled ", ldpNeighborIdentifier, " ", redial.Round(time.Millisecond).String(),
+		" after the first Hello that followed the end of an operational session; events ", describeLDPSessionEvents(records))
+	return nil
+}
+
+// ldpSetupFailurePublishesNoSessionDownDriver is
+// `ldp/setup-failure-publishes-no-session-down netns <name>`, the observer of
+// test/ldp/ldp-setup-failure-publishes-no-session-down.ci.
+func ldpSetupFailurePublishesNoSessionDownDriver(ctx context.Context, args []string) error {
+	return runLDPNeighborScenario(ctx, args, ldpSetupFailurePublishesNoSessionDown)
+}
+
+// ldpSetupFailurePublishesNoSessionDown rejects Ze's first Initialization, then
+// accepts the next session and ends it, and requires the event history to be
+// that one session's up and down alone.
+//
+// The accepted session is the positive control: the observer does receive a
+// session-down when one is owed, so the missing one for the rejected attempt
+// is Ze's silence and not a deaf observer. Delivery to one plugin keeps the
+// order Ze emitted in, and the rejected attempt ended at least 15 seconds
+// before the second session's session-up, so a session-down it published sits
+// first in the history.
+func ldpSetupFailurePublishesNoSessionDown(ctx context.Context, plugin *sdk.Plugin, neighbor *ldpNeighbor, events *ldpSessionEventLog) error {
+	neighbor.hellos.setEnabled(true)
+	first, err := neighbor.acceptSession(time.Now().Add(ldpFirstDialWait))
+	if err != nil {
+		return fmt.Errorf("first attempt: %w", err)
+	}
+	if err := first.reject(); err != nil {
+		return err
+	}
+	rejectedAt := time.Now()
+	if err := awaitLDPNeighborState(ctx, plugin, ldpNeighborStateDiscovered); err != nil {
+		return fmt.Errorf("after the neighbor rejected the Initialization: %w", err)
+	}
+
+	second, err := neighbor.acceptSession(rejectedAt.Add(ldpSetupBackoffWait))
+	if err != nil {
+		return fmt.Errorf("the session after the rejected attempt: %w", err)
+	}
+	waited := time.Since(rejectedAt)
+	if _, err := bringUpLDPSession(ctx, plugin, second, events, 1); err != nil {
+		return fmt.Errorf("the session after the rejected attempt: %w", err)
+	}
+	if waited < ldpSetupBackoffFloor {
+		return fmt.Errorf("a new session %s after the neighbor NAK'd Ze's Initialization, under the %s floor",
+			waited.Round(time.Millisecond), ldpSetupBackoffFloor)
+	}
+
+	records, err := endLDPSession(ctx, plugin, neighbor, second, events, 2)
+	if err != nil {
+		return err
+	}
+	if err := requireLDPSessionEvents(records, ldpSessionEventUp, ldpSessionEventDown); err != nil {
+		return fmt.Errorf("%w: the rejected attempt published a session event", err)
+	}
+	if err := neighbor.hellos.err(); err != nil {
+		return err
+	}
+	netnsSay("OK: the rejected attempt published no session event, Ze dialled again ",
+		waited.Round(time.Millisecond).String(), " later; events ", describeLDPSessionEvents(records))
+	return nil
+}
diff --git a/internal/test/fixture/register_ldp_neighbor_linux.go b/internal/test/fixture/register_ldp_neighbor_linux.go
new file mode 100644
index 0000000000..422d26a9aa
--- /dev/null
+++ b/internal/test/fixture/register_ldp_neighbor_linux.go
@@ -0,0 +1,19 @@
+//go:build linux
+
+// register_ldp_neighbor_linux.go names the fixtures of the ldp suite's live
+// neighbor: the launcher that builds the two-namespace veth link and runs the
+// daemon on one side of it, and the two scenarios whose observer plugin plays
+// the LDP neighbor on the other side.
+//
+// Related: ldp_neighbor_linux.go -- the link, the neighbor and its RFC 5036 codec
+// Related: ldp_session_end_linux.go -- the two scenarios
+// Related: test/ldp/ldp-session-end-clears-backoff.ci -- an operational session ends, Ze redials at once
+// Related: test/ldp/ldp-setup-failure-publishes-no-session-down.ci -- a rejected setup is delayed and silent
+
+package fixture
+
+func init() {
+	Register("ldp/neighbor-link", ldpNeighborLinkDriver)
+	Register("ldp/session-end-clears-backoff", ldpSessionEndClearsBackoffDriver, StopsDaemon)
+	Register("ldp/setup-failure-publishes-no-session-down", ldpSetupFailurePublishesNoSessionDownDriver, StopsDaemon)
+}
diff --git a/internal/test/fixture/ddos_flowspec_exit_linux.go b/internal/test/fixture/ddos_flowspec_exit_linux.go
new file mode 100644
index 0000000000..5a08b8fe86
--- /dev/null
+++ b/internal/test/fixture/ddos_flowspec_exit_linux.go
@@ -0,0 +1,276 @@
+//go:build linux
+
+// Design: docs/guide/ddos-mitigation.md -- what each end of the FlowSpec plugin does to a live announcement
+// Related: register_ddos_flowspec_exit_linux.go -- registers both drivers
+// Related: plugin_fixture_06_ddos_linux.go -- the transit veth, the remote flood, fixture06ReloadDaemon
+
+package fixture
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"os"
+	"strings"
+	"time"
+
+	"github.com/ze-software/ze/internal/core/textbuf"
+	"github.com/ze-software/ze/pkg/plugin/sdk"
+)
+
+// ddosFlowspecExitVictim is the remote victim both FlowSpec exit tests flood.
+// The FlowSpec responder defers a box-owned victim to on-host mitigation, so
+// the victim sits behind the transit veth plugin/ddos-transit-forward-drop-setup
+// builds, as for test/plugin/ddos-announce-rate-limit.ci. The detector names
+// it as a host prefix (characterize.go characterizeTarget), so the rule the
+// blackhole fallback announces is destination-ipv4 203.0.113.9/32 and nothing
+// else.
+const ddosFlowspecExitVictim = "203.0.113.9"
+
+// ddosFlowspecExitRecord is the record key the FlowSpec plugin writes for its
+// live announcement (internal/plugins/ddos/flowspec/register.go
+// announcementKey). It is spelled here, not imported: a fixture links no
+// plugin, and the key is a contract an operator reads in `ze data registered`.
+const ddosFlowspecExitRecord = "meta/ddos-flowspec/announcement"
+
+// ddosFlowspecParentRemovedConfig is what the operator commits: the .ci's file
+// with the WHOLE `ddos` block deleted. The bgp block is byte-identical, attach
+// block included, so the peer is neither torn down nor re-added
+// (reactor/delivery_graph.go: a changed attach block travels through
+// RemovePeer and AddPeer) and its session survives the reload: the withdrawal
+// is the only UPDATE the reload can put on it. The probe's plugin block stays,
+// or the reload would stop this driver before it read anything.
+const ddosFlowspecParentRemovedConfig = `traffic {
+	usage {
+		enabled true
+		track-ip true
+		interfaces {
+			interface zdd0p {
+				enabled true
+			}
+			interface zdd0 {
+				enabled true
+			}
+		}
+	}
+}
+
+bgp {
+	filter {
+		import {
+			final accept
+		}
+		export {
+			final accept
+		}
+	}
+	peer peer1 {
+		connection {
+			remote {
+				ip 127.0.0.1
+			}
+			local {
+				ip 127.0.0.2
+				accept false
+			}
+		}
+		session {
+			asn {
+				local 65000
+				remote 65001
+			}
+			router-id 1.2.3.4
+			family {
+				ipv4/unicast { prefix { maximum 10000; } }
+				ipv4/flow { prefix { maximum 10000; } }
+			}
+			capability {
+				graceful-restart disable
+			}
+		}
+
+		attach process ddos-flowspec {
+			send [ update ]
+		}
+	}
+}
+
+plugin {
+	external ddos-flowspec-parent-removed-probe {
+		run "le test fixture plugin/ddos-flowspec-parent-removed-driver"
+		encoder json
+	}
+}
+`
+
+// ddosFlowspecParentRemoved proves that deleting the whole `ddos` block puts
+// the FlowSpec withdrawal on the wire during the reload.
+//
+// It floods the remote victim until `show ddos flowspec` reports the rule live
+// AND the peer's updates-sent counter shows the announcement left, reloads the
+// daemon with the parent block deleted, then waits for updates-sent to step
+// again: nothing else can send this peer an UPDATE, because the bgp block did
+// not change. The bytes of both UPDATEs are the peer's to assert, and which
+// path withdrew is the .ci's log assertions.
+//
+// After the reload `show ddos flowspec` has no answer: the plugin that owns it
+// is stopped by the same reload. The counter is read from the BGP engine,
+// which the reload does not touch.
+func ddosFlowspecParentRemoved(ctx context.Context, args []string) error {
+	return p05Observe(ctx, args, "ddos-flowspec-parent-removed-probe", func(ctx context.Context, plugin *sdk.Plugin) error {
+		if !waitPeerCounter03(ctx, plugin, "eor-sent", 1, 80) {
+			return errors.New("the BGP session to the test peer never sent its End-of-RIB, so no FlowSpec rule could reach it")
+		}
+		established, err := peerCounter03(ctx, plugin, addrLoopback, "updates-sent")
+		if err != nil {
+			return fmt.Errorf("read updates-sent before the flood: %w", err)
+		}
+
+		flood, err := fixture06OpenRemoteFlood(ddosFlowspecExitVictim)
+		if err != nil {
+			return err
+		}
+		defer flood.Close()
+
+		sent := 0
+		announced := Poll(ctx, 200, 250*time.Millisecond, func() bool {
+			sent += flood.blast(4000)
+			row, showErr := p05ShowMap(ctx, plugin, "show ddos flowspec")
+			if showErr != nil || row["active"] != true {
+				return false
+			}
+			updates, countErr := peerCounter03(ctx, plugin, addrLoopback, "updates-sent")
+			return countErr == nil && updates > established
+		})
+		if !announced {
+			return fmt.Errorf("ddos-flowspec announced nothing to the peer for remote victim %s within 50s of an unbroken flood (sent %d packets)",
+				ddosFlowspecExitVictim, sent)
+		}
+		before, err := peerCounter03(ctx, plugin, addrLoopback, "updates-sent")
+		if err != nil {
+			return fmt.Errorf("read updates-sent after the announcement: %w", err)
+		}
+		if err := ddosFlowspecReport("FLOWSPEC-ANNOUNCED " + ddosFlowspecExitVictim); err != nil {
+			return err
+		}
+
+		if err := fixture06ReloadDaemon(ddosFlowspecParentRemovedConfig); err != nil {
+			return err
+		}
+
+		after := before
+		withdrawn := Poll(ctx, 160, 250*time.Millisecond, func() bool {
+			updates, countErr := peerCounter03(ctx, plugin, addrLoopback, "updates-sent")
+			if countErr != nil {
+				return false
+			}
+			after = updates
+			return updates > before
+		})
+		if !withdrawn {
+			return fmt.Errorf("deleting the parent ddos block sent the peer no UPDATE within 40s (updates-sent stayed at %d): the FlowSpec rule for %s is left at the peer with no plugin to withdraw it",
+				after, ddosFlowspecExitVictim)
+		}
+		return ddosFlowspecReport("FLOWSPEC-WITHDRAWAL-SENT " + ddosFlowspecExitVictim)
+	})
+}
+
+// ddosFlowspecOrphanFlood floods the remote victim until the daemon holds the
+// FlowSpec plugin's record of the announcement, read back through the daemon
+// (`show data cat`, internal/component/config/storage/cli dataCat).
+//
+// The record is the state the orphan test needs, and `show ddos flowspec` is
+// not a barrier for it: the responder publishes the live rule before it writes
+// the record (responder.go announce), so a kill between the two would leave no
+// record. The answer is read until it names the victim, never for a time.
+func ddosFlowspecOrphanFlood(ctx context.Context, args []string) error {
+	if len(args) != 0 {
+		return errors.New("usage: plugin/ddos-flowspec-orphan-flood")
+	}
+	flood, err := fixture06OpenRemoteFlood(ddosFlowspecExitVictim)
+	if err != nil {
+		return err
+	}
+	defer flood.Close()
+
+	command := "show data cat " + ddosFlowspecExitRecord
+	want := ddosFlowspecExitVictim + "/32"
+	environment := os.Environ()
+	sent := 0
+	var last awaitAnswerRun
+	recorded := Poll(ctx, 200, 250*time.Millisecond, func() bool {
+		sent += flood.blast(4000)
+		last.code, last.stdout, last.stderr, last.err = runCaptured(ctx, environment, "", "ze", "cli", "-c", command)
+		if last.err != nil {
+			return false
+		}
+		return last.code == 0 && strings.Contains(last.stdout, want)
+	})
+	if !recorded {
+		if last.err != nil {
+			return fmt.Errorf("the daemon never held a FlowSpec record for %s within 50s of an unbroken flood (sent %d packets); the last `ze cli -c %s` did not start: %w",
+				want, sent, command, last.err)
+		}
+		return fmt.Errorf("the daemon never held a FlowSpec record for %s within 50s of an unbroken flood (sent %d packets); the last `ze cli -c %s` exited %d, stdout %q, stderr %q",
+			want, sent, command, last.code, awaitAnswerTail(last.stdout), awaitAnswerTail(last.stderr))
+	}
+	return ddosFlowspecReport("FLOWSPEC-RECORDED " + want)
+}
+
+// ddosFlowspecOrphanCode is the doctor code of a FlowSpec rule no responder
+// owns (internal/core/diagnostic CodeDoctorDDoSFlowspecOrphanAnnouncement),
+// spelled here for the same reason as ddosFlowspecExitRecord: it is what an
+// operator reads in `ze doctor`.
+const ddosFlowspecOrphanCode = "doctor-ddos-flowspec-orphan-announcement"
+
+// ddosFlowspecOrphanCleared waits until the fix `ze doctor` printed has
+// cleared the finding: in one round, the daemon answers `show doctor` with no
+// ddos-flowspec orphan finding AND refuses `show data cat` for the record,
+// which is gone. Both are asked in the same round, and the doctor answer must
+// exit zero, so a daemon that is down never reads as cleared.
+//
+// The restart the fix runs answers once the new process reached its running
+// stage, and the plugin withdraws the record from OnStarted after that, so the
+// clearing is a state to wait for, not one the restart's answer orders.
+func ddosFlowspecOrphanCleared(ctx context.Context, args []string) error {
+	if len(args) != 0 {
+		return errors.New("usage: plugin/ddos-flowspec-orphan-cleared")
+	}
+	environment := os.Environ()
+	doctorCommand := "show doctor | json"
+	recordCommand := "show data cat " + ddosFlowspecExitRecord
+	var doctor, record awaitAnswerRun
+	cleared := Poll(ctx, 120, 250*time.Millisecond, func() bool {
+		doctor.code, doctor.stdout, doctor.stderr, doctor.err = runCaptured(ctx, environment, "", "ze", "cli", "-c", doctorCommand)
+		if doctor.err != nil {
+			return false
+		}
+		if doctor.code != 0 {
+			return false
+		}
+		if strings.Contains(doctor.stdout, ddosFlowspecOrphanCode) {
+			return false
+		}
+		record.code, record.stdout, record.stderr, record.err = runCaptured(ctx, environment, "", "ze", "cli", "-c", recordCommand)
+		if record.err != nil {
+			return false
+		}
+		return record.code != 0
+	})
+	if !cleared {
+		return fmt.Errorf("the fix ze doctor printed did not clear %s within 30s; the last `ze cli -c %s` exited %d, stdout %q (start error %v); the last `ze cli -c %s` exited %d, stdout %q, stderr %q (start error %v)",
+			ddosFlowspecOrphanCode, doctorCommand, doctor.code, awaitAnswerTail(doctor.stdout), doctor.err,
+			recordCommand, record.code, awaitAnswerTail(record.stdout), awaitAnswerTail(record.stderr), record.err)
+	}
+	return ddosFlowspecReport("FLOWSPEC-REPORT-CLEARED " + ddosFlowspecExitVictim + "/32")
+}
+
+// ddosFlowspecReport writes one marker line on stderr. It goes to stderr: a
+// plugin's stdout is the protocol channel the encoder owns.
+func ddosFlowspecReport(marker string) error {
+	var tb textbuf.Buffer
+	if _, err := fmt.Fprintln(os.Stderr, tb.Str(marker).String()); err != nil {
+		return fmt.Errorf("report %s: %w", marker, err)
+	}
+	return nil
+}
