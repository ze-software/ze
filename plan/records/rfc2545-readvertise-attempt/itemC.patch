+// Found yields each global the table pairs with one Link-Local, and that
+// Link-Local, in no set order. A global whose answer is a miss is not
+// yielded: the field such a global goes out in carries no Link-Local whatever
+// the miss was, so two reads that differ only in how they missed send the same
+// bytes (the reactor's re-advertise compares two reads this way).
+func (n *NeighborLinkLocals) Found() iter.Seq2[netip.Addr, netip.Addr] {
+	return func(yield func(global, linkLocal netip.Addr) bool) {
+		if n == nil {
+			return
+		}
+		for global, answer := range n.byGlobal {
+			if answer.outcome != LinkLocalFound {
+				continue
+			}
+			if !yield(global, answer.linkLocal) {
+				return
+			}
+		}
+	}
+}
