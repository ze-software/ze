 /* helper used by ip_options_compile() to call fib_compute_spec_dst()
  * at most one time.
--- a/net/ipv4/ip_output.c
+++ b/net/ipv4/ip_output.c
@@ -790,6 +790,14 @@
 	 */
 
 	hlen = iph->ihl * 4;
+	/* Encapsulation can leave less than one fragment quantum, even when
+	 * the device MTU itself is valid. Never underflow or emit a fragment
+	 * whose rounded payload is zero: ip_frag_next must make progress.
+	 */
+	if (unlikely(mtu < hlen + 8)) {
+		err = -EMSGSIZE;
+		goto fail;
+	}
 	mtu = mtu - hlen;	/* Size of data space */
 	IPCB(skb)->flags |= IPSKB_FRAG_COMPLETE;
 	ll_rs = LL_RESERVED_SPACE(rt->dst.dev);
