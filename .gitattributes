# The ci-sleep ratchet baseline is an append-only ledger of signed-integer delta
# lines that SUM to the allowed time.sleep( ceiling (scripts/dev/verify_wiring_docs.py
# ::parse_sleep_baseline). merge=union makes git keep BOTH sides of a concurrent
# change, so two specs that each remove sleeps and append their own `-N` line
# auto-merge to a file holding both deltas -- no conflict, and the sum stays
# correct. This is the whole reason the ratchet moved off a single shared integer.
test/.ci-sleep-baseline merge=union

# plan/.citation-baseline is the same shape: an allow-list of currently-dangling
# spec->spec citation targets (scripts/dev/spec-citation-check.py). Two concurrent
# spec closures that each close a still-cited spec append their newly-dangling
# target here; merge=union keeps both so they do not conflict (same rationale as
# the sleep ratchet above -- shared plan-file contention).
plan/.citation-baseline merge=union

# test/.accept-only-baseline grandfathers the existing "accept-only" (exit-code-
# only) .ci tests so the lint (internal/test/runner/accept_only_lint_test.go) only
# fails on a NEW one (spec-fixit-ci-accept-only-tests). It is a sorted allow-list
# that only SHRINKS as tests are strengthened or annotated. Two concurrent
# strengthening efforts each REMOVE their line; merge=union keeps both sides so the
# removals do not conflict (same rationale as the ratchets above). A concurrent
# ADD would also be kept, but adds are what the lint forbids -- the gate, not the
# merge, is what stops the class from growing.
test/.accept-only-baseline merge=union
