	$(GO_TEST) -fuzz=FuzzEncodeDecode -fuzztime=10s -timeout=60s ./internal/component/config/secret/...
	$(GO_TEST) -fuzz=FuzzParseFrame -fuzztime=10s -timeout=60s ./internal/component/l2tp/ppp/...
