# Test: the IPv6 half of the first-packet selection. A BFD Control packet whose
# Your Discriminator is ZERO, sent to ::1, selects the session keyed on ::1.
#
# Linux terminates exactly one address in ::/128, so unlike 127/8 there is no
# second loopback address to send from. The two steps below add a ULA pair to lo
# first, which keeps the shape of the IPv4 arm: the packet is sent FROM one
# address TO another and the session is keyed on the one it is sent to.
#
# VALIDATES: RFC 5880 Section 6.8.6 over IPv6 -- IPV6_PKTINFO, whose payload is
#            the 16-byte destination address FOLLOWED by the ifindex, the
#            opposite order to the IPv4 struct. parseReceivedPktinfo reads both
#            from offsets no unit test can confirm against a real kernel
#            (internal/component/bfd/transport/udp_linux.go).
# PREVENTS:  an IPv6 offset or constant that is wrong in a way the IPv4 arm
#            cannot see. The sibling test bfd-first-packet-pktinfo.ci proves the
#            v4 struct only, and a synthesized cmsg proves the parser against
#            this repository's MODEL of the kernel rather than the kernel.
#
# `bind-v6 true` is what opens the RFC 5883 IPv6 socket at all; without it the
# daemon binds v4 only and nothing would receive this packet.
option=needs-linux
option=env:var=ze.bfd.test-parallel:value=true
option=exclusive:group=bfd-ports

stdin=ze-bfd:terminator=EOF_CONF
plugin {
	external bfd-first-packet-pktinfo-v6-test {
		run "ze-test fixture bfd/bfd-first-packet-pktinfo-v6"
		encoder json
	}
}

environment {
	log {
		bfd debug
	}
}

bfd {
	enabled true;
	bind-v6 true;
	profile fast {
		detect-multiplier 3
		desired-min-tx-us 300000
		required-min-rx-us 300000
	}
	single-hop-session fd00:5882::2 {
		local fd00:5882::1;
		profile fast;
	}
}
EOF_CONF

# `replace` rather than `add`: `add` fails with EEXIST on a second run in the
# same network namespace, and this is the only .ci in test/ that puts an address
# on an interface. The pair is removed again at the end, so the namespace is
# left as it was found whichever way the run goes.
cmd=foreground:seq=1:exec=ip -6 addr replace fd00:5882::1/128 dev lo
expect=exit:code=0
cmd=foreground:seq=2:exec=ip -6 addr replace fd00:5882::2/128 dev lo
expect=exit:code=0
cmd=foreground:seq=3:exec=ze -:stdin=ze-bfd:timeout=30s
expect=exit:code=0
expect=stderr:contains=OK: the first packet was selected by its destination address fd00:5882::1

cmd=foreground:seq=4:exec=ip -6 addr del fd00:5882::1/128 dev lo
expect=exit:code=0
cmd=foreground:seq=5:exec=ip -6 addr del fd00:5882::2/128 dev lo
expect=exit:code=0
