# Test: the PPPoE and L2TP subsystems answer on one daemon at the same time.
# VALIDATES: an L2TP SCCRQ gets an SCCRP while a PPPoE AC is bound and listening
# VALIDATES: a PPPoE PADI gets a PADO while an L2TP control connection is open
# PREVENTS: one access method starving the other at startup. Both subsystems come
# up through the same BNG seam (cmd/ze/hub/bng_infra.go, bngRegister); a failure
# that leaves one of the two unstarted is invisible to test/l2tp and to
# pppoe-basic.ci, because each of those boots only the subsystem it tests.
#
# The two probes use different transports on purpose: L2TP over UDP on loopback,
# PPPoE over AF_PACKET on the veth pair. Passing both proves the daemon is
# serving two access methods, not one wearing two names.
option=needs-linux:caps=net-admin,net-raw
option=netns-link:name=veth-bng:peer=veth-sub


stdin=config:terminator=EOF_CONF
l2tp {
    enabled true
}
environment {
    l2tp {
        server main {
            ip 127.0.0.1
            port $PORT
        }
    }
}
pppoe {
    enabled true
    ac-name ze-concurrent
    interface veth-bng {
    }
}
EOF_CONF

option=env:var=ze.log.l2tp:value=debug
option=env:var=ze.log.pppoe:value=debug
option=env:var=ze.l2tp.skip-kernel-probe:value=true
option=env:var=TEST_IFACE:value=veth-sub

cmd=background:seq=1:exec=ze -:stdin=config
cmd=foreground:seq=2:exec=ze-test fixture pppoe/concurrent-l2tp $PORT:timeout=60s
expect=exit:code=0
expect=stdout:contains=OK: L2TP SCCRP received
expect=stdout:contains=OK: PPPoE PADO received
expect=stdout:contains=OK: both subsystems active concurrently
