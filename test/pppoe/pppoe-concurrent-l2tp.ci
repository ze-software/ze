# Test: PPPoE and L2TP subsystems running concurrently.
# VALIDATES: AC-12 -- both access methods active, shared auth/pool/shaper
#
# Starts ze with both pppoe{} and l2tp{} config blocks. Verifies
# both subsystems accept connections independently. Uses the CLI
# to confirm both subsystem types report active sessions.
option=skip-os:value=darwin

tmpfs=concurrent-test.py:mode=755:terminator=EOF_PY
#!/usr/bin/env python3
"""Test PPPoE and L2TP coexistence.

Phase 1: Send L2TP SCCRQ and verify SCCRP.
Phase 2: Send PPPoE PADI and verify PADO.
Both subsystems must respond, proving concurrent operation.
"""
import os
import socket
import struct
import sys
import time

# L2TP constants
L2TP_PORT = int(os.environ.get("L2TP_PORT", "1701"))

# PPPoE constants
ETH_P_PPOED = 0x8863
PADI = 0x09
PADO = 0x07
TAG_SVC_NAME  = 0x0101
TAG_HOST_UNIQ = 0x0103

PPPOE_IFACE = os.environ.get("TEST_IFACE", "veth-sub")


def avp(mandatory, attr_type, value):
    flags = 0x8000 if mandatory else 0
    return struct.pack("!HHH", flags | (6 + len(value)), 0, attr_type) + value


def build_sccrq():
    body = b""
    body += avp(True, 0, struct.pack("!H", 1))       # Message Type = SCCRQ
    body += avp(True, 2, b"\x01\x00")                 # Protocol Version
    body += avp(True, 3, struct.pack("!I", 3))         # Framing Caps
    body += avp(True, 4, struct.pack("!I", 0))         # Bearer Caps
    body += avp(True, 7, b"concurrent-test")           # Host Name
    body += avp(True, 9, struct.pack("!H", 0x0ABC))   # Assigned Tunnel ID
    body += avp(True, 10, struct.pack("!H", 8))        # Recv Window
    total = 12 + len(body)
    return struct.pack("!HHHHHH", 0xC802, total, 0, 0, 0, 0) + body


def test_l2tp():
    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    sock.bind(("127.0.0.1", 0))
    sock.settimeout(3.0)
    sccrq = build_sccrq()
    for _ in range(10):
        try:
            sock.sendto(sccrq, ("127.0.0.1", L2TP_PORT))
            data, _ = sock.recvfrom(1500)
            if len(data) >= 12:
                print("OK: L2TP SCCRP received")
                sock.close()
                return True
        except (socket.timeout, OSError):
            # retry backoff; the loop above returns on the first valid response, bounded wait not a blind sleep
            time.sleep(0.1)
            continue
    sock.close()
    print("ERROR: no L2TP SCCRP received", file=sys.stderr)
    return False


def test_pppoe():
    sock = socket.socket(socket.AF_PACKET, socket.SOCK_RAW, socket.htons(ETH_P_PPOED))
    sock.bind((PPPOE_IFACE, ETH_P_PPOED))
    sock.settimeout(5.0)
    src_mac = sock.getsockname()[4]
    dst_mac = b"\xff\xff\xff\xff\xff\xff"
    tags = struct.pack("!HH", TAG_SVC_NAME, 0)
    tags += struct.pack("!HH", TAG_HOST_UNIQ, 2) + b"\x45\x45"
    padi = struct.pack("!BBHH", 0x11, PADI, 0, len(tags)) + tags
    frame = dst_mac + src_mac + struct.pack("!H", ETH_P_PPOED) + padi

    for _ in range(10):
        try:
            sock.send(frame)
            resp = sock.recv(1518)
            payload = resp[14:]
            _, code, _, _ = struct.unpack("!BBHH", payload[:6])
            if code == PADO:
                print("OK: PPPoE PADO received")
                sock.close()
                return True
        except (socket.timeout, OSError):
            # retry backoff; the loop above returns on the first valid response, bounded wait not a blind sleep
            time.sleep(0.1)
            continue
    sock.close()
    print("ERROR: no PPPoE PADO received", file=sys.stderr)
    return False


def main():
    # blind settle: give both subsystems a moment to bind their sockets before probing (needs-linux netns test)
    time.sleep(0.5)
    l2tp_ok = test_l2tp()
    pppoe_ok = test_pppoe()
    if l2tp_ok and pppoe_ok:
        print("OK: both subsystems active concurrently")
        return 0
    return 1


if __name__ == "__main__":
    sys.exit(main())
EOF_PY

stdin=config:terminator=EOF_CONF
l2tp {
    enabled true
}
environment {
    l2tp {
        server main {
            ip 127.0.0.1
            port $L2TP_PORT
        }
    }
}
pppoe {
    enabled true
    ac-name ze-concurrent
    interface veth-bng {
    }
}
EOF_CONF

option=env:var=ze.log.l2tp:value=debug
option=env:var=ze.log.pppoe:value=debug
option=env:var=ze.l2tp.skip-kernel-probe:value=true
option=env:var=TEST_IFACE:value=veth-sub
option=netns:veth=veth-bng,veth-sub

cmd=background:seq=1:exec=ze -:stdin=config
cmd=foreground:seq=2:exec=python3 concurrent-test.py:timeout=20s
expect=exit:code=0
expect=stdout:contains=OK: L2TP SCCRP received
expect=stdout:contains=OK: PPPoE PADO received
expect=stdout:contains=OK: both subsystems active concurrently
