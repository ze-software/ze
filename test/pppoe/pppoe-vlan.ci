# Test: RFC 2516 PPPoE discovery over an 802.1Q sub-interface.
# VALIDATES: an interface named veth-bng.100 is resolved and bound like a parent
# VALIDATES: PADO and PADS are exchanged on the tagged segment, session id non-zero
# PREVENTS: an AC that binds only untagged parents. resolveInterface
# (internal/component/l2tp/pppoe/resolve.go) is what turns the configured name
# into an ifindex; point the config at the parent veth-bng instead and the client
# on veth-sub.100 gets no PADO, because the daemon then answers on the untagged
# segment and the tag never matches.
#
# The runner builds the veth pair and both .100 sub-interfaces inside this test's
# own network namespace, so the tag is carried by the kernel, not by the test.
option=needs-linux:caps=net-admin,net-raw
option=netns-link:name=veth-bng:peer=veth-sub:vlan=100


stdin=config:terminator=EOF_CONF
pppoe {
    enabled true
    ac-name ze-vlan-test
    interface veth-bng.100 {
    }
}
EOF_CONF

option=env:var=ze.log.pppoe:value=debug
option=env:var=TEST_IFACE:value=veth-sub.100

cmd=background:seq=1:exec=ze -:stdin=config
cmd=foreground:seq=2:exec=ze-test fixture pppoe/vlan:timeout=45s
expect=exit:code=0
expect=stdout:contains=OK: PADO received on VLAN interface
expect=stdout:contains=OK: PADS received on VLAN
