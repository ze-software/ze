# Test: PPPoE discovery over VLAN-tagged interface.
# VALIDATES: AC-9 -- discovery and session work on VLAN sub-interfaces
#
# Creates a veth pair with a VLAN sub-interface (802.1Q tag 100).
# The PPPoE subsystem binds the VLAN interface; the client sends
# PADI/PADR on the matching VLAN.
option=skip-os:value=darwin

tmpfs=pppoe-vlan-client.py:mode=755:terminator=EOF_PY
#!/usr/bin/env python3
"""PPPoE client over VLAN sub-interface."""
import os
import socket
import struct
import sys

ETH_P_PPOED = 0x8863
PADI = 0x09
PADO = 0x07
PADR = 0x19
PADS = 0x65

TAG_SVC_NAME  = 0x0101
TAG_HOST_UNIQ = 0x0103
TAG_AC_COOKIE = 0x0104
TAG_EOL       = 0x0000

IFACE = os.environ.get("TEST_IFACE", "veth-sub.100")


def build_padi(host_uniq=b"\x44\x44"):
    tags = struct.pack("!HH", TAG_SVC_NAME, 0)
    tags += struct.pack("!HH", TAG_HOST_UNIQ, len(host_uniq)) + host_uniq
    return struct.pack("!BBHH", 0x11, PADI, 0, len(tags)) + tags


def build_padr(ac_cookie, host_uniq=b"\x44\x44"):
    tags = struct.pack("!HH", TAG_SVC_NAME, 0)
    tags += struct.pack("!HH", TAG_HOST_UNIQ, len(host_uniq)) + host_uniq
    tags += struct.pack("!HH", TAG_AC_COOKIE, len(ac_cookie)) + ac_cookie
    return struct.pack("!BBHH", 0x11, PADR, 0, len(tags)) + tags


def parse_tags(payload):
    tags = {}
    off = 0
    while off + 4 <= len(payload):
        ttype, tlen = struct.unpack("!HH", payload[off:off+4])
        if ttype == TAG_EOL:
            break
        if off + 4 + tlen > len(payload):
            break
        tags[ttype] = payload[off+4:off+4+tlen]
        off += 4 + tlen
    return tags


def main():
    sock = socket.socket(socket.AF_PACKET, socket.SOCK_RAW, socket.htons(ETH_P_PPOED))
    sock.bind((IFACE, ETH_P_PPOED))
    sock.settimeout(5.0)

    src_mac = sock.getsockname()[4]
    dst_mac = b"\xff\xff\xff\xff\xff\xff"

    padi = build_padi()
    sock.send(dst_mac + src_mac + struct.pack("!H", ETH_P_PPOED) + padi)

    pado_frame = sock.recv(1518)
    pado = pado_frame[14:]
    _, code, _, plen = struct.unpack("!BBHH", pado[:6])
    if code != PADO:
        print(f"ERROR: expected PADO, got 0x{code:02x}", file=sys.stderr)
        return 1
    tags = parse_tags(pado[6:6+plen])
    print("OK: PADO received on VLAN interface")

    server_mac = pado_frame[6:12]
    padr = build_padr(tags[TAG_AC_COOKIE])
    sock.send(server_mac + src_mac + struct.pack("!H", ETH_P_PPOED) + padr)

    pads_frame = sock.recv(1518)
    pads = pads_frame[14:]
    _, code, sid, _ = struct.unpack("!BBHH", pads[:6])
    if code != PADS:
        print(f"ERROR: expected PADS, got 0x{code:02x}", file=sys.stderr)
        return 1
    if sid == 0:
        print("ERROR: PADS session ID is 0", file=sys.stderr)
        return 1
    print(f"OK: PADS received on VLAN, session-id={sid}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
EOF_PY

stdin=config:terminator=EOF_CONF
pppoe {
    enabled true
    ac-name ze-vlan-test
    interface veth-bng.100 {
    }
}
EOF_CONF

option=env:var=ze.log.pppoe:value=debug
option=env:var=TEST_IFACE:value=veth-sub.100
option=netns:veth=veth-bng,veth-sub:vlan=100

cmd=background:seq=1:exec=ze -:stdin=config
cmd=foreground:seq=2:exec=python3 pppoe-vlan-client.py:timeout=15s
expect=exit:code=0
expect=stdout:contains=OK: PADO received on VLAN interface
expect=stdout:contains=OK: PADS received on VLAN
