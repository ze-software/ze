# Test: RFC 2516 PPPoE discovery exchange (PADI -> PADO -> PADR -> PADS).
# VALIDATES: PADO carries AC-Name and AC-Cookie (RFC 2516 Section 5.2, 5.5)
# VALIDATES: a PADR with a valid AC-Cookie yields PADS with a non-zero session id
# VALIDATES: a PADR with a forged AC-Cookie gets no PADS (VerifyCookie, cookie.go)
# PREVENTS: an AC that hands out sessions to any PADR, which is the DoS the
# AC-Cookie exists to stop -- delete the VerifyCookie call in handlePADR
# (internal/component/l2tp/pppoe/server.go) and the forged-cookie phase below
# gets a PADS and fails.
#
# The daemon binds AF_PACKET to veth-bng and the client to veth-sub, the two ends
# of one veth pair inside this test's own network namespace, so the frames below
# are real Ethernet frames through the kernel and not a loopback of the encoder.
option=needs-linux:caps=net-admin,net-raw
option=netns-link:name=veth-bng:peer=veth-sub

tmpfs=pppoe-client.py:mode=755:terminator=EOF_PY
#!/usr/bin/env python3
"""Minimal PPPoE client: sends PADI, validates PADO, sends PADR, validates PADS."""
import os
import socket
import struct
import sys

ETH_P_PPPOE_DISC = 0x8863
PADI = 0x09
PADO = 0x07
PADR = 0x19
PADS = 0x65

TAG_EOL = 0x0000
TAG_SVC_NAME = 0x0101
TAG_AC_NAME = 0x0102
TAG_HOST_UNIQ = 0x0103
TAG_AC_COOKIE = 0x0104

IFACE = os.environ.get("TEST_IFACE", "veth-sub")

# Each attempt costs one socket timeout, so the wait IS the retry budget: the
# daemon binds its discovery socket after the config it is fed on stdin, and a
# PADI sent before that bind is simply not seen by anybody.
ATTEMPT_TIMEOUT = 1.0
ATTEMPTS = 15
# PADR rounds, each with a fresh cookie from a fresh PADI. A healthy AC answers
# the first one; the rest only cover a daemon still finishing its startup.
PADR_ROUNDS = 6


def build_padi(service_name="", host_uniq=b"\x42\x42"):
    tags = struct.pack("!HH", TAG_SVC_NAME, len(service_name)) + service_name.encode()
    tags += struct.pack("!HH", TAG_HOST_UNIQ, len(host_uniq)) + host_uniq
    return struct.pack("!BBHH", 0x11, PADI, 0x0000, len(tags)) + tags


def build_padr(ac_cookie, service_name="", host_uniq=b"\x42\x42"):
    tags = struct.pack("!HH", TAG_SVC_NAME, len(service_name)) + service_name.encode()
    tags += struct.pack("!HH", TAG_HOST_UNIQ, len(host_uniq)) + host_uniq
    tags += struct.pack("!HH", TAG_AC_COOKIE, len(ac_cookie)) + ac_cookie
    return struct.pack("!BBHH", 0x11, PADR, 0x0000, len(tags)) + tags


def parse_tags(payload):
    tags = {}
    off = 0
    while off + 4 <= len(payload):
        ttype, tlen = struct.unpack("!HH", payload[off:off + 4])
        if ttype == TAG_EOL or off + 4 + tlen > len(payload):
            break
        tags[ttype] = payload[off + 4:off + 4 + tlen]
        off += 4 + tlen
    return tags


class Wire:
    """One AF_PACKET endpoint on IFACE.

    A packet socket also receives a copy of what this process SENDS
    (dev_queue_xmit_nit delivers to every tap on the device), so every read
    discards frames sourced from our own MAC. Without that filter the first
    recv() returns our own PADI and the test reports "expected PADO, got PADI"
    whatever the daemon did.
    """

    def __init__(self):
        self.sock = socket.socket(
            socket.AF_PACKET, socket.SOCK_RAW, socket.htons(ETH_P_PPPOE_DISC)
        )
        self.sock.bind((IFACE, ETH_P_PPPOE_DISC))
        self.sock.settimeout(ATTEMPT_TIMEOUT)
        self.mac = self.sock.getsockname()[4]

    def send(self, dst_mac, payload):
        self.sock.send(dst_mac + self.mac + struct.pack("!H", ETH_P_PPPOE_DISC) + payload)

    def read_one(self):
        """Return (src_mac, code, sid, tags) of the next frame from somebody else."""
        while True:
            frame = self.sock.recv(1518)
            if frame[6:12] == self.mac:
                continue
            payload = frame[14:]
            if len(payload) < 6:
                continue
            _, code, sid, plen = struct.unpack("!BBHH", payload[:6])
            return frame[6:12], code, sid, parse_tags(payload[6:6 + plen])

    def exchange(self, dst_mac, payload, want_code, attempts=ATTEMPTS):
        """Send until a frame with want_code comes back, or the budget is spent."""
        for _ in range(attempts):
            self.send(dst_mac, payload)
            try:
                src, code, sid, tags = self.read_one()
            except socket.timeout:
                continue
            if code == want_code:
                return src, sid, tags
            print(f"ignoring unexpected code 0x{code:02x}", file=sys.stderr)
        return None, None, None

    def discover(self):
        """One PADI/PADO round, returning the AC's MAC and a fresh AC-Cookie."""
        server_mac, _, tags = self.exchange(b"\xff" * 6, build_padi(), PADO)
        if server_mac is None:
            return None, None
        return server_mac, tags

    def silent_for_one_timeout(self, dst_mac, payload):
        """Send once and report whether anything at all answered."""
        self.send(dst_mac, payload)
        try:
            _, code, sid, _ = self.read_one()
        except socket.timeout:
            return None
        return code, sid


def main():
    wire = Wire()
    broadcast = b"\xff" * 6

    server_mac, tags = wire.discover()
    if server_mac is None:
        print("ERROR: no PADO received", file=sys.stderr)
        return 1
    if TAG_AC_NAME not in tags:
        print("ERROR: PADO missing AC-Name", file=sys.stderr)
        return 1
    if TAG_AC_COOKIE not in tags:
        print("ERROR: PADO missing AC-Cookie", file=sys.stderr)
        return 1
    print(f"OK: PADO received, AC-Name={tags[TAG_AC_NAME].decode()}")

    # Re-discover between PADR rounds. An AC-Cookie expires (cookie-timeout, 5s
    # by default), so replaying one cookie for the whole budget turns any single
    # PADR failure into a cascade of "invalid cookie" and reports a stale cookie
    # where the real fault was the first round's.
    sid = None
    for _ in range(PADR_ROUNDS):
        _, sid, _ = wire.exchange(server_mac, build_padr(tags[TAG_AC_COOKIE]), PADS, attempts=2)
        if sid is not None:
            break
        server_mac, tags = wire.discover()
        if server_mac is None:
            print("ERROR: AC stopped answering PADI while retrying PADR", file=sys.stderr)
            return 1
    if sid is None:
        print("ERROR: no PADS received for a valid AC-Cookie", file=sys.stderr)
        return 1
    if sid == 0:
        print("ERROR: PADS session ID is 0", file=sys.stderr)
        return 1
    print(f"OK: PADS received, session-id={sid}")

    # A forged cookie must be dropped before the session table is consulted, so
    # this PADR earns neither a fresh PADS nor a re-send of the one above.
    forged = build_padr(b"\x00" * 32, host_uniq=b"\x43\x43")
    answer = wire.silent_for_one_timeout(server_mac, forged)
    if answer is not None:
        code, bad_sid = answer
        print(f"ERROR: forged cookie answered with code 0x{code:02x} sid={bad_sid}", file=sys.stderr)
        return 1
    print("OK: forged AC-Cookie PADR silently dropped")
    return 0


if __name__ == "__main__":
    sys.exit(main())
EOF_PY

stdin=config:terminator=EOF_CONF
pppoe {
    enabled true
    ac-name ze-test
    interface veth-bng {
    }
}
EOF_CONF

option=env:var=ze.log.pppoe:value=debug
option=env:var=TEST_IFACE:value=veth-sub

cmd=background:seq=1:exec=ze -:stdin=config
cmd=foreground:seq=2:exec=python3 pppoe-client.py:timeout=45s
expect=exit:code=0
expect=stdout:contains=OK: PADO received
expect=stdout:contains=OK: PADS received
expect=stdout:contains=OK: forged AC-Cookie PADR silently dropped
