# Test: Basic PPPoE discovery exchange (PADI -> PADO -> PADR -> PADS).
# VALIDATES: AC-1 -- PADO with AC-Name, Service-Name, AC-Cookie
# VALIDATES: AC-2 -- PADS with session ID after valid PADR
# VALIDATES: AC-6 -- invalid cookie silently dropped
#
# Requires Linux (raw sockets, AF_PPPOX). The test runs in a network
# namespace with a veth pair so the PPPoE subsystem can bind a real
# interface without root on the host.
option=skip-os:value=darwin

tmpfs=pppoe-client.py:mode=755:terminator=EOF_PY
#!/usr/bin/env python3
"""Minimal PPPoE client: sends PADI, validates PADO, sends PADR, validates PADS."""
import os
import socket
import struct
import sys
import time

ETH_P_PPOED = 0x8863
PADI = 0x09
PADO = 0x07
PADR = 0x19
PADS = 0x65

TAG_EOL        = 0x0000
TAG_SVC_NAME   = 0x0101
TAG_AC_NAME    = 0x0102
TAG_HOST_UNIQ  = 0x0103
TAG_AC_COOKIE  = 0x0104

IFACE = os.environ.get("TEST_IFACE", "veth-sub")


def build_padi(service_name="", host_uniq=b"\x42\x42"):
    tags = b""
    tags += struct.pack("!HH", TAG_SVC_NAME, len(service_name)) + service_name.encode()
    tags += struct.pack("!HH", TAG_HOST_UNIQ, len(host_uniq)) + host_uniq
    hdr = struct.pack("!BBHH", 0x11, PADI, 0x0000, len(tags))
    return hdr + tags


def build_padr(ac_cookie, service_name="", host_uniq=b"\x42\x42"):
    tags = b""
    tags += struct.pack("!HH", TAG_SVC_NAME, len(service_name)) + service_name.encode()
    tags += struct.pack("!HH", TAG_HOST_UNIQ, len(host_uniq)) + host_uniq
    tags += struct.pack("!HH", TAG_AC_COOKIE, len(ac_cookie)) + ac_cookie
    hdr = struct.pack("!BBHH", 0x11, PADR, 0x0000, len(tags))
    return hdr + tags


def parse_tags(payload):
    tags = {}
    off = 0
    while off + 4 <= len(payload):
        ttype, tlen = struct.unpack("!HH", payload[off:off+4])
        if ttype == TAG_EOL:
            break
        if off + 4 + tlen > len(payload):
            break
        tags[ttype] = payload[off+4:off+4+tlen]
        off += 4 + tlen
    return tags


def main():
    sock = socket.socket(socket.AF_PACKET, socket.SOCK_RAW, socket.htons(ETH_P_PPOED))
    sock.bind((IFACE, ETH_P_PPOED))
    sock.settimeout(5.0)

    src_mac = sock.getsockname()[4]
    dst_mac = b"\xff\xff\xff\xff\xff\xff"  # broadcast for PADI

    # Send PADI
    padi = build_padi()
    frame = dst_mac + src_mac + struct.pack("!H", ETH_P_PPOED) + padi
    sock.send(frame)

    # Receive PADO
    pado_frame = sock.recv(1518)
    pado_payload = pado_frame[14:]
    ver_type, code, sid, plen = struct.unpack("!BBHH", pado_payload[:6])
    if code != PADO:
        print(f"ERROR: expected PADO (0x07), got 0x{code:02x}", file=sys.stderr)
        return 1
    tags = parse_tags(pado_payload[6:6+plen])
    if TAG_AC_NAME not in tags:
        print("ERROR: PADO missing AC-Name", file=sys.stderr)
        return 1
    if TAG_AC_COOKIE not in tags:
        print("ERROR: PADO missing AC-Cookie", file=sys.stderr)
        return 1
    ac_name = tags[TAG_AC_NAME].decode()
    print(f"OK: PADO received, AC-Name={ac_name}")

    # Send PADR with valid cookie
    server_mac = pado_frame[6:12]
    padr = build_padr(tags[TAG_AC_COOKIE])
    frame = server_mac + src_mac + struct.pack("!H", ETH_P_PPOED) + padr
    sock.send(frame)

    # Receive PADS
    pads_frame = sock.recv(1518)
    pads_payload = pads_frame[14:]
    ver_type, code, sid, plen = struct.unpack("!BBHH", pads_payload[:6])
    if code != PADS:
        print(f"ERROR: expected PADS (0x65), got 0x{code:02x}", file=sys.stderr)
        return 1
    if sid == 0:
        print("ERROR: PADS session ID is 0", file=sys.stderr)
        return 1
    print(f"OK: PADS received, session-id={sid}")

    # Send PADR with invalid cookie (should be silently dropped)
    bad_padr = build_padr(b"\x00" * 32, host_uniq=b"\x43\x43")
    frame = server_mac + src_mac + struct.pack("!H", ETH_P_PPOED) + bad_padr
    sock.send(frame)
    # Should not get a PADS back for invalid cookie
    try:
        sock.settimeout(0.5)
        resp = sock.recv(1518)
        resp_payload = resp[14:]
        _, resp_code, _, _ = struct.unpack("!BBHH", resp_payload[:6])
        if resp_code == PADS:
            print("ERROR: got PADS for invalid cookie", file=sys.stderr)
            return 1
    except socket.timeout:
        pass  # expected: no response

    print("OK: invalid cookie PADR silently dropped")
    return 0


if __name__ == "__main__":
    sys.exit(main())
EOF_PY

stdin=config:terminator=EOF_CONF
pppoe {
    enabled true
    ac-name ze-test
    interface veth-bng {
    }
}
EOF_CONF

option=env:var=ze.log.pppoe:value=debug
option=env:var=TEST_IFACE:value=veth-sub
option=netns:veth=veth-bng,veth-sub

cmd=background:seq=1:exec=ze -:stdin=config
cmd=foreground:seq=2:exec=python3 pppoe-client.py:timeout=15s
expect=exit:code=0
expect=stdout:contains=OK: PADO received
expect=stdout:contains=OK: PADS received
expect=stdout:contains=OK: invalid cookie PADR silently dropped
