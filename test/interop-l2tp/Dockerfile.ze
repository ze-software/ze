# Ze LNS image for the L2TP PPP/NCP interop lab.
# Privileged container shares the host kernel for PPPoL2TP.
#
# It expects a pre-built linux binary at test/interop-l2tp/ze-linux, which
# `./le integration interop-l2tp` cross-compiles before it builds this image
# (internal/le/interoplab/zebuild.go, StageBinaries, declared by
# internal/le/interoplab/l2tp/l2tp.go, LabBinaries). A bare
# `docker build -f test/interop-l2tp/Dockerfile.ze .` on a clean checkout fails
# at the COPY until that action has run.
#
# The daemon personality (ze_core_dispatch.go, which registers the `start` root
# command the lab launches ze with) and every compile-out-able feature are
# tag-gated, so an untagged build has neither: it answers `start` with "unknown
# command" and would not carry L2TP even if it booted. The producer derives both
# from feature-gates.txt through internal/le/featuretags, so this file names no
# tag and this image cannot drift from the shipped binary's feature set.

FROM alpine:3.21

RUN apk add --no-cache tini iproute2 kmod ppp

COPY test/interop-l2tp/ze-linux /usr/local/bin/ze

ENTRYPOINT ["tini", "--", "ze"]
