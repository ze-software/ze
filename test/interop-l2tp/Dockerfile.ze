# Ze LNS image for L2TP PPP/NCP interop lab.
# Privileged container shares the host kernel for PPPoL2TP.

FROM golang:1.27-alpine AS builder

RUN apk add --no-cache git

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .

# The daemon personality (ze_core_dispatch.go, which registers the `start` root
# command the lab launches ze with) and every compile-out-able feature are
# tag-gated, so an untagged build has neither: it answers `start` with "unknown
# command" and would not carry L2TP even if it booted. Derive the default-on
# tags from feature-gates.txt, the same source consumed by the native build
# adapters and test/interop/Dockerfile.ze, so this image cannot drift
# from the shipped binary's feature set.
RUN ZE_FEATURES="$(awk '$1 ~ /^ze_/ {print $1}' feature-gates.txt | sort -u | tr '\n' ' ')" && \
    CGO_ENABLED=0 go build -tags "ze_core $ZE_FEATURES" -o /ze ./cmd/ze

FROM alpine:3.21

RUN apk add --no-cache tini iproute2 kmod ppp

COPY --from=builder /ze /usr/local/bin/ze

ENTRYPOINT ["tini", "--", "ze"]
