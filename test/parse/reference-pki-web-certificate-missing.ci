# Test: a web certificate naming no pki certificate entry is refused
#
# VALIDATES: the environment web certificate leaf declares
#            ze:reference "pki-certificate" (ze-web-conf.yang), so
#            `ze config validate` refuses a name the candidate's pki section
#            does not define, naming the value, the certificate entries that
#            exist and the leaf, and accepts a defined one. The candidate holds
#            another certificate (lan), so the refusal is the missing name and
#            not an empty store.
# PREVENTS: a typo in the web certificate passing validation and surfacing
#           only when the HTTPS listener looks the name up at start.

stdin=missing:terminator=EOF_MISSING
pki {
	ca web-ca {
		certificate 
	}
	certificate lan {
		certificate 
	}
}

environment {
	web {
		enabled true
		certificate lna
	}
}
EOF_MISSING

stdin=present:terminator=EOF_PRESENT
pki {
	ca web-ca {
		certificate 
	}
	certificate lan {
		certificate 
	}
}

environment {
	web {
		enabled true
		certificate lan
	}
}
EOF_PRESENT

cmd=foreground:seq=1:exec=ze config validate -:stdin=missing
expect=exit:code=1
expect=stdout:contains="lna"
expect=stdout:contains=name one of "lan"
expect=stdout:contains=environment/web/certificate
cmd=foreground:seq=2:exec=ze config validate -:stdin=present
expect=exit:code=0
expect=stdout:contains=configuration valid
