# Test: ze show host cpu returns CPU inventory JSON without a daemon
# VALIDATES: offline fallback -- `show host cpu` falls back to the in-process
#            host.RunShow when no daemon is reachable, producing JSON with the
#            logical-cpus field sourced from /proc/cpuinfo + sysfs on Linux.
# PREVENTS: regressions where show host silently requires a daemon connection,
#           or where the JSON output drops its canonical kebab-case fields.
# PLATFORM: host inventory reads /proc/cpuinfo + sysfs; the darwin
# detector (cpu_other.go) returns ErrUnsupported at build time so the
# underlying feature cannot succeed. Skip on darwin per
# rules/os-specific-tests.md.
option=skip-os:value=darwin
stdin=config:terminator=EOF_CONF
bgp {
	peer p1 {
		connection {
			remote { ip 127.0.0.1; }
			local  { ip 127.0.0.1; }
		}
		session { asn { local 65533; remote 65533; } }
	}
}
EOF_CONF

cmd=foreground:seq=1:exec=ze show host cpu
expect=exit:code=0
expect=stdout:contains="logical-cpus"
expect=stdout:contains="vendor"
expect=stdout:contains="hybrid"
