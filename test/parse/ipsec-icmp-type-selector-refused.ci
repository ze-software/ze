stdin=tcp:terminator=EOF_TCP
vpn {
	ipsec {
		unmatched bypass
		policy icmp-under-tcp {
			action discard
			direction in
			protocol 6
			icmp-type 3
			local {
				prefix 198.18.244.0/24
			}
			remote {
				prefix 198.18.245.0/24
			}
		}
	}
}
EOF_TCP

stdin=port:terminator=EOF_PORT
vpn {
	ipsec {
		unmatched bypass
		policy icmp-with-port {
			action discard
			direction in
			protocol 1
			icmp-type 3
			local {
				prefix 198.18.244.0/24
				port 80
			}
			remote {
				prefix 198.18.245.0/24
			}
		}
