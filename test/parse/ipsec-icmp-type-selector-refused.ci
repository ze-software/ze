}
EOF_PORT

stdin=above:terminator=EOF_ABOVE
vpn {
	ipsec {
		unmatched bypass
		policy icmp-type-above {
			action discard
			direction in
			protocol 1
			icmp-type 256
			local {
				prefix 198.18.244.0/24
			}
			remote {
				prefix 198.18.245.0/24
			}
		}
	}
}
EOF_ABOVE

stdin=codeonly:terminator=EOF_CODEONLY
vpn {
	ipsec {
		unmatched bypass
		policy code-without-type {
			action discard
			direction in
			protocol 1
			icmp-code 0-3
			local {
				prefix 198.18.244.0/24
			}
			remote {
				prefix 198.18.245.0/24
			}
		}
	}
}
EOF_CODEONLY

stdin=reversed:terminator=EOF_REVERSED
vpn {
	ipsec {
		unmatched bypass
		policy code-reversed {
			action discard
			direction in
			protocol 1
			icmp-type 3
			icmp-code 3-0
			local {
				prefix 198.18.244.0/24
			}
			remote {
				prefix 198.18.245.0/24
			}
		}
	}
}
EOF_REVERSED

cmd=foreground:seq=1:exec=ze config validate -:stdin=accepted:exit=0
expect=stdout:contains=configuration valid

cmd=foreground:seq=2:exec=ze config validate -:stdin=tcp:exit=1
expect=stdout:contains=icmp-type and icmp-code need protocol 1 (ICMP) or 58 (ICMPv6), and protocol is 6

cmd=foreground:seq=3:exec=ze config validate -:stdin=port:exit=1
expect=stdout:contains=a port selector needs a protocol that carries ports, and protocol is 1

cmd=foreground:seq=4:exec=ze config validate -:stdin=above:exit=1
expect=stdout:contains=icmp-type
expect=stdout:contains=icmp-type: "256" is not an accepted value

cmd=foreground:seq=5:exec=ze config validate -:stdin=codeonly:exit=1
expect=stdout:contains=icmp-code needs an icmp-type

cmd=foreground:seq=6:exec=ze config validate -:stdin=reversed:exit=1
expect=stdout:contains=starts above its end

cmd=foreground:seq=7:exec=ze config validate -:stdin=spd-v1-on-v6:exit=1
expect=stdout:contains=icmp-type and icmp-code under protocol 1 select ICMP messages
expect=stdout:contains=are IPv6, which carries ICMPv6 as protocol 58

cmd=foreground:seq=8:exec=ze config validate -:stdin=spd-v6-on-v4:exit=1
expect=stdout:contains=icmp-type and icmp-code under protocol 58 select ICMPv6 messages
expect=stdout:contains=are IPv4, which carries ICMP as protocol 1

cmd=foreground:seq=9:exec=ze config validate -:stdin=ts-v1-on-v6:exit=1
expect=stdout:contains=the ICMP type and code in its port select ICMP messages under protocol 1
expect=stdout:contains=local prefix 2001:db8:1::/48 is IPv6, which carries ICMPv6 as protocol 58

cmd=foreground:seq=10:exec=ze config validate -:stdin=ts-v6-on-v4:exit=1
expect=stdout:contains=the ICMP type and code in its port select ICMPv6 messages under protocol 58
expect=stdout:contains=local prefix 10.1.0.0/16 is IPv4, which carries ICMP as protocol 1
