# Test: class-of-service ref with inline qos-map on same unit rejected
# VALIDATES: spec-cos-plugin AC-8 -- mutual exclusion enforced.
# PREVENTS: ambiguous config where both mechanisms set QoS maps.
stdin=config:terminator=EOF_CONF
class-of-service {
	ieee-802.1p residential {
		ingress {
			pcp 0 { priority 0; }
		}
		egress {
			priority 0 { pcp 0; }
		}
	}
}

interface {
	backend netlink;
	ethernet eth0 {
		class-of-service residential;
		unit v100 {
			vlan-id 100;
			ingress-qos-map 6 {
				priority 6;
			}
		}
	}
}
EOF_CONF

cmd=foreground:seq=1:exec=ze config validate -:stdin=config
expect=exit:code=1
