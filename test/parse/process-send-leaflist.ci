# Test: bus endpoint send allow with leaf-list bracket syntax
stdin=config:terminator=EOF_CONF
bus {
	endpoint my-process {
		internal bgp-rib
		encoding json
		send {
			allow [ bgp:update ]
		}
	}
}
bgp {
	router-id 203.0.113.253
	peer peer3 {
		connection {
			remote {
				ip 10.0.0.3
			}
			local {
				ip 10.0.0.2
			}
		}
		session {
			asn {
				local 65533
				remote 65533
			}
		}
	}
}
EOF_CONF

cmd=foreground:seq=1:exec=ze config validate -:stdin=config
expect=exit:code=0
