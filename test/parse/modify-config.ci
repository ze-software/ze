# Test: ze config validate accepts del { med; } and rejects the removed syntax
# VALIDATES: YANG modify schema parses del { med; } correctly
# VALIDATES: Filter chain reference modify:NAME resolves
# PREVENTS: YANG schema or augment regression breaking modify parsing
# PREVENTS: Removed set { med-remove true; } syntax remains accepted
stdin=config:terminator=EOF_CONF
bgp {
	policy {
		modify PREFER-LOCAL {
			set {
				local-preference 200
			}
		}
		modify LOWER-MED {
			set {
				med 50
			}
		}
		modify SET-ORIGIN {
			set {
				origin igp
			}
		}
		modify MULTI {
			set {
				local-preference 300
				med 100
				origin incomplete
				next-hop 10.0.0.1
			}
		}
		# RFC 4271 Section 5.1.4's configured MULTI_EXIT_DISC removal. A
		# definition whose only operation is del { med; } is complete. The
		# schema must accept it beside the MED setter that it conflicts with.
		modify DROP-MED {
			del {
				med
			}
		}
	}

	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
			}
		}
		session {
			asn {
				local 65533
				remote 65533
			}
		}
		filter {
			import [ modify:PREFER-LOCAL ]
		}
	}
}
EOF_CONF

stdin=legacy:terminator=EOF_LEGACY
bgp {
	policy {
		modify DROP-MED {
			set {
				med-remove true
			}
		}
	}
}
EOF_LEGACY

cmd=foreground:seq=1:exec=ze config validate -:stdin=config
expect=exit:code=0
expect=stdout:contains=configuration valid

cmd=foreground:seq=2:exec=ze config validate -:stdin=legacy:exit=1
expect=exit:code=1
expect=stdout:contains=med-remove
