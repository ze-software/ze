# Test: a site-to-site peer naming an ike-group or esp-group no group declares is refused
#
# VALIDATES: the site-to-site peer ike-group and esp-group leaves are YANG
#            leafrefs to "../../../ike-group/name" and "../../../esp-group/name"
#            (ze-ipsec-conf.yang), so `ze config validate` refuses a name no
#            group declares, naming the value, the groups that exist and the
#            leaf, and accepts declared names.
# PREVENTS: a dangling group reaching the IKE engine, which then has no
#           proposals, lifetime or DPD timers for the peer.

stdin=ike:terminator=EOF_IKE
vpn {
	ipsec {
		ike-group IKE-A {
			proposal 1 {
				encryption aes256gcm
				hash sha256
				dh-group 14
			}
		}
		ike-group IKE-B {
			proposal 1 {
				encryption aes256gcm
				hash sha256
				dh-group 14
			}
		}
		esp-group ESP-A {
			proposal 1 {
				encryption aes256gcm
			}
		}
		site-to-site {
			peer branch-1 {
				ike-group IKE-NONE
				esp-group ESP-A
				local-address 127.0.0.1
				remote-address 127.0.0.2
				authentication {
					mode pre-shared-secret
					pre-shared-secret 00ff410a1b2c3d4e5f60718293a4b5c6
					pre-shared-secret-encoding hex
				}
			}
		}
	}
}
EOF_IKE

stdin=esp:terminator=EOF_ESP
vpn {
	ipsec {
		ike-group IKE-A {
			proposal 1 {
				encryption aes256gcm
				hash sha256
				dh-group 14
			}
		}
		ike-group IKE-B {
			proposal 1 {
				encryption aes256gcm
				hash sha256
				dh-group 14
			}
		}
		esp-group ESP-A {
			proposal 1 {
				encryption aes256gcm
			}
		}
		site-to-site {
			peer branch-1 {
				ike-group IKE-A
				esp-group ESP-NONE
				local-address 127.0.0.1
				remote-address 127.0.0.2
				authentication {
					mode pre-shared-secret
					pre-shared-secret 00ff410a1b2c3d4e5f60718293a4b5c6
					pre-shared-secret-encoding hex
				}
			}
		}
	}
}
EOF_ESP

stdin=present:terminator=EOF_PRESENT
vpn {
	ipsec {
		ike-group IKE-A {
			proposal 1 {
				encryption aes256gcm
				hash sha256
				dh-group 14
			}
		}
		ike-group IKE-B {
			proposal 1 {
				encryption aes256gcm
				hash sha256
				dh-group 14
			}
		}
		esp-group ESP-A {
			proposal 1 {
				encryption aes256gcm
			}
		}
		site-to-site {
			peer branch-1 {
				ike-group IKE-B
				esp-group ESP-A
				local-address 127.0.0.1
				remote-address 127.0.0.2
				authentication {
					mode pre-shared-secret
					pre-shared-secret 00ff410a1b2c3d4e5f60718293a4b5c6
					pre-shared-secret-encoding hex
				}
			}
		}
	}
}
EOF_PRESENT

cmd=foreground:seq=1:exec=ze config validate -:stdin=ike
expect=exit:code=1
expect=stdout:contains=no name "IKE-NONE" exists at "../../../ike-group/name"
expect=stdout:contains=name one of "IKE-A IKE-B"
expect=stdout:contains=vpn/ipsec/site-to-site/peer[branch-1]/ike-group
cmd=foreground:seq=2:exec=ze config validate -:stdin=esp
expect=exit:code=1
expect=stdout:contains=no name "ESP-NONE" exists at "../../../esp-group/name"
expect=stdout:contains=name one of "ESP-A"
expect=stdout:contains=vpn/ipsec/site-to-site/peer[branch-1]/esp-group
cmd=foreground:seq=3:exec=ze config validate -:stdin=present
expect=exit:code=0
expect=stdout:contains=configuration valid
