# Test: a peer whose traffic-selector list is not every combination of its local
# and remote selectors is refused at config validate.
# Validates: RFC 7296 Section 3.13 -- "a packet matches a given TSi/TSr if it
# matches at least one of the individual selectors in TSi, and at least one of the
# individual selectors in TSr", so the list (10.1/16, 10.2/16), (10.3/16, 10.4/16)
# would offer 10.1/16 <-> 10.4/16 as well, and such a policy "cannot be negotiated
# as a single Child SA pair".
# Design: docs/architecture/ike/ipsec-8-ikev2-child-xfrm.md.
stdin=config:terminator=EOF_CONF
vpn {
	ipsec {
		esp-group esp-default {
			proposal 1 {
				encryption aes256
				hash sha256
			}
		}
		ike-group ike-default {
			proposal 1 {
				dh-group 14
				encryption aes256
				hash sha256
			}
		}
		site-to-site {
			peer peer-1 {
				ike-group ike-default
				esp-group esp-default
				local-address 10.0.0.1
				remote-address 10.0.0.2
				mode tunnel
				traffic-selector 1 {
					local {
						prefix 10.1.0.0/16
					}
					remote {
						prefix 10.2.0.0/16
					}
				}
				traffic-selector 2 {
					local {
						prefix 10.3.0.0/16
					}
					remote {
						prefix 10.4.0.0/16
					}
				}
				authentication {
					mode pre-shared-secret
					pre-shared-secret test-key-1234
				}
			}
		}
	}
}
EOF_CONF

cmd=foreground:seq=1:exec=ze config validate -:stdin=config
expect=exit:code=1
expect=stdout:contains=never together
