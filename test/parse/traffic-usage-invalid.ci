# Test: traffic-usage rejects an out-of-range interval
# Validates: the YANG range "100..3600000" on interval is enforced (interval 99
#   below the minimum is rejected at config validation).
stdin=config:terminator=EOF_CONF
traffic-usage {
	enabled true
	interfaces {
		interface eth0 {
		}
	}
	interval 99
}
EOF_CONF

cmd=foreground:seq=1:exec=ze config validate -:stdin=config
expect=exit:code=1
