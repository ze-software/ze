# Test: unit with ipv6 { autoconf true } is rejected under backend vpp
# VALIDATES: the commit-time feature gate rejects a unit that enables IPv6
#            stateless autoconfiguration when the active backend is vpp. The
#            leaf carries ze:backend "netlink" in ze-iface-conf.yang, because
#            the kernel learns a SLAAC address only when Router Advertisements
#            reach the device it owns. VPP owns the NIC on the vpp backend and
#            delivers no advertisements to the Linux Control Plane tap, so the
#            sysctl net.ipv6.conf.<device>.autoconf is written and no address
#            is ever learned.
# PREVENTS: a silent-wrong path where the verifier accepts autoconf under
#           backend vpp, the commit succeeds, and the operator waits for an
#           address that no dataplane path can produce.
stdin=config:terminator=EOF_CONF
interface {
	backend vpp;
	ethernet eth0 {
		mac {
			address 02:00:00:00:00:99;
		}
		unit 0 {
			ipv6 {
				autoconf true;
			}
		}
	}
}
EOF_CONF

cmd=foreground:seq=1:exec=ze config validate -:stdin=config:exit=1
expect=exit:code=1
expect=stdout:contains=/interface/ethernet/eth0/unit/0/ipv6/autoconf
expect=stdout:contains="vpp"
expect=stdout:contains=netlink
