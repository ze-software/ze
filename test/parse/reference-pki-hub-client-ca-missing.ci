# Test: a hub client ca naming no pki ca entry is refused
#
# VALIDATES: the plugin hub client ca leaf declares ze:reference "pki-ca"
#            (ze-plugin-conf.yang), so `ze config validate` refuses a CA name
#            the candidate's pki section does not define, naming the value, the
#            ca entries that exist and the leaf, and accepts a defined one. The
#            candidate holds another CA (fleet-root), so the refusal is the
#            missing name and not an empty store.
# PREVENTS: a managed client whose trust anchor names nothing, which validates
#           and then leaves the client unable to verify its hub.

stdin=missing:terminator=EOF_MISSING
pki {
	ca fleet-root {
		certificate 
	}
}

plugin {
	hub {
		client edge-01 {
			host 127.0.0.1
			port 1790
			secret edge01-secret-that-is-at-least-32ch
			ca fleet-rot
		}
	}
}
EOF_MISSING

stdin=present:terminator=EOF_PRESENT
pki {
	ca fleet-root {
		certificate 
	}
}

plugin {
	hub {
		client edge-01 {
			host 127.0.0.1
			port 1790
			secret edge01-secret-that-is-at-least-32ch
			ca fleet-root
		}
	}
}
EOF_PRESENT

cmd=foreground:seq=1:exec=ze config validate -:stdin=missing
expect=exit:code=1
expect=stdout:contains="fleet-rot"
expect=stdout:contains=name one of "fleet-root"
expect=stdout:contains=client[edge-01]/ca
cmd=foreground:seq=2:exec=ze config validate -:stdin=present
expect=exit:code=0
expect=stdout:contains=configuration valid
