# Test: interface backend vpp refuses vpn ipsec.
# Question: does `ze config validate` refuse `vpn ipsec` under `interface
#           backend vpp`, naming `vpn ipsec`, explaining it programs kernel
#           XFRM only, and giving `set interface backend kernel`?
#           A unit test cannot prove the IKE engine's real registration reaches
#           `ze config validate` through the composition root.
# VALIDATES: spec-dataplane-compatibility-guard AC-5 (IPsec) -- kernel-only
#            IPsec is refused under VPP at validate, commit, reload and start.
# PREVENTS: IPsec tunnels programming kernel XFRM while VPP forwards traffic
#           around them in clear text.
stdin=config:terminator=EOF_CONF
interface {
	backend vpp;
}
vpn {
	ipsec {
		ike-group IKE-VPP {
			proposal 1 {
				encryption aes256gcm;
				hash sha256;
				dh-group 14;
			}
		}
		esp-group ESP-VPP {
			proposal 1 {
				encryption aes256gcm;
			}
		}
		site-to-site {
			peer branch-1 {
				ike-group IKE-VPP;
				esp-group ESP-VPP;
				local-address 127.0.0.1;
				remote-address 127.0.0.2;
				authentication {
					mode pre-shared-secret;
					pre-shared-secret 00ff410a1b2c3d4e5f60718293a4b5c6;
					pre-shared-secret-encoding hex;
				}
			}
		}
	}
}
EOF_CONF

cmd=foreground:seq=1:exec=ze config validate -:stdin=config
expect=exit:code=1
expect=stdout:contains=vpn ipsec
expect=stdout:contains=XFRM
expect=stdout:contains=set interface backend kernel
