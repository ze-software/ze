# Test: an accounting-port outside 1..65535 is refused.
# VALIDATES: spec-radius-rfc-defects Q-8 -- the accounting-port leaf carries the
#            zt:port range, so port 0 never reaches the accounting socket.
# PREVENTS:  an Accounting-Request addressed to UDP port 0.

stdin=config:terminator=EOF_CONF
l2tp {
    enabled true;
    auth {
        radius {
            server main {
                address 127.0.0.1;
                accounting-port 0;
                shared-key testing123;
            }
        }
    }
}
EOF_CONF

cmd=foreground:seq=1:exec=ze config validate -:stdin=config
expect=exit:code=1
expect=stdout:contains=l2tp auth radius server main accounting-port: "0" is outside the accepted range
expect=stdout:contains=accounting-port accepts a value in 1..65535
expect=stdout:contains=fix: accounting-port <1..65535>;
reject=stdout:pattern=outside range
