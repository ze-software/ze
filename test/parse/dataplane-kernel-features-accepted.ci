# Test: kernel-plane features validate together under interface backend kernel.
# Question: does `ze config validate` accept kernel firewall, kernel traffic
#           control, fib kernel, IPsec, L2TP listener, flow-export sampling and
#           conntrack, policy routing, CoPP, and BGP GTSM together under
#           `interface backend kernel`?
#           A unit test cannot prove all real registrations agree under the
#           `kernel` data plane across the full YANG schema in `ze config
#           validate`.
# VALIDATES: spec-dataplane-compatibility-guard AC-3 and AC-5 survivors --
#            every kernel-only feature stays accepted when `interface backend`
#            is `kernel`.
# PREVENTS: the data-plane guard falsely rejecting valid kernel configurations.
stdin=config:terminator=EOF_CONF
interface {
	backend kernel;
}
fib {
	kernel {
	}
}
firewall {
	backend kernel;
	table wan {
		family inet;
		chain input {
			type filter;
			hook input;
			priority 0;
			policy accept;
			term allow-ssh {
				from {
					protocol tcp;
					destination-port 22;
				}
				then {
					accept;
				}
			}
		}
	}
}
traffic {
	control {
		backend kernel;
		interface eth0 {
			qdisc {
				type htb;
				class control {
					rate 10mbit;
					ceil 100mbit;
				}
			}
		}
	}
}
control-plane-protection {
	bgp {
		rate 100/second;
	}
}
vpn {
	ipsec {
		ike-group IKE-KERN {
			proposal 1 {
				encryption aes256gcm;
				hash sha256;
				dh-group 14;
			}
		}
		esp-group ESP-KERN {
			proposal 1 {
				encryption aes256gcm;
			}
		}
		site-to-site {
			peer branch-1 {
				ike-group IKE-KERN;
				esp-group ESP-KERN;
				local-address 127.0.0.1;
				remote-address 127.0.0.2;
				authentication {
					mode pre-shared-secret;
					pre-shared-secret 00ff410a1b2c3d4e5f60718293a4b5c6;
					pre-shared-secret-encoding hex;
				}
			}
		}
	}
}
l2tp {
	enabled true;
}
environment {
	l2tp {
		server main {
			ip 127.0.0.1;
			port 1701;
		}
	}
}
flow-export {
	collector sflow1 {
		address 10.0.0.50;
		port 6343;
		protocol sflow;
		agent-address 127.0.0.1;
	}
	sampling {
		interface eth0 {
			rate 1000;
		}
	}
	conntrack {
		enabled true;
	}
}
policy {
	route R {
		interface "eth*";
		rule block-quic {
			from {
				destination-port 443;
				protocol udp;
			}
			then {
				drop;
			}
		}
	}
}
bgp {
	router-id 203.0.113.1;
	peer peer1 {
		connection {
			remote { ip 127.0.0.1; }
			local { ip 127.0.0.1; }
			ttl { max 1; }
		}
		session {
			asn { local 65533; remote 65534; }
		}
	}
}
EOF_CONF

cmd=foreground:seq=1:exec=ze config validate -:stdin=config
expect=exit:code=0
expect=stdout:contains=configuration valid
