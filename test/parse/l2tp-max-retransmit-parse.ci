# Test: ze config validate accepts the L2TP max-retransmit leaf
# VALIDATES: RFC 2661 Section 5.8 -- the retransmit count before a tunnel is
#            cleared is configurable under the root l2tp{} block.
stdin=config:terminator=EOF_CONF
l2tp {
	enabled true
	max-retransmit 8
}
environment {
	l2tp {
		server main {
			ip 127.0.0.1
			port 1701
		}
	}
}
EOF_CONF

cmd=foreground:seq=1:exec=ze config validate -:stdin=config
expect=exit:code=0
expect=stdout:contains=configuration valid
