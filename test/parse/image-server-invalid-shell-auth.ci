# Test: image-server rejects a malformed shell-auth-sha256.
# VALIDATES: image-server config validation requires shell-auth-sha256 to be a
# 64-char lowercase hex sha256 (the installer compares a typed password's
# sha256sum against it; a malformed value would silently lock out the rescue
# shell rather than gate it).
# PREVENTS: emitting ze.shell-auth=<garbage> on the installer kernel cmdline.

stdin=config:terminator=EOF_CONF
service {
    image-server {
        enabled true
        image-directory /var/lib/images
        shell-auth-sha256 "tooshort"
    }
}
EOF_CONF

cmd=foreground:seq=1:exec=ze config validate -:stdin=config
expect=exit:code=1
expect=stdout:contains=shell-auth-sha256 must be 64 lowercase hex characters
