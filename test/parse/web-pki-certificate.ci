# A pki block plus environment.web.certificate referencing one of its entries
# parses and validates. spec-pki-full-chain AC-1: the web HTTPS listener can be
# pointed at an operator certificate held in the PKI store.
stdin=config:terminator=EOF_CONF
pki {
	ca web-ca {
		certificate 
	}
	certificate lan {
		certificate 
		private {
			key MHcCAQEEIJWSrBva0yYuEY9NyV6LSqFoZ4eRNSoFUCZj9KdmaPuioAoGCCqGSM49AwEHoUQDQgAE9ujhR+AuyNpjClq9wS3fPg4sLDh2JYdiXLRih2EDVDNJAhFQEQ6RbqhwdSMnZUmPBBuoNbt1T6U+jcrRyF0VhA==
		}
	}
}

environment {
	web {
		enabled true
		certificate lan
	}
}
EOF_CONF

cmd=foreground:seq=1:exec=ze config validate -:stdin=config
expect=exit:code=0
