# Test: a netlink-only tunnel kind is rejected under backend vpp
# VALIDATES: spec-followup-vpp-iface AC-2/R-2 -- after per-kind ze:backend
#            widening (gre/gretap/ipip/vxlan gained "vpp"), the kinds with no
#            proven VPP mapping (sit, ip6tnl, ...) stay netlink-only and are
#            still rejected at commit under the vpp backend, naming the
#            /interface/tunnel YANG path.
# PREVENTS: a list-wide widening that would let vpp receive an Apply call for
#           a tunnel kind ifacevpp.CreateTunnel cannot program (sit lands on
#           the exact-or-reject default).
stdin=config:terminator=EOF_CONF
interface {
	backend vpp;
	tunnel t0 {
		encapsulation {
			sit {
				local { ip 192.0.2.1; }
				remote { ip 198.51.100.1; }
			}
		}
	}
}
EOF_CONF

cmd=foreground:seq=1:exec=ze config validate -:stdin=config
expect=exit:code=1
expect=stdout:contains=/interface/tunnel
expect=stdout:contains="vpp"
