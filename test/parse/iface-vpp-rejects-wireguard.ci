# Test: wireguard is accepted under backend vpp
# // spec-followup-vpp-iface Phase 5 IMPLEMENTS wireguard on the
#   vpp backend (wireguard_interface_create + wireguard_peer_add via the
#   wireguard plugin binary API), so the ze:backend annotation widened from
#   "netlink" to "netlink vpp". The old assertion (reject wireguard under vpp)
#   tested a now-removed limitation; this is replaced coverage. Filename kept
#   for git history.
# VALIDATES: spec-followup-vpp-iface AC-5 -- the commit-time feature gate
#            accepts a wireguard list entry under the vpp backend after the
#            widening. Plugin load is via vpp.plugins.wireguard; a doctor check
#            flags the plugin's runtime absence.
# PREVENTS: a regression that reverts the widening.
stdin=config:terminator=EOF_CONF
interface {
	backend vpp;
	wireguard wg0 {
		listen-port 51820;
		private-key "aHZkc2ZqaHZra2hkZnZoamtkc2Zoa2RoaGRma2poZmg=";
	}
}
EOF_CONF

cmd=foreground:seq=1:exec=ze config validate -:stdin=config
expect=exit:code=0
expect=stdout:contains=configuration valid
