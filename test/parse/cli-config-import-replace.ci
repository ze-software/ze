# Test: ze config import --yes replaces an existing config.
# VALIDATES: importing onto a name the store already holds with --yes commits
#            the imported config, so `ze config cat` answers the new content
#            (cmd_import.go, importOne).
# PREVENTS: a confirmed replace that the stored config does not reflect.
# ISOLATION: the destination is the per-test working directory.
tmpfs=small.conf:terminator=EOF_FILE
system {
	host importhost
}
EOF_FILE

tmpfs=replacement.conf:terminator=EOF_REPLACEMENT
system {
	host replacedhost
}
EOF_REPLACEMENT

option=env:var=ze.config.dir:value=.

cmd=foreground:seq=1:exec=le test fixture storage/empty-tree:exit=0
cmd=foreground:seq=2:exec=ze config import small.conf:exit=0
cmd=foreground:seq=3:exec=ze config import --yes --name small.conf replacement.conf:exit=0
cmd=foreground:seq=4:exec=ze config cat small.conf:exit=0
expect=exit:code=0
expect=stdout:contains=host replacedhost
reject=stdout:contains=host importhost
