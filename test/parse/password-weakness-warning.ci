# Test: setting a weak password warns and still sets it; a strong one is silent.
# VALIDATES: AC-1, AC-2, AC-3, AC-4 and AC-7 -- the weakness policy is advisory
# at both password-set surfaces (`ze config set` and `ze passwd`).
# PREVENTS: the warning becoming a rejection (a config ze accepted yesterday
# would stop committing), and the warning being swallowed at the commit path,
# which would leave an operator with no sign that ze judged the password weak.

stdin=config:terminator=EOF_STDIN
bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
			}
		}
		session {
			asn {
				local 65533
				remote 65533
			}
		}
	}
}
EOF_STDIN

tmpfs=test.conf:terminator=EOF_CONF
bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
			}
		}
		session {
			asn {
				local 65533
				remote 65533
			}
		}
	}
}

system {
	authentication {
		user alice {
		}
		user bob {
		}
		user carol {
		}
	}
}
EOF_CONF

stdin=weak:terminator=EOF_WEAK
qwerty
EOF_WEAK

option=env:var=ze.storage.blob:value=false

# A password under the minimum length: warned about, and set anyway.
cmd=foreground:seq=1:exec=ze config set test.conf system authentication user alice plaintext-password "secret"
expect=exit:code=0
expect=stderr:contains=warning: system.authentication.user.alice.password: weak password (shorter than 8 characters)

# The password IS set: the file holds a bcrypt hash and no plaintext leaf.
cmd=foreground:seq=2:exec=cat test.conf
expect=exit:code=0
expect=stdout:contains=$2a$10$
reject=stdout:contains=plaintext-password

# A denylisted password, in a case the list does not spell: warned about too.
cmd=foreground:seq=3:exec=ze config set test.conf system authentication user bob plaintext-password "LetMeIn"
expect=exit:code=0
expect=stderr:contains=warning: system.authentication.user.bob.password: weak password (one of the most common passwords)

# A strong password: the set line is printed and no warning is.
cmd=foreground:seq=4:exec=ze config set test.conf system authentication user carol plaintext-password "correct horse battery staple"
expect=exit:code=0
expect=stderr:contains=set system authentication user carol plaintext-password
reject=stderr:pattern=weak password

# `ze passwd` warns on stderr and still prints the hash on stdout.
cmd=foreground:seq=5:exec=ze passwd:stdin=weak
expect=exit:code=0
expect=stdout:contains=$2a$10$
expect=stderr:contains=warning: weak password (one of the most common passwords)
