# Test: a site-to-site eap-tls peer whose ca-certificate names no pki ca entry is refused
#
# VALIDATES: the site-to-site authentication ca-certificate leaf declares
#            ze:reference "pki-ca" (ze-ipsec-conf.yang), so `ze config validate`
#            refuses an eap-tls peer naming a CA the candidate's pki section does
#            not define, naming the value, the ca entries that exist and the
#            leaf, while the same peer naming a defined CA is accepted.
#            The candidate holds another CA (vpn-ca) and the peer's certificate,
#            so the refusal is the missing name and not an empty store.
# PREVENTS: a typo in ca-certificate reaching the IKE engine, where the CA
#           lookup returns nil and the peer has no trust anchor (RFC 5216
#           Section 5.3 path validation). Replaces the unit proofs
#           TestValidatePKIRefsRejectsUnknownCAForEAPTLS and the nowhere-ca half
#           of TestValidateIPsecSectionsResolvesAgainstCandidatePKI.

stdin=missing:terminator=EOF_MISSING
pki {
	ca vpn-ca {
		certificate 
	}
	certificate server1 {
		certificate 
	}
}

vpn {
	ipsec {
		ike-group IKE-A {
			proposal 1 {
				encryption aes256gcm
				hash sha256
				dh-group 14
			}
		}
		esp-group ESP-A {
			proposal 1 {
				encryption aes256gcm
			}
		}
		site-to-site {
			peer branch-1 {
				ike-group IKE-A
				esp-group ESP-A
				local-address 127.0.0.1
				remote-address 127.0.0.2
				authentication {
					mode eap-tls
					ca-certificate nowhere-ca
					certificate server1
				}
			}
		}
	}
}
EOF_MISSING

stdin=present:terminator=EOF_PRESENT
pki {
	ca vpn-ca {
		certificate 
	}
	certificate server1 {
		certificate 
	}
}

vpn {
	ipsec {
		ike-group IKE-A {
			proposal 1 {
				encryption aes256gcm
				hash sha256
				dh-group 14
			}
		}
		esp-group ESP-A {
			proposal 1 {
				encryption aes256gcm
			}
		}
		site-to-site {
			peer branch-1 {
				ike-group IKE-A
				esp-group ESP-A
				local-address 127.0.0.1
				remote-address 127.0.0.2
				authentication {
					mode eap-tls
					ca-certificate vpn-ca
					certificate server1
				}
			}
		}
	}
}
EOF_PRESENT

cmd=foreground:seq=1:exec=ze config validate -:stdin=missing
expect=exit:code=1
expect=stdout:contains=nowhere-ca
expect=stdout:contains=name one of "vpn-ca"
expect=stdout:contains=vpn/ipsec/site-to-site/peer[branch-1]/authentication/ca-certificate
cmd=foreground:seq=2:exec=ze config validate -:stdin=present
expect=exit:code=0
expect=stdout:contains=configuration valid
