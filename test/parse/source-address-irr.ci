# Test: system irr with a source-address parses successfully
# VALIDATES: the irr owner's system irr container accepts server and
#            source-address beside a BGP config
# PREVENTS: ze-irr-conf.yang losing source-address, the leaf the owner binds
#           its whois connections to

stdin=config:terminator=EOF_CONF
system {
    irr {
        server whois.radb.net;
        source-address 198.51.100.1;
    }
}

bgp {
    filter {
        import { final accept; }
        export { final accept; }
    }
    router-id 198.51.100.1
    peer test {
        connection {
            remote { ip 192.0.2.2; }
            local { ip 192.0.2.1; }
        }
        session {
            asn { local 65000; remote 65100; }
            router-id 198.51.100.1
        }
    }
}
EOF_CONF

cmd=foreground:seq=1:exec=ze config validate -:stdin=config
expect=exit:code=0
expect=stdout:contains=configuration valid
