# The pppoe-client key is the kernel device name: Ze creates the PPP session
# device under it (RTM_NEWLINK kind ppp), and the kernel limits an interface
# name to 15 octets (IFNAMSIZ 16 with the NUL). The YANG leaf carries
# `length "1..15"` and the ifname pattern (ze-iface-conf.yang, pppoe-client
# name), so the parser refuses the key before any dial meets the kernel.
#
# VALIDATES: AC-6 -- a 16-octet key and a key with a slash are refused by
#            `ze config validate`, the first naming the 1..15 limit
#            (validateLengths, internal/component/config/schema.go) and the
#            second the pattern; a 15-octet key validates, so the bound is
#            proven on both sides rather than by a schema refusing everything.
# PREVENTS: a name the kernel refuses at RTM_NEWLINK reaching the dialer, which
#           would fail every session with no config-time diagnostic.
# PLATFORM: pppoe-client is ze:os "linux"; skip on darwin.
option=skip-os:value=darwin

stdin=atlimit:terminator=EOF_LIMIT
interface {
    backend netlink
    ethernet eth2 {
        mac {
            address 60:be:b4:20:70:6e
        }
    }
    pppoe-client pppoe-012345678 {
        source-interface eth2
        authentication {
            username user@example.net
            password secret123
        }
    }
}
EOF_LIMIT

stdin=toolong:terminator=EOF_LONG
interface {
    backend netlink
    ethernet eth2 {
        mac {
            address 60:be:b4:20:70:6e
        }
    }
    pppoe-client pppoe-0123456789 {
        source-interface eth2
        authentication {
            username user@example.net
            password secret123
        }
    }
}
EOF_LONG

stdin=slash:terminator=EOF_SLASH
interface {
    backend netlink
    ethernet eth2 {
        mac {
            address 60:be:b4:20:70:6e
        }
    }
    pppoe-client pppoe/0 {
        source-interface eth2
        authentication {
            username user@example.net
            password secret123
        }
    }
}
EOF_SLASH

cmd=foreground:seq=1:exec=ze config validate -:stdin=atlimit
expect=exit:code=0
expect=stdout:contains=configuration valid
cmd=foreground:seq=2:exec=ze config validate -:stdin=toolong
expect=exit:code=1
expect=stdout:contains=invalid key for pppoe-client: value length 16 is outside allowed length 1..15; write a value of 1..15 characters
cmd=foreground:seq=3:exec=ze config validate -:stdin=slash
expect=exit:code=1
expect=stdout:contains=invalid key for pppoe-client: value "pppoe/0" does not match pattern
