		session {
			asn {
				local 65000
				remote 65001
			}
			family {
				ipv4/unicast {
					prefix {
						maximum 1000
					}
				}
			}
			capability {
				add-path {
					direction send/receive
					limit {
						receive 0
					}
				}
			}
		}
	}
}
EOF_ZERO

stdin=above:terminator=EOF_ABOVE
bgp {
	router-id 203.0.113.253
	peer test-peer {
		connection {
			remote {
				ip 192.0.2.1
			}
			local {
				ip auto
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			family {
				ipv4/unicast {
					prefix {
						maximum 1000
					}
				}
			}
			capability {
				add-path {
					direction send/receive
					family {
						ipv4/unicast {
							limit {
								receive 65536
							}
						}
					}
				}
			}
		}
