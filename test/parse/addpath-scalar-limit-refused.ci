}
EOF_ABOVE

stdin=container:terminator=EOF_CONTAINER
bgp {
	router-id 203.0.113.253
	peer test-peer {
		connection {
			remote {
				ip 192.0.2.1
			}
			local {
				ip auto
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			family {
				ipv4/unicast {
					prefix {
						maximum 1000
					}
				}
			}
			capability {
				add-path {
					direction send/receive
					limit {
						receive 65535
					}
					family {
						ipv4/unicast {
							limit {
								receive 1
							}
						}
					}
				}
			}
		}
	}
}
EOF_CONTAINER

cmd=foreground:seq=1:exec=ze config validate -:stdin=scalar
expect=exit:code=1
# The needles carry no ':' because the directive splits on it.
expect=stdout:contains=expected '{' after limit
expect=stdout:contains=limit { receive VALUE; }
cmd=foreground:seq=2:exec=ze config validate -:stdin=familyscalar
expect=exit:code=1
expect=stdout:contains=expected '{' after limit
expect=stdout:contains=limit { receive VALUE; }
cmd=foreground:seq=3:exec=ze config validate -:stdin=zero
expect=exit:code=1
expect=stdout:contains=receive
cmd=foreground:seq=4:exec=ze config validate -:stdin=above
expect=exit:code=1
expect=stdout:contains=receive
cmd=foreground:seq=5:exec=ze config validate -:stdin=container
expect=exit:code=0
