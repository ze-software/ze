# Test: traffic mirror is accepted under backend vpp
# VALIDATES: spec-followup-vpp-iface AC-4 -- the mirror container's ze:backend
#            widening to "netlink vpp" lets the vpp backend accept a mirror
#            config at commit time; the vpp backend programs it via SPAN
#            (sw_interface_span_enable_disable).
# PREVENTS: a mirror-under-vpp config being rejected at commit after the SPAN
#           wiring landed, or a regression that reverts the widening.
# PLATFORM: the mirror container carries ze:os "linux" so the schema walker
#           prunes it on other platforms (yang_schema.go getOSExtension); this
#           test is linux-only, matching sibling iface-vpp-rejects-dhcp.
option=skip-os:value=darwin
stdin=config:terminator=EOF_CONF
interface {
	backend vpp;
	ethernet eth0 {
		unit u0 {
			mirror {
				ingress eth1;
			}
		}
	}
}
EOF_CONF

cmd=foreground:seq=1:exec=ze config validate -:stdin=config
expect=exit:code=0
expect=stdout:contains=configuration valid
