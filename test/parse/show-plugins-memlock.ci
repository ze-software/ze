# Test: the memlock plugin's own row carries the outcome its init() recorded
#
# VALIDATES: AC-1 and AC-2 for the one plugin that records. memlock's row
#   carries a real outcome rather than unknown, because its init() calls
#   RecordSetup before main().
# PREVENTS: recording that stops happening while the list keeps rendering.
#   `show plugins` would still answer, every row would read unknown, and no
#   assertion over the list alone can tell that apart from a plugin set that
#   simply records nothing.
#
# PLATFORM: memlock is linux-only. register.go and memlock_linux.go both carry
# `//go:build linux`, and the platform-neutral memlock.go declares no init(),
# so on darwin the plugin never registers and `show plugins` has no memlock
# row. The assertion would fail rather than skip. Skip on darwin per
# rules/os-specific-tests.md.
option=skip-os:value=darwin
stdin=config:terminator=EOF_CONF
# The runner requires a config on stdin. This command reads none.
bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
			}
		}
		session {
			asn {
				local 65533
				remote 65533
			}
		}
	}
}
EOF_CONF

# The three renderings the split moved out of show-plugins.ci, verbatim. The
# json assertion keeps its quotes: expect=stdout:contains= takes the literal
# rest of the line, so `"memlock"` and `memlock` are different assertions and
# only the quoted one proves the name is a JSON string value.
cmd=foreground:seq=1:exec=ze cli -c "show plugins | json":exit=0
expect=exit:code=0
expect=stdout:contains="memlock"
expect=stdout:contains="outcome"

cmd=foreground:seq=2:exec=ze cli -c "show plugins | yaml":exit=0
expect=exit:code=0
expect=stdout:contains=memlock
expect=stdout:contains=outcome

cmd=foreground:seq=3:exec=ze cli -c "show plugins | table":exit=0
expect=exit:code=0
expect=stdout:contains=memlock
expect=stdout:contains=outcome

# memlock records from its own init(), so its row is never unknown. This is the
# assertion that reds the moment recording stops while the list keeps rendering.
cmd=foreground:seq=4:exec=ze cli -c "show plugins | match memlock | json":exit=0
expect=exit:code=0
expect=stdout:contains=memlock
expect=stdout:contains=outcome
expect=stdout:not:contains=unknown
expect=stdout:not:contains="invalid"
