# Invalid config: graceful-restart requires an endpoint permitted to send bgp:update or bgp:raw
stdin=config:terminator=EOF_CONF
bgp {
	peer peer1 {
		connection {
			remote {
				ip 10.0.0.1
			}
			local {
				ip 192.0.2.1
			}
		}
		session {
			asn {
				local 65001
				remote 65002
			}
			router-id 1.2.3.4
			capability {
				graceful-restart { short-lived { restart-time 120; } }
			}
		}
		bus {
			receive {
				from none;
			}
		}
	}
}
EOF_CONF

cmd=foreground:seq=1:exec=ze config validate -:stdin=config
expect=exit:code=1
expect=stdout:contains=graceful-restart requires an endpoint permitted to send bgp:update or bgp:raw
