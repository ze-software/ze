# Test: every numeric bound of `service dns-resolver` refuses the first value
#       past it and accepts the last value inside it, through `ze config
#       validate`, the operator's own pre-commit check.
# Spec: plan/post-release/features/spec-lan-dns-resolver.md -- Boundary Tests
# VALIDATES: the YANG ranges of yang/ze-dns-resolver-conf.yang (cache size,
#            max-ttl, max-negative-ttl, timeout, limit outstanding,
#            per-client-rate, forward server max-elements) and the plugin's
#            own refusal of listener port 0 (parseListener, run by the
#            in-process config verifier). Each refusal names its leaf.
# PREVENTS: a widened or dropped range that lets a value the resolver cannot
#           honor reach the running config.
# DISCRIMINATION: the timeout range widened to 1..61 in the YANG goes red at
# seq 7 (timeout 61 accepted, exit 0).
# The accepted cases run last, so a refusal that widens into "every config
# rejected" fails the test.

stdin=port-0:terminator=EOF_port_0
service {
	dns-resolver {
		enabled true
		listener lan {
			ip 127.0.0.1
			port 0
		}
		allow-from 10.0.0.0/8
		cache {
			size 1000
			max-ttl 300
			max-negative-ttl 300
		}
		timeout 5
		limit {
			outstanding 1000
			per-client-rate 100
		}
		forward {
			server 192.0.2.1 {
				port 53
			}
		}
	}
}
EOF_port_0

