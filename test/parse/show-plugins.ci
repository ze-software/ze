# Test: show plugins carries the setup outcome each plugin recorded
#
# VALIDATES: AC-1, AC-2, AC-4 and AC-7. Every registered plugin is listed, a
#   plugin that recorded nothing is listed as unknown rather than dropped, and
#   `| json`, `| yaml` and `| table` each render the same rows.
# PREVENTS: a feature that is absent for an environment reason with nowhere to
#   say so. Before the outcome joined these rows, a plugin whose setup failed
#   was invisible: it left no row anywhere, and absence reads as "not built
#   into this binary".
#
# No daemon runs here. The outcomes are recorded by plugin init() functions
# before main(), so any ze process answers, and `ze cli -c` serves the command
# in its own process before it asks for credentials.
#
# Every row asserted here is one that each platform has. memlock is the plugin
# that RECORDS an outcome, and it is linux-only (`//go:build linux` on
# register.go), so on darwin it never registers and has no row at all. Its
# assertions are in show-plugins-memlock.ci, which carries the skip.
#
# The suite is `parse` rather than `ui` or `plugin` because only this suite's
# parser splits an exec line on quotes (splitCommand, internal/test/runner/
# parsing.go). The other suites use strings.Fields, which tears
# `-c "show plugins | json"` into five arguments.

stdin=config:terminator=EOF_CONF
# The runner requires a config on stdin. This command reads none.
bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
			}
		}
		session {
			asn {
				local 65533
				remote 65533
			}
		}
	}
}
EOF_CONF

cmd=foreground:seq=1:exec=ze cli -c "show plugins | json":exit=0
expect=exit:code=0
expect=stdout:contains="name"
expect=stdout:contains="outcome"
expect=stdout:contains="routing-table"
expect=stdout:contains="unknown"
expect=stdout:not:contains="invalid"

cmd=foreground:seq=2:exec=ze cli -c "show plugins | yaml":exit=0
expect=exit:code=0
expect=stdout:contains=outcome
expect=stdout:contains=routing-table
expect=stdout:contains=unknown

cmd=foreground:seq=3:exec=ze cli -c "show plugins | table":exit=0
expect=exit:code=0
expect=stdout:contains=outcome
expect=stdout:contains=routing-table
