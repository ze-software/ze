# Test: ze config validate REFUSES a redistribute source no plugin registers
# The scalar form `import rip;` reaches ExtractRedistributeRules
# (internal/component/config/loader_redistribute.go), which looks every source
# up in the registry the plugins fill. rip is not a protocol ze implements, so
# no plugin registers it and the lookup misses.
# The refusal names the source and the destination, so an operator learns at
# validate time rather than at daemon startup.
# VALIDATES: AC-4 -- a redistribute source outside the registry is refused by name
stdin=config:terminator=EOF_CONF
bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
			}
		}
		session {
			asn {
				local 65533
				remote 65533
			}
		}
	}
}

redistribute {
	destination bgp {
		import rip;
	}
}
EOF_CONF

cmd=foreground:seq=1:exec=ze config validate -:stdin=config
expect=exit:code=1
expect=stdout:contains=redistribute: unknown source "rip" under destination "bgp"
