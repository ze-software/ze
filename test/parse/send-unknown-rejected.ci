# Test: unknown bus message rejected in send allow when no plugin registers it
# VALIDATES: AC-2: Unregistered bus message names rejected at config validation time
stdin=config:terminator=EOF_CONF
bus {
	endpoint my-process {
		internal bgp-rib
		encoding json
		send {
			allow [ bgp:unknown-send-type ]
		}
	}
}
bgp {
	router-id 203.0.113.253
	peer peer1 {
		connection {
			remote {
				ip 10.0.0.1
			}
			local {
				ip 10.0.0.2
			}
		}
		session {
			asn {
				local 65001
				remote 65001
			}
		}
	}
}
EOF_CONF

cmd=foreground:seq=1:exec=ze config validate -:stdin=config
expect=exit:code=1
expect=stdout:contains=unknown-send-type
