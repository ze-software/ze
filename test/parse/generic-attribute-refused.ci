cmd=foreground:seq=1:exec=ze config validate -:stdin=flags
expect=exit:code=1
expect=stdout:contains=clear the Optional bit
cmd=foreground:seq=2:exec=ze config validate -:stdin=twowords
expect=exit:code=1
expect=stdout:contains=it needs three
cmd=foreground:seq=3:exec=ze config validate -:stdin=noprefix
expect=exit:code=1
expect=stdout:contains=is not hexadecimal
cmd=foreground:seq=4:exec=ze config validate -:stdin=nexthop
expect=exit:code=1
expect=stdout:contains=NEXT_HOP, which Ze writes from next-hop
cmd=foreground:seq=5:exec=ze config validate -:stdin=mpreach
expect=exit:code=1
expect=stdout:contains=MP_REACH_NLRI, which Ze builds
cmd=foreground:seq=6:exec=ze config validate -:stdin=mpunreach
expect=exit:code=1
expect=stdout:contains=MP_UNREACH_NLRI, which Ze builds
cmd=foreground:seq=7:exec=ze config validate -:stdin=as4path
expect=exit:code=1
expect=stdout:contains=AS4_PATH, which Ze builds
cmd=foreground:seq=8:exec=ze config validate -:stdin=as4aggregator
expect=exit:code=1
expect=stdout:contains=AS4_AGGREGATOR, which Ze builds
cmd=foreground:seq=9:exec=ze config validate -:stdin=medshort
expect=exit:code=1
expect=stdout:contains=is malformed
cmd=foreground:seq=10:exec=ze config validate -:stdin=medgood
expect=exit:code=0
