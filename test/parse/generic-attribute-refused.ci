				remote 65001
			}
		}
		update {
			attribute {
				origin igp
				next-hop 192.0.2.254
				attribute "0x99 0xc0"
			}
			nlri {
				ipv4/unicast add 10.0.1.0/24
			}
		}
	}
}
EOF_TWOWORDS
