# Test: unit with ipv6 { accept-ra 2 } is rejected under backend vpp
# VALIDATES: the commit-time feature gate rejects a unit that accepts Router
#            Advertisements when the active backend is vpp. accept-ra and
#            autoconf describe one behavior, so the leaf carries the same
#            ze:backend "netlink" as its neighbor. The kernel accepts
#            advertisements only on a device that receives them, and VPP
#            delivers none to the Linux Control Plane tap.
# PREVENTS: a config that gates autoconf but leaves accept-ra open, which
#           would let the operator set the receiving half of one behavior on
#           a backend that carries neither half.
stdin=config:terminator=EOF_CONF
interface {
	backend vpp;
	ethernet eth0 {
		mac {
			address 02:00:00:00:00:99;
		}
		unit 0 {
			ipv6 {
				accept-ra 2;
			}
		}
	}
}
EOF_CONF

cmd=foreground:seq=1:exec=ze config validate -:stdin=config:exit=1
expect=exit:code=1
expect=stdout:contains=/interface/ethernet/eth0/unit/0/ipv6/accept-ra
expect=stdout:contains="vpp"
expect=stdout:contains=netlink
