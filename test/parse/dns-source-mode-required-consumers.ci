# Test: DNS source validation refuses ambiguous or inapplicable sources
# and accepts the explicitly supported forms.
# VALIDATES: each operator-facing ze config validate exit and diagnostic.
# A unit test cannot prove the CLI dispatch, stdout and process exit together.
# PREVENTS: validation accepting a source list the consumer cannot evaluate.
# Boot refusals are separate tests so each daemon exit is checked independently.
# Boot companion: dns-source-mode-required-consumers-boot.ci

stdin=forward:terminator=EOF_FWD
service {
	dns-resolver {
		enabled true
		listener lan {
			ip 192.0.2.1
			port 53
		}
		allow-from 192.0.2.0/24
		forward {
			server 198.51.100.53 {
				port 53
			}
			dns-source {
				source [ configured received ]
			}
		}
	}
}
EOF_FWD

stdin=forward-merge:terminator=EOF_FWD_MERGE
service {
	dns-resolver {
		enabled true
		listener lan {
			ip 192.0.2.1
			port 53
		}
		allow-from 192.0.2.0/24
		forward {
			server 198.51.100.53 {
				port 53
			}
			dns-source {
				source [ configured received ]
				mode merge
			}
		}
	}
}
EOF_FWD_MERGE

stdin=subnet:terminator=EOF_SUBNET
service {
    dhcp-server {
        enabled true
        listen-interface br0
        shared-network LAN {
            subnet 192.168.1.0/24 {
                range {
                    start 192.168.1.100
                    stop 192.168.1.200
                }
                default-router 192.168.1.1
                dns-source {
                    source [ self received ]
                }
            }
        }
    }
}
EOF_SUBNET


stdin=pool:terminator=EOF_POOL
l2tp {
    enabled true
    shared-secret s3cr3t
    pool {
        ipv4 {
            gateway 10.255.3.1
            start 10.255.3.10
            end 10.255.3.50
            dns-source {
                source [ radius received ]
            }
        }
    }
}
EOF_POOL

stdin=named-pool:terminator=EOF_NAMED
l2tp {
    enabled true
    shared-secret s3cr3t
    pool {
        named-pool gold {
            gateway 10.255.4.1
            start 10.255.4.10
            end 10.255.4.50
            dns-source {
                source [ configured received ]
            }
        }
    }
}
EOF_NAMED

cmd=foreground:seq=1:exec=ze config validate -:stdin=forward:exit=1
expect=exit:code=1
expect=stdout:contains=service dns-resolver forward dns-source names 2 sources (configured, received) and no mode
expect=stdout:contains=Ze cannot tell whether a later source is a backup or an addition
expect=stdout:contains=set service dns-resolver forward dns-source mode first-usable


cmd=foreground:seq=2:exec=ze config validate -:stdin=subnet:exit=1
expect=exit:code=1
expect=stdout:contains=service dhcp-server shared-network LAN subnet 192.168.1.0/24 dns-source names 2 sources (self, received) and no mode


cmd=foreground:seq=3:exec=ze config validate -:stdin=pool:exit=1
expect=exit:code=1
expect=stdout:contains=l2tp pool ipv4 dns-source names 2 sources (radius, received) and no mode

cmd=foreground:seq=4:exec=ze config validate -:stdin=named-pool:exit=1
expect=exit:code=1
expect=stdout:contains=l2tp pool named-pool gold dns-source names 2 sources (configured, received) and no mode

cmd=foreground:seq=5:exec=ze config validate -:stdin=forward-merge
expect=exit:code=0
expect=stdout:contains=configuration valid
