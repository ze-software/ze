# Test: a consumer's dns-source with two sources and no mode is refused at
#       ze config validate and at boot, naming the path and both fixes
# VALIDATES: spec-home-cpe-23b AC-16b (the router's half is 23a AC-16,
#            test/parse/dns-source-mode-required.ci):
#              seq=1  service dns-resolver forward dns-source, validate
#              seq=2  the same config booted with ze -
#              seq=3  a DHCP subnet's dns-source, validate
#              seq=4  l2tp pool ipv4 dns-source, validate
#              seq=5  l2tp pool named-pool dns-source, validate
#              seq=6  the forward list with mode merge: accepted
#            The RA rdnss consumer is linux-only, so its refusal lives in
#            test/parse/dns-source-ra-rdnss-consumer.ci.
#            Each refusal is dnssource.NewList's ModeRequiredError, reached
#            through the consumer's own reader.
# PREVENTS: a list whose sources Ze would have to guess are a backup or an
#           addition passing validate on any consumer.
# Break: tmp/session/2026-11-07-104251/scratch/rwinv/c23b-mode-unchecked
#        (NewList never asks for a mode): seq 1 to 5 lose their refusal.
#        Observed red, at seq 1, where the runner stops
#        (rwinv/out-gb14/p14-dns-source-mode-required-consumers-broken.log):
#        "expected exit code 1, got 0".

stdin=forward:terminator=EOF_FWD
service {
	dns-resolver {
		enabled true
		listener lan {
			ip 192.0.2.1
			port 53
		}
		allow-from 192.0.2.0/24
		forward {
			server 198.51.100.53 {
				port 53
			}
			dns-source {
				source [ configured received ]
			}
		}
	}
}
EOF_FWD

stdin=forward-merge:terminator=EOF_FWD_MERGE
service {
	dns-resolver {
		enabled true
		listener lan {
			ip 192.0.2.1
			port 53
		}
		allow-from 192.0.2.0/24
		forward {
			server 198.51.100.53 {
				port 53
			}
			dns-source {
				source [ configured received ]
				mode merge
			}
		}
	}
}
EOF_FWD_MERGE

stdin=subnet:terminator=EOF_SUBNET
service {
    dhcp-server {
        enabled true
        listen-interface br0
        shared-network LAN {
            subnet 192.168.1.0/24 {
                range {
                    start 192.168.1.100
                    stop 192.168.1.200
                }
                default-router 192.168.1.1
                dns-source {
                    source [ self received ]
                }
            }
        }
    }
}
EOF_SUBNET


stdin=pool:terminator=EOF_POOL
l2tp {
    enabled true
    shared-secret s3cr3t
    pool {
        ipv4 {
            gateway 10.255.3.1
            start 10.255.3.10
            end 10.255.3.50
            dns-source {
                source [ radius received ]
            }
        }
    }
}
EOF_POOL

stdin=named-pool:terminator=EOF_NAMED
l2tp {
    enabled true
    shared-secret s3cr3t
    pool {
        named-pool gold {
            gateway 10.255.4.1
            start 10.255.4.10
            end 10.255.4.50
            dns-source {
                source [ configured received ]
            }
        }
    }
}
EOF_NAMED

cmd=foreground:seq=1:exec=ze config validate -:stdin=forward:exit=1
expect=exit:code=1
expect=stdout:contains=service dns-resolver forward dns-source names 2 sources (configured, received) and no mode
expect=stdout:contains=Ze cannot tell whether a later source is a backup or an addition
expect=stdout:contains=set service dns-resolver forward dns-source mode first-usable

cmd=foreground:seq=2:exec=ze -:stdin=forward:timeout=30s:exit=1
expect=exit:code=1
expect=stderr:contains=service dns-resolver forward dns-source names 2 sources (configured, received) and no mode

cmd=foreground:seq=3:exec=ze config validate -:stdin=subnet:exit=1
expect=exit:code=1
expect=stdout:contains=service dhcp-server shared-network subnet dns-source names 2 sources (self, received) and no mode


cmd=foreground:seq=4:exec=ze config validate -:stdin=pool:exit=1
expect=exit:code=1
expect=stdout:contains=l2tp pool ipv4 dns-source names 2 sources (radius, received) and no mode

cmd=foreground:seq=5:exec=ze config validate -:stdin=named-pool:exit=1
expect=exit:code=1
expect=stdout:contains=l2tp pool named-pool dns-source names 2 sources (configured, received) and no mode

cmd=foreground:seq=6:exec=ze config validate -:stdin=forward-merge
expect=exit:code=0
expect=stdout:contains=configuration valid
