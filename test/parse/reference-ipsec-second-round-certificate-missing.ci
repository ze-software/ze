# Test: an RFC 4739 second round whose local certificate names no pki certificate entry is refused
#
# VALIDATES: the second-round local certificate leaf declares ze:reference
#            "pki-certificate" (ze-ipsec-conf.yang), so `ze config validate`
#            refuses a name the candidate's pki section does not define, naming
#            the value, the certificate entries that exist and the leaf, while
#            the same round naming a defined certificate is accepted.
# PREVENTS: the second round signing its AUTH with a certificate the store
#           does not hold. Replaces the TestValidateSecondRound case "local
#           certificate not in store".

stdin=missing:terminator=EOF_MISSING
pki {
	ca vpn-ca {
		certificate 
	}
	certificate server1 {
		certificate 
	}
}

vpn {
	ipsec {
		ike-group IKE-A {
			proposal 1 {
				encryption aes256gcm
				hash sha256
				dh-group 14
			}
		}
		esp-group ESP-A {
			proposal 1 {
				encryption aes256gcm
			}
		}
		site-to-site {
			peer branch-1 {
				ike-group IKE-A
				esp-group ESP-A
				local-address 127.0.0.1
				remote-address 127.0.0.2
				authentication {
					mode pre-shared-secret
					pre-shared-secret round-one-secret
					second-round {
						local {
							mode x509
							id localhost
							certificate missing-cert
						}
					}
				}
			}
		}
	}
}
EOF_MISSING

stdin=present:terminator=EOF_PRESENT
pki {
	ca vpn-ca {
		certificate 
	}
	certificate server1 {
		certificate 
	}
}

vpn {
	ipsec {
		ike-group IKE-A {
			proposal 1 {
				encryption aes256gcm
				hash sha256
				dh-group 14
			}
		}
		esp-group ESP-A {
			proposal 1 {
				encryption aes256gcm
			}
		}
		site-to-site {
			peer branch-1 {
				ike-group IKE-A
				esp-group ESP-A
				local-address 127.0.0.1
				remote-address 127.0.0.2
				authentication {
					mode pre-shared-secret
					pre-shared-secret round-one-secret
					second-round {
						local {
							mode x509
							id localhost
							certificate server1
						}
					}
				}
			}
		}
	}
}
EOF_PRESENT

cmd=foreground:seq=1:exec=ze config validate -:stdin=missing
expect=exit:code=1
expect=stdout:contains=missing-cert
expect=stdout:contains=name one of "server1"
expect=stdout:contains=vpn/ipsec/site-to-site/peer[branch-1]/authentication/second-round/local/certificate
cmd=foreground:seq=2:exec=ze config validate -:stdin=present
expect=exit:code=0
expect=stdout:contains=configuration valid
