# Test: plugin-registered bus messages accepted via dynamic bus message registration
# VALIDATES: AC-1: Plugin-registered bus message names accepted in bus send allow
# VALIDATES: AC-4: Validated dynamically against the registered bus message catalog
stdin=config:terminator=EOF_CONF
bus {
	endpoint my-process {
		internal bgp-rib
		encoding json
		send {
			allow [ bgp:update bgp:refresh bgp-rib:best-change ]
		}
	}
}
bgp {
	router-id 203.0.113.253
	peer peer1 {
		connection {
			remote {
				ip 10.0.0.1
			}
			local {
				ip 10.0.0.2
			}
		}
		session {
			asn {
				local 65001
				remote 65001
			}
		}
	}
}
EOF_CONF

cmd=foreground:seq=1:exec=ze config validate -:stdin=config
expect=exit:code=0
