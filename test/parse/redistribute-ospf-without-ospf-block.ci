# Test: a redistribute rule that names OSPF is refused when the config has no
# ospf block, at validate time and at daemon start, with the fix in the message.
#
# VALIDATES: RefuseRedistributeRules (internal/component/config/loader_redistribute.go)
#            reads the root OSPF declares at init: the "ospf" destination
#            (configredist.RegisterDestination in internal/plugins/ospf/register.go)
#            and the "ospf" source (internal/plugins/ospf/redistribute/source.go)
#            each need an `ospf { }` block. `ze config validate` (the commit
#            door) and LoadConfig (boot) both refuse. The same rule with the
#            ospf block present validates.
# PREVENTS:  `destination ospf` with no ospf block being accepted and moving
#            nothing in silence. The OSPF consumer registers only when its
#            plugin starts, so a check that read consumers could not see it.

stdin=dest-ospf:terminator=EOF_DEST
redistribute {
	destination ospf {
		import connected
	}
}
EOF_DEST

cmd=foreground:seq=1:exec=ze config validate -:stdin=dest-ospf
expect=exit:code=1
expect=stdout:contains=redistribute: "destination ospf" needs ospf configured, and this config has no ospf { } block
expect=stdout:contains=fix: configure ospf in a ospf { } block, or remove "destination ospf" from the redistribute block

cmd=foreground:seq=2:exec=ze -:stdin=dest-ospf:timeout=15s
expect=exit:code=1
expect=stderr:contains=redistribute: "destination ospf" needs ospf configured, and this config has no ospf { } block

stdin=import-ospf:terminator=EOF_IMPORT
isis {
	net 49.0001.0000.0000.0001.00
	level l1-l2
}

redistribute {
	destination isis {
		import ospf
	}
}
EOF_IMPORT

cmd=foreground:seq=3:exec=ze config validate -:stdin=import-ospf
expect=exit:code=1
expect=stdout:contains=redistribute: "import ospf" under "destination isis" needs ospf configured

stdin=dest-ospf-present:terminator=EOF_PRESENT
ospf {
	router-id 10.0.0.1
	areas {
		area 0.0.0.0 {
		}
	}
}

redistribute {
	destination ospf {
		import connected
	}
}
EOF_PRESENT

cmd=foreground:seq=4:exec=ze config validate -:stdin=dest-ospf-present
expect=exit:code=0
expect=stdout:contains=configuration valid
