# Valid config: DHCPv4 via set-command format on multiple ethernet interfaces
# AC: multiple "set interface ethernet <name> unit default ipv4 dhcp enabled true"
# accepted by config validate. Covers the multi-NIC bootstrap path
# where EmitSetConfigWithDHCP produces a DHCP line per ethernet.
# PLATFORM: ze:os "linux" prunes ipv4 on darwin.
option=skip-os:value=darwin
stdin=config:terminator=EOF_CONF
set interface ethernet eth0 unit default ipv4 dhcp enabled true
set interface ethernet eth1 unit default ipv4 dhcp enabled true
set interface ethernet enp3s0 unit default ipv4 dhcp enabled true
EOF_CONF

cmd=foreground:seq=1:exec=ze config validate -:stdin=config
expect=exit:code=0
