# Valid config: graceful-restart-llgr.ci with bgp-gr forked
# (spec-filter-wire-6-stage-filters AC-13): graceful-restart long-lived family (RFC 9494)
# validates with bgp-gr configured as a separate process, its LLGR
# insertions placed and no out-of-process refusal reported.
stdin=config:terminator=EOF_CONF
bus {
	hub {
		server local {
			ip 127.0.0.1;
			port 0;
			secret gr-llgr-forked-parse-secret-00001;
		}
	}
	endpoint bgp-gr {
		internal bgp-gr;
		process separate;
	}
	endpoint bgp-rib {
		internal bgp-rib;
	}
}

bgp {
	filter {
		import {
			final accept
		}
		export {
			final accept
		}
	}
	peer peer1 {
		connection {
			remote {
				ip 10.0.0.1
			}
			local {
				ip 192.0.2.1
			}
		}
		session {
			asn {
				local 65001
				remote 65002
			}
			router-id 1.2.3.4
			capability {
				graceful-restart {
					short-lived {
						restart-time 120
					}
					long-lived {
						family {
							ipv4/unicast 3600
						}
					}
				}
			}
		}
	}
}
EOF_CONF

cmd=foreground:seq=1:exec=ze config validate -:stdin=config
expect=exit:code=0
cmd=foreground:seq=2:exec=ze cli -c "show config dump - | json":stdin=config
expect=exit:code=0
expect=stdout:pattern="stale-time": "3600"
expect=stdout:pattern="internal": "bgp-gr"
expect=stdout:pattern="process": "separate"
