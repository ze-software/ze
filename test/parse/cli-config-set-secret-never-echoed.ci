# Test: ze config set never echoes a secret the operator typed
# VALIDATES: spec-config-set-never-echoes-a-secret AC-1 and AC-3 through the
# real entry point. `ze config set` on the ze:sensitive leaf plaintext-password
# acknowledges with the placeholder on the dry-run line and on the success line,
# and the cleartext appears in neither stream of either command. A leaf the
# schema does not mark is still echoed in full, so a mask that hides every value
# cannot pass this file.
# PREVENTS: cmdSetImpl writing the operator's raw credential to stderr, where it
# lands in scrollback, terminal recordings and anything capturing the session.

stdin=config:terminator=EOF_STDIN
bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
			}
		}
		session {
			asn {
				local 65533
				remote 65533
			}
		}
	}
}
EOF_STDIN

tmpfs=test.conf:terminator=EOF_CONF
bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
			}
		}
		session {
			asn {
				local 65533
				remote 65533
			}
		}
	}
}

system {
	authentication {
		user alice {
		}
	}
}
EOF_CONF


# The dry-run acknowledgement and its diff carry the placeholder, never the value.
cmd=foreground:seq=1:exec=ze config set --dry-run test.conf system authentication user alice plaintext-password Zq7kestrelORCHID91x
expect=exit:code=0
expect=stderr:contains=dry-run: would set system authentication user alice plaintext-password /* SECRET-DATA */
reject=stdout:contains=Zq7kestrelORCHID91x
reject=stderr:pattern=Zq7kestrel
reject=stderr:pattern=ORCHID91x

# The success acknowledgement carries the placeholder, never the value.
cmd=foreground:seq=2:exec=ze config set test.conf system authentication user alice plaintext-password Zq7kestrelORCHID91x
expect=exit:code=0
expect=stderr:contains=set system authentication user alice plaintext-password /* SECRET-DATA */
reject=stdout:contains=Zq7kestrelORCHID91x
reject=stderr:pattern=Zq7kestrel
reject=stderr:pattern=ORCHID91x

# Opposite polarity: a leaf the schema does not mark is echoed in full.
cmd=foreground:seq=3:exec=ze config set test.conf bgp peer peer1 session asn local 65000
expect=exit:code=0
expect=stderr:contains=set bgp peer peer1 session asn local 65000
reject=stderr:pattern=SECRET-DATA
