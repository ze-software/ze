# Test: ze config import copies a loose config into the initialized tree.
# VALIDATES: `ze config import <file>` reads the file from the filesystem and
#            writes it into tree storage under its basename, printing the
#            per-file "imported <name> (<n> bytes)" line and the summary
#            "<n> file(s) imported" (cmd_import.go) and exiting 0.
# PREVENTS: config import losing persistent values or its progress/summary output.
# ISOLATION: the destination is the per-test working directory.
tmpfs=small.conf:terminator=EOF_FILE
system {
	host importhost
}
EOF_FILE

option=env:var=ze.config.dir:value=.

cmd=foreground:seq=1:exec=le test fixture storage/empty-tree:exit=0
cmd=foreground:seq=2:exec=ze config import small.conf
expect=exit:code=0
expect=stdout:contains=imported small.conf
expect=stdout:contains=file(s) imported
cmd=foreground:seq=3:exec=ze data cat --path ./database file/active/small.conf
expect=exit:code=0
expect=stdout:contains=importhost
