# Valid config: attach process on a group
stdin=config:terminator=EOF_CONF
plugin {
	external my-process {
		run "ze-test interop-bgp exabgp-api syslog"
		encoder json
	}
}
bgp {
	group default {
		attach process my-process {
			receive [ state ]
		}

		peer peer3 {
			connection {
				remote {
					ip 10.0.0.3
				}
				local {
					ip 10.0.0.2
				}
			}
			session {
				asn {
					local 65533
					remote 65533
				}
				router-id 10.0.0.2
			}
			description "will pass received routes to the program"
			timer {
				receive-hold-time 180
			}
		}
	}
}
EOF_CONF

cmd=foreground:seq=1:exec=ze config validate -:stdin=config
expect=exit:code=0
