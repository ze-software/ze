# Test: SR Policy MPLS label range at config load
# VALIDATES: a config whose ipv4/sr-policy route carries binding-sid mpls 15 (reserved),
#            binding-sid mpls 1048576 or type-a mpls 1048576 (wider than 20 bits) is
#            refused at load, naming the token, the value and the allowed range; the same
#            route with in-range labels validates.
# PREVENTS: a configured label truncated to its low 20 bits or a reserved Binding SID label
#           reaching the wire (spec-bgp-sr-policy-rfc-defects D2).
# RFC 9830 Section 2.4.2: "The Label field is validated by the SRPM but MUST NOT contain the
# reserved MPLS label values (0-15)." RFC 3032 Section 2.1: "This 20-bit field carries the
# actual value of the Label."

stdin=reserved:terminator=EOF_RESERVED
bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65000
			}
			router-id 192.0.2.1
			family {
				ipv4/sr-policy { prefix { maximum 10000; } }
			}
		}

		update {
			attribute {
				next-hop 192.0.2.1
			}
			nlri {
				ipv4/sr-policy add distinguisher 0 color 100 endpoint 10.0.0.1 preference 100 binding-sid mpls 15
			}
		}
	}
}
EOF_RESERVED

stdin=wide:terminator=EOF_WIDE
bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65000
			}
			router-id 192.0.2.1
			family {
				ipv4/sr-policy { prefix { maximum 10000; } }
			}
		}

		update {
			attribute {
				next-hop 192.0.2.1
			}
			nlri {
				ipv4/sr-policy add distinguisher 0 color 100 endpoint 10.0.0.1 preference 100 binding-sid mpls 1048576
			}
		}
	}
}
EOF_WIDE

stdin=typea:terminator=EOF_TYPEA
bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65000
			}
			router-id 192.0.2.1
			family {
				ipv4/sr-policy { prefix { maximum 10000; } }
			}
		}

		update {
			attribute {
				next-hop 192.0.2.1
			}
			nlri {
				ipv4/sr-policy add distinguisher 0 color 100 endpoint 10.0.0.1 preference 100 segment-list weight 1 segment type-a mpls 1048576
			}
		}
	}
}
EOF_TYPEA

stdin=inrange:terminator=EOF_INRANGE
bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65000
			}
			router-id 192.0.2.1
			family {
				ipv4/sr-policy { prefix { maximum 10000; } }
			}
		}

		update {
			attribute {
				next-hop 192.0.2.1
			}
			nlri {
				ipv4/sr-policy add distinguisher 0 color 100 endpoint 10.0.0.1 preference 100 binding-sid mpls 16 segment-list weight 1 segment type-a mpls 1048575
			}
		}
	}
}
EOF_INRANGE

cmd=foreground:seq=1:exec=ze config validate -:stdin=reserved
expect=exit:code=1
expect=stdout:contains=binding-sid mpls 15: labels 0 to 15 are reserved (RFC 9830 Section 2.4.2); use 16 to 1048575

cmd=foreground:seq=2:exec=ze config validate -:stdin=wide
expect=exit:code=1
expect=stdout:contains=binding-sid mpls 1048576: an MPLS label is 20 bits; use 16 to 1048575

cmd=foreground:seq=3:exec=ze config validate -:stdin=typea
expect=exit:code=1
expect=stdout:contains=type-a mpls 1048576: an MPLS label is 20 bits; use 0 to 1048575

cmd=foreground:seq=4:exec=ze config validate -:stdin=inrange
expect=exit:code=0
