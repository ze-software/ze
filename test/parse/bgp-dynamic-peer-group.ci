# Test: BGP dynamic peer group config parsing
# Validates: ip dynamic, range, max-peers, rs-client at group level
stdin=config:terminator=EOF_CONF
bgp {
	router-id 1.1.1.1
	session {
		asn {
			local 65000
		}
	}
	group ix-peers {
		connection {
			remote {
				ip dynamic
				connect false
				range 185.1.69.0/24
				range 2001:7f8:4::/64
				max-peers 500
			}
			local {
				ip 185.1.69.1
				accept true
			}
		}
		session {
			rs-client true
			next-hop unchanged
			family ipv4/unicast {
				mode enable
				prefix {
					maximum 100000
				}
			}
		}
	}
}
EOF_CONF

cmd=foreground:seq=1:exec=ze config validate -:stdin=config
expect=exit:code=0
expect=stdout:contains=configuration valid
