# Test: does Linux offline validation accept PPPoE with the default interface backend?
# Why not a unit test: the shipped command must link both schema modules and
# validate an omitted backend using the Linux host's default kernel backend.
# Other hosts have no interface backend default. Run this question in Ze's guest.

option=needs-linux

stdin=config:terminator=EOF_CONF
interface { ethernet access0 {} }
pppoe { interface access0 {} }
EOF_CONF

cmd=foreground:seq=1:exec=ze config validate -:stdin=config
expect=exit:code=0
expect=stdout:contains=configuration valid
