# Test: a BFD auth secret written in hexadecimal, holding bytes an ASCII string
# cannot carry, is accepted by `ze config validate`.
#
# VALIDATES: RFC 5880 Sections 6.7.2, 6.7.3 and 6.7.4 -- the management
#            interface "SHOULD also allow for the configuration of any
#            arbitrary binary string in hexadecimal form." Each profile writes
#            its key in the `secret-hex` leaf, with a zero byte and a 0xFF
#            byte, at the longest length its Auth Type allows: 16 bytes for
#            simple-password and keyed-md5, 20 bytes for keyed-sha1.
# PREVENTS:  the hexadecimal form being dropped from the schema, or refused by
#            the plugin's own auth parser, so a binary key cannot be configured.

stdin=config:terminator=EOF_CONF
bfd {
    enabled true;
    profile simple {
        auth {
            type simple-password;
            key-id 1;
            secret-hex "00112233445566778899aabbccddeeff";
        }
    }
    profile md5 {
        auth {
            type meticulous-keyed-md5;
            key-id 2;
            secret-hex "FF00FF00FF00FF00FF00FF00FF00FF00";
        }
    }
    profile sha1 {
        auth {
            type keyed-sha1;
            key-id 3;
            secret-hex "00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff";
        }
    }
}
EOF_CONF

cmd=foreground:seq=1:exec=ze config validate -:stdin=config
expect=exit:code=0
