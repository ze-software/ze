# Test: ze config validate with redistribute import kernel
# VALIDATES: AC-1 -- "kernel" recognized as a valid redistribution source
# VALIDATES: AC-7 -- family filter on kernel import parses without error
stdin=config:terminator=EOF_CONF
bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
			}
		}
		session {
			asn {
				local 65533
				remote 65533
			}
		}
	}
}

kernel {
}

redistribute {
	destination bgp {
		import kernel {
			family [ ipv4/unicast ];
		}
	}
}
EOF_CONF

cmd=foreground:seq=1:exec=ze config validate -:stdin=config
expect=exit:code=0
expect=stdout:contains=configuration valid
