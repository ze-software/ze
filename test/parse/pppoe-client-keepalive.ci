# Test: pppoe-client keepalive and reconnect leaves, accepted at every bound
# and refused outside it.
# VALIDATES: spec-home-cpe-17 AC-1 (valid leaves accepted), AC-4 (delay-max
#            below delay-min refused, both leaves and the fix named), AC-5
#            (interval, failures, delay-min, delay-max out of range refused by
#            the YANG range, with the range in the message).
# PREVENTS: a zero interval or a zero redial wait reaching the client.
# PLATFORM: pppoe-client is ze:os "linux"; skip on darwin.
option=skip-os:value=darwin
stdin=lowok:terminator=EOF_LOWOK
interface {
    backend netlink
    ethernet eth2 {
    }
    pppoe-client pppoe0 {
        source-interface eth2
        authentication {
            username subscriber
            password secret123
        }
        keepalive {
            interval 1
            failures 1
        }
        reconnect {
            delay-min 1
            delay-max 1
        }
    }
}
EOF_LOWOK

stdin=highok:terminator=EOF_HIGHOK
interface {
    backend netlink
    ethernet eth2 {
    }
    pppoe-client pppoe0 {
        source-interface eth2
        authentication {
            username subscriber
            password secret123
        }
        keepalive {
            interval 3600
            failures 255
        }
        reconnect {
            delay-min 3600
            delay-max 3600
        }
    }
}
EOF_HIGHOK

