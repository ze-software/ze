# Test: managed hub client with source-address parses successfully

stdin=ze-bgp:terminator=EOF_CONF
plugin {
    hub {
        client mgmt {
            host 10.0.0.1;
            port 12700;
            secret abcdefghijklmnopqrstuvwxyz012345;
            source-address 192.168.1.1;
        }
    }
}
bgp {
    peer peer1 {
        connection {
            remote { ip 127.0.0.1; }
            local { ip 127.0.0.1; }
        }
        session {
            asn { local 1; remote 1; }
            router-id 1.2.3.4
        }
    }
}
EOF_CONF

cmd=foreground:seq=1:exec=ze config validate -:stdin=ze-bgp
expect=exit:code=0
