# Test: BGP route-server worker-queue-size config parsing
# Validates: route-server { worker-queue-size N; } accepted in bgp block
stdin=config:terminator=EOF_CONF
bgp {
	router-id 1.1.1.1
	session {
		asn {
			local 65000
		}
	}
	route-server {
		worker-queue-size 8192
	}
}
EOF_CONF

cmd=foreground:seq=1:exec=ze config validate -:stdin=config
expect=exit:code=0
expect=stdout:contains=configuration valid
