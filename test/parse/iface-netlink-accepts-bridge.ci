# Test: bridge is accepted under the default kernel backend
# VALIDATES: spec-backend-feature-gate AC-6 -- regression guard: the new
#            ze:backend annotation must not break the kernel happy path.
# PREVENTS: accidentally annotating with the wrong backend name, which
#           would silently reject valid kernel configs.
stdin=config:terminator=EOF_CONF
interface {
	backend kernel;
	bridge br0 {
		mac {
			address 02:00:00:00:00:03;
		}
	}
}
EOF_CONF

cmd=foreground:seq=1:exec=ze config validate -:stdin=config
expect=exit:code=0
expect=stdout:contains=configuration valid
