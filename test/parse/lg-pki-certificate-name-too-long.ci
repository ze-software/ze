# spec-lg-pki-certificate boundary table: the looking-glass certificate leaf is
# 1..255 characters over the pki name charset. The boundary is stated on both
# sides here rather than implied -- 255 characters VALIDATES and 256 is REFUSED
# -- because a length constraint that only ever sees a rejected value cannot
# tell a working 1..255 from a schema that rejects everything.
#
# A name carrying a path separator is refused too: the reference is a store key,
# never a file path.
#
# Both refusals assert the leaf's own constraint text. The two names are also
# absent from pki, so the ze:reference check would refuse them anyway: an exit
# code alone would stay green with the length bound or the pattern deleted.
stdin=atlimit:terminator=EOF_LIMIT
pki {
	ca test-ca {
		certificate 
	}
	certificate aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa {
		certificate 
	}
}
environment {
	looking-glass {
		enabled true
		certificate aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
	}
}
EOF_LIMIT

stdin=toolong:terminator=EOF_LONG
environment {
	looking-glass {
		enabled true
		certificate aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
	}
}
EOF_LONG

stdin=badchar:terminator=EOF_BAD
environment {
	looking-glass {
		enabled true
		certificate "../../etc/ze/secret"
	}
}
EOF_BAD

cmd=foreground:seq=1:exec=ze config validate -:stdin=atlimit
expect=exit:code=0
expect=stdout:contains=configuration valid
cmd=foreground:seq=2:exec=ze config validate -:stdin=toolong
expect=exit:code=1
expect=stdout:contains=invalid value for certificate: value length 256 is outside allowed length 1..255
cmd=foreground:seq=3:exec=ze config validate -:stdin=badchar
expect=exit:code=1
expect=stdout:contains=invalid value for certificate: value "../../etc/ze/secret" does not match pattern "[A-Za-z0-9._-]+"
