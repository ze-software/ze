# Valid config: two bus endpoints receive bgp:state from a group
stdin=config:terminator=EOF_CONF
bus {
	endpoint my-process {
		internal bgp-bmp
		encoding json
		receive {
			allow [ bgp:state ]
			from [ /bgp/group/test ]
		}
	}
	endpoint my-second-process {
		internal bgp-gr
		encoding json
		receive {
			allow [ bgp:state ]
			from [ /bgp/group/test ]
		}
	}
}
bgp {
	group test {
		peer peer3 {
			connection {
				remote {
					ip 10.0.0.3
				}
				local {
					ip 10.0.0.2
				}
			}
			session {
				asn {
					local 65533
					remote 65533
				}
				router-id 10.0.0.2
			}
			description "will pass received routes to the program"
			timer {
				receive-hold-time 180
			}
		}
	}
}
EOF_CONF

cmd=foreground:seq=1:exec=ze config validate -:stdin=config
expect=exit:code=0
