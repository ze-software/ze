# Test: DNS source validation refuses ambiguous or inapplicable sources
# and accepts the explicitly supported forms.
# VALIDATES: each operator-facing ze config validate exit and diagnostic.
# A unit test cannot prove the CLI dispatch, stdout and process exit together.
# PREVENTS: validation accepting a source list the consumer cannot evaluate.
# Boot refusals are separate tests so each daemon exit is checked independently.
# Boot companion: dns-source-mode-required-boot.ci
# Boot companion: dns-source-mode-required-interface-boot.ci

stdin=no-mode:terminator=EOF_NO_MODE
system {
	name-server [ 198.51.100.53 ]
	dns-source {
		source [ configured received ]
	}
}
EOF_NO_MODE

stdin=interface-without-received:terminator=EOF_IFACE
system {
	dns-source {
		source [ configured ]
		received-interface [ eth0 ]
	}
}
EOF_IFACE

stdin=self:terminator=EOF_SELF
system {
	dns-source {
		source [ self ]
	}
}
EOF_SELF

stdin=radius:terminator=EOF_RADIUS
system {
	dns-source {
		source [ radius ]
	}
}
EOF_RADIUS

stdin=one-source:terminator=EOF_ONE
system {
	dns-source {
		source [ received ]
	}
}
EOF_ONE

stdin=merge:terminator=EOF_MERGE
system {
	name-server [ 198.51.100.53 ]
	dns-source {
		source [ received configured ]
		mode merge
		received-interface [ eth1 eth0 ]
	}
}
EOF_MERGE

cmd=foreground:seq=1:exec=ze config validate -:stdin=no-mode:exit=1
expect=exit:code=1
expect=stdout:contains=configuration invalid
expect=stdout:contains=system dns-source names 2 sources (configured, received) and no mode
expect=stdout:contains=Ze cannot tell whether a later source is a backup or an addition
expect=stdout:contains=set system dns-source mode first-usable


cmd=foreground:seq=2:exec=ze config validate -:stdin=interface-without-received:exit=1
expect=exit:code=1
expect=stdout:contains=system dns-source names received-interface eth0 but its source list does not name received
expect=stdout:contains=set system dns-source source received, or delete system dns-source received-interface eth0


cmd=foreground:seq=3:exec=ze config validate -:stdin=self:exit=1
expect=exit:code=1
expect=stdout:contains=system dns-source names self
expect=stdout:contains=Ze cannot be its own upstream

cmd=foreground:seq=4:exec=ze config validate -:stdin=radius:exit=1
expect=exit:code=1
expect=stdout:contains=system dns-source names radius

cmd=foreground:seq=5:exec=ze config validate -:stdin=one-source
expect=exit:code=0
expect=stdout:contains=configuration valid

cmd=foreground:seq=6:exec=ze config validate -:stdin=merge
expect=exit:code=0
expect=stdout:contains=configuration valid
