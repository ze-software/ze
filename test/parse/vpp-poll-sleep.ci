# Test: cpu poll-sleep accepts whole-millisecond values, rejects out-of-range/unit
# VALIDATES: ze-vpp-conf.yang -- cpu/poll-sleep is a string matching [0-9]+ms;
#            parseCPU enforces 0ms..100ms and converts to microseconds. AC-6.
# PREVENTS: an out-of-range or unit-less idle-sleep value reaching startup.conf,
#           and the leaf being silently dropped so operators think idle tuning
#           applied when it did not.

# Boundary low: 0ms is valid (equals VPP default, still emitted).
stdin=sleep0:terminator=EOF0
vpp {
	enabled true;
	cpu {
		poll-sleep 0ms;
	}
	dpdk {
		interface 0000:03:00.0 {
			name xe0;
		}
	}
}
EOF0

# Boundary high: 100ms is the last valid value.
stdin=sleepmax:terminator=EOFMAX
vpp {
	enabled true;
	cpu {
		poll-sleep 100ms;
	}
	dpdk {
		interface 0000:03:00.0 {
			name xe0;
		}
	}
}
EOFMAX

# Out of range: 101ms is rejected.
stdin=sleepbad:terminator=EOFBAD
vpp {
	enabled true;
	cpu {
		poll-sleep 101ms;
	}
	dpdk {
		interface 0000:03:00.0 {
			name xe0;
		}
	}
}
EOFBAD

cmd=foreground:seq=1:exec=ze config validate -:stdin=sleep0:exit=0
expect=exit:code=0
expect=stdout:contains=valid

cmd=foreground:seq=2:exec=ze config validate -:stdin=sleepmax:exit=0
expect=exit:code=0
expect=stdout:contains=valid

cmd=foreground:seq=3:exec=ze config validate -:stdin=sleepbad:exit=1
expect=exit:code=1
expect=stdout:contains=poll-sleep
