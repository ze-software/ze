# Test: an RFC 4739 second round whose remote ca-certificate names no pki ca entry is refused
#
# VALIDATES: the second-round remote ca-certificate leaf declares ze:reference
#            "pki-ca" (ze-ipsec-conf.yang), so `ze config validate` refuses a
#            name the candidate's pki section does not define, naming the value,
#            the ca entries that exist and the leaf, while the same round naming
#            a defined CA is accepted.
# PREVENTS: the second round verifying the peer's AUTH against a trust anchor
#           the store does not hold. Replaces the TestValidateSecondRound case
#           "remote ca not in store".

stdin=missing:terminator=EOF_MISSING
pki {
	ca vpn-ca {
		certificate 
	}
	certificate server1 {
		certificate 
	}
}

vpn {
	ipsec {
		ike-group IKE-A {
			proposal 1 {
				encryption aes256gcm
				hash sha256
				dh-group 14
			}
		}
		esp-group ESP-A {
			proposal 1 {
				encryption aes256gcm
			}
		}
		site-to-site {
			peer branch-1 {
				ike-group IKE-A
				esp-group ESP-A
				local-address 127.0.0.1
				remote-address 127.0.0.2
				authentication {
					mode pre-shared-secret
					pre-shared-secret round-one-secret
					second-round {
						remote {
							mode x509
							ca-certificate missing-ca
						}
					}
				}
			}
		}
	}
}
EOF_MISSING

stdin=present:terminator=EOF_PRESENT
pki {
	ca vpn-ca {
		certificate 
	}
	certificate server1 {
		certificate 
	}
}

vpn {
	ipsec {
		ike-group IKE-A {
			proposal 1 {
				encryption aes256gcm
				hash sha256
				dh-group 14
			}
		}
		esp-group ESP-A {
			proposal 1 {
				encryption aes256gcm
			}
		}
		site-to-site {
			peer branch-1 {
				ike-group IKE-A
				esp-group ESP-A
				local-address 127.0.0.1
				remote-address 127.0.0.2
				authentication {
					mode pre-shared-secret
					pre-shared-secret round-one-secret
					second-round {
						remote {
							mode x509
							ca-certificate vpn-ca
						}
					}
				}
			}
		}
	}
}
EOF_PRESENT

cmd=foreground:seq=1:exec=ze config validate -:stdin=missing
expect=exit:code=1
expect=stdout:contains=missing-ca
expect=stdout:contains=name one of "vpn-ca"
expect=stdout:contains=vpn/ipsec/site-to-site/peer[branch-1]/authentication/second-round/remote/ca-certificate
cmd=foreground:seq=2:exec=ze config validate -:stdin=present
expect=exit:code=0
expect=stdout:contains=configuration valid
