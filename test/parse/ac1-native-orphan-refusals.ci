# Test: does the native CLI report both unread peer block classes as parse_error?
# Why not a unit test: discovery and the native result formatter must agree.
# The synthetic tree contains no source and builds nothing. Its executable
# tripwire belongs to this fixture and must never run while reporting refusal.
option=env:var=LE_TEST_NO_BUILD:value=1
option=env:var=ZE_BIN:value=orphan-tripwire
tmpfs=go.mod:terminator=EOF_MOD
module orphan-refusal-fixture
EOF_MOD
tmpfs=test/plugin/orphan-positive.ci:terminator=EOF_POSITIVE
cmd=foreground:seq=1:exec=true
stdin=peer:terminator=END_PEER
expect=bgp:conn=1:seq=1:hex=ffffffffffffffffffffffffffffffff001304
END_PEER
EOF_POSITIVE
tmpfs=test/plugin/orphan-negative.ci:terminator=EOF_NEGATIVE
cmd=foreground:seq=1:exec=true
stdin=peer:terminator=END_PEER
expect=bgp:conn=1:seq=1:hex=ffffffffffffffffffffffffffffffff001304
reject=bgp:conn=1:pattern=deadbeef
END_PEER
EOF_NEGATIVE
cmd=foreground:seq=1:exec=le test fixture parse/write-tripwire orphan-tripwire orphan-tripwire-executed:exit=0
cmd=foreground:seq=2:exec=le test bgp plugin --pattern orphan-positive
expect=exit:code=1
expect=stdout:contains=TYPE:    parse_error
expect=stdout:contains=stdin=peer block has no peer consumer
expect=stdout:contains=orphan-positive
reject=stdout:contains=orphan-tripwire-executed
reject=stderr:pattern=orphan-tripwire-executed
cmd=foreground:seq=3:exec=le test bgp plugin --pattern orphan-negative
expect=exit:code=1
expect=stdout:contains=TYPE:    parse_error
expect=stdout:contains=reject=bgp is read by ze-peer
expect=stdout:contains=orphan-negative
reject=stdout:contains=orphan-tripwire-executed
reject=stderr:pattern=orphan-tripwire-executed
