# Test: ze config validate accepts family-filter config + chain references
# VALIDATES: AC-1 -- family-filter instances parse (family + action)
# VALIDATES: Composable filters in import/export policies with explicit final accept
# PREVENTS: YANG schema or augment regression breaking family-filter parsing
stdin=config:terminator=EOF_CONF
	policy {
		family-filter NoFlow {
			family ipv4/flow
			action remove
		}
		family-filter Kill {
			family ipv4/flow
			action tear-down
		}
	}

bgp {
	router-id 203.0.113.253
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
			}
		}
		session {
			asn {
				local 65533
				remote 65533
			}
			family {
				ipv4/flow { prefix { maximum 10000; } }
				ipv4/unicast { prefix { maximum 10000; } }
			}
		}
		filter {
			export { filters [ bgp-filter-family:NoFlow ]; final accept; }
			import { filters [ bgp-filter-family:Kill ]; final accept; }
		}
	}
}
EOF_CONF

cmd=foreground:seq=1:exec=ze config validate -:stdin=config
expect=exit:code=0
expect=stdout:contains=configuration valid
