# Ze FreeRADIUS subscriber lab: the whole virtual server, written out.
#
# The server listens as a stock deployment does: Access-Requests on 1812 and
# Accounting-Requests on 1813 (RFC 2866 Section 3), one listener each, because
# FreeRADIUS 3.2.7 refuses an Accounting-Request on a UDP auth+acct listener
# ("Invalid packet code 4 sent to authentication port"). ze reaches both
# through one server entry, whose accounting port defaults to 1813.
# Authentication is CHAP against the users file. Accounting writes every
# record to the ze_detail file, which the checkers read as the server's own
# record of each Acct-Session-Id.
server default {
	listen {
		type = auth
		ipaddr = *
		port = 1812
	}

	listen {
		type = acct
		ipaddr = *
		port = 1813
	}

	authorize {
		preprocess
		chap
		files
		pap
	}

	authenticate {
		Auth-Type CHAP {
			chap
		}
		Auth-Type PAP {
			pap
		}
	}

	preacct {
		preprocess
	}

	accounting {
		ze_detail
	}

	post-auth {
	}
}
