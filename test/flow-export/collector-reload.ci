# Test: a SIGHUP reload that adds a collector starts the exporter.
#
# VALIDATES: spec-flow-export-1 AC-6 -- a config reload that adds a collector
#            brings a new exporter online; the reactor's OnConfigVerify accepts
#            the changed config and OnConfigure rebuilds the exporter, emitting
#            "flow-export configured".
#            spec-flow-export-1 AC-12 -- with no flow-export section at boot the
#            component does not start an exporter; it only comes up after the
#            reload introduces the section.
# PREVENTS:  regression where a SIGHUP that introduces a flow-export block is
#            ignored (verify/configure path not wired on reload), leaving the
#            exporter silent.
#
# Scope note (spec-flow-export-1): the assertion is on the reactor's
# "flow-export configured" log line, not on a captured datagram, because the
# reload mechanics (SIGHUP + config swap) are what is under test here. Datagram
# emission is covered by sflow-export.ci / netflow9-export.ci / ipfix-export.ci.

tmpfs=reload.py:mode=755:terminator=EOF_PY
#!/usr/bin/env python3
"""Block on daemon readiness, rewrite config to add a collector, SIGHUP, SIGTERM.

wait_for_daemon_ready is the shared barrier (test/scripts/ze_api.py): it returns
the daemon pid once daemon.ready exists, which ze creates after
apiServer.WaitForStartupComplete returns (cmd/ze/hub/main.go). Every plugin
startup phase has settled by then, the boot-time OnConfigure among them, so the
former 0.3s "let the initial apply finish" hold had nothing left to wait for and
is gone.
"""
import os
import shutil
import signal
import time

from ze_api import wait_for_daemon_ready

pid = wait_for_daemon_ready()

shutil.copy("config2.conf", "ze-bgp.conf")
os.kill(pid, signal.SIGHUP)

# sleep(no-signal): handleSIGHUPReload (cmd/ze/hub/main_reload.go) writes no file and answers no query, and this driver holds no API connection, so the reload's only evidence is the "flow-export configured" line on ze's stderr, which the runner reads and this process cannot
time.sleep(2.5)
os.kill(pid, signal.SIGTERM)
EOF_PY

stdin=ze-conf:terminator=EOF_CONF
environment {
	log {
		flow.export info
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

tmpfs=config2.conf:terminator=EOF_CONF2
environment {
	log {
		flow.export info
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}

flow-export {
	collector c1 {
		address 127.0.0.1
		port $PORT2
		protocol sflow
		polling-interval 1
	}
}
EOF_CONF2

option=env:var=ze.log.flow.export:value=info

cmd=background:seq=1:exec=python3 reload.py
cmd=foreground:seq=2:exec=ze -:stdin=ze-conf:timeout=15s
expect=exit:code=0
expect=stderr:contains=flow-export configured
