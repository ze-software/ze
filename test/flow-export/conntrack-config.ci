# Test: a conntrack { enabled true } config reaches the conntrack worker at boot.
#
# VALIDATES: spec-flow-export-2 -- a `conntrack { enabled true; }` block is
#            parsed and drives startFlowSubsystems -> conntrackWorker.Start,
#            which opens the netlink table reader and the
#            NFNLGRP_CONNTRACK_DESTROY event listener. The destroy listener
#            exports each torn-down flow's residual counters immediately, so
#            short flows that begin and end between two periodic dumps are not
#            lost.
# PREVENTS:  regression where the conntrack sub-tree parses but never reaches
#            the worker, or where the destroy listener is silently dropped and
#            the daemon falls back to dump-only without saying so.
#
# Scope note (mirrors sampling-config.ci): live conntrack table access and real
# destroy-event reception need root + the nf_conntrack / nf_conntrack_netlink
# modules, which CI runners do not grant reliably. The worker degrades
# gracefully and logs exactly one of three lines at startup: "destroy listener
# active" (full path up), "destroy listener unavailable; dump-only mode"
# (table reader up, event subscription denied), or "conntrack reader
# unavailable" (no conntrack at all). This test asserts one of those appears,
# proving the config is wired end to end. The ctnetlink event parser itself is
# covered by the unit tests in conntrack/destroy_test.go.

tmpfs=wait.py:mode=755:terminator=EOF_PY
#!/usr/bin/env python3
"""Hold the test open long enough for ze (in background) to reach OnConfigure
and run the conntrack worker. Background processes do not receive the
ZE_READY_FILE marker, so the wait is a plain sleep."""
import time

# blind hold: a backgrounded ze gets no ZE_READY_FILE marker to poll; hold until OnConfigure emits the asserted log line, left un-converted (no readiness signal for a background daemon)
time.sleep(2.5)
EOF_PY

stdin=ze-conf:terminator=EOF_CONF
environment {
	log {
		flow.export info
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}

flow-export {
	collector nf9 {
		address 127.0.0.1
		port 2055
		protocol netflow9
		polling-interval 1
	}
	conntrack {
		enabled true
		active-timeout 1
	}
}
EOF_CONF

option=env:var=ze.log.flow.export:value=info

cmd=background:seq=1:exec=ze -:stdin=ze-conf
cmd=foreground:seq=2:exec=python3 wait.py:timeout=10s
expect=exit:code=0
expect=stderr:pattern=conntrack (destroy listener active|destroy listener unavailable|reader unavailable)
