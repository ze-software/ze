# Test: a sampling { interface } config reaches the sampling worker at boot.
#
# VALIDATES: spec-flow-export-2 AC-1 -- a `sampling { interface lo { rate 1; } }`
#            block is parsed and drives startFlowSubsystems -> samplingWorker.Start,
#            which attempts tc-sample setup and a psample reader. The config path
#            is wired end to end (the worker runs, not just parses).
# PREVENTS:  regression where the sampling sub-tree parses but never reaches the
#            worker (the pre-flow-export-2 state: config accepted, nothing
#            programmed, no log emitted).
#
# Scope note (spec-flow-export-2 deviation): kernel-state verification of the
# installed `tc sample` action (and real psample packet reception) is deferred
# because it needs CAP_NET_ADMIN + the kernel psample module, which CI runners
# do not grant reliably. The worker degrades gracefully on a runner without
# those capabilities: it logs either "packet sampling enabled" (setup
# succeeded) or "psample reader unavailable; sampling idle" (degraded). This
# test asserts one of those two log lines appears, proving the wiring, exactly
# as traffic/traffic-boot-apply.ci asserts the reactor log line rather than tc
# qdisc state. The netlink Apply path itself is covered by the Linux unit tests
# in internal/plugins/flowexport/sampling/*_linux_test.go.

tmpfs=wait.py:mode=755:terminator=EOF_PY
#!/usr/bin/env python3
"""Hold the test open long enough for ze (in background) to reach OnConfigure
and run the sampling worker. Background processes do not receive the
ZE_READY_FILE marker, so the wait is a plain sleep."""
import time

# blind hold: a backgrounded ze gets no ZE_READY_FILE marker to poll; hold until OnConfigure emits the asserted log line, left un-converted (no readiness signal for a background daemon)
time.sleep(2.5)
EOF_PY

stdin=ze-conf:terminator=EOF_CONF
environment {
	log {
		flow.export info
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}

flow-export {
	sampling {
		interface lo {
			rate 1
		}
	}
}
EOF_CONF

option=env:var=ze.log.flow.export:value=info

cmd=background:seq=1:exec=ze -:stdin=ze-conf
cmd=foreground:seq=2:exec=python3 wait.py:timeout=10s
expect=exit:code=0
expect=stderr:pattern=flow-export: (packet sampling enabled|psample reader unavailable)
