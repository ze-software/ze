# Test: a NetFlow v9 collector receives a datagram with a template FlowSet.
#
# VALIDATES: spec-flow-export-1 AC-1 -- the exporter opens a UDP socket to the
#            configured collector.
#            spec-flow-export-1 AC-4 -- NetFlow v9 datagram header carries
#            version 9 and the first export includes a template FlowSet (ID 0)
#            so the collector can decode the data FlowSet that follows.
# PREVENTS:  regression where the NetFlow v9 encoder emits the wrong version, or
#            never sends the template (collectors discard data records they
#            cannot decode), or never transmits at all.
#
# Architecture:
#   The external receiver binds UDP $PORT2 before signalling ready. With
#   polling-interval 1 a datagram is produced within ~1-2s. The receiver
#   asserts version 9 and that a template FlowSet (ID 0) is present, then
#   dispatches `daemon shutdown`.

option=env:var=ze.log.flow.export:value=info
option=timeout:value=20s

tmpfs=netflow9-receiver.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
"""Bind UDP $PORT2, wait for a NetFlow v9 datagram, assert version 9 + template."""
import socket
import struct

from ze_api import API, runtime_fail


def dispatch(api, command):
    api._call_engine('ze-plugin-engine:dispatch-command', {'command': command})


def main():
    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    sock.bind(('127.0.0.1', $PORT2))
    sock.settimeout(8.0)

    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()

    try:
        data, _ = sock.recvfrom(65535)
    except socket.timeout:
        runtime_fail('no NetFlow v9 datagram received within timeout')

    # NetFlow v9 header is 20 bytes: version(2) count(2) sysUptime(4)
    # unixSecs(4) seqNumber(4) sourceID(4). The first FlowSet follows.
    if len(data) < 24:
        runtime_fail(f'NetFlow v9 datagram too short: {len(data)} bytes')
    version = struct.unpack('!H', data[:2])[0]
    if version != 9:
        runtime_fail(f'NetFlow v9 version={version} want 9')
    flowset_id = struct.unpack('!H', data[20:22])[0]
    if flowset_id != 0:
        runtime_fail(f'first FlowSet id={flowset_id} want 0 (template)')

    dispatch(api, 'request shutdown')
    api.wait_for_shutdown()


if __name__ == '__main__':
    main()
EOF_RUN

stdin=ze-conf:terminator=EOF_CONF
plugin {
	external netflow9-receiver {
		run ./netflow9-receiver.run
		encoder json
	}
}

environment {
	log {
		flow.export info
	}
}

flow-export {
	collector c1 {
		address 127.0.0.1
		port $PORT2
		protocol netflow9
		polling-interval 1
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

cmd=foreground:seq=1:exec=ze -:stdin=ze-conf:timeout=20s
expect=exit:code=0
expect=stderr:contains=flow-export configured
