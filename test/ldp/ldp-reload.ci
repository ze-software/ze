# Test: LDP boots with the real top-level schema on a single interface and
# exposes its bindings, exercising the config -> engine -> show path that a
# reload reconfigures.
#
# VALIDATES: spec-mpls-2-ldp -- the LDP component accepts the real top-level
#            `ldp { ... interfaces <name> }` schema (NOT the bogus
#            `protocol { ldp { interface X { ... } } }` form, which never matched
#            the YANG), starts discovery on the configured interface, originates
#            its local label bindings, and answers `show ldp binding`.
# PREVENTS:  regression to the wrong ConfigRoots/`protocol/ldp` path and to a
#            reload that drops the interface set on the floor.
#
# AC-9 (dynamic add/remove of an LDP interface on config reload) is reconciled
# by the discovery manager. That add/remove reconcile -- starting discovery on a
# newly-added interface and stopping it on a removed one without restarting the
# engine -- is unit-tested directly in
# internal/plugins/ldp/discovery_manager_test.go
# (TestDiscoveryManagerReconcileStartsAndStops,
#  TestDiscoveryManagerNoInterfacesFallsBack), driven through the same
# reconcile() entry point that OnConfigure calls on a live reload. This
# functional test covers the boot half of that path: a single-interface config
# reaches the engine and produces the expected discovery + binding state.


stdin=ze-conf:terminator=EOF_CONF
plugin {
	external ldp-reload {
		run "ze-test fixture ldp/ldp-reload"
		encoder json
	}
}

ldp {
	lsr-id 10.0.0.1
	transport-address 10.0.0.1
	hello-interval 5
	hello-hold-time 15
	interfaces lo
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65000
			}
			router-id 10.0.0.1
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

option=env:var=ze.log.ldp:value=info

cmd=foreground:seq=1:exec=ze -:stdin=ze-conf:timeout=15s
expect=exit:code=0
expect=stderr:contains=discovery started on interface
expect=stderr:contains=answered show ldp binding
reject=stderr:pattern=no lsr-id configured
reject=stderr:pattern=engine idle
reject=stderr:pattern=panic
reject=stderr:pattern=fatal error
