# Test: LDP single-daemon boot, config delivery, and show commands.
#
# VALIDATES: spec-mpls-2-ldp -- a top-level `ldp { ... }` config block reaches
#            the in-process LDP engine (lsr-id, transport-address, timers, and
#            the interfaces leaf-list all parsed from the YANG config tree), the
#            engine starts discovery on the configured interface and originates
#            local FEC bindings, and the operator-facing `show ldp neighbor` /
#            `show ldp binding` commands answer through the plugin dispatcher.
# PREVENTS:  regression where the config section is delivered root-wrapped and
#            string-typed (the Tree.ToMap shape) but the parser reads the wrong
#            nesting/type, leaving the engine permanently idle ("no lsr-id
#            configured"), and where the show RPCs 404 at dispatch.
#
# Live peer-to-peer session establishment (AC-1 Hello on 224.0.0.2:646, AC-2 TCP
# session, AC-3 Label Mapping) needs a mock LDP peer; the wire/session state
# machine is unit-tested in internal/plugins/ldp/session_test.go and
# internal/plugins/ldp/wire_test.go, and FRR interop is covered by
# internal/plugins/ldp/frr_interop_integration_linux_test.go. This functional
# test exercises everything up to the point a peer is required: config parse ->
# YANG -> component auto-load -> engine startup -> show command dispatch.


stdin=ze-conf:terminator=EOF_CONF
plugin {
	external ldp-show {
		run "ze-test fixture ldp/ldp-session"
		encoder json
	}
}

ldp {
	lsr-id 10.0.0.1
	transport-address 10.0.0.1
	hello-interval 5
	hello-hold-time 15
	keepalive-time 60
	interfaces lo
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65000
			}
			router-id 10.0.0.1
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

option=env:var=ze.log.ldp:value=info

cmd=foreground:seq=1:exec=ze -:stdin=ze-conf:timeout=15s
expect=exit:code=0
expect=stderr:contains=discovery started on interface
expect=stderr:contains=show ldp neighbor + binding dispatched
reject=stderr:pattern=no lsr-id configured
reject=stderr:pattern=engine idle
reject=stderr:pattern=panic
reject=stderr:pattern=fatal error
