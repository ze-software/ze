# Test: LDP single-daemon boot, config delivery, and show commands.
#
# VALIDATES: spec-mpls-2-ldp -- a top-level `ldp { ... }` config block reaches
#            the in-process LDP engine (lsr-id, transport-address, timers, and
#            the interfaces leaf-list all parsed from the YANG config tree), the
#            engine starts discovery on the configured interface and originates
#            local FEC bindings, and the operator-facing `show ldp neighbor` /
#            `show ldp binding` commands answer through the plugin dispatcher.
# PREVENTS:  regression where the config section is delivered root-wrapped and
#            string-typed (the Tree.ToMap shape) but the parser reads the wrong
#            nesting/type, leaving the engine permanently idle ("no lsr-id
#            configured"), and where the show RPCs 404 at dispatch.
#
# Live peer-to-peer session establishment (AC-1 Hello on 224.0.0.2:646, AC-2 TCP
# session, AC-3 Label Mapping) needs a mock LDP peer; the wire/session state
# machine is unit-tested in internal/plugins/ldp/session_test.go and
# internal/plugins/ldp/wire_test.go, and FRR interop is covered by
# internal/plugins/ldp/frr_interop_integration_linux_test.go. This functional
# test exercises everything up to the point a peer is required: config parse ->
# YANG -> component auto-load -> engine startup -> show command dispatch.

tmpfs=ldp-show.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
"""Dispatch `show ldp neighbor` / `show ldp binding` against a configured daemon."""

import sys

from ze_api import API, runtime_fail, result_json_data, result_text_data


def dispatch(api, command):
    resp = api._call_engine(
        'ze-plugin-engine:dispatch-command', {'command': command})
    if resp is None:
        return {'status': 'error', 'data': 'engine call returned None'}
    return resp.get('result', {})


def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()
    api.wait_for_post_startup(timeout=5.0)

    # `show ldp neighbor` reaches the LDP engine and returns a JSON array. With
    # no peer there are no discovered adjacencies, so the list is empty -- which
    # is exactly what we assert.
    r = dispatch(api, 'show ldp neighbor')
    if r.get('status') != 'done':
        runtime_fail(
            f"show ldp neighbor: expected done, got status={r.get('status')} "
            f"data={result_text_data(r)[:200]}")
    neighbors = result_json_data(r, None)
    if not isinstance(neighbors, list):
        runtime_fail(f"show ldp neighbor: expected list, got {neighbors!r}")
    if neighbors:
        runtime_fail(f"show ldp neighbor: expected empty list (no peer), got {neighbors!r}")

    # AC-8: `show ldp binding` returns the local/remote label bindings as a JSON
    # array. The LSR originates a local binding for its own FEC, so the array is
    # present (its contents depend on which connected prefixes are readable).
    r = dispatch(api, 'show ldp binding')
    if r.get('status') != 'done':
        runtime_fail(
            f"show ldp binding: expected done, got status={r.get('status')} "
            f"data={result_text_data(r)[:200]}")
    bindings = result_json_data(r, None)
    if not isinstance(bindings, list):
        runtime_fail(f"show ldp binding: expected list, got {bindings!r}")
    for b in bindings:
        if b.get('direction') not in ('local', 'remote'):
            runtime_fail(f"show ldp binding: bad direction in {b!r}")

    import sys
    print('OK: show ldp neighbor + binding dispatched through the LDP engine',
          file=sys.stderr)

    dispatch(api, 'request shutdown')
    api.wait_for_shutdown()


if __name__ == '__main__':
    main()
EOF_RUN

stdin=ze-conf:terminator=EOF_CONF
plugin {
	external ldp-show {
		run ./ldp-show.run
		encoder json
	}
}

ldp {
	lsr-id 10.0.0.1
	transport-address 10.0.0.1
	hello-interval 5
	hello-hold-time 15
	keepalive-time 60
	interfaces lo
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65000
			}
			router-id 10.0.0.1
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

option=env:var=ze.log.ldp:value=info

cmd=foreground:seq=1:exec=ze -:stdin=ze-conf:timeout=15s
expect=exit:code=0
expect=stderr:contains=discovery started on interface
expect=stderr:contains=show ldp neighbor + binding dispatched
reject=stderr:pattern=no lsr-id configured
reject=stderr:pattern=engine idle
reject=stderr:pattern=panic
reject=stderr:pattern=fatal error
