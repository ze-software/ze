# Two products from one pinned build.
#
# freeRouter publishes no stable release, so the build follows a pinned master
# commit (owner decision M14). Docker.Build refuses this file once the commit
# is more than one month old (internal/le/interoplab/sourcepin.go), and
# `./le lab pin bump dockerfile test/interop-rsvpte/Dockerfile.freertr` moves
# ZE_SOURCE_COMMIT and ZE_SOURCE_DATE to upstream's latest master commit; the
# build then proves freertr/ze-interop-resv.patch still applies.
#
# The default (last) stage is the peer image of the `rsvpte` interop suite
# (internal/le/interoplab/rsvpte): Java 21, the jar, rawInt.bin bound to the
# container's eth0, and tcpdump, which records the RSVP the peer receives.
# `--target export` writes /peer for the root-only guest carrier instead.
# freeRouter, patched by freertr/ze-interop-resv.patch, and its unchanged
# interface helpers are CC BY-SA 4.0; retain /peer/NOTICE, /peer/source.tar.gz
# and /peer/ze-interop-resv.patch when redistributing these artifacts.
FROM alpine:3.24.3 AS build
ARG ZE_SOURCE_REPOSITORY=mc36/freeRtr
ARG ZE_SOURCE_COMMIT=96368b02da1030148d44fc1821e844deeba0a2f0
ARG ZE_SOURCE_DATE=2026-10-22T08:41:13Z
RUN apk add --no-cache ca-certificates curl openjdk21-jdk build-base linux-headers zip
WORKDIR /src/freertr
RUN curl --fail --location --output /tmp/source.tar.gz \
    "https://codeload.github.com/${ZE_SOURCE_REPOSITORY}/tar.gz/${ZE_SOURCE_COMMIT}" \
    && tar -xzf /tmp/source.tar.gz --strip-components=1
# The one source change: freertr/ze-interop-resv.patch adds three test knobs to
# the RESV an egress originates, each off unless its environment variable is
# set (FREERTR_ZE_RESV_RATE_AT, FREERTR_ZE_RESV_FF_EXTRA_SENDER,
# FREERTR_ZE_RESV_IMPLICIT_NULL). The unpatched jar has no way to raise a
# reservation in place, to name a sender it has no path for, or to distribute
# Implicit NULL, which the scenarios proving Ze's reaction to each need.
COPY freertr/ze-interop-resv.patch /tmp/ze-interop-resv.patch
RUN patch -p1 < /tmp/ze-interop-resv.patch
# Upstream src/compiler.txt selects --release 21 and compiles router.java's
# dependencies. src/cp.sh packages binOut with the upstream manifest.
WORKDIR /src/freertr/src
RUN mkdir -p ../binOut && javac @compiler.txt && sh cp.sh
WORKDIR /src/freertr
# Upstream misc/iface/c.sh uses pthreads for tapInt and rawInt; static musl
# permits the resulting executables to run directly in an Alpine guest.
RUN mkdir -p /peer \
    && cc -O2 -static -pthread -o /peer/tapInt.bin misc/iface/tapInt.c \
    && cc -O2 -static -pthread -o /peer/rawInt.bin misc/iface/rawInt.c \
    && cp src/rtr.jar /peer/rtr.jar \
    && cp /tmp/source.tar.gz /peer/source.tar.gz \
    && cp /tmp/ze-interop-resv.patch /peer/ze-interop-resv.patch \
    && cp readme.md /peer/upstream-readme.md \
    && cp src/org/freertr/util/version.java /peer/upstream-version.java \
    && printf '%s\n' "${ZE_SOURCE_COMMIT}" > /peer/REVISION
COPY NOTICE /peer/NOTICE
WORKDIR /peer
RUN sha256sum rtr.jar tapInt.bin rawInt.bin > SHA256SUMS
FROM scratch AS export
COPY --from=build /peer /peer
FROM alpine:3.24.3
RUN apk add --no-cache openjdk21-jre-headless iproute2 tcpdump tini
COPY --from=build /peer /peer
# The suite passes the start command (freeRtrScript in
# internal/le/interoplab/rsvpte/zenode.go) as the container command.
ENTRYPOINT ["tini", "--"]
