 public class rtrRsvpIface implements ipPrt {
 
     /**
+     * ze interop test only: RESVs this node originated as an egress
+     */
+    private static int zeResvCount;
+
+    /**
+     * ze interop test only: alter a RESV this node originates as an egress.
+     * FREERTR_ZE_RESV_RATE_AT=n:rate sends only the n-th RESV with its
+     * FLOWSPEC rate (bytes/s) raised in place, same session and sender.
+     * FREERTR_ZE_RESV_FF_EXTRA_SENDER=1 sends fixed-filter RESVs carrying a
+     * second flow descriptor for a sender that has no path state.
+     *
+     * @param pck packet to alter
+     */
+    private static void zeInteropResv(packRsvp pck) {
+        zeResvCount++;
+        String v = System.getenv("FREERTR_ZE_RESV_RATE_AT");
+        if (v != null) {
+            int i = v.indexOf(':');
+            if (zeResvCount == Integer.parseInt(v.substring(0, i))) {
+                pck.flwSpcRate = Float.parseFloat(v.substring(i + 1));
+                logger.info("ze interop: resv " + zeResvCount + " raised to " + pck.flwSpcRate);
+            }
+        }
+        if (System.getenv("FREERTR_ZE_RESV_FF_EXTRA_SENDER") != null) {
+            pck.styleVal = 10;
+            pck.zeExtraSender = true;
+        }
+    }
+
+    /**
      * counter
      */
     public counter cntr = new counter();
