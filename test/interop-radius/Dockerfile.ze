# Ze image for the RADIUS admin interop lab.
# Expects a pre-built linux binary at test/interop-radius/ze-linux, which the
# native suite cross-compiles before it builds this image.

FROM alpine:3.24.3

RUN apk add --no-cache tini iproute2 curl

COPY test/interop-radius/ze-linux /usr/local/bin/ze

RUN mkdir -p /var/lib/ze-web-store && printf 'interop-recovery\nInteropRecovery1!\n127.0.0.1\n2222\n' | ze_config_dir=/var/lib/ze-web-store /usr/local/bin/ze init

ENTRYPOINT ["tini", "--", "ze"]
