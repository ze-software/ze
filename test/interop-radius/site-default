# Ze RADIUS interop lab: the whole virtual server, written out.
#
# This replaces the shipped sites-enabled/default rather than editing it. The
# shipped file carries realms, proxying and accounting, none of which the
# admin-login path uses, and a reader of this lab must be able to see every step
# the server takes between the Access-Request and its reply.
#
# authorize runs chap before files so the chap module can set Auth-Type = CHAP
# from a CHAP-Password, and pap after files so it can read whatever password
# form the users file supplied. eap runs beside them and answers only a request
# carrying EAP-Message, so the PAP and CHAP scenarios pass through it untouched.
server default {
	listen {
		type = auth
		ipaddr = *
		port = 1812
	}

	authorize {
		preprocess

		# Tmp-String-0 and Tmp-String-1 record that a credential was PRESENT.
		# The values never enter the log: a fixture that printed the password
		# would teach the wrong thing, and the CHAP digest says nothing a reader
		# can check by eye. They are set here, before any branch, so every path
		# that logs has them.
		update request {
			&Tmp-String-0 := "absent"
			&Tmp-String-1 := "absent"
			&Tmp-String-2 := "absent"
		}
		if (&User-Password) {
			update request {
				&Tmp-String-0 := "present"
			}
		}
		if (&CHAP-Password) {
			update request {
				&Tmp-String-1 := "present"
			}
		}
		if (&EAP-Message) {
			update request {
				&Tmp-String-2 := "present"
			}
		}

		# A request carrying BOTH an EAP-Message and a State is the client
		# answering a challenge, and it is recorded here rather than in post-auth
		# because post-auth does not run for an Access-Challenge: the reply that
		# asked the question leaves no record of its own. RFC 2865 Section 5.24
		# makes the echo the client's obligation, so this line is the server's
		# evidence that ze carried the State back and that the login was a
		# conversation rather than one request.
		if (&EAP-Message && &State) {
			ze_state_echo_log
		}

		# localop is the lab's control account, and the server answers nothing
		# for it. Silence is deliberate: docs/guide/radius.md step 7 sends a
		# timeout to the next backend, while step 5 stops the chain on an
		# Access-Reject. A reject here would therefore leave no scenario able to
		# reach the local bcrypt backend at all, and a refused RADIUS login
		# could not be told apart from a broken SSH listener.
		#
		# The request is logged before the silence, so the checker reads
		# positive evidence that the server SAW it and chose not to answer.
		if (&User-Name == "localop") {
			ze_silent_log
			update control {
				&Response-Packet-Type := Do-Not-Respond
			}
			handled
		}

		chap

		# eap answers only a request carrying EAP-Message and returns noop for
		# every other one, so the PAP and CHAP scenarios pass through it
		# unchanged. "ok = return" ends authorize for an EAP conversation before
		# files and pap can set an Auth-Type of their own, which is what routes
		# the request to the eap module in authenticate.
		eap {
			ok = return
		}

		files
		pap
	}

	authenticate {
		Auth-Type PAP {
			pap
		}
		Auth-Type CHAP {
			chap
		}
		# EAP-MSCHAPv2 runs the peer's MS-CHAPv2 Response through the mschap
		# module as an inner request, so the eap module needs this section even
		# though nothing on the wire carries an MS-CHAP-Password attribute.
		#
		# The section is named after the MODULE INSTANCE, not after MS-CHAP, and
		# the difference is not cosmetic: rlm_eap_mschapv2 resolves the section
		# it runs with dict_valbyname(PW_AUTH_TYPE, 0, "MSCHAP") and falls back
		# to "MS-CHAP" only when that misses
		# (src/modules/rlm_eap/types/rlm_eap_mschapv2/rlm_eap_mschapv2.c:83 in
		# release_3_2_7). FreeRADIUS registers an Auth-Type value for every
		# module instance it loads, so "mschap" is already there and the
		# case-insensitive first lookup takes it. A section named MS-CHAP then
		# exists and is never reached, and the server answers a correct
		# NT-Response with "Auth-Type sub-section not found.  Ignoring." and an
		# EAP-Failure. Measured here on 2026-09-04.
		Auth-Type mschap {
			mschap
		}
		eap
	}

	post-auth {
		ze_request_log

		Post-Auth-Type REJECT {
			# RFC 2865 Section 5.11 gives Filter-Id a count of 0 in an
			# Access-Reject. The users file attaches it as a reply item during
			# authorize, which runs before the verdict is known, so this filter
			# removes it again on the reject path and keeps the lab's replies
			# conformant.
			attr_filter.access_reject
			ze_request_log
		}
	}
}
