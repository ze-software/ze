option=file:api-sr-policy.conf
# RFC 9830 Section 2.1: SR Policy NLRI in MP_REACH_NLRI, AFI 1 SAFI 73.
# RFC 9830 Section 4.2.1: "The SR Policy update MUST have either the
# NO_ADVERTISE community, at least one Route Target extended community in
# IPv4-address format, or both." ExaBGP 6.0 (pin f9bfb853b) refuses the
# announcement without one, so the route carries NO_ADVERTISE. The bytes are
# the pin's own (`--dut exabgp`).
1:cmd:announce ipv4 sr-policy distinguisher 0 color 300 endpoint 10.0.0.3 next-hop 192.0.2.1 preference 300 segment-list weight 1 segment type-a mpls 16001 segment-list weight 2 segment type-a mpls 16002 community [ no-advertise ]
1:raw:FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF007C0200000065800E1600014904C00002010060000000000000012C0A0000034001010040020040050400000064C00804FFFFFF02C01734000F00300C0600000000012C8000110009060000000000010106000003E810008000110009060000000000020106000003E82000
1:cmd:announce eor ipv4 sr-policy
1:raw:FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF001E0200000007900F0003000149
# The withdrawal is MP_UNREACH_NLRI carrying the same NLRI, followed by ORIGIN,
# AS_PATH and LOCAL_PREF. ExaBGP 6.0 (pin f9bfb853b, `--dut exabgp`) sends these
# bytes: UpdateCollection._attribute_sets drops the attributes only when every MP
# withdrawal is unicast or multicast, and api-flow.ci pins the same shape for
# FlowSpec. RFC 4760 Section 4 allows both shapes.
1:cmd:withdraw ipv4 sr-policy distinguisher 0 color 300 endpoint 10.0.0.3
1:raw:FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF:0038:02:00000021800F1000014960000000000000012C0A0000034001010040020040050400000064
