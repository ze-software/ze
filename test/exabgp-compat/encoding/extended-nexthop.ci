option=file:extended-nexthop.conf
1:cmd:announce route 153.153.153.153/32 next-hop bad:cafe:bad:cafe:bad:cafe:bad:cafe origin igp local-preference 100
1:raw:FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF:0042:02:0000002B4001010040020040050400000064800E1A000101100BADCAFE0BADCAFE0BADCAFE0BADCAFE002099999999
1:json:{"exabgp":"6.0.0","type":"update","neighbor":{"address":{"local":"127.0.0.1","peer":"127.0.0.1"},"asn":{"local":12345,"peer":12345},"router-id":"127.0.0.2","direction":"in","message":{"update":{"attribute":{"origin":"igp","local-preference":100},"announce":{"ipv4 unicast":{"bad:cafe:bad:cafe:bad:cafe:bad:cafe":[{"nlri":"153.153.153.153/32"}]}}}}}}
# RFC 2545 Section 3: "The value of the Length of Next Hop Network Address
# field on a MP_REACH_NLRI attribute shall be set to 16, when only a global
# address is present, or 32 if a link-local address is also included".
# ExaBGP's four-octet AFI 2 field is not defined. RFC 8950 Section 1 names the
# defined form for IPv6 NLRI with an IPv4 next hop: RFC 4798 "defines how the
# IPv4-mapped IPv6 address format ... can be used for that purpose". FRR and
# BIRD both send that sixteen-octet mapped field, and Ze does not map
# automatically (d3e5b4a770), so the config writes ::ffff:170.170.170.170.
1:cmd:announce ipv6 unicast dead:beef:dead:beef:dead:beef:dead:beef/128 next-hop ::ffff:170.170.170.170 origin igp local-preference 100
1:raw:FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF:004E:02:000000374001010040020040050400000064800E260002011000000000000000000000FFFFAAAAAAAA0080DEADBEEFDEADBEEFDEADBEEFDEADBEEF
1:json:{"exabgp":"6.0.0","type":"update","neighbor":{"address":{"local":"127.0.0.1","peer":"127.0.0.1"},"asn":{"local":12345,"peer":12345},"router-id":"127.0.0.2","direction":"in","message":{"update":{"attribute":{"origin":"igp","local-preference":100},"announce":{"ipv6 unicast":{"::ffff:170.170.170.170":[{"nlri":"dead:beef:dead:beef:dead:beef:dead:beef/128"}]}}}}}}
