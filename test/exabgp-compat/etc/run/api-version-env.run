#!/usr/bin/env python3
"""AC-10: exabgp.api.version=4 in the environment holds the helper to API 4 from
its start, so its FIRST line, a v6 one that would otherwise hold it to 6, is
answered error and reaches no peer."""

import sys
import time


def send(command: str) -> None:
    sys.stdout.write(command + '\n')
    sys.stdout.flush()


def answer() -> list[str]:
    """The lines the bridge wrote for one command, up to and including its done or error."""
    lines = []
    while True:
        line = sys.stdin.readline()
        if not line:
            sys.stderr.write('ERROR: stdin closed\n')
            sys.exit(1)
        line = line.strip()
        lines.append(line)
        # `error: <why>` is a detail line before the marker; ze still writes
        # its refusal as one `error <why>` line, which ends the answer too.
        if line in ('done', 'error') or line.startswith('error '):
            return lines


def expect(command: str, check, what: str) -> None:
    send(command)
    got = answer()
    if not check(got):
        sys.stderr.write(f'ERROR: {command!r} answered {got!r}, want {what}\n')
        sys.exit(1)


def main() -> None:
    time.sleep(0.2)  # let the EOR pass
    expect('peer * announce route 2.2.2.2/32 next-hop 22.22.22.22', lambda a: a[-1].startswith('error'), 'error')
    expect('api version', lambda a: a == ['API version: 4 (this helper: 4)', 'done'], 'API version: 4 (this helper: 4)')
    # Reached only when every answer above was ExaBGP's: the wire proves it.
    expect('announce route 1.1.1.1/32 next-hop 11.11.11.11', lambda a: a == ['done'], 'done')
    sys.stderr.write('SUCCESS\n')
    while sys.stdin.readline():
        pass


if __name__ == '__main__':
    main()
