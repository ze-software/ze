#!/usr/bin/env python3
"""MUP routes whose leading field is an address, sent on the API as the pin sends them.

ExaBGP writes the field after the route type bare: an ip prefix for mup-isd and
mup-t1st, an ip address for mup-dsd and an endpoint address for mup-t2st (the
grammar comments in configuration/static/mpls.py, 5.0.1). ze's MUP encoder reads
the address under the keyword `address` (nlri/mup/encode.go), so a DSD or T2ST
line the bridge named `prefix` was refused with "requires address".
The bytes expected are the ones the same routes produce from the configuration
(encoding/conf-srv6-mup.ci)."""


import sys
import time


def send(command: str) -> None:
    sys.stdout.write(command + '\n')
    sys.stdout.flush()


def read() -> str:
    line = sys.stdin.readline()
    if not line:
        sys.stderr.write('ERROR: stdin closed\n')
        sys.exit(1)
    return line.strip()


def answer() -> list[str]:
    """The lines the bridge wrote for one command, up to and including its done or error."""
    lines = []
    while True:
        lines.append(read())
        if lines[-1] in ('done', 'error'):
            return lines


def expect_done(command: str) -> None:
    send(command)
    got = answer()
    if got != ['done']:
        sys.stderr.write(f'ERROR: {command!r} answered {got!r}, want done\n')
        sys.exit(1)


def main() -> None:
    time.sleep(0.2)  # let the EOR pass
    # The wire carries a Direct Segment Discovery route for 10.0.0.1 in rd 100:100.
    expect_done('announce ipv4 mup mup-dsd 10.0.0.1 rd 100:100 next-hop 2001::2 extended-community [target:10:10 mup:10:10] bgp-prefix-sid-srv6 ( l3-service 2001:db8:1:1:: 0x13 [64,24,16,0,0,0] )')
    # The wire carries a Type 2 Session Transformed route for endpoint 10.0.0.1, teid 12345/32.
    expect_done('announce ipv4 mup mup-t2st 10.0.0.1 rd 100:100 teid 12345/32 next-hop 10.0.0.2 extended-community [target:10:10 mup:10:10]')
    sys.stderr.write('SUCCESS\n')
    while sys.stdin.readline():
        pass


if __name__ == '__main__':
    main()
