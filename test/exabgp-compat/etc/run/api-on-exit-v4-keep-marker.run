#!/usr/bin/env python3
"""The sibling of api-on-exit-v4-keep: it waits for the one-shot helper to have exited, then
announces the route that closes the recording."""

import sys
import time


def send(command: str) -> None:
    sys.stdout.write(command + '\n')
    sys.stdout.flush()


def answer() -> list[str]:
    """The lines the bridge wrote for one command, up to and including its done or error."""
    lines = []
    while True:
        line = sys.stdin.readline()
        if not line:
            sys.stderr.write('ERROR: stdin closed\n')
            sys.exit(1)
        line = line.strip()
        lines.append(line)
        # `error: <why>` is a detail line before the marker, so only the
        # marker ends the answer.
        if line in ('done', 'error'):
            return lines


def expect(command: str, check, what: str) -> None:
    send(command)
    got = answer()
    if not check(got):
        sys.stderr.write(f'ERROR: {command!r} answered {got!r}, want {what}\n')
        sys.exit(1)


def main() -> None:
    time.sleep(3)  # the one-shot helper has exited by now
    expect('announce route 2.2.2.2/32 next-hop 22.22.22.22', lambda a: a == ['done'], 'done')
    sys.stderr.write('SUCCESS\n')
    for _ in sys.stdin:
        pass


if __name__ == '__main__':
    main()
