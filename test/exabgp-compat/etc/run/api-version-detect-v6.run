#!/usr/bin/env python3
"""X-1, X-2, X-3, X-5: the first deciding line, `peer * announce`, holds the helper to API 6,
so its later v4 line is answered error, and it is answered in JSON though its encoder is text."""

import sys
import time


def send(command: str) -> None:
    sys.stdout.write(command + '\n')
    sys.stdout.flush()


def answer() -> list[str]:
    """The lines the bridge wrote for one command, up to and including its done or error."""
    lines = []
    while True:
        line = sys.stdin.readline()
        if not line:
            sys.stderr.write('ERROR: stdin closed\n')
            sys.exit(1)
        line = line.strip()
        lines.append(line)
        # `error: <why>` is a detail line before the marker, so only the
        # marker ends the answer.
        if line in ('done', 'error'):
            return lines


def expect(command: str, check, what: str) -> None:
    send(command)
    got = answer()
    if not check(got):
        sys.stderr.write(f'ERROR: {command!r} answered {got!r}, want {what}\n')
        sys.exit(1)


def main() -> None:
    time.sleep(0.2)  # let the EOR pass
    expect('peer * announce route 1.1.1.1/32 next-hop 11.11.11.11', lambda a: a == ['done'], 'done')
    expect('announce route 2.2.2.2/32 next-hop 22.22.22.22', lambda a: a[-1].startswith('error'), 'error')
    expect(
        'system api version',
        lambda a: a == ['{"api_version": "auto", "helper_api_version": "6"}', 'done'],
        'the JSON answer naming 6',
    )
    expect('peer * announce route 3.3.3.3/32 next-hop 33.33.33.33', lambda a: a == ['done'], 'done')
    sys.stderr.write('SUCCESS\n')
    while sys.stdin.readline():
        pass


if __name__ == '__main__':
    main()
