#!/usr/bin/env python3
"""X-16 (AC-18 to AC-20): a `group start` block holds its routes until `group end`, which
sends them in one UPDATE and answers what it applied; a line that cannot be applied makes the
end answer its count and error; a nested start and a stray end are refused."""

import sys
import time


def send(command: str) -> None:
    sys.stdout.write(command + '\n')
    sys.stdout.flush()


def answer() -> list[str]:
    """The lines the bridge wrote for one command, up to and including its done or error."""
    lines = []
    while True:
        line = sys.stdin.readline()
        if not line:
            sys.stderr.write('ERROR: stdin closed\n')
            sys.exit(1)
        line = line.strip()
        lines.append(line)
        # `error: <why>` is a detail line before the marker, so only the
        # marker ends the answer.
        if line in ('done', 'error'):
            return lines


def expect(command: str, check, what: str) -> None:
    send(command)
    got = answer()
    if not check(got):
        sys.stderr.write(f'ERROR: {command!r} answered {got!r}, want {what}\n')
        sys.exit(1)


def main() -> None:
    time.sleep(0.2)  # let the EOR pass
    expect('group start', lambda a: a == ['group started', 'done'], ['group started', 'done'])
    expect('announce route 1.1.1.1/32 next-hop 11.11.11.11', lambda a: a == ['done'], ['done'])
    expect('announce route 2.2.2.2/32 next-hop 11.11.11.11', lambda a: a == ['done'], ['done'])
    expect('group end', lambda a: a == ['group processed: 2 announced, 0 withdrawn', 'done'], ['group processed: 2 announced, 0 withdrawn', 'done'])
    expect('group start', lambda a: a == ['group started', 'done'], ['group started', 'done'])
    expect('group start', lambda a: a == ['error: already in group block (nested groups not allowed)', 'error'], ['error: already in group block (nested groups not allowed)', 'error'])
    expect('announce route 3.3.3.3/32 next-hop 11.11.11.11', lambda a: a == ['done'], ['done'])
    expect('announce route 3.3.3.4/32 next-hop 11.11.11.11 frobnicate 1', lambda a: a == ['done'], ['done'])
    expect('group end', lambda a: a == ['group processed: 1 announced, 0 withdrawn, 1 errors', 'error'], ['group processed: 1 announced, 0 withdrawn, 1 errors', 'error'])
    expect('group end', lambda a: a == ['error: not in group block', 'error'], ['error: not in group block', 'error'])
    expect('group start', lambda a: a == ['group started', 'done'], ['group started', 'done'])
    expect('group end', lambda a: a == ['group ended (0 commands)', 'done'], ['group ended (0 commands)', 'done'])
    sys.stderr.write('SUCCESS\n')
    for _ in sys.stdin:
        pass


if __name__ == '__main__':
    main()
