#!/usr/bin/env python3
"""X-26, X-27 (AC-32, AC-33): how ExaBGP 6's API reads a route line that repeats an attribute.

A repeated attribute that is not a list keeps its first value, a community list given twice
is merged as the pin merges it (add_attribute, configuration/grammar/tree/static.py), and a
split shorter than the prefix sends the prefix whole; each line is done. The same case holds
the two other forms the pin's configuration lexer decides for a route line: its backslash
escapes are resolved before it is split into words, and an SRv6 service group that names
no endpoint behavior is sent with the opaque behavior 0xFFFF."""


import sys
import time


def send(command: str) -> None:
    sys.stdout.write(command + '\n')
    sys.stdout.flush()


def read() -> str:
    line = sys.stdin.readline()
    if not line:
        sys.stderr.write('ERROR: stdin closed\n')
        sys.exit(1)
    return line.strip()


def answer() -> list[str]:
    """The lines the bridge wrote for one command, up to and including its done or error."""
    lines = []
    while True:
        lines.append(read())
        if lines[-1] in ('done', 'error'):
            return lines


def expect(command: str, check, what: str) -> None:
    send(command)
    got = answer()
    if not check(got):
        sys.stderr.write(f'ERROR: {command!r} answered {got!r}, want {what}\n')
        sys.exit(1)


def main() -> None:
    time.sleep(0.2)  # let the EOR pass
    # The wire carries NEXT_HOP 1.1.1.1: the first next-hop is kept.
    expect('announce route 10.0.0.0/24 next-hop 1.1.1.1 next-hop 2.2.2.2', lambda a: a == ['done'], 'done')
    # The wire carries 10.0.1.0/24 whole: /23 cuts nothing.
    expect('announce route 10.0.1.0/24 next-hop 1.1.1.1 split /23', lambda a: a == ['done'], 'done')
    # The wire carries COMMUNITIES 1:1 2:2 3:3: the second list is merged into the first.
    expect('announce route 10.0.2.0/24 next-hop 1.1.1.1 community 1:1 community [ 2:2 3:3 ]',
           lambda a: a == ['done'], 'done')
    # The script writes a backslash and an n: the wire carries MED 100, as `\n` ends the word.
    expect('announce route 10.0.3.0/24 next-hop 1.1.1.1 med 100\\n', lambda a: a == ['done'], 'done')
    # The wire carries the SRv6 SID with behavior 0xFFFF (RFC 9252 Section 3.1, opaque).
    expect('announce route 10.0.4.0/24 next-hop 1.1.1.1 bgp-prefix-sid-srv6 ( l3-service 2001:db8:1:1:: )',
           lambda a: a == ['done'], 'done')
    sys.stderr.write('SUCCESS\n')
    while sys.stdin.readline():
        pass


if __name__ == '__main__':
    main()
