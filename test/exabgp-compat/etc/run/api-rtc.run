#!/usr/bin/env python3
"""ExaBGP 6.0's `announce ipv4 rtc` forms (RFC 4684): a membership, the default
membership, and the withdrawal of each.

The default membership names its next hop rather than `self`: on this loopback
session `self` is the peer's own address, which Ze withholds (RFC 4271 Section
5.1.3), as api-nexthop-self records."""

import time

from exabgp_api import send, wait_for_ack, wait_for_shutdown


def main() -> None:
    messages = [
        'neighbor 127.0.0.1 announce ipv4 rtc origin-as 65000 route-target 65000:1 next-hop 192.0.2.1',
        'neighbor 127.0.0.1 announce ipv4 rtc default next-hop 192.0.2.1',
        'neighbor 127.0.0.1 withdraw ipv4 rtc origin-as 65000 route-target 65000:1',
        'neighbor 127.0.0.1 withdraw ipv4 rtc default',
    ]

    time.sleep(0.2)  # let the EOR pass

    for message in messages:
        send(message)
        time.sleep(0.2)

    wait_for_ack(expected_count=4)
    wait_for_shutdown()


if __name__ == '__main__':
    main()
