#!/usr/bin/env python3
"""An API route that names a watchdog is the watchdog's, as a configured one is (ExaBGP c43f90f79).

announce_route gives the route to add_to_rib_watchdog with its owner: without `withdraw` it is
sent now, with `withdraw` it is held until `announce watchdog <name>`, and `withdraw watchdog
<name>` withdraws it. A route with `withdraw` and no watchdog is announced. The route stays the
helper's: when the helper exits, its routes are withdrawn and taken off the watchdog, so the
route still held under `gone` is never sent. Every frame the case names is checked, and a frame
it does not name fails it."""


import sys
import time


def send(command: str) -> None:
    sys.stdout.write(command + '\n')
    sys.stdout.flush()


def read() -> str:
    line = sys.stdin.readline()
    if not line:
        sys.stderr.write('ERROR: stdin closed\n')
        sys.exit(1)
    return line.strip()


def answer() -> list[str]:
    """The lines the bridge wrote for one command, up to and including its done or error."""
    lines = []
    while True:
        lines.append(read())
        if lines[-1] in ('done', 'error'):
            return lines


def expect_done(command: str) -> None:
    send(command)
    got = answer()
    if got != ['done']:
        sys.stderr.write(f'ERROR: {command!r} answered {got!r}, want done\n')
        sys.exit(1)


def main() -> None:
    time.sleep(0.2)  # let the EOR pass
    # Given to dnsr and sent now: the wire carries 10.0.4.0/24.
    expect_done('announce route 10.0.4.0/24 next-hop 1.1.1.1 watchdog dnsr')
    # The watchdog withdraws it, then announces it again.
    expect_done('withdraw watchdog dnsr')
    # sleep: ExaBGP answers done once the RIB holds the change, before the wire does, and
    # its outgoing RIB folds a withdrawal and a re-announce of one prefix that meet in one
    # flush into nothing (1 run in 2 at f9bfb853b). No answer tells the helper the
    # withdrawal left, so the helper waits one flush before it announces again.
    time.sleep(0.2)
    expect_done('announce watchdog dnsr')
    # Given to dnsr held: nothing on the wire until the watchdog is announced, which sends
    # 10.0.5.0/24 alone, 10.0.4.0/24 being announced already.
    expect_done('announce route 10.0.5.0/24 next-hop 1.1.1.1 watchdog dnsr withdraw')
    expect_done('announce watchdog dnsr')
    # `withdraw` under no watchdog holds nothing: the wire carries 10.0.6.0/24.
    expect_done('announce route 10.0.6.0/24 next-hop 1.1.1.1 withdraw')
    # Held under gone, which is never announced: the exit takes it off the watchdog unsent.
    expect_done('announce route 10.0.7.0/24 next-hop 1.1.1.1 watchdog gone withdraw')
    time.sleep(0.5)  # let the last frames leave before the exit withdraws them
    sys.stderr.write('SUCCESS\n')


if __name__ == '__main__':
    main()
