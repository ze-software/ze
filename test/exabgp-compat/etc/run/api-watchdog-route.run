#!/usr/bin/env python3
"""An API route that names a watchdog is sent at once, as ExaBGP 4.2, 5.0 and the 6.0 pin send it.

ExaBGP holds a route under a watchdog only when the route comes from the configuration
(add_to_rib_watchdog). An API route goes through add_to_rib, which never reads the watchdog
or the `withdraw` flag, so `withdraw watchdog <name>` and `announce watchdog <name>` do not
move it. Each route below is on the wire once, and the watchdog commands between them send
nothing: a frame the case does not name fails it."""


import sys
import time


def send(command: str) -> None:
    sys.stdout.write(command + '\n')
    sys.stdout.flush()


def read() -> str:
    line = sys.stdin.readline()
    if not line:
        sys.stderr.write('ERROR: stdin closed\n')
        sys.exit(1)
    return line.strip()


def answer() -> list[str]:
    """The lines the bridge wrote for one command, up to and including its done or error."""
    lines = []
    while True:
        lines.append(read())
        if lines[-1] in ('done', 'error'):
            return lines


def expect_done(command: str) -> None:
    send(command)
    got = answer()
    if got != ['done']:
        sys.stderr.write(f'ERROR: {command!r} answered {got!r}, want done\n')
        sys.exit(1)


def main() -> None:
    time.sleep(0.2)  # let the EOR pass
    # The wire carries 10.0.4.0/24 now: the watchdog holds an API route back from nothing.
    expect_done('announce route 10.0.4.0/24 next-hop 1.1.1.1 watchdog dnsr')
    # Neither command moves the API route, so the wire carries nothing for them.
    expect_done('withdraw watchdog dnsr')
    expect_done('announce watchdog dnsr')
    # The wire carries 10.0.5.0/24 now: the `withdraw` flag is read by the configuration's
    # watchdog alone.
    expect_done('announce route 10.0.5.0/24 next-hop 1.1.1.1 watchdog dnsr withdraw')
    sys.stderr.write('SUCCESS\n')
    while sys.stdin.readline():
        pass


if __name__ == '__main__':
    main()
