#!/usr/bin/env python3

import time

from exabgp_api import counters, send, trace, wait_for_ack

# the neighbor has 1.1.1.1/32 in its static block; the script announces the same
# prefix with another next hop, which replaces it, and exits: without on-exit an
# API 6 helper has its routes withdrawn, and a route which replaced a configured one
# gives it back rather than leaving the prefix unannounced (withdraw_owner,
# rib/outgoing.py), so the peer sees the configured route again, never a withdrawal
BARRIER_TIMEOUT = 20.0


def barrier(what: str, expected_count: int = 1, **events) -> None:
    if wait_for_ack(expected_count=expected_count, timeout=BARRIER_TIMEOUT, **events):
        trace(f'{what} ok')
        return
    raise SystemExit(f'{what} never happened, saw {counters()}')


def main() -> None:
    barrier('the session coming up', expected_count=0, state=(('up', 1),))
    send('peer * announce route 1.1.1.1/32 next-hop 11.11.11.11')
    # the replacement must be on the wire before the exit gives the prefix back
    time.sleep(3)
    trace('exiting')


if __name__ == '__main__':
    main()
