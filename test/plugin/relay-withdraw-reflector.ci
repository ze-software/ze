# Test: RFC 4456 reflection adds no attribute to a relayed withdrawal
# VALIDATES: RFC 4271 Section 4.3 -- "An UPDATE message might advertise only
#            routes that are to be withdrawn from service, in which case the
#            message will not include path attributes or Network Layer
#            Reachability Information." A route reflector reflects no route on
#            such a message, so it must add nothing to it.
#
# PREVENTS: forwardUpdateCore (internal/component/bgp/reactor/reactor_api_forward.go)
#           recording Op(9, AttrModSet) and Op(10, AttrModPrepend) on the
#           iBGP rail with no question asked about whether the UPDATE reflects
#           anything. originatorIDHandler and clusterListHandler
#           (internal/component/bgp/reactor/filter_delta_handlers.go) both CREATE
#           their attribute when the source carries none, so before advertiseGate
#           (forward_build.go) every withdrawal reflected between clients reached
#           them carrying ORIGINATOR_ID and CLUSTER_LIST and nothing else -- no
#           ORIGIN, no AS_PATH, no NEXT_HOP. RFC 4456 Section 8 conditions both
#           obligations on reflecting a ROUTE: "When an RR reflects a route, it
#           MUST prepend the local CLUSTER_ID to the CLUSTER_LIST."
#
# WHY A .ci AND NOT ONLY THE INTEROP SCENARIO. This runs in the verify tier.
# test/interop/scenarios/bgp-relay-withdraw-reflector-frr proves the same property
# with FRR 10.3.1 as the route's source, but interop is the nightly tier, so
# without this file the daemon's own wire output for the RFC 4456 producer is
# proven only by unit tests. relay-withdraw-nexthop-self.ci does not cover it:
# its sessions are external, and forwardUpdateCore records Op(9)/Op(10) only when
# the source is internal and the destination is not external.
#
# NON-VACUITY (ai/rules/interop-and-goal-validation.md). An assertion that an
# attribute is ABSENT passes when the mechanism that adds it is deleted. So the
# POSITIVE and the NEGATIVE run on the SAME session to the SAME peer in one run:
# dest seq=1 requires the reflected ADVERTISEMENT to carry ORIGINATOR_ID 7F000001
# and CLUSTER_LIST 0A000001, and dest seq=2 requires the reflected WITHDRAWAL to
# carry no attribute at all. A build where reflection never fires reddens seq=1;
# a build without the gate reddens seq=2. Neither red can be reached by the peer
# having disconnected: the observer proves each message was written to the dest
# before releasing the next.

# Source peer -- an RR client (iBGP, ASN 65000) on 127.0.0.1. Its BGP identifier
# is pinned so ORIGINATOR_ID's value is an exact number rather than whatever the
# peer defaulted to.
stdin=source:terminator=EOF_SOURCE
option=tcp_connections:value=1
option=timeout:value=30s
option=open:value=router-id:id=127.0.0.1
# The source must outlive the dest's assertions: the two sessions establish
# independently and a source that closes makes ze withdraw its routes, which
# would deliver the dest a withdrawal it never asked for.
option=linger:value=true
# seq=1 -- advertise 10.0.0.0/24: ORIGIN=IGP, empty AS_PATH (iBGP), NEXT_HOP=1.1.1.1,
# LOCAL_PREF=100.
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00300200000015400101004002004003040101010140050400000064180A0000
# seq=2 -- BARRIER, not an assertion. The observer injects 192.0.2.0/24 to THIS
# peer only, and only after ze has already written the dest the advertisement.
# Without it the withdrawal below races the dest's establishment, and a dest that
# is not yet a forward target sees neither message.
expect=bgp:conn=1:seq=2:contains=18C00002
# seq=3 -- withdraw 10.0.0.0/24. withdrawnLen=4, attrLen=0.
action=send:conn=1:seq=3:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF001B020004180A00000000
EOF_SOURCE

# Dest peer -- the other RR client (iBGP, ASN 65000) on 127.0.0.2. The wire
# assertions live here.
stdin=dest:terminator=EOF_DEST
option=tcp_connections:value=1
option=timeout:value=30s
# seq=1 POSITIVE -- the reflected advertisement MUST carry both attributes RFC
# 4456 Section 8 owes it: ORIGINATOR_ID (code 9) holding the source client's BGP
# identifier 127.0.0.1, and CLUSTER_LIST (code 10) holding the configured
# cluster-id 10.0.0.1. This is what proves reflection is engaged; without it
# seq=2 below would pass on a build where the reflector never ran at all.
expect=bgp:conn=1:seq=1:contains=8009047F000001800A040A000001
# seq=2 NEGATIVE -- the reflected withdrawal, BYTE-IDENTICAL to what the source
# sent: attrLen=0000, no attribute of any code. A stamped withdrawal reads
# attrLen=000E with 8009047F000001800A040A000001, and this exact-hex rule
# refuses it.
expect=bgp:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF001B020004180A00000000
EOF_DEST

# ze (ASN 65000) as a route reflector with two clients on separate loopbacks.
# cluster-id is pinned rather than defaulted so the dest's CLUSTER_LIST assertion
# is an exact number.
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	internal adj-rib-in {
		use bgp-adj-rib-in
	}
	internal rs {
		use bgp-rs
	}
	external relay-rr {
		run "ze-test fixture plugin/relay-withdraw-reflector"
		encoder json
	}
}
bgp {
	peer source-peer {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65000
			}
			router-id 1.2.3.4
			route-reflector-client true
			cluster-id 10.0.0.1
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
		}
		attach process relay-rr {
			send [ update ]
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
		attach process adj-rib-in {
			receive [ update-received state ]
			send [ update ]
		}
	}

	peer dest-peer {
		connection {
			remote {
				ip 127.0.0.2
			}
			local {
				ip 127.0.0.2
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65000
			}
			router-id 1.2.3.4
			# The subject of this test. Every UPDATE reflected to this client has
			# an ORIGINATOR_ID and a CLUSTER_LIST operation recorded against it
			# by forwardUpdateCore.
			route-reflector-client true
			cluster-id 10.0.0.1
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
		attach process adj-rib-in {
			receive [ update-received state ]
			send [ update ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=source
cmd=background:seq=2:exec=ze-peer --bind 127.0.0.2 --port $PORT:stdin=dest
cmd=foreground:seq=3:exec=ze -:stdin=ze-bgp:timeout=30s
expect=exit:code=0
reject=stderr:pattern=panic recovered
reject=stderr:pattern=fatal error
reject=stderr:pattern=ZE-OBSERVER-FAIL
