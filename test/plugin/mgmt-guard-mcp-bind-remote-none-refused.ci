# Test: MCP bind-remote with auth-mode none leaves MCP down at daemon startup
# VALIDATES: the owner ruling of 2026-11-26 (plan/records/ruling-ze-always-starts.md)
# and spec-fixit-mgmt-listener-auth-guard AC-2(a) -- MCPListenConfig.Validate
# rejects `bind-remote true` with `auth-mode none`. At daemon start, `ze`
# runs that check, keeps running without MCP, and reports the refusal under
# doctor-service-not-started; `ze config validate` and reloads keep refusing it.
# PREVENTS: an inconsistent `environment.mcp` block booting an accept-all
# server or taking down the rest of `ze`.

option=exclusive:group=mgmt-guard

stdin=ze-bgp:terminator=EOF_CONF
environment {
	mcp {
		enabled true
		bind-remote true
		auth-mode none
		server main {
			ip 127.0.0.1
			port 18082
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze -:stdin=ze-bgp:name=daemon:ready=Ze running:timeout=15s
expect=stderr:contains=the MCP server is not started; ze and its other services keep running
expect=stderr:contains=environment.mcp: bind-remote requires auth-mode != none
expect=stderr:contains=code=doctor-service-not-started
reject=stderr:contains=MCP server listening
cmd=stop:seq=2:name=daemon:signal=term
