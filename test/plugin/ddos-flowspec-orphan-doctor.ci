# Runs the fix exactly as `ze doctor` printed it. The text report's `fix:` line
# is the raw command, quotes included (doctor-local-asks-daemon.ci asserts the
# form), so eval runs what an operator would paste. The script's `ze` is this
# run's binary (the runner's shim directory is first on every child's PATH).
tmpfs=run-fix.sh:terminator=EOF_SCRIPT
#!/bin/sh
set -eu
fix=$(ze doctor | sed -n 's/^[[:space:]]*fix: //p' | grep -F 'plugin restart ddos-flowspec' | head -n 1)
if [ -z "$fix" ]; then
	echo "FIX-MISSING: ze doctor printed no FlowSpec plugin restart fix" >&2
	exit 1
fi
echo "FIX-RUN: $fix" >&2
eval "$fix"
EOF_SCRIPT

# Corrects the cause of the failed withdrawal: the peer attaches ddos-flowspec
# again. The daemon reads running2.conf, so the first daemon's file, which holds
# the attach block, is copied over it and the daemon is asked to reload. The
# attach change restarts the session, so the script returns only once the peer
# is established again (show bgp, peers-established).
tmpfs=fix-cause.sh:terminator=EOF_CAUSE
#!/bin/sh
set -eu
cp running.conf running2.conf
ze request reload
le test fixture daemon/await-answer '"peers-established": 1' 'show bgp | json'
EOF_CAUSE

cmd=foreground:seq=1:exec=le test fixture plugin/ddos-transit-forward-drop-setup
cmd=background:seq=2:exec=le test peer --port $PORT:stdin=peer
cmd=background:seq=3:exec=ze start running.conf:name=first:ready=Ze running.
cmd=foreground:seq=4:exec=le test fixture plugin/ddos-flowspec-orphan-flood:exit=0
expect=stderr:contains=FLOWSPEC-RECORDED 203.0.113.9/32
cmd=stop:seq=5:name=first:signal=kill

cmd=background:seq=6:exec=ze start running2.conf:name=second:ready=Ze running.
expect=stderr:contains=ddos-flowspec: a previous run left a FlowSpec rule announced, withdrawing it
expect=stderr:contains=ddos-flowspec: the withdrawal of a FlowSpec rule a previous run announced failed, so the rule may still be at the BGP peers and stays recorded
# After doctor's fix: the engine received the withdrawal and withheld it from
# a session that never carried the rule (reactor_api_batch.go logWithdrawWithheld).
expect=stderr:contains=withdrawal withheld: this session has advertised no route to the peer

cmd=foreground:seq=7:exec=le test fixture daemon/await-answer doctor-ddos-flowspec-orphan-announcement "show doctor | json":exit=0

cmd=foreground:seq=8:exec=ze cli -c "show doctor | json":exit=0
expect=stdout:contains="code": "doctor-ddos-flowspec-orphan-announcement"
expect=stdout:contains=ddos-flowspec holds the record of a FlowSpec rule it announced for 203.0.113.9/32, and no running responder holds that rule as its live announcement
expect=stdout:contains="fix": "ze request plugin restart ddos-flowspec"

cmd=foreground:seq=9:exec=sh fix-cause.sh:exit=0

cmd=foreground:seq=10:exec=sh run-fix.sh:exit=0
expect=stderr:contains=FIX-RUN: ze request plugin restart ddos-flowspec
reject=stderr:contains=FIX-MISSING

cmd=foreground:seq=11:exec=le test fixture plugin/ddos-flowspec-orphan-cleared:exit=0
expect=stderr:contains=FLOWSPEC-REPORT-CLEARED 203.0.113.9/32

# The second daemon is stopped so the test ends: the peer holds connection 3
# open until the remote closes it (option=linger), and nothing else closes it.
# SIGTERM is a clean stop; the plugin holds no live rule by now, so its exit
# path has nothing to withdraw, and the two rejects on connection 3 cover the
# teardown as well.
cmd=stop:seq=12:name=second:signal=term
