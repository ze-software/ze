# Question: does a running Ze daemon refuse a correct password over SSH when
# the account's login-service set excludes ssh (identically to a wrong password,
# recording one auth-fail audit entry, incrementing ze_aaa_login_service_refused_total,
# and leaving config unchanged) while admitting the exact same account and
# credential on REST under its command authorization profile?
# Why a unit test cannot decide it: only a running daemon exercises SSH password
# callback wiring, the AAA wrapper, REST private API auth, audit recording, and
# Prometheus metric export together on one accepted generation.
#
# VALIDATES: AC-2, AC-3, AC-4 -- SSH password refusal, REST admission, audit + metric, profile enforcement
# PREVENTS: SSH password logins bypassing system/authorization/login-service

option=timeout:value=45s
option=env:var=ze.log.aaa:value=info

tmpfs=ssh-password.conf:terminator=EOF_CONF
system {
	authentication {
		user admin {
			password "$2a$04$UlwuiuH82Unfsq.XEMPGJeDkXwbm3KW.nvVaVXOd/JeFK8VjMjrQO"
			profile [ admin ]
		}
		user apiop {
			password "$2a$04$UlwuiuH82Unfsq.XEMPGJeDkXwbm3KW.nvVaVXOd/JeFK8VjMjrQO"
			profile [ read-only ]
			login-service api-only
		}
	}
	authorization {
		profile admin {
			run { default-action allow }
			edit { default-action allow }
		}
		profile read-only {
			run {
				default-action deny
				entry 10 { action allow; match "show version"; }
			}
			edit { default-action deny }
		}
		login-service api-only {
			service [ rest ]
		}
	}
}
environment {
	ssh {
		enabled true
		server main { ip 127.0.0.1; port $PORT; }
	}
	api-server {
		rest {
			enabled true
			server main { ip 127.0.0.1; port $PORT2; }
		}
	}
}
telemetry {
	prometheus {
		enabled true
		server main { ip 127.0.0.1; port $PORT3; }
		netdata { enabled false; }
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze start ssh-password.conf:name=daemon:ready=Ze running.
cmd=foreground:seq=2:exec=le test fixture plugin/login-service-ssh-password $PORT $PORT2 $PORT3:timeout=35s
expect=exit:code=0
expect=stderr:contains=OK: SSH password login refused for excluded account identically to wrong password
expect=stderr:contains=OK: same account succeeded on REST and honored command authorization profile
expect=stderr:contains=OK: audit record and refusal metric verified with zero side effects
reject=stderr:contains=ZE-OBSERVER-FAIL
