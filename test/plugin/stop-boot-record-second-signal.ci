# Test: a second Ctrl+C while the stop waits for the boot record forces the
#       exit at once, with exit 1, and the record is abandoned.
# Exercises: SIGINT after "Ze running." -> the ordered stop -> the waiting line
#            of awaitBootRecordAtStop (cmd/ze/hub/config_source.go) -> a second
#            SIGINT -> stopSignals.onSignal after teardown (cmd/ze/hub/drain.go)
#            -> exitForced (cmd/ze/hub/main.go).
# VALIDATES: spec-boot-record-after-listen, the stop fix of 322fc9e5c7: the
#            waiting line's promise "Ctrl+C again to force" holds, ze exits 1
#            with "forced exit" and never prints "Ze stopped.", and the store
#            holds no active pointer, so the next start records the file.
# PREVENTS:  a wait the operator cannot interrupt, and a forced exit that still
#            reports a clean stop.
#
# The fixture sends the second SIGINT only once ze printed the waiting line, so
# it lands inside the wait and not in the stop's fence, where a second signal
# only skips the drain. With the wait gone the line never appears, the second
# signal is never sent, and the fixture fails naming the missing cue.

option=storage:value=disk
option=timeout:value=60s
option=env:var=ze.test.boot.record.hold:value=6s

tmpfs=boot-force.conf:terminator=EOF_CONF
# stop-boot-record-second-signal marker
environment {
}
EOF_CONF

cmd=foreground:seq=1:exec=le test fixture hub/stop-during-boot-record boot-force.conf int,int 1:timeout=60s:exit=0
expect=stderr:contains=stop-boot-record: sent interrupt after "Ze running."
expect=stderr:contains=stop-boot-record: sent interrupt after "Stopping: the store is still recording the boot configuration"
expect=stderr:contains=forced exit
expect=stdout:contains=Stopping: the store is still recording the boot configuration
reject=stdout:contains=Ze stopped.
reject=stderr:pattern=panic
expect=key:path=meta/config/boot-force.conf/active:absent=true
