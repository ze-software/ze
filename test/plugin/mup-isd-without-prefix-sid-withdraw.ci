# mup-isd-without-prefix-sid-withdraw -- draft-ietf-bess-mup-safi Section 3.3.3
# (row 14 / DRAFT-IETF-BESS-MUP-SAFI-3.3.3-3), end to end through the route server.
#
# RFC requirement: DRAFT-IETF-BESS-MUP-SAFI-3.3.3-3 positive -- an ISD route announced without a Prefix-SID attribute is treated as withdrawn (MP_UNREACH_NLRI sent to peers and removed from Adj-RIB-In) while its sibling T2ST route is kept and relayed and the session survives.
#
# A peer announces an Interwork Segment Discovery route I4 with a Prefix-SID
# attribute, then sends an UPDATE carrying I4 again beside a sibling Type 2 ST
# route T4 with no Prefix-SID attribute. Section 3.3.3: "When a BGP speaker receives
# the Interwork Segment Dicovery routes with a MP_REACH_NLRI attribute without a
# prefix SID attribute, then it MUST be treated as if it contained a malformed prefix
# SID attribute and the "Treat-as-withdraw procedure of [RFC7606] is applied. A BGP
# speaker MUST skip such NLRIs and continue processing of rest of the Update message."
# Receiver-peer sees I4 withdrawn and T4 announced, Adj-RIB-In retains T4 and drops
# I4, and no session is reset.

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=2
option=timeout:value=20s
option=bind:value=0.0.0.0
option=linger:value=true
option=conn_map:value=remote-ip
option=await-file:path=peers-isd-nosid.ready

#   I4: 0100010C0000FDE900000001180A0002 (ISD, RD 65001:1, 10.0.2.0/24)
#   T4: 010004110000FDE90000000140C000020100000001 (T2ST, RD 65001:1, ep 192.0.2.1, TEID 1)
# seq=1 announces I4 with a Prefix-SID attribute (SID 2001:db8::1, End.DT4).
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF005F02000000484001010040020602010000FDE9800E190001550401010101000100010C0000FDE900000001180A0002C0281C050019000100150020010DB800000000000000000000000100001300

# seq=2 carries I4 then T4 in one MP_REACH_NLRI, with no Prefix-SID.
action=send:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0055020000003E4001010040020602010000FDE9800E2E0001550401010101000100010C0000FDE900000001180A0002010004110000FDE90000000140C000020100000001

# seq=3: IPv4 unicast fence 10.0.0.0/24.
action=send:conn=1:seq=3:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002F02000000144001010040020602010000FDE940030401010101180A0000

# Receiver (conn=2): I4 announced first, then withdrawn via MP_UNREACH_NLRI while T4 is announced.
expect=bgp:conn=2:seq=1:contains=0100010C0000FDE900000001180A0002
expect=bgp:conn=2:seq=2:contains=0001550100010C0000FDE900000001180A0002
expect=bgp:conn=2:seq=2:contains=010004110000FDE90000000140C000020100000001
expect=bgp:conn=2:seq=3:announced=180A0000

# I4 is never re-announced beside T4.
reject=bgp:conn=2:pattern=0100010C0000FDE900000001180A0002010004110000FDE90000000140C000020100000001

EOF_PEER

stdin=ze-bgp:terminator=EOF_CONF
bus {
	endpoint bgp-rib {
		internal bgp-rib;
		receive { allow none; }
		send { allow none; }
	}
	endpoint rs {
		internal bgp-rs;
	}
	endpoint adj-rib-in {
		internal bgp-adj-rib-in;
		send {
			message bgp:update { to none; }
		}
	}
	endpoint mup-sd-observer {
		external {
			run "le test fixture plugin/mup-segment-discovery-observer --ready-file=peers-isd-nosid.ready --keep=010004110000fde90000000140c000020100000001 --absent=0100010c0000fde900000001180a0002";
		}
		encoding json;
	}
}
bgp {
	filter {
		import { final accept; }
		export { final accept; }
	}
	peer source-peer {
		connection {
			remote { ip 127.0.0.1 }
			local { ip 127.0.0.1; accept false }
		}
		session {
			rs-client true;
			asn { local 65000; remote 65001 }
			router-id 1.2.3.4
			accept-srv6-prefix-sid true
			family {
				ipv4/unicast { prefix { maximum 10000; } }
				ipv4/mup { prefix { maximum 10000; } }
			}
			capability { graceful-restart disable }
		}
		behavior { group-updates disable }
	}
	peer receiver-peer {
		connection {
			remote { ip 127.0.0.2 }
			local { ip 127.0.0.2; accept false }
		}
		session {
			rs-client true;
			asn { local 65000; remote 65002 }
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
				ipv4/mup { prefix { maximum 10000; } }
			}
			capability { graceful-restart disable }
		}
		behavior { group-updates disable }
	}
}
EOF_CONF

cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
reject=stderr:pattern=panic
reject=stderr:pattern=fatal error
