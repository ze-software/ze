# Test: clear irr cache reaches the IRR client of bgp-filter-irr running internal
# Exercises: dispatch-command -> ze-resolve:clear-irr-cache-{all,as-set}
#            -> ze-plugin-callback:resolver-cache-clear to bgp-filter-irr
# Verifies: the filter refreshes AS-SET AS-TEST from the mock, and
#           clear irr cache as-set AS-TEST finds it, with the owner
#           bgp-filter-irr reporting the entries it removed (the hub's own IRR
#           resolver never looked it up); a second clear finds nothing; the
#           bare clear irr cache is refused; all answers clear-all.
# Related: clear-irr-cache-external.ci runs the same steps with the plugin
#          as a separate process.

# ze-peer: accepts connection
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
option=asn:value=65001
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER


stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external clear-irr-cache-test {
		run "le test fixture plugin/clear-irr-cache"
		encoder json
	}
}

bgp {
	policy {
		irr {
			server 127.0.0.1:$PORT2
			refresh-interval 3600
		}
	}

	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast {
					prefix {
						maximum 10000
					}
				}
			}
			capability {
				graceful-restart disable
			}
			irr {
				as-set AS-TEST
			}
		}
		filter {
			import [ bgp-filter-irr:65001 ]
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=le test irr --port $PORT2
cmd=background:seq=2:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=3:exec=ze --plugin ze.bgp-filter-irr -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
