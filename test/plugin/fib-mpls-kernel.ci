# Test: fib-kernel programs an MPLS push route from a system-RIB change
#
# Flow:
# 1. the setup puts the static kernel scenarios' gateway subnet on a dummy link
# 2. fakefib emits a system-RIB change for 198.18.204.0/24 via 192.0.2.1 with
#    Labels=[100,200]
# 3. the fixture reads the kernel and requires one proto 250 entry carrying
#    `encap mpls 100/200` via that gateway
#
# VALIDATES: spec-fib-depth AC-10 -- MPLS label stack installed as lwtunnel encap
# PREVENTS: Labels lost between sysrib and fib-kernel, or the stack reordered.
#           Until 2026-10-09 this test asserted only that stderr named
#           fib-kernel, which held with no route installed.
#
# Requires Linux, CAP_NET_ADMIN and MPLS lwtunnel support in the kernel.
option=needs-linux:caps=net-admin

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER


stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external fib-mpls-kernel-test {
		run "le test fixture plugin/fib-mpls-kernel"
		encoder json
	}
	internal bgp-rib {
		use bgp-rib
	}
	internal rib {
		use rib
	}
	internal fib-kernel {
		use fib-kernel
	}
	internal sysctl {
		use sysctl
	}
	internal fakefib {
		use fakefib
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}

		attach process bgp-rib {
			receive [ update state refresh ]
			send [ update ]
		}
	}
}
EOF_CONF

cmd=foreground:seq=1:exec=le test fixture static/static-kernel-setup
cmd=background:seq=2:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=3:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
expect=stderr:contains=OK: kernel holds 198.18.204.0/24 encap mpls 100/200 via 192.0.2.1
reject=stderr:pattern=panic recovered
reject=stderr:pattern=fatal error
reject=stderr:pattern=ZE-OBSERVER-FAIL
