# Test: show policy test with single filter override by plain name
# VALIDATES: spec-pol-4-explain AC-3 -- single filter override by unique name
# VALIDATES: spec-pol-4-explain AC-9 -- remove-private-as strips private ASN in dry-run
# PREVENTS: Plain filter name failing to resolve in dry-run context

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=20s
option=bind:value=0.0.0.0
EOF_PEER

tmpfs=policy-test-rpa.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
import json
import sys
from ze_api import API, runtime_fail

def dispatch(api, command):
    resp = api._call_engine(
        'ze-plugin-engine:dispatch-command', {'command': command})
    if resp is None:
        return {'status': 'error', 'data': 'engine call returned None'}
    return resp.get('result', {})

def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()
    api.wait_for_post_startup(timeout=5.0)

    # Valid BGP UPDATE with private ASN 64512 in AS_PATH:
    # ORIGIN=IGP, AS_PATH=[64496 64512 64497], NEXT_HOP=1.1.1.1, LOCAL_PREF=100, NLRI=10.0.0.0/24
    update_hex = 'FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF003E02000000234001010040020E02030000FBF00000FC000000FBF14003040101010140050400000064180A0000'

    # Test with plain filter name (STRIP) instead of plugin-prefixed form
    result = dispatch(api, f'show policy test peer test-peer export filter STRIP update {update_hex}')
    status = result.get('status', '')
    if status == 'error':
        # The daemon now supports the dry-run; an error here is a real
        # regression, so fail rather than tolerate it.
        error = result.get('error', '')
        runtime_fail(f'dry-run returned error: {error}')
        print(f'FAIL: dry-run returned error: {error}', file=sys.stderr)
        sys.exit(1)

    if status != 'done':
        runtime_fail(f'unexpected status: {status}')
        print(f'FAIL: unexpected status: {status}', file=sys.stderr)
        sys.exit(1)

    data = result.get('data', {})
    if isinstance(data, str):
        data = json.loads(data)
    action = data.get('action', '')
    changed = data.get('changed-attrs', [])

    # AC-9: stripping the private ASN must modify the route and list as-path changed.
    if action != 'modify':
        runtime_fail(f'expected action=modify, got {action}')
        print(f'FAIL: expected action=modify, got {action}', file=sys.stderr)
        sys.exit(1)
    if 'as-path' not in changed:
        runtime_fail(f'as-path not in changed-attrs: {changed}')
        print(f'FAIL: as-path not in changed-attrs: {changed}', file=sys.stderr)
        sys.exit(1)
    print('OK: remove-private-as dry-run modified as-path (AC-9)')

    trace = data.get('trace', [])
    print(f'OK: trace entries: {len(trace)}')
    if trace:
        print(f'OK: first filter: {trace[0].get("filter", "")} action={trace[0].get("action", "")}')

    dispatch(api, 'request shutdown')
    api.wait_for_shutdown()

main()
EOF_RUN

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	internal rs {
		use bgp-rs
	}
	external policy-test-rpa {
		run ./policy-test-rpa.run
		encoder json
	}
}
bgp {
	policy {
		remove-private-as STRIP {
		}
	}
	peer test-peer {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		filter {
			export [ STRIP ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --mode sink --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze --plugin ze.bgp-filter-remove-private-as -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
reject=stderr:pattern=ZE-OBSERVER-FAIL
reject=stderr:pattern=panic
reject=stderr:pattern=fatal error