# Test: REST no-auth callers are read-only
# VALIDATES: AC-8 -- REST without authenticator or token permits reads and denies writes.
# PREVENTS: unauthenticated REST access silently becoming admin access.

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=25s
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER


stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external rest-readonly-test {
		run "ze-test fixture plugin/rest-no-auth-readonly"
		encoder json
	}
}

environment {
	api-server {
		rest {
			enabled true;
			server main {
				ip 127.0.0.1;
				port 18086;
			}
		}
	}
}

bgp {
	router-id 1.2.3.4
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=25s
expect=exit:code=0
