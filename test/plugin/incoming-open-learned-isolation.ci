# Test: can a losing OPEN replace the selected route-server client's families?
# A unit cannot prove the real daemon delivers selected OPENs to bgp-rs and
# keeps useful forwarding on its ordinary plugin rail after a competing socket.
# VALIDATES: valid IPv6-only competing OPEN receives exact collision6/7 and EOF;
# the original IPv4-only client remains up with ASN65002 and only ipv4/unicast;
# fresh OTC-stamped IPv4 routes reach the original destination connection.
# PREVENTS: unselected decoded OPEN events replacing live learned capability state.
# Scenario: internal/test/fixture/incoming_open_learned.go.

option=timeout:value=90s

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	internal adj-rib-in { use bgp-adj-rib-in; }
	internal rs { use bgp-rs; }
	external incoming-open-watch {
		run "le test fixture plugin/incoming-open-learned-isolation 127.0.0.1:$PORT"
		encoder json
	}
}
bgp {
	filter { import { final accept; } export { final accept; } }
	peer source-peer {
		connection {
			local { ip 127.0.0.1; port $PORT; }
			remote { ip 127.0.0.2; connect false; }
		}
		session {
			asn { local 65000; remote 65001; }
			router-id 1.2.3.4
			next-hop unchanged
			family { ipv4/unicast { prefix { maximum 10000; } } }
		}
		role { import provider; export customer; }
		attach process rs { receive [ update-received state open-received refresh ]; send [ update ]; }
		attach process adj-rib-in { receive [ update-received state ]; send [ update ]; }
	}
	peer dest-peer {
		connection {
			local { ip 127.0.0.1; port $PORT; }
			remote { ip 127.0.0.3; connect false; }
		}
		session {
			asn { local 65000; remote 65002; }
			router-id 1.2.3.4
			next-hop unchanged
			family {
				ipv4/unicast { prefix { maximum 10000; } }
				ipv6/unicast { prefix { maximum 10000; } }
			}
		}
		role { import provider; }
		attach process rs { receive [ update-received state open-received refresh ]; send [ update ]; }
		attach process adj-rib-in { receive [ update-received state ]; send [ update ]; }
	}
}
EOF_CONF

cmd=foreground:seq=1:exec=ze --plugin ze.bgp-role -:stdin=ze-bgp:timeout=90s
expect=stderr:contains=OK: losing IPv6-only OPEN received collision6/7 and EOF; route server retained selected IPv4 family and ASN; fresh IPv4 export reached the original Customer socket
reject=stderr:contains=ZE-OBSERVER-FAIL
reject=stderr:pattern=panic recovered|fatal error
expect=exit:code=0
