# rs-control-community-withdraw-egress -- the RFC 7947 sibling of
# wellknown-no-export-withdraw-egress.ci, on the route-server fast-path rail.
#
# WHAT IT GUARDS. A ze route-server control community names a whitelist or a blacklist of
# CLIENT ASNs, and wireu.ParseCommunityPolicy reads it off the ANNOUNCED route's COMMUNITY
# attribute. CommunityPolicy.ShouldForwardTo is therefore a decision about ONE ROUTE, while
# reactorForwardRS applies it to a whole MESSAGE. One UPDATE can carry both halves -- RFC
# 7606 Section 5.1 tells a sender not to emit that shape and ze must still handle it on
# receipt (wireu.MixesNLRIFields) -- and the Withdrawn Routes field carries no attributes,
# so it was tagged by nobody. Refusing the whole message leaves the excluded client holding
# a prefix an earlier UPDATE did advertise to it and ze can no longer take back until the
# session resets.
#
# RFC 7947 requires per-client import and export policy and places no normative requirement
# on these communities: the control convention is ze's own (wireu.StripControlCommunities).
# The obligation this file asserts is therefore ze's, not the RFC's, and it carries no
# `RFC requirement:` tag.
#
# WHY A .ci AND NOT ONLY THE UNIT TESTS. The unit tests
# (TestForwardRSWithdrawsFromClientRefusedByControlCommunity) prove the rail splits the
# message. Only a running daemon proves the withdrawal reaches a socket while the
# announcement does not, and the egress rail is where a stranded route actually happens.
#
# NON-VACUITY (ai/rules/interop-and-goal-validation.md). Three controls, and the reject rule
# covers the leak in the other direction:
#   1. the FENCE route 192.0.2.0/24 IS delivered to the excluded client, so a build
#      forwarding nothing to it is red;
#   2. the client the community does NOT name receives BOTH halves plus the fence, so a
#      build suppressing on the wrong side is red;
#   3. the observer counts the excluded client's UPDATEs and refuses a fourth one
#      (seed, withdrawal and fence are the three permitted frames).
#
# ORDERING. The source sends the mixed UPDATE BEFORE the fence, on one TCP stream ze
# processes in order on one goroutine. The observer waiting for the fence therefore proves
# the mixed UPDATE was already decided.

# Independent peer processes are required: conn_map executes complete scripts
# serially, so a source waiting for another connection's receipt would deadlock.
# The observer waits for all three EOR counters before releasing the seed.
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=30s
option=bind:value=127.0.0.1
option=asn:value=65001
# The peers must outlive the assertions: a source that closes makes ze withdraw its routes,
# which would deliver the clients messages they never asked for.
option=linger:value=true

# conn=1, the SOURCE -- external, AS 65001, on 127.0.0.1.
# Establish the original withdrawal's owner on both real destination Sessions.
# Receipt files acknowledge the seed before the observer releases the source.
expect=bgp:conn=1:seq=1:announced=18C00004
action=send:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0036020000001B4001010040020602010000FDE9400304010101014005040000006418C63364
expect=bgp:conn=1:seq=3:announced=18C00003
#
# seq=4 -- the MIXED UPDATE. Withdrawn Routes = 198.51.100.0/24 (18C63364). NLRI =
# 10.0.0.0/24 (180A0000) with ORIGIN=IGP, AS_PATH=[65001], NEXT_HOP=1.1.1.1,
# LOCAL_PREF=100, COMMUNITY=0:65002 (0000FDEA). The 0:X form is the ze route-server
# BLACKLIST convention (wireu.parseCommunityAttr), so ShouldForwardTo answers false for the
# client in AS 65002 and true for the one in AS 65003. The community rides in the attribute
# section, which governs the NLRI only: the Withdrawn Routes field carries no attributes.
action=send:conn=1:seq=4:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF004102000418C6336400224001010040020602010000FDE94003040101010140050400000064C008040000FDEA180A0000
# seq=5 -- the FENCE, 192.0.2.0/24, tagged 65001:100 (FDE90064). Its high half is neither 0
# nor the route server's 65000, so it is an ordinary community that names nobody and the
# route reaches both clients.
action=send:conn=1:seq=5:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF003D02000000224001010040020602010000FDE94003040101010140050400000064C00804FDE9006418C00002
EOF_PEER

# The EXCLUDED client -- AS 65002, on 127.0.0.2.
stdin=excluded:terminator=EOF_EXCLUDED
option=tcp_connections:value=1
option=timeout:value=30s
option=bind:value=127.0.0.2
option=asn:value=65002
option=linger:value=true
expect=bgp:conn=1:seq=1:announced=18C63364
action=rewrite:conn=1:seq=2:source=withdraw-seed.src:dest=withdraw-seed-2.received
# THE POINT OF THIS TEST: the withdrawal half REACHES the excluded client.
expect=bgp:conn=1:seq=3:withdrawn=18C63364
# The refused announcement also invalidates any previously advertised generation.
expect=bgp:conn=1:seq=3:withdrawn=180A0000
# CONTROL 1: the fence reaches this session too, so the assertion above cannot pass by way
# of some unrelated message.
expect=bgp:conn=1:seq=4:announced=18C00002
# THE ASSERTION: 10.0.0.0/24 is never announced to this client.
reject=bgp:conn=1:scope=announced:pattern=180A0000
EOF_EXCLUDED

# The INCLUDED client -- AS 65003, on 127.0.0.3. CONTROL 2.
stdin=included:terminator=EOF_INCLUDED
option=tcp_connections:value=1
option=timeout:value=30s
option=bind:value=127.0.0.3
option=asn:value=65003
option=linger:value=true
expect=bgp:conn=1:seq=1:announced=18C63364
action=rewrite:conn=1:seq=2:source=withdraw-seed.src:dest=withdraw-seed-3.received
# The control community names 65002 only, so this client receives BOTH halves. ze splits
# the mixed shape before sending it (RFC 7606 Section 5.1), withdrawal first, so the two
# halves arrive as two messages in that order, and the fence follows.
expect=bgp:conn=1:seq=3:withdrawn=18C63364
expect=bgp:conn=1:seq=4:announced=180A0000
expect=bgp:conn=1:seq=5:announced=18C00002
EOF_INCLUDED

tmpfs=withdraw-seed.src:terminator=EOF_SEED
received 198.51.100.0/24 from the original source
EOF_SEED

# Observer: hold the daemon up until the fence has reached the excluded client, which proves
# the mixed UPDATE ahead of it was already decided, then count what each client was sent.

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	internal rs {
		use bgp-rs
	}
	external rs-community-withdraw {
		run "le test fixture plugin/bgp-rs-control-community-withdraw-egress"
		encoder json
	}
}
bgp {
	peer source-peer {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			rs-client true
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		# The source-side flag that selects the fast-path rail (reactorForwardRS)
		# instead of the bgp-rs ForwardCached chain; see
		# bgp-rs-community-strip-multi-fastpath.ci for why the gate is source-side.
		behavior {
			group-updates disable
			rs-fast-path enable
		}
		# The observer may send readiness markers only to the source.
		attach process rs-community-withdraw {
			send [ update ]
		}
	}

	peer excluded-client {
		connection {
			remote {
				ip 127.0.0.2
			}
			local {
				ip 127.0.0.2
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65002
			}
			router-id 1.2.3.4
			# LOAD-BEARING: the RFC 7947 policy branch in reactorForwardRS is gated on
			# facts.rsClient, which is this leaf. Without it the control community
			# decides nothing and every assertion below passes against a broken build.
			rs-client true
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}

	peer included-client {
		connection {
			remote {
				ip 127.0.0.3
			}
			local {
				ip 127.0.0.3
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65003
			}
			router-id 1.2.3.4
			rs-client true
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

# All listeners share the leased port but bind distinct loopback addresses.
# The observer's all-EOR release replaces the old per-process batch barrier.
cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer
cmd=background:seq=2:exec=le test peer --port $PORT:stdin=excluded
cmd=background:seq=3:exec=le test peer --port $PORT:stdin=included
cmd=foreground:seq=4:exec=ze -:stdin=ze-bgp:timeout=30s
expect=exit:code=0
expect=stderr:contains=OK: both receivers acknowledged original withdrawal seed
reject=stderr:pattern=panic recovered
reject=stderr:pattern=fatal error
reject=stderr:pattern=ZE-OBSERVER-FAIL
