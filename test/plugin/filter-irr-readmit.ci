# Test: a route rejected while its ASN's IRR list was missing is accepted once the list arrives
# VALIDATES: the IRR filter asks the peer to send the route again (ROUTE-REFRESH,
#   RFC 2918 Section 4) when a list it was waiting for resolves, and accepts it
# PREVENTS: a valid route staying rejected until the peer happens to send it again
#
# Flow:
# 1. The mock IRR fails its first query, so AS65001's first resolution fails.
# 2. The peer sends 10.0.0.0/24; the filter rejects it as no-prefix-list and
#    holds it for re-evaluation.
# 3. The peer sends an End-of-RIB after that UPDATE. The observer waits for the
#    failed resolution and eor-received, which proves the preceding filter
#    decision and hold completed, then runs `update bgp irr all` to resolve AS-TEST.
# 4. The filter sees that the held prefix is in the new list and sends a
#    ROUTE-REFRESH for ipv4/unicast; the peer answers by sending the route again.
# 5. The observer receives the accepted 10.0.0.0/24 (internal/test/fixture/
#    plugin_fixture_07_irr.go, filterIRRReadmit07).

option=env:var=ze.log.bgp.filter.irr:value=info

stdin=peer:terminator=EOF_PEER
option=linger:value=true
option=tcp_connections:value=1
option=timeout:value=25s
# UPDATE from AS 65001: ORIGIN IGP, AS_PATH [65001], NEXT_HOP 1.1.1.1, NLRI 10.0.0.0/24
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002F02000000144001010040020602010000FDE940030401010101180A0000
# This later frame cannot be counted until the preceding filter verdict and
# held-route tracking finish on the session's synchronous receive path.
action=send:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
# ROUTE-REFRESH: marker(16) + length(0017=23) + type(05) + AFI(0001) + reserved(00) + SAFI(01)
expect=bgp:conn=1:seq=3:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170500010001
# The same UPDATE again, as a peer answers a ROUTE-REFRESH
action=send:conn=1:seq=4:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002F02000000144001010040020602010000FDE940030401010101180A0000
EOF_PEER

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external test-filter-irr-readmit {
		run "le test fixture plugin/filter-irr-readmit"
		encoder json
	}
	# ze advertises route-refresh, so it must be able to re-advertise its
	# Adj-RIB-Out when the peer asks (RFC 2918 Section 3); bgp-rib does that.
	internal bgp-rib {
		use bgp-rib
	}
}
policy {
	irr {
		server 127.0.0.1:$PORT2
		refresh-interval 3600
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				route-refresh enable
				graceful-restart disable
			}
			irr {
				as-set AS-TEST
			}
		}

		filter {
			import { filters [ bgp-filter-irr:65001 ]; final accept; }
		}

		attach process test-filter-irr-readmit {
			receive [ update state ]
		}
		# The filter asks the peer for its routes again, so it needs the refresh
		# send permission like any other process.
		attach process bgp-filter-irr {
			send [ refresh ]
		}
		attach process bgp-rib {
			receive [ update state refresh ]
			send [ update ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=le mock irr --port $PORT2 --fail-first 1
cmd=background:seq=2:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=3:exec=ze --plugin ze.bgp-filter-irr -:stdin=ze-bgp:timeout=25s
expect=exit:code=0
expect=stderr:pattern=reason=no-prefix-list
expect=stderr:pattern=irr: asked the peer to send again routes the IRR list now authorizes
expect=stderr:pattern=irr filter accept
