# Test: `bgp update-delay` holds the first advertisement until max-delay expires
# Spec: spec-bgp-update-delay -- AC-1, AC-3, user story 1 (closed 2026-09-11)
#
# VALIDATES: a speaker configured with `update-delay max-delay 3` and TWO peers
#            withholds its initial routing update from the peer that IS up,
#            because the second peer never comes up and convergence can never be
#            reached, and releases on its outer bound. The route and the
#            End-of-RIB then reach the wire in one settled set.
# PREVENTS:  the churn a rebooting speaker causes today. It advertises the
#            instant each session reaches Established, before the RIB has
#            learned what its other neighbours will send it, so the neighbour
#            sees an initial route set and then a rapid add/withdraw sequence.
#
# NON-VACUITY (ai/rules/interop-and-goal-validation.md). The wire assertions
# below pass with or without the hold: an unheld speaker sends the same two
# messages, sooner. What discriminates is the pair of production log lines. The
# ARMED line names the expected-peer count the hold is waiting for, and the
# RELEASED line names WHICH of the three conditions ended it. Deleting the hold
# removes both lines; releasing on the wrong condition changes the second.
#
# WHY TWO PEERS. The connecting peer negotiates no graceful restart, so RFC 4724
# Section 4.1 excludes it from the End-of-RIB wait and it settles the moment it
# establishes. With it alone the hold would converge at once, which is correct
# and observable in a unit test but puts nothing on the wire to distinguish from
# no hold at all. The second peer, which nothing is listening for, makes
# convergence unreachable, so only max-delay can end this hold.
option=env:var=ze.log.bgp.reactor:value=info

# ze-peer expectations
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=30s

# The static route, then the End-of-RIB that says the initial routing update is
# complete (RFC 4724 Section 2). Both arrive only after the hold releases.
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00300200000015400101004002004003040A0000014005040000006418C0A801
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

stdin=ze-bgp:terminator=EOF_CONF
bgp {
	router-id 1.2.3.4

	session {
		asn {
			local 1
		}
	}

	update-delay {
		max-delay 3
	}

	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
		}
		behavior {
			group-updates disable
		}
		timer { connect-retry 5; }

		update {
			attribute {
				origin igp
				local-preference 100
				next-hop 10.0.0.1
			}
			nlri {
				ipv4/unicast add 192.168.1.0/24
			}
		}
	}

	# The peer that never answers. It is configured, so it counts toward the
	# expected set the hold waits for, and nothing listens on 127.0.0.2, so the
	# set can never complete.
	peer peer2 {
		connection {
			remote {
				ip 127.0.0.2
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 2
			}
			router-id 1.2.3.5
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
		}
		timer { connect-retry 60; }
	}
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=30s

# The hold was armed for BOTH configured peers.
expect=stderr:pattern=update-delay armed.*expected-peers=2
# And it was ended by its outer bound, not by convergence and not by an
# establish-wait this config does not set.
expect=stderr:pattern=update-delay released.*reason=max-delay
reject=stderr:pattern=update-delay released.*reason=converged
