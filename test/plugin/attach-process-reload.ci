# Test: a reload changes one peer's attach blocks, and delivery follows the new
#       blocks while the edge that survives the reload keeps being fed.
# Exercises: SIGHUP -> reconcilePeersJournaled -> AddPeer/RemovePeer ->
#            Reactor.publishDeliveryGraphLocked -> Server.UpdateDeliveryGraph ->
#            Server.PeerScopedProcs.
# VALIDATES: AC-4. The added program is fed only AFTER the reload, and the kept
#            program is still fed after it.
# PREVENTS: an index that answers from the config the daemon started with, which
#           is what a build-once graph would do.
#
# The marker file is the ordering, never a duration: the added program refuses
# any event that reaches it before the trigger has sent the SIGHUP, so an
# implementation that fed it from the start fails on the first event rather than
# on a timeout.

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=2
option=timeout:value=30s
# One session before the reload and one after it: the peer is torn down and
# re-added because ProcessBindings sits outside hotSwappableSettings, and each
# session ends its initial sync with an End-of-RIB.
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
expect=bgp:conn=2:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# Attached in BOTH configs: the edge that survives the reload.
tmpfs=reload-kept.run:mode=755:terminator=EOF_KEPT
#!/usr/bin/env python3
import json
import os
import sys

from ze_api import API, runtime_fail


def is_state(raw):
    try:
        decoded = json.loads(raw)
    except (json.JSONDecodeError, TypeError, ValueError):
        return False
    return decoded.get("bgp", decoded).get("message", {}).get("type", "") == "state"


def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.subscribe(["state"])
    api.ready()

    before = 0
    while before == 0:
        event = api.wait_for_event(timeout=25.0)
        if event is None:
            runtime_fail("RELOAD-KEPT: never fed before the reload")
            return
        if is_state(event):
            before = 1

    # The same edge exists in the new config, so it must be fed again once the
    # reload has torn the peer down and re-added it (ProcessBindings sits
    # outside hotSwappableSettings, so a changed attach block bounces the peer).
    while True:
        event = api.wait_for_event(timeout=25.0)
        if event is None:
            runtime_fail("RELOAD-KEPT: the surviving edge was not fed after the reload")
            return
        if is_state(event) and os.path.exists("reloaded.marker"):
            break

    print("RELOAD-KEPT: fed before and after the reload", file=sys.stderr, flush=True)
    with open("kept.marker", "w") as marker:
        marker.write("done")
    api.wait_for_shutdown(timeout=30.0)


if __name__ == '__main__':
    main()
EOF_KEPT

# Attached only by the SECOND config: it must be fed nothing until the reload.
tmpfs=reload-added.run:mode=755:terminator=EOF_ADDED
#!/usr/bin/env python3
import json
import os
import sys
import time

from ze_api import API, runtime_fail


def is_state(raw):
    try:
        decoded = json.loads(raw)
    except (json.JSONDecodeError, TypeError, ValueError):
        return False
    return decoded.get("bgp", decoded).get("message", {}).get("type", "") == "state"


def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.subscribe(["state"])
    api.ready()

    fed = False
    deadline = time.monotonic() + 25.0
    while not fed and time.monotonic() < deadline:
        event = api.wait_for_event(timeout=1.0)
        if event is None:
            continue
        if not os.path.exists("reloaded.marker"):
            runtime_fail(f"RELOAD-ADDED: fed before the config attached it: {event[:200]}")
            return
        fed = is_state(event)
    if not fed:
        runtime_fail("RELOAD-ADDED: the reload attached it and it was fed nothing")
        return

    print("RELOAD-ADDED: fed only after the reload attached it", file=sys.stderr, flush=True)

    while not os.path.exists("kept.marker"):
        if api.wait_for_event(timeout=0.5) is None and time.monotonic() > deadline + 20.0:
            runtime_fail("RELOAD-ADDED: the kept edge never reported")
            return
    api.shutdown_fire_and_forget()
    api.wait_for_shutdown(timeout=15.0)


if __name__ == '__main__':
    main()
EOF_ADDED

# Trigger: rewrite the config, SIGHUP, then say so. The marker is written AFTER
# the signal, so an event that beats it is genuinely early.
tmpfs=trigger.sh:mode=755:terminator=EOF_TRIGGER
#!/bin/sh
while [ ! -f daemon.pid ]; do sleep 0.1; done
while [ ! -f daemon.ready ]; do sleep 0.1; done
cp config2.conf ze-bgp.conf
kill -HUP $(cat daemon.pid)
touch reloaded.marker
EOF_TRIGGER

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external reload-kept {
		run ./reload-kept.run
		encoder json
	}
	external reload-added {
		run ./reload-added.run
		encoder json
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		attach process reload-kept {
			receive [ state ]
		}
	}
}
EOF_CONF

# The second config attaches reload-added beside the kept one.
tmpfs=config2.conf:terminator=EOF_CONF2
plugin {
	external reload-kept {
		run ./reload-kept.run
		encoder json
	}
	external reload-added {
		run ./reload-added.run
		encoder json
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		attach process reload-kept {
			receive [ state ]
		}
		attach process reload-added {
			receive [ state ]
		}
	}
}
EOF_CONF2

expect=stderr:pattern=RELOAD-KEPT: fed before and after the reload
expect=stderr:pattern=RELOAD-ADDED: fed only after the reload attached it

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=background:seq=2:exec=sh trigger.sh
cmd=foreground:seq=3:exec=ze -:stdin=ze-bgp:timeout=40s
expect=exit:code=0
