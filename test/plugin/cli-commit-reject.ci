# Test: config editor commit rejection leaves active config unchanged
# VALIDATES: AC-2 -- CLI commit with a daemon reports transaction failure, clears candidate, and keeps active unchanged.
# PREVENTS: config editor promoting a candidate rejected by plugin verify.

option=timeout:value=30s
option=env:var=ZE_STORAGE_BLOB:value=false

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER



tmpfs=cli-commit-reject.conf:terminator=EOF_CONF
plugin {
    external cli-reject-plugin {
        run "ze-test fixture plugin/cli-commit-reject-plugin"
        encoder json
    }
}

system {
    authentication {
        user admin {
            password "$2a$04$UlwuiuH82Unfsq.XEMPGJeDkXwbm3KW.nvVaVXOd/JeFK8VjMjrQO"
        }
    }
}

environment {
    ssh {
        enabled true
        server main {
            ip 127.0.0.1;
            port $PORT2;
        }
    }
}

bgp {
    router-id 1.2.3.4
    session {
        asn {
            local 1
        }
    }
    peer peer1 {
        connection {
            remote {
                ip 127.0.0.1
            }
            local {
                ip 127.0.0.1
                accept false
            }
        }
        session {
            asn {
                remote 1
            }
            router-id 1.2.3.4
            family {
                ipv4/unicast { prefix { maximum 10000; } }
            }
        }
        behavior {
            group-updates disable
        }
    }
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze start cli-commit-reject.conf:timeout=30s
cmd=foreground:seq=3:exec=ze-test fixture plugin/cli-commit-reject-driver $PORT2:timeout=30s
expect=exit:code=0
expect=file:path=meta/config/active:exists=true
expect=file:path=meta/config/candidate:absent=true
expect=file:path=meta/config/rollback:absent=true
expect=file:path=cli-commit-reject.conf:contains=router-id 1.2.3.4
expect=file:path=cli-commit-reject.conf:not-contains=router-id 2.2.2.2
expect=file:glob=rollback/cli-commit-reject-*.conf:count=1
expect=file:glob=rollback/cli-commit-reject-*.conf:contains=router-id 1.2.3.4
expect=file:glob=rollback/cli-commit-reject-*.conf:not-contains=router-id 2.2.2.2
