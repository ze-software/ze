# Test: cos warns when running as an external plugin process
# VALIDATES: plan/learned/1045-plugin-process-boundary.md -- cos's
# warnIfExternal (internal/plugins/cos/register.go) logs a warning when it
# runs as a genuine external subprocess, since iface.GetBackend is a
# same-process call that would silently no-op across the process boundary --
# ConfigureEventBus (the only place dynamicHandler is set) is never invoked
# for an external plugin at all, so dynamic per-interface QoS map updates
# silently never fire. Unlike as112/traffic-usage/flow-export, cos still
# provides real value external (static profile config and
# `show class-of-service` both work unaffected), so it warns rather than
# refuses -- the plugin keeps running.
# Uses `ze-test plugin-external cos` (internal/test/cli/cmd_plugin_external.go)
# to launch the real plugin's own RunEngine via a real TLS connect-back,
# exercising the warning through the actual external-plugin transport, not a
# mocked conn.
# PREVENTS: an operator running `plugin { external cos { ... } }` getting no
# indication that dynamic QoS updates are disabled.
#
# // test-relax: replaced the blind 4.0s sleep + wait.py hold with the
# await=stderr fence below. Coverage is REPLACED, not weakened: the
# warn-message assertion (expect=stderr:contains=) is preserved byte-for-byte;
# only the WHEN-to-tear-down changes from a fixed sleep to a deterministic wait
# for the exact line. cos warns from inside RunEngine after the external TLS
# connect-back, so the relayed line proves the warning fired through the real
# external-plugin transport, exactly as before.

stdin=ze-bgp:terminator=EOF_CONF
class-of-service {
	ieee-802.1p residential {
		ingress {
			pcp 0 { priority 0; }
		}
	}
}

plugin {
	external cos {
		run "ze-test plugin-external cos"
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast {
					prefix {
						maximum 10000
					}
				}
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

cmd=foreground:seq=1:exec=ze -:stdin=ze-bgp:timeout=15s
await=stderr:contains=dynamic per-interface QoS map updates
expect=stderr:contains=dynamic per-interface QoS map updates
