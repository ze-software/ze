# Test: OTC processing scoped to unicast families only per RFC 9234
# VALIDATES: AC-6, AC-7 -- non-unicast family routes bypass OTC ingress/egress rules
# PREVENTS: OTC applied to multicast/VPN/flow families violating RFC 9234 Section 5

# ze-peer: customer peer sends multicast UPDATE with OTC (would be rejected if OTC applied)
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
# Hold the session open past this peer's own completion -- see the same option in
# role-otc-export-unknown.ci for the full reasoning. Without it this peer closes
# ~1ms after its UPDATE, bgp-adj-rib-in drops the peer's routes on session-down
# (adj_rib_in/rib.go "delete(r.ribIn, peerAddr)"), and the observer's
# total-routes poll below can never see the route.
option=linger:value=true
# Role capability: drop ze-peer's default (Provider mirror) then add Customer (0x03).
option=open:value=drop-capability:code=9
option=open:value=add-capability:code=9:hex=03
# Send UPDATE with MP_REACH_NLRI for IPv4 multicast (AFI=1, SAFI=2) + OTC attribute.
# If OTC processing applied, this would be rejected (OTC from Customer = leak).
# Since multicast is out of OTC scope, it should be accepted.
# UPDATE body:
#   withdrawn_len=0000
#   attrs:
#     ORIGIN=IGP: 40 01 01 00
#     AS_PATH=[65001]: 40 02 06 02 01 0000FDE9
#     MP_REACH_NLRI (AFI=1 SAFI=2 nhlen=4 nh=1.1.1.1 nlri=10.0.0.0/24):
#       80 0E 0D 0001 02 04 01010101 00 180A0000
#     OTC=65001: C0 23 04 0000FDE9
#   attr_len = 4+9+16+7 = 36 = 0x24
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF003B02000000244001010040020602010000FDE9800E0D000102040101010100180A0000C023040000FDE9
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# Dest peer (Customer, ASN 65002) also negotiates multicast. The route should
# forward unchanged with OTC still present because OTC processing is out of scope
# for non-unicast families.
stdin=dest:terminator=EOF_DEST
option=tcp_connections:value=1
option=timeout:value=15s
option=open:value=drop-capability:code=9
option=open:value=add-capability:code=9:hex=03
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF003F02000000284001010040020A02020000FDE80000FDE9800E0D000102040101010100180A0000C023040000FDE9
# // test-relax: the removed End-of-RIB rule was unsatisfiable by construction, so
# it asserted nothing and only produced a red the runner used to mask. This peer's
# EOR is emitted by its OWN initial sync the moment it establishes
# (peer_initial_sync.go), which is BEFORE any route is forwarded to it from
# another peer. That early EOR does not match the route rule(s) above, and
# checker.go silently swallows an unmatched EOR instead of re-offering it, so the
# trailing EOR slot could never be filled. RFC 4724 orders the EOR only against
# this speaker's own initial dump, never against routes learned afterwards, so
# there is no ordering here for a test to assert. The forwarded-route rule(s)
# above are this test's actual subject and are unchanged.
EOF_DEST

# Python test plugin: keeps the daemon alive while the destination wire
# assertion proves multicast bypasses OTC processing.
tmpfs=test-scope.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
"""Keep the daemon alive while the dest peer verifies OTC bypass for multicast."""
import json
import sys
from ze_api import API, runtime_fail, result_json_data, result_text_data
# // test-relax: removed unused 'import time'; blind sleep is now dispatch_until + quiesce

def dispatch(api, command):
    resp = api._call_engine('ze-plugin-engine:dispatch-command', {'command': command})
    return resp.get('result', {})


def dest_got_route(result):
    """True once the dest peer has been sent a real UPDATE, not just its EOR.

    updates-sent counts EVERY UPDATE written to the peer, End-of-RIB included
    (reactor_notify.go IncrUpdatesSent, which sees only the message type).
    eor-sent is the separate marker counter, so the DIFFERENCE is the forwarded
    multicast route this test is about.

    Deliberately NOT gated on state == established: the dest is a check-mode
    ze-peer without linger, so it closes the instant its expect=bgp rule matches
    and the success this predicate looks for is immediately followed by
    "connecting".
    """
    if result.get('status') != 'done':
        return False
    data = result_text_data(result, '{}')
    try:
        parsed = json.loads(data) if isinstance(data, str) else data
    except (json.JSONDecodeError, TypeError, ValueError):
        return False
    if not isinstance(parsed, dict):
        return False
    peers = parsed.get('peers', {})
    if not isinstance(peers, dict):
        return False
    for row in peers.values():
        if not isinstance(row, dict):
            continue
        if row.get('updates-sent', 0) - row.get('eor-sent', 0) >= 1:
            return True
    return False


def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()

    # If OTC was applied to multicast, this route would be rejected (OTC from
    # Customer = leak). Since multicast is out of OTC scope, it must be accepted
    # into adj-rib-in AND forwarded to the dest, whose expect=bgp rule is the
    # authoritative proof of the bypass.
    #
    # The barrier is the OUTBOUND one, because it implies the inbound one. An
    # adj-rib-in-only barrier said nothing about the dest: when the dest was not
    # yet an established forward target the route arrives later on the replay
    # rail, and this observer -- which owns `request shutdown` -- tore the daemon
    # down first, leaving ze-peer reporting "connection closed before completion"
    # while the script printed an unconditional OK for an assertion it had never
    # made (ai/rules/fail-closed-guards.md).
    #
    # quiesce() FIRST so the poll behind it is a safety net rather than the
    # mechanism: every dispatch_until attempt is a full engine RPC, and a long
    # poll on a starved daemon outlasts the test's own budget.
    # // test-relax: blind sleep(3.0) -> quiesce + dispatch_until(dest peer sent a real UPDATE)
    api.quiesce()
    dest_result = api.dispatch_until(
        'show bgp peer dest-peer detail', dest_got_route, attempts=24,
    )
    if not dest_got_route(dest_result):
        print(f'FAIL: dest-peer detail: {result_text_data(dest_result)}', file=sys.stderr)
        sys.stderr.flush()
        runtime_fail('dest peer was never sent the multicast route')

    # Now a single query, no poll.
    total = result_json_data(dispatch(api, 'show bgp adj-rib-in status'), {}).get('total-routes', -1)
    if total < 1:
        msg = f'adj-rib-in never stored the multicast route, got total={total}'
        print(f'FAIL: {msg}', file=sys.stderr)
        sys.stderr.flush()
        runtime_fail(msg)

    print('OK: multicast route with OTC accepted and forwarded to the dest peer', file=sys.stderr)
    dispatch(api, 'request shutdown')
    api.wait_for_shutdown()

if __name__ == '__main__':
    main()
EOF_RUN

# ze configuration: Provider with two Customer peers, ipv4/multicast enabled
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	internal adj-rib-in {
		use bgp-adj-rib-in
	}
	internal rs {
		use bgp-rs
	}
	external test-scope {
		run ./test-scope.run
		encoder json
	}
}
bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
				ipv4/multicast { prefix { maximum 10000; } }
			}
		}

		role {
			import provider
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
		attach process adj-rib-in {
			receive [ update-received state ]
			send [ update ]
		}
	}

	peer dest-peer {
		connection {
			remote {
				ip 127.0.0.2
			}
			local {
				ip 127.0.0.2
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65002
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
				ipv4/multicast { prefix { maximum 10000; } }
			}
		}

		role {
			import provider
			export default
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
		attach process adj-rib-in {
			receive [ update-received state ]
			send [ update ]
		}
	}
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=background:seq=2:exec=ze-peer --bind 127.0.0.2 --port $PORT:stdin=dest
cmd=foreground:seq=3:exec=ze --plugin ze.bgp-role -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
reject=stderr:pattern=panic recovered
reject=stderr:pattern=fatal error
reject=stderr:pattern=ZE-OBSERVER-FAIL
