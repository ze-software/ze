# Question: does actual daemon startup refuse a send-only ordinary destination
# beside a complete source, naming the destination, process and missing grants?
# A validator unit cannot prove the shipped daemon invokes the grant gate.
# VALIDATES: spec-bgp-best-route-advertised-to-peers AC-25 startup refusal.
# The completed-graph positive is bgp-best-route-transit-default.ci, which
# observes useful selected output and withdrawal on real peer sockets.
# Each invalid graph has its own test: daemon exit assertions are file-level.

option=timeout:value=25s
option=env:var=ze.log.bgp.plugin:value=info

stdin=destination-send-only:terminator=CONFIG
bus {
 endpoint ac25-table {
  internal bgp-rib;
  receive { from [ /bgp/peer/source ]; }
  send { to [ /bgp/peer/destination ]; }
 }
}
bgp {
 router-id 192.0.2.254;
 session { asn { local 65000; } }
 peer source {
  connection { local { ip 127.0.0.1; port $PORT; } remote { ip 127.0.0.2; connect false; } }
  session { asn { remote 65001; } }
  filter { import { final accept; } export { final reject; } }
 }
 peer destination {
  connection { local { ip 127.0.0.1; port $PORT; } remote { ip 127.0.0.3; connect false; } }
  session { asn { remote 65002; } }
  filter { import { final reject; } export { final accept; } }
 }
}
CONFIG

cmd=foreground:seq=1:exec=ze -:stdin=destination-send-only:timeout=20s
expect=exit:code=1
expect=stderr:contains=participant "destination" endpoint "ac25-table" has incomplete destination grants for dissemination role "bgp-selected-output"
expect=stderr:contains=bus { endpoint ac25-table { receive { allow [ bgp:state bgp:refresh bgp:update ]; } send { allow [ bgp:update ]; } } }
reject=stderr:contains=bgp peers started
reject=stderr:contains=panic
