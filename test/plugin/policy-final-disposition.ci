stdin=ze-bgp:terminator=EOF_CONF
plugin {
    internal adj-rib-in { use bgp-adj-rib-in; }
    external policy-final { run "le test fixture plugin/policy-final-disposition"; encoder json; }
}
policy {
    reject-asn PASS { indirect [ 64512 ]; }
    reject-asn DENY { direct [ 65001 ]; indirect [ 65001 ]; }
    modify MED { set { med 77; } }
    family-filter NoV6 { family ipv6/unicast; action remove; }
}

bgp {
    peer peer-1 {
        connection { remote { ip 127.0.0.1; } local { ip 127.0.0.4; accept false; } }
        session {
            asn { local 65000; remote 65001; }
            router-id 1.2.3.4;
            family { ipv4/unicast { prefix { maximum 10000; } } ipv6/unicast { prefix { maximum 10000; } } }
            capability { graceful-restart disable; }
        }
        behavior { group-updates disable; }
        filter { import { final accept; } }
        attach process policy-final { send [ update ]; }
        attach process adj-rib-in { receive [ update-received state ]; }
    }
    peer peer-2 {
        connection { remote { ip 127.0.0.2; } local { ip 127.0.0.5; accept false; } }
        session {
            asn { local 65000; remote 65002; }
            router-id 1.2.3.4;
            family { ipv4/unicast { prefix { maximum 10000; } } ipv6/unicast { prefix { maximum 10000; } } }
            capability { graceful-restart disable; }
        }
        behavior { group-updates disable; }
        filter { export { final accept; } }
        attach process policy-final { send [ update ]; }
        attach process adj-rib-in { receive [ update-received state ]; }
    }
}
EOF_CONF

cmd=background:seq=1:exec=le test peer --port $PORT:stdin=source
cmd=background:seq=2:exec=le test peer --bind 127.0.0.2 --port $PORT:stdin=sink
cmd=foreground:seq=3:exec=ze --plugin ze.bgp-filter-path-asn --plugin ze.bgp-filter-modify --plugin ze.bgp-filter-family -:stdin=ze-bgp:timeout=180s
expect=exit:code=0
reject=stderr:pattern=ZE-OBSERVER-FAIL
reject=stderr:pattern=peer restart required
reject=stderr:pattern=panic recovered
