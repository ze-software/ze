# Test: delete bgp peer removes a config-defined peer at runtime
# VALIDATES: delete bgp peer tears down a peer and removes it from the peer list
# PREVENTS: delete silently failing or leaving stale entries

# ze-peer expectations
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# Python test plugin: exercises dispatch-command for peer delete
tmpfs=peer-remove-test.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
import json
import sys
import time
from ze_api import API, result_json_data

def dispatch(api, command):
    resp = api._call_engine(
        'ze-plugin-engine:dispatch-command', {'command': command})
    if resp is None:
        return {'status': 'error', 'data': 'engine call returned None'}
    return resp.get('result', {})

def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()
    api.wait_for_post_startup(timeout=5.0)

    try:
        result = dispatch(api, 'show bgp peer list')
        data = result.get('data', {})
        if isinstance(data, str):
            data = json.loads(data)
        peers = data.get('peers', {})
        if '127.0.0.1' not in peers:
            print(f'FAIL: config peer 127.0.0.1 not in initial peer list', file=sys.stderr)
            sys.exit(1)

        result = dispatch(api, 'delete bgp peer 127.0.0.1')
        if result.get('status') != 'done':
            print(f'FAIL: remove status={result.get("status")}', file=sys.stderr)
            sys.exit(1)

        result = api.dispatch_until(
            'show bgp peer list',
            lambda r: '127.0.0.1' not in result_json_data(r, {}).get('peers', {}),
        )
        data = result.get('data', {})
        if isinstance(data, str):
            data = json.loads(data)
        peers = data.get('peers', {})
        if '127.0.0.1' in peers:
            print(f'FAIL: 127.0.0.1 still in peers after delete', file=sys.stderr)
            sys.exit(1)

        print('OK: peer delete verified', file=sys.stderr)
    finally:
        dispatch(api, 'request shutdown')
        api.wait_for_shutdown()

if __name__ == '__main__':
    main()
EOF_RUN

# ze bgp configuration
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external peer-remove-test {
		run ./peer-remove-test.run
		encoder json
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
