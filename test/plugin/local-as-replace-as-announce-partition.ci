# local-as-replace-as-announce-partition -- the API ANNOUNCE rail sends each of two
# peers sharing one local AS the AS_PATH its own replace-as setting calls for.
#
# The router has migrated into AS 65000 and answers to the legacy AS 65010 on
# both sessions. ONE `send bgp * update hex` reaches two eBGP receivers whose
# configuration differs only in `local-options [ replace-as ]`:
#
#   conn=1  127.0.0.2  no option   AS_SEQUENCE[65010, 65000]
#   conn=2  127.0.0.3  replace-as  AS_SEQUENCE[65010]
#
# RFC 7705 Section 3.3: without "Replace Old AS" the speaker prepends the Local
# AS in front of the globally configured ASN; with it, it "MUST NOT append the
# globally configured ASN" and "MUST append only the configured 'Local AS' ASN
# value".
#
# WHY THIS FILE EXISTS. AnnounceNLRIBatch groups peers on announceFacts and
# builds ONE UPDATE per group (internal/component/bgp/reactor/reactor_api_batch.go).
# The key once carried the bare local AS, so these two peers shared a build and
# both received whichever AS_PATH was built first, decided by map iteration
# order. group-updates is left at its default (true) so that a key which merged
# them would send one frame to both, and exactly one expectation below fails.
# bgp-local-as-options.ci proves the same options on the FORWARD rail.
#
# NO LOCAL_PREF in the announce: both destinations are eBGP peers and RFC 4271
# Section 5.1.5 forbids one toward them.

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=2
option=timeout:value=30s
option=bind:value=0.0.0.0
option=conn_map:value=remote-ip

# conn=1, no option: AS_PATH 40020A 0202 0000FDF2 0000FDE8 (65010, 65000).
# attr len = 4+13+7 = 24 = 0x18; total = 19+2+2+24+4 = 51 = 0x33.
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF003302000000184001010040020A02020000FDF20000FDE84003040A00000118C00002
# conn=2, replace-as: AS_PATH 400206 0201 0000FDF2 (65010 alone).
# attr len = 4+9+7 = 20 = 0x14; total = 19+2+2+20+4 = 47 = 0x2F.
expect=bgp:conn=2:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002F02000000144001010040020602010000FDF24003040A00000118C00002
EOF_PEER

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external local-as-announce {
		run "le test fixture plugin/local-as-replace-as-announce-partition"
		encoder json
	}
}
bgp {
	# The router's globally configured ASN. Both peers below override it with
	# the legacy local AS 65010, which RFC 7705 Section 3.3 calls the "Local AS".
	session {
		asn {
			local 65000
		}
	}
	peer prepend-receiver {
		connection {
			remote {
				ip 127.0.0.2
			}
			local {
				ip 127.0.0.2
				accept false
			}
		}
		session {
			asn {
				local 65010
				remote 65002
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		attach process local-as-announce {
			send [ update ]
		}
	}
	peer replace-as-receiver {
		connection {
			remote {
				ip 127.0.0.3
			}
			local {
				ip 127.0.0.3
				accept false
			}
		}
		session {
			asn {
				local 65010
				remote 65003
				# The ONE leaf that separates this peer from prepend-receiver.
				local-options [ replace-as ]
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		attach process local-as-announce {
			send [ update ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=30s
expect=exit:code=0
reject=stderr:pattern=panic
reject=stderr:pattern=fatal error
