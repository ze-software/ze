# Test: show policy test runs a peer's configured IMPORT chain
# VALIDATES: spec-pol-4-explain AC-2 -- configured import chain returns structured result
# PREVENTS: import direction being untested (only export was covered)

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=20s
option=bind:value=0.0.0.0
EOF_PEER

tmpfs=policy-test-import.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
import json
import sys  # noqa: F401
from ze_api import API, runtime_fail

def dispatch(api, command):
    resp = api._call_engine(
        'ze-plugin-engine:dispatch-command', {'command': command})
    if resp is None:
        return {'status': 'error', 'data': 'engine call returned None'}
    return resp.get('result', {})

def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()
    api.wait_for_post_startup(timeout=5.0)

    # Valid BGP UPDATE: ORIGIN=IGP, AS_PATH=[64496 64512 64497], NEXT_HOP=1.1.1.1,
    # LOCAL_PREF=100, NLRI=10.0.0.0/24 (64512 is a Private Use ASN, RFC 6996)
    update_hex = 'FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF003E02000000234001010040020E02030000FBF00000FC000000FBF14003040101010140050400000064180A0000'

    result = dispatch(api, f'show policy test peer receiver-peer import update {update_hex}')
    status = result.get('status', '')
    if status != 'done':
        runtime_fail(f'import dry-run status={status} error={result.get("error", "")}')
        print(f'FAIL: status={status}', file=sys.stderr)
        sys.exit(1)

    data = result.get('data', {})
    if isinstance(data, str):
        data = json.loads(data)

    direction = data.get('direction', '')
    if direction != 'import':
        runtime_fail(f'direction = {direction}, want import')
        print(f'FAIL: direction = {direction}', file=sys.stderr)
        sys.exit(1)

    action = data.get('action', '')
    if action not in ('accept', 'modify', 'reject'):
        runtime_fail(f'unexpected action: {action}')
        print(f'FAIL: action = {action}', file=sys.stderr)
        sys.exit(1)

    print(f'OK: show policy test import returned action={action} direction={direction}')
    dispatch(api, 'request shutdown')
    api.wait_for_shutdown()

main()
EOF_RUN

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external policy-test-import {
		run ./policy-test-import.run
		encoder json
	}
}
bgp {
	policy {
		remove-private-as STRIP {
		}
	}
	peer receiver-peer {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65002
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		filter {
			import [ STRIP ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze --plugin ze.bgp-filter-remove-private-as --plugin ze.bgp-adj-rib-in -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
reject=stderr:pattern=ZE-OBSERVER-FAIL
reject=stderr:pattern=panic
reject=stderr:pattern=fatal error
