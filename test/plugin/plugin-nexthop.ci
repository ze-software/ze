# Migrated from test/data/plugin/nexthop.*

# ze-peer expectations
stdin=peer:terminator=EOF_PEER
# Step 5: commands migrated to bgp peer prefix
#
# This file used to quote a ruling of 2026-07-27 saying the marker is ordered
# only against this speaker's own initial dump, never against routes learned
# afterwards, and applied it to a PLUGIN-INJECTED route. That application is
# VOID: the owner ruled on 2026-08-30 that a plugin-injected route DOES belong
# to this speaker's initial routing update, so the End-of-RIB waits for it
# (RFC 4724 Section 4, ProcessBinding.MayPushRoutes, peer_initial_sync.go).
# The sentence stays true where role-otc-unicast-scope.ci and the forward tests
# use it, because there the route is FORWARDED from another peer and was never
# part of this speaker's dump.
#
# The EOR-position rule stays absent here even so, and this file is not where
# the new order is proven. The driver (`nexthopRoutes`,
# internal/test/fixture/plugin_fixture_11.go) sends the seq=1 announce and only
# then waits for `eor-sent`, so under ruling 1 the marker is owed between seq=1
# and seq=2. Which frame wins is decided by how fast the plugin announces inside
# the barrier window rather than by an order Ze publishes, and this file's rule
# failed 13 of 40 on exactly that (internal/le/stressrepro/actions.go). The
# order ruling 1 makes assertable is asserted where the barrier, not a race,
# decides it: test/plugin/initial-sync-barrier-raw.ci, whose plugin dispatches
# `plugin session ready` so the marker is released by the barrier itself.
#
# The rule's cmd=api documentation line went with it: cmd=api sets Cmd on the
# message at that conn/seq (internal/test/runner/record_parse.go), so leaving it
# would have relabelled the renumbered 2001::2 announce with the EOR command
# text.
#
# The marker's EXISTENCE is still required: the driver fails the run with
# "initial-sync end-of-rib never reached the wire" when `eor-sent` never rises.
#
# Nothing else is relaxed. All three announce rules keep their exact hex,
# including the ORIGIN, AS_PATH, LOCAL_PREF, MP_REACH attribute order that
# reactor_api_batch.go insertAttrOrdered now guarantees on both announce rails.
cmd=api:conn=1:seq=1:text=peer * update text origin igp local-preference 500 nhop 2001::1 nlri ipv6/unicast add 2605::2/128
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF004E020000003740010100400200400504000001F4800E260002011020010000000000000000000000000001008026050000000000000000000000000002
expect=json:conn=1:seq=1:json={"meta":{"version":"1.0.0","format":"ze-bgp"},"message":{"type":"update"},"peer":{"address":"127.0.0.1","remote":{"as":65533}},"direction":"in","local-preference":500,"origin":"igp","ipv6/unicast":[{"action":"add","nlri":["2605::2/128"],"next-hop":"2001::1"}]}
cmd=api:conn=1:seq=2:text=peer * update text origin igp local-preference 500 nhop 2001::2 nlri ipv6/unicast add 2605::2/128
expect=bgp:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF004E020000003740010100400200400504000001F4800E260002011020010000000000000000000000000002008026050000000000000000000000000002
expect=json:conn=1:seq=2:json={"meta":{"version":"1.0.0","format":"ze-bgp"},"message":{"type":"update"},"peer":{"address":"127.0.0.1","remote":{"as":65533}},"direction":"in","local-preference":500,"origin":"igp","ipv6/unicast":[{"action":"add","nlri":["2605::2/128"],"next-hop":"2001::2"}]}
cmd=api:conn=1:seq=3:text=peer * update text origin igp local-preference 500 nhop 2001::1 nlri ipv6/unicast add 2605::2/128
expect=bgp:conn=1:seq=3:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF004E020000003740010100400200400504000001F4800E260002011020010000000000000000000000000001008026050000000000000000000000000002
expect=json:conn=1:seq=3:json={"meta":{"version":"1.0.0","format":"ze-bgp"},"message":{"type":"update"},"peer":{"address":"127.0.0.1","remote":{"as":65533}},"direction":"in","local-preference":500,"origin":"igp","ipv6/unicast":[{"action":"add","nlri":["2605::2/128"],"next-hop":"2001::1"}]}
EOF_PEER

# native plugin script

# ze bgp configuration
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external announce-routes {
		run "ze-test fixture plugin/nexthop"
		encoder json
	}
}
bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65512
				remote 65512
			}
			router-id 10.0.0.139
			family {
				ipv6/unicast { prefix { maximum 10000; } }
			}
		}
		timer {
			receive-hold-time 30
		}

		attach process announce-routes {
			send [ update ]
		}
	}
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=10s
