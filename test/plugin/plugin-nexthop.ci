# Migrated from test/data/plugin/nexthop.*

# ze-peer expectations
stdin=peer:terminator=EOF_PEER
# Step 5: commands migrated to bgp peer prefix
#
# No End-of-RIB position is asserted here, because ze promises none against
# these routes. A process that creates routes stands where a peer stands (owner
# ruling, 2026-09-18): ze holds its marker for nobody, so the marker follows
# ze's own table and has no defined order against a process's announce
# (docs/architecture/behavior/peer-lifecycle.md, "What the End-of-RIB marker
# orders, and what it does not", restated by the owner on 2026-11-14). The
# 2026-09-18 ruling superseded the 2026-08-30 one this file used to quote, that
# a plugin-injected route belongs to this speaker's initial routing update and
# the End-of-RIB waits for it: the marker waits for no process.
#
# The driver (`nexthopRoutes`, internal/test/fixture/plugin_fixture_11.go)
# sends the seq=1 announce and only then waits for `eor-sent`, so the marker
# lands before or after seq=1 as timing decides, and the marker expectation
# this file once carried failed 13 of 40 on exactly that
# (internal/le/test/stressrepro/actions.go). The marker beside a route nothing
# orders is asserted as an unordered pair elsewhere:
# test/plugin/initial-sync-barrier-raw.ci for a raw route, and
# test/plugin/initial-sync-marker-beside-process-route.ci for a process's
# route.
#
# The rule's cmd=api documentation line went with it: cmd=api sets Cmd on the
# message at that conn/seq (internal/test/runner/record_parse.go), so leaving it
# would have relabelled the renumbered 2001::2 announce with the EOR command
# text.
#
# The marker's EXISTENCE is still required: the driver fails the run with
# "initial-sync end-of-rib never reached the wire" when `eor-sent` never rises.
#
# Nothing else is relaxed. All three announce rules keep their exact hex,
# including the ORIGIN, AS_PATH, LOCAL_PREF, MP_REACH attribute order that
# reactor_api_batch.go insertAttrOrdered now guarantees on both announce rails.
cmd=api:conn=1:seq=1:text=send bgp * update text origin igp local-preference 500 nhop 2001::1 mp ipv6/unicast add 2605::2/128
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF004E0200000037800E26000201102001000000000000000000000000000100802605000000000000000000000000000240010100400200400504000001F4
expect=json:conn=1:seq=1:json={"meta":{"version":"1.0.0","format":"ze-bgp"},"message":{"type":"update"},"peer":{"address":"127.0.0.1","remote":{"as":65533}},"direction":"in","local-preference":500,"origin":"igp","ipv6/unicast":[{"action":"add","nlri":["2605::2/128"],"next-hop":"2001::1"}]}
cmd=api:conn=1:seq=2:text=send bgp * update text origin igp local-preference 500 nhop 2001::2 mp ipv6/unicast add 2605::2/128
expect=bgp:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF004E0200000037800E26000201102001000000000000000000000000000200802605000000000000000000000000000240010100400200400504000001F4
expect=json:conn=1:seq=2:json={"meta":{"version":"1.0.0","format":"ze-bgp"},"message":{"type":"update"},"peer":{"address":"127.0.0.1","remote":{"as":65533}},"direction":"in","local-preference":500,"origin":"igp","ipv6/unicast":[{"action":"add","nlri":["2605::2/128"],"next-hop":"2001::2"}]}
cmd=api:conn=1:seq=3:text=send bgp * update text origin igp local-preference 500 nhop 2001::1 mp ipv6/unicast add 2605::2/128
expect=bgp:conn=1:seq=3:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF004E0200000037800E26000201102001000000000000000000000000000100802605000000000000000000000000000240010100400200400504000001F4
expect=json:conn=1:seq=3:json={"meta":{"version":"1.0.0","format":"ze-bgp"},"message":{"type":"update"},"peer":{"address":"127.0.0.1","remote":{"as":65533}},"direction":"in","local-preference":500,"origin":"igp","ipv6/unicast":[{"action":"add","nlri":["2605::2/128"],"next-hop":"2001::1"}]}
EOF_PEER

# native plugin script

# ze bgp configuration
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external announce-routes {
		run "le test fixture plugin/nexthop"
		encoder json
	}
}
bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65512
				remote 65512
			}
			router-id 10.0.0.139
			family {
				ipv6/unicast { prefix { maximum 10000; } }
			}
		}
		timer {
			receive-hold-time 30
		}

		attach process announce-routes {
			send [ update ]
		}
	}
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=10s
