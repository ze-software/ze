# Test: `show doctor` includes owner-registered runtime dependency checks.
#
# VALIDATES: command-surface-ownership Phase 6 -- the daemon `show doctor`
#            provider bridge runs checks registered by owner packages, not only
#            checks left in cmd/ze/doctor.
# PREVENTS: owner-registered doctor checks disappearing from the daemon command
#           surface while `ze doctor` still works.

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

tmpfs=doctor-missing-plugin.conf:terminator=EOF_DOCTOR_CONF
plugin {
    external feed {
        run /nonexistent/ze-plugin-binary
        encoder json
    }
}
EOF_DOCTOR_CONF


stdin=ze-conf:terminator=EOF_CONF
plugin {
    external doctor-owner-check-show {
        run "ze-test fixture plugin/doctor-owner-check-show"
        encoder json
    }
}

bgp {
    peer peer1 {
        connection {
            remote {
                ip 127.0.0.1
            }
            local {
                ip 127.0.0.1
                accept false
            }
        }
        session {
            asn {
                local 1
                remote 1
            }
            router-id 1.2.3.4
            family {
                ipv4/unicast { prefix { maximum 10000; } }
            }
            capability {
                graceful-restart disable
            }
        }
        behavior {
            group-updates disable
        }
    }
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-conf:timeout=15s
expect=exit:code=0
