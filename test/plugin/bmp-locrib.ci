# Test: BMP sender emits RFC 9069 Loc-RIB Route Monitoring (PeerType=3).
# VALIDATES: with `loc-rib true`, a best-path change in ze's local RIB reaches
#            the BMP collector as a Route Monitoring message whose per-peer
#            header has Peer Type = 3 (Loc-RIB) and whose embedded PDU is a
#            complete BGP UPDATE (marker + length + type=UPDATE). A Loc-RIB
#            Peer Up (Peer Type 3) precedes it.
#
#            The top-level `router-id` and `session asn local` are what the
#            emulated peer describes itself with (RFC 9069 Section 5.1), so a
#            config that names neither gets no Loc-RIB feed at all. Both are
#            `mandatory true` in internal/component/bgp/yang/ze-bgp-conf.yang.
# PREVENTS:  regressing rib-arch-5 -- Loc-RIB monitoring silently not emitting,
#            or emitting with the wrong peer type / a malformed UPDATE PDU.
#
# Flow:
# 1. Start a native fixture BMP collector listener on $PORT2.
# 2. Start ze as BMP sender (loc-rib enabled), peered with ze-peer.
# 3. ze-peer announces a prefix -> ze's RIB selects it as best -> the bmp
#    plugin builds a PeerType=3 Route Monitoring from the best-change event.
# 4. Collector validates a PeerType=3 Route Monitoring PDU, then prints a
#    sentinel. Per-peer (PeerType=0) monitoring messages are ignored.
# 5. Test matches the sentinel on stderr.

option=env:var=ze.log.bgp.bmp:value=info
# 30s, not 20s: the observer's fail-closed path must be able to SPEAK. Its worst
# case is wait_for_post_startup 5s + marker barrier 10s (100 x 0.1) = 15s, and the
# daemon's own startup and handshake come out of the same budget. At 20s the
# runner's timeout could fire first on exactly the slow run the barrier exists to
# diagnose, reporting a bare timeout instead of the observer's reason. A passing
# run is unaffected (~2s).
option=timeout:value=30s



stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=update:value=send-route:prefix=10.20.30.0/24:origin-as=65001:next-hop=101.1.101.1
# ze replies with EOR after the initial RIB exchange
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

stdin=ze-bgp:terminator=EOF_CONF
bgp {
    router-id 1.2.3.5;
    session {
        asn {
            local 65000;
        }
    }
    bmp {
        sender {
            collector test-collector {
                address 127.0.0.1;
                port $PORT2;
            }
            loc-rib true;
        }
    }
    peer test-peer {
        connection {
            remote {
                ip 127.0.0.1
            }
            local {
                ip 127.0.0.1
                accept false
            }
        }
        session {
            asn {
                local 65000;
                remote 65001;
            }
            router-id 1.2.3.5;
            family {
                ipv4/unicast { prefix { maximum 10000; } }
            }
        }
        behavior {
            group-updates disable;
        }
    }
}
plugin {
    external bmp-shutdown {
        run "ze-test fixture plugin/bmp-locrib;"
        encoder json;
    }
}
EOF_CONF

cmd=background:seq=1:exec=ze-test fixture plugin/bmp-locrib-collector $PORT2
cmd=background:seq=2:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=3:exec=ze --plugin ze.bgp-bmp -:stdin=ze-bgp
expect=exit:code=0
expect=stderr:pattern=BMP-COLLECTOR: listening on
expect=stderr:pattern=BMP-COLLECTOR: valid-locrib-route-monitoring
reject=stderr:pattern=BMP-COLLECTOR: invalid-pdu
expect=stderr:pattern=BMP-COLLECTOR: done
