# Test: show bgp health returns the peer health overview
# Exercises: dispatch-command -> ze-show:bgp-health -> handleShowBGPHealth
# Verifies the R9 rename `show bgp health` (was `show bgp-health`) dispatches
# and returns the overview JSON {peers, count, not-established}. Native (no
# kernel feature); the configured peer1 supplies at least one row.

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
option=asn:value=65001
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

tmpfs=show-bgp-health-test.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
import json
import sys
from ze_api import API, dispatch, runtime_fail, result_text_data


def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()
    api.wait_for_post_startup(timeout=5.0)

    try:
        resp = dispatch(api, 'show bgp health')
        status = resp.get('status')
        data = result_text_data(resp)
        if status != 'done':
            runtime_fail(f'bgp-health: status={status} data={data}')

        if isinstance(data, str) and data:
            data = json.loads(data)
        if not isinstance(data, dict):
            runtime_fail(f'bgp-health: expected dict, got {type(data).__name__}')

        for key in ('peers', 'count', 'not-established'):
            if key not in data:
                runtime_fail(f'bgp-health: missing key {key!r} in {list(data.keys())}')
        if not isinstance(data['peers'], list):
            runtime_fail(f'bgp-health: peers is not a list: {data["peers"]!r}')

        print(f'OK: bgp health count={data["count"]} keys={list(data.keys())}', file=sys.stderr)
    finally:
        dispatch(api, 'request shutdown')
        api.wait_for_shutdown()

if __name__ == '__main__':
    main()
EOF_RUN

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external show-bgp-health-test {
		run ./show-bgp-health-test.run
		encoder json
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast {
					prefix {
						maximum 10000
					}
				}
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}

		process show-bgp-health-test {
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
