# Test: TACACS+ single-connect reuses one TCP connection across sessions.
# VALIDATES: AC-16.

stdin=ze-conf:terminator=EOF_CONF
bgp {
	peer peer1 {
		connection { remote { ip 127.0.0.2; } local { ip 127.0.0.1; accept false; } }
		session { asn { local 65533; remote 65533; } }
	}
}
system {
	authentication {
		tacacs {
			server 127.0.0.1 { port $PORT; key "ze-mock-key"; }
			timeout 2
			accounting true
		}
		tacacs-profile 15 { profile [ admin ]; }
	}
	authorization {
		profile admin { run { default-action allow; } edit { default-action allow; } }
	}
}
environment { ssh { enabled true; server main { ip 127.0.0.1; port $PORT2; } } }
plugin {
	external tacacs-singleconnect-test {
		run "ze-test fixture plugin/tacacs-singleconnect $PORT $PORT2"
		encoder json
	}
}
EOF_CONF

cmd=foreground:seq=1:exec=ze -:stdin=ze-conf:timeout=25s
expect=exit:code=0
expect=stderr:pattern=tacacs-mock: single-connect accepted
expect=stderr:pattern=tacacs-mock: connection #1
reject=stderr:pattern=tacacs-mock: connection #2
expect=stderr:pattern=OK: repeated TACACS\+ sessions completed over the negotiated connection
reject=stderr:pattern=ZE-OBSERVER-FAIL
