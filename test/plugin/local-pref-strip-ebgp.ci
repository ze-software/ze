# Test: RFC 4271 Section 5.1.5 -- LOCAL_PREF never leaves toward an external peer
# VALIDATES: spec-fixit-send-community-suppress-ignored AC-13, AC-14 -- a route
#   LEARNED from an internal peer and RELAYED to an external one reaches the
#   socket with no LOCAL_PREF attribute, and with every other attribute intact.
# PREVENTS: the live MUST NOT violation this spec fixes. Two egress rails already
#   stripped the attribute for an external destination -- buildAnnounceUpdate
#   (reactor/reactor_api_batch.go) and writeAnnounceUpdateWithPlan
#   (reactor/reactor_wire.go) -- but the FORWARD rail relayed the source
#   attribute block verbatim, so the same prefix crossed the AS boundary carrying
#   the internal preference when it was relayed and did not when it was
#   originated. applyFactsLocalPref (reactor/forward_local_pref.go) records the
#   strip; localPrefAllowedTo is the one predicate all four rails now ask.
#
# RFC requirement: RFC4271-5.1.5-2 positive -- "A BGP speaker MUST NOT include
#   this attribute in UPDATE messages it sends to external peers, except in the
#   case of BGP Confederations [RFC3065]." The destination expectation is the
#   FULL UPDATE, byte for byte, so it fails both ways: a run that leaks
#   LOCAL_PREF fails, and so does a run that strips more than LOCAL_PREF.
# RFC requirement: RFC4271-5.1.5-2 negative -- the attribute reaches Ze in the
#   first place. The source expectation below is Ze's End-of-RIB, so a source
#   whose UPDATE was never read cannot satisfy this file.
#
# This exercises the GENERAL forward rail (forwardUpdateCore,
# reactor/reactor_api_forward.go). bgp-rs IS loaded and IS the program that asks
# for the forward: it is what turns the source's UPDATE into a write toward
# dest-ebgp-peer, and nothing else here does. bgp-adj-rib-in only replays on
# peer-up (rib.go RelayStoredRoute), so with the rs attach removed the
# destination is sent no UPDATE at all -- measured 4/4 with the observer's
# ZE-OBSERVER-FAIL, which is why the attach stays.
#
# What is NOT on the path is reactorForwardRS, the reactor's own RS fast path:
# no peer here sets `rs-fast-path`, so bgp-rs reaches the wire through the plugin
# dispatch and forwardUpdateCore. That fast-path copy of the same strip is proven
# against a real peer by test/interop/scenarios/54-local-pref-strip-frr.
#
# The header said "no route-server plugin is loaded" until 2026-08-15. That was
# never true: registry.Registration in bgp/plugins/rs/register.go declares
# `ConfigRoots: []string{"bgp"}`, so getConfigPathPlugins
# (plugin/server/startup_autoload.go) auto-loads bgp-rs for ANY config with a bgp
# container, and it did so here before the attach block existed. What the attach
# adds is the delivery edge, not the process.
#
# An absence assertion is satisfied just as well by a daemon that forwarded
# nothing, so the observer below fails loudly when the destination was never sent
# a real UPDATE.

option=env:var=ze.log.bgp.forward:value=info

# Source peer: INTERNAL (65000 -> 65000) on 127.0.0.1.
stdin=source:terminator=EOF_SOURCE
option=tcp_connections:value=1
option=timeout:value=20s
# linger for the reason send-community-suppress.ci carries it: the source must
# outlive the destination assertion, or Ze reads the close as session-down and
# withdraws the relayed route while the destination is still being checked.
option=linger:value=true
# UPDATE: ORIGIN=IGP, AS_PATH=[] (iBGP, empty), NEXT_HOP=1.1.1.1,
#   LOCAL_PREF=200 (0x000000C8), COMMUNITY=65000:200, NLRI=10.0.0.0/24.
# Attrs: ORIGIN(4) + AS_PATH(3) + NEXT_HOP(7) + LOCAL_PREF(7) + COMMUNITY(7)
#        = 28 = 0x1C
# Total: 16+2+1+2+2+28+4 = 55 = 0x37
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0037020000001C4001010040020040030401010101400504000000C8C00804FDE800C8180A0000
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_SOURCE

# Destination: EXTERNAL (65000 -> 65002) on 127.0.0.2.
# Expect ORIGIN + AS_PATH[65000] + NEXT_HOP + COMMUNITY + NLRI, and NO LOCAL_PREF.
# Ze prepends its own AS for an external peer, so AS_PATH grows from empty to one
# AS_SEQUENCE of [65000] (0x02 0x01 0000FDE8).
# Attrs: ORIGIN(4) + AS_PATH(9) + NEXT_HOP(7) + COMMUNITY(7) = 27 = 0x1B
# Total: 16+2+1+2+2+27+4 = 54 = 0x36
# The COMMUNITY is in the expectation on purpose: it sits AFTER LOCAL_PREF in
# ascending code order, so a strip that took the wrong span would move it.
stdin=dest-ebgp:terminator=EOF_DEST_EBGP
option=tcp_connections:value=1
option=timeout:value=20s
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0036020000001B4001010040020602010000FDE840030401010101C00804FDE800C8180A0000
EOF_DEST_EBGP

tmpfs=test-localpref.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
"""Keep the daemon alive while the external peer proves its wire.

The expect=bgp rule on dest-ebgp is the authoritative assertion. This observer
owns `request shutdown` and fails loudly if the destination was never sent a
real UPDATE: "no LOCAL_PREF" is satisfied just as well by "no UPDATE at all".
"""
import json
import sys
from ze_api import API, runtime_fail, result_text_data


def peer_got_route(result):
    """True once this peer has been sent an UPDATE that is not its own EOR.

    updates-sent counts every UPDATE written to the peer, End-of-RIB included,
    so the DIFFERENCE against eor-sent is the forwarded route. Not gated on
    state == established: a check-mode ze-peer without linger closes the moment
    its expect=bgp rule matches, so requiring established would be unsatisfiable
    in exactly the run that passed.
    """
    if result.get('status') != 'done':
        return False
    data = result_text_data(result, '{}')
    try:
        parsed = json.loads(data) if isinstance(data, str) else data
    except (json.JSONDecodeError, TypeError, ValueError):
        return False
    if not isinstance(parsed, dict):
        return False
    peers = parsed.get('peers', {})
    if not isinstance(peers, dict):
        return False
    for row in peers.values():
        if isinstance(row, dict) and row.get('updates-sent', 0) - row.get('eor-sent', 0) >= 1:
            return True
    return False


def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()

    api.quiesce()
    result = api.dispatch_until(
        'show bgp peer dest-ebgp-peer detail', peer_got_route, attempts=24,
    )
    if not peer_got_route(result):
        detail = result_text_data(result)
        print(f'FAIL: dest-ebgp-peer detail: {detail}', file=sys.stderr)
        sys.stderr.flush()
        runtime_fail('dest-ebgp-peer was never sent the forwarded route')
    print('OK: dest-ebgp-peer was sent the forwarded route', file=sys.stderr)

    api.dispatch('request shutdown')
    api.wait_for_shutdown()


if __name__ == '__main__':
    main()
EOF_RUN

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	internal adj-rib-in {
		use bgp-adj-rib-in
	}
	internal rs {
		use bgp-rs
	}
	external test-localpref {
		run ./test-localpref.run
		encoder json
	}
}
bgp {
	peer source-peer {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65000
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
		attach process adj-rib-in {
			receive [ update-received state ]
			send [ update ]
		}
	}

	peer dest-ebgp-peer {
		connection {
			remote {
				ip 127.0.0.2
			}
			local {
				ip 127.0.0.2
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65002
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
		attach process adj-rib-in {
			receive [ update-received state ]
			send [ update ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=source
cmd=background:seq=2:exec=ze-peer --bind 127.0.0.2 --port $PORT:stdin=dest-ebgp
cmd=foreground:seq=3:exec=ze -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
reject=stderr:pattern=panic recovered
reject=stderr:pattern=fatal error
reject=stderr:pattern=treat-as-withdraw
reject=stderr:pattern=ZE-OBSERVER-FAIL
