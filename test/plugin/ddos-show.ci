# Test: the `show ddos` command tree reaches the ddos-observe / ddos-local /
# ddos-flowspec plugins.
# Exercises: config ddos{detect,observe,local,flowspec} -> RunEngine ->
#            activeStore / activeResponder set, then dispatch-command ->
#            ze-show:ddos{,-incidents,-local,-flowspec} -> the show handlers.
# Verifies the wire methods resolve and that loading each plugin wires it to the
# process-global its show handler reads (enabled=true; empty ring / not-active
# with no traffic). The emit/mitigate path is covered by the plugins' unit tests
# since the .ci harness cannot synthesize an attack without a traffic generator.
#
# STATUS: option=needs-linux. ddos-detect declares Dependencies: ["interface"]
# and ddos-local declares Dependencies: ["firewall"], so the daemon also starts
# the interface plugin, which has no OS-default backend on darwin ("no backend
# configured and no OS default available") and fails startup before the show
# handlers run. Runs on Linux (CI/QEMU) where the netlink backend is available.
option=needs-linux
# Serialize against every other ddos test: they all flood the SAME loopback
# interface and the detector picks the victim by top-destination-bytes over that
# interface, so a sibling's concurrent flood is indistinguishable from this
# test's own. Rationale in full: test/plugin/ddos-direction.ci.
option=exclusive:group=ddos-flood

# ze-peer: accepts connection
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
option=asn:value=65001
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

tmpfs=ddos-show-test.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
import json
import sys
from ze_api import API, runtime_fail, result_text_data

def dispatch(api, command):
    resp = api._call_engine(
        'ze-plugin-engine:dispatch-command', {'command': command})
    if resp is None:
        return {'status': 'error', 'data': 'engine call returned None'}
    return resp.get('result', {})

def check(api, command, keys):
    resp = dispatch(api, command)
    status = resp.get('status')
    if status != 'done':
        runtime_fail(f'{command}: status={status} data={resp.get("data")}')
    data = result_text_data(resp)
    if isinstance(data, str) and data:
        data = json.loads(data)
    if data.get('enabled') is not True:
        runtime_fail(f'{command}: enabled != true (plugin not wired): {data}')
    for k in keys:
        if k not in data:
            runtime_fail(f'{command}: missing {k!r} in {data}')
    print(f'OK: {command} -> {data}', file=sys.stderr)
    return data

def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()
    api.wait_for_post_startup(timeout=5.0)

    try:
        status = check(api, 'show ddos status', ['active-attacks', 'incidents'])
        if status['active-attacks'] != 0:
            runtime_fail(f'show ddos status: active-attacks != 0 with no traffic: {status}')
        incs = check(api, 'show ddos incidents', ['incidents'])
        if not isinstance(incs['incidents'], list):
            runtime_fail(f'show ddos incidents: incidents not a list: {incs["incidents"]!r}')
        local = check(api, 'show ddos local', ['active'])
        if local['active'] is not False:
            runtime_fail(f'show ddos local: active != false with no attack: {local}')
        flowspec = check(api, 'show ddos flowspec', ['active'])
        if flowspec['active'] is not False:
            runtime_fail(f'show ddos flowspec: active != false with no attack: {flowspec}')
    finally:
        dispatch(api, 'request shutdown')
        api.wait_for_shutdown()

if __name__ == '__main__':
    main()
EOF_RUN

stdin=ze-bgp:terminator=EOF_CONF
ddos {
	detect {
		enabled true
	}
	observe {
		incident-ring-size 100
	}
	local {
		response-level alert
	}
	flowspec {
		response-level alert
		# action is mandatory with no default (ze-ddos-flowspec-conf.yang: neither
		# drop nor rate-limit is universally safe). Omitting it made ddos-flowspec
		# reject its config at stage 2, which aborted the whole startup barrier and
		# failed this test on exit code, not on anything it asserts. discard needs
		# no rate-limit-bytes, and response-level alert means nothing is enforced.
		action discard
	}
}

plugin {
	external ddos-show-test {
		run ./ddos-show-test.run
		encoder json
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast {
					prefix {
						maximum 10000
					}
				}
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}

		process ddos-show-test {
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
