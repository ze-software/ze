# Test: commit start then rollback discards queued routes
# VALIDATES: commit rollback dispatches and discards without sending
# PREVENTS: rollback silently failing or still sending routes

# ze-peer expectations
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# Python test plugin: exercises dispatch-command for commit rollback
tmpfs=commit-lifecycle-test.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
import sys
import time
from ze_api import API, runtime_fail

def dispatch(api, command):
    resp = api._call_engine(
        'ze-plugin-engine:dispatch-command', {'command': command})
    if resp is None:
        return {'status': 'error', 'data': 'engine call returned None'}
    return resp.get('result', {})

def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()
    api.wait_for_post_startup(timeout=5.0)

    # Wait for peer1's initial sync (the EOR this test's ze-peer expects) to
    # reach the wire, BEFORE asserting anything or shutting down. Without this
    # barrier the peer's EOR expectation is unreachable by construction: the
    # script can complete and dispatch `request shutdown` inside the OPEN
    # handshake window, closing the session under the peer, which then reports
    # `failed: connection closed before completion`.
    #
    # // the `'established' in <detail json>` check removed here was
    # VACUOUS, not coverage: every peer row carries the key
    # `connections-established` (cmd/peer/peer.go:238), so the substring matched
    # on the FIRST poll -- before any session existed -- and the barrier returned
    # instantly, gating nothing. It is replaced by a STRICTLY STRONGER wait on
    # the per-peer `eor-sent` counter (peer.go:217; peer_stats.go IncrEORSent
    # increments it only once peer_initial_sync.go's sendInitialRoutes has written
    # AND flushed the EOR to the peer's socket), which cannot return before the
    # asserted frame is on the wire,
    # and by runtime_fail instead of the sys.exit(1) observer antipattern the
    # runner ignores (ai/rules/testing.md, Observer-Exit Antipattern).
    if not api.wait_peer_eor_sent('peer1', attempts=40):
        runtime_fail('peer1 initial-sync EOR never reached the wire')
    # Complement, not a substitute: quiesce drains the forward pool, but its
    # bgp-peer-sync quiescer skips a peer that has not begun its initial sync
    # (reactor_api.go peersSynced), so it returns instantly before establishment.
    api.quiesce()

    try:
        # Start a named commit
        result = dispatch(api, 'request commit rollback-test start')
        if result.get('status') != 'done':
            print(f'FAIL: commit start status={result.get("status")} data={result.get("data")}', file=sys.stderr)
            sys.exit(1)

        # Rollback (discard)
        result = dispatch(api, 'request commit rollback-test rollback')
        if result.get('status') != 'done':
            print(f'FAIL: commit rollback status={result.get("status")} data={result.get("data")}', file=sys.stderr)
            sys.exit(1)

        # Verify commit list shows no active commits
        result = dispatch(api, 'request commit list')
        if result.get('status') != 'done':
            print(f'FAIL: commit list status={result.get("status")}', file=sys.stderr)
            sys.exit(1)

        print('OK: commit start/rollback/list lifecycle completed', file=sys.stderr)
    finally:
        dispatch(api, 'request shutdown')
        api.wait_for_shutdown()

if __name__ == '__main__':
    main()
EOF_RUN

# ze bgp configuration
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external commit-lifecycle-test {
		run ./commit-lifecycle-test.run
		encoder json
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}

		attach process commit-lifecycle-test {
			send [ update ]
		}
	}
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
