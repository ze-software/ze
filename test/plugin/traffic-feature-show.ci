# Test: show traffic feature returns the neutral per-source feature snapshot
# Exercises: dispatch-command -> ze-show:traffic-feature -> handleShowTrafficFeature
# Verifies AC-9: the wire method resolves and returns structured JSON with the
# degraded flag and a top-source-ips array (empty when there is no traffic).

# ze-peer: accepts connection
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
option=asn:value=65001
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

tmpfs=traffic-feature-show-test.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
import json
import sys
from ze_api import API, runtime_fail, result_text_data

def dispatch(api, command):
    resp = api._call_engine(
        'ze-plugin-engine:dispatch-command', {'command': command})
    if resp is None:
        return {'status': 'error', 'data': 'engine call returned None'}
    return resp.get('result', {})

def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()
    api.wait_for_post_startup(timeout=5.0)

    try:
        resp = dispatch(api, 'show traffic feature')
        status = resp.get('status')
        if status is None:
            runtime_fail(f'traffic-feature: dispatch returned no status: {resp}')
        if status != 'done':
            runtime_fail(f'traffic-feature: status={status} data={resp.get("data")}')

        data = result_text_data(resp)
        if isinstance(data, str) and data:
            data = json.loads(data)

        if 'degraded' not in data:
            runtime_fail(f'traffic-feature: missing "degraded" in {data}')
        if 'top-source-ips' not in data:
            runtime_fail(f'traffic-feature: missing "top-source-ips" in {data}')
        if not isinstance(data['top-source-ips'], list):
            runtime_fail(f'traffic-feature: top-source-ips not a list: {data["top-source-ips"]!r}')

        print(f'OK: traffic-feature degraded={data["degraded"]} sources={len(data["top-source-ips"])}', file=sys.stderr)
    finally:
        dispatch(api, 'request shutdown')
        api.wait_for_shutdown()

if __name__ == '__main__':
    main()
EOF_RUN

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external traffic-feature-show-test {
		run ./traffic-feature-show-test.run
		encoder json
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast {
					prefix {
						maximum 10000
					}
				}
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
