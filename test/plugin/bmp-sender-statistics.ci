# Test: BMP sender emits a periodic Statistics Report at statistics-timeout.
# VALIDATES: AC-1 -- statistics-timeout N sends a Statistics Report to every
#            collector, for every established peer, every N seconds.
# VALIDATES: AC-3 -- each report carries RFC 7854 Stat Type 13 as a 4-byte
#            counter, and its per-peer header clears the RFC 8671 O flag.
# PREVENTS:  the leaf being parsed, compared and bounced over while nothing
#            reaches the wire, which is what ze did before this test existed.
#
# Flow:
# 1. Start a native fixture BMP collector listener on $PORT2.
# 2. Start ze as BMP sender with statistics-timeout 1, peered with ze-peer.
# 3. ze-peer establishes; ze reports it up to the collector, then sends one
#    Statistics Report per second.
# 4. The collector validates TWO reports: at least one statistic, Stat Type 13
#    four bytes wide, and the O flag clear. Two, because one report proves a
#    report was sent and says nothing about a timer.
# 5. Test matches the sentinel on stderr.

option=env:var=ze.log.bgp.bmp:value=info
option=timeout:value=30s



stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=update:value=send-route:prefix=10.20.30.0/24:origin-as=65001:next-hop=101.1.101.1
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

stdin=ze-bgp:terminator=EOF_CONF
environment {
    bmp {
        enabled true;
    }
}
bgp {
    router-id 1.2.3.5;
    bmp {
        sender {
            collector test-collector {
                address 127.0.0.1;
                port $PORT2;
            }
            route-monitoring-policy all;
            statistics-timeout 1;
        }
    }
    peer test-peer {
        connection {
            remote {
                ip 127.0.0.1
            }
            local {
                ip 127.0.0.1
                accept false
            }
        }
        session {
            asn {
                local 65000;
                remote 65001;
            }
            router-id 1.2.3.5;
            family {
                ipv4/unicast { prefix { maximum 10000; } }
            }
        }
        behavior {
            group-updates disable;
        }
    	attach process bgp-bmp {
    		receive [ state update open notification keepalive refresh ]
    	}
    }
}
plugin {
    external bmp-shutdown {
        run "ze-test fixture plugin/bmp-sender-statistics;"
        encoder json;
    }
}
EOF_CONF

cmd=background:seq=1:exec=ze-test fixture plugin/bmp-sender-statistics-collector $PORT2
cmd=background:seq=2:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=3:exec=ze --plugin ze.bgp-bmp -:stdin=ze-bgp
expect=exit:code=0
expect=stderr:pattern=BMP-COLLECTOR: listening on
expect=stderr:pattern=BMP-COLLECTOR: valid-statistics-report
reject=stderr:pattern=BMP-COLLECTOR: invalid-pdu
