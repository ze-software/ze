# Migrated from test/data/plugin/logging-level-filter.*
#
# Test: a per-subsystem log level set in the environment silences that
#       subsystem's DEBUG output in the running daemon.
#
# VALIDATES: ze.log.bgp.server=info stops bgp.server DEBUG lines reaching stderr.
# PREVENTS:  a level filter that is parsed at startup and never applied.
#
# NON-VACUITY (ai/rules/interop-and-goal-validation.md). One line carries the
# whole claim, reject=stderr:pattern=level=DEBUG, so its discrimination was
# measured and not argued. The mutation is one word: a copy of this file whose
# only edit is option=env:var=ze.log.bgp.server:value=debug FAILS, reporting
# `reject=stderr pattern found: level=DEBUG`, and the lines it finds carry
# subsystem=bgp.server. That copy was drafted as test/draft/plugin/mut-debuglevel.ci
# and run on 2026-08-17; a draft is deleted once its subject is promoted, so the
# path is a record of the run and not a file to open.
# The rejection is answered by a DEBUG site that fires in this scenario, and not
# by a subsystem that stays silent whatever the level is.
#
# WHY A RUNNER DIRECTIVE IS READ INSIDE A PEER BLOCK. ze-peer does not consume
# reject=stderr, so ClaimLine (internal/test/peer/expect.go) answers ClaimRunner
# and validateOnePeerBlock (internal/test/runner/peer_contract.go) gives the line
# to the runner's own parser where it stands. Before that guard existed, this
# file stated the same subject while the line was discarded in silence, and it
# passed on a daemon with no level filter at all.
#
# WHAT THIS FILE DOES NOT PROVE. It holds no assertion that bgp.server logged
# anything in the passing run, so a build that stopped logging that subsystem
# altogether would also pass. The control for that is the mutation above, not a
# line in this file.

# Set bgp.server subsystem logging to INFO level (filters out DEBUG).
# Convention is ze.log.<subsystem> per slogutil.go — see docs/functional-tests.md.
# Must live OUTSIDE the stdin=peer block: option=env is consumed by the
# test runner (seeds proc.Env), not ze-peer.
option=env:var=ze.log.bgp.server:value=info

# ze-peer expectations
stdin=peer:terminator=EOF_PEER
option=timeout:value=10s

# Test: Level filtering
# Verifies ze.log.bgp.server=info filters out DEBUG messages

# Static route UPDATE
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00300200000015400101004002004003040A0000014005040000006418C0A801
# EOR
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000

# DEBUG messages should NOT appear (server subsystem logs at DEBUG level).
# The runner reads this line where it stands. option=env above is the one
# directive a peer block refuses, because it sets the environment of every
# process the test starts rather than of this peer.
reject=stderr:pattern=level=DEBUG
EOF_PEER

# ze bgp configuration
stdin=ze-bgp:terminator=EOF_CONF
# Test: Level filtering
# Verifies that ze.bgp.log.server=info filters out DEBUG messages

plugin {
    internal gr {
        use bgp-gr
    }
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
			    ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
			    graceful-restart {
			        restart-time 120
			    }
			}
		}
		behavior {
			group-updates disable
		}
	
	
	
	    update {
	        attribute {
	            origin igp
	            local-preference 100
	            next-hop 10.0.0.1
	        }
	        nlri {
	            ipv4/unicast add 192.168.1.0/24
	        }
	    }
	
	    attach process gr {
	    	receive [ open-received state eor ]
	    	send [ update ]
	    }
	}
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=10s
