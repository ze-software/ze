# prefixsid-announce-rail-boundary -- RFC 8669 Section 8 on the API ANNOUNCE rail,
# with its confining positive in the same run.
#
# RFC requirement: RFC8669-8-1 negative -- "The propagation to other ASes MUST be explicitly
# configured." Receiver A is an eBGP neighbor that sets no propagate-srv6-prefix-sid, and the
# UPDATE the API announce produces for it carries no attribute 40 at all.
# RFC requirement: RFC8669-8-1 positive -- that removal is CONFINED to neighbors the operator has
# not configured. Receiver B is identical except that it sets propagate-srv6-prefix-sid true, and
# it is sent the attribute byte for byte. ONE `send bgp * update hex` reaches both, so the two
# frames differ in attribute 40 and in nothing else.
#
# WHY THIS FILE EXISTS BESIDE prefixsid-ebgp-egress-boundary.ci. That file drives the FORWARD
# rail: a route received from a source peer and relayed. This one drives the rail ze ORIGINATES
# on, buildBatchAnnounceUpdate (internal/component/bgp/reactor/reactor_api_batch.go), which
# copies the caller's attribute block verbatim and asked nobody about attribute 40 until
# 2026-09-05. It carries the API announce, the grouped announce and the RFC 9494 stale
# readvertise.
#
# WHY group-updates IS LEFT AT ITS DEFAULT (true). The two receivers differ in one leaf, and that
# leaf is a field of announceBuildKey. With grouping on, a key that did not carry it would put
# both peers in ONE build group and send them ONE frame, so exactly one of the two expectations
# below would fail. That is what makes this file the test of the key and not only of the drop.
#
# NO LOCAL_PREF in the announce: the destinations are eBGP peers and RFC 4271 Section 5.1.5
# forbids one toward them, so the sibling strip would remove it and the frames below would pin
# that removal as much as this one.

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=2
option=timeout:value=20s
option=bind:value=0.0.0.0
# Bind conn=N by remote IP rather than accept order: which session establishes first is a race,
# and the two receivers must be told apart by identity, not arrival (peer_connmap.go).
option=conn_map:value=remote-ip

# The announce is issued by the fixture plugin below, over ze's own command
# dispatcher, once both sessions are established and quiet:
#   send bgp * update hex attr set 40010100C0280A01000700000000000064
#           nhop set 0A000001 nlri ipv4/unicast add 18C00002
# ORIGIN igp, then flags 0xC0 optional transitive, code 40 (0x28), length 10, and a
# Label-Index TLV (RFC 8669 Section 3.1: type 1, length 7, RESERVED 0, Flags 0, Label
# Index 100); next-hop 10.0.0.1 and NLRI 192.0.2.0/24. The wire form is used because
# `update text` has no token for a raw attribute, and it hands the rail the same kind of
# attribute block the RFC 9494 stale readvertise replays onto it. The producer is
# internal/test/fixture/register_prefixsid_announce_rail.go.

# Receiver A (conn=1, AS 65002, propagate-srv6-prefix-sid ABSENT): ORIGIN, the AS_PATH ze
# prepended itself onto, NEXT_HOP, and no attribute 40.
#   ORIGIN:   40010100                 IGP
#   AS_PATH:  4002060201 0000FDE8      AS_SEQUENCE[65000], 4-byte ASNs
#   NEXT_HOP: 400304 0A000001          10.0.0.1
#   NLRI:     18C00002                 192.0.2.0/24
# attr len = 4+9+7 = 20 = 0x14; total = 19+2+2+20+4 = 47 = 0x2F.
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002F02000000144001010040020602010000FDE84003040A00000118C00002

# Receiver B (conn=2, AS 65003, propagate-srv6-prefix-sid TRUE): the same frame with the
# Prefix-SID kept, in ascending type-code order so it sits last.
# attr len = 20+13 = 33 = 0x21; total = 19+2+2+33+4 = 60 = 0x3C.
expect=bgp:conn=2:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF003C02000000214001010040020602010000FDE84003040A000001C0280A0100070000000000006418C00002
EOF_PEER

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external prefixsid-announce {
		run "ze-test fixture plugin/prefixsid-announce-rail-boundary"
		encoder json
	}
}
bgp {
	peer outside-sr-domain-receiver {
		connection {
			remote {
				ip 127.0.0.2
			}
			local {
				ip 127.0.0.2
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65002
			}
			router-id 1.2.3.4
			# propagate-srv6-prefix-sid deliberately NOT set. This peer is an eBGP
			# neighbor the operator has not placed inside the SR domain, and its
			# default of false is what RFC 8669 Section 8 calls for.
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		attach process prefixsid-announce {
			send [ update ]
		}
	}
	peer inside-sr-domain-receiver {
		connection {
			remote {
				ip 127.0.0.3
			}
			local {
				ip 127.0.0.3
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65003
			}
			router-id 1.2.3.4
			# The one leaf that separates this peer from receiver A. It is the
			# explicit configuration RFC 8669 Section 8 requires before the
			# attribute may cross into another AS.
			propagate-srv6-prefix-sid true
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		attach process prefixsid-announce {
			send [ update ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
reject=stderr:pattern=panic
reject=stderr:pattern=fatal error
