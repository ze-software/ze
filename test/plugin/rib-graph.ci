# Test: RIB graph terminal renders AS path topology as box-drawing art
#
# Flow:
# 1. Native test fixture injects routes with known AS paths via rib inject
# 2. Dispatches "rib show received graph" command
# 3. Verifies output contains box-drawing characters and ASN labels
#
# VALIDATES: AC-1 "Output contains box-drawing characters and both ASN labels"
#   AC-2 "Graph shows columns (layers), left-to-right flow"
#   AC-4 "Consecutive duplicates collapsed"
#   AC-7 "No routes match filters -- no crash"
# PREVENTS: Graph terminal not wired into pipeline, empty output.

# ze-peer runs as a sink: only a dial target, asserts nothing (routes injected via API)
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s

# No wire expectations from ze-peer (routes injected via API)
EOF_PEER

# Native test fixture

# ze bgp configuration
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external graph-test {
		run "ze-test fixture plugin/rib-graph"
		encoder json
	}
	internal bgp-rib {
		use bgp-rib
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}

		attach process bgp-rib {
			receive [ update state refresh ]
			send [ update ]
		}
	}
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=ze-peer --mode sink --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
