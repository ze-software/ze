# Test: `show bfd sessions` returns structured JSON via typed ResponseData
# VALIDATES: spec-response-typed-data AC-5 -- BFD handler returns concrete
#            SessionState slice, marshaling boundary produces valid JSON,
#            and pipe framework can process the output.
# PREVENTS:  regression where typed data breaks JSON marshaling or produces
#            double-encoded strings.

option=env:var=ze.bfd.test-parallel:value=true
# BFD listens on the RFC 5881 / RFC 5883 FIXED ports, so every concurrently
# running BFD test's daemon binds the same wildcard (0.0.0.0, 3784/3785) tuple.
# SO_REUSEPORT above lets them co-bind, and the kernel then HASHES each inbound
# datagram to one socket in the group (internal/component/bfd/transport/
# udp_linux.go applySocketOptions) -- so a control reply or a reflected echo meant
# for this daemon can be delivered to a sibling test's daemon instead. That is the
# kernel-global surface option=exclusive exists for: unique addresses cannot
# partition a port number the RFC fixes. Tests outside the group still run
# alongside these.
option=exclusive:group=bfd-ports

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

tmpfs=bfd-show-json.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
"""Verify `show bfd sessions` returns valid structured JSON, not a pre-serialized string."""

import json
import sys
import time

from ze_api import API, runtime_fail, result_text_data


def dispatch(api, command):
    resp = api._call_engine(
        'ze-plugin-engine:dispatch-command', {'command': command})
    if resp is None:
        return {'status': 'error', 'data': 'engine call returned None'}
    return resp.get('result', {})


def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()
    api.wait_for_post_startup(timeout=5.0)

    r = api.dispatch_until_done('show bfd sessions')  # // test-relax: hand-rolled status==done poll -> dispatch_until_done
    if r is None or r.get('status') != 'done':
        status = r.get('status') if r else 'nil'
        runtime_fail(f'show bfd sessions: status={status}')

    raw = result_text_data(r)
    if not raw:
        runtime_fail('show bfd sessions: empty data')

    try:
        parsed = json.loads(raw)
    except json.JSONDecodeError as exc:
        runtime_fail(f'show bfd sessions: invalid JSON: {exc}: {raw[:200]}')
        return

    if not isinstance(parsed, list):
        runtime_fail(f'show bfd sessions: expected list, got {type(parsed).__name__}')

    if len(parsed) < 1:
        runtime_fail(f'show bfd sessions: expected at least 1 session, got {len(parsed)}')

    for s in parsed:
        if not isinstance(s, dict):
            runtime_fail(f'show bfd sessions: element is {type(s).__name__}, not dict')
            continue
        for key in ('peer', 'state', 'mode', 'local-discriminator'):
            if key not in s:
                runtime_fail(f'show bfd sessions: missing field {key} in {s.get("peer", "?")}')

    # Verify no double-encoding (string containing escaped JSON)
    if raw.startswith('"') and raw.endswith('"'):
        runtime_fail(f'show bfd sessions: data is double-encoded string: {raw[:100]}')

    dispatch(api, 'request shutdown')
    api.wait_for_shutdown()


if __name__ == '__main__':
    main()
EOF_RUN

stdin=ze-bfd:terminator=EOF_CONF
plugin {
	external bfd-show-json-test {
		run ./bfd-show-json.run
		encoder json
	}
}

environment {
	log {
		bfd debug
	}
}

bfd {
	enabled true;
	profile fast {
		detect-multiplier 3
		desired-min-tx-us 50000
		required-min-rx-us 50000
	}
	single-hop-session 203.0.113.9 {
		profile fast
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bfd:timeout=15s
expect=exit:code=0
