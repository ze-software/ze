# Test: BMP session disconnect withdraws all routes from RIB
# VALIDATES: AC-6 -- BMP session disconnect withdraws all routes for that router
#
# Flow:
# 1. ze starts with BMP receiver on $PORT2
# 2. Observer sends Initiation + Peer Up + Route Monitoring (inject route)
# 3. Observer closes TCP connection (session disconnect)
# 4. Plugin queries "show bmp rib" and verifies routes are gone

option=env:var=ze.log.bgp.bmp:value=info
option=env:var=ze.log.bgp.rib:value=info
option=timeout:value=20s


stdin=ze-bgp:terminator=EOF_CONF
environment {
    bmp {
        enabled true;
        server default {
            ip 127.0.0.1;
            port $PORT2;
        }
    }
}
plugin {
    external bmp-disconnect {
        run "ze-test fixture plugin/bmp-lg-disconnect $PORT2;"
        encoder json;
    }
}
bgp {
    router-id 1.2.3.5;
    peer test {
        connection {
            remote {
                ip 127.0.0.1
            }
            local {
                ip 127.0.0.1
                accept false
            }
        }
        session {
            asn {
                local 65000;
                remote 65001;
            }
            router-id 1.2.3.5;
            family {
                ipv4/unicast { prefix { maximum 10000; } }
            }
        }
    }
}
EOF_CONF

stdin=peer:terminator=EOF_PEER
EOF_PEER

cmd=background:seq=1:exec=ze-peer --mode sink --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze --plugin ze.bgp-bmp -:stdin=ze-bgp
expect=exit:code=0
expect=stderr:pattern=bmp: session ended
expect=stderr:pattern=PASS: BMP routes withdrawn
