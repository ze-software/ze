# Test: a second SIGTERM during the drain aborts it and the stop goes on
# Exercises: SIGTERM -> runStopDrain (cmd/ze/hub/drain.go) -> the plugin's
#            OnDrain, which sends the second SIGTERM -> stopSignals.onSignal in
#            the drain phase cancels the round (DrainRound.Run,
#            internal/component/plugin/server/drain.go) -> teardown.
# VALIDATES: spec-daemon-drain-before-stop AC-6 row 1: the drain is aborted at
#            once ("drain aborted by signal", no deadline warning although the
#            plugin never answers), the peer still receives Cease 6/2, and the
#            daemon exits 0, not 1 ("forced exit").
# PREVENTS:  an operator's second Ctrl+C being ignored until the drain deadline,
#            or force-exiting with no Cease.

option=env:var=ze.log.plugin.server:value=info

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=20s

expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000

action=sigterm:conn=1:seq=2

expect=bgp:conn=1:seq=3:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002D0306021741646D696E6973747261746976652053687574646F776E
EOF_PEER

tmpfs=ze-bgp.conf:terminator=EOF_CONF
plugin {
	external drain-signaler {
		run "le test fixture plugin/drain-signaler"
		encoder json
	}
}
bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze start ze-bgp.conf:timeout=20s
expect=exit:code=0
expect=stderr:contains=drain-fixture: drain received kind=stop, signaling
expect=stderr:contains=drain-fixture: sent SIGTERM during the drain
expect=stderr:contains=drain aborted by signal
reject=stderr:contains=drain deadline passed
reject=stderr:contains=forced exit
reject=stderr:contains=drain-fixture: FAIL
