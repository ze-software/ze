# Test: rib inject accepts an RFC 5549 extended next-hop (IPv4 NLRI, IPv6 next-hop)
# VALIDATES: request bgp rib inject stores an IPv6 next-hop for an IPv4 NLRI as an
#            MP_REACH_NLRI extended next-hop (RFC 5549/8950); the best-path show
#            recovers and renders it via extractMPNextHopAddr (the forward path).
# PREVENTS: inject silently discarding the IPv6 next-hop (the pre-fix behavior:
#           "IPv6 nhop accepted but not stored in NEXT_HOP attr"), and the show
#           path rendering only Bundle.NextHop, which omitted the next-hop key
#           from every route whose next-hop arrived in MP_REACH_NLRI.
#
# Every assertion below uses runtime_fail, never `print(...)` + `sys.exit(1)`.
# The observer's exit status does not reach the runner: ze itself still exits 0,
# so `expect=exit:code=0` passes and the assertion is invisible. This test spent
# its whole life red on the next-hop check while reporting PASS, and the
# `sys.exit` also skipped wait_eor_sent below, so the teardown raced the EOR the
# peer block asserts and turned a permanent defect into a 1-in-3 "flake".
# See ai/rules/testing.md, "Observer-Exit Antipattern in .ci Tests".

# ze-peer expectations
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
# Assert ze's ipv4/unicast End-of-RIB (RFC 4724 S2: the empty UPDATE). The observer
# gates `request shutdown` on eor-sent >= 1 (wait_eor_sent) AND on this peer having
# read it and closed (wait_peer_consumed), so ze is neither torn down mid
# initial-sync nor closed out from under a marker that only reached its own socket.
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# Python test plugin: inject an IPv4 route with an IPv6 next-hop, then confirm the
# best-path show reports the IPv6 extended next-hop.
tmpfs=rib-inject-rfc5549.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
import json
import sys
from ze_api import API, runtime_fail, result_text_data, result_json_data


def dispatch(api, command):
    resp = api._call_engine(
        'ze-plugin-engine:dispatch-command', {'command': command})
    if resp is None:
        return {'status': 'error', 'data': 'engine call returned None'}
    return resp.get('result', {})


def eor_sent(result):
    """True once ze has written its End-of-RIB to at least one peer.

    `show bgp peer <sel> detail` returns {"peers": {"<ip>": {..., "eor-sent": N}}}
    (peer.go:217, :341-345). peer_stats.go IncrEORSent, called only from
    peer_initial_sync.go's sendInitialRoutes, increments the counter once the EOR
    write has succeeded and been flushed to the peer's socket, so eor-sent >= 1
    proves the marker is on the wire rather than merely scheduled.
    """
    if result.get('status') != 'done':
        return False
    try:
        peers = result_json_data(result, {}).get('peers', {})
    except (json.JSONDecodeError, TypeError, ValueError):
        return False
    return any(p.get('eor-sent', 0) >= 1 for p in peers.values())


def wait_eor_sent(api, selector):
    """Block until ze has sent its EOR, so `request shutdown` cannot pre-empt it.

    The peer block asserts ze's End-of-RIB on the wire. ze emits it only after the
    initial-sync barrier: peer_initial_sync.go's sendInitialRoutes runs the
    apiSync wait (500ms sleep, then the plugin-ready signal) before its EOR-send
    loop builds and sends the EOR. The
    session reaches `established` long before that, so a shutdown gated on the
    inject/show checks alone closes TCP first and the peer's expectation can never
    fire. Gate on the EOR the test actually asserts.
    """
    if not eor_sent(api.dispatch_until(
            f'show bgp peer {selector} detail', eor_sent, attempts=40)):
        runtime_fail(f'ze never sent its End-of-RIB to {selector}')


def peer_state(result):
    """The peer's FSM state from `show bgp peer <sel> detail`, '' if unavailable.

    peer.go:209 renders it as PeerState.String(): stopped, connecting, active,
    established, unknown.
    """
    if result.get('status') != 'done':
        return ''
    try:
        peers = result_json_data(result, {}).get('peers', {})
    except (json.JSONDecodeError, TypeError, ValueError):
        return ''
    for entry in peers.values():
        return str(entry.get('state', ''))
    return ''


def wait_peer_consumed(api, selector):
    """Block until the ze-peer has read the End-of-RIB and closed its session.

    `eor-sent >= 1` proves ze flushed the marker to its OWN socket, and no more
    than that: IncrEORSent runs after Session.SendUpdate -> flushWrites returns
    (session_write.go:437-442, peer_initial_sync.go:303). The `request shutdown`
    in the finally block below can still close the connection before the peer
    reads those bytes, which is a real, rare loss -- observed once in 258
    stressed runs as `failed: connection closed before completion` with the peer
    holding zero messages.

    The ze-peer runs in check mode with no linger, so it closes as soon as its
    expectations are met (internal/test/peer/peer.go completed()). ze leaving
    `established` is therefore proof the peer consumed the marker, and it is a
    condition rather than a delay. tcp_connections=1 means the peer stops
    listening after the first connection, so the state cannot bounce back.
    """
    final = peer_state(api.dispatch_until(
        f'show bgp peer {selector} detail',
        lambda r: peer_state(r) not in ('established', ''),
        attempts=60))
    if final in ('established', ''):
        runtime_fail(
            f'{selector} never consumed the End-of-RIB (state={final!r})')


def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()
    api.wait_for_post_startup(timeout=5.0)

    try:
        # RFC 5549: IPv4 unicast NLRI reachable via an IPv6 next-hop.
        result = dispatch(
            api,
            'request bgp rib inject 10.0.0.99 ipv4/unicast 192.168.1.0/24 origin igp nexthop 2001:db8::1')
        if result.get('status') != 'done':
            runtime_fail(
                f'rib inject status={result.get("status")} data={result.get("data")}')

        # Best-path show recovers the next-hop from the stored MP_REACH_NLRI.
        result = dispatch(api, 'show bgp rib best')
        if result.get('status') != 'done':
            runtime_fail(
                f'rib best show status={result.get("status")}')

        show_data = result_text_data(result)
        if '192.168.1.0/24' not in show_data:
            runtime_fail(
                f'injected prefix not in best show: {show_data[:300]}')
        if '2001:db8::1' not in show_data:
            runtime_fail(
                f'IPv6 extended next-hop not in best show (discarded?): {show_data[:300]}')

        print('OK: RFC 5549 extended next-hop stored and recovered', file=sys.stderr)

        wait_eor_sent(api, 'peer1')
        wait_peer_consumed(api, 'peer1')
    finally:
        dispatch(api, 'request shutdown')
        api.wait_for_shutdown()


if __name__ == '__main__':
    main()
EOF_RUN

# ze bgp configuration
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external rib-inject-rfc5549 {
		run ./rib-inject-rfc5549.run
		encoder json
	}
	internal bgp-rib {
		use bgp-rib
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}

		attach process bgp-rib {
			receive [ update state refresh ]
			send [ update ]
		}
	}
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
# runtime_fail emits this sentinel on the observer's stderr; without the reject the
# observer's assertion failures would be invisible to the runner.
reject=stderr:pattern=ZE-OBSERVER-FAIL
