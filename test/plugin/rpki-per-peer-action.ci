# Test: RPKI per-peer action override (AC-2, AC-10)
# VALIDATES: global action/invalid=reject, but peer1 overrides action/invalid=accept, so an
#            Invalid-origin route from peer1 is ACCEPTED; show bgp rpki status reports the override.
# PREVENTS: per-peer action being ignored (route rejected by global) or status not reflecting it.

# ze-peer: send route 10.0.1.0/24 from AS 65999 (VRP has AS 65001) => Invalid origin
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
option=update:value=send-route:prefix=10.0.1.0/24:origin-as=65999:next-hop=10.0.0.1
# EOR from ze
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# Python test plugin: verifies the Invalid route IS accepted (per-peer override) and status reports it.
tmpfs=rpki-per-peer-test.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
import sys
from ze_api import API, result_text_data, result_json_data

def dispatch(api, command):
    resp = api._call_engine(
        'ze-plugin-engine:dispatch-command', {'command': command})
    if resp is None:
        return {'status': 'error', 'data': 'engine call returned None'}
    return resp.get('result', {})

def vrp_count(api):
    d = result_json_data(dispatch(api, 'show bgp rpki status'), {})
    return d.get('vrp-count-ipv4', 0) if isinstance(d, dict) else 0

def updates_received(api):
    r = dispatch(api, 'show bgp peer peer1 detail')
    return r.get('data', {}).get('peers', {}).get('127.0.0.1', {}).get('updates-received', 0)

def wait_until(api, pred, cycles=150):
    for _ in range(cycles):
        if pred():
            return True
        api.wait_for_event(timeout=0.2)
    return False

def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()

    if not wait_until(api, lambda: vrp_count(api) >= 1):
        print('FAIL: RTR never synced a VRP', file=sys.stderr)
        sys.exit(1)
    if not wait_until(api, lambda: updates_received(api) >= 1):
        print('FAIL: ze never received the UPDATE', file=sys.stderr)
        sys.exit(1)
    api.quiesce()

    try:
        # 1) The Invalid route must be ACCEPTED: global action/invalid=reject, but peer1
        #    overrides action/invalid=accept, so the route is kept in the RIB.
        result = dispatch(api, 'show bgp rib received')
        if result.get('status') != 'done':
            print(f'FAIL: rib received status={result.get("status")}', file=sys.stderr)
            sys.exit(1)
        data = result_text_data(result)
        if '10.0.1.0/24' not in data:
            print(f'FAIL: Invalid route 10.0.1.0/24 should be ACCEPTED via per-peer override: {data}', file=sys.stderr)
            sys.exit(1)

        # 2) show bgp rpki status must report the per-peer resolved action for 127.0.0.1.
        status = result_json_data(dispatch(api, 'show bgp rpki status'), {})
        peer_actions = status.get('peer-actions', [])
        entry = next((p for p in peer_actions if p.get('peer') == '127.0.0.1'), None)
        if entry is None:
            print(f'FAIL: peer-actions missing 127.0.0.1: {peer_actions}', file=sys.stderr)
            sys.exit(1)
        inv = entry.get('invalid', {})
        if inv.get('action') != 'accept' or inv.get('source') != 'peer':
            print(f'FAIL: peer 127.0.0.1 invalid action/source wrong: {inv}', file=sys.stderr)
            sys.exit(1)
        # not-found was not overridden, so it must inherit the global value (source global).
        nf = entry.get('not-found', {})
        if nf.get('source') != 'global':
            print(f'FAIL: peer 127.0.0.1 not-found should inherit global: {nf}', file=sys.stderr)
            sys.exit(1)

        print('OK: Invalid route accepted via per-peer override; status reports peer-actions', file=sys.stderr)
    finally:
        dispatch(api, 'request shutdown')
        api.wait_for_shutdown()

if __name__ == '__main__':
    main()
EOF_RUN

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	hub {
		server local {
			ip 127.0.0.1;
			port 0;
			secret rpki-test-secret-key-01234567890;
		}
	}
	external rpki-per-peer-test {
		run ./rpki-per-peer-test.run
		encoder json
	}
	internal rpki {
		use bgp-rpki
	}
	internal adj-rib-in {
		use bgp-adj-rib-in
	}
}

bgp {
	rpki {
		cache-server 127.0.0.1 {
			port $PORT2
		}
		action {
			invalid reject;
		}
	}
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		rpki {
			action {
				invalid accept;
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}

		process rpki-per-peer-test {
		}
		process rpki {
			receive [ update ]
		}
		process adj-rib-in {
			receive [ update state ]
		}
	}
}
EOF_CONF

# VRP: 10.0.0.0/8 maxlen=24 AS=65001 (route from AS 65999 = Invalid)
cmd=background:seq=1:exec=ze-test rtr-mock --port $PORT2 --vrp 10.0.0.0/8,24,65001
cmd=background:seq=2:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=3:exec=ze -:stdin=ze-bgp:timeout=20s
