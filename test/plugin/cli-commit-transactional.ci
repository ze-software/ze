# Test: config editor commit with a running daemon promotes a candidate
# VALIDATES: AC-1 and AC-15 -- CLI commit with a daemon promotes candidate to active and records rollback.
# PREVENTS: config editor commit saving disk state before daemon reload succeeds.

option=timeout:value=30s
option=env:var=ZE_STORAGE_BLOB:value=false

tmpfs=cli-commit.conf:terminator=EOF_CONF
system {
    authentication {
        user admin {
            password "$2a$04$UlwuiuH82Unfsq.XEMPGJeDkXwbm3KW.nvVaVXOd/JeFK8VjMjrQO"
        }
    }
}

environment {
    ssh {
        enabled true
        server main {
            ip 127.0.0.1;
            port $PORT2;
        }
    }
}

bgp {
    router-id 1.2.3.4
}
EOF_CONF

tmpfs=drive-cli-commit.py:mode=755:terminator=EOF_PY
#!/usr/bin/env python3
import os
import pty
import select
import signal
import fcntl
import subprocess
import struct
import sys
import termios
import time

from ze_api import wait_until

PORT = '$PORT2'

def run(cmd, **kwargs):
    result = subprocess.run(cmd, **kwargs)
    if result.returncode != 0:
        stdout = result.stdout.decode(errors='replace') if result.stdout else ''
        stderr = result.stderr.decode(errors='replace') if result.stderr else ''
        print(f'FAIL: {cmd} exited {result.returncode}\n{stdout}\n{stderr}', file=sys.stderr)
        sys.exit(1)
    return result

def wait_for_daemon(env):
    # // test-relax: replaced a hand-rolled daemon-readiness deadline loop with
    # ze_api.wait_until (same 50x0.2s budget, ratchet-exempt internal sleep); the
    # 0.2s poll delay here was pacing over `show version`, not race-hiding.
    last = ['']
    def ready():
        result = subprocess.run(
            ['ze', 'cli', '-c', 'show version'],
            env=env,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        )
        if result.returncode == 0:
            return True
        last[0] = (result.stdout + result.stderr).decode(errors='replace')
        return False
    if not wait_until(ready, attempts=50, delay=0.2):
        print(f'FAIL: daemon did not become reachable: {last[0]}', file=sys.stderr)
        sys.exit(1)

def read_available(fd, deadline):
    chunks = []
    while time.time() < deadline:
        ready, _, _ = select.select([fd], [], [], 0.1)
        if not ready:
            continue
        try:
            data = os.read(fd, 4096)
        except OSError:
            break
        if not data:
            break
        chunks.append(data)
    return b''.join(chunks).decode(errors='replace')

def drive_editor(env):
    master, slave = pty.openpty()
    fcntl.ioctl(slave, termios.TIOCSWINSZ, struct.pack('HHHH', 30, 120, 0, 0))
    proc = subprocess.Popen(
        ['ze', 'config', 'edit', '-f', 'cli-commit.conf'],
        stdin=slave,
        stdout=slave,
        stderr=slave,
        env=env,
        close_fds=True,
    )
    os.close(slave)
    transcript = read_available(master, time.time() + 1.5)
    for command in ['set bgp router-id 2.2.2.2', 'commit']:
        try:
            os.write(master, (command + '\r').encode())
        except OSError as exc:
            print(f'FAIL: config editor closed before command {command!r}: {exc}\n{transcript}', file=sys.stderr)
            sys.exit(1)
        transcript += read_available(master, time.time() + 2.0)
    try:
        os.write(master, b'quit\r')
    except OSError as exc:
        print(f'FAIL: config editor closed before quit: {exc}\n{transcript}', file=sys.stderr)
        sys.exit(1)
    transcript += read_available(master, time.time() + 2.0)

    deadline = time.time() + 8
    while proc.poll() is None and time.time() < deadline:
        transcript += read_available(master, time.time() + 0.2)
    if proc.poll() is None:
        proc.send_signal(signal.SIGTERM)
        proc.wait(timeout=2)
        print(f'FAIL: config editor did not exit\n{transcript}', file=sys.stderr)
        sys.exit(1)
    if proc.returncode != 0:
        print(f'FAIL: config editor exited {proc.returncode}\n{transcript}', file=sys.stderr)
        sys.exit(1)
    return transcript

def main():
    client_dir = os.path.abspath('client-db')
    os.makedirs(client_dir, exist_ok=True)
    env = os.environ.copy()
    env['ZE_CONFIG_DIR'] = client_dir
    env['ZE_SSH_PASSWORD'] = 'testpass'
    env['NO_COLOR'] = '1'
    env['TERM'] = 'xterm'
    init_input = f'admin\ntestpass\n127.0.0.1\n{PORT}\n\n'.encode()
    run(['ze', 'init'], input=init_input, env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    wait_for_daemon(env)
    transcript = drive_editor(env)
    if 'and reloaded' not in transcript or 'commit failed:' in transcript:
        print(f'FAIL: config editor did not report transactional commit success\n{transcript}', file=sys.stderr)
        sys.exit(1)
    run(['ze', 'cli', '-c', 'show version'], env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    print('OK: CLI commit promoted candidate and daemon applied router-id', file=sys.stderr)

if __name__ == '__main__':
    main()
EOF_PY

cmd=foreground:seq=1:exec=ze start cli-commit.conf:timeout=30s
cmd=foreground:seq=2:exec=./drive-cli-commit.py:timeout=30s
expect=exit:code=0
expect=file:path=meta/config/active:exists=true
expect=file:path=meta/config/candidate:absent=true
expect=file:path=meta/config/rollback:exists=true
expect=file:path=cli-commit.conf:contains=router-id 2.2.2.2
expect=file:glob=rollback/cli-commit-*.conf:contains=router-id 1.2.3.4
expect=file:glob=rollback/cli-commit-*.conf:contains=router-id 2.2.2.2
