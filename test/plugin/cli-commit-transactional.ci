# Test: config editor commit with a running daemon promotes a candidate
# VALIDATES: AC-1 and AC-15 -- CLI commit with a daemon promotes candidate to active and records rollback.
# PREVENTS: config editor commit saving disk state before daemon reload succeeds.

option=timeout:value=30s
option=env:var=ZE_STORAGE_BLOB:value=false

tmpfs=cli-commit.conf:terminator=EOF_CONF
system {
    authentication {
        user admin {
            password "$2a$04$UlwuiuH82Unfsq.XEMPGJeDkXwbm3KW.nvVaVXOd/JeFK8VjMjrQO"
        }
    }
}

environment {
    ssh {
        enabled true
        server main {
            ip 127.0.0.1;
            port $PORT2;
        }
    }
}

bgp {
    router-id 1.2.3.4
}
EOF_CONF

tmpfs=drive-cli-commit.py:mode=755:terminator=EOF_PY
#!/usr/bin/env python3
import codecs
import os
import pty
import select
import signal
import fcntl
import subprocess
import struct
import sys
import termios
import time

from ze_api import wait_until

PORT = '$PORT2'

def run(cmd, **kwargs):
    result = subprocess.run(cmd, **kwargs)
    if result.returncode != 0:
        stdout = result.stdout.decode(errors='replace') if result.stdout else ''
        stderr = result.stderr.decode(errors='replace') if result.stderr else ''
        print(f'FAIL: {cmd} exited {result.returncode}\n{stdout}\n{stderr}', file=sys.stderr)
        sys.exit(1)
    return result

def wait_for_daemon(env):
    # // test-relax: replaced a hand-rolled daemon-readiness deadline loop with
    # ze_api.wait_until (same 50x0.2s budget, ratchet-exempt internal sleep); the
    # 0.2s poll delay here was pacing over `show version`, not race-hiding.
    last = ['']
    def ready():
        result = subprocess.run(
            ['ze', 'cli', '-c', 'show version'],
            env=env,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        )
        if result.returncode == 0:
            return True
        last[0] = (result.stdout + result.stderr).decode(errors='replace')
        return False
    if not wait_until(ready, attempts=50, delay=0.2):
        print(f'FAIL: daemon did not become reachable: {last[0]}', file=sys.stderr)
        sys.exit(1)

# Every wait below blocks on the editor's own output, never on the clock:
# select() returns the moment bytes arrive, and each step ends when the editor
# has SAID it finished. The budgets are failure backstops, not pacing.
STARTUP_BUDGET = 20.0
COMMAND_BUDGET = 20.0
EXIT_BUDGET = 20.0

MATCH = 'match'
EOF = 'eof'
EXPIRED = 'expired'

# The editor's first rendered frame: the alt-screen switch and the config
# panel's top-left corner. bubbletea's Run enters raw mode (initTerminal ->
# initInput -> term.MakeRaw) before it builds the renderer, so either byte
# proves the editor already owns the terminal.
FIRST_FRAME = ('\x1b[?1049h', '╭')

# One decoder for the whole session: a UTF-8 box-drawing character split across
# two reads would otherwise decode to replacement characters on both sides.
DECODER = codecs.getincrementaldecoder('utf-8')(errors='replace')

def pump(fd, transcript, predicate, budget):
    """Append pty output to transcript until predicate(transcript) holds.

    Returns (transcript, MATCH|EOF|EXPIRED). The select() call blocks on the
    editor's output, so this returns as soon as the awaited state is on screen.
    """
    deadline = time.time() + budget
    if predicate(transcript):
        return transcript, MATCH
    while True:
        remaining = deadline - time.time()
        if remaining <= 0:
            return transcript, EXPIRED
        ready, _, _ = select.select([fd], [], [], min(remaining, 0.5))
        if not ready:
            continue
        try:
            data = os.read(fd, 65536)
        except OSError:
            return transcript, EOF
        if not data:
            return transcript, EOF
        transcript += DECODER.decode(data)
        if predicate(transcript):
            return transcript, MATCH

def appears(mark, needles):
    """Predicate: any needle present in output written after offset `mark`."""
    return lambda text: any(needle in text[mark:] for needle in needles)

def fail(reason, transcript):
    print(f'FAIL: {reason}\n{transcript}', file=sys.stderr)
    sys.exit(1)

def send(fd, command, transcript):
    """Type one editor command, failing with the transcript if the pty is gone."""
    try:
        os.write(fd, (command + '\r').encode())
    except OSError as exc:
        fail(f'config editor closed before command {command!r}: {exc}', transcript)

def drive_editor(env):
    master, slave = pty.openpty()
    fcntl.ioctl(slave, termios.TIOCSWINSZ, struct.pack('HHHH', 30, 120, 0, 0))
    proc = subprocess.Popen(
        ['ze', 'config', 'edit', '-f', 'cli-commit.conf'],
        stdin=slave,
        stdout=slave,
        stderr=slave,
        env=env,
        close_fds=True,
    )
    os.close(slave)

    # Nothing may be typed before the editor draws. ze config edit loads
    # credentials, probes the daemon's SSH port and opens storage before
    # bubbletea reaches raw mode, and until then the pty is still canonical:
    # ICRNL rewrites the trailing \r to LF, and LF is ctrl+j rather than Enter,
    # so an early command is echoed by the line discipline and never submitted.
    transcript, status = pump(master, '', appears(0, FIRST_FRAME), STARTUP_BUDGET)
    if status != MATCH:
        fail('config editor did not draw its first frame', transcript)

    # Each command waits for the editor to acknowledge it. `set` renders the new
    # value; `commit` prints a verdict, and it prints the success verdict only
    # after the reload round-trip returned and the editor is no longer dirty --
    # which is what keeps the `quit` below off the pending-changes prompt.
    for command, verdicts in (
        ('set bgp router-id 2.2.2.2', ('2.2.2.2',)),
        ('commit', ('Configuration committed', 'commit failed:', 'commit blocked:')),
    ):
        mark = len(transcript)
        send(master, command, transcript)
        transcript, status = pump(master, transcript, appears(mark, verdicts), COMMAND_BUDGET)
        if status != MATCH:
            fail(f'config editor did not acknowledge {command!r}', transcript)

    # A rejected commit leaves the editor dirty, so `quit` would stop on the
    # pending-changes prompt and the exit wait below would blame the exit for a
    # commit failure. Report the real verdict here instead.
    if 'commit failed:' in transcript or 'commit blocked:' in transcript:
        fail('config editor rejected the commit', transcript)

    send(master, 'quit', transcript)
    # The editor closes the pty slave as it exits, so EOF on the master is the
    # exit signal. Keep draining until then: a full pty buffer would block the
    # editor's own shutdown render.
    transcript, status = pump(master, transcript, lambda text: False, EXIT_BUDGET)
    exited = status == EOF
    if exited:
        try:
            proc.wait(timeout=EXIT_BUDGET)
        except subprocess.TimeoutExpired:
            exited = False
    if not exited:
        proc.send_signal(signal.SIGTERM)
        proc.wait(timeout=2)
        print(f'FAIL: config editor did not exit\n{transcript}', file=sys.stderr)
        sys.exit(1)
    if proc.returncode != 0:
        print(f'FAIL: config editor exited {proc.returncode}\n{transcript}', file=sys.stderr)
        sys.exit(1)
    return transcript

def main():
    client_dir = os.path.abspath('client-db')
    os.makedirs(client_dir, exist_ok=True)
    env = os.environ.copy()
    env['ZE_CONFIG_DIR'] = client_dir
    env['ZE_SSH_PASSWORD'] = 'testpass'
    env['NO_COLOR'] = '1'
    env['TERM'] = 'xterm'
    init_input = f'admin\ntestpass\n127.0.0.1\n{PORT}\n\n'.encode()
    run(['ze', 'init'], input=init_input, env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    wait_for_daemon(env)
    transcript = drive_editor(env)
    if 'and reloaded' not in transcript or 'commit failed:' in transcript:
        print(f'FAIL: config editor did not report transactional commit success\n{transcript}', file=sys.stderr)
        sys.exit(1)
    run(['ze', 'cli', '-c', 'show version'], env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    print('OK: CLI commit promoted candidate and daemon applied router-id', file=sys.stderr)

if __name__ == '__main__':
    main()
EOF_PY

cmd=foreground:seq=1:exec=ze start cli-commit.conf:timeout=30s
cmd=foreground:seq=2:exec=./drive-cli-commit.py:timeout=30s
expect=exit:code=0
expect=file:path=meta/config/active:exists=true
expect=file:path=meta/config/candidate:absent=true
expect=file:path=meta/config/rollback:exists=true
expect=file:path=cli-commit.conf:contains=router-id 2.2.2.2
expect=file:glob=rollback/cli-commit-*.conf:contains=router-id 1.2.3.4
expect=file:glob=rollback/cli-commit-*.conf:contains=router-id 2.2.2.2
