# Test: web config mutation denies read-only user
# VALIDATES: AC-1 through AC-6 and AC-15 -- read-only web user can view but cannot edit config.
# PREVENTS: web config handlers bypassing profile authorization.

option=timeout:value=30s

tmpfs=web-rbac-check.py:mode=755:terminator=EOF_PY
#!/usr/bin/env python3
import base64
import ssl
import sys
import urllib.error
import urllib.parse
import urllib.request
from ze_api import wait_until

BASE_URL = 'https://127.0.0.1:18443'
# The CONFIG-FILE readonly user, not the zefs power user of the same name.
# `readonly` exists in both, and mergeAuthUsers gives the config entry
# precedence, so this password is the one the daemon checks. The config entry is
# also the one carrying `profile [ readweb ]`, which is what this test is about.
AUTH = 'Basic ' + base64.b64encode(b'readonly:testpass').decode()
CTX = ssl._create_unverified_context()

def request(method, path, data=None, content_type=None):
    headers = {'Authorization': AUTH}
    body = None
    if data is not None:
        body = data
        if content_type:
            headers['Content-Type'] = content_type
    req = urllib.request.Request(BASE_URL + path, data=body, headers=headers, method=method)
    return urllib.request.urlopen(req, timeout=5, context=CTX)

def wait_for_show(timeout=10):
    # // replaced a hand-rolled HTTP-readiness deadline loop with
    # ze_api.wait_until (same 20x0.5s budget, ratchet-exempt internal sleep); the
    # 0.5s poll delay was pacing over the show endpoint, not race-hiding.
    def ready():
        try:
            request('GET', '/show/environment/daemon/').read()
            return True
        except (urllib.error.URLError, ConnectionRefusedError, OSError):
            return False
    return wait_until(ready, attempts=20, delay=0.5)

def wait_for_rbac(timeout=10):
    # // replaced a hand-rolled RBAC-active deadline loop with
    # ze_api.wait_until (same 20x0.5s budget, ratchet-exempt internal sleep); the
    # 0.5s poll delay was pacing until the 403 appears, not race-hiding.
    form = urllib.parse.urlencode({'leaf': 'bad/name', 'value': 'probe'}).encode()
    def denied():
        try:
            request('POST', '/config/set/environment/daemon/', form, 'application/x-www-form-urlencoded').read()
        except urllib.error.HTTPError as err:
            return err.code == 403
        except (urllib.error.URLError, ConnectionRefusedError, OSError):
            pass
        return False
    return wait_until(denied, attempts=20, delay=0.5)

def expect_forbidden(path, fields, label):
    form = urllib.parse.urlencode(fields).encode()
    try:
        request('POST', path, form, 'application/x-www-form-urlencoded').read()
        print(f'FAIL: read-only web {label} succeeded', file=sys.stderr)
        sys.exit(1)
    except urllib.error.HTTPError as err:
        if err.code != 403:
            print(f'FAIL: web {label} status={err.code}, want 403', file=sys.stderr)
            sys.exit(1)
    print(f'OK: read-only web {label} denied', file=sys.stderr)

def main():
    if not wait_for_show():
        print('FAIL: web show page did not become available', file=sys.stderr)
        sys.exit(1)
    print('OK: read-only web user can view show page', file=sys.stderr)

    if not wait_for_rbac():
        print('FAIL: web RBAC did not become active', file=sys.stderr)
        sys.exit(1)

    expect_forbidden('/config/set/environment/daemon/', {'leaf': 'zeuser', 'value': 'blocked-user'}, 'config set')
    expect_forbidden('/config/add/bgp/peer/', {'name': 'blocked-peer'}, 'config add')
    expect_forbidden('/config/delete/environment/daemon/', {'leaf': 'zeuser'}, 'config delete')
    expect_forbidden('/config/rename/bgp/peer/peer1/', {'new-key': 'peer2'}, 'config rename')
    expect_forbidden('/config/commit/', {}, 'config commit')
    expect_forbidden('/config/discard/', {}, 'config discard')
    expect_forbidden('/cli/terminal', {'command': 'set zeuser blocked-terminal'}, 'terminal config set')
    expect_forbidden('/cli', {'command': 'set zeuser blocked-cli', 'path': 'environment/daemon'}, 'integrated CLI config set')

    body = request('GET', '/show/environment/daemon/').read().decode(errors='replace')
    if 'blocked-user' in body or 'blocked-terminal' in body or 'blocked-cli' in body:
        print('FAIL: denied config set changed rendered config', file=sys.stderr)
        sys.exit(1)
    print('OK: denied web mutations left config unchanged', file=sys.stderr)

if __name__ == '__main__':
    main()
EOF_PY

tmpfs=test-web-rbac-deny.sh:mode=755:terminator=EOF_SH
#!/bin/sh
set -e

ZE_DIR=$(mktemp -d)
DAEMON_PID=""
cleanup() {
	rm -rf "$ZE_DIR"
	if [ -n "$DAEMON_PID" ]; then
		kill "$DAEMON_PID" 2>/dev/null || true
		wait "$DAEMON_PID" 2>/dev/null || true
	fi
}
trap cleanup EXIT

printf 'readonly\nreadonlypass\n127.0.0.1\n2222\n' | ZE_CONFIG_DIR="$ZE_DIR" ze init >/dev/null
DB="$ZE_DIR/database.zefs"
printf 'readonly' > zefs-username
ze data --path "$DB" write 'meta/ssh/{host}/{port}/username' zefs-username >/dev/null
ze data --path "$DB" cat 'meta/ssh/127.0.0.1/2222/password' > zefs-password
ze data --path "$DB" write 'meta/ssh/{host}/{port}/password' zefs-password >/dev/null

cat > web-rbac-deny.conf << 'ZECONF'
system {
	authentication {
		# bcrypt cost-4 hash of "testpass" -- the same fixture as
		# ssh-user-login-yang.ci and authz-allow.ci. The plaintext MUST be known:
		# web authentication reads the running config per login, so this entry
		# is the credential the daemon checks for `readonly`, overriding the
		# zefs power user of the same name (mergeAuthUsers). The hash that used
		# to sit here matched no known plaintext, and the test passed only
		# because config users were then invisible to the web server unless the
		# config also declared an environment{ssh{}} block.
		user readonly {
			password "$2a$04$UlwuiuH82Unfsq.XEMPGJeDkXwbm3KW.nvVaVXOd/JeFK8VjMjrQO"
			profile [ readweb ]
		}
	}
	authorization {
		profile readweb {
			run {
				default-action allow
			}
			edit {
				default-action deny
			}
		}
	}
}

environment {
	web {
		enabled true;
		server main {
			ip 127.0.0.1;
			port 18443;
		}
	}
}

bgp {
	router-id 1.2.3.4
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
ZECONF

export ze_test_bgp_port=$((12000 + ($$ % 40000)))
ZE_CONFIG_DIR="$ZE_DIR" ze start web-rbac-deny.conf 2>daemon.log &
DAEMON_PID=$!

./web-rbac-check.py
kill $DAEMON_PID 2>/dev/null || true
wait $DAEMON_PID 2>/dev/null || true
exit 0
EOF_SH

cmd=foreground:seq=1:exec=./test-web-rbac-deny.sh:timeout=30s
expect=exit:code=0
