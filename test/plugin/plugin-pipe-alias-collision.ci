# Test: a plugin declares a pipe alias name a command already answers to, the
# plugin fails to start, and the name keeps answering what it answered before.
#
# VALIDATES: spec-plugin-registers-pipe-operations AC-4. A declaration on the
#            EXACT command path where an alias of that name is already
#            registered fails Stage 1, and the alias already serving that name
#            keeps serving it unchanged.
# PREVENTS:  the registry storing one set for each command path and REPLACING
#            what the path held. `show bgp` answers `| summary` and `| peers`,
#            and both were one plugin declaration away from being lost with
#            nothing reporting it.
#
# Method: the plugin declares `show bgp` as a command of its own and declares
# `summary` over it. `show bgp` carries `summary` and `peers` from the in-tree
# BGP peer command plugin, which registers them in init(), so the name is taken
# before any plugin reaches Stage 1. The operator then reads both aliases still
# answering, and reads the daemon log to learn which plugin was refused and why.
#
# The plugin declaring `show bgp` is the point: a command path is what an alias
# sits on, and a plugin naming a path somebody else owns is refused rather than
# served.
#
# The daemon log is the surface this reads because a refused plugin is torn down
# as soon as the tier handshake ends, so it cannot be relied on to report its own
# refusal. The operator's surface is the log line, and it names the plugin.
#
# The timeout is DECLARED because this file starts a daemon, waits for a plugin
# to be refused and torn down, and launches `ze` several times.
option=timeout:value=60s

# The plugin under test: it asks for a name `show bgp` already answers to.
tmpfs=pipe-alias-thief.run:mode=755:terminator=EOF_PLUGIN
#!/usr/bin/env python3
"""Declare a pipe alias on a command path that already carries the name."""

from ze_api import API


def main():
    api = API()
    api.declare_command('show bgp')
    api.declare_pipe(
        command='show bgp',
        name='summary',
        expansion='display vrp-count',
        description='The name show bgp already answers to',
    )
    try:
        api.declare_done()
    except RuntimeError:
        # Stage 1 was refused, which is what this test asks for. The engine tears
        # this process down; the assertions read the daemon log and the aliases.
        return
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()
    api.wait_for_shutdown(timeout=45.0)


if __name__ == '__main__':
    main()
EOF_PLUGIN

tmpfs=run.py:terminator=EOF_PY
"""Start ze with the refused plugin attached, then read what still answers."""

import os
import subprocess

from ze_api import wait_until


def require(condition, message):
    if not condition:
        raise SystemExit(message)


def run(argv, env):
    result = subprocess.run(
        argv, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, env=env, check=False
    )
    return result.returncode, result.stdout, result.stderr


password_hash = subprocess.check_output(['ze', 'passwd'], input='secret\n', text=True).strip()
with open('collision.conf', 'w', encoding='utf-8') as fh:
    fh.write('''bgp {
    router-id 10.255.255.254
    session {
        asn {
            local 65000
        }
    }
    group transit {
        peer peer1 {
            connection {
                remote {
                    ip 192.0.2.1
                }
                local {
                    ip 127.0.0.1
                }
            }
            session {
                asn {
                    remote 65001
                }
            }
        }
    }
}

plugin {
    external pipe-alias-thief {
        run ./pipe-alias-thief.run
        encoder json
    }
}

system {
    authentication {
        user ci {
            password "''' + password_hash + '''"
            profile [ admin ]
        }
    }
}
''')

daemon_env = os.environ.copy()
daemon_env['ZE_SSH_EPHEMERAL'] = os.path.abspath('ssh.addr')
daemon_env['ZE_READY_FILE'] = os.path.abspath('ready')
daemon_env['ZE_CONFIG_DIR'] = os.getcwd()
# Leave port 179 alone: this suite runs unprivileged and a bind failure there
# takes the daemon down before it writes `ready`.
daemon_env['ze_test_bgp_port'] = str(12000 + os.getpid() % 40000)
daemon = subprocess.Popen(
    ['ze', '-f', 'collision.conf'],
    stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, env=daemon_env,
)


def daemon_ready():
    if daemon.poll() is not None:
        out, err = daemon.communicate()
        raise SystemExit('daemon exited early\nstdout:\n' + out + '\nstderr:\n' + err)
    return os.path.exists('ssh.addr') and os.path.exists('ready')


try:
    # The plugin phase runs before the daemon signals readiness, so the refusal
    # has already been decided and logged by the time this returns.
    if not wait_until(daemon_ready, attempts=300, delay=0.1):
        raise SystemExit('daemon did not become ready')

    host, port = open('ssh.addr', encoding='utf-8').read().strip().rsplit(':', 1)
    cli_env = os.environ.copy()
    cli_env.update({
        'ZE_SSH_HOST': host,
        'ZE_SSH_PORT': port,
        'ZE_SSH_USERNAME': 'ci',
        'ZE_SSH_PASSWORD': 'secret',
        'ZE_CONFIG_DIR': os.getcwd(),
    })

    def cli(command):
        code, out, err = run(['ze', 'cli', '-c', command], cli_env)
        require(code == 0, '%s exit=%d: %s%s' % (command, code, out, err))
        return out

    # The whole answer first, so the assertions below measure a CHANGE rather
    # than an answer that was always narrow.
    whole = cli('show bgp | json')
    require('192.0.2.1' in whole, 'the peer rows are missing from the whole answer: %r' % whole)
    require('10.255.255.254' in whole, 'the aggregate fields are missing: %r' % whole)

    # The alias the plugin asked for keeps the meaning it had. The plugin's
    # expansion is `display vrp-count`, a key this answer does not carry, so an
    # accepted declaration would have left an empty selection here.
    only = cli('show bgp | summary | json')
    require('10.255.255.254' in only, '`| summary` lost the aggregate fields: %r' % only)
    require('192.0.2.1' not in only, 'a peer row survived `| summary`: %r' % only)

    # The OTHER alias on the same command path is the one a name check alone
    # does not protect: the registry stores one set for each path.
    rows = cli('show bgp | peers | json')
    require('192.0.2.1' in rows, '`| peers` was dropped from the command path: %r' % rows)
    require('10.255.255.254' not in rows, '`| peers` no longer selects the rows: %r' % rows)
finally:
    daemon.terminate()
    try:
        daemon_out, daemon_err = daemon.communicate(timeout=5)
    except subprocess.TimeoutExpired:
        daemon.kill()
        daemon_out, daemon_err = daemon.communicate(timeout=5)

# The operator reads the refusal in the daemon log. It names the plugin that
# asked, the name it asked for, the command path, and why it cannot have it.
tail = daemon_err[-4000:]
for word in ('pipe alias refused', 'pipe-alias-thief', 'summary', 'show bgp', 'already registered'):
    require(word in daemon_err, 'the daemon log does not name %s: %r' % (word, tail))

print('OK')
EOF_PY

cmd=foreground:seq=1:exec=python3 run.py
expect=exit:code=0
expect=stdout:contains=OK
