# Test: ze show help lists available read-only commands
# VALIDATES: show command dispatch is wired and lists commands from YANG RPCs
# PREVENTS: show command dispatch broken or missing command list

cmd=foreground:seq=1:exec=ze show help
expect=exit:code=0
expect=stderr:contains=ze show
expect=stderr:contains=Read-only
expect=stderr:contains=Commands
expect=stderr:not-contains=Returns audit log entries
