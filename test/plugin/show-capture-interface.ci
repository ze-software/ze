# Test: show capture interface error paths
# Exercises: dispatch-command -> ze-show:capture-interface -> handleCaptureInterface
# Verifies: AC-5 (invalid interface), AC-6 (parse errors via missing args)

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
option=asn:value=65001
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

tmpfs=show-capture-interface-test.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
import sys
from ze_api import API, runtime_fail, result_text_data

def dispatch(api, command):
    resp = api._call_engine(
        'ze-plugin-engine:dispatch-command', {'command': command})
    if resp is None:
        return {'status': 'error', 'data': 'engine call returned None'}
    return resp.get('result', {})

def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()
    api.wait_for_post_startup(timeout=5.0)

    try:
        # AC-5: invalid interface name
        resp = dispatch(api, 'show capture interface nonexistent-iface-xyz-99')
        status = resp.get('status')
        if status != 'error':
            runtime_fail(f'expected error for invalid iface, got status={status}')
        data = result_text_data(resp)
        if 'interface not found' not in data and 'not available' not in data:
            runtime_fail(f'unexpected error message: {data}')
        print(f'OK: invalid interface rejected: {data}', file=sys.stderr)

        # Missing interface: no args at all
        resp = dispatch(api, 'show capture interface')
        status = resp.get('status')
        if status != 'error':
            runtime_fail(f'expected error for missing iface, got status={status}')
        data = result_text_data(resp)
        if 'missing interface' not in data and 'not available' not in data:
            runtime_fail(f'unexpected error for missing args: {data}')
        print(f'OK: missing interface rejected: {data}', file=sys.stderr)

    finally:
        dispatch(api, 'request shutdown')
        api.wait_for_shutdown()

if __name__ == '__main__':
    main()
EOF_RUN

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external show-capture-interface-test {
		run ./show-capture-interface-test.run
		encoder json
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast {
					prefix {
						maximum 10000
					}
				}
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}

		process show-capture-interface-test {
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
