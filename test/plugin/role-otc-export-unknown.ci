# Test: no role config means no OTC filtering (backward compatible)
# VALIDATES: AC-8 -- no import/export keywords = no OTC filtering
# PREVENTS: OTC filtering being applied to peers without role config

# ze-peer: NO role capability (untagged peer)
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
# Hold the session open past this peer's own completion. Without it a check peer
# closes the moment its script finishes (internal/test/peer/peer.go completed()),
# and this peer's script IS finished as soon as it has sent its UPDATE and seen
# ze's EOR -- measured at 1 ms after the UPDATE was dispatched. ze then correctly
# treats that as session-down, and TWO things follow that break this test:
#   1. bgp-adj-rib-in drops the peer's stored routes on down (adj_rib_in/rib.go,
#      "delete(r.ribIn, peerAddr)"), so the observer's total-routes poll below
#      could never see the route -- it burned its full 5s timeout on every run
#      and the fail-open gate then let the test pass vacuously.
#   2. bgp-rs (auto-loaded by the `bgp` config path, not just by an explicit
#      `--plugin`) withdraws the down peer's routes to every other peer
#      (rs/server_handlers.go handleStateDown -> sendBatchedWithdrawals), which
#      races the announce the dest peer below is asserting and is the source of
#      the rare spurious `WITHDRAWN: 10.0.0.0/24` recorded in
#      plan/known-failures/bgp-plugin-role-otc-export-unknown.md.
# Same lever as the 224 forward-overflow-two-tier fix (spec-fixit-peer-verdict-and-forward-rail).
option=linger:value=true
# No role capability added -- this peer is "unknown/untagged"
# Send UPDATE: ORIGIN=IGP, AS_PATH=empty, NEXT_HOP=1.1.1.1, NLRI=10.0.0.0/24
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0029020000000E4001010040020040030401010101180A0000
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# Dest peer: with no role config on the source, the route should be forwarded
# normally and must not gain OTC filtering behavior.
stdin=dest:terminator=EOF_DEST
option=tcp_connections:value=1
option=timeout:value=15s
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002F02000000144001010040020602010000FDE840030401010101180A0000
# // test-relax: the removed End-of-RIB rule was unsatisfiable by construction, so
# it asserted nothing and only produced a red the runner used to mask. This peer's
# EOR is emitted by its OWN initial sync the moment it establishes
# (peer_initial_sync.go), which is BEFORE any route is forwarded to it from
# another peer. That early EOR does not match the route rule(s) above, and
# checker.go silently swallows an unmatched EOR instead of re-offering it, so the
# trailing EOR slot could never be filled. RFC 4724 orders the EOR only against
# this speaker's own initial dump, never against routes learned afterwards, so
# there is no ordering here for a test to assert. The forwarded-route rule(s)
# above are this test's actual subject and are unchanged.
EOF_DEST

# Python test plugin: keeps the daemon alive while the destination wire
# assertion proves backward-compatible forwarding.
tmpfs=test-unknown.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
"""Keep the daemon alive while the dest peer verifies untagged forwarding."""
import json
import sys
from ze_api import API, runtime_fail, result_json_data
# // test-relax: removed unused 'import time'; blind sleep is now dispatch_until + quiesce

def dispatch(api, command):
    resp = api._call_engine('ze-plugin-engine:dispatch-command', {'command': command})
    return resp.get('result', {})

def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()

    # Wait for the source route to land in adj-rib-in, then drain outbound so the
    # destination forwarding wire assertion is deterministic.
    # // test-relax: blind sleep(3.0) -> dispatch_until(adj-rib-in>=1) + quiesce (anchor-then-quiesce)
    api.dispatch_until(
        'show bgp adj-rib-in status',
        lambda r: result_json_data(r, {}).get('total-routes', 0) >= 1,
    )
    api.quiesce()

    # Query adj-rib-in: route should be stored (no role = no OTC filtering).
    result = dispatch(api, 'show bgp adj-rib-in status')
    data = result_json_data(result, {})
    total = data.get('total-routes', -1)

    # Fail CLOSED on zero, not just on a missing key. `total < 0` could only fire
    # when the key was absent, so a present-but-zero total -- which is what the
    # source peer's early close produced on EVERY run before option=linger above
    # -- fell straight through to the OK print, and the adj-rib-in half of this
    # test asserted nothing at all. total >= 1 IS the assertion this observer
    # exists to make (ai/rules/fail-closed-guards.md: a zero value must never be
    # a valid-looking answer).
    if total < 1:
        msg = f'adj-rib-in never stored the route, got total={total}'
        print(f'FAIL: {msg}', file=sys.stderr)
        sys.stderr.flush()
        runtime_fail(msg)

    print('OK: route from untagged peer accepted while dest wire assertion verified forwarding', file=sys.stderr)
    dispatch(api, 'request shutdown')
    api.wait_for_shutdown()

if __name__ == '__main__':
    main()
EOF_RUN

# ze configuration: no role config for either peer (backward compatible)
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	internal adj-rib-in {
		use bgp-adj-rib-in
	}
	internal rs {
		use bgp-rs
	}
	external test-unknown {
		run ./test-unknown.run
		encoder json
	}
}
bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
		attach process adj-rib-in {
			receive [ update-received state ]
			send [ update ]
		}
	}

	peer dest-peer {
		connection {
			remote {
				ip 127.0.0.2
			}
			local {
				ip 127.0.0.2
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65002
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
		attach process adj-rib-in {
			receive [ update-received state ]
			send [ update ]
		}
	}
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=background:seq=2:exec=ze-peer --bind 127.0.0.2 --port $PORT:stdin=dest
cmd=foreground:seq=3:exec=ze --plugin ze.bgp-role -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
reject=stderr:pattern=panic recovered
reject=stderr:pattern=fatal error
reject=stderr:pattern=ZE-OBSERVER-FAIL
