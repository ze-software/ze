# Test: BGP protocol event capture and replay (spec improve-3)
# VALIDATES: AC-2, AC-3, AC-4 and user story 1 -- an operator enables capture on
#            a live peer, the session's inbound messages land in a JSONL file
#            that is closed cleanly on shutdown, and a developer replays that
#            file through the same read path and sees the same outcome.
# PREVENTS: a capture feature that writes nothing an operator can hand over, or
#           a replay that cannot consume what the daemon wrote.
#
# Flow:
# 1. ze-peer accepts the daemon's session and sends one UPDATE.
# 2. ze runs with capture enabled, writing ./capture/bgp-127.0.0.1.jsonl.
# 3. A barrier waits for the UPDATE to reach the capture file.
# 4. cmd=stop terminates the daemon, which closes the capture cleanly.
# 5. ze-test replay reads the file back and reports the FSM states and the
#    prefix the peer announced.
#
# 6. The same file is piped in as "-", which is how a capture arriving from
#    another machine is replayed without a temporary file.
#
# Mutation-verified 2026-08-03: with the tee in Session.teeCapture disabled the
# barrier at seq=3 goes red, so this test gates on the feature rather than on
# the daemon merely running.
# Mutation-verified 2026-08-04: with runReplay opening the path through os.Open
# instead of cliio.OpenReader, seq=7 goes red -- "-" is then a file name that
# does not exist.

option=timeout:value=60s
tmpfs=.capture-workdir:terminator=EOF_WORKDIR
capture
EOF_WORKDIR

# Marker(16) + Len=0x002F(47) + Type=02 + WdLen=0000 + AttrLen=0x0014(20)
#   ORIGIN: 40010100 (IGP)
#   AS_PATH: 40020602010000FE4C (AS_SEQ [65100])
#   NEXT_HOP: 40030401010101
#   NLRI: 180A0000 (10.0.0.0/24)
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=55s
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002F02000000144001010040020602010000FE4C40030401010101180A0000
# Initial-sync End-of-RIB keeps the source session open until the daemon is ready.
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# The compiled barriers wait for the UPDATE and clean capture shutdown. The
# stdin replay driver feeds the capture bytes to replay through "-".

stdin=ze-bgp:terminator=EOF_CONF
bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		# connect-retry 1: the runner starts ze-peer and the daemon back to back,
		# so the daemon's first dial can lose the race to ze-peer's listen. With
		# the 5-second default that costs the test a whole backoff cycle and makes
		# it load-dependent; one second keeps the barrier below its bound on a
		# loaded machine (ai/rules/testing.md, load-dependent failures).
		timer { connect-retry 1; }
		session {
			asn {
				local 65000
				remote 65100
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
		}
		capture {
			enabled true
			directory ./capture
			maximum-size 1
			on-limit rotate
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=background:seq=2:exec=ze -:stdin=ze-bgp:name=daemon
cmd=foreground:seq=3:exec=ze-test fixture plugin/bgp-capture-replay-wait-update:timeout=40s
cmd=stop:seq=4:name=daemon:signal=term
cmd=foreground:seq=5:exec=ze-test fixture plugin/bgp-capture-replay-wait-closed:timeout=40s
cmd=foreground:seq=6:exec=ze-test replay ./capture/bgp-127.0.0.1.jsonl:timeout=20s
cmd=foreground:seq=7:exec=ze-test fixture plugin/bgp-capture-replay-stdin:timeout=20s
expect=exit:code=0
expect=stdout:contains=capture-has-messages
expect=stdout:contains=capture-closed
expect=stdout:contains=OPEN
expect=stdout:contains=UPDATE
expect=stdout:contains=announce=[10.0.0.0/24]
expect=stdout:contains=ESTABLISHED
expect=stdout:contains=stdin-replay-ok
