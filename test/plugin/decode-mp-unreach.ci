# Test: Plugin→engine decode-mp-unreach RPC
# Validates plugin can decode MP_UNREACH_NLRI via engine RPC (Socket A)
# MP_UNREACH_NLRI: IPv4 unicast, withdrawn=192.168.0.0/24
# Plugin decodes, then announces a route BUILT FROM the decoded fields.

# ze-peer expectations
stdin=peer:terminator=EOF_PEER
# The announced NLRI (18 C0A800) is the prefix decode-mp-unreach returned as
# withdrawn. ze has no other source for it, so this message cannot appear unless
# the RPC decoded the MP_UNREACH_NLRI correctly.
cmd=api:conn=1:seq=1:text=peer * update text nhop 10.0.0.1 nlri ipv4/unicast add 192.168.0.0/24
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00300200000015400101004002004003040A0000014005040000006418C0A800
EOF_PEER


# ze bgp configuration
stdin=ze-bgp:terminator=EOF_CONF
plugin {
    external decode-test {
        run "ze-test fixture plugin/decode-mp-unreach"
        encoder json
    }
}
bgp {
    peer peer1 {
    	connection {
    		remote {
    			ip 127.0.0.1
    		}
    		local {
    			ip 127.0.0.1
    			accept false
    		}
    	}
    	session {
    		asn {
    			local 65000
    			remote 65000
    		}
    		router-id 10.0.0.1
    		family {
    		    ipv4/unicast { prefix { maximum 10000; } }
    		}
    	}
    	behavior {
    		group-updates disable
    	}

        attach process decode-test {
            send [ update ]
        }
    }
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
