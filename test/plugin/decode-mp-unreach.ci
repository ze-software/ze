# Test: Plugin→engine decode-mp-unreach RPC
# Validates plugin can decode MP_UNREACH_NLRI via engine RPC (Socket A)
# MP_UNREACH_NLRI: IPv4 unicast, withdrawn=192.168.0.0/24
# Plugin decodes, then announces a route BUILT FROM the decoded fields.

# ze-peer expectations
stdin=peer:terminator=EOF_PEER
# The announced NLRI (18 C0A800) is the prefix decode-mp-unreach returned as
# withdrawn. ze has no other source for it, so this message cannot appear unless
# the RPC decoded the MP_UNREACH_NLRI correctly.
cmd=api:conn=1:seq=1:text=peer * update text nhop 10.0.0.1 nlri ipv4/unicast add 192.168.0.0/24
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00300200000015400101004002004003040A0000014005040000006418C0A800
EOF_PEER

# Python plugin script
tmpfs=decode-mp-unreach.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
"""Test decode-mp-unreach RPC: plugin calls engine to decode MP_UNREACH_NLRI."""

from ze_api import API, runtime_fail


def main() -> None:
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()

    # MP_UNREACH_NLRI for IPv4 unicast:
    # AFI=1(0001), SAFI=1(01), Withdrawn=192.168.0.0/24(18C0A800)
    # RFC 4760 Section 4
    params = {'hex': '00010118C0A800', 'add-path': False}
    resp = api._call_engine('ze-plugin-engine:decode-mp-unreach', params)

    result = resp.get('result')
    if result is None:
        runtime_fail('decode-mp-unreach returned no result')

    if result.get('family') != 'ipv4/unicast':
        runtime_fail(f'expected family ipv4/unicast, got {result.get("family")}')

    nlri = result.get('nlri')
    # Exactly one, so a decoder that over-reads the withdrawn field and returns
    # a trailing extra prefix is caught here. Only nlri[0] reaches the wire, so
    # the expect=bgp line below cannot see that particular defect.
    if not isinstance(nlri, list) or len(nlri) != 1:
        runtime_fail(f'expected exactly one withdrawn prefix, got {nlri!r}')
    if '192.168.0.0/24' not in str(nlri):
        runtime_fail(f'expected 192.168.0.0/24 in nlri, got {nlri}')

    # Success signal: announce the withdrawn prefix the RPC decoded, under the
    # family it decoded. MP_UNREACH carries no next hop, so only that one field
    # is a literal. ze has no other source for 192.168.0.0/24, so the expect=bgp
    # line cannot match unless decode-mp-unreach worked. A bare EOR was the old
    # signal and could not discriminate: ze emits its own initial-sync EOR, so
    # that assertion passed with the plugin dead.
    api.send(
        f'peer * update text nhop 10.0.0.1 '
        f'nlri {result["family"]} add {nlri[0]}'
    )
    # The quiesce barrier returns only once the announce above is on the wire,
    # so asking for shutdown here cannot race the expect=bgp match.
    api.wait_for_ack(expected_count=1)  # // test-relax: dropped redundant sleep; wait_for_ack is the outbound barrier
    api.shutdown_fire_and_forget()
    api.wait_for_shutdown()


if __name__ == '__main__':
    main()
EOF_RUN

# ze bgp configuration
stdin=ze-bgp:terminator=EOF_CONF
plugin {
    external decode-test {
        run ./decode-mp-unreach.run
        encoder json
    }
}
bgp {
    peer peer1 {
    	connection {
    		remote {
    			ip 127.0.0.1
    		}
    		local {
    			ip 127.0.0.1
    			accept false
    		}
    	}
    	session {
    		asn {
    			local 65000
    			remote 65000
    		}
    		router-id 10.0.0.1
    		family {
    		    ipv4/unicast { prefix { maximum 10000; } }
    		}
    	}
    	behavior {
    		group-updates disable
    	}

        process decode-test {
        }
    }
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
