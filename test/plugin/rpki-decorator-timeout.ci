# Test: rpki-decorator graceful degradation when RPKI times out
# VALIDATES: AC-4: UPDATE emitted as update-rpki without rpki section on timeout
# VALIDATES: AC-7: rpki plugin not responding, decorator delivers UPDATE data only
# PREVENTS: Decorator blocking on missing rpki events, consumer never getting data

# ze-peer: send one route, no RTR server → rpki validation unavailable
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=linger:value=true
option=timeout:value=20s
option=update:value=send-route:prefix=10.0.0.0/24:origin-as=65001:next-hop=10.0.0.1
# EOR from ze
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# native test plugin: subscribes to update-rpki, verifies UPDATE data without rpki section
# Native compiled fixture: plugin/rpki-decorator-timeout
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	hub {
		server local {
			ip 127.0.0.1;
			port 0;
			secret rpki-timeout-test-secret-0123456789abcdef;
		}
	}
	external rpki-to-test {
		run "ze-test fixture plugin/rpki-decorator-timeout"
		encoder json
	}
	internal rpki-decorator {
		use bgp-rpki-decorator
	}
	internal adj-rib-in {
		use bgp-adj-rib-in
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}

		attach process rpki-to-test {
			receive [ update-rpki ]
		}
		attach process rpki-decorator {
			receive [ update-received rpki ]
		}
		attach process adj-rib-in {
			receive [ update-received state ]
		}
	}
}
EOF_CONF

# No RTR mock -- rpki plugin not loaded, no rpki events
# Decorator receives UPDATEs only, emits after union timeout
cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=30s
expect=exit:code=0
