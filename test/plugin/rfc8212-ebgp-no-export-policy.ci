# Test: an EBGP session with no export policy at the bgp, group or peer layer
#       is sent no route from any egress path (RFC 8212 Section 3,
#       RFC8212-3-2: "Routes SHALL NOT be added to an Adj-RIB-Out associated
#       with an EBGP peer if no explicit Export Policy has been applied.").
#
# VALIDATES: spec-bgp-rfc8212-ebgp-default-reject AC-2 and AC-9's export
#            warning. Three EBGP sessions:
#   127.0.0.2 65002, NO export policy: receives nothing from any origin. Each
#             origin's prefix is a reject rule on its socket AND a forbidden
#             prefix in the observer, so one announcement fails the run even if
#             a later withdrawal hides it.
#   127.0.0.3 65003, explicit export `final accept` (echo, Ze's role
#             rs-client so its echo passes the first-AS check): the positive
#             control. Every origin MUST reach it, so the absence at .2 is
#             never the absence of the route itself.
#   127.0.0.1 65001, explicit import and export accept: the forwarded source.
# The seven origins, each sent to both .2 and .3:
#   10.82.10.0/24 config `update` block (initial sync, before any snapshot)
#   10.82.1.0/24  forwarded from 127.0.0.1 through bgp-rs
#   10.82.11.0/24 API `update text`
#   10.82.12.0/24 ExaBGP bridge `announce route`
#   10.82.13.0/24 redistribution (fakeredist through the orchestrator)
#   10.82.14.0/24 API raw UPDATE body
#   10.82.15.0/24 API raw full packet
#   10.82.16.0/24 API raw KEEPALIVE+UPDATE concatenation, sent to .2 only
# PREVENTS: an absent EBGP export direction behaving as `final accept` on any
#           egress path, including raw injection that bypasses the parser.
#
# The observer is the compiled fixture plugin/rfc8212-ebgp-no-export-policy
# (internal/test/fixture/rfc8212_policy.go, rfc8212PolicyExport). The bridge
# helper plugin/rfc8212-policy-bridge waits for the observer's
# rfc8212-bridge-ready file before announcing. The run ends on two fences on
# the SAME sockets: a withdrawal .3 must echo, and an EOR to .2 that its script
# answers with a withdrawal only after checking every preceding frame.
option=timeout:value=120s

stdin=source:terminator=EOF_SOURCE
option=tcp_connections:value=1
option=linger:value=true
option=asn:value=65001
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
# AS_PATH 65001, NEXT_HOP 192.0.2.1: 10.82.1.0/24.
expect=bgp:conn=1:seq=2:announced=18C0A801
action=send:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002F02000000144001010040020602010000FDE9400304C0000201180A5201
EOF_SOURCE

stdin=absent:terminator=EOF_ABSENT
option=tcp_connections:value=1
option=linger:value=true
option=asn:value=65002
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
# The observer's fence: an EOR. Answer with a withdrawal of 192.168.250.0/24
# (never announced here), which the observer reads as the fence's receipt.
expect=bgp:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
action=send:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF001B02000418C0A8FA0000
reject=bgp:conn=1:scope=announced:pattern=180A520A
reject=bgp:conn=1:scope=announced:pattern=180A5201
reject=bgp:conn=1:scope=announced:pattern=180A520B
reject=bgp:conn=1:scope=announced:pattern=180A520C
reject=bgp:conn=1:scope=announced:pattern=180A520D
reject=bgp:conn=1:scope=announced:pattern=180A520E
reject=bgp:conn=1:scope=announced:pattern=180A520F
reject=bgp:conn=1:scope=announced:pattern=180A5210
EOF_ABSENT

stdin=accepted:terminator=EOF_ACCEPTED
option=tcp_connections:value=1
option=linger:value=true
option=asn:value=65003
EOF_ACCEPTED

stdin=ze-bgp:terminator=EOF_CONF
exabgp {
    bridge {
        process rfc8212-bridge { run "le test fixture plugin/rfc8212-policy-bridge"; }
        family ipv4/unicast
    }
}
plugin {
    internal adj-rib-in { use bgp-adj-rib-in; }
    internal rs { use bgp-rs; }
    internal rib { use bgp-rib; }
    internal fakeredist { use fakeredist; }
    internal exabgp-bridge { use exabgp-bridge; }
    external rfc8212-policy { run "le test fixture plugin/rfc8212-ebgp-no-export-policy"; encoder json; }
}
policy {
    # Named by the rs-client control below as inactive: never applied.
    reject-asn NO-TRANSIT { indirect [ 3356 ]; }
    # The echo returns Ze's own UPDATEs, whose AS_PATH holds 65000: the
    # RFC 4271 Section 9.1.2 own-AS loop check drops every echo before the
    # observer sees it. The control below names this instance as inactive,
    # which turns loop detection off on that session only.
    loop-detection ECHO-OWN-AS { allow-own-as 0; }
}
redistribute {
    destination bgp {
        import fakeredist { family [ ipv4/unicast ]; }
    }
}
bgp {
    peer source {
        connection { remote { ip 127.0.0.1; } local { ip 127.0.0.5; accept false; } }
        session {
            asn { local 65000; remote 65001; }
            router-id 1.2.3.4;
            family { ipv4/unicast { prefix { maximum 10000; } } }
            capability { graceful-restart disable; }
        }
        behavior { group-updates disable; }
        filter { import { final accept; } export { final accept; } }
        attach process rfc8212-policy { send [ update ]; }
        attach process adj-rib-in { receive [ update-received state ]; }
        attach process rs { receive [ update-received state open-received refresh ]; }
        attach process rib { receive [ update state refresh ]; }
    }
    peer absent-export {
        connection { remote { ip 127.0.0.2; } local { ip 127.0.0.5; accept false; } }
        session {
            asn { local 65000; remote 65002; }
            router-id 1.2.3.4;
            family { ipv4/unicast { prefix { maximum 10000; } } }
            capability { graceful-restart disable; }
        }
        behavior { group-updates disable; }
        filter { import { final accept; } }
        update {
            attribute { origin igp; next-hop 192.0.2.1; }
            nlri { ipv4/unicast add 10.82.10.0/24; }
        }
        attach process rfc8212-policy { receive [ update-received state ]; send [ update raw ]; }
        attach process rs { receive [ state open-received refresh ]; send [ update ]; }
        attach process rib { receive [ update-sent state refresh ]; send [ update ]; }
        attach process exabgp-bridge { receive [ * ]; send [ * ]; }
        attach process redistribute-orchestrator { send [ update ]; }
    }
    peer accepted {
        connection { remote { ip 127.0.0.3; } local { ip 127.0.0.5; accept false; } }
        session {
            asn { local 65000; remote 65003; }
            router-id 1.2.3.4;
            family { ipv4/unicast { prefix { maximum 10000; } } }
            capability { graceful-restart disable; }
        }
        behavior { group-updates disable; }
        # The echo returns Ze's own UPDATEs, whose AS_PATH starts with 65000.
        # Declaring Ze an RS-client of this session (RFC 9234 role) disables the
        # RFC 7606 Section 7.2 first-AS check, so the echo is read as sent
        # instead of being treated as a withdrawal.
        role { import rs-client; }
        # RFC 9234 requires a transit-leak filter on an rs-client session; this
        # control runs without one, recorded with the `inactive:` prefix.
        filter {
            import { filters [ inactive:ECHO-OWN-AS inactive:NO-TRANSIT ]; final accept; }
            export { filters [ inactive:NO-TRANSIT ]; final accept; }
        }
        update {
            attribute { origin igp; next-hop 192.0.2.1; }
            nlri { ipv4/unicast add 10.82.10.0/24; }
        }
        attach process rfc8212-policy { receive [ update-received state ]; send [ update raw ]; }
        attach process rs { receive [ state open-received refresh ]; send [ update ]; }
        attach process rib { receive [ update-sent state refresh ]; send [ update ]; }
        attach process exabgp-bridge { receive [ * ]; send [ * ]; }
        attach process redistribute-orchestrator { send [ update ]; }
    }
}
EOF_CONF

cmd=background:seq=1:exec=le test peer --port $PORT:stdin=source
cmd=background:seq=2:exec=le test peer --bind 127.0.0.2 --port $PORT:stdin=absent
cmd=background:seq=3:exec=le test peer --bind 127.0.0.3 --port $PORT --mode echo:stdin=accepted
cmd=foreground:seq=4:exec=ze -:stdin=ze-bgp:timeout=120s

expect=exit:code=0
reject=stderr:pattern=ZE-OBSERVER-FAIL
reject=stderr:pattern=panic recovered
# AC-9: one warning per absent direction per session, naming the peer, the
# direction, RFC 8212, what is blocked, and the editor command that repairs it
# followed by `commit now` (rfc8212_warning.go, warnRFC8212AbsentPolicy). The
# configured direction and the configured peers MUST NOT warn.
expect=stderr:contains=RFC 8212
expect=stderr:contains=no export policy
expect=stderr:contains=peer=absent-export
expect=stderr:contains=set bgp peer absent-export filter export final accept
expect=stderr:contains=commit now
reject=stderr:contains=set bgp peer absent-export filter import
reject=stderr:pattern=set bgp peer (source|accepted) filter
