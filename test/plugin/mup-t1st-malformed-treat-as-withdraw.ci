# mup-t1st-malformed-treat-as-withdraw -- draft-ietf-bess-mup-safi Section 3.1.3.1
# treat-as-withdraw, end to end through the route server.
#
# A peer announces a well-formed Type 1 ST route K, then sends an UPDATE carrying a
# malformed copy of K (its Length ends inside the Endpoint Address) beside a
# well-formed route L. Section 3.1.3.1: "< 0: the mandatory fields exceed the declared
# Length; the NLRI is malformed; MUST be treated as Treat-as-withdraw." The malformed
# copy shares K's key (RD and prefix), so treating it as withdrawn removes K: the
# receiving peer, which already holds K, sees K withdrawn and L announced. The
# withdrawal names K by the bytes Ze held for it, because a receiver decodes every
# field of a withdrawn NLRI and K' is malformed (GoBGP 3.31.0 panics on it), so the
# malformed octets never reach the receiver at all. No session is reset.

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=2
option=timeout:value=20s
option=bind:value=0.0.0.0
option=linger:value=true
# Bind conn=N by remote IP: which client connects first is a race (peer_connmap.go).
option=conn_map:value=remote-ip

# Source peer (conn=1, AS 65001). Every UPDATE carries ORIGIN IGP, AS_PATH [65001]
# (4-byte ASNs) and an MP_REACH_NLRI for AFI 1 / SAFI 85 with next hop 1.1.1.1.
# draft-ietf-bess-mup-safi Section 3.1 frames each NLRI as
# [architecture-type:1][route-type:2][length:1][value]; a Type 1 ST value
# (Sections 3.1.3, 3.1.3.1) is RD 65001:1, prefix length 32 and prefix,
# TEID 00000001, QFI 09, Endpoint Address Length 32 and Endpoint Address.
#   K:  010003180000FDE900000001200A000001000000010920C000020100
#       prefix 10.0.0.1/32, endpoint 192.0.2.1, Source Address Length 0, Length 0x18
#   K': 010003160000FDE900000001200A000001000000010920C00002
#       K with Length 0x16: the Endpoint Address is cut to three octets
#   L:  010003180000FDE900000001200A000002000000010920C000020100
#       prefix 10.0.0.2/32
# seq=1 announces K.
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF004C02000000354001010040020602010000FDE9800E25000155040101010100010003180000FDE900000001200A000001000000010920C000020100

# seq=2 carries K' then L in one MP_REACH_NLRI.
action=send:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0066020000004F4001010040020602010000FDE9800E3F000155040101010100010003160000FDE900000001200A000001000000010920C00002010003180000FDE900000001200A000002000000010920C000020100

# An ordinary IPv4 route fences the MUP UPDATEs on the same source connection.
action=send:conn=1:seq=3:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002F02000000144001010040020602010000FDE940030401010101180A0000

# Receiver (conn=2, AS 65002, rs-client): K first.
expect=bgp:conn=2:seq=1:contains=010003180000FDE900000001200A000001000000010920C000020100
# Then K withdrawn: an MP_UNREACH_NLRI for AFI 1 / SAFI 85 whose first route is K,
# the generation Ze held for the key K' shares with it. AFI and SAFI directly followed by an NLRI
# occur only in MP_UNREACH_NLRI, because MP_REACH_NLRI carries the next hop between
# them.
expect=bgp:conn=2:seq=2:contains=000155010003180000FDE900000001200A000001000000010920C000020100
# And L announced.
expect=bgp:conn=2:seq=2:contains=010003180000FDE900000001200A000002000000010920C000020100
expect=bgp:conn=2:seq=3:announced=180A0000

# The malformed octets are never announced: no MP_REACH_NLRI carries K', first after
# the next hop or after L.
reject=bgp:conn=2:pattern=040101010100010003160000FDE900000001200A000001000000010920C00002
reject=bgp:conn=2:pattern=010003180000FDE900000001200A000002000000010920C000020100010003160000FDE900000001200A000001000000010920C00002
# Nor withdrawn: no MP_UNREACH_NLRI, nor any other byte of what Ze sends, carries K'.
reject=bgp:conn=2:pattern=010003160000FDE900000001200A000001000000010920C00002

EOF_PEER

# Observer: wait until the route server has replayed the fence prefix to every client, then
# shut down.

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	internal rs {
		use bgp-rs
	}
	internal adj-rib-in {
		use bgp-adj-rib-in
	}
	external shutdown-after-up {
		run "le test fixture plugin/mup-t1st-malformed-treat-as-withdraw"
		encoder json
	}
}
bgp {
	peer source-peer {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
				ipv4/mup { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		attach process adj-rib-in {
			receive [ update-received state ]
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
		attach process shutdown-after-up {
			receive [ update ]
		}
	}
	peer receiver-peer {
		connection {
			remote {
				ip 127.0.0.2
			}
			local {
				ip 127.0.0.2
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65002
			}
			router-id 1.2.3.4
			rs-client true
			family {
				ipv4/unicast { prefix { maximum 10000; } }
				ipv4/mup { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		attach process adj-rib-in {
			send [ update ]
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
		attach process shutdown-after-up {
			receive [ update ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
reject=stderr:pattern=panic
reject=stderr:pattern=fatal error
