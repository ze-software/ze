# Test: compiled-in bgp-rr keeps its declared commands in-daemon and forked (process separate) and is uniformly gated by send > allow.
# QUESTION: when compiled-in `bgp-rr` runs both in-daemon and forked via
# `process separate`, does `request bgp adj-rib-in claim-replay` succeed with
# zero refusals and reflect `i1`'s route to `i2` exactly once when nothing is
# written, and when `send { allow [ ... ]; }` excludes
# `cli:request bgp adj-rib-in claim-replay`, do both transports refuse it with
# the allow-list message naming `/bus/endpoint/bgp-rr` and log
# `could not claim adj-rib-in replay ownership`? A unit test cannot decide this
# because it spans DirectBridge vs TLS connect-back process fork, real BGP
# reflection between two iBGP peers, `bgp-adj-rib-in` replay claiming, doctor,
# and Prometheus metrics.
#
# VALIDATES: spec-explicit-plugin-and-attach-config S28 / AC-29.
# PREVENTS: incomplete compiled-in send declarations breaking `bgp-rr`, or
# in-daemon and forked (`process separate`) transports diverging on bus gating.

option=timeout:value=150s
option=env:var=ZE_CONFIG_DIR:value=.
option=env:var=XDG_DATA_HOME:value=.
option=env:var=ze.ssh.password:value=testpass

stdin=init-answers:terminator=EOF_INIT
admin
testpass
127.0.0.1
$PORT2
EOF_INIT

# Peer scripts for Run 1 (in-daemon default).
stdin=i1-int:terminator=EOF_I1_INT
option=tcp_connections:value=1
option=timeout:value=40s
option=asn:value=65000
option=open:value=router-id:id=127.0.0.1
option=linger:value=true
option=await-file:path=i2-int.established
option=update:value=send-route:prefix=198.51.100.0/24:next-hop=192.0.2.1
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_I1_INT

stdin=i2-int:terminator=EOF_I2_INT
option=tcp_connections:value=1
option=timeout:value=40s
option=asn:value=65000
option=open:value=router-id:id=127.0.0.2
option=linger:value=true
option=established-file:path=i2-int.established
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
expect=bgp:conn=1:seq=1:announced=18C63364
EOF_I2_INT

# Peer scripts for Run 2 (forked process separate default).
stdin=i1-fork:terminator=EOF_I1_FORK
option=tcp_connections:value=1
option=timeout:value=40s
option=asn:value=65000
option=open:value=router-id:id=127.0.0.1
option=linger:value=true
option=await-file:path=i2-fork.established
option=update:value=send-route:prefix=198.51.100.0/24:next-hop=192.0.2.1
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_I1_FORK

stdin=i2-fork:terminator=EOF_I2_FORK
option=tcp_connections:value=1
option=timeout:value=40s
option=asn:value=65000
option=open:value=router-id:id=127.0.0.2
option=linger:value=true
option=established-file:path=i2-fork.established
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
expect=bgp:conn=1:seq=1:announced=18C63364
EOF_I2_FORK

# Config 1: bgp-rr in-daemon, nothing written on send.
tmpfs=rr-int-default.conf:terminator=EOF_RR_INT_DEF
system {
	authentication {
		# bcrypt cost-4 hash of "testpass".
		user admin {
			password "$2a$04$UlwuiuH82Unfsq.XEMPGJeDkXwbm3KW.nvVaVXOd/JeFK8VjMjrQO"
		}
	}
}
environment {
	ssh {
		enabled true
		server main { ip 127.0.0.1; port $PORT2; }
	}
}
telemetry {
	prometheus {
		enabled true
		server main { ip 127.0.0.1; port $PORT3; }
	}
}
bus {
	endpoint bgp-adj-rib-in { internal bgp-adj-rib-in; }
	endpoint bgp-rib { internal bgp-rib; }
	endpoint bgp-rr { internal bgp-rr; }
}
bgp {
	router-id 1.2.3.4;
	filter {
		import { final accept; }
		export { final accept; }
	}
	peer i1 {
		connection {
			remote { ip 127.0.0.1; }
			local { ip 127.0.0.1; accept false; }
		}
		session {
			asn { local 65000; remote 65000; }
			route-reflector-client true;
			cluster-id 10.0.0.1;
			family { ipv4/unicast { prefix { maximum 10000; } } }
			capability { graceful-restart disable; }
		}
		behavior { group-updates disable; }
	}
	peer i2 {
		connection {
			remote { ip 127.0.0.2; }
			local { ip 127.0.0.2; accept false; }
		}
		session {
			asn { local 65000; remote 65000; }
			family { ipv4/unicast { prefix { maximum 10000; } } }
			capability { graceful-restart disable; }
		}
		behavior { group-updates disable; }
	}
}
EOF_RR_INT_DEF

