# med-removal-configured -- the operator asks for MULTI_EXIT_DISC to be removed from a route,
# and it is gone before the route is used or advertised.
#
# RFC requirement: RFC4271-5.1.4-4 positive -- "A BGP speaker MUST implement a mechanism (based
# on local configuration) that allows the MULTI_EXIT_DISC attribute to be removed from a route"
# (Section 5.1.4). The mechanism is `del { med; }` on a modify policy attached
# to a peer's import chain. The receiver gets the source frame without attribute 4.
# RFC requirement: RFC4271-5.1.4-2 positive -- "If a BGP speaker is configured to remove the
# MULTI_EXIT_DISC attribute from a route, then this removal MUST be done prior to determining the
# degree of preference of the route and prior to performing route selection (Decision Process
# phases 1 and 2)." The import chain's rewritten payload REPLACES the WireUpdate before the
# UPDATE is cached and dispatched (reactor_notify.go), so every consumer of that route -- the RIB
# plugin that runs phases 1 and 2 among them -- reads a route with no metric. The bytes below are
# that replacement, relayed on.
#
# THE RECEIVER IS A ROUTE SERVER CLIENT, AND THAT IS WHAT MAKES THE ASSERTION DISCRIMINATING.
# RFC 7947 Section 2.2.3 exempts an rs-client from Section 5.1.4, so ze's automatic strip
# (applyFactsMED, reactor/forward_med.go) deliberately does NOT fire for this destination:
# med-not-propagated-across-as.ci asserts the very same receiver getting the metric
# BYTE-IDENTICAL. The only thing that can take attribute 4 off this wire is the configured
# removal, so an absence here cannot be the automatic rule wearing a different hat.
#
# The source peer is EXTERNAL (65000 -> 65001) because Section 5.1.4's metric arrives over eBGP.
# No LOCAL_PREF in the source frame: Section 5.1.5 keeps it off an external session, and ze would
# overwrite it with an ATTR_DISCARD marker (message/rfc7606.go).

option=env:var=ze.log.bgp.filter.modify:value=info

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=2
option=timeout:value=20s
option=bind:value=0.0.0.0
# Bind conn=N by remote IP rather than accept order: which client connects first is a race
# (peer_connmap.go).
option=conn_map:value=remote-ip

# Source peer (conn=1, AS 65001): announce 10.0.0.0/24 carrying a metric.
#   ORIGIN:    40010100            IGP
#   AS_PATH:   40020602010000FDE9  AS_SEQUENCE[65001], 4-byte ASNs
#   NEXT_HOP:  40030401010101      1.1.1.1
#   MED:       80040400000064      100 -- the attribute the operator asked to remove
#   NLRI:      180A0000            10.0.0.0/24
# attr len = 4+9+7+7 = 27 = 0x1B; total = 19+2+2+27+4 = 54 = 0x36.
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0036020000001B4001010040020602010000FDE94003040101010180040400000064180A0000

# The source's own EOR. Only conn=1's is asserted on the wire: RFC 4724 Section 4.1 constrains no
# ordering between a peer's EOR and routes it learns afterwards.
expect=bgp:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000

# Receiver (conn=2, AS 65002, rs-client TRUE): the source frame with attribute 4 gone and every
# other byte where it was. AS_PATH is not prepended because RFC 7947 Section 2.2.2.1 keeps a
# route server transparent.
# attr len = 4+9+7 = 20 = 0x14; total = 19+2+2+20+4 = 47 = 0x2F.
expect=bgp:conn=2:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002F02000000144001010040020602010000FDE940030401010101180A0000
EOF_PEER

# Observer: wait until every client has been replayed to, then shut down.

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	internal rs {
		use bgp-rs
	}
	internal adj-rib-in {
		use bgp-adj-rib-in
	}
	external shutdown-after-up {
		run "ze-test fixture plugin/med-removal-configured"
		encoder json
	}
}
bgp {
	policy {
		# RFC 4271 Section 5.1.4's configured del { med; } removal. Nothing else
		# is declared, so the removal is a complete definition.
		modify DROP-MED {
			del {
				med
			}
		}
	}

	peer source-peer {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		# IMPORT, not export. Section 5.1.4 requires the removal to happen before the
		# decision process, and the import chain is the only chain that runs there.
		filter {
			import [ modify:DROP-MED ]
		}
		attach process adj-rib-in {
			receive [ update-received state ]
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
		attach process shutdown-after-up {
			receive [ update ]
		}
	}
	peer rs-client-receiver {
		connection {
			remote {
				ip 127.0.0.2
			}
			local {
				ip 127.0.0.2
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65002
			}
			router-id 1.2.3.4
			# RFC 7947 Section 2.2.3 exempts this peer from the automatic Section 5.1.4
			# strip, so the metric would reach it if the configured removal had not
			# already taken the attribute off the route.
			rs-client true
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		attach process adj-rib-in {
			send [ update ]
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
		attach process shutdown-after-up {
			receive [ update ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze --plugin ze.bgp-filter-modify -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
expect=stderr:pattern=filter=DROP-MED
expect=stderr:pattern=delta=med-remove
reject=stderr:pattern=panic
reject=stderr:pattern=fatal error
reject=stderr:pattern=forward-cached failed
reject=stderr:pattern=release-cached failed
