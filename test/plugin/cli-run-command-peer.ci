# Test: dispatch peer list through engine returns peer data
# VALIDATES: peer list dispatch returns 127.0.0.1 in peers dict
# PREVENTS: peer list dispatch broken when called from CLI path

# ze-peer expectations
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# native fixture test plugin: exercises dispatch-command for peer list (CLI path)

# ze bgp configuration
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external cli-peer-test {
		run "ze-test fixture plugin/cli-run-command-peer"
		encoder json
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
