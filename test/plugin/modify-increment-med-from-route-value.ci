# modify-increment-med-from-route-value -- the operator asks for 50 more metric, and the
# receiver reads the route's own metric plus 50.
#
# VALIDATES: AC-4 -- an import chain running bgp-filter-modify with
#            increment { med 50 } over a route carrying MULTI_EXIT_DISC 100 produces the
#            delta "med 150", and the wire modification sets the attribute to 150.
# PREVENTS:  the increment computing from an absent attribute. appendSingleAttr named
#            *attribute.MED, knownAttrParsers boxes attribute.MED, so no arm matched and
#            the subject named no metric. currentForArithmetic then took the absent base
#            of 0 (RFC 4271 Section 9.1.2.2) and the same configuration wrote "med 50" on
#            every route, whatever the route carried.
#
# Flow:
# 1. The source peer announces 10.0.0.0/24 carrying MULTI_EXIT_DISC 100.
# 2. The import chain calls bgp-filter-modify:INC-MED, which reads "med 100" out of the
#    subject and answers the delta "med 150".
# 3. textDeltaToModOps turns the delta into a wire modification, and the receiver reads
#    the source frame with attribute 4 carrying 150.
#
# THE RECEIVER IS A ROUTE SERVER CLIENT, AND THAT IS WHAT LETS THE METRIC BE READ AT ALL.
# RFC 4271 Section 5.1.4 keeps a received metric off a route re-announced to another AS,
# and ze performs that strip automatically (applyFactsMED, reactor/forward_med.go). RFC
# 7947 Section 2.2.3 exempts an rs-client, so this receiver is the one destination the
# metric legitimately reaches, and med-not-propagated-across-as.ci asserts the same
# receiver getting an unmodified metric byte for byte.
#
# The source peer is EXTERNAL (65000 -> 65001) because Section 5.1.4's metric arrives over
# eBGP. No LOCAL_PREF in the source frame: Section 5.1.5 keeps it off an external session.

option=env:var=ze.log.bgp.filter.modify:value=info

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=2
option=timeout:value=20s
option=bind:value=0.0.0.0
# Bind conn=N by remote IP rather than accept order: which client connects first is a race
# (peer_connmap.go).
option=conn_map:value=remote-ip

# Source peer (conn=1, AS 65001): announce 10.0.0.0/24 carrying a metric of 100.
#   ORIGIN:    40010100            IGP
#   AS_PATH:   40020602010000FDE9  AS_SEQUENCE[65001], 4-byte ASNs
#   NEXT_HOP:  40030401010101      1.1.1.1
#   MED:       80040400000064      100 -- the number the increment computes from
#   NLRI:      180A0000            10.0.0.0/24
# attr len = 4+9+7+7 = 27 = 0x1B; total = 19+2+2+27+4 = 54 = 0x36.
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0036020000001B4001010040020602010000FDE94003040101010180040400000064180A0000

# The source's own EOR. Only conn=1's is asserted on the wire: RFC 4724 Section 4.1
# constrains no ordering between a peer's EOR and routes it learns afterwards.
expect=bgp:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000

# Receiver (conn=2, AS 65002, rs-client TRUE): the source frame with attribute 4 carrying
# 150 and every other byte where it was. AS_PATH is not prepended because RFC 7947 Section
# 2.2.2.1 keeps a route server transparent.
#   MED: 80040400000096  150
expect=bgp:conn=2:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0036020000001B4001010040020602010000FDE94003040101010180040400000096180A0000
EOF_PEER

# Observer: wait until every client has been replayed to, then shut down.

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	internal rs {
		use bgp-rs
	}
	internal adj-rib-in {
		use bgp-adj-rib-in
	}
	external shutdown-after-up {
		run "ze-test fixture plugin/modify-increment-med-from-route-value"
		encoder json
	}
}
bgp {
	policy {
		# The operator's whole configuration: 50 more metric on what arrives.
		modify INC-MED {
			increment {
				med 50
			}
		}
	}

	peer source-peer {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		# IMPORT: the operator wants the metric raised on what the route becomes, so the
		# change is made once on arrival rather than on each re-announcement.
		filter {
			import [ modify:INC-MED ]
		}
		attach process adj-rib-in {
			receive [ update-received state ]
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
		attach process shutdown-after-up {
			receive [ update ]
		}
	}
	peer rs-client-receiver {
		connection {
			remote {
				ip 127.0.0.2
			}
			local {
				ip 127.0.0.2
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65002
			}
			router-id 1.2.3.4
			# RFC 7947 Section 2.2.3 exempts this peer from the automatic Section 5.1.4
			# strip, so the metric this test measures reaches the wire.
			rs-client true
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		attach process adj-rib-in {
			send [ update ]
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
		attach process shutdown-after-up {
			receive [ update ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze --plugin ze.bgp-filter-modify -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
expect=stderr:pattern=filter=INC-MED
expect=stderr:pattern=delta="med 150"
reject=stderr:pattern=delta="med 50"
reject=stderr:pattern=panic
reject=stderr:pattern=fatal error
