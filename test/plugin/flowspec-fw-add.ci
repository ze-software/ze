# FlowSpec outbound wire encoding through the configured BGP CLI path.
# VALIDATES: UPDATE and EOR bytes, including the required empty next hop.
# This carrier does not prove received-route authorization or firewall delivery.
# Those paths have retained-RIB regressions, the privileged selected-rule kernel
# carrier, and the bgp-flowspec-sctp-gobgp interop scenario.

# ze-peer expectations: receive a FlowSpec route from ze
stdin=peer:terminator=EOF_PEER
cmd=api:conn=1:seq=1:text=send bgp * update text extended-community [copy-to-nexthop] nhop 1.2.3.4 mp ipv4/flow destination-ipv4 10.1.0.0/24 protocol tcp destination-port 80
# The action is copy-to-nexthop, the 0x0800 redirect/copy-to-IP-next-hop
# community, whose target IS the MP_REACH_NLRI next hop
# (draft-simpson-idr-flowspec-redirect-02 Section 3). The expectation carries
# `85 04 01020304 00`, where every other FlowSpec action carries the RFC 8955
# Section 4 zero length (message.MPReachCarriesNextHop, since 4358372547). That
# exception is an owner-approved deviation from the RFC 8955 Section 4 MUST
# (2026-10-20, handover 03 owner decisions), not conformance.
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00480200000031800E150001850401020304000B01180A01000381060581504001010040020040050400000064C010080800000000000001
# EOR
cmd=api:conn=1:seq=2:text=send bgp * update text mp ipv4/flow eor
expect=bgp:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF001E0200000007900F0003000185
EOF_PEER

# ze bgp configuration
stdin=ze-bgp:terminator=EOF_CONF
bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/flow { prefix { maximum 10000; } }
			}
		}
		behavior {
			group-updates disable
		}
		update {
			attribute {
				next-hop 1.2.3.4
				extended-community [copy-to-nexthop]
			}
			nlri {
				ipv4/flow add destination-ipv4 10.1.0.0/24 protocol tcp destination-port 80
			}
		}
	}
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=10s
