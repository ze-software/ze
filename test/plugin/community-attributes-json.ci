# Test: every community attribute a peer sends reaches a plugin decoded
# VALIDATES: COMMUNITIES, EXTENDED_COMMUNITIES, IPV6_EXTENDED_COMMUNITIES and
#            LARGE_COMMUNITIES each render under their own ze-bgp JSON key on
#            the plugin update-received event, and an EXTENDED_COMMUNITIES
#            entry carries the named form (`target:65000:1`, `target:65536:100`,
#            `mark:46`, `traffic-action:sample-terminal`) that the FlowSpec
#            firewall bridge matches, not raw hex.
# PREVENTS: the four JSON formatters in filter_community asserting a POINTER
#           while every parser in internal/core/bgp/attribute/community.go
#           returns a VALUE. The assertion never matched, appendAttributeJSON
#           read the nil return as "no formatter", and every community
#           attribute an operator saw was "attr-8" / "attr-16" / "attr-25" /
#           "attr-32" with a hex payload.
# RFC requirement: RFC8955-7.5-1 positive -- a traffic-marking community reaches a plugin as its DSCP (§7.5)
# RFC requirement: RFC8955-7.5-1 negative -- the reserved bits above the 6-bit DSCP field are ignored on decode (§7.5)
# RFC requirement: RFC8955-7.3-1 positive -- a traffic-action community reaches a plugin as the Terminal and Sample bits it carries (§7.3)
# RFC requirement: RFC8955-7.3-1 negative -- the unused Traffic Action Field bits are ignored on decode, so two communities differing only in them decode alike (§7.3)

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=20s
# Hold the session open until the observer has read the event and shut ze down.
option=linger:value=true
# UPDATE carrying one of each community attribute.
# Header: marker(16) + len=0081(129) + type=02
# Body:   withdrawn len=0000, attr len=0066(102)
#   40 01 01 00                            ORIGIN igp
#   40 02 00                               AS_PATH empty (iBGP)
#   40 03 04 C0A80102                      NEXT_HOP 192.168.1.2
#   C0 08 04 FDE90064                      COMMUNITIES 65001:100 (RFC 1997)
#   C0 10 28                               EXTENDED_COMMUNITIES, five entries (RFC 4360)
#            0002FDE800000001              route target 65000:1, two-octet AS form
#            80090000000000EE              traffic-marking DSCP 46, and BOTH bits above
#                                          the 6-bit DSCP field set: 0xEE is 0b11_101110,
#                                          and RFC 8955 Section 7.5 says those two are
#                                          reserved and ignored during decoding
#            0202000100000064              route target 65536:100, four-octet AS form:
#                                          RFC 5668 Section 2 puts a 4-octet administrator
#                                          and a 2-octet assigned number where the form
#                                          above puts 2 and 4
#            8007000000000003              traffic-action, Sample and Terminal set, every
#                                          unused bit of the Traffic Action Field clear
#            8007FFFFFFFFFFFF              the same two bits with every unused bit SET:
#                                          RFC 8955 Section 7.3 says those are ignored on
#                                          decode, so this must render as the line above
#   C0 19 14 0002 20010DB8.. 0001          IPV6_EXTENDED_COMMUNITIES 2001:db8::,1 (RFC 5701)
#   C0 20 0C 0000FDE9 00000001 00000002    LARGE_COMMUNITIES 65001:1:2 (RFC 8092)
#   18 0A0000                              NLRI 10.0.0.0/24
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0081020000006640010100400200400304C0A80102C00804FDE90064C010280002FDE80000000180090000000000EE020200010000006480070000000000038007FFFFFFFFFFFFC01914000220010DB80000000000000000000000000001C0200C0000FDE90000000100000002180A0000
EOF_PEER


stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external community-json {
		run "ze-test fixture plugin/community-attributes-json"
		encoder json
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}

		attach process community-json {
			receive [ update-received ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
