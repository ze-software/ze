# Migrated from test/data/plugin/ipv6.*

# ze-peer expectations
stdin=peer:terminator=EOF_PEER
# Test: IPv6 unicast announce/withdraw with JSON format documentation
# JSON format: {"ipv6/unicast":[{"next-hop":"...","action":"add|del","nlri":["..."]}]}
cmd=api:conn=1:seq=1:text=send bgp * update text origin igp local-preference 200 nhop 2001::11 nlri ipv6/unicast add fc00:1::/64
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0046020000002F40010100400200400504000000C8800E1E00020110200100000000000000000000000000110040FC00000100000000
expect=json:conn=1:seq=1:json={"meta":{"version":"1.0.0","format":"ze-bgp"},"message":{"type":"update"},"peer":{"address":"127.0.0.1","remote":{"as":65533}},"direction":"in","local-preference":200,"origin":"igp","ipv6/unicast":[{"action":"add","nlri":["fc00:1::/64"],"next-hop":"2001::11"}]}
# ZE's own initial-sync End-of-RIB is NOT asserted here, and that is the
# assertion this file lost on 2026-09-18 rather than one it forgot.
#
# The marker used to sit AFTER the announce because a plugin-injected route
# belonged to this speaker's initial routing update (owner ruling, 2026-08-30)
# and the initial-sync barrier held the marker for every route-pushing binding.
# Since 2026-09-18 a process which creates routes stands where a peer stands: ze
# holds its marker for nobody, so the marker follows ze's own table and RACES
# this plugin's announce. A route pushed before the queue gate closes drains
# ahead of it; one pushed after goes straight to the wire behind it. A peer's
# routes have no defined order against our marker either, which is the point of
# the ruling.
#
# The checker only NOTES a marker that lands early (checker.go, noteMisordered);
# it does not satisfy the later expectation with it. So neither order can be
# written here truthfully, and what this file asserts is what it is named for:
# the announce and the withdraw, encoded right, for ipv6/unicast.
cmd=api:conn=1:seq=2:text=send bgp * update text nlri ipv6/unicast del fc00:1::/64
expect=bgp:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0026020000000F800F0C00020140FC00000100000000
expect=json:conn=1:seq=2:json={"meta":{"version":"1.0.0","format":"ze-bgp"},"message":{"type":"update"},"peer":{"address":"127.0.0.1","remote":{"as":65533}},"direction":"in","ipv6/unicast":[{"action":"del","nlri":["fc00:1::/64"]}]}
EOF_PEER


# ze bgp configuration
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external announce-routes {
		run "le-test fixture plugin/ipv6-announce-withdraw"
		encoder json
	}
}
bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65000
			}
			router-id 10.0.0.1
			family {
				ipv6/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart
			}
		}
		behavior {
			group-updates disable
		}
	
		attach process announce-routes {
			send [ update ]
		}
	}
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=10s
