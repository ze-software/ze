# flowspec-redirect-check-refused -- an EBGP FlowSpec redirect-to-IP rule whose
# redirect address resolves to a route originated in another AS is forwarded
# without its 0x0800 community and with a zero next-hop length.
#
# draft-simpson-idr-flowspec-redirect-02 Section 3: "If the flow-spec route has
# an IP next-hop X and includes a redirect-to-IP extended community, then the
# BGP speaker SHOULD discard the redirect-to-ip extended community (and not
# propagate it further with the flow-spec route) if the last AS in the AS_PATH
# or AS4_PATH attribute of the longest prefix match for X does not match the AS
# of the EBGP peer."
#
# VALIDATES: the daemon path. The source (EBGP, AS 65002) sends 192.0.2.0/24
#            with AS_PATH 65002 65009, then a FlowSpec rule for destination
#            192.0.2.0/24 carrying redirect-to-IP (0800000000000000) with next
#            hop X = 192.0.2.77. The RIB's longest match for X is 192.0.2.0/24,
#            whose last AS 65009 is not 65002, so the check refuses the action
#            (flowSpecRedirectRefused, plugins/rib/rib_flowspec_redirect.go) and
#            the route server forwards the rule to the receiver with
#            MP_REACH next-hop length 0 and no redirect community.
# PREVENTS:  the refusal living only in unit tests: an overlay of
#            flowSpecRedirectRefused that always answers false makes the
#            receiver get next hop C000024D and the community, and this file red
#            (recorded in plan/handover/03-session-2026-10-18-linux-continue.md).
#            flowspec-redirect-check-disabled.ci is the same exchange with the
#            switch off.

option=timeout:value=30s

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=2
option=bind:value=0.0.0.0
option=conn_map:value=remote-ip
option=asn:value=65002:peer=127.0.0.1
option=asn:value=65003:peer=127.0.0.2

# Source: the covering unicast route
# (ORIGIN IGP, AS_PATH 65002 65009, NEXT_HOP 192.0.2.1, 192.0.2.0/24) ...
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF003302000000184001010040020A02020000FDEA0000FDF1400304C000020118C00002
# ... then the FlowSpec rule: ORIGIN IGP, AS_PATH 65002, EXT_COMMUNITY
# redirect-to-IP, MP_REACH ipv4/flow next hop 192.0.2.77, destination 192.0.2.0/24.
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0041020000002A4001010040020602010000FDEAC010080800000000000000800E0F00018504C000024D00050118C00002

# ... and ze's End-of-RIB, which ends the source's part of the exchange.
expect=bgp:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000

# Receiver, seq 3: the unicast route (AS_PATH 65002 65009, kept by the route
# server), forwarded live. The live forward carries no FlowSpec rule: the RIB's
# ValidationChange for the new path is the one export of the rule, so the
# receiver gets it exactly once, as an announcement, and never a withdrawal
# (flowSpecSection, reactor/forward_validation.go).
expect=bgp:conn=2:seq=3:contains=02020000FDEA0000FDF1
reject=bgp:conn=2:scope=withdrawn:pattern=050118C00002
# seq 4: the rule, once and exactly: MP_REACH ipv4/flow with next-hop length 0
# (800E0B 0001 85 00 00 050118C00002), ORIGIN, AS_PATH 65002, no EXT_COMMUNITY.
expect=bgp:conn=2:seq=4:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0032020000001B800E0B0001850000050118C000024001010040020602010000FDEA
reject=bgp:conn=2:pattern=10080800000000000000
# Both seen: stop the daemon, which closes every session of the batch.
action=sigterm:conn=2:seq=5
EOF_PEER

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	internal bgp-rib {
		use bgp-rib
	}
	internal rs {
		use bgp-rs
	}
	internal adj-rib-in {
		use bgp-adj-rib-in
	}
}
bgp {
	# RFC 8212: an EBGP direction with no policy is refused; this test exchanges routes.
	filter {
		import { final accept; }
		export { final accept; }
	}
	peer source {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65002
			}
			router-id 1.2.3.4
			rs-client true
			family {
				ipv4/unicast { prefix { maximum 10000; } }
				ipv4/flow { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		attach process bgp-rib {
			receive [ update state refresh ]
			send [ update ]
		}
		attach process adj-rib-in {
			receive [ update-received state ]
			send [ update ]
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
	}
	peer receiver {
		connection {
			remote {
				ip 127.0.0.2
			}
			local {
				ip 127.0.0.2
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65003
			}
			router-id 1.2.3.4
			rs-client true
			family {
				ipv4/unicast { prefix { maximum 10000; } }
				ipv4/flow { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		attach process bgp-rib {
			receive [ update state refresh ]
			send [ update ]
		}
		attach process adj-rib-in {
			receive [ update-received state ]
			send [ update ]
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=30s
expect=exit:code=0
reject=stderr:pattern=panic
reject=stderr:pattern=fatal error
