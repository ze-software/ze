# Test: the BFD daemon runs a Keyed SHA1 session whose key is written in
# hexadecimal and holds bytes an ASCII string cannot carry.
#
# VALIDATES: RFC 5880 Section 6.7.4 -- the management interface "SHOULD also
#            allow for the configuration of any arbitrary binary string in
#            hexadecimal form." A 20-byte `secret-hex` key with zero and 0xFF
#            bytes loads through the real daemon, the session is created on
#            the profile, and the signer runs for every transmission.
# PREVENTS:  the hexadecimal form passing `ze config validate` but being
#            refused or dropped when the daemon's BFD plugin loads its config.

option=env:var=ze.bfd.test-parallel:value=true
# BFD listens on the RFC 5881 / RFC 5883 FIXED ports, so every concurrently
# running BFD test's daemon binds the same wildcard (0.0.0.0, 3784/3785) tuple.
# SO_REUSEPORT above lets them co-bind, and the kernel then HASHES each inbound
# datagram to one socket in the group (internal/component/bfd/transport/
# udp_linux.go applySocketOptions) -- so a control reply or a reflected echo meant
# for this daemon can be delivered to a sibling test's daemon instead. That is the
# kernel-global surface option=exclusive exists for: unique addresses cannot
# partition a port number the RFC fixes. Tests outside the group still run
# alongside these.
option=exclusive:group=bfd-ports

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER


stdin=ze-bfd:terminator=EOF_CONF
plugin {
	external bfd-auth-sha1-test {
		run "le test fixture plugin/bfd-auth-sha1"
		encoder json
	}
}

environment {
	log {
		bfd debug
	}
}

bfd {
	enabled true;
	profile fast-auth {
		detect-multiplier 3
		desired-min-tx-us 100000
		required-min-rx-us 100000
		auth {
			type keyed-sha1
			key-id 7
			secret-hex "00ff4142434445464748494a4b4c4d4e4f5051ff"
		}
	}
	single-hop-session 203.0.113.9 {
		profile fast-auth
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bfd:timeout=15s
expect=exit:code=0
