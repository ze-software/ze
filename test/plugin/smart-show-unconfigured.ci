# Test: `show storage smart` on a daemon without SMART config
# VALIDATES: spec-smart-management AC-8 -- the show RPC is dispatched through
#            the plugin engine and returns the stable error contract when no
#            `storage { smart { ... } }` is configured (manager pointer nil).
# PREVENTS:  regression where an unconfigured daemon panics, returns done with
#            no manager, or changes the documented error string.

tmpfs=smart-show-error.run:mode=755:terminator=EOF_ERROR
#!/usr/bin/env python3
"""Dispatch `show storage smart` against an unconfigured daemon: expect the stable error."""

from ze_api import API, runtime_fail, result_text_data

WANT = 'storage SMART management not configured'


def dispatch(api, command):
    resp = api._call_engine(
        'ze-plugin-engine:dispatch-command', {'command': command})
    if resp is None:
        return {'status': 'error', 'data': 'engine call returned None'}
    return resp.get('result', {})


def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()
    api.wait_for_post_startup(timeout=5.0)

    r = dispatch(api, 'show storage smart')
    if r.get('status') != 'error':
        runtime_fail(
            f"show storage smart (unconfigured): expected error, "
            f"got status={r.get('status')} data={result_text_data(r)[:200]}")

    msg = result_text_data(r)
    if WANT not in msg:
        runtime_fail(
            f"show storage smart (unconfigured): expected error containing "
            f"{WANT!r}, got {msg[:200]!r}")

    dispatch(api, 'request shutdown')
    api.wait_for_shutdown()


if __name__ == '__main__':
    main()
EOF_ERROR

stdin=ze-conf:terminator=EOF_CONF
plugin {
    external smart-show-error {
        run ./smart-show-error.run
        encoder json
    }
}

bgp {
    peer peer1 {
        connection {
            remote {
                ip 127.0.0.1
            }
            local {
                ip 127.0.0.1
                accept false
            }
        }
        session {
            asn {
                local 1
                remote 1
            }
            router-id 1.2.3.4
            family {
                ipv4/unicast { prefix { maximum 10000; } }
            }
            capability {
                graceful-restart disable
            }
        }
        behavior {
            group-updates disable
        }
    }
}
EOF_CONF

cmd=foreground:seq=1:exec=ze -:stdin=ze-conf:timeout=15s
expect=exit:code=0
