# Test: show pki local-ca pem exports the root of the local certificate authority
# Exercises: dispatch-command -> ze-show:pki-local-ca-pem
# Verifies: the export is a CA certificate in PEM, its payload agrees with the
#           certificate it carries, and no private key reaches the response

# ze-peer: accepts connection
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
option=asn:value=65001
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# The daemon generates its root at start with no config, so this test configures
# no pki block. That is the point: the root exists because the daemon ran.
stdin=ze-bgp:terminator=EOF_CONF
plugin {
    external pki-ca-root-export-test {
        run "ze-test fixture plugin/pki-ca-root-export"
        encoder json
    }
}

bgp {
    peer peer1 {
        connection {
            remote {
                ip 127.0.0.1
            }
            local {
                ip 127.0.0.1
                accept false
            }
        }
        session {
            asn {
                local 65000
                remote 65001
            }
            router-id 1.2.3.4
            family {
                ipv4/unicast {
                    prefix {
                        maximum 10000
                    }
                }
            }
            capability {
                graceful-restart disable
            }
        }
        behavior {
            group-updates disable
        }
    }
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
