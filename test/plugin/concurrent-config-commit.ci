# Test: concurrent config commit rejects the second candidate
# VALIDATES: AC-13 -- a second commit while a transaction is active fails and does not replace the first candidate.
# PREVENTS: concurrent commits racing candidate pointers and promoting the wrong config.

option=timeout:value=45s
option=env:var=ZE_STORAGE_BLOB:value=false

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER


tmpfs=concurrent-config-commit.conf:terminator=EOF_CONF
plugin {
    external slow-commit {
        run "ze-test fixture plugin/concurrent-config-commit $PORT2"
        encoder json
    }
}

environment {
    api-server {
        token "secret";
        rest {
            enabled true;
            server main {
                ip 127.0.0.1;
                port $PORT2;
            }
        }
    }
}

bgp {
    router-id 1.2.3.4
    session {
        asn {
            local 1
        }
    }
    peer peer1 {
        connection {
            remote {
                ip 127.0.0.1
            }
            local {
                ip 127.0.0.1
                accept false
            }
        }
        session {
            asn {
                remote 1
            }
            router-id 1.2.3.4
            family {
                ipv4/unicast { prefix { maximum 10000; } }
            }
        }
        behavior {
            group-updates disable
        }
    }
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze start concurrent-config-commit.conf:timeout=45s
expect=exit:code=0
expect=file:path=concurrent.ok:contains=OK: concurrent commit rejected second candidate
expect=file:path=meta/config/active:exists=true
expect=file:path=meta/config/candidate:absent=true
expect=file:path=concurrent-config-commit.conf:contains=router-id 10.0.0.2
expect=file:path=concurrent-config-commit.conf:not-contains=router-id 10.0.0.3
