# Test: concurrent config commit rejects the second candidate
# VALIDATES: AC-13 -- a second commit while a transaction is active fails and does not replace the first candidate.
# PREVENTS: concurrent commits racing candidate pointers and promoting the wrong config.

option=timeout:value=45s
option=env:var=ZE_STORAGE_BLOB:value=false

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

tmpfs=slow-commit.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
import json
import os
import threading
import time
import urllib.error
import urllib.request

import ze_api
from ze_api import API, runtime_fail, wait_until

REST_PORT = int('$PORT2')
BASE_URL = f'http://127.0.0.1:{REST_PORT}/api/v1'
HEADERS = {'Authorization': 'Bearer secret', 'Content-Type': 'application/json'}

driver_done = threading.Event()
driver_error = []
shutdown_sent = False


def wait_for_rest(timeout=10):
    def _ok():
        try:
            req = urllib.request.Request(f'{BASE_URL}/commands', headers={'Authorization': 'Bearer secret'})
            urllib.request.urlopen(req, timeout=2).read()
            return True
        except (urllib.error.URLError, ConnectionRefusedError, OSError):
            return False
    # // test-relax: hand-rolled REST retry loop -> wait_until(REST /commands reachable)
    if not wait_until(_ok, attempts=max(1, int(timeout / 0.2)), delay=0.2):
        raise RuntimeError('REST API did not respond')


def request(method, path, payload=None, timeout=8):
    data = None
    headers = dict(HEADERS)
    if payload is not None:
        data = json.dumps(payload).encode()
    req = urllib.request.Request(BASE_URL + path, data=data, headers=headers, method=method)
    resp = urllib.request.urlopen(req, timeout=timeout)
    raw = resp.read()
    if not raw:
        return {}
    return json.loads(raw)


def create_session(value):
    created = request('POST', '/config/sessions')
    session_id = created.get('session-id')
    if not session_id:
        raise RuntimeError(f'create session response={created}')
    request('PUT', f'/config/sessions/{session_id}', {'path': 'bgp.router-id', 'value': value})
    return session_id


def commit_session(session_id, result):
    try:
        result['response'] = request('POST', f'/config/sessions/{session_id}/commit', timeout=15)
    except urllib.error.HTTPError as err:
        result['http_error'] = (err.code, err.read().decode(errors='replace'))
    except Exception as exc:  # noqa: BLE001
        result['error'] = repr(exc)


def wait_for_verify_start():
    if not wait_until(lambda: os.path.exists('verify.started'), attempts=80, delay=0.1):
        raise RuntimeError('first commit did not enter config verify')


def drive_rest_commits():
    try:
        wait_for_rest()
        first = create_session('10.0.0.2')
        second = create_session('10.0.0.3')

        first_result = {}
        worker = threading.Thread(target=commit_session, args=(first, first_result), daemon=True)
        worker.start()
        wait_for_verify_start()

        second_result = {}
        commit_session(second, second_result)
        http_error = second_result.get('http_error')
        if not http_error:
            raise RuntimeError(f'second commit unexpectedly succeeded: {second_result}')
        status, body = http_error
        if status < 400 or ('candidate' not in body and 'progress' not in body and 'reload' not in body):
            raise RuntimeError(f'unexpected second commit rejection status={status} body={body}')

        worker.join(timeout=18)
        if worker.is_alive():
            raise RuntimeError('first commit did not finish')
        if first_result.get('response', {}).get('status') != 'committed':
            raise RuntimeError(f'first commit failed: {first_result}')

        with open('concurrent-config-commit.conf', encoding='utf-8') as fh:
            active = fh.read()
        if 'router-id 10.0.0.2' not in active or 'router-id 10.0.0.3' in active:
            raise RuntimeError(f'active config after concurrent commits was wrong:\n{active}')
        with open('concurrent.ok', 'w', encoding='utf-8') as fh:
            fh.write('OK: concurrent commit rejected second candidate\n')
        print('OK: concurrent commit rejected second candidate', file=os.sys.stderr)
    except Exception as exc:  # noqa: BLE001
        driver_error.append(str(exc))
    finally:
        driver_done.set()


def candidate_has_router_id(params, router_id):
    for section in params.get('sections', []):
        if section.get('root') == 'bgp' and router_id in section.get('data', ''):
            return True
    return False


def main():
    global shutdown_sent
    api = API()
    ze_api._api = api
    api.declare_config('bgp')
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()

    def verify(params):
        if candidate_has_router_id(params, '10.0.0.2'):
            with open('verify.started', 'w', encoding='utf-8') as fh:
                fh.write('started\n')
            # deliberate timer: the 3s verify hold IS the concurrency race window under test, do NOT convert
            time.sleep(3)
        return {'status': 'ok'}

    api.on_config_verify(verify)
    api.ready()
    api.wait_for_post_startup(timeout=5.0)

    driver = threading.Thread(target=drive_rest_commits, daemon=True)
    driver.start()
    while True:
        api.read_line(timeout=0.1)
        if driver_done.is_set() and not shutdown_sent:
            api._call_engine('ze-plugin-engine:dispatch-command', {'command': 'request shutdown'})
            shutdown_sent = True
        if api._shutdown:
            break

    driver.join(timeout=2)
    if driver_error:
        runtime_fail(driver_error[0])


if __name__ == '__main__':
    main()
EOF_RUN

tmpfs=concurrent-config-commit.conf:terminator=EOF_CONF
plugin {
    external slow-commit {
        run ./slow-commit.run
        encoder json
    }
}

environment {
    api-server {
        token "secret";
        rest {
            enabled true;
            server main {
                ip 127.0.0.1;
                port $PORT2;
            }
        }
    }
}

bgp {
    router-id 1.2.3.4
    session {
        asn {
            local 1
        }
    }
    peer peer1 {
        connection {
            remote {
                ip 127.0.0.1
            }
            local {
                ip 127.0.0.1
                accept false
            }
        }
        session {
            asn {
                remote 1
            }
            router-id 1.2.3.4
            family {
                ipv4/unicast { prefix { maximum 10000; } }
            }
        }
        behavior {
            group-updates disable
        }
    }
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze start concurrent-config-commit.conf:timeout=45s
expect=exit:code=0
expect=file:path=concurrent.ok:contains=OK: concurrent commit rejected second candidate
expect=file:path=meta/config/active:exists=true
expect=file:path=meta/config/candidate:absent=true
expect=file:path=concurrent-config-commit.conf:contains=router-id 10.0.0.2
expect=file:path=concurrent-config-commit.conf:not-contains=router-id 10.0.0.3
