# Test: the stored bcrypt hash is accepted as a credential ONLY over a local
# (loopback) SSH transport, and rejected over a non-loopback transport.
#
# VALIDATES: spec-fixit-bcrypt-hash-credential
#   AC-2 -- hash-as-token over loopback authenticates (the on-box ze CLI path).
#   AC-1 -- hash-as-token over a non-loopback peer is REJECTED.
#   AC-3 -- the real plaintext password authenticates over both transports.
# PREVENTS: a leaked config backup containing the bcrypt hash being replayed
#           as an SSH credential from another machine.

stdin=ze-conf:terminator=EOF_CONF
bgp {
	peer peer1 {
		connection {
			remote { ip 127.0.0.2; }
			local { ip 127.0.0.1; accept false; }
		}
		session { asn { local 65533; remote 65533; } }
	}
}
system {
	authentication {
		user alice {
			password "$2a$04$UlwuiuH82Unfsq.XEMPGJeDkXwbm3KW.nvVaVXOd/JeFK8VjMjrQO"
		}
	}
}
environment {
	ssh {
		enabled true
		server loop { ip 127.0.0.1; port $PORT; }
		# Binding the second listener to all interfaces lets the native fixture
		# connect through a host-owned non-loopback address when one exists.
		server lan { ip 0.0.0.0; port $PORT2; }
	}
}
plugin {
	external remote-hash-test {
		run "ze-test fixture plugin/ssh-remote-hash-rejected $PORT $PORT2"
		encoder json
	}
}
EOF_CONF

cmd=foreground:seq=1:exec=ze -:stdin=ze-conf:timeout=30s
expect=exit:code=0
expect=stderr:pattern=OK: AC-2 -- hash-as-token accepted over loopback
expect=stderr:pattern=OK: all ssh-remote-hash tests passed
reject=stderr:pattern=ZE-OBSERVER-FAIL
