# Test: dynamic CoS profiles loaded and queriable at runtime via show command.
#
# VALIDATES: spec-cos-dynamic AC-2 -- CoS profiles available for session-up handler.
# VALIDATES: spec-cos-dynamic AC-12 -- show class-of-service returns registered profiles.
# PREVENTS:  CoS plugin startup failure or profile registration silently dropped.
#
# The full session lifecycle (RADIUS -> session-up -> maps applied -> session-down
# -> maps reverted) requires L2TP kernel support and runs in QEMU integration tests.
# This test verifies the wiring that makes that lifecycle possible: profiles load
# from config, the plugin starts, and the show command returns correct data.

# This test creates a VLAN interface, so it needs CAP_NET_ADMIN, not merely
# Linux. On the unprivileged GitHub runner the interface plugin logged
# 'iface: create vlan "eth0.100": operation not permitted' and ze exited 1.
# needs-linux alone does not gate on the capability; caps=net-admin does, and
# names the runner where the test really executes (ai/rules/qemu-testing.md).
option=needs-linux:caps=net-admin
# Serialize against every other needs-linux cos test: they all configure the SAME
# VLAN (unit v100 / vlan-id 100) on the VM's real eth0, and the QEMU run gives
# them one shared root namespace, so concurrent daemons create, reconcile and
# remove the same kernel device eth0.100. That produced `eth0.100 remove stale
# address fe80::.../64: cannot assign requested address` -- one daemon removing an
# address another had already taken away. Same mechanism as the ddos cluster; see
# test/plugin/ddos-direction.ci for the full rationale.
option=exclusive:group=cos-vlan
option=env:var=ze.l2tp.skip-kernel-probe:value=true
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER


stdin=ze-conf:terminator=EOF_CONF
plugin {
    external cos-dynamic-session-test {
        run "ze-test fixture plugin/cos-dynamic-session"
    }
}

class-of-service {
    ieee-802.1p residential {
        ingress {
            pcp 0 { priority 0; }
            pcp 6 { priority 6; }
        }
        egress {
            priority 0 { pcp 0; }
            priority 6 { pcp 6; }
        }
    }
    ieee-802.1p business {
        ingress {
            pcp 0 { priority 0; }
        }
        egress {
            priority 0 { pcp 1; }
            priority 1 { pcp 3; }
        }
    }
}

interface {
    backend netlink;
    ethernet eth0 {
        unit v100 { vlan-id 100; }
    }
}

bgp {
    peer peer1 {
        connection {
            remote { ip 127.0.0.1; }
            local { ip 127.0.0.1; accept false; }
        }
        session {
            asn { local 1; remote 1; }
            router-id 1.2.3.4
            family { ipv4/unicast { prefix { maximum 10000; } } }
            capability { graceful-restart disable; }
        }
        behavior { group-updates disable; }
    }
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-conf:timeout=15s
expect=exit:code=0
