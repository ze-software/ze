# Test: an operator runs a plugin-owned command whose walk streams every row
#
# Flow:
# 1. A shell script writes a config declaring one external Go SDK plugin
# 2. The daemon starts, spawns `ze-test record-plugin`, and opens SSH
# 3. `ze init` creates operator credentials
# 4. `ze cli -c "show test records walk | ndjson"` reads the walk
# 5. Every row of the walk reaches the operator, one line each, in walk order
#
# The plugin's handler answers with a plugin.Records rather than a built value
# (cmdRecordPlugin, internal/test/cli/cmd_record_plugin.go), so its rows travel
# to the engine as records (Records.WriteAnswer, pkg/plugin/records.go), the
# engine reads them as records (SendExecuteCommandAnswer,
# internal/component/plugin/ipc/rpc.go), and the operator's channel renders them
# one at a time (RenderRecords, internal/component/command/render_records.go).
# No Go unit test joins those three, because only a running daemon has all of
# them.
#
# The walk is sized so the two readings of it DIFFER, which is what makes this
# test discriminate. A short walk collapses to the same document a built value
# would have carried, by design, so a fixture of ordinary rows would pass with
# the record path removed. This walk is wider than rpc.MaxMessageSize in total,
# so it has no form as a single wire message at all: a producer that built the
# whole answer and wrote it on one line cannot carry it.
#
# VALIDATES: AC-4 -- a plugin command handler answers with a row generator and
# the rows reach the operator as records.
# VALIDATES: user story 1 -- an operator runs a plugin-owned command with a long
# walk and sees every row.
# PREVENTS: the plugin's answer being built whole and flattened into one line,
# which makes the 16 MB message ceiling a ceiling on the whole answer.

tmpfs=test-plugin-owned-command-streams.sh:mode=755:terminator=EOF_SH
#!/bin/sh
set -e

# Signal test runner readiness
touch daemon.ready

cat > plugin-owned-command-streams.conf << 'ZECONF'
plugin {
	external record-plugin {
		run "ze-test record-plugin"
		encoder json
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.2
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65533
				remote 65533
			}
		}
	}
}

system {
	authentication {
		user admin {
			password "$2a$04$UlwuiuH82Unfsq.XEMPGJeDkXwbm3KW.nvVaVXOd/JeFK8VjMjrQO"
			profile [ admin ]
		}
	}
	authorization {
		profile admin {
			run {
				default-action allow
			}
			edit {
				default-action allow
			}
		}
	}
}

environment {
	ssh {
		enabled true
		server main {
			ip 127.0.0.1;
			port 0;
		}
	}
}
ZECONF

# Use a PID-derived high port for BGP to avoid needing root for port 179
export ze_test_bgp_port=$((10000 + ($$ % 50000)))

ze start plugin-owned-command-streams.conf 2>daemon.log &
DAEMON_PID=$!
trap 'kill $DAEMON_PID 2>/dev/null; wait $DAEMON_PID 2>/dev/null' EXIT

# Wait for the SSH server to report its listening address
SSH_PORT=""
for i in $(seq 1 50); do
	SSH_PORT=$(grep -o '127\.0\.0\.1:[0-9]*' daemon.log 2>/dev/null | head -1 | cut -d: -f2 || true)
	if [ -n "$SSH_PORT" ]; then
		break
	fi
	sleep 0.2
done

if [ -z "$SSH_PORT" ]; then
	echo "FAIL: SSH server did not start (no address in daemon.log)" >&2
	cat daemon.log >&2
	exit 1
fi
echo "SSH port: $SSH_PORT" >&2

# Brief delay for postStartFunc to wire the authorizer
sleep 0.5

ADMIN_DIR=$(mktemp -d)
trap 'rm -rf "$ADMIN_DIR"; kill $DAEMON_PID 2>/dev/null; wait $DAEMON_PID 2>/dev/null' EXIT
printf 'admin\ntestpass\n127.0.0.1\n%s\n' "$SSH_PORT" | ZE_CONFIG_DIR="$ADMIN_DIR" ze init >/dev/null

# The plugin registers its commands at Stage 1, and the engine freezes the
# registry after every plugin is ready. Wait for the name to be there rather
# than for a duration.
for i in $(seq 1 50); do
	if ZE_CONFIG_DIR="$ADMIN_DIR" ZE_SSH_PASSWORD="testpass" \
		ze cli -c "system command list | raw" 2>/dev/null | grep -q 'show test records walk'; then
		break
	fi
	sleep 0.2
done

if ! ZE_CONFIG_DIR="$ADMIN_DIR" ZE_SSH_PASSWORD="testpass" \
	ze cli -c "system command list | raw" 2>/dev/null | grep -q 'show test records walk'; then
	echo "FAIL: the plugin never registered its command" >&2
	cat daemon.log >&2
	exit 1
fi

# The operator reads the walk. `| ndjson` names one JSON value per line, which
# is the one format the daemon can write as the records arrive.
if ! ZE_CONFIG_DIR="$ADMIN_DIR" ZE_SSH_PASSWORD="testpass" \
	ze cli -c "show test records walk | ndjson" > walk.ndjson 2> walk-err.log; then
	echo "FAIL: the plugin command did not answer" >&2
	cat walk-err.log >&2
	exit 1
fi

BYTES=$(wc -c < walk.ndjson | tr -d ' ')
LINES=$(wc -l < walk.ndjson | tr -d ' ')

# Fixture precondition: the collection must be wider than one wire message.
# Without it the record path and a built value carry the same document, and
# this test would pass with the record path removed.
if [ "$BYTES" -le 16777216 ]; then
	echo "FAIL: fixture problem -- the walk is $BYTES bytes, inside the 16777216-byte wire message" >&2
	exit 1
fi

# Fixture precondition: the walk must pass the 256-record threshold, or the
# answer collapses to one document and never streams.
if [ "$LINES" -le 256 ]; then
	echo "FAIL: fixture problem -- the walk is $LINES rows, inside the 256-record threshold" >&2
	exit 1
fi

# Every row, once, in walk order.
python3 - walk.ndjson << 'PYEOF'
import json
import sys

seen = []
with open(sys.argv[1]) as handle:
    for number, line in enumerate(handle):
        row = json.loads(line)
        if set(row) != {"index", "fill"}:
            print(f"FAIL: row {number} carries {sorted(row)}, want index and fill", file=sys.stderr)
            sys.exit(1)
        if "rows" in row:
            print(f"FAIL: row {number} carries the envelope, which the head carries", file=sys.stderr)
            sys.exit(1)
        seen.append(row["index"])

if seen != list(range(len(seen))):
    print(f"FAIL: the rows arrived out of walk order or with a gap: {seen[:8]}", file=sys.stderr)
    sys.exit(1)

print(f"OK: {len(seen)} rows reached the operator, one line each, in walk order", file=sys.stderr)
PYEOF

echo "OK: the plugin walk streamed $LINES rows and $BYTES bytes" >&2
exit 0
EOF_SH

# Process orchestration
cmd=foreground:seq=1:exec=./test-plugin-owned-command-streams.sh:timeout=60s
expect=exit:code=0
expect=stderr:pattern=OK: [0-9]+ rows reached the operator, one line each, in walk order
expect=stderr:pattern=OK: the plugin walk streamed [0-9]+ rows and [0-9]+ bytes
reject=stderr:pattern=panic recovered
