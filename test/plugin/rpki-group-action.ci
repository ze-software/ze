# Test: RPKI group-level action inheritance (AC-3)
# VALIDATES: global action/invalid=reject, group "upstreams" overrides action/invalid=accept, and
#            member peer1 (no own override) inherits it, so an Invalid-origin route is ACCEPTED;
#            show bgp rpki status reports the action with source=group.
# PREVENTS: group-level action not being inherited by member peers.

# ze-peer: send route 10.0.1.0/24 from AS 65999 (VRP has AS 65001) => Invalid origin
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
option=linger:value=true
option=update:value=send-route:prefix=10.0.1.0/24:origin-as=65999:next-hop=10.0.0.1
# EOR from ze
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# native test plugin: verifies the Invalid route IS accepted via group inheritance.
# Native compiled fixture: plugin/rpki-group-action
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	hub {
		server local {
			ip 127.0.0.1;
			port 0;
			secret rpki-test-secret-key-01234567890;
		}
	}
	external rpki-group-test {
		run "ze-test fixture plugin/rpki-group-action"
		encoder json
	}
	internal rpki {
		use bgp-rpki
	}
	internal adj-rib-in {
		use bgp-adj-rib-in
	}
}

bgp {
	rpki {
		cache-server 127.0.0.1 {
			port $PORT2
		}
		action {
			invalid reject;
		}
	}
	group upstreams {
		rpki {
			action {
				invalid accept;
			}
		}
		peer peer1 {
			connection {
				remote {
					ip 127.0.0.1
				}
				local {
					ip 127.0.0.1
					accept false
				}
			}
			session {
				asn {
					local 1
					remote 1
				}
				router-id 1.2.3.4
				family {
					ipv4/unicast { prefix { maximum 10000; } }
				}
				capability {
					graceful-restart disable
				}
			}
			behavior {
				group-updates disable
			}

			attach process rpki-group-test {
				receive [ update state ]
			}
			attach process rpki {
				receive [ update-received ]
			}
			attach process adj-rib-in {
				receive [ update-received state ]
			}
		}
	}
}
EOF_CONF

# VRP: 10.0.0.0/8 maxlen=24 AS=65001 (route from AS 65999 = Invalid)
cmd=background:seq=1:exec=ze-test rtr-mock --port $PORT2 --vrp 10.0.0.0/8,24,65001
cmd=background:seq=2:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=3:exec=ze -:stdin=ze-bgp:timeout=20s
