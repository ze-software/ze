# Test: ASPA policy log-only - route with ASPA Invalid path accepted when policy=log-only
# VALIDATES: AC-2 — aspa-invalid-action log-only + ASPA Invalid -> route accepted, event emitted
# PREVENTS: ASPA Invalid routes incorrectly rejected under default log-only policy

# ze-peer: send route 10.0.1.0/24 with AS_PATH [64500, 64501, 64502]
# 64502 has ASPA record but does NOT authorize 64501 -> Invalid
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
option=update:value=send-route:prefix=10.0.1.0/24:origin-as=64502:next-hop=10.0.0.1:as-path=64500,64501,64502
# EOR from ze
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# Python observer: verify route IS in adj-rib-in (accepted) and event has aspa-state=invalid
tmpfs=rpki-aspa-policy-logonly-test.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
import json
import sys
from ze_api import API, result_text_data
# // test-relax: removed unused 'import time'; blind sleeps replaced by event loop + dispatch_until

def dispatch(api, command):
    resp = api._call_engine(
        'ze-plugin-engine:dispatch-command', {'command': command})
    if resp is None:
        return {'status': 'error', 'data': 'engine call returned None'}
    return resp.get('result', {})

def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()

    api.subscribe(['rpki direction received'])
    api.ready()

    # // test-relax: deleted blind sleep(5.0); the event read loop below polls up to ~15s for the invalid event
    try:
        # Wait for ASPA event confirming Invalid state (should still emit event)
        found_event = False
        for _ in range(30):
            event_str = api.read_line(timeout=0.5)
            if event_str is None:
                continue
            try:
                evt = json.loads(event_str)
            except (json.JSONDecodeError, TypeError):
                continue
            bgp = evt.get('bgp', {})
            msg = bgp.get('message', {})
            if msg.get('type') != 'rpki':
                continue
            rpki = bgp.get('rpki', {})
            if not isinstance(rpki, dict):
                continue
            if rpki.get('status') == 'unavailable':
                continue
            aspa_state = rpki.get('aspa-state')
            if aspa_state == 'invalid':
                found_event = True
                print('OK: rpki event has aspa-state=invalid (log-only mode)', file=sys.stderr)
                break

        if not found_event:
            print('FAIL: no rpki event with aspa-state=invalid', file=sys.stderr)
            sys.exit(1)

        # Query adj-rib-in: route should be ACCEPTED (log-only does not reject).
        # Config loads bgp-adj-rib-in (not bgp-rib), so 'show bgp adj-rib-in' is the
        # served command that lists received routes.
        # // test-relax: blind sleep(1.0) + single-shot -> dispatch_until poll until the accepted route lands
        result = api.dispatch_until(
            'show bgp adj-rib-in',
            lambda r: '10.0.1.0/24' in result_text_data(r),
        )
        if result.get('status') != 'done':
            print(f'FAIL: rib routes received status={result.get("status")}', file=sys.stderr)
            sys.exit(1)

        data = result_text_data(result)
        if '10.0.1.0/24' not in data:
            print(f'FAIL: route 10.0.1.0/24 should be accepted under log-only policy: {data}', file=sys.stderr)
            sys.exit(1)

        print('OK: route 10.0.1.0/24 correctly accepted under log-only ASPA policy', file=sys.stderr)
    finally:
        dispatch(api, 'request shutdown')
        api.wait_for_shutdown()

if __name__ == '__main__':
    main()
EOF_RUN

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	hub {
		server local {
			ip 127.0.0.1;
			port 0;
			secret rpki-test-secret-key-01234567890;
		}
	}
	external rpki-aspa-policy-logonly-test {
		run ./rpki-aspa-policy-logonly-test.run
		encoder json
	}
	internal rpki {
		use bgp-rpki
	}
	internal adj-rib-in {
		use bgp-adj-rib-in
	}
}

bgp {
	rpki {
		cache-server 127.0.0.1 {
			port $PORT2
		}
		aspa {
			validation true;
			action {
				invalid log-only;
			}
		}
	}
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 64500
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}

		process rpki-aspa-policy-logonly-test {
		}
		process rpki {
			receive [ update ]
		}
		process adj-rib-in {
			receive [ update state ]
		}
	}
}
EOF_CONF

# RTR mock: VRP covers route (ROA Valid), ASPA where 64502 authorizes 99999 (NOT 64501) -> Invalid
cmd=background:seq=1:exec=ze-test rtr-mock --port $PORT2 --vrp 10.0.0.0/8,24,64502 --aspa 64501:64500 --aspa 64502:99999
cmd=background:seq=2:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=3:exec=ze -:stdin=ze-bgp:timeout=25s
expect=exit:code=0
