# Test: the forward-handle fast-path consumer reads zero-copy UPDATE bytes.
# VALIDATES: rib-arch-6 — the first production consumer of Change.Forward
#            (forwardStateTracker) AddRefs and reads the wire UPDATE bytes of a
#            received best-path route, updating observable fast-path state.
# PREVENTS: the zero-copy forward producer wiring (learned 784) shipping with no
#           real consumer (only the debug nil-check observer read the handle).

option=timeout:value=20s

# ze-peer announces a real route so the RIB produces a non-nil Change.Forward
# (injected routes carry no wire bytes, so a received UPDATE is required).
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=update:value=send-route:prefix=10.20.30.0/24:origin-as=65001:next-hop=101.1.101.1
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# Test plugin: enable the fast path early, then confirm the peer's announced
# route was read through the Change.Forward handle (forwarded > 0).

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external bgp-rs-fastpath {
		run "ze-test fixture plugin/bgp-rs-fastpath"
		encoder json
	}
	internal bgp-rib {
		use bgp-rib
	}
}

bgp {
	peer test-peer {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.5
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}

		attach process bgp-rib {
			receive [ update state refresh ]
			send [ update ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
