# Test: show ping to localhost via dispatch-command
# Exercises: dispatch-command -> ze-show:ping -> handleShowPing (ping.go:44) -> doPing (raw ICMP)
# Verifies: when privileged, JSON has destination/sent/received/loss-percent/replies[]
#           (fields built at ping.go:202-227). When the daemon lacks CAP_NET_RAW
#           (unprivileged runner) the handler returns a deterministic error that
#           names CAP_NET_RAW (ping.go:129); both branches are asserted, so the
#           test is green unprivileged and green under a privileged/QEMU-root run.
# NOTE: raw ICMP (ip4:icmp) needs CAP_NET_RAW; the default bin/ze-test runner is
#       unprivileged, so the error branch is what executes here.

# ze-peer: accepts connection
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
option=asn:value=65001
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

tmpfs=show-ping-test.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
import json
import sys
from ze_api import API, runtime_fail, result_text_data

def dispatch(api, command):
    # Convert an RPC-level failure (e.g. an unwired/unknown command, which makes
    # _call_engine raise) into a status=error dict so the assertions below fire a
    # loud runtime_fail instead of crashing the plugin and passing vacuously.
    try:
        resp = api._call_engine(
            'ze-plugin-engine:dispatch-command', {'command': command})
    except Exception as e:
        return {'status': 'error', 'error': f'engine call raised: {e}'}
    if resp is None:
        return {'status': 'error', 'error': 'engine call returned None'}
    return resp.get('result', {})

def check_happy_path(resp):
    data = result_text_data(resp)
    if isinstance(data, str) and data:
        data = json.loads(data)
    if not isinstance(data, dict):
        runtime_fail(f'ping: expected dict, got {type(data).__name__}')
    if data.get('destination') != '127.0.0.1':
        runtime_fail(f'ping: expected destination=127.0.0.1, got {data.get("destination")!r}')
    if data.get('sent') != 1:
        runtime_fail(f'ping: expected sent=1, got {data.get("sent")!r}')
    if data.get('received') != 1:
        runtime_fail(f'ping: expected received=1 (loopback), got {data.get("received")!r}')
    replies = data.get('replies')
    if not isinstance(replies, list) or len(replies) != 1:
        runtime_fail(f'ping: expected 1 reply, got {replies!r}')
    reply = replies[0]
    if reply.get('status') != 'ok':
        runtime_fail(f'ping: expected reply status=ok, got {reply!r}')
    if 'rtt-ms' not in reply:
        runtime_fail(f'ping: missing "rtt-ms" in reply: {reply}')
    print(f'OK: show ping (privileged) received={data["received"]} loss={data["loss-percent"]}', file=sys.stderr)

def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()
    api.wait_for_post_startup(timeout=5.0)

    try:
        resp = dispatch(api, 'show ping 127.0.0.1 count 1 timeout 2s')
        status = resp.get('status')
        if status == 'done':
            check_happy_path(resp)
        elif status == 'error':
            err = resp.get('error') or result_text_data(resp)
            if 'CAP_NET_RAW' not in (err or ''):
                runtime_fail(f'ping: unexpected error (want CAP_NET_RAW): {err!r}')
            print(f'OK: show ping wired; raw ICMP needs CAP_NET_RAW: {err}', file=sys.stderr)
        else:
            runtime_fail(f'ping: unexpected status={status!r} resp={resp}')
    finally:
        dispatch(api, 'request shutdown')
        api.wait_for_shutdown()

if __name__ == '__main__':
    main()
EOF_RUN

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external show-ping-test {
		run ./show-ping-test.run
		encoder json
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast {
					prefix {
						maximum 10000
					}
				}
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}

		process show-ping-test {
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
