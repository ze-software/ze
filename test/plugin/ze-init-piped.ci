# Test: ze init with piped stdin creates the zefs database.
# VALIDATES: AC-1 -- piped credentials create zefs with SSH entries.

option=env:var=ZE_CONFIG_DIR:value=.
tmpfs=.ze-init-workdir:terminator=EOF_WORKDIR
init
EOF_WORKDIR
stdin=init-answers:terminator=EOF_INPUT
admin
secret123
127.0.0.1
2222
EOF_INPUT

# Declarative stdin exercises the actual ze init entry point without a helper.
cmd=foreground:seq=1:exec=ze init:stdin=init-answers:timeout=10s
expect=exit:code=0
expect=file:path=database.zefs:exists=true
