# bgp-local-as-options -- the two RFC 7705 Section 3.3 local-as options select
# DIFFERENT AS_PATHs, read off the wire in one run.
#
# The router has migrated into AS 65000 and still answers to the legacy AS 65010
# on the sessions that have not been renumbered. One UPDATE from AS 65001 leaves
# for four receivers whose configuration differs only in `local-options`:
#
#   conn=2  no option        AS_SEQUENCE[65010, 65000, 65001]
#   conn=3  no-prepend       AS_SEQUENCE[65010, 65000, 65001]
#   conn=4  replace-as       AS_SEQUENCE[65010, 65001]
#   conn=5  no-prepend and replace-as   AS_SEQUENCE[65010, 65001]
#
# RFC 7705 Section 3.3 gives the two options two rails. "Replace Old AS" is
# outbound: toward the peer carrying it the speaker "MUST NOT append the
# globally configured ASN" and "MUST append only the configured 'Local AS' ASN
# value", which is conn=4. "No Prepend Inbound" is inbound: it governs what is
# installed and what reaches iBGP neighbors, and it "MUST still append the
# globally configured ASN as normal when advertising the UPDATE to other local
# eBGP neighbors". It therefore changes nothing about what conn=3 receives, and
# conn=3 is byte-identical to conn=2 on purpose.
#
# WHY THIS FILE EXISTS. Until 2026-08-29 either option cleared the same field
# (secondaryPrependAS, peer_forward_facts.go), so conn=3, conn=4 and conn=5 all
# received the conn=4 bytes: three documented configurations, one behavior, and
# no test anywhere drove local-as onto the wire. The conn=3 / conn=4 pair is what
# makes that collapse impossible to reintroduce silently -- the two frames differ
# by exactly one enum in the config below.
#
# The unit-level twin is internal/component/bgp/reactor/rfc7705_local_as_test.go,
# which reads the same rail and adds the iBGP and native-eBGP destinations.
#
# NO LOCAL_PREF in the source frame: the source is an eBGP peer and RFC 4271
# Section 5.1.5 forbids LOCAL_PREF toward external peers, so ze would overwrite
# it with an ATTR_DISCARD marker and the byte equality below would pin the marker
# rather than the AS_PATH.

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=5
option=timeout:value=20s
option=bind:value=0.0.0.0
# Bind conn=N by remote IP rather than accept order: which receiver connects
# first is a race, and the four receivers must be told apart by identity
# (peer_connmap.go).
option=conn_map:value=remote-ip

# Source peer (conn=1, AS 65001): announce 10.0.0.0/24 with a populated AS_PATH.
#   ORIGIN:    40010100            IGP
#   AS_PATH:   40020602010000FDE9  AS_SEQUENCE[65001], 4-byte ASNs
#   NEXT_HOP:  40030401010101      1.1.1.1
#   NLRI:      180A0000            10.0.0.0/24
# attr len = 4+9+7 = 20 = 0x14; total = 19+2+2+20+4 = 47 = 0x2F.
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002F02000000144001010040020602010000FDE940030401010101180A0000

# The source's own EOR. Only conn=1's is asserted: RFC 4724 Section 4.1
# constrains no ordering between a peer's EOR and the routes it learns
# afterwards, so pinning a receiver's EOR turns a permitted ordering into a flake
# under load. That every receiver sends one is still enforced, fail-closed, by
# the observer's expected_peers=5.
expect=bgp:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000

# conn=2, local-as 65010 with NO option: the base form of RFC 7705 Section 3.3,
# "first append the globally configured ASN ... immediately followed by the
# 'Local AS' value", so the local-as ends up outermost.
#   AS_PATH: 40020E02030000FDF20000FDE80000FDE9   AS_SEQUENCE[65010, 65000, 65001]
# attr len = 4+17+7 = 28 = 0x1C; total = 19+2+2+28+4 = 55 = 0x37.
expect=bgp:conn=2:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0037020000001C4001010040020E02030000FDF20000FDE80000FDE940030401010101180A0000

# conn=3, local-as 65010 with no-prepend: an INBOUND option, so these bytes are
# conn=2's bytes. 0000FDE8 (65000) is still there, and that is the assertion.
expect=bgp:conn=3:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0037020000001C4001010040020E02030000FDF20000FDE80000FDE940030401010101180A0000

# conn=4, local-as 65010 with replace-as: the globally configured ASN is gone.
#   AS_PATH: 40020A02020000FDF20000FDE9   AS_SEQUENCE[65010, 65001]
# attr len = 4+13+7 = 24 = 0x18; total = 19+2+2+24+4 = 51 = 0x33.
expect=bgp:conn=4:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF003302000000184001010040020A02020000FDF20000FDE940030401010101180A0000

# conn=5, both options together: the YANG description calls this "full
# replacement with no prepend", and outbound that is replace-as -- conn=4's
# bytes.
expect=bgp:conn=5:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF003302000000184001010040020A02020000FDF20000FDE940030401010101180A0000
EOF_PEER

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	internal rs {
		use bgp-rs
	}
	internal adj-rib-in {
		use bgp-adj-rib-in
	}
	external shutdown-after-up {
		run "ze-test fixture plugin/bgp-local-as-options"
		encoder json
	}
}
bgp {
	# The router's globally configured ASN. Every peer below inherits it unless
	# it states a local-as of its own, and it is the ASN RFC 7705 calls "the
	# globally configured ASN" throughout Section 3.3.
	session {
		asn {
			local 65000
		}
	}
	peer source-peer {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		attach process adj-rib-in {
			receive [ update-received state ]
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
		attach process shutdown-after-up {
			receive [ update ]
		}
	}
	peer dual-receiver {
		connection {
			remote {
				ip 127.0.0.2
			}
			local {
				ip 127.0.0.2
				accept false
			}
		}
		session {
			asn {
				# local-as override, no modifier: both ASNs reach this peer.
				local 65010
				remote 65002
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		attach process adj-rib-in {
			send [ update ]
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
		attach process shutdown-after-up {
			receive [ update ]
		}
	}
	peer no-prepend-receiver {
		connection {
			remote {
				ip 127.0.0.3
			}
			local {
				ip 127.0.0.3
				accept false
			}
		}
		session {
			asn {
				local 65010
				remote 65003
				# The ONE leaf that separates this peer from dual-receiver. It is
				# RFC 7705's inbound option, so the frame above is unchanged by it.
				local-options [ no-prepend ]
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		attach process adj-rib-in {
			send [ update ]
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
		attach process shutdown-after-up {
			receive [ update ]
		}
	}
	peer replace-as-receiver {
		connection {
			remote {
				ip 127.0.0.4
			}
			local {
				ip 127.0.0.4
				accept false
			}
		}
		session {
			asn {
				local 65010
				remote 65004
				# The ONE leaf that separates this peer from no-prepend-receiver.
				local-options [ replace-as ]
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		attach process adj-rib-in {
			send [ update ]
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
		attach process shutdown-after-up {
			receive [ update ]
		}
	}
	peer both-options-receiver {
		connection {
			remote {
				ip 127.0.0.5
			}
			local {
				ip 127.0.0.5
				accept false
			}
		}
		session {
			asn {
				local 65010
				remote 65005
				local-options [ no-prepend replace-as ]
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		attach process adj-rib-in {
			send [ update ]
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
		attach process shutdown-after-up {
			receive [ update ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
reject=stderr:pattern=panic
reject=stderr:pattern=fatal error
reject=stderr:pattern=forward-cached failed
reject=stderr:pattern=release-cached failed
