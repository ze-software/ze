# Test: `show interface errors` reports exactly the links with non-zero error or
#        drop counters
# Exercises: dispatch-command -> ze-show:interface-errors ->
#            handleShowInterfaceErrors -> showInterfaceErrors
#            (internal/component/iface/cmd/show_interface.go)
# VALIDATES: the reported rows, and their four counter values, equal what the full
#            `show interface` list says. Both directions: nothing with a non-zero
#            counter is missed, nothing with all-zero counters is included.
# PREVENTS:  the vacuous form of this test. A clean host reports no rows, so
#            asserting "the list is empty" would pass just as well with the whole
#            handler deleted (ai/rules/interop-and-goal-validation.md, vacuity
#            traps). The reference set is computed from the sibling command instead,
#            so the assertion discriminates whether or not any link has errors.

option=skip-os:value=darwin

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=20s
option=asn:value=65001
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

tmpfs=show-interface-errors-test.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
"""Assert `show interface errors` equals the error rows of `show interface`."""

import json
import sys

from ze_api import API, dispatch, runtime_fail, result_text_data

# The four counters showInterfaceErrors filters and reports on, paired with their
# source field in InterfaceInfo.Stats (internal/component/iface/iface.go).
COUNTERS = ('rx-errors', 'rx-dropped', 'tx-errors', 'tx-dropped')


def decoded(resp, label):
    status = resp.get('status')
    if status != 'done':
        runtime_fail(f'{label}: status={status} data={result_text_data(resp)}')
    data = result_text_data(resp)
    if isinstance(data, str) and data:
        data = json.loads(data)
    return data


def counters_of(stats):
    """The four filtered counters, defaulting to 0 for an omitempty-dropped key."""
    return tuple(int(stats.get(key, 0)) for key in COUNTERS)


def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()
    api.wait_for_post_startup(timeout=5.0)

    try:
        every = decoded(dispatch(api, 'show interface'), 'interface-all')
        if not isinstance(every, list) or not every:
            runtime_fail(f'interface-all: expected a non-empty list, got {every!r}')

        with_stats = [
            i for i in every
            if isinstance(i, dict) and isinstance(i.get('stats'), dict)
        ]
        if not with_stats:
            runtime_fail(
                'interface-all: no interface carries "stats", so this test could '
                f'not tell a working filter from a deleted one: {every}')

        expected = {
            i['name']: counters_of(i['stats'])
            for i in with_stats
            if any(counters_of(i['stats']))
        }
        # The comparison only discriminates a REMOVED filter when at least one
        # link is excluded by it. A host with no clean link would leave that half
        # of the assertion untested, so say so rather than pass quietly.
        clean = [i['name'] for i in with_stats if not any(counters_of(i['stats']))]
        if not clean:
            runtime_fail(
                'interface-all: every link with stats has a non-zero error or drop '
                f'counter, so the filter has nothing to exclude here: {with_stats}')

        result = decoded(dispatch(api, 'show interface errors'), 'interface-errors')
        if not isinstance(result, dict) or 'interfaces' not in result:
            runtime_fail(f'interface-errors: expected an "interfaces" wrapper, got {result!r}')
        rows = result['interfaces']
        if not isinstance(rows, list):
            runtime_fail(f'interface-errors: "interfaces" is {type(rows).__name__}, not a list')

        got = {}
        for row in rows:
            if not isinstance(row, dict) or 'name' not in row:
                runtime_fail(f'interface-errors: malformed row {row!r}')
            missing = [key for key in COUNTERS if key not in row]
            if missing:
                runtime_fail(f'interface-errors: row {row["name"]} missing {missing}')
            got[row['name']] = tuple(int(row[key]) for key in COUNTERS)

        if got != expected:
            runtime_fail(
                f'interface-errors: reported {got}, but the full list says the '
                f'links with non-zero counters are {expected} '
                f'(clean links that must stay out: {clean})')

        print(f'OK: show interface errors matches {len(expected)} error link(s); '
              f'{len(clean)} clean link(s) excluded', file=sys.stderr)
    finally:
        dispatch(api, 'request shutdown')
        api.wait_for_shutdown()


if __name__ == '__main__':
    main()
EOF_RUN

stdin=ze-conf:terminator=EOF_CONF
plugin {
	external show-interface-errors-test {
		run ./show-interface-errors-test.run
		encoder json
	}
}

# The interface block makes the iface component run OnConfigure ->
# iface.LoadBackend("netlink"), so ListInterfaces has a backend to read. No
# interface is declared, so the managed set is empty and nothing is created or
# deleted: every read below is of links the host already has.
interface {
	backend netlink
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-conf:timeout=20s
expect=exit:code=0
expect=stderr:contains=OK: show interface errors matches
reject=stderr:pattern=panic
