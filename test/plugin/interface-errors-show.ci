# Test: `show interface errors` reports exactly the links with non-zero error or
#        drop counters
# Exercises: dispatch-command -> ze-show:interface-errors ->
#            handleShowInterfaceErrors -> showInterfaceErrors
#            (internal/component/iface/cmd/show_interface.go)
# VALIDATES: the reported rows, and their four counter values, equal what the full
#            `show interface` list says. Both directions: nothing with a non-zero
#            counter is missed, nothing with all-zero counters is included.
# PREVENTS:  the vacuous form of this test. A clean host reports no rows, so
#            asserting "the list is empty" would pass just as well with the whole
#            handler deleted (ai/rules/interop-and-goal-validation.md, vacuity
#            traps). The reference set is computed from the sibling command instead,
#            so the assertion discriminates whether or not any link has errors.

option=skip-os:value=darwin

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=20s
option=asn:value=65001
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER


stdin=ze-conf:terminator=EOF_CONF
plugin {
	external interface-errors-show-test {
		run "ze-test fixture plugin/interface-errors-show"
		encoder json
	}
}

# The interface block makes the iface component run OnConfigure ->
# iface.LoadBackend("netlink"), so ListInterfaces has a backend to read. No
# interface is declared, so the managed set is empty and nothing is created or
# deleted: every read below is of links the host already has.
interface {
	backend netlink
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-conf:timeout=20s
expect=exit:code=0
expect=stderr:contains=OK: show interface errors matches
reject=stderr:pattern=panic
