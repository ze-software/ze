# EOR test - End of RIB markers for IPv4 and IPv6
#
# VALIDATES: ze emits one End-of-RIB marker per NEGOTIATED family when a session
#            establishes, in ascending AFI order, with the exact RFC 4724 Section 2
#            encoding (ipv4/unicast in the body, ipv6/unicast as MP_UNREACH).
# PREVENTS:  a family losing its marker, or the marker being emitted for a family
#            the peer never negotiated.

# ze-peer expectations. Both markers come from sendInitialRoutes
# (internal/component/bgp/reactor/peer_initial_sync.go), which emits one per
# negotiated family on establishment. Families() sorts by AFI, so ipv4 precedes
# ipv6 deterministically.
stdin=peer:terminator=EOF_PEER
option=asn:value=1
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
expect=bgp:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF001E0200000007900F0003000201
EOF_PEER

# Python plugin script
tmpfs=eor.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3

from ze_api import API, runtime_fail


def main() -> None:
    api = API()
    # Full 5-stage handshake (the module-level ready() helper's sequence).
    api.declare_done()
    api.wait_for_config(timeout=10.0)
    api.capability_done()
    api.wait_for_registry(timeout=10.0)
    api.ready()

    # This observer OBSERVES; it no longer sends.
    #
    # It used to call `update text nlri <family> eor` twice, on the premise -- once
    # stated in this file -- that removing graceful-restart stops ze emitting
    # markers by itself. That premise is false: sendInitialRoutes emits one per
    # negotiated family unconditionally (peer_initial_sync.go), and those markers
    # claim the per-family slot RFC 4724 Section 2 allows. AnnounceEOR then refuses
    # the explicit one at BOTH gates -- peer.ShouldQueue() before the drain and
    # !peer.ClaimInitialSyncEOR(fam) after it (reactor_api_forward.go) -- so it
    # could never reach the wire. Its only observable effect was to raise "no
    # established peers to send to" on the run where ze-peer, already satisfied by
    # the real markers, had closed the session first.
    #
    # The wire assertions above are unchanged; they now have one producer.
    if not api.wait_peer_eor_sent():
        runtime_fail('peer1 never sent its initial-sync End-of-RIB')

    api.wait_for_shutdown()


if __name__ == '__main__':
    main()
EOF_RUN

# ze bgp configuration
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external announce-routes {
		run ./eor.run
		encoder json
	}
}
bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
				ipv6/unicast { prefix { maximum 10000; } }
			}
		}
		behavior {
			group-updates disable
		}

		process announce-routes {
		}
	}
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=10s
