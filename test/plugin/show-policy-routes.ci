# Test: show policy routes returns JSON with configured PBR rules
# VALIDATES: spec-cli-1-command-grammar AC-2 -- show policy routes returns JSON with PBR policy routes
# PREVENTS: show command returns empty or malformed JSON after CLI grammar migration
#
# Requires CAP_NET_ADMIN (nftables).

option=skip-os:value=darwin
option=skip-env:var=ZE_QEMU
option=timeout:value=15s

tmpfs=driver.py:mode=755:terminator=EOF_PY
#!/usr/bin/env python3
import json, os, signal, subprocess, sys, time

for _ in range(200):
    if os.path.exists("daemon.pid") and os.path.exists("daemon.ready"):
        break
    # poll interval; the loop above breaks once daemon.pid and daemon.ready exist, bounded wait not a blind sleep
    time.sleep(0.05)
else:
    sys.exit("daemon readiness files missing")

with open("daemon.pid") as f:
    pid = int(f.read().strip())

# // test-relax: deleted blind sleep(0.5) lead-in; the ze-cli retry loop below (50x) already covers daemon readiness
last_err = None
out = None
for _ in range(50):
    try:
        out = subprocess.check_output(
            ["ze", "cli", "-c", "show policy routes"],
            text=True, stderr=subprocess.STDOUT)
        break
    except subprocess.CalledProcessError as e:
        last_err = e
        # retry interval; the loop above stops on the first successful CLI response, bounded wait not a blind sleep
        time.sleep(0.1)
if out is None:
    sys.exit("ze cli never became ready: %s" % last_err.output)

try:
    data = json.loads(out)
except json.JSONDecodeError as e:
    sys.exit("invalid JSON from show policy routes: %s\noutput: %s" % (e, out))

if not isinstance(data, list) or len(data) == 0:
    sys.exit("expected non-empty list, got: %s" % out)

entry = data[0]
if 'name' not in entry:
    sys.exit("policy entry missing 'name' field: %s" % entry)

sys.stdout.write(out)
os.kill(pid, signal.SIGTERM)
EOF_PY

stdin=ze-bgp:terminator=EOF_CONF
firewall {
    backend nft;
}
policy {
    route test-pbr {
        interface "lo";
        rule allow-http {
            from {
                destination-port 80;
                protocol tcp;
            }
            then {
                accept;
            }
        }
    }
}
EOF_CONF

option=env:var=ze.log.policy.routes:value=info
option=env:var=ze.log.firewall:value=info

cmd=background:seq=1:exec=ze -:stdin=ze-bgp
cmd=foreground:seq=2:exec=python3 driver.py:timeout=15s
expect=exit:code=0
expect=stdout:contains=test-pbr
expect=stdout:contains=allow-http
