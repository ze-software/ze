# Test: mrt updates stream -- an operator configures MRT UPDATE dumping and a
# BGP UPDATE (the end-of-RIB marker ze sends after convergence) is written to
# the MRT file as an RFC 6396 BGP4MP record.
#
# VALIDATES: with `mrt { updates { file ... } }` configured (which auto-loads the
#            mrt plugin), an UPDATE message flowing on the session drives the MRT
#            component to open and write its updates file. mrtfmt.Writer creates
#            the file lazily on the first record, so file existence after a clean
#            shutdown proves the end-to-end config -> mrt component (MessageBridge
#            OnBGPMessage) -> asyncWriter -> file path fired for a real UPDATE.
# PREVENTS: the mrt plugin silently recording nothing -- notably the config-root
#           unwrap bug (mrt received {"mrt":{...}} but parsed the body as top
#           level, so it went idle and never wrote a dump).
#
# Mutation check: reverting the ParseConfig root-unwrap (mrt/register.go) makes
# the plugin idle again -> mrt-updates.dump absent -> this test flips RED
# (verified 2026-07-10: pre-fix the file was never created).

option=skip-os:value=darwin

# Give the runner one private working directory for both the daemon's relative
# MRT path and the file assertion below.
tmpfs=.mrt-workdir:terminator=EOF_WORKDIR
mrt
EOF_WORKDIR

# ze-peer: listen on $PORT, accept ze's session, and receive ze's end-of-RIB
# UPDATE (the expectation below both gives ze-peer test data and confirms the
# UPDATE ze records was really sent).
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
option=asn:value=65001
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# Native observer waits for the EOR UPDATE before requesting clean shutdown.

# ze configuration: the top-level `mrt {}` section auto-loads the mrt plugin
# (config-path auto-load, startup_autoload.go:74) and the observer drives the
# clean shutdown.
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external mrt-observer {
		run "ze-test fixture plugin/mrt-dump-updates"
		encoder json
	}
}

mrt {
	updates {
		file "mrt-updates.dump"
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast {
					prefix {
						maximum 10000
					}
				}
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

# After a clean shutdown the MRT updates file must exist (lazily created on the
# first written record, so its presence proves a real UPDATE was dumped).
expect=file:path=mrt-updates.dump:exists=true

# Process orchestration: ze-peer listener (background) + ze (foreground).
cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
reject=stderr:pattern=panic recovered
reject=stderr:pattern=mrt plugin failed
