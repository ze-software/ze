# Test: fib-kernel receives blackhole route via sysrib EventBus
#
# Flow:
# 1. fakefib emits sysrib BestChangeBatch with RouteType=blackhole
# 2. fib-kernel subscribes to (system-rib, best-change) and receives it
# 3. hasRichFields detects RouteType, dispatches to addRichRoute (Linux)
#    or logs error (non-Linux unsupported backend)
#
# VALIDATES: spec-fib-depth-3-richroute AC-1 -- blackhole route dispatched to fib-kernel
# PREVENTS: RouteType field lost in sysrib -> fib-kernel event delivery

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER


stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external fib-blackhole-test {
		run "ze-test fixture plugin/fib-blackhole"
		encoder json
	}
	internal bgp-rib {
		use bgp-rib
	}
	internal rib {
		use rib
	}
	internal fib-kernel {
		use fib-kernel
	}
	internal sysctl {
		use sysctl
	}
	internal fakefib {
		use fakefib
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}

		attach process bgp-rib {
			receive [ update state refresh ]
			send [ update ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
expect=stderr:pattern=fib-kernel
reject=stderr:pattern=panic recovered
reject=stderr:pattern=fatal error
reject=stderr:pattern=ZE-OBSERVER-FAIL
