# Test: fib-kernel programs each discard route type the system RIB carries
#
# Flow:
# 1. fakefib emits system-RIB changes with RouteType blackhole, unreachable and
#    prohibit, one prefix each
# 2. fib-kernel subscribes to (system-rib, best-change) and programs them
# 3. the fixture reads the kernel and requires one proto 250 entry per prefix,
#    of the emitted type
#
# VALIDATES: spec-fib-depth AC-6 and AC-7 (kernel side) -- RTN_BLACKHOLE,
#            RTN_UNREACHABLE and RTN_PROHIBIT installed from the event
# PREVENTS: RouteType lost between sysrib and fib-kernel, or a discard route
#           programmed as unicast. Until 2026-10-09 this test asserted only
#           that stderr named fib-kernel, which held with no route installed.
#
# Requires Linux and CAP_NET_ADMIN: fib-kernel programs through netlink.
option=needs-linux:caps=net-admin

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER


stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external fib-blackhole-test {
		run "le test fixture plugin/fib-blackhole"
		encoder json
	}
	internal bgp-rib {
		use bgp-rib
	}
	internal rib {
		use rib
	}
	internal fib-kernel {
		use fib-kernel
	}
	internal sysctl {
		use sysctl
	}
	internal fakefib {
		use fakefib
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}

		attach process bgp-rib {
			receive [ update state refresh ]
			send [ update ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
expect=stderr:contains=OK: kernel holds blackhole 198.18.201.0/24 proto 250
expect=stderr:contains=OK: kernel holds unreachable 198.18.202.0/24 proto 250
expect=stderr:contains=OK: kernel holds prohibit 198.18.203.0/24 proto 250
reject=stderr:pattern=panic recovered
reject=stderr:pattern=fatal error
reject=stderr:pattern=ZE-OBSERVER-FAIL
