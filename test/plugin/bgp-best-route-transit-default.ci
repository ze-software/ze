# Test: does an explicitly attached bgp-rib advertise its elected iBGP route to
# an external peer without a route-server plugin, then retire its withdrawal?
# RFC requirement: RFC4271-9.2-7 positive -- a newly elected ordinary IPv4 unicast route learned from iBGP reaches the configured eBGP recipient in an UPDATE with the learned path and local AS, with internal and forked bgp-rib.
# A unit cannot decide whether configuration grants, plugin placement, actual
# receive storage, next-hop resolution and the recipient TCP writer are joined.
# The compiled driver waits for both initial EORs, installs real terminal
# next-hop routes, proves local API output, observes the selected RIB owner,
# then requires learned output and withdrawal on the original socket. A final
# API fence detects spurious removal of unrelated output. No sleeps decide it.
option=timeout:value=150s

stdin=config-internal:terminator=CONFIG_INTERNAL
bus {
  endpoint adj-rib-in {
    internal bgp-adj-rib-in;
  }
  endpoint rib {
    internal bgp-rib;
  }
  endpoint bgp-selected-test {
    external {
      run "le test fixture plugin/bgp-best-route-transit-default internal 127.0.0.1:$PORT";
    }
    encoding json;
  }
}
bgp {
 router-id 1.1.1.1;
 peer source {
  connection { local { ip 127.0.0.1; port $PORT; } remote { ip 127.0.0.2; connect false; } }
  session { asn { local 65000; remote 65000; } aigp { enabled false; } family { ipv4/unicast { prefix { maximum 100; } } } capability { graceful-restart disable; } }
  behavior { group-updates disable; }
  filter { import { final accept; } }
 }
 peer destination {
  connection { local { ip 127.0.0.1; port $PORT; } remote { ip 127.0.0.3; connect false; } }
  session { asn { local 65000; remote 65002; } aigp { enabled false; } family { ipv4/unicast { prefix { maximum 100; } } } capability { graceful-restart disable; } }
  behavior { group-updates disable; }
  filter { import { final reject; } export { final accept; } }
 }
}
CONFIG_INTERNAL

cmd=foreground:seq=1:exec=ze -:stdin=config-internal:timeout=70s
expect=exit:code=0
expect=stderr:contains=OK: selected-route internal wiring and API survivor
reject=stderr:contains=ZE-OBSERVER-FAIL
reject=stderr:contains=panic recovered
cmd=foreground:seq=2:exec=le test fixture daemon/await-exit:timeout=20s
expect=stderr:contains=OK: the first daemon exited

stdin=config-forked:terminator=CONFIG_FORKED
bus {
  endpoint adj-rib-in {
    internal bgp-adj-rib-in;
  }
  endpoint rib {
    internal bgp-rib;
    process separate;
  }
  endpoint bgp-selected-test {
    external {
      run "le test fixture plugin/bgp-best-route-transit-default forked 127.0.0.1:$PORT";
    }
    encoding json;
  }
}
bgp {
 router-id 1.1.1.1;
 peer source {
  connection { local { ip 127.0.0.1; port $PORT; } remote { ip 127.0.0.2; connect false; } }
  session { asn { local 65000; remote 65000; } aigp { enabled false; } family { ipv4/unicast { prefix { maximum 100; } } } capability { graceful-restart disable; } }
  behavior { group-updates disable; }
  filter { import { final accept; } }
 }
 peer destination {
  connection { local { ip 127.0.0.1; port $PORT; } remote { ip 127.0.0.3; connect false; } }
  session { asn { local 65000; remote 65002; } aigp { enabled false; } family { ipv4/unicast { prefix { maximum 100; } } } capability { graceful-restart disable; } }
  behavior { group-updates disable; }
  filter { import { final reject; } export { final accept; } }
 }
}
CONFIG_FORKED

cmd=foreground:seq=3:exec=ze -:stdin=config-forked:timeout=70s
expect=exit:code=0
expect=stderr:contains=OK: selected-route forked wiring and API survivor
reject=stderr:contains=ZE-OBSERVER-FAIL
reject=stderr:contains=panic recovered
