# Test: RR client config parses and peer detail reports it
# VALIDATES: cmd-1 AC-13 -- peer detail shows route-reflector-client and cluster-id
# VALIDATES: cmd-1 AC-6 -- cluster-id configured and visible in peer detail
# PREVENTS: RR config not wired to PeerSettings

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
# The observer asserts that 10.1.0.0/24 -- learned from THIS peer over the wire --
# is in the RIB. That route exists only while this session is up: when the peer
# goes away ze correctly withdraws it. Without linger the peer exits the instant
# it receives ze's End-of-RIB, so the route is withdrawn out from under the
# observer and the test only passed by winning a ~500ms race (ze holds the EOR
# behind the initial-sync barrier, peer_initial_sync.go). linger holds the session
# open past the expectation, making the RIB assertion independent of host load.
option=linger:value=true

action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0036020000001B4001010040020602010000FDE94003040A000001400504000000C8180A0100
# Assert ze's ipv4/unicast End-of-RIB (RFC 4724 S2: the empty UPDATE). This is a
# real wire assertion, not just a TCP-hold: the observer gates `request shutdown`
# on eor-sent >= 1 (see wait_eor_sent below), so ze is given the chance to emit it.
# It also keeps the peer from closing TCP while the observer polls for peer state.
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

tmpfs=rr-test.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
import json
import sys
import time
from ze_api import API, runtime_fail, result_text_data, result_json_data

def dispatch(api, command):
    resp = api._call_engine(
        'ze-plugin-engine:dispatch-command', {'command': command})
    if resp is None:
        return {'status': 'error', 'data': 'engine call returned None'}
    return resp.get('result', {})

def eor_sent(result):
    """True once ze has written its End-of-RIB to at least one peer.

    `show bgp peer <sel> detail` returns {"peers": {"<ip>": {..., "eor-sent": N}}}
    (peer.go:217, :341-345). peer_stats.go IncrEORSent, called only from
    peer_initial_sync.go's sendInitialRoutes, increments the counter once the EOR
    write has succeeded and been flushed to the peer's socket, so eor-sent >= 1
    proves the marker is on the wire rather than merely scheduled.
    """
    if result.get('status') != 'done':
        return False
    try:
        peers = result_json_data(result, {}).get('peers', {})
    except (json.JSONDecodeError, TypeError, ValueError):
        return False
    return any(p.get('eor-sent', 0) >= 1 for p in peers.values())

def wait_eor_sent(api, selector):
    """Block until ze has sent its EOR, so `request shutdown` cannot pre-empt it.

    The peer block asserts ze's End-of-RIB on the wire. ze emits it only after the
    initial-sync barrier: peer_initial_sync.go's sendInitialRoutes runs the
    apiSync wait (500ms sleep, then the plugin-ready signal) before its EOR-send
    loop builds and sends the EOR. The
    session reaches `established` long before that, so a shutdown gated on
    establishment (or on the RIB check) closes TCP first and the peer's expectation
    can never fire. Gate on the EOR the test actually asserts.
    """
    if not eor_sent(api.dispatch_until(
            f'show bgp peer {selector} detail', eor_sent, attempts=40)):
        runtime_fail(f'ze never sent its End-of-RIB to {selector}')

def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()

    # Wait for peer-src's initial sync to reach the wire before asserting anything.
    #
    # // test-relax: the `'established' in <detail json>` check removed here was
    # VACUOUS, not coverage: every peer row carries the KEY
    # `connections-established` (cmd/peer/peer.go:238), so the substring matched
    # on the FIRST poll -- before any session existed -- and the barrier returned
    # instantly, gating none of the assertions below it. Replaced by this file's
    # own wait_eor_sent, which polls the per-peer `eor-sent` counter (peer.go:217;
    # peer_stats.go IncrEORSent increments it only once peer_initial_sync.go's
    # sendInitialRoutes has written AND flushed the EOR to the peer's socket).
    # eor-sent >= 1 strictly implies established, so this is stronger than the
    # check it replaces and it fails loudly.
    wait_eor_sent(api, 'peer-src')

    result = dispatch(api, 'show bgp peer peer-src detail')
    if result.get('status') != 'done':
        runtime_fail(f'peer detail failed: {result}')

    detail = result_text_data(result)
    if 'route-reflector-client' not in detail:
        runtime_fail(f'missing route-reflector-client: {detail[:300]}')
    if 'cluster-id' not in detail:
        runtime_fail(f'missing cluster-id: {detail[:300]}')

    # Verify RIB has the route (proves UPDATE was processed, not just config
    # accepted). Establishment precedes UPDATE processing, so poll the RIB until
    # the route lands rather than racing it with a single-shot query.
    # // test-relax: single-shot show bgp rib best -> dispatch_until poll until 10.1.0.0/24 lands
    def _route_present(r):
        if r.get('status') != 'done':
            return False
        d = result_text_data(r, '{}')
        try:
            p = json.loads(d) if isinstance(d, str) else d
        except (json.JSONDecodeError, TypeError, ValueError):
            return False
        entries = p.get('best-path', []) if isinstance(p, dict) else []
        return any(e.get('prefix') == '10.1.0.0/24' for e in entries)

    result = api.dispatch_until('show bgp rib best', _route_present, attempts=40)
    if result.get('status') != 'done':
        runtime_fail(f'rib show best failed: {result}')

    data = result_text_data(result, '{}')
    parsed = json.loads(data) if isinstance(data, str) else data
    entries = parsed.get('best-path', [])

    found = any(e.get('prefix') == '10.1.0.0/24' for e in entries)
    if not found:
        runtime_fail(f'route 10.1.0.0/24 not in RIB')

    print('OK: RR client and cluster-id visible in peer detail, route in RIB', file=sys.stderr)

    wait_eor_sent(api, 'peer-src')

    dispatch(api, 'request shutdown')
    api.wait_for_shutdown()

if __name__ == '__main__':
    main()
EOF_RUN

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external rr-test {
		run ./rr-test.run
		encoder json
	}
	internal bgp-rib {
		use bgp-rib
	}
}
bgp {
	peer peer-src {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65000
			}
			router-id 1.2.3.4
			route-reflector-client true
			cluster-id 10.10.10.10
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}

		process rr-test {
		}
		process bgp-rib {
			receive [ state ]
			send [ update ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
reject=stderr:pattern=panic recovered
reject=stderr:pattern=fatal error
reject=stderr:pattern=ZE-OBSERVER-FAIL
