# Test: peer raw sends raw bytes to peer
# VALIDATES: raw command puts the exact bytes it was handed on the wire, judged on
#            a frame ze never sends on its own account
# PREVENTS: raw command handler broken or bytes not reaching peer

# ze-peer expectations
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
# EOR
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
# The injected frame: ROUTE-REFRESH ipv4/unicast, marker(16) + length(0017=23) +
# type(05) + AFI(0001) + reserved(00) + SAFI(01).
#
# It is a ROUTE-REFRESH and not a KEEPALIVE because ze sends a KEEPALIVE of its
# own, byte for byte the same, so the expectation was met whether or not the raw
# command ever reached the wire. ze builds a ROUTE-REFRESH only when a command
# asks for one (reactor/reactor_api.go and reactor_api_forward.go are its only
# producers) and this test asks for none, so the injection is the only thing that
# can satisfy this line.
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170500010001
EOF_PEER

# Native test plugin: exercises dispatch-command for peer raw

# ze bgp configuration
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external raw-test {
		run "ze-test fixture plugin/api-raw"
		encoder json
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		attach process raw-test {
			send [ * ]
		}
	}
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
