# Test: SSH `restart` runs the drain with kind restart and cause in-place
# Exercises: SSH exec `restart` -> the SSH restart function
#            (cmd/ze/hub/service_ssh.go) -> requestRestartStop(in-place) ->
#            stopForRestart -> runStopDrain (cmd/ze/hub/drain.go) with
#            stopDrainInput -> drain-responder's OnDrain.
# VALIDATES: spec-daemon-drain-before-stop AC-7 (SSH restart half): the
#            drain-registered plugin receives kind restart with cause
#            in-place, answers, and the daemon exits 0.
# PREVENTS:  a restart draining as a stop, which would make BGP tag every
#            path graceful-shutdown and send Cease on a restart.

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=20s

expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

tmpfs=ze-bgp.conf:terminator=EOF_CONF
plugin {
	external drain-responder {
		run "le test fixture plugin/drain-responder"
		encoder json
	}
}

system {
	authentication {
		user admin {
			password "$2a$04$UlwuiuH82Unfsq.XEMPGJeDkXwbm3KW.nvVaVXOd/JeFK8VjMjrQO"
		}
	}
}

environment {
	ssh {
		enabled true
		server main {
			ip 127.0.0.1;
			port $PORT2;
		}
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

# The daemon is the last command, so expect=exit asserts the daemon's own exit
# and the runner waits for it. The SSH client runs in the background and polls
# until the daemon's SSH server answers. With the client last, the runner
# stopped the daemon with SIGTERM as soon as the client exited, which aborted
# the restart drain before the plugin could answer.
cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer
cmd=background:seq=2:exec=le test fixture plugin/drain-ssh-restart $PORT2:timeout=30s
cmd=foreground:seq=3:exec=ze start ze-bgp.conf:timeout=30s
expect=exit:code=0
expect=stderr:contains=drain-fixture: sent restart output=restarting daemon error=none
expect=stderr:contains=drain-fixture: drain received kind=restart cause=in-place
expect=stderr:contains=drain-fixture: drain answered
reject=stderr:contains=drain-fixture: FAIL
reject=stderr:contains=drain aborted by signal
