# S=2001:db8::254, N=2001:db8::1 plus fe80::1, P=2001:db8::2.
# Separate namespaces share one real bridge/veth link. The fixture reads back
# address ownership and attachment before starting Ze or either peer.
option=needs-linux:caps=net-admin
option=env:var=ze_test_bgp_port:value=$PORT
option=timeout:value=90s

# Test: a route learned with an RFC 2545 two-address next hop is replayed with
#       BOTH addresses, byte-identical to what the live forward rail relays.
# VALIDATES: RFC 2545 Section 3 -- "A BGP speaker shall advertise to its peer in
#            the Network Address of Next Hop field the global IPv6 address of the
#            next hop, potentially followed by the link-local IPv6 address of the
#            next hop", with the Length octet set to 32 when both are present.
#            The store keeps the WHOLE field and buildRelayUpdate writes it back.
# PREVENTS: the truncation this replaces. MPReachWire.NextHop returns one
#           netip.Addr and keeps the first 16 octets, so the Adj-RIB-In stored the
#           global address alone. RFC 2545's own pitfall list names the
#           consequence: a speaker holding only the global address cannot rebuild
#           form 2. The replayed copy went out with 16 octets and a Length of 16
#           while the live forward of the same route relayed the source's 32, so
#           the two rails put different bytes on the wire and a peer that took the
#           replayed copy lost the link-local next hop it resolves on its own link.
#
# RFC requirement: RFC2545-3-1 positive -- the destination receives
# 20010DB8000000000000000000000001FE800000000000000000000000000001, the global
# address followed by the link-local address, asserted as exact wire hex on a
# running daemon (Section 3).
# RFC requirement: RFC2545-3-2 positive -- the Length of Next Hop Network Address
# octet reads 0x20 on both arrivals, which is the value Section 3 requires when a
# link-local address is included.
#
# NON-VACUITY (ai/rules/interop-and-goal-validation.md). The destination receives
# the route TWICE and each arrival has its own owner:
#   seq=1 -- the LIVE forward, the control. It proves the session, the negotiated
#            family and the egress transform are real, and it is the rail the
#            replay must match.
#   seq=2 -- the REPLAY, the subject. It is reconstructed from the STORED bytes,
#            so it is the only one of the two that can carry a truncated field.
# The mandatory RIB is not granted peer events or output here, so it cannot
# provide a local-table replay. Adj-rib-in receives `state` for the SOURCE only,
# so its own peer-up replay never fires for the destination. The observer's
# explicit `request bgp adj-rib-in replay` owns the second copy.
#
# WHY THE TWO ARRIVALS MUST BE IDENTICAL. No next-hop mode rewrites the field.
# The configured common IPv6 link satisfies the joint egress scope predicate.
# Both live forwarding and replay must preserve the same complete pair.

# ---------------------------------------------------------------------------
# Source peer -- eBGP, AS 65001, on 2001:db8::1, ipv6/unicast.
# ---------------------------------------------------------------------------
tmpfs=source.peer:terminator=EOF_SOURCE
option=tcp_connections:value=1
option=asn:value=65001
option=bind:value=2001:db8::1
# The source must outlive the destination's assertions: if it closes, ze
# withdraws its routes and the destination receives a withdrawal it has no rule
# for.
option=linger:value=true

# seq=1 -- ze's initial-sync End-of-RIB for ipv6/unicast. RFC 4724 Section 2 makes
# a non-IPv4-unicast marker an UPDATE whose only attribute is an empty
# MP_UNREACH_NLRI: flags 0x90 (optional, extended length), code 0x0F, length 3,
# then AFI 2 and SAFI 1. The observer holds wait_peer_eor_sent() before it injects
# the seq=2 marker, so this is an ordering assertion, not a race.
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF001E0200000007900F0003000201

# seq=2 -- BARRIER, not an assertion. The observer injects 2001:db8:ffff::/48 to
# THIS peer only, and only once BOTH sessions are established. Without it the
# source's announcement below can arrive while the destination is not yet a
# forward target, and the destination then sees the replay alone, so its seq=1
# control is lost.
expect=bgp:conn=1:seq=2:contains=3020010DB8FFFF

# seq=3 -- announce 2001:db8:1::/48 with an RFC 2545 form-2 next hop.
#   ORIGIN:   40010100                      IGP
#   AS_PATH:  40020602010000FDE9            AS_SEQUENCE[65001], 4-byte ASNs
#   MP_REACH: 800E2C                        optional, code 14, 44 octets of value
#             0002 01                       AFI 2 (IPv6), SAFI 1 (unicast)
#             20                            Next Hop Network Address length 32
#             20010DB8...0001               global 2001:db8::1
#             FE800000...0001               link-local fe80::1
#             00                            Reserved
#             3020010DB80001                NLRI 2001:db8:1::/48
# attr len = 4+9+47 = 60 = 0x3C; total = 19+2+2+60 = 83 = 0x53.
action=send:conn=1:seq=3:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0053020000003C4001010040020602010000FDE9800E2C0002012020010DB8000000000000000000000001FE800000000000000000000000000001003020010DB80001
EOF_SOURCE

# ---------------------------------------------------------------------------
# Destination peer -- eBGP, AS 65002, on 2001:db8::2, ipv6/unicast.
# ---------------------------------------------------------------------------
# Both arrivals carry the SAME bytes. RFC 4271 Section 5.1.2 prepends ze's own AS
# 65000 (0xFDE8) towards an external peer; ORIGIN and the whole MP_REACH next-hop
# field are relayed unchanged.
#   AS_PATH:  40020A02020000FDE80000FDE9    AS_SEQUENCE[65000, 65001]
# attr len = 4+13+47 = 64 = 0x40; total = 19+2+2+64 = 87 = 0x57.
tmpfs=dest.peer:terminator=EOF_DEST
option=tcp_connections:value=1
option=asn:value=65002
option=bind:value=2001:db8::2
option=linger:value=true
option=established-file:path=destination.up

# seq=1 CONTROL -- the LIVE forward.
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF005702000000404001010040020A02020000FDE80000FDE9800E2C0002012020010DB8000000000000000000000001FE800000000000000000000000000001003020010DB80001
# seq=2 SUBJECT -- the REPLAY, reconstructed from the stored route. The store is
# the only place the link-local half can be lost, so this line is the assertion.
expect=bgp:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF005702000000404001010040020A02020000FDE80000FDE9800E2C0002012020010DB8000000000000000000000001FE800000000000000000000000000001003020010DB80001
EOF_DEST

# ---------------------------------------------------------------------------
# Observer: sequences the run and drives the replay.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# ze -- AS 65000, two external IPv6 peers on one real common link.
# ---------------------------------------------------------------------------
# The mandatory RIB has no peer grants here, preventing a second delivery path.
# Adj-rib-in receives `update-received state` on the SOURCE only, so it stores
# that peer's routes and never sees the destination come up.
tmpfs=ze.conf:terminator=EOF_CONF
plugin {
	internal rs {
		use bgp-rs
	}
	external replay-nh2545 {
		run "le test fixture plugin/adj-rib-in-replay-rfc2545-next-hop"
		encoder json
	}
	internal adj-rib-in {
		use bgp-adj-rib-in
	}
}

bgp {
	peer source-peer {
		connection {
			remote {
				ip 2001:db8::1
			}
			local {
				ip 2001:db8::254
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			next-hop unchanged
			family {
				ipv6/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}

		attach process replay-nh2545 {
			send [ update ]
		}
		attach process adj-rib-in {
			receive [ update-received state ]
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
	}

	peer dest-peer {
		connection {
			remote {
				ip 2001:db8::2
			}
			local {
				ip 2001:db8::254
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65002
			}
			router-id 1.2.3.4
			next-hop unchanged
			family {
				ipv6/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		# The replay puts an UPDATE on this peer's wire, so this peer must grant
		# adj-rib-in the permission to originate one (maySend,
		# internal/component/bgp/reactor/send_permission.go). Send only, and no
		# receive list: the NON-VACUITY note rests on adj-rib-in never being fed
		# `state` for a destination, so its own peer-up self-replay stays silent.
		attach process adj-rib-in {
			send [ update ]
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
	}
}
EOF_CONF

cmd=foreground:seq=1:exec=le test fixture plugin/rfc2545-joint-subnet case replay netns zerp$PORT peer router dest.peer peer-after destination.up far source.peer run ze start ze.conf:timeout=90s
expect=exit:code=0
expect=stderr:contains=TOPOLOGY-PASSED: replay distinct S/P/N address owners and veth attachments
expect=stderr:contains=WIRE-PASSED: recipient subject and completion fence; both peers held open
reject=stdout:pattern=ZE-PEER-REJECTED
reject=stderr:pattern=panic
reject=stderr:pattern=fatal error
reject=stderr:pattern=ZE-OBSERVER-FAIL
