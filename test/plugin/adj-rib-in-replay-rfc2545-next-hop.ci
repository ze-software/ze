# Test: a route learned with an RFC 2545 two-address next hop is replayed with
#       BOTH addresses, byte-identical to what the live forward rail relays.
# VALIDATES: RFC 2545 Section 3 -- "A BGP speaker shall advertise to its peer in
#            the Network Address of Next Hop field the global IPv6 address of the
#            next hop, potentially followed by the link-local IPv6 address of the
#            next hop", with the Length octet set to 32 when both are present.
#            The store keeps the WHOLE field and buildRelayUpdate writes it back.
# PREVENTS: the truncation this replaces. MPReachWire.NextHop returns one
#           netip.Addr and keeps the first 16 octets, so the Adj-RIB-In stored the
#           global address alone. RFC 2545's own pitfall list names the
#           consequence: a speaker holding only the global address cannot rebuild
#           form 2. The replayed copy went out with 16 octets and a Length of 16
#           while the live forward of the same route relayed the source's 32, so
#           the two rails put different bytes on the wire and a peer that took the
#           replayed copy lost the link-local next hop it resolves on its own link.
#
# RFC requirement: RFC2545-3-1 positive -- the destination receives
# 20010DB8000000000000000000000001FE800000000000000000000000000001, the global
# address followed by the link-local address, asserted as exact wire hex on a
# running daemon (Section 3).
# RFC requirement: RFC2545-3-2 positive -- the Length of Next Hop Network Address
# octet reads 0x20 on both arrivals, which is the value Section 3 requires when a
# link-local address is included.
#
# NON-VACUITY (ai/rules/interop-and-goal-validation.md). The destination receives
# the route TWICE and each arrival has its own owner:
#   seq=1 -- the LIVE forward, the control. It proves the session, the negotiated
#            family and the egress transform are real, and it is the rail the
#            replay must match.
#   seq=2 -- the REPLAY, the subject. It is reconstructed from the STORED bytes,
#            so it is the only one of the two that can carry a truncated field.
# Nothing else can produce the second copy: no RIB plugin is loaded, so the
# destination has no local-table delivery path, and adj-rib-in receives `state`
# for the SOURCE peer only, so its own peer-up self-replay never fires for the
# destination. The observer's explicit `request bgp adj-rib-in replay` is the sole
# producer.
#
# WHY THE TWO ARRIVALS MUST BE IDENTICAL. No next-hop mode is configured, so
# applyFactsNextHop takes nhModeNone and returns without touching code 14. The
# live forward therefore relays the source's next-hop field verbatim, and the
# replay's job is to reproduce it. Asserting the same hex twice is the direct
# statement of the one-egress-transform invariant, not a restatement of the code.

# ---------------------------------------------------------------------------
# Source peer -- eBGP, AS 65001, on 127.0.0.1, ipv6/unicast.
# ---------------------------------------------------------------------------
stdin=source:terminator=EOF_SOURCE
option=tcp_connections:value=1
option=timeout:value=40s
# The source must outlive the destination's assertions: if it closes, ze
# withdraws its routes and the destination receives a withdrawal it has no rule
# for.
option=linger:value=true

# seq=1 -- ze's initial-sync End-of-RIB for ipv6/unicast. RFC 4724 Section 2 makes
# a non-IPv4-unicast marker an UPDATE whose only attribute is an empty
# MP_UNREACH_NLRI: flags 0x90 (optional, extended length), code 0x0F, length 3,
# then AFI 2 and SAFI 1. The observer holds wait_peer_eor_sent() before it injects
# the seq=2 marker, so this is an ordering assertion, not a race.
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF001E0200000007900F0003000201

# seq=2 -- BARRIER, not an assertion. The observer injects 2001:db8:ffff::/48 to
# THIS peer only, and only once BOTH sessions are established. Without it the
# source's announcement below can arrive while the destination is not yet a
# forward target, and the destination then sees the replay alone, so its seq=1
# control is lost.
expect=bgp:conn=1:seq=2:contains=3020010DB8FFFF

# seq=3 -- announce 2001:db8:1::/48 with an RFC 2545 form-2 next hop.
#   ORIGIN:   40010100                      IGP
#   AS_PATH:  40020602010000FDE9            AS_SEQUENCE[65001], 4-byte ASNs
#   MP_REACH: 800E2C                        optional, code 14, 44 octets of value
#             0002 01                       AFI 2 (IPv6), SAFI 1 (unicast)
#             20                            Next Hop Network Address length 32
#             20010DB8...0001               global 2001:db8::1
#             FE800000...0001               link-local fe80::1
#             00                            Reserved
#             3020010DB80001                NLRI 2001:db8:1::/48
# attr len = 4+9+47 = 60 = 0x3C; total = 19+2+2+60 = 83 = 0x53.
action=send:conn=1:seq=3:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0053020000003C4001010040020602010000FDE9800E2C0002012020010DB8000000000000000000000001FE800000000000000000000000000001003020010DB80001
EOF_SOURCE

# ---------------------------------------------------------------------------
# Destination peer -- eBGP, AS 65002, on 127.0.0.2, ipv6/unicast.
# ---------------------------------------------------------------------------
# Both arrivals carry the SAME bytes. RFC 4271 Section 5.1.2 prepends ze's own AS
# 65000 (0xFDE8) towards an external peer; ORIGIN and the whole MP_REACH next-hop
# field are relayed unchanged.
#   AS_PATH:  40020A02020000FDE80000FDE9    AS_SEQUENCE[65000, 65001]
# attr len = 4+13+47 = 64 = 0x40; total = 19+2+2+64 = 87 = 0x57.
stdin=dest:terminator=EOF_DEST
option=tcp_connections:value=1
option=timeout:value=40s
option=bind:value=127.0.0.2

# seq=1 CONTROL -- the LIVE forward.
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF005702000000404001010040020A02020000FDE80000FDE9800E2C0002012020010DB8000000000000000000000001FE800000000000000000000000000001003020010DB80001
# seq=2 SUBJECT -- the REPLAY, reconstructed from the stored route. The store is
# the only place the link-local half can be lost, so this line is the assertion.
expect=bgp:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF005702000000404001010040020A02020000FDE80000FDE9800E2C0002012020010DB8000000000000000000000001FE800000000000000000000000000001003020010DB80001
EOF_DEST

# ---------------------------------------------------------------------------
# Observer: sequences the run and drives the replay.
# ---------------------------------------------------------------------------
tmpfs=replay-nh2545.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
"""Replay an IPv6 route whose next hop carries the RFC 2545 link-local half."""
import sys

from ze_api import API, dispatch, result_json_data, runtime_fail

SOURCE = '127.0.0.1'
DEST = '127.0.0.2'


def dest_updates(api, peer):
    """Real UPDATEs written to a peer, End-of-RIB markers excluded.

    updates-sent counts EVERY UPDATE written to the peer, the initial-sync EoR
    included (IncrUpdatesSent in reactor/reactor_notify.go sees only the message
    type). eor-sent is the separate marker counter, so the difference is the
    route traffic this test is about.
    """
    return api.peer_counter('updates-sent', peer=peer) - api.peer_counter('eor-sent', peer=peer)


def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()

    # Every poll carries an EXPLICIT budget and they sum inside the 40s envelope,
    # so a starved daemon reports the barrier that failed rather than an opaque
    # timeout.

    # Both sessions up BEFORE the source announces, so the destination's seq=1
    # control is the live rail's message.
    if not api.wait_peers_established(expected_peers=2, attempts=40):
        runtime_fail('the two peers did not establish')

    # The source asserts ze's EOR frame at its seq=1. Hold that barrier before
    # injecting, or the marker can overtake the EOR.
    if not api.wait_peer_eor_sent(peer=SOURCE, attempts=20):
        runtime_fail('ze never sent its initial-sync EOR to the source peer')

    # Release the source's announcement. This route goes to the SOURCE only; its
    # NLRI (2001:db8:ffff::/48 -> 30 2001 0DB8 FFFF) is the source's seq=2 barrier.
    api.send(f'peer {SOURCE} update text origin igp nhop 2001:db8:ffff::1 '
             'nlri ipv6/unicast add 2001:db8:ffff::/48')

    # quiesce FIRST so each poll behind it is a safety net rather than the
    # mechanism.
    api.quiesce()

    # The route must be STORED before a replay can carry it.
    status = api.dispatch_until(
        'show bgp adj-rib-in status',
        lambda r: result_json_data(r, {}).get('total-routes', 0) > 0,
        attempts=20,
    )
    if result_json_data(status, {}).get('total-routes', 0) <= 0:
        runtime_fail('adj-rib-in stored no route from the source peer')

    # ... and the LIVE forward must have landed at the destination, so its seq=1
    # control is consumed before the replay arrives. Without this the two
    # identical messages could be matched in either order and seq=2 would no
    # longer name the replay.
    if not api.wait_until(lambda: dest_updates(api, DEST) >= 1, attempts=20):
        runtime_fail(f'{DEST} was never sent the live forward of the source route')
    print('OK: the destination was sent the live forward', file=sys.stderr)

    # THE SUBJECT. Two args only, so the cut is UNBOUNDED (rib_commands.go
    # replayCommand: presence of a third arg is what bounds it). A bounded cut
    # would exclude this route -- it was ingested after the destination became a
    # forward target -- and the replay would be a correct no-op.
    result = dispatch(api, f'request bgp adj-rib-in replay {DEST} 0')
    if result.get('status') != 'done':
        runtime_fail(f'replay dispatch to {DEST} failed: {result}')
    replayed = result_json_data(result, {}).get('replayed', 0)
    if replayed < 1:
        runtime_fail(f'replay to {DEST} selected no route to relay: {result}')
    print(f'OK: replay to {DEST} selected {replayed} route(s)', file=sys.stderr)

    # Hold the daemon up until the relayed copy has actually been written. This is
    # also the assertion that makes a dead or refusing RelayStoredRoute fail HERE
    # rather than at the outer timeout: `replayed` above counts what the PLUGIN
    # selected, which stays 1 even when the engine relays nothing.
    if not api.wait_until(lambda: dest_updates(api, DEST) >= 2, attempts=24):
        runtime_fail(f'{DEST} was never sent the relayed copy of the stored route')
    print('OK: the destination was sent the relayed copy', file=sys.stderr)

    api.dispatch('request shutdown')
    api.wait_for_shutdown()


if __name__ == '__main__':
    main()
EOF_RUN

# ---------------------------------------------------------------------------
# ze -- AS 65000, two external peers on separate loopbacks.
# ---------------------------------------------------------------------------
# No RIB plugin is loaded on purpose: bgp-rib would give the destination a second
# delivery path for the same prefix out of a local table, and seq=2 would stop
# naming the relay. adj-rib-in is given `update-received state` on the SOURCE peer
# only, so it stores that peer's routes and never sees the destination come up.
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	internal rs {
		use bgp-rs
	}
	external replay-nh2545 {
		run ./replay-nh2545.run
		encoder json
	}
	internal adj-rib-in {
		use bgp-adj-rib-in
	}
}

bgp {
	peer source-peer {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv6/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}

		attach process replay-nh2545 {
			send [ update ]
		}
		attach process adj-rib-in {
			receive [ update-received state ]
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
	}

	peer dest-peer {
		connection {
			remote {
				ip 127.0.0.2
			}
			local {
				ip 127.0.0.2
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65002
			}
			router-id 1.2.3.4
			family {
				ipv6/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		# The replay puts an UPDATE on this peer's wire, so this peer must grant
		# adj-rib-in the permission to originate one (maySend,
		# internal/component/bgp/reactor/send_permission.go). Send only, and no
		# receive list: the NON-VACUITY note rests on adj-rib-in never being fed
		# `state` for a destination, so its own peer-up self-replay stays silent.
		attach process adj-rib-in {
			send [ update ]
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=source
cmd=background:seq=2:exec=ze-peer --bind 127.0.0.2 --port $PORT:stdin=dest
cmd=foreground:seq=3:exec=ze -:stdin=ze-bgp:timeout=40s
expect=exit:code=0
reject=stderr:pattern=panic
reject=stderr:pattern=fatal error
reject=stderr:pattern=ZE-OBSERVER-FAIL
