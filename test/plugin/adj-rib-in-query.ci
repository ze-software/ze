# Test: adj-rib-in plugin stores received routes queryable via API
# VALIDATES: routes received from peer stored in adj-rib-in, queryable via rib routes
# PREVENTS: adj-rib-in not storing received routes or query returning empty

# ze-peer expectations
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
option=update:value=send-default-route
# EOR from ze
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# Python test plugin: waits for route from peer, then queries adj-rib-in
tmpfs=adj-rib-query-test.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
import json
import sys
import time
from ze_api import API, result_json_data

def dispatch(api, command):
    resp = api._call_engine(
        'ze-plugin-engine:dispatch-command', {'command': command})
    if resp is None:
        return {'status': 'error', 'data': 'engine call returned None'}
    return resp.get('result', {})

def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()

    # Wait for the inbound route to land in adj-rib-in before querying.
    # // test-relax: blind 2.0s sleep -> dispatch_until poll on adj-rib-in
    # status (outbound quiesce cannot wait on an inbound route).
    api.dispatch_until(
        'show bgp adj-rib-in status',
        lambda r: result_json_data(r, {}).get('total-routes', 0) >= 1,
    )

    # The inbound route above proves the session reached Established. Quiesce so
    # ze's End-of-RIB reaches the wire before `request shutdown` closes the
    # session, making the peer's EOR expectation reachable instead of a race:
    # PendingSync stays set from establishment (peer_run.go sendingInitialRoutes)
    # until after the EOR is sent (peer_initial_sync.go), and the bgp-peer-sync
    # quiescer blocks on exactly that, so this barrier cannot return early.
    api.quiesce()

    try:
        # Query adj-rib-in for received routes
        result = dispatch(api, 'show bgp rib received')
        if result.get('status') != 'done':
            print(f'FAIL: rib show-in status={result.get("status")} data={result.get("data")}', file=sys.stderr)
            sys.exit(1)

        print('OK: adj-rib-in query returned done', file=sys.stderr)
    finally:
        dispatch(api, 'request shutdown')
        api.wait_for_shutdown()

if __name__ == '__main__':
    main()
EOF_RUN

# ze bgp configuration with adj-rib-in plugin
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external adj-rib-query-test {
		run ./adj-rib-query-test.run
		encoder json
	}
	internal bgp-rib {
		use bgp-rib
	}
	internal adj-rib-in {
		use bgp-adj-rib-in
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}

		attach process bgp-rib {
			receive [ update state refresh ]
			send [ update ]
		}
		attach process adj-rib-in {
			receive [ update-received state ]
		}
	}
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
