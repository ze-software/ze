# Test: update cursor protocol dispatches correctly through the engine
# VALIDATES: cursor init, delta, inherit, done all process without error
# PREVENTS: cursor commands rejected by parser or silently dropped

# ze-peer sends a route to ze, then the plugin replays via cursor
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
option=update:value=send-default-route
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# Plugin: send cursor commands and verify they succeed
tmpfs=cursor-test.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
"""Send cursor init, delta, inherit, del, and done commands.

Each send() is synchronous via the YANG RPC. If the engine rejects
any cursor command, _call_engine raises RuntimeError and the test
fails with a non-zero exit.
"""
import sys
from ze_api import API

def dispatch(api, command):
    resp = api._call_engine(
        'ze-plugin-engine:dispatch-command', {'command': command})
    if resp is None:
        return {'status': 'error', 'data': 'engine call returned None'}
    return resp.get('result', {})

def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()

    commands = [
        # Init: full attributes + NLRIs
        'peer * update cursor origin igp as-path [65001 65002] med 100 '
        'local-preference 200 next-hop 10.0.0.1 '
        'nlri ipv4/unicast add 10.0.0.0/24 10.0.1.0/24',
        # Delta: only AS_PATH changed
        'peer * update cursor as-path [65001 65003] '
        'nlri ipv4/unicast add 10.1.0.0/24',
        # Inherit: NLRIs only, all attrs from cursor
        'peer * update cursor nlri ipv4/unicast add 10.2.0.0/24 10.2.1.0/24',
        # Del: remove MED
        'peer * update cursor del med '
        'nlri ipv4/unicast add 10.3.0.0/24',
        # Done: clear cursor state
        'peer * update cursor done',
    ]

    for i, cmd in enumerate(commands):
        try:
            api.send(cmd)
        except RuntimeError as e:
            print(f'FAIL: cursor command {i} rejected: {e}', file=sys.stderr)
            dispatch(api, 'daemon shutdown')
            api.wait_for_shutdown()
            sys.exit(1)

    print(f'OK: all {len(commands)} cursor commands accepted', file=sys.stderr)
    dispatch(api, 'daemon shutdown')
    api.wait_for_shutdown()

if __name__ == '__main__':
    main()
EOF_RUN

# ze bgp configuration
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external cursor-test {
		run ./cursor-test.run
		encoder json
	}
}
bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}

		process cursor-test {
			send [ update ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
expect=stderr:pattern=all 5 cursor commands accepted
