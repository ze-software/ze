# Test: update cursor protocol dispatches correctly through the engine
# VALIDATES: cursor init, delta, inherit, done all process without error
# PREVENTS: cursor commands rejected by parser or silently dropped

# ze-peer sends a route to ze, then the plugin replays via cursor
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
option=update:value=send-default-route
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# Plugin: send cursor commands and verify they succeed

# ze bgp configuration
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external cursor-test {
		run "ze-test fixture plugin/cursor-replay"
		encoder json
	}
}
bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}

		attach process cursor-test {
			send [ update ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
expect=stderr:pattern=all 5 cursor commands accepted
