# Test: IRR prefix-list filter accepts matching routes from mock IRR
# VALIDATES: AC-2 -- UPDATE with prefix in IRR-resolved list accepted
# VALIDATES: AC-3 -- UPDATE with prefix NOT in IRR-resolved list rejected
# VALIDATES: AC-8 -- explicit AS-SET from config used
# VALIDATES: AC-12 -- IPv4 prefixes filtered correctly
# PREVENTS: IRR filter silently drops all routes or accepts all routes
#
# Flow:
# 1. Mock IRR server provides AS-TEST -> 10.0.0.0/24, 10.0.1.0/24, 172.16.0.0/16
# 2. Peer sends UPDATE with NLRI=10.0.0.0/24 (in IRR list -> accept)
# 3. Peer sends UPDATE with NLRI=192.168.0.0/24 (not in IRR list -> reject)
# 4. Observer verifies 1 route accepted in adj-rib-in

option=env:var=ze.log.bgp.filter.irr:value=info

# Source peer sends two routes: one matching, one not
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=20s
# UPDATE 1: 10.0.0.0/24 from AS 65001 (in IRR list -> should be accepted)
# Marker(16) + Len=002F(47) + Type=02 + WdLen=0000 + AttrLen=0014(20)
#   ORIGIN: 40010100 (IGP)
#   AS_PATH: 40020602010000FDE9 (AS_SEQ [65001])
#   NEXT_HOP: 40030401010101
#   NLRI: 180A0000 (10.0.0.0/24)
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002F02000000144001010040020602010000FDE940030401010101180A0000
action=sleep:seq=2:ms=500
# UPDATE 2: 192.168.0.0/24 from AS 65001 (NOT in IRR list -> should be rejected)
# Same attributes, different NLRI: 18C0A800 (192.168.0.0/24)
action=send:conn=1:seq=3:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002F02000000144001010040020602010000FDE94003040101010118C0A800
EOF_PEER

# Observer plugin
tmpfs=test-filter-irr.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
"""Verify IRR filter: matching route accepted, non-matching rejected."""
import sys
import time
from ze_api import API, result_json_data

def dispatch(api, command):
    resp = api._call_engine('ze-plugin-engine:dispatch-command', {'command': command})
    return resp.get('result', {})

def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()

    # Wait for session establishment, IRR query, and route processing.
    time.sleep(8.0)

    result = dispatch(api, 'show adj-rib-in status')
    data = result_json_data(result, {})
    total = data.get('total-routes', -1)

    if total != 1:
        print(f'FAIL: expected 1 accepted route (IRR match), got {total}', file=sys.stderr)
        dispatch(api, 'request shutdown')
        api.wait_for_shutdown()
        sys.exit(1)

    print(f'OK: {total} matching route accepted by IRR filter', file=sys.stderr)
    dispatch(api, 'request shutdown')
    api.wait_for_shutdown()

if __name__ == '__main__':
    main()
EOF_RUN

# ze configuration with mock IRR server and IRR filter
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external test-filter-irr {
		run ./test-filter-irr.run
		encoder json
	}
}
bgp {
	policy {
		irr {
			server 127.0.0.1:$IRR_PORT
			refresh-interval 3600
		}
	}

	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			irr {
				as-set AS-TEST
			}
		}

		filter {
			import [ bgp-filter-irr:65001 ]
		}

		process test-filter-irr {
			receive [ update state ]
		}
	}
}
EOF_CONF

# Start mock IRR server, peer, and ze
cmd=background:seq=1:exec=ze-test irr --port 0:portvar=IRR_PORT
cmd=background:seq=2:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=3:exec=ze --plugin ze.bgp-filter-irr --plugin ze.bgp-adj-rib-in -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
expect=stderr:pattern=irr filter accept
expect=stderr:pattern=irr filter reject
