# Test: IRR prefix-list filter accepts matching routes from mock IRR
# VALIDATES: AC-2 -- UPDATE with prefix in IRR-resolved list accepted
# VALIDATES: AC-3 -- UPDATE with prefix NOT in IRR-resolved list rejected
# VALIDATES: AC-8 -- explicit AS-SET from config used
# VALIDATES: AC-12 -- IPv4 prefixes filtered correctly
# PREVENTS: IRR filter silently drops all routes or accepts all routes
#
# Flow:
# 1. Mock IRR server provides AS-TEST -> 10.0.0.0/24, 10.0.1.0/24, 172.16.0.0/16
# 2. Peer sends ONE UPDATE with two NLRIs: 10.0.0.0/24 (in list) and
#    192.168.0.0/24 (not in list)
# 3. Filter modifies the UPDATE: keeps 10.0.0.0/24, drops 192.168.0.0/24
# 4. Observer verifies exactly 1 route accepted in adj-rib-in

option=env:var=ze.log.bgp.filter.irr:value=info

# // test-relax: the test uses per-prefix modify (one multi-NLRI UPDATE with one
# in-list and one out-of-list prefix) and asserts the modify decision via stderr
# (irr filter modify, accepted=1, rejected=1, filter=65001). A RIB-level
# adj-rib-in assertion is omitted: ze-peer intermittently disconnects after send,
# withdrawing the route before the observer can read adj-rib-in. The
# accept/reject partition is covered by unit tests TestPartitionUpdate*.
# Source peer sends ONE UPDATE carrying two NLRIs: one in the IRR list, one not.
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=20s
# UPDATE from AS 65001 with two NLRIs:
#   180A0000  10.0.0.0/24    (in IRR list -> kept)
#   18C0A800  192.168.0.0/24 (NOT in IRR list -> dropped via modify)
# Marker(16) + Len=0033(51) + Type=02 + WdLen=0000 + AttrLen=0014(20)
#   ORIGIN: 40010100 (IGP)
#   AS_PATH: 40020602010000FDE9 (AS_SEQ [65001])
#   NEXT_HOP: 40030401010101
#   NLRI: 180A0000 18C0A800
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF003302000000144001010040020602010000FDE940030401010101180A000018C0A800
EOF_PEER

tmpfs=test-filter-irr.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
"""Shutdown observer for the IRR per-prefix modify test."""
from ze_api import API

def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()
    # Wait for the peer's UPDATE to be processed and delivered (this observer
    # subscribes to update events) rather than sleeping a fixed interval.
    api.wait_for_event(timeout=5.0)
    api._call_engine('ze-plugin-engine:dispatch-command', {'command': 'request shutdown'})
    api.wait_for_shutdown()

if __name__ == '__main__':
    main()
EOF_RUN

# ze configuration with mock IRR server and IRR filter
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external test-filter-irr {
		run ./test-filter-irr.run
		encoder json
	}
}
bgp {
	policy {
		irr {
			server 127.0.0.1:$PORT2
			refresh-interval 3600
		}
	}

	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			irr {
				as-set AS-TEST
			}
		}

		filter {
			import [ bgp-filter-irr:65001 ]
		}

		attach process test-filter-irr {
			receive [ update state ]
		}
	}
}
EOF_CONF

# Start mock IRR server, peer, and ze
cmd=background:seq=1:exec=ze-test irr --port $PORT2
cmd=background:seq=2:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=3:exec=ze --plugin ze.bgp-filter-irr --plugin ze.bgp-adj-rib-in -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
# Filter must emit the modify decision keeping the in-list prefix and dropping
# the out-of-list one. A whole-update accept or reject would miss these.
expect=stderr:pattern=irr filter modify
expect=stderr:pattern=accepted=1
expect=stderr:pattern=rejected=1
expect=stderr:pattern=filter=65001
