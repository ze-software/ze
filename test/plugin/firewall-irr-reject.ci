# Test: config commit rejects when ASN not cached
# VALIDATES: AC-5 -- verify rejects with actionable error naming the missing ASN
# PREVENTS: config commit silently accepting uncached ASN references
#
# Flow:
# 1. No IRR data fetched (cold cache)
# 2. Config contains source-asn 99999 in a firewall term
# 3. Config verify rejects with error naming AS99999

# This test programs nftables, so it needs CAP_NET_ADMIN, not merely Linux.
# skip-os:value=darwin only hid it from macOS: on an unprivileged Linux host it
# RAN, the firewall plugin died with "firewallnft: list tables: netlink receive:
# operation not permitted" during its stage-3 handshake, the daemon never
# reached the asserted state, and the test hung or failed. Declaring the
# capability turns that into an honest skip naming the runner where it does
# execute (ai/rules/qemu-testing.md).
option=needs-linux:caps=net-admin
# Serialize against every other firewall-irr test. The nftables ruleset is
# NODE-WIDE, and the table names these tests program cannot be varied from a
# .ci: ifaceTableName is the Go constant "ze_irr_iface"
# (internal/component/firewall/plugins/irr/sets.go) and the config-derived names
# collide as ze_wan and ze_lan. Apply
# (internal/plugins/firewall/nft/backend_linux.go) lists the node's tables and
# deletes every ze_* table it is about to program, so one daemon removes a
# sibling's live table and the sibling reads back terms it never wrote. The
# persisted prefix store is shared too: DefaultConfigDir
# (internal/core/paths/paths.go) derives it from the binary path, so every
# daemon in the run opens one database.zefs, and a sibling that fetches AS-TEST
# destroys the cold-cache precondition firewall-irr-cold-cache-recovers asserts
# on its first line. MEASURED 2026-08-22 in one privileged container: run in
# parallel 2 of 12 failed, run serially 12 of 12 pass.
option=exclusive:group=firewall-irr-nft
option=env:var=ze.log.firewall.irr:value=debug
option=timeout:value=20s

tmpfs=firewall-irr-reject.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
"""Verify config commit rejects uncached ASN references."""
import sys
from ze_api import API, runtime_fail

def dispatch(api, command):
    resp = api._call_engine('ze-plugin-engine:dispatch-command', {'command': command})
    if resp is None:
        return {'status': 'error'}
    return resp.get('result', {})

def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()

    # The initial config has source-asn 99999 but no cached data.
    # The firewall-irr plugin should have rejected this at verify time.
    # We verify by checking stderr for the rejection message.
    print('OK: reached observer (verify rejection tested via stderr pattern)', file=sys.stderr)
    dispatch(api, 'request shutdown')
    api.wait_for_shutdown()

if __name__ == '__main__':
    main()
EOF_RUN

stdin=ze-fw:terminator=EOF_CONF
plugin {
	external firewall-irr-reject-test {
		run ./firewall-irr-reject.run
		encoder json
	}
}
firewall {
	backend nft;
	irr {
		server 127.0.0.1:43;
	}
	table wan {
		family inet;
		chain input {
			type filter;
			hook input;
			priority 0;
			policy drop;
			term block-unknown {
				from {
					source-asn 99999;
				}
				then {
					drop;
				}
			}
		}
	}
}
bgp {
	peer peer1 {
		connection {
			remote { ip 127.0.0.1; }
			local { ip 127.0.0.1; accept false; }
		}
		session {
			asn { local 1; remote 1; }
			router-id 1.2.3.4;
			family { ipv4/unicast { prefix { maximum 10000; } } }
		}
	}
}
EOF_CONF

cmd=foreground:seq=1:exec=ze --plugin ze.firewall-irr -:stdin=ze-fw:timeout=20s
expect=exit:code=0
expect=stderr:pattern=no cached prefix data for AS99999
