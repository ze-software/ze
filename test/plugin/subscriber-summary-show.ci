# Test: `show subscriber` returns empty summary on an idle daemon.
#
# VALIDATES: spec-subscriber-session-model AC-7 -- show subscriber summary
#            lists sessions from all access types. On idle daemon: total=0.
#            Proves the CLI handlers, service locator, YANG augment of
#            `show`, and subscriber registry are wired end-to-end.
# PREVENTS:  regression where the subscriber CLI surface comes un-wired.

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# Native observer fixture: plugin/subscriber-summary-show.

stdin=ze-conf:terminator=EOF_CONF
plugin {
	external subscriber-summary-show-test {
		run "ze-test fixture plugin/subscriber-summary-show"
		encoder json
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-conf:timeout=15s
expect=exit:code=0
