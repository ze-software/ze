# Test: a peer that did not negotiate the record shape sees today's frame
#
# Flow:
# 1. Daemon starts with two external plugins on one BGP peer
# 2. answer-plain declares NO wire shape at Stage 3, then dispatches commands
# 3. answer-records declares "record-answers" at Stage 3, then dispatches the
#    same command
# 4. Each plugin asserts the frame it received, on the bytes, not on a decoded
#    payload
#
# The answer shape is negotiated per peer at Stage 3 (declare-capabilities), so
# the two plugins share one daemon, one dispatcher and one command, and differ
# only in what they declared. answer-plain must receive `#<id> ok <json>` on one
# line, with the {status, data} envelope byte for byte; answer-records must
# receive a head, one record line and a terminator. The record line must carry
# the SAME data bytes the plain plugin received, which is what makes the
# negotiation a change of frame and nothing else.
#
# `system version api` is the compared command because its answer is constant
# (handleSystemVersionAPI, internal/component/plugin/server/system.go), so a
# byte comparison across two dispatches is a comparison of the frames rather
# than of two moments in time.
#
# VALIDATES: AC-13 -- a peer that has not negotiated the new shape receives
# `#<id> ok [<json>]` exactly as today.
# PREVENTS: the record shape being emitted unconditionally, which breaks every
# plugin written against the frame that exists today, in the tree and outside it.

# ze-peer expectations: one session so `show bgp peer list` names a real peer.
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=25s
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# Un-negotiated plugin: declares no wire shape, so its answer is one line.
tmpfs=answer-plain.run:mode=755:terminator=EOF_PLAIN
#!/usr/bin/env python3
"""Un-negotiated peer: it names no wire shape, so every answer is one line."""

import os
import sys

from ze_api import API, runtime_fail

# ENVELOPE is the answer frame every plugin written before the record shape
# reads: `#<id> ok ` and one JSON object carrying status then data
# (AppendResult and DispatchCommandOutput, pkg/plugin/rpc).
ENVELOPE = '{"status":"done","data":'
MARKER = "plain-answer.txt"


def answer_data(api, command):
    """Return the data bytes of a one-line answer, or fail loudly."""
    lines = api.dispatch_wire_lines(command)
    if len(lines) != 1:
        runtime_fail(f"{command} answered {len(lines)} lines, want 1: {lines}")
    parts = lines[0].split(" ", 2)
    if len(parts) != 3 or parts[1] != "ok":
        runtime_fail(f"{command} answered an unexpected frame: {lines[0][:120]}")
    tail = parts[2]
    if not tail.startswith(ENVELOPE) or not tail.endswith("}"):
        runtime_fail(f"{command} answer envelope changed: {tail[:120]}")
    return tail[len(ENVELOPE) : -1]


def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    # Stage 3 with no protocol list: this peer names no wire shape.
    api.capability_done()
    api.wait_for_registry()
    api.ready()
    api.wait_for_post_startup(timeout=5.0)

    version = answer_data(api, "system version api")
    peers = answer_data(api, "show bgp peer list")
    if '"peers"' not in peers:
        runtime_fail(f"show bgp peer list lost its envelope: {peers[:120]}")

    print("OK: the un-negotiated peer received today's frame", file=sys.stderr)

    # Hand the answer bytes to the negotiated peer. Written to a temporary name
    # and renamed, so the reader never opens a half-written file.
    with open(MARKER + ".tmp", "w", encoding="utf-8") as handle:
        handle.write(version)
    os.rename(MARKER + ".tmp", MARKER)

    api.wait_for_shutdown()


if __name__ == "__main__":
    main()
EOF_PLAIN

# Negotiated plugin: declares record-answers, so its answer is a sequence.
tmpfs=answer-records.run:mode=755:terminator=EOF_RECORDS
#!/usr/bin/env python3
"""Negotiated peer: it names record-answers, so every answer is a sequence."""

import os
import sys
import time

from ze_api import API, runtime_fail

MARKER = "plain-answer.txt"


def wait_for_plain(timeout=10.0):
    """Return the bytes the un-negotiated peer received for the same command."""
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        if os.path.exists(MARKER):
            with open(MARKER, encoding="utf-8") as handle:
                return handle.read()
        # Poll interval: the other peer writes this file from its own process,
        # and a file appearing has no event to wait on.
        time.sleep(0.1)
    runtime_fail(f"the un-negotiated peer wrote no answer within {timeout}s")
    return ""


def tail_of(line, want_verb="ok"):
    """Return the key=value tail of one answer line."""
    parts = line.split(" ", 2)
    if len(parts) != 3 or parts[1] != want_verb:
        runtime_fail(f"unexpected answer line: {line[:120]}")
    return parts[2]


def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    # Stage 3 naming the wire shape this peer reads.
    api.capability_done(protocol=["record-answers"])
    api.wait_for_registry()
    api.ready()
    api.wait_for_post_startup(timeout=5.0)

    plain = wait_for_plain()

    lines = api.dispatch_wire_lines("system version api")
    if len(lines) != 3:
        runtime_fail(f"answer was {len(lines)} lines, want head, record, terminator: {lines}")

    head = tail_of(lines[0])
    # type=json says the one item carries the whole answer as one document,
    # which is what a payload the handler built whole always was.
    if head != "status=done type=json":
        runtime_fail(f"head was {head!r}, want 'status=done type=json'")

    record = tail_of(lines[1])
    if not record.startswith("item="):
        runtime_fail(f"record line was {record[:120]!r}, want an item=")
    item = record[len("item=") :]
    if item != plain:
        runtime_fail(f"record carries {item[:120]!r}, the plain peer got {plain[:120]!r}")

    terminator = tail_of(lines[2])
    if terminator != "count=1":
        runtime_fail(f"terminator was {terminator!r}, want 'count=1'")

    print("OK: the negotiated peer received the record shape", file=sys.stderr)

    # A negotiated peer reads EVERY dispatch answer as a sequence, so the
    # shutdown goes out the same way. api.dispatch parses the answer as one
    # JSON payload and would fail on the head's key=value tail.
    api.dispatch_wire_lines("request shutdown", timeout=2.0, settle=0.2)
    api.wait_for_shutdown()


if __name__ == "__main__":
    main()
EOF_RECORDS

# ze bgp configuration
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external answer-plain {
		run ./answer-plain.run
		encoder json
	}
	external answer-records {
		run ./answer-records.run
		encoder json
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=25s
expect=exit:code=0
expect=stderr:contains=OK: the un-negotiated peer received today's frame
expect=stderr:contains=OK: the negotiated peer received the record shape
reject=stderr:pattern=ZE-OBSERVER-FAIL
reject=stderr:pattern=panic recovered
