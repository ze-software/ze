# Test: REST config refusals retain schema help and the root set fix
# VALIDATES: AC-8, AC-43 of spec-config-enum-refusal-proposes-valid-values.
# Why not a unit test: only a real daemon proves the listener, candidate editor
# and validation hook deliver the refusal to an authenticated REST client.

option=storage:value=disk
option=timeout:value=30s

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

tmpfs=api-config-enum-refusal.conf:terminator=EOF_CONF
plugin {
    external api-enum-refusal {
        run "le test fixture plugin/api-config-enum-refusal http://127.0.0.1:$PORT2"
        encoder json
    }
}
environment {
    api-server {
        token "secret";
        rest {
            enabled true;
            server main { ip 127.0.0.1; port $PORT2; }
        }
    }
}
bgp {
    router-id 1.2.3.4
    peer peer1 {
        connection {
            remote { ip 127.0.0.1; }
            local { ip 127.0.0.1; accept false; }
        }
        session {
            asn { local 1; remote 1; }
            router-id 1.2.3.4
            family { ipv4/unicast { prefix { maximum 10000; } } }
            capability { graceful-restart disable; }
        }
        behavior { group-updates disable; }
    }
}
EOF_CONF

cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze start api-config-enum-refusal.conf:timeout=30s
expect=exit:code=0
expect=stderr:contains=OK: REST session set refused the list key bogus
expect=stderr:contains=OK: REST session commit refused route-refresh requre
expect=stderr:contains=OK: REST session commit returned both value refusals as indented blocks
expect=key:path=meta/config/api-config-enum-refusal.conf/active:exists=true
expect=key:path=meta/config/api-config-enum-refusal.conf/candidate:absent=true
expect=key:glob=object/*:count=1
expect=key:glob=object/*:not-contains=requre
expect=key:glob=object/*:not-contains=redistribute
