# Test: RIB pipeline filter wiring with actual routes
#
# Flow:
# 1. BGP session establishes, ze-peer sends default route (populates adj-rib-in)
# 2. Config static route populates adj-rib-out via RIB plugin
# 3. Native test fixture dispatches pipeline commands via dispatch-command
# 4. Verifies scope routing, filter keywords, count terminal, and old command rejection
#
# VALIDATES: Pipeline parameters reach rib plugin through full command chain
#   (dispatch-command -> tokenizer -> longest-match -> execute-command -> pipeline).
# PREVENTS: Pipeline args silently dropped, scope keywords ignored, count terminal
#   returning wrong format, old commands still working after removal.

# ze-peer expectations
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
option=linger:value=true
# Default route with a non-self NEXT_HOP.
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002C02000000144001010040020602010000FDE94003040101010100

# ze sends static route + EOR after session setup
# UPDATE: origin=IGP, as-path=[], next-hop=10.0.0.1, local-pref=100, nlri=192.168.1.0/24
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00300200000015400101004002004003040A0000014005040000006418C0A801
# EOR
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# Native test fixture: exercises dispatch-command with pipeline filter args on populated RIB

# ze bgp configuration
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external pipe-test {
		run "ze-test fixture plugin/rib-pipe-filter"
		encoder json
	}
	internal bgp-rib {
		use bgp-rib
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}


		update {
			attribute {
				origin igp
				local-preference 100
				next-hop 10.0.0.1
			}
			nlri {
				ipv4/unicast add 192.168.1.0/24
			}
		}

		attach process bgp-rib {
			receive [ update update-received state refresh ]
			send [ update ]
		}

		attach process pipe-test {
			send [ update ]
		}
	}
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
