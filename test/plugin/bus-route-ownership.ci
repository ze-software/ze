# ExaBGP config for S38 migration verification.
tmpfs=exabgp-s38.conf:terminator=EOF_EXABGP_S38
process k {
	run ./k.py;
	on-exit keep;
}
process w {
	run ./w.py;
	on-exit withdraw;
}
process v4 {
	run ./v4.py;
}
process r {
	run ./r.py;
	respawn false;
}
neighbor 192.0.2.1 {
	router-id 1.1.1.1;
	local-as 65001;
	peer-as 65002;
	api {
		processes [ k w v4 r ];
	}
}
EOF_EXABGP_S38

tmpfs=verify-migrate-s38.py:mode=755:terminator=EOF_MIG_S38
#!/usr/bin/env python3
import os
import re
import subprocess


def endpoint_block(text, name):
    m = re.search(rf"endpoint {re.escape(name)} \{{(.*?)\n\t\}}", text, re.S)
    if not m:
        raise SystemExit(f"endpoint {name} not found in:\n{text}")
    return m.group(1)


def run_migrate(extra_env=None):
    env = dict(os.environ)
    env.pop("exabgp_api_version", None)
    env.pop("EXABGP_API_VERSION", None)
    if extra_env:
        env.update(extra_env)
    out = subprocess.check_output(["ze", "exabgp", "migrate", "exabgp-s38.conf"], text=True, env=env)
    for forbidden in ("--on-exit", "--respawn", "exabgp {", "attach process"):
        if forbidden in out:
            raise SystemExit(f"forbidden token {forbidden!r} in migrated output:\n{out}")
    return out


default_out = run_migrate()
if "on-exit keep" not in endpoint_block(default_out, "k"):
    raise SystemExit(f"default: endpoint k missing on-exit keep:\n{default_out}")
if "on-exit" in endpoint_block(default_out, "w"):
    raise SystemExit(f"default: endpoint w should omit default on-exit withdraw:\n{default_out}")
if "on-exit" in endpoint_block(default_out, "v4"):
    raise SystemExit(f"default: endpoint v4 should omit on-exit under default API version:\n{default_out}")
if "respawn false" not in endpoint_block(default_out, "r"):
    raise SystemExit(f"default: endpoint r missing respawn false:\n{default_out}")

v4_out = run_migrate({"exabgp_api_version": "4"})
if "on-exit keep" not in endpoint_block(v4_out, "k"):
    raise SystemExit(f"v4: endpoint k missing on-exit keep:\n{v4_out}")
if "on-exit keep" not in endpoint_block(v4_out, "v4"):
    raise SystemExit(f"v4: endpoint v4 missing on-exit keep under API v4:\n{v4_out}")
if "on-exit" in endpoint_block(v4_out, "w"):
    raise SystemExit(f"v4: endpoint w should omit explicit on-exit withdraw:\n{v4_out}")
if "respawn false" not in endpoint_block(v4_out, "r"):
    raise SystemExit(f"v4: endpoint r missing respawn false:\n{v4_out}")

print("OK: ze exabgp migrate writes external { on-exit keep; } and respawn false; with no CLI flags")
EOF_MIG_S38

cmd=foreground:seq=1:exec=ze init:stdin=init-answers:exit=0

# --- Run 1: default on-exit withdraw ---
cmd=background:seq=2:name=peer1:exec=le test peer --bind 127.0.0.2 --port $PORT:stdin=edge1-withdraw
cmd=background:seq=3:name=daemon1:exec=ze start run1-withdraw.conf:ready=Ze running.
reject=stderr:pattern=panic

cmd=foreground:seq=4:exec=le test fixture plugin/bus-wait-file b1.ready:exit=0
expect=stdout:contains=OK: marker file b1.ready appeared

cmd=foreground:seq=5:exec=le test fixture daemon/await-answer-all "show bgp rib" 203.0.113.0/24 198.51.100.0/24:exit=0
expect=stdout:contains=OK:

# Stop a -> 198.51.100.0/24 is withdrawn while 203.0.113.0/24 stays from b.
cmd=foreground:seq=6:exec=le test fixture plugin/bus-touch-file a1.exit:exit=0
expect=stdout:contains=OK: wrote marker file a1.exit

cmd=foreground:seq=7:exec=le test fixture daemon/await-answer-all "show warnings | json" doctor-plugin-stopped:exit=0
expect=stdout:contains=OK:

# Wait until edge1 has received the failover + withdrawal (updates-sent == 5: EOR + 2 announces + b failover + 1 withdraw).
cmd=foreground:seq=8:exec=le test fixture daemon/await-answer-all "show bgp peer edge1 detail | json" '"updates-sent": 5':exit=0
expect=stdout:contains=OK:

cmd=foreground:seq=9:exec=ze cli -c "show bgp rib":exit=0
expect=stdout:contains=203.0.113.0/24
reject=stdout:contains=198.51.100.0/24

cmd=stop:seq=10:name=daemon1:signal=term
cmd=stop:seq=11:name=peer1

# --- Run 2: external { on-exit keep; } ---
cmd=background:seq=12:name=peer2:exec=le test peer --bind 127.0.0.2 --port $PORT:stdin=edge1-keep
cmd=background:seq=13:name=daemon2:exec=ze start run2-keep.conf:ready=Ze running.
reject=stderr:pattern=panic

cmd=foreground:seq=14:exec=le test fixture plugin/bus-wait-file a2.ready:exit=0
expect=stdout:contains=OK: marker file a2.ready appeared

cmd=foreground:seq=15:exec=le test fixture daemon/await-answer-all "show bgp rib" 198.51.100.0/24:exit=0
expect=stdout:contains=OK:

cmd=foreground:seq=16:exec=le test fixture plugin/bus-touch-file a2.exit:exit=0
expect=stdout:contains=OK: wrote marker file a2.exit

cmd=foreground:seq=17:exec=le test fixture daemon/await-answer-all "show warnings | json" doctor-plugin-stopped:exit=0
expect=stdout:contains=OK:

# Causal fence: b2 announces sentinel 192.0.2.0/24 after a2 stopped.
cmd=foreground:seq=18:exec=le test fixture plugin/bus-touch-file b2.go:exit=0
expect=stdout:contains=OK: wrote marker file b2.go

cmd=foreground:seq=19:exec=le test fixture plugin/bus-wait-file b2.done:exit=0
expect=stdout:contains=OK: marker file b2.done appeared

cmd=foreground:seq=20:exec=le test fixture daemon/await-answer-all "show bgp rib" 198.51.100.0/24 192.0.2.0/24:exit=0
expect=stdout:contains=OK:

cmd=stop:seq=21:name=daemon2:signal=term
cmd=stop:seq=22:name=peer2

# --- Step 3: ze exabgp migrate output for on-exit / respawn / API v4 ---
cmd=foreground:seq=23:exec=python3 verify-migrate-s38.py:exit=0
expect=stdout:contains=OK: ze exabgp migrate writes external { on-exit keep; } and respawn false; with no CLI flags
