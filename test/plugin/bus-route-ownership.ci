#!/bin/sh
set -eu
le test fixture plugin/bus-wait-file b2.go >/dev/null
printf 'announce route 192.0.2.0/24 next-hop 192.0.2.20\n'
IFS= read -r _
le test fixture plugin/bus-touch-file b2.done >/dev/null
while IFS= read -r _; do
	:
done
EOF_B2

# Run 1 config: default on-exit withdraw, respawn false on a so a stays stopped after exit.
tmpfs=run1-withdraw.conf:terminator=EOF_CONF1
system {
	authentication {
		# bcrypt cost-4 hash of "testpass".
		user admin {
			password "$2a$04$UlwuiuH82Unfsq.XEMPGJeDkXwbm3KW.nvVaVXOd/JeFK8VjMjrQO"
		}
	}
}
environment {
	ssh {
		enabled true
		server main { ip 127.0.0.1; port $PORT2; }
	}
}
bus {
	endpoint bgp-rib { internal bgp-rib; }
	endpoint a {
		external {
			run "ze exabgp plugin ./ep-a1.sh";
			respawn false;
		}
		encoding json;
		receive { from none; }
		send { to [ /bgp/peer/edge1 ]; }
	}
	endpoint b {
		external {
			run "ze exabgp plugin ./ep-b1.sh";
		}
		encoding json;
		receive { from none; }
		send { to [ /bgp/peer/edge1 ]; }
	}
}
bgp {
	router-id 192.0.2.254;
	filter {
		import { final accept; }
		export { final accept; }
	}
	peer edge1 {
		connection {
			remote { ip 127.0.0.2; }
			local { ip 127.0.0.1; accept false; }
		}
		session {
			asn { local 65001; remote 65002; }
			family { ipv4/unicast { prefix { maximum 10000; } } }
			capability { graceful-restart disable; }
		}
		behavior { group-updates disable; }
	}
}
EOF_CONF1

