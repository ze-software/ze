# Test: route ownership withdraws routes of an exited endpoint unless another endpoint still announces the prefix or `external { on-exit keep; }` is set, and `ze exabgp migrate` emits `on-exit`/`respawn` in `external {}`.
# QUESTION: when two external endpoints `a` and `b` both announce `203.0.113.0/24` toward
# `edge1` and `a` alone announces `198.51.100.0/24`, after `a` exits (default `on-exit withdraw`),
# does `edge1` keep `203.0.113.0/24` from `b` while receiving a wire withdrawal for
# `198.51.100.0/24`; when `a` runs with `external { on-exit keep; }` and exits, does `edge1`
# keep `198.51.100.0/24` with no withdrawal; and does `ze exabgp migrate` write `on-exit keep;`
# / `respawn false;` inside `external {}` (with API v4 defaulting unset `on-exit` to `keep`)
# and never emit `--on-exit` or `--respawn` flags in `run`?
# A unit test cannot decide this because the path spans live external process exit,
# `originReceiptStore.endOwnerWithPolicy`, live Loc-RIB re-evaluation across two owners,
# real BGP UPDATE withdrawal / retention on the wire, and `ze exabgp migrate` CLI output.
#
# VALIDATES: spec-explicit-plugin-and-attach-config S38 / AC-41.
# PREVENTS: exited endpoint routes lingering as orphans under default `on-exit withdraw`,
# withdrawing a prefix still owned by a surviving endpoint, breaking `external { on-exit keep; }`,
# or migration leaking retired `--on-exit`/`--respawn` flags onto wrapper `run` lines.

option=timeout:value=120s
option=env:var=ZE_CONFIG_DIR:value=.
option=env:var=XDG_DATA_HOME:value=.
option=env:var=ze.ssh.password:value=testpass

stdin=init-answers:terminator=EOF_INIT
admin
testpass
127.0.0.1
$PORT2
EOF_INIT

# Run 1 peer: receives EOR (seq=1), both announcements 203.0.113.0/24 and 198.51.100.0/24 (seq=2),
# then withdrawal of 198.51.100.0/24 ONLY (seq=3); rejects any withdrawal of 203.0.113.0/24.
stdin=edge1-withdraw:terminator=EOF_PEER1
option=tcp_connections:value=1
option=asn:value=65002
option=open:value=router-id:id=192.0.2.1
option=linger:value=true
option=established-file:path=edge1-r1.up
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
expect=bgp:conn=1:seq=2:announced=18CB0071
expect=bgp:conn=1:seq=2:announced=18C63364
expect=bgp:conn=1:seq=3:announced=18CB0071
expect=bgp:conn=1:seq=3:withdrawn=18C63364
reject=bgp:conn=1:scope=withdrawn:pattern=18CB0071
EOF_PEER1

# Run 2 peer (on-exit keep): receives EOR (seq=1), 198.51.100.0/24 (seq=2),
# rebind announce of 198.51.100.0/24 when a2 exits under on-exit keep (seq=3),
# then sentinel 192.0.2.0/24 announced by b2 after a2 exits (seq=4, causal wire fence);
# rejects any withdrawal of 198.51.100.0/24.
stdin=edge1-keep:terminator=EOF_PEER2
option=tcp_connections:value=1
option=asn:value=65002
option=open:value=router-id:id=192.0.2.1
option=linger:value=true
option=established-file:path=edge1-r2.up
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
expect=bgp:conn=1:seq=2:announced=18C63364
expect=bgp:conn=1:seq=3:announced=18C63364
expect=bgp:conn=1:seq=4:announced=18C00002
reject=bgp:conn=1:scope=withdrawn:pattern=18C63364
EOF_PEER2

tmpfs=ep-a1.sh:mode=755:terminator=EOF_A1
#!/bin/sh
set -eu
le test fixture plugin/bus-wait-file edge1-r1.up >/dev/null
printf 'announce route 203.0.113.0/24 next-hop 192.0.2.10\n'
IFS= read -r _
printf 'announce route 198.51.100.0/24 next-hop 192.0.2.10\n'
IFS= read -r _
le test fixture plugin/bus-touch-file a1.ready >/dev/null
le test fixture plugin/bus-wait-file a1.exit >/dev/null
exit 0
EOF_A1

