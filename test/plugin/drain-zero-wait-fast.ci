# Test: a drain whose every wait is 0 costs the stop no more than its round trip
# Exercises: SIGTERM -> runStopDrain (cmd/ze/hub/drain.go) -> DrainRound.Run
#            (internal/component/plugin/server/drain.go) -> a plugin that
#            answers its drain at once.
# VALIDATES: spec-daemon-drain-before-stop AC-13 (b): "drain finished" logs an
#            elapsed time under 500 ms for a drain-registered plugin that waits
#            for nothing, and the daemon exits 0.
# PREVENTS:  the drain waiting out the plugin's budget, or a fixed delay, when
#            every plugin has already answered.

option=env:var=ze.log.plugin.server:value=info

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=20s

expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000

action=sigterm:conn=1:seq=2
EOF_PEER

tmpfs=ze-bgp.conf:terminator=EOF_CONF
plugin {
	external drain-zero-wait {
		run "le test fixture plugin/drain-zero-wait"
		encoder json
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze start ze-bgp.conf:timeout=20s
expect=exit:code=0
expect=stderr:contains=drain-fixture: drain answered at once
expect=stderr:pattern=drain finished.*plugin=drain-zero-wait elapsed=([0-9.]+(ns|µs|us)|[0-9]ms|[0-9][0-9]ms|[0-4][0-9][0-9]ms)
