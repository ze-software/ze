# FlowSpec plugin test - verify FlowSpec routes via external process API
# Tests a compiled observer sending FlowSpec routes

# ze-peer expectations
stdin=peer:terminator=EOF_PEER
# Route sent by plugin script
cmd=api:conn=1:seq=1:text=peer * update text extended-community [copy-to-nexthop] nhop 1.2.3.4 nlri ipv4/flow add source-ipv4 10.0.0.2/32
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0043020000002C4001010040020040050400000064800E100001850401020304000602200A000002C010080800000000000001
expect=json:conn=1:seq=1:json={"meta":{"version":"1.0.0","format":"ze-bgp"},"message":{"type":"update"},"origin":"igp","local-preference":100,"extended-community":[{"string":"0x0800:000000000001","value":576460752303423489}],"ipv4/flow":[{"action":"add","nlri":{"source":[["10.0.0.2/32/0"]],"next-hop":"1.2.3.4"}}]}
# // the End-of-RIB rule that stood here asserted an ordering the
# product does not define, and named a producer that never ran. Nothing in this
# test sends an EOR: the marker is peer1's OWN initial-sync one
# (reactor/peer_initial_sync.go sendInitialRoutes, one per negotiated family), and
# RFC 4724 Section 2 allows exactly one per family per session, so an explicit
# `update text nlri ipv4/flow eor` could never put a second on the wire. It only
# appeared to work while a static config route rode the initial sync AHEAD of the
# marker; with the plugin as the producer the route necessarily follows it.
# The frame is still proven: the observer takes wait_peer_eor_sent below, which
# reads the eor-sent counter IncrEORSent bumps only after the socket flush, and
# fails the test if the marker never reaches the wire.
EOF_PEER


# ze bgp configuration. The plugin is the ONLY producer of the asserted route.
#
# There used to be a static `update { ... }` here, commented "ensures route is
# sent". It was a crutch: the observer's command was missing the add/del verb the
# grammar requires (route/route.go ErrMissingAddDel) and carried `copy-to-nexthop`,
# which the `update text` parser rejected outright, so the plugin never produced
# anything and the static route satisfied the wire assertions in its place. The
# test's own header says the subject is "FlowSpec routes via external process API",
# and with the crutch present that was never what the bytes proved -- the failure
# only surfaced intermittently, when the observer's exception happened to reach the
# daemon before shutdown.
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external flowspec-process {
		run "ze-test fixture plugin/flowspec-announce"
		encoder json
	}
}
bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/flow { prefix { maximum 10000; } }
			}
		}
		behavior {
			group-updates disable
		}


		# // the static `update { ... }` that stood here is REPLACED, not
		# dropped. It was announcing the very route this test asserts, so the plugin
		# send named in the header was never what the bytes proved -- and could not
		# be, since that command was rejected twice over (missing add/del verb, and
		# an extended community the update-text parser did not accept). Both are
		# fixed in this change, so the plugin now produces the route and the same
		# expect=bgp assertions below prove the API path they were always meant to.
		# Coverage of the static config path is unaffected: test/encode/simple-flow.ci
		# and the other 14 test/encode flow tests exercise it directly.
		attach process flowspec-process {
			send [ update ]
		}
	}
}
EOF_CONF

# Process orchestration
# flowspec plugin auto-loaded because ipv4/flow family is configured
cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=10s
