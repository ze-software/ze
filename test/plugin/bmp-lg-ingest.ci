# Test: BMP receiver ingests routes, visible via show bmp rib
# VALIDATES: AC-1 -- Route Monitoring IPv4 unicast stored under bmpProtocolID
# VALIDATES: AC-10 -- show bmp rib displays BMP routes
#
# Flow:
# 1. ze starts with BMP receiver on $PORT2
# 2. Observer connects TCP, sends Initiation + Peer Up + Route Monitoring
# 3. Plugin queries "show bmp rib" and verifies route is present

option=env:var=ze.log.bgp.bmp:value=info
option=env:var=ze.log.bgp.rib:value=info
option=timeout:value=20s

tmpfs=bmp-ingest.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
"""BMP test client: sends Route Monitoring with IPv4 UPDATE, verifies via show bmp rib."""
import json
import socket
import struct
import sys
import time
from ze_api import API, result_text_data, result_json_data

def bmp_header(msg_type, length):
    return struct.pack('!BIB', 3, length, msg_type)

def bmp_initiation():
    name = b'test-router'
    name_tlv = struct.pack('!HH', 2, len(name)) + name
    return bmp_header(4, 6 + len(name_tlv)) + name_tlv

def bgp_open(asn):
    marker = b'\xff' * 16
    body = struct.pack('!BHHIB', 4, asn, 90, 0x01020304, 0)
    length = 19 + len(body)
    return marker + struct.pack('!HB', length, 1) + body

def bmp_peer_header(peer_as=65001):
    ph = struct.pack('!BB', 0, 0)
    ph += struct.pack('!Q', 0)
    ph += b'\x00' * 10 + b'\xff\xff' + bytes([10, 0, 0, 1])
    ph += struct.pack('!II', peer_as, 0x01020304)
    ph += struct.pack('!II', int(time.time()), 0)
    return ph

def bmp_peer_up():
    ph = bmp_peer_header()
    local_addr = b'\x00' * 10 + b'\xff\xff' + bytes([10, 0, 0, 100])
    ports = struct.pack('!HH', 179, 54321)
    sent_open = bgp_open(65000)
    recv_open = bgp_open(65001)
    payload = ph + local_addr + ports + sent_open + recv_open
    return bmp_header(3, 6 + len(payload)) + payload

def bgp_update_announce(prefix_bytes, prefix_len):
    """Build a BGP UPDATE announcing a single IPv4 prefix with minimal attributes."""
    marker = b'\xff' * 16
    withdrawn_len = struct.pack('!H', 0)
    origin = struct.pack('!BBB', 0x40, 1, 1) + b'\x00'
    as_path = struct.pack('!BBB', 0x40, 2, 0)
    next_hop = struct.pack('!BBB', 0x40, 3, 4) + bytes([10, 0, 0, 100])
    attrs = origin + as_path + next_hop
    attr_len = struct.pack('!H', len(attrs))
    nlri = bytes([prefix_len]) + prefix_bytes
    body = withdrawn_len + attr_len + attrs + nlri
    length = 19 + len(body)
    return marker + struct.pack('!HB', length, 2) + body

def bmp_route_monitoring():
    ph = bmp_peer_header()
    update = bgp_update_announce(bytes([10, 0, 0]), 24)
    payload = ph + update
    return bmp_header(0, 6 + len(payload)) + payload

def dispatch(api, command):
    resp = api._call_engine(
        'ze-plugin-engine:dispatch-command', {'command': command})
    if resp is None:
        return {'status': 'error', 'data': 'engine call returned None'}
    return resp.get('result', {})

def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()

    api.wait_for_post_startup(timeout=5.0)

    sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    sock.connect(('127.0.0.1', $PORT2))
    sock.sendall(bmp_initiation())
    sock.sendall(bmp_peer_up())
    sock.sendall(bmp_route_monitoring())

    # Poll show bmp rib until the injected 10.0.0.0/24 route lands (BMP ingest is
    # async over the raw socket); replaces blind inter-send + settle sleeps.
    result = api.dispatch_until(
        'show bmp rib',
        lambda r: any(
            '10.0.0.0' in rt.get('prefix', '')
            for routes in result_json_data(r, {}).get('adj-rib-in', {}).values()
            for rt in routes
        ),
    )
    data = result_text_data(result, '{}')
    parsed = json.loads(data) if isinstance(data, str) else data
    rib_in = parsed.get('adj-rib-in', {})
    found = False
    for peer, routes in rib_in.items():
        for route in routes:
            if '10.0.0.0' in route.get('prefix', ''):
                found = True
                break

    if not found:
        print(f'FAIL: route 10.0.0.0/24 not found in show bmp rib, got: {data}', file=sys.stderr, flush=True)
        sys.exit(1)

    print('PASS: BMP route 10.0.0.0/24 found in show bmp rib', file=sys.stderr, flush=True)
    sock.close()

    dispatch(api, 'request shutdown')
    api.wait_for_shutdown()

if __name__ == '__main__':
    main()
EOF_RUN

stdin=ze-bgp:terminator=EOF_CONF
environment {
    bmp {
        enabled true;
        server default {
            ip 127.0.0.1;
            port $PORT2;
        }
    }
}
plugin {
    external bmp-ingest {
        run ./bmp-ingest.run;
        encoder json;
    }
}
bgp {
    router-id 1.2.3.5;
    peer test {
        connection {
            remote {
                ip 127.0.0.1
            }
            local {
                ip 127.0.0.1
                accept false
            }
        }
        session {
            asn {
                local 65000;
                remote 65001;
            }
            router-id 1.2.3.5;
            family {
                ipv4/unicast { prefix { maximum 10000; } }
            }
        }
    }
}
EOF_CONF

stdin=peer:terminator=EOF_PEER
EOF_PEER

cmd=background:seq=1:exec=ze-peer --mode sink --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze --plugin ze.bgp-bmp -:stdin=ze-bgp
expect=exit:code=0
expect=stderr:pattern=bmp: receiver listening
expect=stderr:pattern=bmp: session started
expect=stderr:pattern=PASS: BMP route
