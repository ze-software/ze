# AS112 BGP integration (spec-as112-3): healthcheck probe -> watchdog-gated
# update block carrying the four AS112 covering prefixes (H3), community
# no-export, and the mandatory watchdog withdraw marker (H2).
#
# FAKE probe: command "true" (always succeeds), rise=1 for fast UP. This test
# proves the BGP-mechanics composition only (watchdog/community/NLRI wiring for
# AS112's config shape) -- NOT real DNS health, which is proven by spec-as112-2's
# own suite and a separate probe-content test.
#
# AC-1: routes absent at startup (EOR only) because watchdog withdraw=true.
# AC-2: routes announced to the peer once the probe reaches UP.

# ze-peer expectations
stdin=peer:terminator=EOF_PEER
option=timeout:value=15s
# Startup: only EOR expected (both AS112 update blocks have watchdog withdraw=true).
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
# After probe succeeds (rise=1), healthcheck dispatches
# "request bgp watchdog announce as112 med 100". The pool holds 4 entries
# (2 ipv4 covering /24s + 2 ipv6 covering /48s); each is sent as its own
# UPDATE, so all 4 are expected here as one unordered group (pool iteration
# order is not deterministic).
cmd=api:conn=1:seq=2:text=healthcheck probe UP triggers watchdog announce as112 med 100
expect=bgp:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF003E020000002340010100400200400304010203048004040000006440050400000064C00804FFFFFF0118C0AF30
expect=bgp:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF003E020000002340010100400200400304010203048004040000006440050400000064C00804FFFFFF0118C01FC4
expect=bgp:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0052020000003B400101004002008004040000006440050400000064C00804FFFFFF01800E1C000201102001000000000000000000000000000100302620004F8000
expect=bgp:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0052020000003B400101004002008004040000006440050400000064C00804FFFFFF01800E1C00020110200100000000000000000000000000010030200100040112
EOF_PEER

# ze bgp configuration
stdin=ze-bgp:terminator=EOF_CONF
bgp {
	healthcheck {
		probe as112 {
			command "true"
			group as112
			interval 1
			rise 1
			fall 1
			withdraw-on-down true
			up-metric 100
		}
	}
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65533
				remote 65533
			}
			router-id 10.0.0.10
			family {
				ipv4/unicast { prefix { maximum 10000; } }
				ipv6/unicast { prefix { maximum 10000; } }
			}
		}

		# AS112 covering prefixes -- IPv4 (H3). Split by address family
		# because next-hop is family-specific.
		update {
			attribute {
				origin igp
				local-preference 100
				next-hop 1.2.3.4
				community [ no-export ]
			}
			nlri {
				ipv4/unicast add 192.175.48.0/24
				ipv4/unicast add 192.31.196.0/24
			}
			watchdog {
				name as112
				withdraw true
			}
		}
		# AS112 covering prefixes -- IPv6 (H3).
		update {
			attribute {
				origin igp
				local-preference 100
				next-hop 2001::1
				community [ no-export ]
			}
			nlri {
				ipv6/unicast add 2620:4f:8000::/48
				ipv6/unicast add 2001:4:112::/48
			}
			watchdog {
				name as112
				withdraw true
			}
		}
	}
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze --plugin ze.bgp-healthcheck --plugin ze.bgp-watchdog -:stdin=ze-bgp:timeout=15s
