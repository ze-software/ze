# Test: `sysctl list` returns known keys with descriptions.
#
# VALIDATES: AC-6/AC-7 -- sysctl list shows platform-filtered known keys.
# PREVENTS:  Known keys registry not wired to CLI command dispatch.

option=env:var=ze.log.sysctl:value=debug
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s

# ze-peer runs as a sink: only a dial target, asserts nothing. This test is about
# the sysctl plugin's command output; the BGP peer exists so ze has a session.
#
# // the ipv4/unicast EOR this block declared was unreachable BY
# CONSTRUCTION -- the run-script calls `request shutdown` at post-startup, so ze
# closes during the OPEN handshake ("open recv / open sent / connection closed
# before completion") and the EOR is never sent. It could not fail for a real
# reason, only pass vacuously (pre-F1) or hang the verdict (post-F1). Coverage is
# NOT reduced: this test never asserted BGP wire content -- its sysctl assertions
# and expect=exit:code=0 are what it proves. Per
# plan/spec-fixit-redistribute-establishment-stall.md the honest fixes are
# --mode sink (peer is scaffolding, as here) or reaching Established first, which
# would test BGP rather than sysctl.
EOF_PEER

# Native observer fixture: plugin/sysctl-list.

stdin=ze-sysctl:terminator=EOF_CONF
plugin {
	external sysctl-list-test {
		run "ze-test fixture plugin/sysctl-list"
		encoder json
	}
}

sysctl {
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --mode sink --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-sysctl:timeout=15s
expect=exit:code=0
