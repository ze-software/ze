# Test: `sysctl list` returns known keys with descriptions.
#
# VALIDATES: AC-6/AC-7 -- sysctl list shows platform-filtered known keys.
# PREVENTS:  Known keys registry not wired to CLI command dispatch.

option=env:var=ze.log.sysctl:value=debug
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s

# ze-peer runs as a sink: only a dial target, asserts nothing. This test is about
# the sysctl plugin's command output; the BGP peer exists so ze has a session.
#
# // the ipv4/unicast EOR this block declared was unreachable BY
# CONSTRUCTION -- the run-script calls `request shutdown` at post-startup, so ze
# closes during the OPEN handshake ("open recv / open sent / connection closed
# before completion") and the EOR is never sent. It could not fail for a real
# reason, only pass vacuously (pre-F1) or hang the verdict (post-F1). Coverage is
# NOT reduced: this test never asserted BGP wire content -- its sysctl assertions
# and expect=exit:code=0 are what it proves. Per
# plan/spec-fixit-redistribute-establishment-stall.md the honest fixes are
# --mode sink (peer is scaffolding, as here) or reaching Established first, which
# would test BGP rather than sysctl.
EOF_PEER

tmpfs=sysctl-list.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
"""Dispatch `sysctl list` and verify known keys are returned."""

import json
import sys
import time

from ze_api import API, runtime_fail, result_json_data, result_text_data


def dispatch(api, command):
    resp = api._call_engine(
        'ze-plugin-engine:dispatch-command', {'command': command})
    if resp is None:
        return {'status': 'error', 'data': 'engine call returned None'}
    return resp.get('result', {})


def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()
    r = api.dispatch_until_done('show sysctl keys')
    if r is None or r.get('status') != 'done':
        status = r.get('status') if r else 'nil'
        runtime_fail(f'sysctl list: status={status}')

    try:
        keys = result_json_data(r, [])
    except json.JSONDecodeError as exc:
        runtime_fail(f'sysctl list json: {exc}: {result_text_data(r)[:200]}')
        keys = []

    if not isinstance(keys, list) or len(keys) == 0:
        runtime_fail(f'sysctl list: expected non-empty list, got {type(keys).__name__} len={len(keys) if isinstance(keys, list) else "N/A"}')

    # Every entry must have key, description, type fields.
    for entry in keys:
        if not isinstance(entry, dict):
            runtime_fail(f'sysctl list: entry is not dict: {entry}')
        for field in ('key', 'description', 'type'):
            if field not in entry:
                runtime_fail(f'sysctl list: missing field {field} in {entry.get("key", "?")}')

    # At least one forwarding key must be present (registered on all platforms).
    key_names = {e.get('key') for e in keys}
    found_forwarding = any('forwarding' in k for k in key_names)
    if not found_forwarding:
        runtime_fail(f'sysctl list: no forwarding key found in {sorted(key_names)[:5]}')

    # Fire-and-forget: a synchronous dispatch of `request shutdown` races ze's own
    # socket close. When the close wins (routine under load) _call_engine blocks for
    # its 30s TLS read timeout then raises "no response for
    # ze-plugin-engine:dispatch-command", failing a test whose assertions all passed.
    # wait_for_shutdown observes the close itself, which is the real condition.
    api.shutdown_fire_and_forget()
    api.wait_for_shutdown()


if __name__ == '__main__':
    main()
EOF_RUN

stdin=ze-sysctl:terminator=EOF_CONF
plugin {
	external sysctl-list-test {
		run ./sysctl-list.run
		encoder json
	}
}

sysctl {
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --mode sink --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-sysctl:timeout=15s
expect=exit:code=0
