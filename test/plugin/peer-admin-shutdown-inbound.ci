# Test: a peer held down by the shutdown container answers an inbound
# connection with Cease 6/5, Connection Rejected (RFC 4486 Section 4).
#
# VALIDATES: AC-41, the inbound half of the hold, through the real listener.
#            The peer accepts and never connects, so the only connection is the
#            one ze-peer dials, and ze must reject it rather than let the
#            peer back in through its own retry.
# PREVENTS:  a hold that stops only ze's own connect attempts. Without the
#            hold the dialed connection is accepted and ze answers with an
#            OPEN, so the first message ze-peer reads is not the Cease below.
#
# The config hold, enable and disable with a message are
# test/plugin/peer-admin-shutdown.ci.

option=env:var=ze.log.bgp.reactor.peer:value=info
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=20s
# ze sends no OPEN, so the first message it writes is the expectation itself.
option=open:value=inspect-open-message
# NOTIFICATION, Len=0015(21): code 06 (Cease), subcode 05 (Connection Rejected),
# no data.
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0015030605
EOF_PEER

tmpfs=ze-bgp.conf:terminator=EOF_CONF
bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
				connect false
			}
			local {
				ip 127.0.0.1
				accept true
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		shutdown {
			message "maintenance"
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=le test peer --dial 127.0.0.1:$PORT:stdin=peer
cmd=foreground:seq=2:exec=ze start ze-bgp.conf:timeout=20s
expect=stderr:contains=peer held administratively down
reject=stderr:contains=session established
reject=stderr:pattern=panic recovered
reject=stderr:pattern=fatal error
