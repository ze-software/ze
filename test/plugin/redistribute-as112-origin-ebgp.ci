# Test: redistribute-as112-origin-ebgp -- origin-AS on an eBGP peer prepends the
# local AS. This is the key proof that `origin igp origin-as 112` becomes a real
# locally-originated route (AS_PATH built by the export rule), NOT a verbatim
# as-path: for an eBGP peer (local AS 65001, remote 64500) the AS_PATH is
# [65001, 112] -- the local AS prepended ahead of the origin AS.
#
# VALIDATES: origin-as redistribution on eBGP -> AS_PATH [localAS, originAS];
#            LOCAL_PREF is (correctly) absent on the eBGP UPDATE.
# PREVENTS: origin-as being emitted as a bare AS_PATH [112] to eBGP (which
#           would drop the local AS and misrepresent the route's origin path).

# ze-peer -- eBGP session. asn=64500 so the peer presents the remote AS ze
# expects. The bgp contains= rules match AS_PATH [65001,112] + NEXT_HOP +
# NLRI tail of each v4 covering UPDATE; matching both completes the peer so the
# runner runs the JSON validator over the received UPDATEs.
stdin=peer:terminator=EOF_PEER
option=asn:value=64500
option=tcp_connections:value=1
option=timeout:value=15s
expect=bgp:conn=1:seq=1:contains=40020A02020000FDE9000000704003047F00000218C0AF30
expect=bgp:conn=1:seq=1:contains=40020A02020000FDE9000000704003047F00000218C01FC4
expect=json:conn=1:seq=1:json={"meta":{"version":"1.0.0","format":"ze-bgp"},"message":{"type":"update"},"origin":"igp","as-path":[65001,112],"ipv4/unicast":[{"action":"add","nlri":["192.175.48.0/24"],"next-hop":"127.0.0.2"}]}
expect=json:conn=1:seq=2:json={"meta":{"version":"1.0.0","format":"ze-bgp"},"message":{"type":"update"},"origin":"igp","as-path":[65001,112],"ipv4/unicast":[{"action":"add","nlri":["192.31.196.0/24"],"next-hop":"127.0.0.2"}]}
EOF_PEER

# Python observer plugin: drive `fakeas112 emit add asn 112`, then exit.
tmpfs=as112-ebgp-test.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
from ze_api import API, runtime_fail
from ze_api import result_json_data


def dispatch(api, command):
    return api._call_engine('ze-plugin-engine:dispatch-command', {'command': command}) or {}


def peer_field(api, field, default):
    result = dispatch(api, 'show bgp peer peer1 detail').get('result', {})
    if result.get('status') != 'done':
        return default
    data = result_json_data(result, {})
    return data.get('peers', {}).get('127.0.0.1', {}).get(field, default)


def wait_peer(api, predicate, what, cycles=100):
    for _ in range(cycles):
        if predicate():
            return
        api.wait_for_event(timeout=0.2)
    runtime_fail(f'timeout waiting for {what}')


def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()

    # Deterministic sync (no fixed sleeps): session established + initial EOR
    # sent, then baseline the sent-update counter (EOR counts into it).
    wait_peer(api, lambda: peer_field(api, 'state', '') == 'established',
              'peer1 established')
    wait_peer(api, lambda: peer_field(api, 'eor-sent', 0) >= 1,
              'initial EOR sent')
    base = peer_field(api, 'updates-sent', 0)

    resp = dispatch(api, 'request fakeas112 emit add asn 112')
    result = resp.get('result', {})
    if result.get('status') != 'done':
        runtime_fail(f'request fakeas112 emit failed: {result}')
        return

    # The covering-prefix UPDATE is on the wire once the engine counts it;
    # TCP FIFO delivers it to the peer before the shutdown that follows.
    wait_peer(api, lambda: peer_field(api, 'updates-sent', 0) >= base + 1,
              'covering-prefix UPDATE sent')
    dispatch(api, 'request shutdown')
    api.wait_for_shutdown()


if __name__ == '__main__':
    main()
EOF_RUN

# ze configuration -- eBGP: ze is AS 65001, peer is AS 64500.
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external as112-ebgp-test {
		run ./as112-ebgp-test.run
		encoder json
	}
	internal redistribute-orchestrator {
		use redistribute-orchestrator
	}
	internal fakeas112 {
		use fakeas112
	}
}

redistribute {
	destination bgp {
		import as112 {
			family [ ipv4/unicast ];
		}
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			# Ze's own address on this session, and what `nhop self` puts on the
			# wire. It is deliberately NOT peer1's 127.0.0.1: RFC 4271 Section
			# 5.1.3 forbids a peer its own address as NEXT_HOP, and
			# originatedNextHopIsPeerOwn (reactor/forward_next_hop.go) withholds
			# the route when the two match.
			local {
				ip 127.0.0.2
				accept false
			}
		}
		session {
			asn {
				local 65001
				remote 64500
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		attach process redistribute-orchestrator {
			send [ update ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
reject=stderr:pattern=panic recovered
reject=stderr:pattern=fatal error
