# Test: `show bgp rpki | summary` answers the aggregate half of the bare RPKI
# command, and `show bgp rpki summary` keeps answering unchanged.
#
# VALIDATES: AC-12 and AC-13. The bare `show bgp rpki` payload carries the
#            aggregate counters and the cache server rows as siblings, the
#            plugin-declared `summary` alias selects the aggregates, and the two
#            answers are the same record.
# PREVENTS:  a bare command whose aggregate half is absent, where the alias has
#            nothing to select; and a conversion that changes what the existing
#            `show bgp rpki summary` subcommand answers.
#
# Method: ze runs with one RPKI cache server configured and nothing listening on
# it, so a session exists, carries no data, and is not established. That is the
# state that makes the assertions discriminate: the rows are present in the
# whole answer and MUST be absent from the selected half. A second process,
# `ze cli`, types each form over the SSH exec channel, which is where the daemon
# resolves the pipe chain.
#
# The timeout is DECLARED because this file starts a daemon, waits for an
# internal plugin to reach Stage 5, and launches `ze` several times.
option=timeout:value=60s

tmpfs=run.py:terminator=EOF_PY
"""Start ze with bgp-rpki configured, then type the alias over SSH exec."""

import json
import os
import subprocess

from ze_api import wait_until

SUMMARY_FIELDS = [
    'vrp-count',
    'validation-enabled',
    'sessions-total',
    'sessions-established',
    'sessions-synced',
    'aspa-enabled',
    'aspa-records',
]


def require(condition, message):
    if not condition:
        raise SystemExit(message)


def run(argv, env):
    result = subprocess.run(
        argv, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, env=env, check=False
    )
    return result.returncode, result.stdout, result.stderr


# Nothing listens here. The session is created from the config, so a row exists
# for it, and it never reaches the established state or carries a VRP.
cache_port = 23000 + os.getpid() % 20000

password_hash = subprocess.check_output(['ze', 'passwd'], input='secret\n', text=True).strip()
with open('rpki-pipe.conf', 'w', encoding='utf-8') as fh:
    fh.write('''plugin {
    internal rpki {
        use bgp-rpki
    }
    internal adj-rib-in {
        use bgp-adj-rib-in
    }
}

bgp {
    rpki {
        cache-server 127.0.0.1 {
            port ''' + str(cache_port) + '''
        }
    }
}

system {
    authentication {
        user ci {
            password "''' + password_hash + '''"
            profile [ admin ]
        }
    }
}
''')

daemon_env = os.environ.copy()
daemon_env['ZE_SSH_EPHEMERAL'] = os.path.abspath('ssh.addr')
daemon_env['ZE_READY_FILE'] = os.path.abspath('ready')
daemon_env['ZE_CONFIG_DIR'] = os.getcwd()
# Leave port 179 alone: this suite runs unprivileged and a bind failure there
# takes the daemon down before it writes `ready`.
daemon_env['ze_test_bgp_port'] = str(12000 + os.getpid() % 40000)
daemon = subprocess.Popen(
    ['ze', '-f', 'rpki-pipe.conf'],
    stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, env=daemon_env,
)


def daemon_ready():
    if daemon.poll() is not None:
        out, err = daemon.communicate()
        raise SystemExit('daemon exited early\nstdout:\n' + out + '\nstderr:\n' + err)
    return os.path.exists('ssh.addr') and os.path.exists('ready')


try:
    if not wait_until(daemon_ready, attempts=300, delay=0.1):
        raise SystemExit('daemon did not become ready')

    host, port = open('ssh.addr', encoding='utf-8').read().strip().rsplit(':', 1)
    cli_env = os.environ.copy()
    cli_env.update({
        'ZE_SSH_HOST': host,
        'ZE_SSH_PORT': port,
        'ZE_SSH_USERNAME': 'ci',
        'ZE_SSH_PASSWORD': 'secret',
        'ZE_CONFIG_DIR': os.getcwd(),
    })

    def cli(command):
        code, out, err = run(['ze', 'cli', '-c', command], cli_env)
        require(code == 0, '%s exit=%d: %s%s' % (command, code, out, err))
        return out

    # The plugin answers at all. Without this the assertions below measure an
    # unanswered command rather than a selection over a full one.
    if not wait_until(
        lambda: 'vrp-count' in cli('show bgp rpki | json'), attempts=200, delay=0.1
    ):
        raise SystemExit('`show bgp rpki` never answered')

    whole = json.loads(cli('show bgp rpki | json'))
    for field in SUMMARY_FIELDS:
        require(field in whole, 'the bare answer is missing %s: %r' % (field, whole))
    rows = whole.get('cache-servers')
    require(isinstance(rows, list) and len(rows) == 1,
            'the bare answer carries no cache server row: %r' % whole)
    require(rows[0].get('address') == '127.0.0.1',
            'the cache server row names another address: %r' % rows[0])

    # The alias is the assertion. It selects among the sibling keys, so the
    # aggregates survive and the rows do not.
    half = json.loads(cli('show bgp rpki | summary | json'))
    require(sorted(half) == sorted(SUMMARY_FIELDS),
            '`| summary` answered another field set: %r' % half)
    require('cache-servers' not in half, 'a cache server row survived `| summary`: %r' % half)

    # AC-13. The subcommand is unchanged, and it answers the same record, so the
    # pipe form reproduces it rather than approximating it.
    subcommand = json.loads(cli('show bgp rpki summary | json'))
    require(subcommand == half,
            '`show bgp rpki summary` and `show bgp rpki | summary` disagree: %r vs %r'
            % (subcommand, half))

    # The engine derives an empty declaration for every command the plugin
    # declared below the one the alias sits on, so the name stops there. Without
    # it `| summary` would be offered over a payload that carries none of it.
    code, out, err = run(['ze', 'cli', '-c', 'show bgp rpki status | summary | json'], cli_env)
    require('unknown pipe operator: summary' in (out + err),
            '`| summary` reached a command below the one it sits on: exit=%d %r %r'
            % (code, out, err))

    print('--- show bgp rpki')
    print(cli('show bgp rpki'), end='')
    print('--- show bgp rpki | summary')
    print(cli('show bgp rpki | summary'), end='')
    print('--- show bgp rpki summary')
    print(cli('show bgp rpki summary'), end='')
finally:
    daemon.terminate()
    try:
        daemon.wait(timeout=5)
    except subprocess.TimeoutExpired:
        daemon.kill()
        daemon.wait(timeout=5)

print('OK')
EOF_PY

cmd=foreground:seq=1:exec=python3 run.py
expect=exit:code=0
expect=stdout:contains=OK
