# rs-prepend-control-community -- a route-server client asks the route server to
# prepend its AS toward one other client, and only that client sees the prepend.
#
# VALIDATES: spec-bcp194-1-communities AC-11, AC-12 and AC-14 through the real
# daemon. The source sends the large community 65000:101:65002, the route
# server's existing convention (function 101, one prepend, parameter = the
# client's ASN; RFC 8195 Section 4.2.1 describes the same action as function 6).
#   - receiver-named (AS 65002) gets AS_SEQUENCE[65000, 65001]: the route
#     server's AS prepended once (wireu.CommunityPolicy.RSPrepend).
#   - receiver-other (AS 65003) gets the AS_PATH byte-identical to the one the
#     source sent (RFC 7947 Section 2.2.2.1, the default).
#   - neither receives the LARGE_COMMUNITY: its only value is in the route
#     server's namespace, so it is removed (wireu.StripLargeControlCommunities)
#     and the attribute leaves the UPDATE with it.
#   - the route server counts what it did: one prepend applied, two large
#     control values stripped (one per client), read by the observer.
# One source UPDATE, two clients, two different AS_PATHs, so neither assertion can
# pass by accident, and both are exact byte strings, so a leaked large community
# fails them too.
#
# PREVENTS: CommunityPolicy.PrependCount staying a function only tests call. Until
# this spec nothing on either forward rail read it, so the request was parsed and
# silently ignored.
#
# RAIL: rs-fast-path is ABSENT, so forwarding goes through the bgp-rs plugin into
# reactorAPIAdapter.forwardUpdateCore (bgp-rs-relay-aspath-transparency.ci says
# why). The fast-path rail is covered by TestRSPrependReachesWire/fast-path, and
# rs-control-community-strip.ci drives the fast path through the daemon.

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=3
option=timeout:value=20s
option=bind:value=0.0.0.0
# Bind conn=N by remote IP: the two receivers must be told apart by identity.
option=conn_map:value=remote-ip

# Source peer (conn=1, AS 65001): announce 10.0.0.0/24.
#   ORIGIN:          40010100
#   AS_PATH:         40020602010000FDE9            AS_SEQUENCE[65001], 4-byte ASNs
#   NEXT_HOP:        40030401010101                1.1.1.1
#   LARGE_COMMUNITY: C0200C 0000FDE8 00000065 0000FDEA   65000:101:65002
#   NLRI:            180A0000                      10.0.0.0/24
# attr len = 4+9+7+15 = 35 = 0x23; total = 19+2+2+35+4 = 62 = 0x3E.
# No LOCAL_PREF: see bgp-rs-relay-aspath-transparency.ci for the ATTR_DISCARD marker it
# would pin instead.
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF003E02000000234001010040020602010000FDE940030401010101C0200C0000FDE8000000650000FDEA180A0000

# The source's own EOR. Receivers' EORs are not pinned (bgp-rs-relay-aspath-transparency.ci).
expect=bgp:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000

# receiver-named (conn=2, AS 65002): the route server's AS prepended once.
#   AS_PATH:   40020A02020000FDE80000FDE9   AS_SEQUENCE[65000, 65001]
# attr len = 4+13+7 = 24 = 0x18; total = 19+2+2+24+4 = 51 = 0x33. No LARGE_COMMUNITY.
expect=bgp:conn=2:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF003302000000184001010040020A02020000FDE80000FDE940030401010101180A0000

# receiver-other (conn=3, AS 65003): the AS_PATH as the source sent it.
# attr len = 4+9+7 = 20 = 0x14; total = 19+2+2+20+4 = 47 = 0x2F. No LARGE_COMMUNITY.
expect=bgp:conn=3:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002F02000000144001010040020602010000FDE940030401010101180A0000
EOF_PEER

# Observer: wait until the route server has replayed to every client, then shut down.

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	internal rs {
		use bgp-rs
	}
	internal adj-rib-in {
		use bgp-adj-rib-in
	}
	external shutdown-after-up {
		run "le test fixture plugin/rs-prepend-control-community"
		encoder json
	}
}
# The observer reads ze_bgp_rs_prepend_applied_total (1: one client was
# prepended) and ze_bgp_rs_large_control_community_stripped_total (2: the request
# value left what both clients were written) through `show metrics values`, which
# answers only with Prometheus enabled.
telemetry {
	prometheus {
		enabled true
		server main {
			ip 127.0.0.1;
			port $PORT2;
		}
	}
}
bgp {
	peer source-peer {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			rs-client true
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		attach process adj-rib-in {
			receive [ update-received state ]
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
		attach process shutdown-after-up {
			receive [ update ]
		}
	}
	peer receiver-named {
		connection {
			remote {
				ip 127.0.0.2
			}
			local {
				ip 127.0.0.2
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65002
			}
			router-id 1.2.3.4
			rs-client true
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		attach process adj-rib-in {
			send [ update ]
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
		attach process shutdown-after-up {
			receive [ update ]
		}
	}
	peer receiver-other {
		connection {
			remote {
				ip 127.0.0.3
			}
			local {
				ip 127.0.0.3
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65003
			}
			router-id 1.2.3.4
			rs-client true
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		attach process adj-rib-in {
			send [ update ]
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
		attach process shutdown-after-up {
			receive [ update ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
reject=stderr:pattern=panic
reject=stderr:pattern=fatal error
reject=stderr:pattern=forward-cached failed
reject=stderr:pattern=release-cached failed
