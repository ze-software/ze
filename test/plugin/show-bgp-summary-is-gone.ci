# Test: `show bgp summary` is no longer a command.
#
# VALIDATES: spec-cli-show-bgp-is-the-command AC-4. The `summary` container is
#            gone from ze-peer-cmd.yang and ze-bgp:summary is registered
#            nowhere, so the tokens match `show bgp` and `summary` arrives at
#            handleBgpOverview as an argument. It names no address family, so
#            the operator is told the command is unknown.
# PREVENTS:  R-3. The operator with muscle memory for the retired spelling being
#            told that `summary` is an invalid address family, which is the
#            wrong diagnosis, and the command quietly still working because a
#            registration survived somewhere.

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# Native observer fixture: plugin/show-bgp-summary-is-gone.

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external summary-is-gone {
		run "ze-test fixture plugin/show-bgp-summary-is-gone"
		encoder json
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
