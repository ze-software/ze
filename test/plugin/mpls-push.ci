# MPLS label push: BGP labeled unicast route installed in kernel FIB
# Spec: plan/spec-mpls-1-kernel.md AC-1
#
# TODO: requires Linux with MPLS kernel support
# - peer sends labeled unicast UPDATE with label stack
# - ze installs MPLS route in kernel via netlink
# - verify route appears in kernel MPLS FIB

option=skip-os:value=darwin
# ze-peer expectations
stdin=peer:terminator=EOF_PEER
option=asn:value=65002
option=open:value=add-capability:code=1:hex=00010004
cmd=api:conn=1:seq=1:text=peer * update text origin igp local-preference 100 nhop 10.0.0.2 nlri ipv4/mpls-label label 1000 add 10.1.0.0/24
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF003E02000000274001010040020602010000FDE940050400000064800E10000104040A0000020030003E810A0100
EOF_PEER

# ze bgp configuration
stdin=ze-bgp:terminator=EOF_CONF
bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65001
				remote 65002
			}
			router-id 1.2.3.4
			family {
				ipv4/mpls-label { prefix { maximum 10000; } }
			}
		}
	}
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=10s
