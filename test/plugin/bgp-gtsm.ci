# Test: BGP GTSM / TTL-security (RFC 5082) single-hop config wires and is visible
# VALIDATES: AC-3 -- ttl { max 1 } derives OutTTL=255 and MinTTL=255 on the peer
# VALIDATES: end-to-end story #1 -- enabling single-hop GTSM does not break the session
# PREVENTS: ttl config parsed but never reaching PeerSettings / peer detail
#
# The peer configures `connection { ttl { max 1 } }`. The parser derives
# OutTTL=255 and MinTTL=255 (single-hop GTSM, RFC 5082 255-N+1). This functional
# test proves the config→settings→peer-detail wiring AND that the session forms
# between two conforming GTSM speakers.
#
# ze-peer must therefore run with `--ttl 255`. The socket enforcement is
# linux-only: setIPMinTTL (internal/core/network/ttl_linux.go) really sets
# IP_MINTTL=255, and the kernel then drops every inbound packet below it, while
# the non-Linux stub (ttl_other.go) reports "unsupported" and the option is
# absent. A default-TTL test peer therefore handshakes on macOS and is dropped
# on Linux -- this test passed for the maintainer and hung to its 15s timeout on
# every CI run, with the peer showing OPEN sent and nothing after it. Leaving the
# peer at TTL 64 would also have made the assertion a lie: it would prove GTSM
# lets a NON-conforming peer through, which is the opposite of RFC 5082.

# ze-peer expectations
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# Python test plugin: assert GTSM fields present in peer detail
tmpfs=gtsm-show-test.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
import json
import sys
from ze_api import API

def dispatch(api, command):
    resp = api._call_engine(
        'ze-plugin-engine:dispatch-command', {'command': command})
    if resp is None:
        return {'status': 'error', 'data': 'engine call returned None'}
    return resp.get('result', {})

def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()
    api.wait_for_post_startup(timeout=5.0)

    try:
        result = dispatch(api, 'show bgp peer peer1 detail')
        if result.get('status') != 'done':
            print(f'FAIL: detail status={result.get("status")}', file=sys.stderr)
            sys.exit(1)

        data = result.get('data', {})
        if isinstance(data, str):
            data = json.loads(data)

        peers = data.get('peers', {})
        if '127.0.0.1' not in peers:
            print('FAIL: 127.0.0.1 not in detail response', file=sys.stderr)
            sys.exit(1)

        peer = peers['127.0.0.1']
        out_ttl = peer.get('gtsm-ttl-out')
        min_ttl = peer.get('gtsm-ttl-min')
        if out_ttl != 255:
            print(f'FAIL: gtsm-ttl-out={out_ttl} expected 255', file=sys.stderr)
            sys.exit(1)
        if min_ttl != 255:
            print(f'FAIL: gtsm-ttl-min={min_ttl} expected 255', file=sys.stderr)
            sys.exit(1)

        print(f'OK: GTSM active out={out_ttl} min={min_ttl} state={peer.get("state")}', file=sys.stderr)
    finally:
        dispatch(api, 'request shutdown')
        api.wait_for_shutdown()

if __name__ == '__main__':
    main()
EOF_RUN

# ze bgp configuration with single-hop GTSM
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external gtsm-show-test {
		run ./gtsm-show-test.run
		encoder json
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
			ttl {
				max 1
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}

		process gtsm-show-test {
		}
	}
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=ze-peer --port $PORT --ttl 255:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
expect=stderr:pattern=GTSM active out=255 min=255
