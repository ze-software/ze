# Test: show pki certificate export commands (pem, bundle pem, fingerprint)
# Exercises: dispatch-command -> ze-show:pki-certificate-pem, ze-show:pki-certificate-bundle-pem, ze-show:pki-certificate-fingerprint
# Verifies: PEM output contains certificate header, bundle contains both cert and key, fingerprint is colon-separated hex

# ze-peer: accepts connection
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
option=asn:value=65001
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# Native observer validates PEM, bundle, fingerprint, and CA refusal contracts.

stdin=ze-bgp:terminator=EOF_CONF
pki {
    ca test-ca {
        certificate 
    }
    certificate dev-1 {
        certificate 
        private {
            key MIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQgcB7/8yWgsXMhdewDNNnoIrIm0uflDeXk7p+tYC4A3UqhRANCAAQloGtoqG/Wy9NhTeku4dnMtEOWg5oP0+7hdgNMDEGw2Hf9IYbYp93dd1+Kdn1JqsBmOAAebbQ6jSE9f6WC4fhL
        }
    }
}

plugin {
    external pki-export-show-test {
        run "ze-test fixture plugin/pki-certificate-export-show"
        encoder json
    }
}

bgp {
    peer peer1 {
        connection {
            remote {
                ip 127.0.0.1
            }
            local {
                ip 127.0.0.1
                accept false
            }
        }
        session {
            asn {
                local 65000
                remote 65001
            }
            router-id 1.2.3.4
            family {
                ipv4/unicast {
                    prefix {
                        maximum 10000
                    }
                }
            }
            capability {
                graceful-restart disable
            }
        }
        behavior {
            group-updates disable
        }
    }
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
