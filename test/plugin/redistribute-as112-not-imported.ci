# Test: redistribute-as112-not-imported -- the redistribute orchestrator IS
# running (subscribed to the as112 source) but there is NO `import as112` rule,
# so it drops the emitted route-change for lack of a matching import and nothing
# reaches the peer. Mirrors redistribute-l2tp-not-configured.
#
# The orchestrator MUST be present for this test to exercise the right path:
# without it the emit would be dropped merely because nothing subscribed (a false
# pass that would survive even if the orchestrator leaked un-imported sources).
# With it running and no import rule, the import filter is the code actually under
# test -- the emit flows into the orchestrator, which drops it for lack of a
# matching import. (The .ci harness has no BGP wire-absence assertion -- reject=
# covers only stderr/syslog/stdout and the peer silently accepts unexpected
# UPDATEs -- so, like the sibling redistribute-l2tp-not-configured, the gate is a
# clean exit rather than an explicit "no UPDATE arrived" wire check.)
#
# VALIDATES: with the orchestrator running but no `redistribute { import as112 }`,
#            fakeas112's emit reaches the orchestrator's import filter, which drops
#            it -- ze stays healthy and exits clean.
# PREVENTS: an import-filter regression from being masked by an unsubscribed
#           orchestrator (the false-pass this test previously had).

# ze-peer -- session establishes (the initial-sync EOR is the only expected
# wire message; an empty expectation set would make ze-peer exit with "no test
# data available", leaving no listener and no real session). With a live
# session, the observer's updates-sent counter check below is a REAL absence
# gate: a leaked import would increment the counter and put bytes on the wire.
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=10s
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# Python observer plugin: emit an as112 add, wait, then shut down cleanly.
tmpfs=as112-nocfg-test.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
from ze_api import API, runtime_fail, result_json_data


def dispatch(api, command):
    return api._call_engine('ze-plugin-engine:dispatch-command', {'command': command}) or {}


def peer_field(api, field, default):
    result = dispatch(api, 'show bgp peer peer1 detail').get('result', {})
    if result.get('status') != 'done':
        return default
    data = result_json_data(result, {})
    return data.get('peers', {}).get('127.0.0.1', {}).get(field, default)


def wait_peer(api, predicate, what, cycles=100):
    for _ in range(cycles):
        if predicate():
            return
        api.wait_for_event(timeout=0.2)
    runtime_fail(f'timeout waiting for {what}')


def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()

    # // the first revision of this conversion asserted
    # per-session updates-sent == baseline as a wire-absence gate. That
    # assertion cannot hold in this topology: the peer completes at the
    # initial EOR and exits, the session tears down, and ClearStats
    # (internal/component/bgp/reactor/peer_stats.go:322) zeroes per-session
    # counters, so the observer never reliably sees an established session.
    # The gate stays what the file header documents (clean, healthy exit);
    # the lifetime connections-established wait below replaces the fixed
    # sleep with a deterministic session-came-up proof.
    wait_peer(api,
              lambda: peer_field(api, 'connections-established', 0) >= 1,
              'peer1 session established at least once')

    resp = dispatch(api, 'request fakeas112 emit add asn 112')
    result = resp.get('result', {})
    if result.get('status') != 'done':
        runtime_fail(f'request fakeas112 emit failed: {result}')
        return

    # Bounded observation window (event-wait backoff, no fixed sleep): if the
    # un-imported emit were going to reach the reactor, it would within this
    # window.
    for _ in range(10):
        api.wait_for_event(timeout=0.2)

    dispatch(api, 'request shutdown')
    api.wait_for_shutdown()


if __name__ == '__main__':
    main()
EOF_RUN

# ze configuration -- NO redistribute import as112 block.
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external as112-nocfg-test {
		run ./as112-nocfg-test.run
		encoder json
	}
	# Orchestrator IS running (subscribed to as112) -- so a route reaching the
	# wire could only come from a missing import filter, not a missing subscriber.
	internal redistribute-orchestrator {
		use redistribute-orchestrator
	}
	internal fakeas112 {
		use fakeas112
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65533
				remote 65533
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=10s
expect=exit:code=0
reject=stderr:pattern=panic recovered
reject=stderr:pattern=fatal error
