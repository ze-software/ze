# Test: object-rooted kernel-read commands dispatch through the daemon.
#
# VALIDATES: `show route` (incl. `<cidr>`, `default`, `limit N`), `show neighbor`
# (incl. `ipv4`/`ipv6`), and `show arp` are wired -- each reaches its iface
# handler, never "unknown command". This proves the rename (show ip route ->
# show route, show ip arp -> show neighbor/arp) and the `limit N` keyword
# dispatch correctly.
# PREVENTS: a rename that leaves a command unregistered or a malformed grammar.
#
# Backend-free by design: no `interface {}` block, so the netlink backend is not
# loaded and the live reads return a graceful "no backend loaded" error. Wiring
# is the assertion, so this is deterministic on every OS -- no QEMU needed.
# Invalid args (bad family, non-numeric limit) are rejected upstream by the YANG
# ArgDef validator before these handlers, so they are not exercised here.

tmpfs=iface-kernel-read.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
"""Assert show route/neighbor/arp dispatch (wiring) through the daemon."""

# // authored this session, never previously green. The first draft
# asserted handler-level errors (unknown family, --limit, invalid limit) and
# case-insensitivity; running it showed the YANG ArgDef dispatcher rejects bad
# family/limit values upstream (case-sensitively) before these handlers, and
# that dispatching an ArgDef-invalid command raises plugin-side. Rewritten to
# assert wiring of the valid object-rooted commands; the negative paths are the
# framework's ArgDef contract, not these handlers'.

import sys

from ze_api import API, runtime_fail, result_text_data


def dispatch(api, command):
    resp = api._call_engine(
        'ze-plugin-engine:dispatch-command', {'command': command})
    if resp is None:
        return {'status': 'error', 'data': 'engine call returned None'}
    return resp.get('result', {})


def assert_wired(api, command):
    # Reaches its handler: status done (backend present) or a graceful handler
    # error, but never "unknown command" (which means unregistered).
    result = dispatch(api, command)
    msg = result_text_data(result, '')
    if result.get('status') != 'done' and 'unknown command' in msg.lower():
        runtime_fail(f"{command}: not wired -- {msg[:160]}")


def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()
    api.wait_for_post_startup(timeout=5.0)

    try:
        for cmd in (
            'show route',
            'show route 10.0.0.0/8',
            'show route default',
            'show route limit 5',
            'show neighbor',
            'show neighbor ipv4',
            'show neighbor ipv6',
            'show arp',
        ):
            assert_wired(api, cmd)

        print('OK iface kernel-read dispatch verified', file=sys.stderr)
    finally:
        dispatch(api, 'request shutdown')
        api.wait_for_shutdown()


if __name__ == '__main__':
    main()
EOF_RUN

stdin=ze-conf:terminator=EOF_CONF
plugin {
	external iface-kernel-read-test {
		run ./iface-kernel-read.run
		encoder json
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65000
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

cmd=foreground:seq=1:exec=ze -:stdin=ze-conf:timeout=15s
expect=exit:code=0
expect=stderr:contains=OK iface kernel-read dispatch verified
reject=stderr:pattern=panic
reject=stderr:pattern=fatal error
