# Test: the peer-to-process delivery graph the config produces is inspectable
#       from outside the daemon.
# Exercises: config load -> Reactor.publishDeliveryGraphLocked -> the plugin
#            server's index -> dispatch-command -> ze-show:event-delivery ->
#            handleShowEventDelivery.
# VALIDATES: the index names exactly the processes each peer attaches, with the
#            direction each token grants, and names no process for a peer that
#            attaches none. An index nobody can see is an index nobody can debug.
# PREVENTS: the index being built and reaching no surface, which is how the
#           defect this spec fixes survived: the config surface stayed while
#           nothing read it.

# ze-peer: accepts one connection from peer1.
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
option=asn:value=65001
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER


stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external delivery-graph-test {
		run "ze-test fixture plugin/attach-process-delivery-graph"
		encoder json
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		attach process delivery-graph-test {
			receive [ state ]
		}
	}

	peer peer2 {
		connection {
			remote {
				ip 192.0.2.9
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65002
			}
			router-id 1.2.3.4
			capability {
				graceful-restart disable
			}
		}
		attach process delivery-graph-test {
			send [ update ]
		}
	}

	peer peer3 {
		connection {
			remote {
				ip 192.0.2.10
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65003
			}
			router-id 1.2.3.4
			capability {
				graceful-restart disable
			}
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
