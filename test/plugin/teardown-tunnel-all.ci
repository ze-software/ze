# Test: `l2tp tunnel teardown-all` fans a StopCCN at every tunnel
#       and the subsystem snapshot reports zero active tunnels.
#
# VALIDATES: spec-l2tp-7 AC-23 -- mass teardown iterates every
#            reactor, tearing down every tunnel and returning the
#            total in `tunnels-cleared`.
# PREVENTS:  regression where teardown-all clears only the first
#            tunnel (early return on first success), or where the
#            counter lies.

option=env:var=ze.l2tp.skip-kernel-probe:value=true
option=env:var=TEST_SECRET:value=teardown-all-secret
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=25s
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER



stdin=ze-conf:terminator=EOF_CONF
plugin {
	external teardown-tunnel-all-test {
		run "ze-test fixture plugin/teardown-tunnel-all"
		encoder json
	}
}

environment {
	log {
		l2tp debug
	}
	l2tp {
		server main {
			ip 127.0.0.1
			port $PORT2
		}
	}
}

l2tp {
	enabled true
	shared-secret teardown-all-secret
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=background:seq=2:exec=ze-test fixture plugin/teardown-tunnel-peer $PORT2 0x0111
cmd=background:seq=3:exec=ze-test fixture plugin/teardown-tunnel-peer $PORT2 0x0222
cmd=foreground:seq=4:exec=ze -:stdin=ze-conf:timeout=25s
expect=exit:code=0
expect=stderr:contains=tunnel now established
