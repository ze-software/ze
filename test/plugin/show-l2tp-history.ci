# Test: show l2tp {session history|session traffic|tunnel history} <id>
# Exercises: dispatch-command -> ze-l2tp-api:{session-history,session-traffic,
#            tunnel-history} -> handleSessionHistory/handleSessionTraffic/
#            handleTunnelHistory.
# Verifies the R9 rename split (`session-history` -> `session history`, etc.)
# dispatches end-to-end with a live tunnel+session: each id-scoped command
# resolves via its container path, passes the trailing id as args[0], and
# returns done with the FSM/traffic JSON. (Existing show-l2tp-session-detail.ci
# / show-l2tp-tunnel-detail.ci cover the `... id <id>` siblings, not these.)
# Native (l2tp control-plane, kernel probe skipped).

option=env:var=ze.l2tp.skip-kernel-probe:value=true
# The kernel data plane is DISABLED for this test. skip-kernel-probe above bypasses
# only the modprobe; on a host where l2tp_netlink is already loaded the genl tunnel
# create still runs and needs CAP_NET_ADMIN, which is why this test used to fail
# unprivileged with "session never established". With no kernel worker the session
# establishes on the control plane alone, which is the whole of what this test
# asserts -- it reads the CLI surface, never the kernel's view. A test that DOES
# need the data plane must not set this (see test/l2tp/session-stopccn-cascade.ci).
option=env:var=ze.l2tp.disable-kernel-dataplane:value=true
option=env:var=TEST_SECRET:value=l2tp-history-secret
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=20s
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

tmpfs=l2tp-history-peer.py:mode=755:terminator=EOF_PY
#!/usr/bin/env python3
"""Establish an L2TP tunnel + session, then idle."""
import hashlib
import os
import socket
import struct
import sys
import time

if len(sys.argv) < 2:
    print("usage: l2tp-history-peer.py <port> [tid] [sid]", file=sys.stderr)
    sys.exit(2)

TARGET = ("127.0.0.1", int(sys.argv[1]))
PEER_TID = int(sys.argv[2], 0) if len(sys.argv) > 2 else 0x0123
PEER_SID = int(sys.argv[3], 0) if len(sys.argv) > 3 else 500
SECRET = os.environ.get("TEST_SECRET", "").encode("utf-8")
PEER_CHALLENGE = bytes.fromhex("00112233445566778899aabbccddeeff")


def avp(mandatory, attr_type, value):
    flags = 0x8000 if mandatory else 0
    return struct.pack("!HHH", flags | (6 + len(value)), 0, attr_type) + value


def l2tp_ctrl(dest_tid, dest_sid, ns, nr, body):
    total = 12 + len(body)
    hdr = struct.pack("!HHHHHH", 0xC802, total, dest_tid, dest_sid, ns, nr)
    return hdr + body


def parse_avps(body):
    out = {}
    off = 0
    while off + 6 <= len(body):
        word, vendor, atype = struct.unpack("!HHH", body[off:off + 6])
        length = word & 0x03FF
        if length < 6 or off + length > len(body):
            break
        if vendor == 0:
            out[atype] = body[off + 6:off + length]
        off += length
    return out


def build_sccrq():
    body = b""
    body += avp(True, 0, struct.pack("!H", 1))
    body += avp(True, 2, b"\x01\x00")
    body += avp(True, 3, struct.pack("!I", 0x3))
    body += avp(True, 4, struct.pack("!I", 0x0))
    body += avp(True, 7, f"py-peer-{PEER_TID}".encode("ascii"))
    body += avp(True, 9, struct.pack("!H", PEER_TID))
    body += avp(True, 10, struct.pack("!H", 8))
    if SECRET:
        body += avp(True, 11, PEER_CHALLENGE)
    return l2tp_ctrl(0, 0, 0, 0, body)


def build_scccn(dest_tid, ns, nr, response):
    body = b""
    body += avp(True, 0, struct.pack("!H", 3))
    if response is not None:
        body += avp(True, 13, response)
    return l2tp_ctrl(dest_tid, 0, ns, nr, body)


def build_icrq(dest_tid, ns, nr):
    body = b""
    body += avp(True, 0, struct.pack("!H", 10))
    body += avp(True, 14, struct.pack("!H", PEER_SID))
    body += avp(True, 15, struct.pack("!I", 42))
    return l2tp_ctrl(dest_tid, 0, ns, nr, body)


def build_iccn(dest_tid, dest_sid, ns, nr):
    body = b""
    body += avp(True, 0, struct.pack("!H", 12))
    body += avp(True, 24, struct.pack("!I", 10_000_000))
    body += avp(True, 19, struct.pack("!I", 2))
    return l2tp_ctrl(dest_tid, dest_sid, ns, nr, body)


def recv(sock):
    data, _ = sock.recvfrom(1500)
    if len(data) < 12:
        return None, None
    _, length, _, _, _, _ = struct.unpack("!HHHHHH", data[:12])
    return parse_avps(data[12:length]), None


def main():
    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    sock.bind(("127.0.0.1", 0))
    sock.settimeout(0.25)

    # Deterministic handshake: retransmit SCCRQ until ze answers with SCCRP. The
    # retry loop tolerates ze's L2TP listener not being ready yet, so no fixed
    # pre-handshake settle sleep is needed.
    sccrp_avps = None
    for _ in range(40):
        try:
            sock.sendto(build_sccrq(), TARGET)
            sccrp_avps, _ = recv(sock)
            if sccrp_avps:
                break
        except (socket.timeout, ConnectionRefusedError, OSError):
            continue
    if not sccrp_avps:
        print(f"ERROR[{PEER_TID}]: no SCCRP", file=sys.stderr)
        return 1
    local_tid = struct.unpack("!H", sccrp_avps[9])[0]
    response = None
    if SECRET:
        response = hashlib.md5(bytes([3]) + SECRET + sccrp_avps[11]).digest()
    sock.settimeout(1.0)
    sock.sendto(build_scccn(local_tid, 1, 1, response), TARGET)
    try:
        sock.recvfrom(1500)
    except (socket.timeout, OSError):
        pass
    # Deterministic replacement for sleep(0.05): retransmit ICRQ (same Ns=2, a valid
    # L2TP retransmission ze dedupes) until ICRP carrying the peer's Assigned Session
    # ID (AVP 14) arrives, instead of assuming ze processed SCCCN within 50ms.
    sock.settimeout(0.25)
    icrp_avps = None
    for _ in range(40):
        try:
            sock.sendto(build_icrq(local_tid, 2, 1), TARGET)
            icrp_avps, _ = recv(sock)
        except (socket.timeout, OSError):
            continue
        if icrp_avps and 14 in icrp_avps:
            break
    if icrp_avps is None or 14 not in icrp_avps:
        print(f"ERROR[{PEER_TID}]: no ICRP", file=sys.stderr)
        return 1
    ze_sid = struct.unpack("!H", icrp_avps[14])[0]
    try:
        sock.recvfrom(1500)
    except (socket.timeout, OSError):
        pass
    sock.sendto(build_iccn(local_tid, ze_sid, 3, 2), TARGET)
    try:
        sock.recvfrom(1500)
    except (socket.timeout, OSError):
        pass
    print(f"OK[{PEER_TID}]: session established local_sid={PEER_SID} remote_sid={ze_sid}")
    sys.stdout.flush()

    deadline = time.time() + 15.0
    sock.settimeout(0.2)
    while time.time() < deadline:
        if os.path.exists("peer.exit"):
            break
        try:
            sock.recvfrom(1500)
        except (socket.timeout, OSError):
            pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
EOF_PY

tmpfs=l2tp-history.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
"""Dispatch the id-scoped show l2tp history/traffic commands on a live session."""
import json
import sys
import time

from ze_api import API, runtime_fail, result_json_data, result_text_data


def dispatch(api, command):
    resp = api._call_engine(
        'ze-plugin-engine:dispatch-command', {'command': command})
    if resp is None:
        return {'status': 'error', 'data': 'engine call returned None'}
    return resp.get('result', {})


def list_rows(api, command):
    r = dispatch(api, command)
    if r.get('status') != 'done':
        return []
    try:
        rows = result_json_data(r, [])
    except json.JSONDecodeError:
        return []
    return rows if isinstance(rows, list) else []


def expect_done_json(api, command):
    r = dispatch(api, command)
    if r.get('status') != 'done':
        runtime_fail(f'{command!r}: status={r.get("status")!r} data={result_text_data(r)[:160]}')
    try:
        return result_json_data(r, None)
    except json.JSONDecodeError as exc:
        runtime_fail(f'{command!r}: invalid JSON: {exc}')


def eor_on_wire(result):
    """True once peer1's initial-sync End-of-RIB has been written."""
    if result.get('status') != 'done':
        return False
    data = result_text_data(result, '{}')
    try:
        parsed = json.loads(data) if isinstance(data, str) else data
    except (json.JSONDecodeError, TypeError, ValueError):
        return False
    if not isinstance(parsed, dict):
        return False
    peers = parsed.get('peers', {})
    if not isinstance(peers, dict):
        return False
    return any(isinstance(row, dict) and row.get('eor-sent', 0) >= 1
               for row in peers.values())


def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()

    # peer1 is scaffolding: it hosts this observer plugin and drives no L2TP
    # behaviour. It is still a real BGP session, and the peer block above
    # asserts its initial-sync End-of-RIB, so wait for that EOR to reach the
    # wire before this script's work leads to `request shutdown`. Without the
    # wait the assertion is reachable only by luck -- the observer finished
    # first, ze closed the session inside the OPEN handshake, and ze-peer
    # reported "connection closed before completion". Same gate, same reason, as
    # show-l2tp-sessions.ci. No plugin binds send [ update ] here, so
    # apiSendCount is 0 and the EOR follows establishment immediately.
    synced = api.dispatch_until(
        'show bgp peer peer1 detail', eor_on_wire, attempts=60,
    )
    if not eor_on_wire(synced):
        runtime_fail('peer1 never sent its initial-sync End-of-RIB')

    # // test-relax: hand-rolled for-loop + sleep(0.1) poll -> api.dispatch_until (ratchet-exempt internal sleep)
    def _has_session(r):
        if r.get('status') != 'done':
            return False
        try:
            ss = result_json_data(r, [])
        except json.JSONDecodeError:
            return False
        return isinstance(ss, list) and len(ss) >= 1

    api.dispatch_until('show l2tp sessions', _has_session, attempts=150, delay=0.1)
    ss = list_rows(api, 'show l2tp sessions')
    local_sid = ss[0].get('local-sid') if ss else None
    if not isinstance(local_sid, int) or local_sid == 0:
        runtime_fail('session never established')

    ts = list_rows(api, 'show l2tp tunnels')
    local_tid = ts[0].get('local-tid') if ts else None
    if not isinstance(local_tid, int) or local_tid == 0:
        runtime_fail(f'no tunnel local-tid; tunnels={ts!r}')

    # session history: FSM transitions of the established session.
    hist = expect_done_json(api, f'show l2tp session history {local_sid}')
    if not isinstance(hist, dict) or not isinstance(hist.get('transitions'), list):
        runtime_fail(f'session history missing transitions list: {hist!r}')

    # session traffic: per-session counters read from the kernel PPP data
    # plane. This control-plane-only test has no PPP interface, so the handler
    # returns "no PPP interface"; with a data plane it returns done. Either
    # outcome proves the renamed command reaches handleSessionTraffic.
    rt = dispatch(api, f'show l2tp session traffic {local_sid}')
    tb = json.dumps(rt)
    if rt.get('status') != 'done' and 'PPP interface' not in tb:
        runtime_fail(f'session traffic did not reach handler: {tb}')

    # tunnel history: FSM transitions of the established tunnel.
    thist = expect_done_json(api, f'show l2tp tunnel history {local_tid}')
    if not isinstance(thist, dict) or not isinstance(thist.get('transitions'), list):
        runtime_fail(f'tunnel history missing transitions list: {thist!r}')

    print(f'OK: session history({len(hist["transitions"])}), session traffic, '
          f'tunnel history({len(thist["transitions"])}) dispatched', file=sys.stderr)

    with open('peer.exit', 'w') as f:
        f.write('ok')
    dispatch(api, 'request shutdown')
    api.wait_for_shutdown()


if __name__ == '__main__':
    main()
EOF_RUN

stdin=ze-conf:terminator=EOF_CONF
plugin {
	external l2tp-history-test {
		run ./l2tp-history.run
		encoder json
	}
}

environment {
	log {
		l2tp debug
	}
	l2tp {
		server main {
			ip 127.0.0.1
			port $PORT2
		}
	}
}

l2tp {
	enabled true
	shared-secret l2tp-history-secret
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		process l2tp-history-test {
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=background:seq=2:exec=python3 l2tp-history-peer.py $PORT2 0x0123 500
cmd=foreground:seq=3:exec=ze -:stdin=ze-conf:timeout=20s
expect=exit:code=0
expect=stderr:contains=tunnel now established
