# Test: ddos-detect Stage-2 characterization -> ddos-local narrows the drop.
#
# VALIDATES: cp-survival-5-detect-5 AC-3/AC-7/AC-9 -- on a UDP reflection flood
#            (dominant source port is a known amplifier) the detector classifies
#            the attack from the flow-export recent-flow ring, emits
#            AttackCharacterized, and ddos-local narrows the nftables drop to
#            match the protocol + source port (not just the destination prefix).
# PREVENTS:  a regression where characterization never narrows and mitigation
#            stays coarse (destination-only), or the classifier misreads the
#            reflection signature.
#
# STATUS: option=needs-linux. It exercises the full daemon path (rate trigger ->
#   trafficusage victim -> flow-export conntrack recent-flow ring -> classifier ->
#   AttackCharacterized -> ddos-local narrow), which requires a Linux kernel with
#   nf_conntrack (flow-export conntrack) and eBPF (traffic-usage). It is NOT
#   runnable on the darwin dev host and has not been run there; the QEMU CI runs
#   it. The classifier/ring/responder units are covered on any platform
#   (detect/characterize_test.go, flowexport/recent_test.go, local/match_test.go).
#
#   TIMING NOTE (see docs/guide/ddos-mitigation.md): characterization is one-shot
#   at attack-confirm, and the recent-flow ring only refreshes at each conntrack
#   dump (active-timeout, set to 1s here). The driver therefore PRE-WARMS the ring
#   with a low-rate flow (below absolute-floor, so the detector does not trigger)
#   and waits for a dump before the heavy flood, so the reflection flow is in the
#   ring when characterization runs.

option=needs-linux
option=env:var=ze.log.ddos.detect:value=info
option=env:var=ze.log.ddos.local:value=info
option=timeout:value=50s

tmpfs=driver.py:mode=755:terminator=EOF_PY
#!/usr/bin/env python3
"""Reflection flood (UDP src-port 11211) -> assert ddos-local narrows to it."""
import os
import signal
import socket
import subprocess
import sys
import time

# Wait for the daemon to come up (runner writes daemon.pid + daemon.ready).
for _ in range(400):
    if os.path.exists("daemon.pid") and os.path.exists("daemon.ready"):
        break
    # poll interval; the loop above breaks once daemon.pid and daemon.ready exist, bounded wait not a blind sleep
    time.sleep(0.05)
else:
    print("ERROR: daemon.pid/ready never appeared", file=sys.stderr)
    sys.exit(1)

with open("daemon.pid") as f:
    pid = int(f.read().strip())

victim = "127.0.0.2"
# Source port 11211 (memcached) is in the classifier's reflection table and is
# non-privileged, so no root is needed to bind it and it is unlikely to be in use.
sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
sock.bind(("127.0.0.1", 11211))
payload = b"x" * 64

# Bind the victim port so the flood lands on an OPEN port. Without a listener the
# kernel answers each UDP to the closed 127.0.0.2:9999 with an ICMP port-unreachable
# back to 127.0.0.1 -- a loopback-only artifact (attacker and victim share the box).
# Those ICMP replies EGRESS toward 127.0.0.1 and, carrying the quoted datagram, are
# larger per packet than the forward flood, so trafficusage's by-destination-bytes
# victim pick (parseTopDestination) latches onto 127.0.0.1 (the source) instead of
# 127.0.0.2, and characterization can never narrow to a victim it is not tracking.
# On a real transit box forwarding a flood the victim egress dominates and there is
# no such confound; the bound socket models that. It only receives (buffer fills and
# drops silently); no drain needed.
victim_sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
victim_sock.setsockopt(socket.SOL_SOCKET, socket.SO_RCVBUF, 1 << 20)
victim_sock.bind((victim, 9999))


def blast(n):
    sent = 0
    for _ in range(n):
        try:
            sock.sendto(payload, (victim, 9999))
            sent += 1
        except OSError:
            pass
    return sent


# 1. Pre-warm: low rate (below the 1000 pps absolute-floor, so no trigger) that
#    establishes the 127.0.0.1:11211 -> 127.0.0.2 conntrack flow and lets at least
#    one conntrack dump (active-timeout=1s) land it in the recent-flow ring.
for _ in range(3):
    blast(50)
    # deliberate pacing: 1s between pre-warm blasts so a conntrack dump (active-timeout 1s) lands the flow in the recent-flow ring before the flood
    time.sleep(1.0)

# 2. Flood hard so the detector confirms and characterization runs against the
#    now-warm ring; poll for the NARROWED rule (udp source port 11211 to victim).
narrowed = False
ruleset = ""
deadline = time.time() + 30.0
sent = 0
while time.time() < deadline:
    sent += blast(4000)
    snap = subprocess.run(["nft", "list", "ruleset"], capture_output=True, text=True)
    ruleset = snap.stdout
    # The coarse rule carries only the destination; "sport 11211" appears only once
    # the classifier narrows to the reflection source port.
    if "ddos-local" in ruleset and victim in ruleset and "11211" in ruleset:
        narrowed = True
        break
    # poll interval; the loop above breaks once the narrowed nft rule appears in the ruleset, bounded wait not a blind sleep
    time.sleep(0.2)

sys.stdout.write(ruleset)
os.kill(pid, signal.SIGTERM)

if not narrowed:
    print(f"ERROR: ddos-local did not narrow to udp sport 11211 -> {victim} "
          f"(sent {sent} packets); rule stayed coarse or classifier missed the flow",
          file=sys.stderr)
    sys.exit(1)
print("OK: ddos-local narrowed the drop to the reflection source port 11211",
      file=sys.stderr)
EOF_PY

stdin=ze-bgp:terminator=EOF_CONF
ddos {
    detect {
        enabled true;
        absolute-floor 1000;
        confirm-duration 1;
        startup-grace 0;
        baseline-window 10;
        check-interval 1;
        characterize-enable true;
        characterize-window 60;
        characterize-timeout 3000;
    }
    local {
        response-level enforce;
    }
}

traffic {
    usage {
        enabled true;
        track-ip true;
        interfaces {
            interface lo {
                enabled true;
            }
        }
    }
}

flow-export {
    conntrack {
        enabled true;
        active-timeout 1;
        recent-flow-ring 256;
    }
}
EOF_CONF

cmd=background:seq=1:exec=ze -:stdin=ze-bgp
cmd=foreground:seq=2:exec=python3 driver.py:timeout=45s
expect=exit:code=0
expect=stdout:contains=ddos-local
expect=stdout:contains=127.0.0.2
expect=stderr:contains=ddos-local: drop rule installed
