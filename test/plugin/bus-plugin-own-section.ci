# Test: narrowing `bgp-rs` via its own section (`bgp { route-server { bus { send { to [ /bgp/group/ix ]; } } } }`) and `bgp-rr` via `bus { endpoint bgp-rr { send { to [ /bgp/group/core ]; } } }` limits forwarding to the listed groups only.
# QUESTION: (1) with `bgp { route-server { bus { send { to [ /bgp/group/ix ]; } } } }` and
# RS-client groups `ix` (`ix1`, `ix2-peer`) and `ix2` (`ix2a`, `ix2b`), does the route
# server forward routes to `ix` peers only and NOT `ix2` peers, with `| implied` showing
# `send > to` written at `/bgp/route-server`, while removing that line lets `ix2` receive
# them; and (2) with `bus { endpoint bgp-rr { internal bgp-rr; send { to [ /bgp/group/core ]; } } }`
# and iBGP groups `core` (`core1`, `core2`) and `edge` (`edge1`, `edge2`), does `bgp-rr`
# reflect routes to `core` peers only and NOT `edge` peers, with `| implied` showing
# `send > to` written at `/bus/endpoint/bgp-rr`, while removing that line lets `edge`
# receive them? A unit test cannot decide this because it spans live RS/RR forwarding over
# TCP, own-section vs bus-endpoint filter compilation, and `| implied` reporting.
#
# VALIDATES: spec-explicit-plugin-and-attach-config S14 / AC-2, AC-7.
# PREVENTS: `bgp { route-server { bus { send > to } } }` or `bus { endpoint bgp-rr { send > to } }`
# failing to restrict live route forwarding to the named group.

option=timeout:value=150s
option=env:var=ZE_CONFIG_DIR:value=.
option=env:var=XDG_DATA_HOME:value=.
option=env:var=ze.ssh.password:value=testpass

stdin=init-answers:terminator=EOF_INIT
admin
testpass
127.0.0.1
$PORT2
EOF_INIT

# --- Part 1 (RS restricted): ix1 sends 10.0.1.0/24 (180A0001), ix2a sends 10.0.2.0/24 (180A0002) ---
stdin=rs-ix1-lim:terminator=EOF_RS_IX1_L
option=tcp_connections:value=1
option=timeout:value=60s
option=asn:value=65001
option=open:value=router-id:id=127.0.0.2
option=linger:value=true
option=await-file:path=rs-ixb-lim.up
option=update:value=send-route:prefix=10.0.1.0/24:next-hop=192.0.2.1
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
expect=bgp:conn=1:seq=1:announced=180A0002
EOF_RS_IX1_L

stdin=rs-ixb-lim:terminator=EOF_RS_IXB_L
option=tcp_connections:value=1
option=timeout:value=60s
option=asn:value=65002
option=open:value=router-id:id=127.0.0.3
option=linger:value=true
option=established-file:path=rs-ixb-lim.up
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
expect=bgp:conn=1:seq=1:announced=180A0001
expect=bgp:conn=1:seq=1:announced=180A0002
EOF_RS_IXB_L

stdin=rs-ix2a-lim:terminator=EOF_RS_IX2A_L
option=tcp_connections:value=1
option=timeout:value=60s
option=asn:value=65003
option=open:value=router-id:id=127.0.0.4
option=linger:value=true
option=await-file:path=rs-ix2b-lim.up
option=update:value=send-route:prefix=10.0.2.0/24:next-hop=192.0.2.2
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
reject=bgp:conn=1:scope=announced:pattern=180A0001
EOF_RS_IX2A_L

stdin=rs-ix2b-lim:terminator=EOF_RS_IX2B_L
option=tcp_connections:value=1
option=timeout:value=60s
option=asn:value=65004
option=open:value=router-id:id=127.0.0.5
option=linger:value=true
option=established-file:path=rs-ix2b-lim.up
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
reject=bgp:conn=1:scope=announced:pattern=180A0001
reject=bgp:conn=1:scope=announced:pattern=180A0002
EOF_RS_IX2B_L

# --- Part 1 control (RS unrestricted): ix2b receives 10.0.1.0/24 (180A0001) ---
stdin=rs-ix1-ctl:terminator=EOF_RS_IX1_C
option=tcp_connections:value=1
option=timeout:value=60s
option=asn:value=65001
option=open:value=router-id:id=127.0.0.2
option=linger:value=true
option=await-file:path=rs-ix2b-ctl.up
option=update:value=send-route:prefix=10.0.1.0/24:next-hop=192.0.2.1
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_RS_IX1_C

stdin=rs-ix2b-ctl:terminator=EOF_RS_IX2B_C
option=tcp_connections:value=1
option=timeout:value=60s
option=asn:value=65004
option=open:value=router-id:id=127.0.0.5
option=linger:value=true
option=established-file:path=rs-ix2b-ctl.up
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
expect=bgp:conn=1:seq=1:announced=180A0001
EOF_RS_IX2B_C

# --- Part 2 (RR restricted): core1 sends 10.0.3.0/24 (180A0003), edge1 sends 10.0.4.0/24 (180A0004) ---
stdin=rr-core1-lim:terminator=EOF_RR_C1_L
option=tcp_connections:value=1
option=timeout:value=60s
option=asn:value=65000
option=open:value=router-id:id=127.0.0.2
option=linger:value=true
option=await-file:path=rr-core2-lim.up
option=update:value=send-route:prefix=10.0.3.0/24:next-hop=192.0.2.3
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
expect=bgp:conn=1:seq=1:announced=180A0004
EOF_RR_C1_L

stdin=rr-core2-lim:terminator=EOF_RR_C2_L
option=tcp_connections:value=1
option=timeout:value=60s
option=asn:value=65000
option=open:value=router-id:id=127.0.0.3
option=linger:value=true
option=established-file:path=rr-core2-lim.up
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
expect=bgp:conn=1:seq=1:announced=180A0003
expect=bgp:conn=1:seq=1:announced=180A0004
EOF_RR_C2_L

stdin=rr-edge1-lim:terminator=EOF_RR_E1_L
option=tcp_connections:value=1
option=timeout:value=60s
option=asn:value=65000
option=open:value=router-id:id=127.0.0.4
option=linger:value=true
option=await-file:path=rr-edge2-lim.up
option=update:value=send-route:prefix=10.0.4.0/24:next-hop=192.0.2.4
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
reject=bgp:conn=1:scope=announced:pattern=180A0003
EOF_RR_E1_L

stdin=rr-edge2-lim:terminator=EOF_RR_E2_L
option=tcp_connections:value=1
option=timeout:value=60s
option=asn:value=65000
option=open:value=router-id:id=127.0.0.5
option=linger:value=true
option=established-file:path=rr-edge2-lim.up
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
reject=bgp:conn=1:scope=announced:pattern=180A0003
reject=bgp:conn=1:scope=announced:pattern=180A0004
EOF_RR_E2_L

# --- Part 2 control (RR unrestricted): edge2 receives 10.0.3.0/24 (180A0003) ---
stdin=rr-core1-ctl:terminator=EOF_RR_C1_C
option=tcp_connections:value=1
option=timeout:value=60s
option=asn:value=65000
option=open:value=router-id:id=127.0.0.2
option=linger:value=true
option=await-file:path=rr-edge2-ctl.up
option=update:value=send-route:prefix=10.0.3.0/24:next-hop=192.0.2.3
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_RR_C1_C

stdin=rr-edge2-ctl:terminator=EOF_RR_E2_C
option=tcp_connections:value=1
option=timeout:value=60s
