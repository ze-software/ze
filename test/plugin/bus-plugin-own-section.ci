			session { asn { local 65000; remote 65004; } rs-client true; family { ipv4/unicast { prefix { maximum 10000; } } } capability { graceful-restart disable; } }
			behavior { group-updates disable; }
		}
	}
}
EOF_C_RS_C

# Config 3: RR limited via bus { endpoint bgp-rr { internal bgp-rr; send { to [ /bgp/group/core ]; } } }.
tmpfs=s14-rr-lim.conf:terminator=EOF_C_RR_L
system {
	authentication {
		user admin {
			password "$2a$04$UlwuiuH82Unfsq.XEMPGJeDkXwbm3KW.nvVaVXOd/JeFK8VjMjrQO"
		}
	}
}
environment {
	ssh {
		enabled true
		server main { ip 127.0.0.1; port $PORT2; }
	}
}
bus {
	endpoint bgp-rr {
		internal bgp-rr;
		send {
			to [ /bgp/group/core ];
		}
	}
}
bgp {
	router-id 192.0.2.254;
	filter {
		import { final accept; }
		export { final accept; }
	}
	group core {
		peer core1 {
			connection { remote { ip 127.0.0.2; } local { ip 127.0.0.1; accept false; } }
			session { asn { local 65000; remote 65000; } route-reflector-client true; cluster-id 10.0.0.1; family { ipv4/unicast { prefix { maximum 10000; } } } capability { graceful-restart disable; } }
			behavior { group-updates disable; }
		}
		peer core2 {
			connection { remote { ip 127.0.0.3; } local { ip 127.0.0.1; accept false; } }
			session { asn { local 65000; remote 65000; } route-reflector-client true; cluster-id 10.0.0.1; family { ipv4/unicast { prefix { maximum 10000; } } } capability { graceful-restart disable; } }
			behavior { group-updates disable; }
		}
	}
	group edge {
		peer edge1 {
			connection { remote { ip 127.0.0.4; } local { ip 127.0.0.1; accept false; } }
			session { asn { local 65000; remote 65000; } route-reflector-client true; cluster-id 10.0.0.1; family { ipv4/unicast { prefix { maximum 10000; } } } capability { graceful-restart disable; } }
			behavior { group-updates disable; }
		}
		peer edge2 {
			connection { remote { ip 127.0.0.5; } local { ip 127.0.0.1; accept false; } }
			session { asn { local 65000; remote 65000; } route-reflector-client true; cluster-id 10.0.0.1; family { ipv4/unicast { prefix { maximum 10000; } } } capability { graceful-restart disable; } }
			behavior { group-updates disable; }
		}
	}
}
EOF_C_RR_L

# Config 4: RR control without send > to.
tmpfs=s14-rr-ctl.conf:terminator=EOF_C_RR_C
system {
	authentication {
		user admin {
			password "$2a$04$UlwuiuH82Unfsq.XEMPGJeDkXwbm3KW.nvVaVXOd/JeFK8VjMjrQO"
		}
	}
}
environment {
	ssh {
		enabled true
		server main { ip 127.0.0.1; port $PORT2; }
	}
}
bus {
	endpoint bgp-rr {
		internal bgp-rr;
	}
}
bgp {
	router-id 192.0.2.254;
	filter {
		import { final accept; }
		export { final accept; }
	}
	group core {
		peer core1 {
			connection { remote { ip 127.0.0.2; } local { ip 127.0.0.1; accept false; } }
			session { asn { local 65000; remote 65000; } route-reflector-client true; cluster-id 10.0.0.1; family { ipv4/unicast { prefix { maximum 10000; } } } capability { graceful-restart disable; } }
			behavior { group-updates disable; }
		}
	}
	group edge {
		peer edge2 {
			connection { remote { ip 127.0.0.5; } local { ip 127.0.0.1; accept false; } }
			session { asn { local 65000; remote 65000; } route-reflector-client true; cluster-id 10.0.0.1; family { ipv4/unicast { prefix { maximum 10000; } } } capability { graceful-restart disable; } }
			behavior { group-updates disable; }
		}
	}
}
EOF_C_RR_C

cmd=foreground:seq=1:exec=ze init:stdin=init-answers:exit=0

# --- Run 1: bgp-rs limited to /bgp/group/ix ---
cmd=background:seq=2:name=rs-ix1-l:exec=le test peer --bind 127.0.0.2 --port $PORT:stdin=rs-ix1-lim
cmd=background:seq=3:name=rs-ixb-l:exec=le test peer --bind 127.0.0.3 --port $PORT:stdin=rs-ixb-lim
cmd=background:seq=4:name=rs-ix2a-l:exec=le test peer --bind 127.0.0.4 --port $PORT:stdin=rs-ix2a-lim
cmd=background:seq=5:name=rs-ix2b-l:exec=le test peer --bind 127.0.0.5 --port $PORT:stdin=rs-ix2b-lim
cmd=background:seq=6:name=d-rs-l:exec=ze start s14-rs-lim.conf:ready=Ze running.
reject=stderr:pattern=ZE-OBSERVER-FAIL
reject=stderr:pattern=panic

cmd=foreground:seq=7:exec=le test fixture daemon/await-answer-all "show bgp peer ixb detail | json" '"updates-sent": 3' '"eor-sent": 1':exit=0
cmd=foreground:seq=8:exec=le test fixture daemon/await-answer-all "show bgp peer ix1 detail | json" '"updates-sent": 2' '"eor-sent": 1':exit=0
cmd=foreground:seq=9:exec=ze cli -c "show bgp peer ix2b detail | json":exit=0
expect=stdout:contains="updates-sent": 1
cmd=foreground:seq=10:exec=ze cli -c "show bgp peer ix2a detail | json":exit=0
expect=stdout:contains="updates-sent": 1

# | implied shows route-server send > to written at its own place (/bgp/route-server).
cmd=foreground:seq=11:exec=le test fixture plugin/bus-assert-implied rule /bgp/route-server send bgp:update written /bgp/group/ix --source-contains route-server:exit=0
expect=stdout:contains=OK:

cmd=stop:seq=12:name=d-rs-l:signal=term
cmd=stop:seq=13:name=rs-ix1-l
cmd=stop:seq=14:name=rs-ixb-l
cmd=stop:seq=15:name=rs-ix2a-l
cmd=stop:seq=16:name=rs-ix2b-l

# --- Run 2 (RS negative control): without route-server > bus, ix2b receives ix1's route ---
cmd=background:seq=17:name=rs-ix1-c:exec=le test peer --bind 127.0.0.2 --port $PORT:stdin=rs-ix1-ctl
cmd=background:seq=18:name=rs-ix2b-c:exec=le test peer --bind 127.0.0.5 --port $PORT:stdin=rs-ix2b-ctl
cmd=background:seq=19:name=d-rs-c:exec=ze start s14-rs-ctl.conf:ready=Ze running.
reject=stderr:pattern=ZE-OBSERVER-FAIL
reject=stderr:pattern=panic

cmd=foreground:seq=20:exec=le test fixture daemon/await-answer-all "show bgp peer ix2b detail | json" '"updates-sent": 2' '"eor-sent": 1':exit=0

cmd=stop:seq=21:name=d-rs-c:signal=term
cmd=stop:seq=22:name=rs-ix1-c
cmd=stop:seq=23:name=rs-ix2b-c

# --- Run 3: bgp-rr limited to /bgp/group/core ---
cmd=background:seq=24:name=rr-c1-l:exec=le test peer --bind 127.0.0.2 --port $PORT:stdin=rr-core1-lim
cmd=background:seq=25:name=rr-c2-l:exec=le test peer --bind 127.0.0.3 --port $PORT:stdin=rr-core2-lim
cmd=background:seq=26:name=rr-e1-l:exec=le test peer --bind 127.0.0.4 --port $PORT:stdin=rr-edge1-lim
cmd=background:seq=27:name=rr-e2-l:exec=le test peer --bind 127.0.0.5 --port $PORT:stdin=rr-edge2-lim
cmd=background:seq=28:name=d-rr-l:exec=ze start s14-rr-lim.conf:ready=Ze running.
reject=stderr:pattern=ZE-OBSERVER-FAIL
reject=stderr:pattern=panic

cmd=foreground:seq=29:exec=le test fixture daemon/await-answer-all "show bgp peer core2 detail | json" '"updates-sent": 3' '"eor-sent": 1':exit=0
cmd=foreground:seq=30:exec=le test fixture daemon/await-answer-all "show bgp peer core1 detail | json" '"updates-sent": 2' '"eor-sent": 1':exit=0
cmd=foreground:seq=31:exec=ze cli -c "show bgp peer edge2 detail | json":exit=0
expect=stdout:contains="updates-sent": 1
cmd=foreground:seq=32:exec=ze cli -c "show bgp peer edge1 detail | json":exit=0
expect=stdout:contains="updates-sent": 1

# | implied shows bgp-rr send > to written at its own place (/bus/endpoint/bgp-rr).
cmd=foreground:seq=33:exec=le test fixture plugin/bus-assert-implied rule /bus/endpoint/bgp-rr send bgp:update written /bgp/group/core --source-contains bgp-rr:exit=0
expect=stdout:contains=OK:

cmd=stop:seq=34:name=d-rr-l:signal=term
cmd=stop:seq=35:name=rr-c1-l
cmd=stop:seq=36:name=rr-c2-l
cmd=stop:seq=37:name=rr-e1-l
cmd=stop:seq=38:name=rr-e2-l

# --- Run 4 (RR negative control): without bgp-rr > send, edge2 receives core1's route ---
cmd=background:seq=39:name=rr-c1-c:exec=le test peer --bind 127.0.0.2 --port $PORT:stdin=rr-core1-ctl
cmd=background:seq=40:name=rr-e2-c:exec=le test peer --bind 127.0.0.5 --port $PORT:stdin=rr-edge2-ctl
cmd=background:seq=41:name=d-rr-c:exec=ze start s14-rr-ctl.conf:ready=Ze running.
reject=stderr:pattern=ZE-OBSERVER-FAIL
reject=stderr:pattern=panic

cmd=foreground:seq=42:exec=le test fixture daemon/await-answer-all "show bgp peer edge2 detail | json" '"updates-sent": 2' '"eor-sent": 1':exit=0

cmd=stop:seq=43:name=d-rr-c:signal=term
cmd=stop:seq=44:name=rr-c1-c
cmd=stop:seq=45:name=rr-e2-c
