option=established-file:path=rr-edge2-ctl.up
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
expect=bgp:conn=1:seq=1:announced=180A0003
EOF_RR_E2_C

# Config 1: RS limited via own section bgp { route-server { bus { send { to [ /bgp/group/ix ]; } } } }.
tmpfs=s14-rs-lim.conf:terminator=EOF_C_RS_L
system {
	authentication {
		user admin {
			password "$2a$04$UlwuiuH82Unfsq.XEMPGJeDkXwbm3KW.nvVaVXOd/JeFK8VjMjrQO"
		}
	}
}
environment {
	ssh {
		enabled true
		server main { ip 127.0.0.1; port $PORT2; }
	}
}
bus {
	endpoint bgp-rs { internal bgp-rs; }
}
bgp {
	router-id 192.0.2.254;
	filter {
		import { final accept; }
		export { final accept; }
	}
	route-server {
		bus {
			send {
				to [ /bgp/group/ix ];
			}
		}
	}
	group ix {
		peer ix1 {
			connection { remote { ip 127.0.0.2; } local { ip 127.0.0.1; accept false; } }
			session { asn { local 65000; remote 65001; } rs-client true; family { ipv4/unicast { prefix { maximum 10000; } } } capability { graceful-restart disable; } }
			behavior { group-updates disable; }
		}
		peer ixb {
			connection { remote { ip 127.0.0.3; } local { ip 127.0.0.1; accept false; } }
			session { asn { local 65000; remote 65002; } rs-client true; family { ipv4/unicast { prefix { maximum 10000; } } } capability { graceful-restart disable; } }
			behavior { group-updates disable; }
		}
	}
	group ix2 {
		peer ix2a {
			connection { remote { ip 127.0.0.4; } local { ip 127.0.0.1; accept false; } }
			session { asn { local 65000; remote 65003; } rs-client true; family { ipv4/unicast { prefix { maximum 10000; } } } capability { graceful-restart disable; } }
			behavior { group-updates disable; }
		}
		peer ix2b {
			connection { remote { ip 127.0.0.5; } local { ip 127.0.0.1; accept false; } }
			session { asn { local 65000; remote 65004; } rs-client true; family { ipv4/unicast { prefix { maximum 10000; } } } capability { graceful-restart disable; } }
			behavior { group-updates disable; }
		}
	}
}
EOF_C_RS_L

