# Test: `show bgp` answers its aggregates and its peer rows as siblings.
# VALIDATES: AC-1, AC-2 — no "summary" envelope; router-id, local-as, uptime,
#            peers-configured, peers-established and peers are top-level keys,
#            and a family filter adds family and peers-in-family beside them.
# PREVENTS: an agent parsing the answer having to descend one level that no
#           other handler in the tree requires. A reader that looks in the wrong
#           place renders EMPTY rather than failing, because a missing key
#           unmarshals to a zero value.

# ze-peer expectations
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=20s
# The family-filtered half reads NegotiatedFamilies, which peer_run.go clears on
# teardown (p.negotiated.Store(nil)). Without linger the peer exits the instant
# it receives ze's End-of-RIB, so `show bgp ipv4/unicast` rejects with
# "un-negotiated family" and the assertion becomes a race. linger holds the
# session open past the expectation.
option=linger:value=true
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# native fixture test plugin: reads the payload an agent reads.

# ze bgp configuration
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external flat-payload-test {
		run "ze-test fixture plugin/bgp-summary-flat-payload"
		encoder json
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
