EOF_PEER

# Native plugin subscribes atomically to UPDATE events, validates the default
# route, and sends the response route.

# ze bgp configuration
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external check-and-announce {
		run "ze-test fixture plugin/plugin-check"
		encoder json
	}
}
bgp {
	group controler {
		session {
			family {
				ipv4/unicast { prefix { maximum 10000; } }
				ipv6/unicast { prefix { maximum 10000; } }
			}
		}
		update {
			attribute {
				origin igp
				local-preference 100
				next-hop 127.0.0.2
			}
			nlri {
				ipv4/unicast add 127.0.0.1/32
			}
		}
		update {
			attribute {
				origin igp
				local-preference 100
				next-hop ::1
			}
			nlri {
				ipv6/unicast add ::1/128
			}
		}
		attach process check-and-announce {
			content {
				format parsed
			}
			receive [ update ]
			send [ update ]
		}

		peer peer1 {
			connection {
				remote {
					ip 127.0.0.1
				}
				local {
					ip 127.0.0.1
					accept false
				}
			}
			session {
				asn {
					local 65512
					remote 65512
				}
				router-id 10.0.0.139
			}
			timer {
				receive-hold-time 30
			}
		}
	}
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=10s
