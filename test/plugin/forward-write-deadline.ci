# Test: forward write deadline env var is accepted and forward path functional
# VALIDATES: ze.fwd.write.deadline env var parsed, forward pool operational
# PREVENTS: write deadline config breaking the forward path

# ze-peer expectations: peer receives an UPDATE forwarded through the cache
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
# seq=1 -- the End-of-RIB marker. The observer holds wait_peer_eor_sent before it
# announces, so the marker is on the wire first whatever the initial-sync gate
# does with it: this peer attaches a process permitted to send updates, and that
# is what makes the gate hold the marker at all (peer_run.go apiSendCount).
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
# seq=2 -- the route the observer then announces through the forward path:
# ORIGIN=IGP, empty AS_PATH (IBGP, local 1 remote 1), NEXT_HOP=1.1.1.1,
# LOCAL_PREF=100, NLRI 10.0.0.0/24. This is the frame that proves the pool
# forwards under the configured write deadline, which the marker alone does not.
expect=bgp:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00300200000015400101004002004003040101010140050400000064180A0000
EOF_PEER

# compiled Go test plugin: sends a route and verifies forward pool is operational

# ze bgp configuration -- sets a custom write deadline via env var
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external deadline-test {
		run "ze-test fixture plugin/forward-write-deadline"
		encoder json
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}

		attach process deadline-test {
			send [ update ]
		}
	}
}
EOF_CONF

# Process orchestration -- set write deadline env var to verify it is accepted
cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s:env=ZE_FWD_WRITE_DEADLINE=10s
expect=exit:code=0
