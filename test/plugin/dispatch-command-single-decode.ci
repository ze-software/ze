# Test: dispatch-command returns raw JSON data (single decode)
# VALIDATES: AC-1 — data field on the wire is raw JSON, decoded with one json.loads
# VALIDATES: AC-2 — error text in dedicated error field, data absent on errors
# PREVENTS: double-encoded data requiring two json.loads calls

# ze-peer expectations
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
option=update:value=send-default-route
# EOR from ze
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER


# ze bgp configuration with rib plugin (provides structured command responses)
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external dispatch-decode-test {
		run "ze-test fixture plugin/dispatch-command-single-decode"
		encoder json
	}
	internal bgp-rib {
		use bgp-rib
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}

		attach process bgp-rib {
			receive [ update state refresh ]
			send [ update ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
# Prove the observer reached its final assertion. Without this the plugin could
# die before dispatching anything and the file would still be green on exit=0.
expect=stderr:contains=PASS: single-decode verified
reject=stderr:pattern=ZE-OBSERVER-FAIL
