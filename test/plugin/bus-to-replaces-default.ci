cmd=foreground:seq=1:exec=ze init:stdin=init-answers:exit=0

# --- Run 1 (S2): lab send > to [ /bus/endpoint/collector ] replaces bgp-rib default ---
cmd=background:seq=2:name=edge1-s2:exec=le test peer --bind 127.0.0.2 --port $PORT:stdin=edge1-s2
cmd=background:seq=3:name=lab-s2:exec=le test peer --bind 127.0.0.3 --port $PORT:stdin=lab-s2
cmd=background:seq=4:name=daemon1:exec=ze start s2.conf:ready=Ze running.
reject=stderr:pattern=ZE-OBSERVER-FAIL
reject=stderr:pattern=panic

cmd=foreground:seq=5:exec=le test fixture plugin/bus-wait-file edge1-s2.up:exit=0
cmd=foreground:seq=6:exec=le test fixture plugin/bus-wait-file lab-s2.up:exit=0
cmd=foreground:seq=7:exec=le test fixture plugin/bus-assert-implied poll-file-contains s2-collector.log 203.0.113.0/24:exit=0
cmd=foreground:seq=8:exec=le test fixture plugin/bus-assert-implied poll-file-contains s2-collector.log 198.51.100.0/24:exit=0
cmd=foreground:seq=9:exec=le test fixture daemon/await-answer-all "show bgp rib" 203.0.113.0/24:exit=0

# Loc-RIB must hold edge1's route and NOT lab's route.
cmd=foreground:seq=10:exec=ze cli -c "show bgp rib":exit=0
expect=stdout:contains=203.0.113.0/24
reject=stdout:contains=198.51.100.0/24

# | implied shows lab's send > to as written and lists bgp-rib among replaced defaults.
cmd=foreground:seq=11:exec=ze cli -c "show config running | implied":exit=0
expect=stdout:contains=replaced registered default(s)
expect=stdout:contains=/bus/endpoint/bgp-rib
cmd=foreground:seq=12:exec=le test fixture plugin/bus-assert-implied rule /bgp/peer/lab send bgp:update written /bus/endpoint/collector --replaced /bus/endpoint/bgp-rib:exit=0
expect=stdout:contains=OK:

cmd=stop:seq=13:name=daemon1:signal=term
cmd=stop:seq=14:name=edge1-s2
cmd=stop:seq=15:name=lab-s2

# --- Run 2 (S2 negative control): without the line, Loc-RIB holds lab's route ---
cmd=background:seq=16:name=edge1-ctl:exec=le test peer --bind 127.0.0.2 --port $PORT:stdin=edge1-ctl
cmd=background:seq=17:name=lab-ctl:exec=le test peer --bind 127.0.0.3 --port $PORT:stdin=lab-ctl
cmd=background:seq=18:name=daemon2:exec=ze start s2-control.conf:ready=Ze running.
reject=stderr:pattern=ZE-OBSERVER-FAIL
reject=stderr:pattern=panic

cmd=foreground:seq=19:exec=le test fixture daemon/await-answer-all "show bgp rib" 203.0.113.0/24 198.51.100.0/24:exit=0

cmd=stop:seq=20:name=daemon2:signal=term
cmd=stop:seq=21:name=edge1-ctl
cmd=stop:seq=22:name=lab-ctl

# --- Run 3 (S3): lab send > to none delivers nothing for lab while edge1 still arrives ---
cmd=background:seq=23:name=edge1-s3:exec=le test peer --bind 127.0.0.2 --port $PORT:stdin=edge1-s3
cmd=background:seq=24:name=lab-s3:exec=le test peer --bind 127.0.0.3 --port $PORT:stdin=lab-s3
cmd=background:seq=25:name=daemon3:exec=ze start s3.conf:ready=Ze running.
reject=stderr:pattern=ZE-OBSERVER-FAIL
reject=stderr:pattern=panic

cmd=foreground:seq=26:exec=le test fixture plugin/bus-wait-file edge1-s3.up:exit=0
cmd=foreground:seq=27:exec=le test fixture plugin/bus-wait-file lab-s3.up:exit=0
# Causal fences: Ze received lab's UPDATE on the wire, and edge1's route reached both collector and Loc-RIB.
cmd=foreground:seq=28:exec=le test fixture daemon/await-answer-all "show bgp peer lab detail | json" '"updates-received": 1':exit=0
cmd=foreground:seq=29:exec=le test fixture plugin/bus-assert-implied poll-file-contains s3-collector.log 203.0.113.0/24:exit=0
cmd=foreground:seq=30:exec=le test fixture daemon/await-answer-all "show bgp rib" 203.0.113.0/24:exit=0

# Neither collector nor Loc-RIB holds anything from lab.
cmd=foreground:seq=31:exec=le test fixture plugin/bus-assert-implied file-not-contains s3-collector.log 127.0.0.3:exit=0
cmd=foreground:seq=32:exec=le test fixture plugin/bus-assert-implied file-not-contains s3-collector.log 198.51.100.0/24:exit=0
cmd=foreground:seq=33:exec=ze cli -c "show bgp rib":exit=0
expect=stdout:contains=203.0.113.0/24
reject=stdout:contains=198.51.100.0/24

# show config prints `to none`.
cmd=foreground:seq=34:exec=ze cli -c "show config running | implied":exit=0
expect=stdout:contains=to none

cmd=stop:seq=35:name=daemon3:signal=term
cmd=stop:seq=36:name=edge1-s3
cmd=stop:seq=37:name=lab-s3

# S3 negative: combining `none` with a destination path is refused at validate.
cmd=foreground:seq=38:exec=ze config validate s3-invalid-none.conf:exit=1
expect=stdout:contains=none
