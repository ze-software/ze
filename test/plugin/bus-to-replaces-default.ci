# Test: writing `send { to [ ... ]; }` or `send { to none; }` on a peer replaces all registered destinations (including bgp-rib), while peers without it keep default wiring.
# QUESTION: when `lab` carries `bus { send { to [ /bus/endpoint/collector ]; } }` while
# `edge1` has no `bus` block, do both peers' updates reach `collector` while Loc-RIB
# holds `edge1`'s route (203.0.113.0/24) and NOT `lab`'s (198.51.100.0/24), does
# `show config running | implied` show `lab`'s `send > to` as written and list
# `/bus/endpoint/bgp-rib` among replaced defaults (while removing the line puts `lab`'s
# route in Loc-RIB), and when `lab` carries `bus { send { to none; } }`, do neither
# `collector` nor Loc-RIB receive anything from `lab` while `edge1`'s route still arrives,
# `show config running` prints `to none`, and combining `to [ none /bus/endpoint/collector ]`
# is refused at validate? A unit test cannot decide this because it spans live BGP peer
# UPDATE intake, compiled delivery graph dispatch to auto-loaded `bgp-rib` and external
# `collector`, live `show bgp rib`, and `| implied` rendering.
#
# VALIDATES: spec-explicit-plugin-and-attach-config S2, S3 / AC-2, AC-23.
# PREVENTS: `send > to` merging with rather than replacing registered defaults, `to none`
# leaking events to registered receivers, or `show config` dropping `to none`.

option=timeout:value=120s
option=env:var=ZE_CONFIG_DIR:value=.
option=env:var=XDG_DATA_HOME:value=.
option=env:var=ze.ssh.password:value=testpass

stdin=init-answers:terminator=EOF_INIT
admin
testpass
127.0.0.1
$PORT2
EOF_INIT

# Peer scripts for Run 1 (S2: lab send > to [ /bus/endpoint/collector ]).
stdin=edge1-s2:terminator=EOF_EDGE1_S2
option=tcp_connections:value=1
option=timeout:value=60s
option=asn:value=65001
option=open:value=router-id:id=127.0.0.2
option=linger:value=true
option=established-file:path=edge1-s2.up
option=update:value=send-route:prefix=203.0.113.0/24:next-hop=192.0.2.1
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_EDGE1_S2

stdin=lab-s2:terminator=EOF_LAB_S2
option=tcp_connections:value=1
option=timeout:value=60s
option=asn:value=65002
option=open:value=router-id:id=127.0.0.3
option=linger:value=true
option=established-file:path=lab-s2.up
option=update:value=send-route:prefix=198.51.100.0/24:next-hop=192.0.2.2
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_LAB_S2

# Peer scripts for Run 2 (S2 control: lab without send > to line).
stdin=edge1-ctl:terminator=EOF_EDGE1_CTL
option=tcp_connections:value=1
option=timeout:value=60s
option=asn:value=65001
option=open:value=router-id:id=127.0.0.2
option=linger:value=true
option=established-file:path=edge1-ctl.up
option=update:value=send-route:prefix=203.0.113.0/24:next-hop=192.0.2.1
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_EDGE1_CTL

stdin=lab-ctl:terminator=EOF_LAB_CTL
option=tcp_connections:value=1
option=timeout:value=60s
option=asn:value=65002
option=open:value=router-id:id=127.0.0.3
option=linger:value=true
option=established-file:path=lab-ctl.up
option=update:value=send-route:prefix=198.51.100.0/24:next-hop=192.0.2.2
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_LAB_CTL

# Peer scripts for Run 3 (S3: lab send > to none).
stdin=edge1-s3:terminator=EOF_EDGE1_S3
option=tcp_connections:value=1
option=timeout:value=60s
option=asn:value=65001
option=open:value=router-id:id=127.0.0.2
option=linger:value=true
option=established-file:path=edge1-s3.up
option=update:value=send-route:prefix=203.0.113.0/24:next-hop=192.0.2.1
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_EDGE1_S3

stdin=lab-s3:terminator=EOF_LAB_S3
option=tcp_connections:value=1
option=timeout:value=60s
option=asn:value=65002
option=open:value=router-id:id=127.0.0.3
option=linger:value=true
option=established-file:path=lab-s3.up
option=update:value=send-route:prefix=198.51.100.0/24:next-hop=192.0.2.2
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_LAB_S3

tmpfs=s2.conf:terminator=EOF_S2
system {
	authentication {
		user admin {
			password "$2a$04$UlwuiuH82Unfsq.XEMPGJeDkXwbm3KW.nvVaVXOd/JeFK8VjMjrQO"
		}
	}
}
environment {
	ssh {
		enabled true
		server main { ip 127.0.0.1; port $PORT2; }
	}
}
bus {
	endpoint collector {
		external {
			run "le test fixture plugin/bus-bgp-collector s2-collector.log";
		}
		encoding json;
	}
}
bgp {
	router-id 192.0.2.254;
	filter {
		import { final accept; }
		export { final accept; }
	}
	peer edge1 {
		connection {
			remote { ip 127.0.0.2; }
			local { ip 127.0.0.1; accept false; }
		}
		session {
			asn { local 65000; remote 65001; }
			family { ipv4/unicast { prefix { maximum 10000; } } }
			capability { graceful-restart disable; }
		}
		behavior { group-updates disable; }
	}
	peer lab {
		connection {
			remote { ip 127.0.0.3; }
			local { ip 127.0.0.1; accept false; }
		}
		session {
			asn { local 65000; remote 65002; }
			family { ipv4/unicast { prefix { maximum 10000; } } }
			capability { graceful-restart disable; }
		}
		behavior { group-updates disable; }
		bus {
			send {
				to [ /bus/endpoint/collector ];
			}
		}
	}
}
EOF_S2

