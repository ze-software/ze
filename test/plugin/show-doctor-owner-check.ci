# Test: `show doctor` includes owner-registered runtime dependency checks.
#
# VALIDATES: command-surface-ownership Phase 6 -- the daemon `show doctor`
#            provider bridge runs checks registered by owner packages, not only
#            checks left in cmd/ze/doctor.
# PREVENTS: owner-registered doctor checks disappearing from the daemon command
#           surface while `ze doctor` still works.

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

tmpfs=doctor-missing-plugin.conf:terminator=EOF_DOCTOR_CONF
plugin {
    external feed {
        run /nonexistent/ze-plugin-binary
        encoder json
    }
}
EOF_DOCTOR_CONF

tmpfs=show-doctor-owner-check.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
"""Dispatch `show doctor` and assert owner-registered checks are included."""

import json
import time

from ze_api import API, runtime_fail, result_json_data, result_text_data


def dispatch(api, command):
    resp = api._call_engine(
        'ze-plugin-engine:dispatch-command', {'command': command})
    if resp is None:
        return {'status': 'error', 'data': 'engine call returned None'}
    return resp.get('result', {})


def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()
    api.wait_for_post_startup(timeout=5.0)

    result = api.dispatch_until_done('show doctor doctor-missing-plugin.conf')  # // test-relax: hand-rolled status==done poll -> dispatch_until_done
    if result is None or result.get('status') != 'done':
        status = result.get('status') if result else 'nil'
        data = result_text_data(result) if result else ''
        runtime_fail(f'show doctor: status={status} data={data[:200]}')

    try:
        data = result_json_data(result, {})
    except json.JSONDecodeError as exc:
        runtime_fail(f'show doctor json: {exc}: {result_text_data(result)[:200]}')
        data = {}

    diagnostics = data.get('diagnostics', [])
    codes = [diag.get('code') for diag in diagnostics]
    if 'doctor-plugin-missing' not in codes:
        runtime_fail(f'show doctor missing owner-registered plugin check: codes={codes!r}')

    dispatch(api, 'request shutdown')
    api.wait_for_shutdown()


if __name__ == '__main__':
    main()
EOF_RUN

stdin=ze-conf:terminator=EOF_CONF
plugin {
    external show-doctor-owner-check {
        run ./show-doctor-owner-check.run
        encoder json
    }
}

bgp {
    peer peer1 {
        connection {
            remote {
                ip 127.0.0.1
            }
            local {
                ip 127.0.0.1
                accept false
            }
        }
        session {
            asn {
                local 1
                remote 1
            }
            router-id 1.2.3.4
            family {
                ipv4/unicast { prefix { maximum 10000; } }
            }
            capability {
                graceful-restart disable
            }
        }
        behavior {
            group-updates disable
        }
    }
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-conf:timeout=15s
expect=exit:code=0
