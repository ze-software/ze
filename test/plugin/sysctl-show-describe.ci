# Test: `sysctl show` returns empty array, `sysctl describe` returns metadata.
#
# VALIDATES: AC-5 -- show-result with empty store returns [].
# VALIDATES: AC-8 -- describe-result for known key includes description and type.
# PREVENTS:  CLI command dispatch broken, JSON format wrong.

option=env:var=ze.log.sysctl:value=debug
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s

# ze-peer runs as a sink: only a dial target, asserts nothing. This test is about
# the sysctl plugin's describe output; the BGP peer exists so ze has a session.
#
# // test-relax: the ipv4/unicast EOR this block declared was unreachable BY
# CONSTRUCTION -- the run-script calls `request shutdown` at post-startup, so ze
# closes during the OPEN handshake ("open recv / open sent / connection closed
# before completion") and the EOR is never sent. It could not fail for a real
# reason, only pass vacuously (pre-F1) or hang the verdict (post-F1). Coverage is
# NOT reduced: this test never asserted BGP wire content -- its sysctl assertions
# and expect=exit:code=0 are what it proves. Per
# plan/spec-fixit-redistribute-establishment-stall.md the honest fixes are
# --mode sink (peer is scaffolding, as here) or reaching Established first, which
# would test BGP rather than sysctl.
EOF_PEER

tmpfs=sysctl-show-describe.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
"""Dispatch `sysctl show` and `sysctl describe` and verify output."""

import json
import sys
import time

from ze_api import API, runtime_fail, result_json_data


def dispatch(api, command):
    resp = api._call_engine(
        'ze-plugin-engine:dispatch-command', {'command': command})
    if resp is None:
        return {'status': 'error', 'data': 'engine call returned None'}
    return resp.get('result', {})


def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()
    # Test sysctl show: no config applied, no defaults => empty array.
    r = api.dispatch_until_done('show sysctl')  # // test-relax: lead-in sleep + hand-rolled poll -> dispatch_until_done
    if r is None or r.get('status') != 'done':
        runtime_fail(f'sysctl show: status={r.get("status") if r else "nil"}')

    try:
        entries = result_json_data(r, [])
    except json.JSONDecodeError as exc:
        runtime_fail(f'sysctl show json: {exc}')
        entries = None

    if not isinstance(entries, list):
        runtime_fail(f'sysctl show: expected list, got {type(entries).__name__}')

    # Test sysctl describe: pick first key from sysctl list.
    r = dispatch(api, 'show sysctl keys')
    if r.get('status') != 'done':
        runtime_fail(f'sysctl list for describe: status={r.get("status")}')

    keys = result_json_data(r, [])
    if not keys:
        runtime_fail('sysctl list returned empty, cannot test describe')

    first_key = keys[0].get('key', '')
    r = dispatch(api, f'show sysctl key {first_key}')
    if r.get('status') != 'done':
        runtime_fail(f'show sysctl key {first_key}: status={r.get("status")}')

    try:
        detail = result_json_data(r, {})
    except json.JSONDecodeError as exc:
        runtime_fail(f'show sysctl key json: {exc}')
        detail = {}

    if detail.get('key') != first_key:
        runtime_fail(f'sysctl describe: key={detail.get("key")!r} want {first_key!r}')
    if not detail.get('description'):
        runtime_fail(f'show sysctl key {first_key}: missing description')
    if not detail.get('type'):
        runtime_fail(f'show sysctl key {first_key}: missing type')

    # Fire-and-forget: a synchronous dispatch of `request shutdown` races ze's own
    # socket close. When the close wins (routine under load) _call_engine blocks for
    # its 30s TLS read timeout then raises "no response for
    # ze-plugin-engine:dispatch-command", failing a test whose assertions all passed.
    # wait_for_shutdown observes the close itself, which is the real condition.
    api.shutdown_fire_and_forget()
    api.wait_for_shutdown()


if __name__ == '__main__':
    main()
EOF_RUN

stdin=ze-sysctl:terminator=EOF_CONF
plugin {
	external sysctl-show-describe-test {
		run ./sysctl-show-describe.run
		encoder json
	}
}

sysctl {
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		process sysctl-show-describe-test {
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --mode sink --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-sysctl:timeout=15s
expect=exit:code=0
