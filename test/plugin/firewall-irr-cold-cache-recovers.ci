# Test: a cold IRR store costs one table, and an update command wins it back.
# VALIDATES: the reconcile is held back per TABLE, not for every owner. The
#            table whose term names an IRR set with nothing stored waits; every
#            other table is programmed on the same reconcile.
# VALIDATES: spec-fetched-data-survives-restart AC-6 -- the irr plugin fetches a
#            cold reference at once, and while that fetch fails the table stays
#            held back.
# VALIDATES: `update irr as-set` stores what it fetched and firewall-irr
#            programs it, so the wait ends. Inside this test nothing else ends
#            it: the owner retries a failed fetch only a minute later.
# PREVENTS:  a fresh install, a wiped store, or an unreadable stored copy
#            leaving the WHOLE firewall out of the kernel behind one WARN, with
#            no operator command able to change it.
#
# Flow:
# 1. The daemon starts with two tables and an empty store. `wan` names
#    AS-TEST, which nothing has stored; `lan` names nothing.
# 2. The irr plugin fetches AS-TEST at once; the mock IRR server fails that
#    first query (--fail-first 1), so nothing is stored and the irr plugin
#    logs the failed fetch.
# 3. The observer reads the ruleset back: `lan` is programmed, `wan` is not.
# 4. The observer runs `update irr as-set AS-TEST`; the second query answers.
# 5. `wan` is now programmed, with the term and its IPv6 twin.

# The runner assigns each daemon a separate tree store beside its explicit
# source, so this scenario starts with an empty prefix cache. Kernel nftables
# objects remain shared and require the exclusion group below.

# This test programs nftables, so it needs CAP_NET_ADMIN, not merely Linux.
option=needs-linux:caps=net-admin
# Serialize against every other firewall-irr test. The nftables ruleset is
# NODE-WIDE, and the table names these tests program cannot be varied from a
# .ci: ifaceTableName is the Go constant "ze_irr_iface"
# (internal/component/firewall/plugins/irr/sets.go) and the config-derived names
# collide as ze_wan and ze_lan. Apply
# (internal/plugins/firewall/nft/backend_linux.go) lists the node's tables and
# deletes every ze_* table it is about to program, so one daemon removes a
# sibling's live table and the sibling reads back terms it never wrote.
# Per-daemon tree isolation does not isolate those kernel objects.
option=exclusive:group=firewall-irr-nft
option=env:var=ze.log.firewall.irr:value=debug
option=env:var=ze.log.irr:value=info
option=timeout:value=30s


stdin=ze-fw:terminator=EOF_CONF
bus {
	endpoint firewall-irr-cold-cache-test {
		external {
			run "le test fixture plugin/firewall-irr-cold-cache-recovers";
		}
		encoding json;
	}
}
system {
	irr { server 127.0.0.1:$PORT2; }
}
firewall {
	backend kernel;
	table wan {
		family inet;
		chain input {
			type filter;
			hook input;
			priority 0;
			policy accept;
			term from-as-test {
				from {
					source-as-set AS-TEST;
				}
				then {
					accept;
				}
			}
		}
	}
	table lan {
		family inet;
		chain input {
			type filter;
			hook input;
			priority 1;
			policy accept;
			term from-lan {
				from {
					source-address 192.0.2.0/24;
				}
				then {
					accept;
				}
			}
		}
	}
}
bgp {
	peer peer1 {
		connection {
			remote { ip 127.0.0.1; }
			local { ip 127.0.0.1; accept false; }
		}
		session {
			asn { local 1; remote 1; }
			router-id 1.2.3.4;
			family { ipv4/unicast { prefix { maximum 10000; } } }
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=le mock irr --port $PORT2 --fail-first 1
cmd=foreground:seq=2:exec=ze --plugin ze.firewall-irr -:stdin=ze-fw:timeout=30s
expect=exit:code=0
expect=stderr:pattern=irr: the IRR server did not answer
expect=stderr:pattern=lan stayed programmed, and the update brought wan back
reject=stderr:pattern=references unknown set
