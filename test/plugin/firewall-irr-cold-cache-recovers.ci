# Test: a cold IRR cache costs one table, and an update command wins it back.
# VALIDATES: the reconcile is held back per TABLE, not for every owner. The
#            table whose term names an unregistered IRR set waits; every other
#            table is programmed on the same reconcile.
# VALIDATES: `update firewall irr as-set` programs what it fetched, so the wait
#            ends. Nothing else ends it: refresh-interval defaults to 0.
# PREVENTS:  a fresh install, a wiped database.zefs, or an unreadable cache
#            leaving the WHOLE firewall out of the kernel behind one WARN, with
#            no operator command able to change it.
#
# Flow:
# 1. The daemon starts with two tables and an empty prefix cache. `wan` names
#    AS-TEST, which no owner has registered; `lan` names nothing.
# 2. The observer reads the ruleset back: `lan` is programmed, `wan` is not.
# 3. The observer fetches AS-TEST from the mock IRR server.
# 4. `wan` is now programmed, with the term and its IPv6 twin.

# HARNESS NOTE: step 1's "empty prefix cache" is a precondition this file cannot
# set, and the runner does not reset it. DefaultConfigDir
# (internal/core/paths/paths.go) resolves ze.config.dir first and otherwise
# EvalSymlinks's the running binary and hands it to ConfigDirFromBinary, so a ze
# at <repo>/bin/ze opens <repo>/etc/ze/database.zefs -- the developer's own
# store, not a per-test one. setupBinShims (internal/test/runner/runner.go) puts
# a bare-named symlink on PATH and the EvalSymlinks above sees through it, so the
# shim does not isolate this. A store that already holds meta/irr/AS-TEST makes
# `wan` reachable at startup and this test fails on its first assertion, with
# nothing in the failure naming the store. Two ways out until the runner isolates
# the config dir: run the daemon from a prefix outside the checkout (a container
# copy at /usr/local/bin/ze resolves /etc/ze), or move
# <repo>/etc/ze/database.zefs aside. Recorded in
# plan/journal/suite-shares-one-persistent-store.md.

# This test programs nftables, so it needs CAP_NET_ADMIN, not merely Linux.
option=needs-linux:caps=net-admin
# Serialize against every other firewall-irr test. The nftables ruleset is
# NODE-WIDE, and the table names these tests program cannot be varied from a
# .ci: ifaceTableName is the Go constant "ze_irr_iface"
# (internal/component/firewall/plugins/irr/sets.go) and the config-derived names
# collide as ze_wan and ze_lan. Apply
# (internal/plugins/firewall/nft/backend_linux.go) lists the node's tables and
# deletes every ze_* table it is about to program, so one daemon removes a
# sibling's live table and the sibling reads back terms it never wrote. The
# persisted prefix store is shared too: DefaultConfigDir
# (internal/core/paths/paths.go) derives it from the binary path, so every
# daemon in the run opens one database.zefs, and a sibling that fetches AS-TEST
# destroys the cold-cache precondition firewall-irr-cold-cache-recovers asserts
# on its first line. MEASURED 2026-08-22 in one privileged container: run in
# parallel 2 of 12 failed, run serially 12 of 12 pass.
option=exclusive:group=firewall-irr-nft
option=env:var=ze.log.firewall.irr:value=debug
option=timeout:value=30s

tmpfs=firewall-irr-cold-cache.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
"""Verify a cold IRR cache costs one table, and that an update recovers it."""
import sys
from ze_api import API, runtime_fail, result_json_data

def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()

    # The table that needs no IRR set must be in the kernel already: one absent
    # supplier is not the whole firewall's problem.
    result = api.dispatch_until(
        'show firewall ruleset lan',
        lambda res: res.get('status') == 'done',
        attempts=50,
        delay=0.1,
    )
    if result.get('status') != 'done':
        runtime_fail(f'lan was not programmed while wan waited for its IRR set: {result}')

    # The table that names the unregistered set is the only one held back.
    result = api.dispatch_until_done('show firewall ruleset wan')
    if result.get('status') == 'done':
        runtime_fail(f'wan was programmed with a rule naming a set nobody registered: {result}')

    result = api.dispatch_until_done('update firewall irr as-set AS-TEST')
    if result.get('status') != 'done':
        runtime_fail(f'update failed: {result}')
    if result_json_data(result, {}).get('ipv4-count', 0) < 1:
        runtime_fail(f'no prefixes cached for AS-TEST: {result}')

    result = api.dispatch_until(
        'show firewall ruleset wan',
        lambda res: res.get('status') == 'done' and 'from-as-test' in str(result_json_data(res, {})),
        attempts=50,
        delay=0.1,
    )
    if result.get('status') != 'done':
        runtime_fail(f'wan is still unprogrammed after the prefixes were fetched: {result}')
    dumped = str(result_json_data(result, {}))
    if 'from-as-test' not in dumped:
        runtime_fail(f'the IRR term is not in the kernel ruleset: {dumped}')
    if 'from-as-test_v6' not in dumped:
        runtime_fail(f'the IPv6 twin of the term is missing: {dumped}')

    print('OK: lan stayed programmed, and the update brought wan back', file=sys.stderr)

    api._call_engine('ze-plugin-engine:dispatch-command', {'command': 'request shutdown'})
    api.wait_for_shutdown()

if __name__ == '__main__':
    main()
EOF_RUN

stdin=ze-fw:terminator=EOF_CONF
plugin {
	external firewall-irr-cold-cache-test {
		run ./firewall-irr-cold-cache.run
		encoder json
	}
}
firewall {
	backend nft;
	irr {
		server 127.0.0.1:$PORT2;
	}
	table wan {
		family inet;
		chain input {
			type filter;
			hook input;
			priority 0;
			policy accept;
			term from-as-test {
				from {
					source-as-set AS-TEST;
				}
				then {
					accept;
				}
			}
		}
	}
	table lan {
		family inet;
		chain input {
			type filter;
			hook input;
			priority 1;
			policy accept;
			term from-lan {
				from {
					source-address 192.0.2.0/24;
				}
				then {
					accept;
				}
			}
		}
	}
}
bgp {
	peer peer1 {
		connection {
			remote { ip 127.0.0.1; }
			local { ip 127.0.0.1; accept false; }
		}
		session {
			asn { local 1; remote 1; }
			router-id 1.2.3.4;
			family { ipv4/unicast { prefix { maximum 10000; } } }
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-test irr --port $PORT2
cmd=foreground:seq=2:exec=ze --plugin ze.firewall-irr -:stdin=ze-fw:timeout=30s
expect=exit:code=0
expect=stderr:pattern=lan stayed programmed, and the update brought wan back
reject=stderr:pattern=references unknown set
