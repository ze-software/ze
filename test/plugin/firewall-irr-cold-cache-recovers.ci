# Test: a cold IRR cache costs one table, and an update command wins it back.
# VALIDATES: the reconcile is held back per TABLE, not for every owner. The
#            table whose term names an unregistered IRR set waits; every other
#            table is programmed on the same reconcile.
# VALIDATES: `update firewall irr as-set` programs what it fetched, so the wait
#            ends. Nothing else ends it: refresh-interval defaults to 0.
# PREVENTS:  a fresh install, a wiped store, or an unreadable cache
#            leaving the WHOLE firewall out of the kernel behind one WARN, with
#            no operator command able to change it.
#
# Flow:
# 1. The daemon starts with two tables and an empty prefix cache. `wan` names
#    AS-TEST, which no owner has registered; `lan` names nothing.
# 2. The observer reads the ruleset back: `lan` is programmed, `wan` is not.
# 3. The observer fetches AS-TEST from the mock IRR server.
# 4. `wan` is now programmed, with the term and its IPv6 twin.

# The runner assigns each daemon a separate tree store beside its explicit
# source, so this scenario starts with an empty prefix cache. Kernel nftables
# objects remain shared and require the exclusion group below.

# This test programs nftables, so it needs CAP_NET_ADMIN, not merely Linux.
option=needs-linux:caps=net-admin
# Serialize against every other firewall-irr test. The nftables ruleset is
# NODE-WIDE, and the table names these tests program cannot be varied from a
# .ci: ifaceTableName is the Go constant "ze_irr_iface"
# (internal/component/firewall/plugins/irr/sets.go) and the config-derived names
# collide as ze_wan and ze_lan. Apply
# (internal/plugins/firewall/nft/backend_linux.go) lists the node's tables and
# deletes every ze_* table it is about to program, so one daemon removes a
# sibling's live table and the sibling reads back terms it never wrote.
# Per-daemon tree isolation does not isolate those kernel objects.
option=exclusive:group=firewall-irr-nft
option=env:var=ze.log.firewall.irr:value=debug
option=timeout:value=30s


stdin=ze-fw:terminator=EOF_CONF
plugin {
	external firewall-irr-cold-cache-test {
		run "le test fixture plugin/firewall-irr-cold-cache-recovers"
		encoder json
	}
}
firewall {
	backend nft;
	irr {
		server 127.0.0.1:$PORT2;
	}
	table wan {
		family inet;
		chain input {
			type filter;
			hook input;
			priority 0;
			policy accept;
			term from-as-test {
				from {
					source-as-set AS-TEST;
				}
				then {
					accept;
				}
			}
		}
	}
	table lan {
		family inet;
		chain input {
			type filter;
			hook input;
			priority 1;
			policy accept;
			term from-lan {
				from {
					source-address 192.0.2.0/24;
				}
				then {
					accept;
				}
			}
		}
	}
}
bgp {
	peer peer1 {
		connection {
			remote { ip 127.0.0.1; }
			local { ip 127.0.0.1; accept false; }
		}
		session {
			asn { local 1; remote 1; }
			router-id 1.2.3.4;
			family { ipv4/unicast { prefix { maximum 10000; } } }
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=le test irr --port $PORT2
cmd=foreground:seq=2:exec=ze --plugin ze.firewall-irr -:stdin=ze-fw:timeout=30s
expect=exit:code=0
expect=stderr:pattern=lan stayed programmed, and the update brought wan back
reject=stderr:pattern=references unknown set
