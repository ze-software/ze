# Test: the boot guard leaves an env-published unauthenticated MCP listener down while ze starts
# VALIDATES: spec-fixit-mgmt-listener-auth-guard AC-2(b) and the 2026-11-26
# ruling (plan/records/ruling-ze-always-starts.md) -- a bare
# ze.mcp.listen=<routable> with no token reaches `ze start` without passing
# through the config editor, and MCP's own fail-closed MCPListenConfig.Validate
# never runs on that path (there is no config block to validate). The guard is
# the only thing standing between that variable and an accept-all MCP server on
# every interface, so it keeps the listener down while ze starts. With no
# environment.mcp block the listener has no TLS either, and config.MCPExposure
# requires both off loopback, so the guard reports both breaches and both fixes
# under doctor-service-not-started.
# PREVENTS: an environment variable in a unit file or container spec publishing
# an unauthenticated tool-calling surface off-box, or preventing ze from starting.

option=exclusive:group=mgmt-guard
option=env:var=ze.mcp.listen:value=0.0.0.0:18081

stdin=ze-bgp:terminator=EOF_CONF
environment {
}
EOF_CONF

cmd=background:seq=1:name=daemon:exec=ze -:stdin=ze-bgp:ready=Ze running
expect=stderr:contains=refusing to start MCP on non-loopback listener "0.0.0.0:18081" without authentication
expect=stderr:contains=set environment mcp auth-mode bearer and set environment mcp token <token>
expect=stderr:contains=refusing to start MCP on non-loopback listener "0.0.0.0:18081" without TLS
expect=stderr:contains=set environment mcp tls cert <cert.pem> and set environment mcp tls key <key.pem>
expect=stderr:contains=code=doctor-service-not-started
reject=stderr:contains=MCP server listening
cmd=stop:seq=2:name=daemon:signal=term
