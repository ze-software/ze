# Test: ze starts a second time over a tunnel netdev its own first run created
# Exercises: iface OnConfigure -> applyConfig(cfg, nil, b) -> CreateTunnel ->
#            RTM_NEWLINK EEXIST -> the kept-netdev branch
#            (internal/component/iface/config_apply.go, D-5/D-6/D-7)
# VALIDATES: the second start applies cleanly and KEEPS the device the first
#            start made. The kernel ifindex is carried from the first run to the
#            second and compared, so "the netdev survives" means the same
#            device, not merely a device with that name.
# PREVENTS:  the restart failure this branch exists for. netlink.LinkAdd sends
#            NLM_F_CREATE|NLM_F_EXCL (vendor/github.com/vishvananda/netlink/
#            link_linux.go), nothing in internal/component/iface deletes tunnels
#            when the daemon stops, and OnConfigure runs applyConfig with a nil
#            previous at EVERY plugin start. So the second start met EEXIST over
#            ze's own netdev, failed the whole interface apply, and the
#            fail-closed startup cascade then refused to start the daemon.
#
# Why unit evidence cannot reach this obligation: every unit test of the branch
# runs against fakeBackend (internal/component/iface/config_test.go), whose
# EEXIST answer and link-type read-back are hand-written. They prove the branch
# reacts to what the fake says. Only a real kernel says whether RTM_NEWLINK
# answers EEXIST for a tunnel a dead process left behind, and whether that
# netdev is still there to answer for.
#
# Why the assertion discriminates:
#  - Revert the kept-netdev branch and the second apply fails on `file exists`,
#    the startup cascade stops the daemon, the pass 2 observer never runs, and
#    the seq=4 daemon does not exit 0.
#  - Replace "keep" with "delete and re-create" and the netdev is a NEW device:
#    the ifindex differs and pass 2 fails on the comparison, not on absence.
#  - Break the FIRST run instead and pass 1 fails on its own reading of
#    /sys/class/net, so a second run that merely creates the tunnel itself
#    cannot carry the test. Pass 1 recording nothing is a failure too, at the
#    seq=2 barrier: pass 2 comparing against a file pass 1 never wrote is the
#    one outcome this test must never call green.
#
# The two ze runs are sequential, not concurrent: cmd=stop with signal=term
# reaps the first daemon before the second starts (internal/test/runner/
# runner_exec_util.go, stopBackgroundProcess). The first run is a background
# command so the runner waits for daemon.ready, which cmd/ze/hub/main.go writes
# only after WaitForStartupComplete -- that is, after the interface apply.
#
# daemon.ready is NOT a barrier for the observer, which is why seq=2 exists.
# WaitForStartupComplete returns as soon as startupDone is closed, and the
# goroutine that closes it has only just SPAWNED the post-startup delivery:
# sendPostStartupToAll (internal/component/plugin/server/startup.go) hands each
# plugin its callback to a goroutine and deliberately does not wait, so nothing
# orders "the ready file exists" against "the observer has been told". The stop
# step could therefore reach the daemon while the pass 1 observer was still
# blocked in wait_for_post_startup, and pass 1 then recorded nothing at all.
# The seq=2 barrier holds the stop until the recorded ifindex is on disk, so
# pass 1 cannot reach the stop step without having written the file.
#
# The endpoint pair 192.0.2.211 -> 198.51.100.211 is this test's own. The kernel
# refuses a second tunnel of one driver on a pair it already holds whatever the
# device is named, and the suites share one VM.
# TestCITunnelEndpointsAreUniqueAcrossTests
# (internal/test/runner/tunnel_endpoint_lint_test.go) enforces that. The same
# interface name appears in both configs below and is one holder there, because
# one device answers for both runs.

# Creating links needs CAP_NET_ADMIN, not merely Linux (ai/rules/platform-linux.md).
option=needs-linux:caps=net-admin

tmpfs=iface-tunnel-restart-boot.run:mode=755:terminator=EOF_BOOT
#!/usr/bin/env python3
"""First run: assert the tunnel was created, and record its kernel ifindex."""

import sys

from ze_api import API, runtime_fail

NAME = 'trs0'
IFINDEX_FILE = 'restart-ifindex'


def kernel_ifindex():
    """Read the ifindex the kernel holds for NAME, through sysfs.

    sysfs rather than `show interface`: the second run reads it the same way,
    and neither reading goes through the code under test.
    """
    path = '/sys/class/net/' + NAME + '/ifindex'
    try:
        with open(path) as handle:
            return handle.read().strip()
    except OSError as exc:
        runtime_fail(f'first run: {path}: {exc}: the kernel holds no netdev '
                     f'named {NAME}, so the tunnel was never created')
        return ''


def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()
    # Checked, not discarded: this returns False both on timeout and when the
    # daemon is already shutting down, and either one means this run records no
    # ifindex. Saying so here names the cause while ze is still alive to relay
    # the sentinel; the seq=2 barrier is what catches the case where it is not.
    if not api.wait_for_post_startup(timeout=5.0):
        runtime_fail('first run: post-startup never arrived, so the tunnel was '
                     'never read and pass 2 has no ifindex to compare against')

    index = kernel_ifindex()
    with open(IFINDEX_FILE, 'w') as handle:
        handle.write(index)
    print(f'OK: tunnel restart pass 1 created {NAME} ifindex {index}',
          file=sys.stderr)

    # No shutdown request: the runner stops this daemon with cmd=stop, which is
    # what makes the second run start against a process the OS has torn down.
    api.wait_for_shutdown(timeout=30.0)


if __name__ == '__main__':
    main()
EOF_BOOT

tmpfs=iface-tunnel-restart-check.run:mode=755:terminator=EOF_CHECK
#!/usr/bin/env python3
"""Second run: assert the apply kept the netdev the first run created."""

import json
import sys

from ze_api import API, dispatch, runtime_fail, result_text_data

NAME = 'trs0'
IFINDEX_FILE = 'restart-ifindex'


def decoded(resp, label):
    status = resp.get('status')
    if status != 'done':
        runtime_fail(f'{label}: status={status} data={result_text_data(resp)}')
    data = result_text_data(resp)
    if isinstance(data, str) and data:
        data = json.loads(data)
    return data


def kernel_ifindex():
    path = '/sys/class/net/' + NAME + '/ifindex'
    try:
        with open(path) as handle:
            return handle.read().strip()
    except OSError as exc:
        runtime_fail(f'second run: {path}: {exc}: the netdev the first run '
                     f'created did not survive the restart')
        return ''


def recorded_ifindex():
    """Read the ifindex pass 1 wrote, naming what is missing when it is not there.

    Without the except, a missing file raises FileNotFoundError, which unwinds
    through main's finally and is reported as a traceback carrying a bare
    filename -- the reader then has to know which run writes that file and why
    it might not have. The seq=2 barrier makes "pass 1 was merely late"
    unreachable here; what is left is a pass 1 that failed for a reason of its
    own, and this message says which run owes the file.
    """
    try:
        with open(IFINDEX_FILE) as handle:
            return handle.read().strip()
    except OSError as exc:
        runtime_fail(f'second run: {IFINDEX_FILE}: {exc}: the first run never '
                     f'recorded {NAME}, so this run has nothing to compare '
                     f'against')
        return ''


def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()
    api.wait_for_post_startup(timeout=5.0)

    try:
        before = recorded_ifindex()
        if not before:
            runtime_fail('the first run recorded an empty ifindex, so this run '
                         'has nothing to compare against')

        after = kernel_ifindex()
        if after != before:
            runtime_fail(f'{NAME} ifindex {before} -> {after}: the apply '
                         f'replaced the netdev instead of keeping it, so every '
                         f'flow crossing the tunnel was broken by the restart')

        # ze's own read must agree with the kernel: the interface is still
        # there AND the daemon can see it.
        every = decoded(dispatch(api, 'show interface'), 'interface-all')
        if not isinstance(every, list) or not every:
            runtime_fail(f'interface-all: expected a non-empty list, got {every!r}')
        present = {i.get('name') for i in every if isinstance(i, dict)}
        if NAME not in present:
            runtime_fail(f'{NAME} is in the kernel and absent from `show '
                         f'interface`, which reported {sorted(present)}')

        print(f'OK: tunnel restart pass 2 kept {NAME} same ifindex {after}',
              file=sys.stderr)
    finally:
        dispatch(api, 'request shutdown')
        api.wait_for_shutdown()


if __name__ == '__main__':
    main()
EOF_CHECK

# Barrier: hold the stop step until pass 1 has recorded the ifindex.
tmpfs=iface-tunnel-restart-wait.sh:terminator=EOF_WAIT
#!/bin/sh
# Poll, do not spin. `[` is a builtin, so a busy loop would fork nothing, and it
# would still starve the daemon it waits for on the two-vCPU QEMU VM this test
# runs in. `sleep 0.1` under /bin/sh is what the other needs-linux barrier in
# that VM uses (test/reload/test-tx-iface-tunnel-create.ci).
#
# The test is `-s`, non-empty: the observer creates the file and then writes the
# index into it, so an empty file means the write has not landed yet.
#
# 0.1s x 121 bounds the wait at ~12 seconds. The bound comes from the engine,
# not from taste: postStartupTimeout (internal/component/plugin/server/
# startup.go) abandons the post-startup delivery after 10 seconds, so a file
# that has not appeared by then can never appear. Waiting a little past that
# makes this barrier outlive the delivery it waits on, and it fails HERE, with
# the message below, rather than as an opaque outer timeout.
i=0
while [ "$i" -le 120 ]; do
	if [ -s restart-ifindex ]; then
		echo "OK: tunnel restart pass 1 recorded ifindex $(cat restart-ifindex)"
		exit 0
	fi
	i=$((i + 1))
	sleep 0.1
done
echo "pass 1 recorded no ifindex in restart-ifindex: its observer never reached the sysfs read, so pass 2 has nothing to compare against" >&2
ls -la . >&2
exit 1
EOF_WAIT

# First run's config. The interface stanza is byte-identical to the second
# run's: only the observer differs, so the restart applies one tunnel config
# twice.
stdin=boot:terminator=EOF_BOOT_CONF
plugin {
	external iface-tunnel-restart-boot {
		run ./iface-tunnel-restart-boot.run
		encoder json
	}
}

interface {
	backend netlink

	tunnel trs0 {
		encapsulation {
			gre {
				local { ip 192.0.2.211; }
				remote { ip 198.51.100.211; }
			}
		}
	}
}
EOF_BOOT_CONF

# Second run's config: same tunnel, the checking observer.
stdin=restart:terminator=EOF_RESTART_CONF
plugin {
	external iface-tunnel-restart-check {
		run ./iface-tunnel-restart-check.run
		encoder json
	}
}

interface {
	backend netlink

	tunnel trs0 {
		encapsulation {
			gre {
				local { ip 192.0.2.211; }
				remote { ip 198.51.100.211; }
			}
		}
	}
}
EOF_RESTART_CONF

cmd=background:seq=1:exec=ze -:stdin=boot:name=ze1
cmd=foreground:seq=2:exec=sh iface-tunnel-restart-wait.sh
cmd=stop:seq=3:name=ze1:signal=term
# 30s, not the 20s this carried before the seq=2 barrier: the barrier is allowed
# ~12s of its own, and the budget it sits inside has to leave room for that plus
# both daemon startups, or a barrier failure is reported as a bare timeout with
# the message it printed nowhere in the report.
cmd=foreground:seq=4:exec=ze -:stdin=restart:timeout=30s
expect=exit:code=0
expect=stderr:contains=OK: tunnel restart pass 1 created trs0 ifindex
# The barrier's own line: proof the stop step ran AFTER the ifindex was on disk,
# rather than the barrier having been skipped.
expect=stdout:contains=OK: tunnel restart pass 1 recorded ifindex
expect=stderr:contains=OK: tunnel restart pass 2 kept trs0 same ifindex
# The symptom the kept-netdev branch removes. A second start that fails the
# interface apply logs it and takes the daemon down with it.
reject=stderr:pattern=file exists
reject=stderr:pattern=panic
