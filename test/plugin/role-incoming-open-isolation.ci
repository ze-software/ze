# Test: can a rejected or losing TCP OPEN change the selected Customer's useful export?
# Unit and SDK-observer tests cannot decide whether the shipped daemon starts
# bgp-role, inserts its export filter, and preserves learned role through actual
# competing TCP OPENs and route-server forwarding to the same original socket.
# VALIDATES: an invalid Provider OPEN receives exact Role Mismatch2/11 and EOF;
# roleless and valid Customer OPENs pass role policy but lose collision6/7.
# After each outcome a fresh source route with an explicit customer export set
# reaches the original Customer socket with OTC65000, with no peer reconnect.
# PREVENTS: provisional OPEN validation replacing learned destination role,
# suppressing useful customer export or bypassing required OTC stamping.
# Scenario: internal/test/fixture/role_incoming_open.go.

option=timeout:value=90s

stdin=ze-bgp:terminator=EOF_CONF
bus {
	endpoint adj-rib-in {
		internal bgp-adj-rib-in;
	}
	endpoint rs {
		internal bgp-rs;
	}
	endpoint role-incoming-watch {
		external {
			run "le test fixture plugin/role-incoming-open-isolation 127.0.0.1:$PORT";
		}
		encoding json;
	}
}
bgp {
	filter {
		import { final accept; }
		export { final accept; }
	}
	peer source-peer {
		connection {
			local { ip 127.0.0.1; port $PORT; }
			remote { ip 127.0.0.2; connect false; }
		}
		session {
			rs-client true;
			asn { local 65000; remote 65001; }
			router-id 1.2.3.4
			family { ipv4/unicast { prefix { maximum 10000; } } }
		}
		role { import provider; export customer; }
	}
	peer dest-peer {
		connection {
			local { ip 127.0.0.1; port $PORT; }
			remote { ip 127.0.0.3; connect false; }
		}
		session {
			rs-client true;
			asn { local 65000; remote 65002; }
			router-id 1.2.3.4
			family { ipv4/unicast { prefix { maximum 10000; } } }
		}
		role { import provider; }
	}
}
EOF_CONF

cmd=foreground:seq=1:exec=ze --plugin ze.bgp-role -:stdin=ze-bgp:timeout=90s
expect=stderr:contains=OK: competing mismatched Provider OPEN received exact 2/11 and EOF; original Customer socket received fresh OTC-stamped route
expect=stderr:contains=OK: competing roleless OPEN received exact 6/7 and EOF; original Customer socket received fresh OTC-stamped route
expect=stderr:contains=OK: competing valid Customer OPEN received exact 6/7 and EOF; original Customer socket received fresh OTC-stamped route
reject=stderr:contains=ZE-OBSERVER-FAIL
reject=stderr:pattern=panic recovered|fatal error
expect=exit:code=0
