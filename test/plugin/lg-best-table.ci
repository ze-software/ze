# Test: Looking glass best-routes table and route count against the real bgp-rib
# VALIDATES: routes/table/{family} (handleAPIRoutesTable,
#            internal/component/lg/handler_api.go) answers the best path for
#            every prefix the RIB holds, learnt from its best peer and primary;
#            routes/count/protocol/{name} (handleAPIRoutesCount) answers the
#            number of routes stored for that peer; the UI peer page
#            (handleUIPeerRoutes) renders the prefix-length histogram.
# PREVENTS: the table asking bgp-rib for a spelling it refuses
#           (`show bgp rib best <family>`) or failing to read the `best-path`
#           envelope it answers, either of which rendered an empty table over a
#           full Loc-RIB; the count asking `show bgp rib count peer <name>`,
#           which bgp-rib refuses, rendered as 0.
#
# WHY THE REAL PLUGIN: the package tests feed copies of bgp-rib's answers
# (internal/component/lg/ribfake_test.go): the best-path rows, the route rows,
# the count and the histogram. This test is the check that each copy still
# matches the plugin, one assertion per answer.

# ze-peer expectations (minimal handshake)
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=25s
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# Native observer injects 15 distinct prefixes (10.20.0.0/24 to 10.20.14.0/24,
# from 10.0.1.1) and stays attached until shutdown.

# ze bgp configuration with LG enabled
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external lg-paginate {
		run "le test fixture plugin/lg-paginate"
		encoder json
	}
	internal bgp-rib {
		use bgp-rib
	}
}

environment {
	looking-glass {
		enabled true
		# TLS defaults ON since spec-fixit-mgmt-listener-auth-guard AC-5.
		# This test asserts looking-glass CONTENT over plain HTTP, so it takes
		# the documented opt-out rather than terminating a self-signed TLS
		# handshake; the opt-out working is part of AC-5.
		tls false
		server main {
			ip 127.0.0.1
			port $PORT2
		}
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65000
			}
			router-id 10.0.0.1
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}

		attach process bgp-rib {
			receive [ update state refresh ]
			send [ update ]
		}
	}

	# The peer the fixture injects its routes under. It never connects: it is
	# configured so the UI peer page (handleUIPeerRoutes, which 404s an address
	# no configured peer holds) renders the histogram bgp-rib answers for it.
	# A peer must connect or accept, so it listens on 127.0.0.2, where nothing
	# dials, leaving 127.0.0.1:$PORT to the test peer.
	peer injected {
		connection {
			remote {
				ip 10.0.1.1
				connect false
			}
			local {
				ip 127.0.0.2
				accept true
			}
		}
		session {
			asn {
				local 65000
				remote 65100
			}
			router-id 10.0.0.1
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
		}
	}
}
EOF_CONF

# Process orchestration -- both in background, HTTP checks are the assertions
cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer
cmd=background:seq=2:exec=ze -:stdin=ze-bgp

# Readiness: wait until the 15 routes are stored, read through the per-peer list,
# which does not depend on the endpoints under test.
http=wait:seq=1:url=http://127.0.0.1:$PORT2/api/looking-glass/routes/protocol/10.0.1.1:status=200:contains="routes_count": 15:timeout=15s

# --- the best table holds every stored prefix ---
http=get:seq=1:url=http://127.0.0.1:$PORT2/api/looking-glass/routes/table/ipv4%2Funicast:status=200:contains="routes_count": 15
http=get:seq=2:url=http://127.0.0.1:$PORT2/api/looking-glass/routes/table/ipv4%2Funicast:status=200:contains="network": "10.20.7.0/24"
http=get:seq=3:url=http://127.0.0.1:$PORT2/api/looking-glass/routes/table/ipv4%2Funicast:status=200:contains="learnt_from": "10.0.1.1"
http=get:seq=4:url=http://127.0.0.1:$PORT2/api/looking-glass/routes/table/ipv4%2Funicast:status=200:contains="primary": true

# --- the count is the stored count, not 0 ---
http=get:seq=5:url=http://127.0.0.1:$PORT2/api/looking-glass/routes/count/protocol/10.0.1.1:status=200:contains="routes": 15

# --- the UI peer page renders the histogram bgp-rib answers ---
# `show bgp rib peer <address> histogram` (handleUIPeerRoutes) is one
# of the answers ribfake_test.go copies; this row is the check that the copy still
# matches: one /24 row counting the 15 injected prefixes.
http=get:seq=6:url=http://127.0.0.1:$PORT2/lg/peer/10.0.1.1:status=200:contains=<tr><td>ipv4/unicast</td><td>/24</td><td>15</td></tr>
