# Test: bgp-rs refuses to start as an external plugin process
# VALIDATES: bgp-rs's IsInternal() guard (internal/component/bgp/plugins/rs/server.go, RunRouteServer)
# refuses to start when bgp-rs runs as a genuine external subprocess. Its DOWN
# handler asks retention.Family whether bgp-gr retains the departed peer's
# family, a same-process call: in a forked route server no Graceful Restart engine
# has published its answer, so every family reads as not retained.
# PREVENTS: an operator configuring `plugin { external rs { run ... } }`
# getting a route server that withdraws a restarting peer's routes from every
# other peer, which RFC 4724 Section 4.2 requires kept, with no error.
#
# The refusal aborts the daemon's plugin-startup coordinator, so the relayed
# stderr line is the signal, as in as112-external-refuses.ci.

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	hub {
		server local {
			ip 127.0.0.1;
			port 0;
			secret rs-external-refuse-test-secret-0001;
		}
	}
	external bgp-rs {
		# le test plugin-external launches the registered engine's own
		# RunEngine over a real TLS connect-back
		# (internal/test/cli/cmd_plugin_external.go).
		# The block carries the registered name: le test plugin-external
		# connects back under that name (sdk.DialTLSEnvRaw), and the hub
		# rejects a connect-back whose name no plugin block holds.
		run "le test plugin-external bgp-rs"
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast {
					prefix {
						maximum 10000
					}
				}
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

# The needle names bgp-rs, so another plugin's refusal cannot satisfy it.
cmd=foreground:seq=1:exec=ze -:stdin=ze-bgp:timeout=15s
await=stderr:contains=bgp-rs: refusing to start as an external plugin process -- the graceful-restart retention decision
expect=stderr:contains=bgp-rs: refusing to start as an external plugin process -- the graceful-restart retention decision
