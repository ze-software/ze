# Test: daemon start leaves vpn ipsec off under interface backend vpp and reports doctor-dataplane-mismatch.
# Question: does `ze start` on a file holding `interface backend vpp` and
#           `vpn ipsec` reach "Ze running", leave `vpn ipsec` off and reported
#           under `doctor-dataplane-mismatch` naming `vpn ipsec` and
#           `set interface backend kernel`, and keep the config file untouched,
#           while `ze config validate` still refuses the file?
# VALIDATES: 2026-11-26 owner ruling, Answer 2a
#            (plan/records/ruling-ze-always-starts.md) and
#            spec-dataplane-compatibility-guard AC-16 -- IPsec under VPP is
#            left off at daemon start and reported under
#            `doctor-dataplane-mismatch`, while `ze config validate` stays
#            strict.
# PREVENTS: IPsec blocking a VPP daemon from starting, or starting kernel XFRM
#           IPsec tunnels beside VPP interfaces, or rewriting disk config.

option=needs-build-tag:value=ze_vpp:state=present
option=needs-build-tag:value=ze_ike:state=present

tmpfs=vpp-ipsec.conf:refused=config-plugin-verify:terminator=EOF_CONF
interface {
	backend vpp;
}
vpn {
	ipsec {
		ike-group IKE-VPP {
			proposal 1 {
				encryption aes256gcm;
				hash sha256;
				dh-group 14;
			}
		}
		esp-group ESP-VPP {
			proposal 1 {
				encryption aes256gcm;
			}
		}
		site-to-site {
			peer branch-1 {
				ike-group IKE-VPP;
				esp-group ESP-VPP;
				local-address 127.0.0.1;
				remote-address 127.0.0.2;
				authentication {
					mode pre-shared-secret;
					pre-shared-secret 00ff410a1b2c3d4e5f60718293a4b5c6;
					pre-shared-secret-encoding hex;
				}
			}
		}
	}
}
EOF_CONF

# `ze config validate` stays strict and refuses the mismatch.
cmd=foreground:seq=1:exec=ze config validate vpp-ipsec.conf:timeout=20s
expect=exit:code=1
expect=stdout:contains=vpn ipsec
expect=stdout:contains=set interface backend kernel

# Daemon start succeeds, leaves vpn ipsec off, and reports doctor-dataplane-mismatch.
cmd=background:seq=2:name=daemon:exec=ze start vpp-ipsec.conf:ready=Ze running
expect=stderr:contains=that feature is left off; ze and its other services keep running
expect=stderr:contains=code=doctor-dataplane-mismatch
expect=stderr:contains=vpn ipsec
expect=stderr:contains=set interface backend kernel
reject=stderr:contains=error: load config:
reject=stderr:contains=ike peers started
reject=stderr:pattern=panic

cmd=stop:seq=3:name=daemon:signal=term

# Stored config file on disk stays untouched: validate still sees the mismatch.
cmd=foreground:seq=4:exec=ze config validate vpp-ipsec.conf:timeout=20s
expect=exit:code=1
expect=stdout:contains=set interface backend kernel
