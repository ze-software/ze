# Test: daemon start refuses vpn ipsec under interface backend vpp.
# Question: does `ze start` on a file holding `interface backend vpp` and
#           `vpn ipsec` exit 1 before any plugin starts, naming `vpn ipsec`
#           and `set interface backend kernel` with no start exception?
#           A unit test cannot prove `LoadConfig` at daemon start applies the
#           same verdict to IPsec as `ze config validate` with no boot bypass.
# VALIDATES: spec-dataplane-compatibility-guard AC-16 (C-5) -- a stored
#            configuration with IPsec under VPP refuses to boot, naming
#            `vpn ipsec` and `set interface backend kernel`.
# PREVENTS: a VPP daemon booting with kernel XFRM IPsec tunnels that carry no
#           VPP-forwarded traffic.

option=needs-build-tag:value=ze_vpp:state=present
option=needs-build-tag:value=ze_ike:state=present

stdin=ze-bgp:refused=config-plugin-verify:terminator=EOF_CONF
interface {
	backend vpp;
}
vpn {
	ipsec {
		ike-group IKE-VPP {
			proposal 1 {
				encryption aes256gcm;
				hash sha256;
				dh-group 14;
			}
		}
		esp-group ESP-VPP {
			proposal 1 {
				encryption aes256gcm;
			}
		}
		site-to-site {
			peer branch-1 {
				ike-group IKE-VPP;
				esp-group ESP-VPP;
				local-address 127.0.0.1;
				remote-address 127.0.0.2;
				authentication {
					mode pre-shared-secret;
					pre-shared-secret 00ff410a1b2c3d4e5f60718293a4b5c6;
					pre-shared-secret-encoding hex;
				}
			}
		}
	}
}
EOF_CONF

cmd=foreground:seq=1:exec=ze -:stdin=ze-bgp:timeout=30s
expect=exit:code=1
expect=stderr:contains=error: load config:
expect=stderr:contains=vpn ipsec
expect=stderr:contains=set interface backend kernel
reject=stderr:contains=interface backend loaded
reject=stderr:pattern=panic
