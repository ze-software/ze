# med-removal-export-refused -- the same operator directive on an EXPORT chain does nothing to
# the route, and says why.
#
# RFC requirement: RFC4271-5.1.4-2 negative -- "If a BGP speaker is configured to remove the
# MULTI_EXIT_DISC attribute from a route, then this removal MUST be done prior to determining the
# degree of preference of the route and prior to performing route selection (Decision Process
# phases 1 and 2)" (Section 5.1.4). An export chain runs AFTER those phases, so a removal there
# would be the ordering the MUST forbids. RFC 4271 Section 9.1.2.2 states what that ordering
# causes: "Including the MULTI_EXIT_DISC of an EBGP-learned route in the comparison with an
# IBGP-learned route, then removing the MULTI_EXIT_DISC attribute, and advertising the route has
# been proven to cause route loops."
#
# TWO HALVES, AND EACH ONE ALONE PROVES NOTHING. The metric REACHES the peer, which is the
# conformance outcome, and the daemon SAYS the directive was withheld, which is what stops a
# configured removal from silently not happening. The wire half is enforced by the engine
# (textDeltaToModOps skips the directive, and the export site never calls ExtractMEDRemoveOps);
# the log half is bgp-filter-modify's own refusal (appendMEDRemove,
# internal/component/bgp/plugins/filter_modify/filter_modify.go). Deleting the refusal turns
# `delta=med-remove` back on in the log and the reject line below goes red, while the wire stays
# where it is: that is the point, and it is why the log assertion is not decoration.
#
# THE RECEIVER IS A ROUTE SERVER CLIENT, so ze's automatic Section 5.1.4 strip does not fire for
# it (RFC 7947 Section 2.2.3, medPropagationAllowedTo, internal/component/bgp/reactor/forward_med.go).
# The metric arriving is therefore attributable to the export chain doing nothing, rather than to
# an exemption that was going to keep it anyway. med-removal-configured.ci is the same topology
# with the directive on the IMPORT chain, where the metric is gone.

option=env:var=ze.log.bgp.filter.modify:value=info

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=2
option=timeout:value=20s
option=bind:value=0.0.0.0
# Bind conn=N by remote IP rather than accept order: which client connects first is a race
# (peer_connmap.go).
option=conn_map:value=remote-ip

# Source peer (conn=1, AS 65001): announce 10.0.0.0/24 carrying a metric.
#   ORIGIN:    40010100            IGP
#   AS_PATH:   40020602010000FDE9  AS_SEQUENCE[65001], 4-byte ASNs
#   NEXT_HOP:  40030401010101      1.1.1.1
#   MED:       80040400000064      100 -- the attribute the export directive fails to remove
#   NLRI:      180A0000            10.0.0.0/24
# attr len = 4+9+7+7 = 27 = 0x1B; total = 19+2+2+27+4 = 54 = 0x36.
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0036020000001B4001010040020602010000FDE94003040101010180040400000064180A0000

# The source's own EOR.
expect=bgp:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000

# Receiver (conn=2, AS 65002, rs-client TRUE): the source frame, byte for byte, MED included.
expect=bgp:conn=2:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0036020000001B4001010040020602010000FDE94003040101010180040400000064180A0000
EOF_PEER

# Observer: wait until every client has been replayed to, then shut down.
tmpfs=shutdown-after-up.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
from ze_api import API

API().run_rs_observer(expected_peers=2, forward_prefix="10.0.0.0/24")
EOF_RUN

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	internal rs {
		use bgp-rs
	}
	external shutdown-after-up {
		run ./shutdown-after-up.run
		encoder json
	}
}
bgp {
	policy {
		# The same definition med-removal-configured.ci attaches to an import chain.
		modify DROP-MED {
			set {
				med-remove true
			}
		}
	}

	peer source-peer {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
	peer rs-client-receiver {
		connection {
			remote {
				ip 127.0.0.2
			}
			local {
				ip 127.0.0.2
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65002
			}
			router-id 1.2.3.4
			# RFC 7947 Section 2.2.3 exempts this peer from the automatic Section 5.1.4
			# strip, so nothing but the export directive could take the metric off.
			rs-client true
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		# EXPORT, which is the direction the mechanism is not honored on.
		filter {
			export [ modify:DROP-MED ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze --plugin ze.bgp-filter-modify -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
expect=stderr:pattern=med-remove is an import-chain mechanism
reject=stderr:pattern=delta=med-remove
reject=stderr:pattern=panic
reject=stderr:pattern=fatal error
reject=stderr:pattern=forward-cached failed
reject=stderr:pattern=release-cached failed
