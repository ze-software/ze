# Test: redistribute-as112-community -- an origin-AS redistribute carries the
# producer's COMMUNITIES onto the wire. fakeas112 emits `community nopeer`
# (RFC 3765 NOPEER = 0xFFFFFF04 = 65535:65284, RFC 7534's recommended community
# for AS112 routes to bilateral peers), and the reactor attaches it to every
# covering prefix.
#
# The JSON expectation below reads `"community": ["nopeer"]`: renderAttributeZe
# (internal/component/bgp/cli/decode_update.go) files attribute code 8 under the
# key `community`, and parseCommunities renders each value through
# Community.String, which answers with the well-known name the registry carries
# (internal/core/bgp/attribute/community.go, CommunityNoPeer). That key was
# ABSENT from this expectation until 2026-08-19, because case 8 reached no arm of
# that switch and the attribute vanished from the output. The wire assertions
# above always carried C00804FFFFFF04, so the golden recorded the absence of a
# community the same UPDATE was proven to carry.
#
# VALIDATES: RouteChangeBatch.Community -> COMMUNITIES on the announced covering
#            prefixes, alongside origin igp + AS_PATH [112] (iBGP).
# PREVENTS: the community list being dropped on redistribution.

# ze-peer -- iBGP session. The bgp contains= rule matches AS_PATH [112] +
# NEXT_HOP + LOCAL_PREF + COMMUNITIES 0xFFFFFF04 + NLRI tail of each covering
# UPDATE; matching both completes the peer so the JSON validator runs.
#
# These two hex strings used to read ...C00804FFFFFF04 4005040000006418..., i.e.
# COMMUNITIES (type 8) BEFORE LOCAL_PREF (type 5). That is the wire this daemon
# emitted, and it violated RFC 4271 Section 5 ("The sender of an UPDATE message
# SHOULD order path attributes within the UPDATE message in ascending order of
# attribute type"): the batch announce builder appended LOCAL_PREF after the
# producer's attribute block instead of placing it at its type-code position. The
# builder was fixed (reactor_api_batch.go insertAttrOrdered) and these fixtures
# corrected to the conformant order -- they were pinning the defect, not the
# behaviour.
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
expect=bgp:conn=1:seq=1:contains=4002060201000000704003047F00000240050400000064C00804FFFFFF0418C0AF30
expect=bgp:conn=1:seq=1:contains=4002060201000000704003047F00000240050400000064C00804FFFFFF0418C01FC4
expect=json:conn=1:seq=1:json={"meta":{"version":"1.0.0","format":"ze-bgp"},"message":{"type":"update"},"origin":"igp","as-path":[112],"local-preference":100,"community":["nopeer"],"ipv4/unicast":[{"action":"add","nlri":["192.175.48.0/24"],"next-hop":"127.0.0.2"}]}
EOF_PEER

# ze configuration
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external as112-community-test {
		run "ze-test fixture plugin/redistribute-as112-community"
		encoder json
	}
	internal redistribute-orchestrator {
		use redistribute-orchestrator
	}
	internal fakeas112 {
		use fakeas112
	}
}

redistribute {
	destination bgp {
		import as112 {
			family [ ipv4/unicast ];
		}
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			# Ze's own address on this session, and what `nhop self` puts on the
			# wire. It is deliberately NOT peer1's 127.0.0.1: RFC 4271 Section
			# 5.1.3 forbids a peer its own address as NEXT_HOP, and
			# originatedNextHopIsPeerOwn (reactor/forward_next_hop.go) withholds
			# the route when the two match.
			local {
				ip 127.0.0.2
				accept false
			}
		}
		session {
			asn {
				local 65533
				remote 65533
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		attach process redistribute-orchestrator {
			send [ update ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
reject=stderr:pattern=panic recovered
reject=stderr:pattern=fatal error
