# Test: clear peeringdb cache all and asn empty the PeeringDB client cache
# Exercises: dispatch-command -> ze-resolve:clear-peeringdb-cache-{all,asn}
# Verifies: the bare clear peeringdb cache is refused and clears nothing; asn
#           and all each make the next resolve peeringdb as-set reach the mock
#           again (its AS-SERVED-<n> answer counts the requests it served).

# ze-peer: accepts connection
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
option=asn:value=65001
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER


stdin=ze-bgp:terminator=EOF_CONF
system {
	peeringdb {
		url http://127.0.0.1:$PORT2
	}
}

plugin {
	external clear-peeringdb-cache-test {
		run "le test fixture plugin/clear-peeringdb-cache"
		encoder json
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast {
					prefix {
						maximum 10000
					}
				}
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=le mock peeringdb --port $PORT2 --served-count
cmd=background:seq=2:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=3:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
