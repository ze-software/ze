# ExaBGP script endpoint (default text encoder): runs via the external wrapper
# `ze exabgp plugin` declared under `bus { endpoint helper { external ... } }`
# (E-1, E-7). The announce and resulting wire UPDATE match the explicit JSON
# encoder test (exabgp-bridge-sdk.ci).

# ze-peer expectations
stdin=peer:terminator=EOF_PEER
cmd=api:conn=1:seq=1:text=send bgp * update text origin igp local-preference 100 nhop 101.1.101.1 nlri add 1.1.0.0/24
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0030020000001540010100400200400304650165014005040000006418010100
EOF_PEER

# Compiled ExaBGP-style helper writes one text command to stdout.

# ze bgp configuration: ExaBGP script runs via the external `ze exabgp plugin`
# wrapper endpoint on the bus.
stdin=ze-bgp:terminator=EOF_CONF
bus {
	endpoint helper {
		external {
			run "ze exabgp plugin --family ipv4/unicast le test fixture plugin/exabgp-bridge-helper";
		}
		encoding json;
	}
}
bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
