# Test: a withdraw-only UPDATE from an ADD-PATH peer reaches a plugin as a del
# of the prefix it names, with its Path Identifier.
# VALIDATES: ze negotiates ADD-PATH receive for ipv4/unicast (le test peer answers
# send, invertedAddPath in internal/test/peer/open_capability.go). ze-peer announces
# 10.0.0.0/8 with Path Identifier 7, then sends an UPDATE whose only field is
# Withdrawn Routes [00000007][8][10] with a zero Total Path Attribute Length.
# The JSON event the attached plugin receives carries
# "ipv4/unicast":[{"action":"del","nlri":[{"prefix":"10.0.0.0/8","path-id":7}]}],
# which the fixture prints as "ADDPATH-EVENT: del 10.0.0.0/8 path-id 7" (ze
# relays plugin stderr through its logger, which escapes quotes, so the line
# holds none).
# PREVENTS: the formatter reading the ADD-PATH context from the attribute
# section, which a withdraw-only UPDATE does not have: the withdrawn routes were
# then walked with no Path Identifier, 00000007 read as three 0.0.0.0/0 and the
# event held no withdrawal of 10.0.0.0/8.
# RFC 7911 Section 3: "In order to carry the Path Identifier in an UPDATE
# message, the NLRI encoding MUST be extended by prepending the Path Identifier
# field, which is of four octets."

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
option=linger:value=true
option=asn:value=65001
# ORIGIN IGP, AS_PATH [65001], NEXT_HOP 192.0.2.1, NLRI [00000007][8][10].
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF003102000000144001010040020602010000FDE9400304C000020100000007080A
# Withdrawn Routes [00000007][8][10], no path attributes, no NLRI.
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF001D02000600000007080A0000
EOF_PEER

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external addpath-withdraw-event {
		run "le test fixture plugin/addpath-withdraw-event"
		encoder json
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				add-path {
					direction receive
					family {
						ipv4/unicast
					}
				}
			}
		}
		behavior {
			group-updates disable
		}

		attach process addpath-withdraw-event {
			receive [ update-received ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=30s
expect=stderr:contains=ADDPATH-EVENT: add 10.0.0.0/8 path-id 7
expect=stderr:contains=ADDPATH-EVENT: del 10.0.0.0/8 path-id 7
