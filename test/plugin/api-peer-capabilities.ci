# Test: bgp peer capabilities shows negotiated capabilities
# VALIDATES: capabilities returns negotiated data with families for the peer,
#   as one row under "peers" whatever the number of matched peers
# PREVENTS: capabilities returning empty, and its answer changing shape with
#   the number of peers it matched

# ze-peer expectations
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
option=linger:value=true
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# Native test plugin: exercises dispatch-command for peer capabilities

# ze bgp configuration
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external peer-caps-test {
		run "ze-test fixture plugin/api-peer-capabilities"
		encoder json
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
