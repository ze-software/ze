# Test: as112 with `tls { enabled true }` starts and applies the DNS-over-TLS
# (RFC 7858) listener config through the real ze binary; the node answers
# `show as112` with enabled=true and the DoT listener is bound on the port.
# Exercises: OnConfigure -> as112Server.applyConfig -> dnsserver.ApplyWithSecure
#   -> bindDoT (dns.Server over tls.NewListener). Verifies AC-3 wiring.
# The DoT *transport* is proven by internal/core/dnsserver.TestDoTListener
# (real tcp-tls client + real cert root) and the interop runbook in the spec.

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
option=asn:value=65001
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

tmpfs=as112-dot-test.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
import json
import sys
from ze_api import API, runtime_fail, result_text_data

def dispatch(api, command):
    resp = api._call_engine(
        'ze-plugin-engine:dispatch-command', {'command': command})
    if resp is None:
        return {'status': 'error', 'data': 'engine call returned None'}
    return resp.get('result', {})

def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()
    api.wait_for_post_startup(timeout=5.0)

    try:
        resp = dispatch(api, 'show as112')
        status = resp.get('status')
        if status != 'done':
            runtime_fail(f'as112: status={status} data={resp.get("data")}')

        data = result_text_data(resp)
        if isinstance(data, str) and data:
            data = json.loads(data)
        if not isinstance(data, dict):
            runtime_fail(f'as112: expected dict, got {type(data).__name__}')
        if data.get('enabled') is not True:
            runtime_fail(f'as112: expected enabled=true, got {data.get("enabled")}')
        if data.get('zones') != 22:
            runtime_fail(f'as112: expected zones=22, got {data.get("zones")}')

        # Prove the DoT listener (RFC 7858) is bound on the configured port. A
        # plain TCP connect is enough; the TLS handshake + query are proven by
        # the Go unit test TestDoTListener and the spec's interop runbook (the
        # observer sandbox cannot import Python's ssl to drive a handshake).
        import socket
        bound = False
        for _ in range(20):
            try:
                with socket.create_connection(('127.0.0.1', 18853), timeout=1):
                    bound = True
                    break
            except OSError:
                pass
        if not bound:
            runtime_fail('dot: listener not bound on 127.0.0.1:18853')

        print(f'OK: as112 enabled={data["enabled"]} zones={data["zones"]} dot-bound', file=sys.stderr)
    finally:
        dispatch(api, 'request shutdown')
        api.wait_for_shutdown()

if __name__ == '__main__':
    main()
EOF_RUN

stdin=ze-bgp:terminator=EOF_CONF
service {
	as112 {
		enabled true
		tls {
			enabled true
			listen-port 18853
		}
	}
}

plugin {
	external as112-dot-test {
		run ./as112-dot-test.run
		encoder json
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast {
					prefix {
						maximum 10000
					}
				}
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
