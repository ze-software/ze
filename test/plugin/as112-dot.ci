# Test: as112 with `tls { enabled true }` starts and applies the DNS-over-TLS
# (RFC 7858) listener config through the real ze binary; the node answers
# `show as112` with enabled=true and the DoT listener is bound on the port.
# Exercises: OnConfigure -> as112Server.applyConfig -> dnsserver.ApplyWithSecure
#   -> bindDoT (dns.Server over tls.NewListener). Verifies AC-3 wiring.
# The DoT *transport* is proven by internal/core/dnsserver.TestDoTListener
# (real tcp-tls client + real cert root) and the interop runbook in the spec.

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
option=asn:value=65001
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER


stdin=ze-bgp:terminator=EOF_CONF
service {
	as112 {
		enabled true
		tls {
			enabled true
			listen-port 18853
		}
	}
}

plugin {
	external as112-dot-test {
		run "ze-test fixture plugin/as112-dot"
		encoder json
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast {
					prefix {
						maximum 10000
					}
				}
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
