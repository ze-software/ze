# Test: rib best reason terminal narrates decision steps
# VALIDATES: cmd-9 AC-1 -- rib best reason shows decision steps with winner/loser
# VALIDATES: cmd-9 AC-2 -- local-pref difference identified as deciding factor
# PREVENTS: reason terminal not wired or returning empty JSON

# One real peer sends a route. Python observer injects a second route for a
# synthetic peer via bgp rib inject. Then queries rib best reason and verifies
# the JSON output shows the local-preference deciding step.

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=20s
# The best-path-reason assertion needs BOTH candidates for 10.1.0.0/24: the one
# injected synthetically (10.0.0.99) and the one learned from THIS peer over the
# wire. The wire candidate exists only while this session is up: when the peer
# goes away ze correctly withdraws it, leaving a single candidate. Without linger
# the peer exits the instant it receives ze's End-of-RIB, so the test only passed
# by winning a ~500ms race (ze holds the EOR behind the initial-sync barrier,
# peer_initial_sync.go). linger holds the session open past the expectation,
# making the candidate-count assertion independent of host load.
option=linger:value=true

# Send IPv4 UPDATE with LOCAL_PREF=200
# ORIGIN=IGP, AS_PATH=[65001], NEXT_HOP=10.0.0.1, LOCAL_PREF=200, NLRI=10.1.0.0/24
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0036020000001B4001010040020602010000FDE94003040A000001400504000000C8180A0100
# Assert ze's ipv4/unicast End-of-RIB (RFC 4724 S2: the empty UPDATE). This is a
# real wire assertion, not just a TCP-hold: the observer gates `request shutdown`
# on eor-sent >= 1 (see wait_eor_sent below), so ze is given the chance to emit it.
# It also keeps the peer from closing TCP while the observer polls for peer state.
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

tmpfs=reason-test.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
import json
import sys
import time
from ze_api import API, runtime_fail, result_text_data, result_json_data

def dispatch(api, command):
    resp = api._call_engine(
        'ze-plugin-engine:dispatch-command', {'command': command})
    if resp is None:
        return {'status': 'error', 'data': 'engine call returned None'}
    return resp.get('result', {})

def eor_sent(result):
    """True once ze has written its End-of-RIB to at least one peer.

    `show bgp peer <sel> detail` returns {"peers": {"<ip>": {..., "eor-sent": N}}}
    (peer.go:217, :341-345). The counter is incremented at the EOR write itself
    (peer_initial_sync.go:334-335), so eor-sent >= 1 proves the marker is on the
    wire rather than merely scheduled.
    """
    if result.get('status') != 'done':
        return False
    try:
        peers = result_json_data(result, {}).get('peers', {})
    except (json.JSONDecodeError, TypeError, ValueError):
        return False
    return any(p.get('eor-sent', 0) >= 1 for p in peers.values())

def wait_eor_sent(api, selector):
    """Block until ze has sent its EOR, so `request shutdown` cannot pre-empt it.

    The peer block asserts ze's End-of-RIB on the wire. ze emits it only after the
    initial-sync barrier: peer_initial_sync.go:174-178 sleeps 500ms and then waits
    for the plugin ready signal before :332-337 builds and sends the EOR. The
    session reaches `established` long before that, so a shutdown gated on
    establishment (or on the RIB check) closes TCP first and the peer's expectation
    can never fire. Gate on the EOR the test actually asserts.
    """
    if not eor_sent(api.dispatch_until(
            f'show bgp peer {selector} detail', eor_sent, attempts=40)):
        runtime_fail(f'ze never sent its End-of-RIB to {selector}')

def reason_ready(result):
    """True once 10.1.0.0/24 has >=2 best-path candidates (both routes seen)."""
    data = result_text_data(result, '{}')
    try:
        parsed = json.loads(data) if isinstance(data, str) else data
    except (json.JSONDecodeError, TypeError):
        return False
    for entry in parsed.get('best-path-reason', []):
        if entry.get('prefix') == '10.1.0.0/24' and len(entry.get('candidates', [])) >= 2:
            return True
    return False

def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()

    # Wait for peer1's initial sync to reach the wire before injecting anything.
    #
    # // test-relax: the `'established' in <detail json>` check removed here was
    # VACUOUS, not coverage: every peer row carries the KEY
    # `connections-established` (cmd/peer/peer.go:238), so the substring matched
    # on the FIRST poll -- before any session existed -- and the barrier returned
    # instantly, gating none of the assertions below it. Replaced by this file's
    # own wait_eor_sent, which polls the per-peer `eor-sent` counter
    # (peer.go:217, incremented at peer_initial_sync.go:353 immediately after the
    # EOR is written to the session). eor-sent >= 1 strictly implies established,
    # so this is stronger than the check it replaces and it fails loudly.
    wait_eor_sent(api, 'peer1')

    # // test-relax: dropped blind 1.0s sleep; the dispatch_until on rib best reason below is the real barrier

    # Inject a second route from synthetic peer with lower LOCAL_PREF
    result = dispatch(api, 'request bgp rib inject 10.0.0.99 ipv4/unicast 10.1.0.0/24 origin igp aspath 65002 localpref 100')
    if result.get('status') != 'done':
        runtime_fail(f'rib inject failed: {result}')

    # Query rib best reason, polling until the injected candidate is visible.
    # // test-relax: blind 0.5s sleep after inject -> dispatch_until until 10.1.0.0/24 has >=2 candidates
    result = api.dispatch_until('show bgp rib best reason', reason_ready)
    if result.get('status') != 'done':
        runtime_fail(f'rib best reason failed: {result}')

    data = result_text_data(result, '{}')
    parsed = json.loads(data) if isinstance(data, str) else data
    entries = parsed.get('best-path-reason', [])

    if not entries:
        runtime_fail(f'best-path-reason array is empty, raw: {data[:200]}')

    # Find the entry for 10.1.0.0/24
    found = None
    for entry in entries:
        if entry.get('prefix') == '10.1.0.0/24':
            found = entry
            break

    if found is None:
        runtime_fail(f'no reason entry for 10.1.0.0/24, got: {[e.get("prefix") for e in entries]}')

    # Verify there are candidates and steps
    candidates = found.get('candidates', [])
    if len(candidates) < 2:
        runtime_fail(f'expected 2+ candidates, got {len(candidates)}: {candidates}')

    steps = found.get('steps', [])
    if not steps:
        runtime_fail(f'no decision steps, candidates: {candidates}')

    step = steps[0]
    if 'local-preference' not in step.get('step', ''):
        runtime_fail(f'expected local-preference step, got: {step}')

    reason = step.get('reason', '')
    if '200' not in reason or '100' not in reason:
        runtime_fail(f'reason should mention LP 200 and 100, got: {reason}')

    print(f'OK: best-path reason: {step["step"]} {reason}', file=sys.stderr)

    wait_eor_sent(api, 'peer1')

    dispatch(api, 'request shutdown')
    api.wait_for_shutdown()

if __name__ == '__main__':
    main()
EOF_RUN

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external reason-test {
		run ./reason-test.run
		encoder json
	}
	internal bgp-rib {
		use bgp-rib
	}
}
bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65000
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}

		process reason-test {
		}
		process bgp-rib {
			receive [ state ]
			send [ update ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
reject=stderr:pattern=panic recovered
reject=stderr:pattern=fatal error
reject=stderr:pattern=ZE-OBSERVER-FAIL
