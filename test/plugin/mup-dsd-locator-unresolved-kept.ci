# mup-dsd-locator-unresolved-kept -- draft-ietf-bess-mup-safi Section 3.3.6
# unresolved locator originator -> keep route + Warn + report-bus warning
# (`doctor-bgp-mup-locator-unresolved`), visible in `show warnings` and `show doctor`.
#
# No IS-IS instance or locator-origin publisher runs, so the in-daemon locator-origin
# index has no active source. A peer announces DSD route D4 carrying Prefix-SID
# 2001:db8::1 with IPv6 next hop 2001:db8:140::1. Ze MUST keep D4 (never falsely
# withdraw it), relay D4 to receiver-peer, retain D4 in Adj-RIB-In, log a Warn
# carrying doctor-bgp-mup-locator-unresolved, and raise the warning on the daemon
# report bus so `show warnings` and `show doctor` surface it.

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=2
option=timeout:value=20s
option=bind:value=0.0.0.0
option=linger:value=true
option=conn_map:value=remote-ip

# seq=1: DSD D4 with IPv6 next hop 2001:db8:140::1 and Prefix-SID 2001:db8::1.
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF006B02000000544001010040020602010000FDE9800E250001551020010DB8014000000000000000000001000100020C0000FDE900000001C0000201C0281C050019000100150020010DB800000000000000000000000100001300

# seq=2: IPv4 unicast fence 10.0.0.0/24.
action=send:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002F02000000144001010040020602010000FDE940030401010101180A0000

# Receiver (conn=2): D4 is kept and relayed, followed by the fence.
expect=bgp:conn=2:seq=1:contains=0100020C0000FDE900000001C0000201
expect=bgp:conn=2:seq=2:announced=180A0000

# D4 is never synthesized as an MP_UNREACH_NLRI withdrawal.
reject=bgp:conn=2:pattern=0001550100020C0000FDE900000001C0000201

EOF_PEER

stdin=ze-bgp:terminator=EOF_CONF
bus {
	endpoint bgp-rib {
		internal bgp-rib;
		receive { allow none; }
		send { allow none; }
	}
	endpoint rs {
		internal bgp-rs;
	}
	endpoint adj-rib-in {
		internal bgp-adj-rib-in;
		send {
			message bgp:update { to none; }
		}
	}
	endpoint mup-sd-observer {
		external {
			run "le test fixture plugin/mup-segment-discovery-observer --keep=0100020c0000fde900000001c0000201 --expect-warning=doctor-bgp-mup-locator-unresolved --expect-doctor=doctor-bgp-mup-locator-unresolved";
		}
		encoding json;
	}
}
bgp {
	filter {
		import { final accept; }
		export { final accept; }
	}
	peer source-peer {
		connection {
			remote { ip 127.0.0.1 }
			local { ip 127.0.0.1; accept false }
		}
		session {
			rs-client true;
			asn { local 65000; remote 65001 }
			router-id 1.2.3.4
			accept-srv6-prefix-sid true
			family {
				ipv4/unicast { prefix { maximum 10000; } }
				ipv4/mup { prefix { maximum 10000; } }
			}
			capability { graceful-restart disable }
		}
		behavior { group-updates disable }
	}
	peer receiver-peer {
		connection {
			remote { ip 127.0.0.2 }
			local { ip 127.0.0.2; accept false }
		}
		session {
			rs-client true;
			asn { local 65000; remote 65002 }
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
				ipv4/mup { prefix { maximum 10000; } }
			}
			capability { graceful-restart disable }
		}
		behavior { group-updates disable }
	}
}
EOF_CONF

cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
expect=stderr:contains=doctor-bgp-mup-locator-unresolved
reject=stderr:pattern=doctor-bgp-mup-locator-mismatch
reject=stderr:pattern=panic
reject=stderr:pattern=fatal error
