# Test: bgp summary returns valid dashboard data via dispatch-command
# VALIDATES: AC-1 — monitor bgp can reach summary data through dispatch-command
# PREVENTS: dashboard wiring broken — summary RPC not reachable

# ze-peer expectations
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# Compiled observer exercises dispatch-command for the BGP summary.

# ze bgp configuration
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external dashboard-test {
		run "ze-test fixture plugin/bgp-monitor-dashboard"
		encoder json
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
