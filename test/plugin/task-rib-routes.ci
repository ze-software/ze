# task-rib-routes - a long operation is tasked by the server, polled, and its
# result collected from tasks/get.
#
# VALIDATES: spec-mcp2026-3-tasks-extension AC-1, AC-2 and AC-3, end to end:
# server-directed creation -> worker dispatch -> tasks/get poll -> terminal
# payload, with a real route in the RIB so the retrieved result carries content.
#
# WHAT CHANGED AND WHY: the pre-cutover file sent `task:{}` to opt the call into
# task execution and then collected the output with a blocking `tasks/result`
# call. Both are gone. MCP 2026-07-28 changelog Major change 6 "replaces the
# blocking tasks/result method with polling via tasks/get" and "allows servers
# to return task handles unsolicited without per-request opt-in", so the client
# now sends an ordinary tools/call and the payload rides on the same tasks/get
# that reports the status.
#
# That payload move is why this test matters more than it used to. The result is
# now stored BEFORE the state goes terminal (runTaskWorker, internal/component/
# mcp/tasks.go): a client polls, sees a terminal status, and reads the result
# from that SAME response. If the two were ordered the other way there would be a
# window where the task reads terminal with an empty payload and a correct client
# would conclude it finished with no output and stop polling. The assertion that
# the route text comes back is what closes that window.

# ze-peer: send one route then expect EOR from ze
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
option=update:value=send-route:prefix=10.0.0.0/24:next-hop=10.0.0.1:origin-as=65001
# The peer MUST hold the session open after its EOR expectation is met. Without
# linger it closes as soon as it is satisfied, ze reads that as session-down and
# withdraws the peer's routes -- so the RIB query below would race an empty RIB.
option=linger:value=true
# EOR from ze
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

stdin=mcp:terminator=EOF_MCP
wait-established
# No readiness signal: wait-established polls until ze reports the peer up, but
# nothing this client can query says the peer's UPDATE has been installed in the
# Adj-RIB-In. ze-test mcp has no "poll a command until its output contains X"
# directive, so this remains a fixed hold rather than a condition wait.
wait 1s
# An ORDINARY tools/call. ze_show_bgp carries `ze:task-support required`, so the
# server returns a task handle unasked; task-call fails the run unless the reply
# really is resultType "task" with a taskId, so the server-directed creation is
# enforced rather than assumed.
task-call ze_show_bgp {"action":"rib"}
# AC-2 then AC-3: poll until terminal, then read the payload the terminal
# response carries. task-result now reads `result` off tasks/get and fails if a
# terminal task carries neither a result nor an error.
task-wait $LAST completed
task-result $LAST
EOF_MCP

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	internal bgp-rib {
		use bgp-rib
	}
	internal bgp-adj-rib-in {
		use bgp-adj-rib-in
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
		}
		behavior {
			group-updates disable
		}
		attach process bgp-adj-rib-in {
			receive [ update-received state ]
		}
		attach process bgp-rib {
			receive [ update state refresh ]
			send [ update ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=background:seq=2:exec=ze --mcp $PORT2 -:stdin=ze-bgp
cmd=foreground:seq=3:exec=ze-test mcp --port $PORT2 --tasks:stdin=mcp:timeout=20s
# Declaring an exit code is what makes the runner wait on -- and judge -- the
# MCP client at all; without it the peer's EOR would be the only thing checked.
expect=exit:code=0
# The terminal tasks/get really carried the route the peer announced, so the
# whole chain moved real data rather than an empty envelope.
expect=stdout:contains=10.0.0.0/24
# `show bgp rib` answers FLAT ROWS: one envelope under `routes`, one row per
# route, each row carrying `peer` and `direction` as fields (owner ruling,
# 2026-08-23). It answered an object keyed by direction and then by peer
# before, which is where `adj-rib-in` came from. Asserting the row FIELD is
# a stronger check than the envelope key was: it proves a route came back
# and says which way it went, where the key only proved an envelope existed.
expect=stdout:contains=direction
expect=stdout:contains=routes
# The terminal state is asserted by `task-wait $LAST completed` above: it errors
# out if the task reaches any OTHER terminal state and times out if it reaches
# none.
# // the two stdout needles here (`contains=code -32021` and
# `contains=code -32602`) were removed, not weakened. They could never match
# whatever the server did: formatProbeResult prints `code=<n>` and the
# space-separated spelling exists only in a client error string that goes to
# stderr -- and this file sends no probe at all, so stdout carries no `code=`
# token in either spelling. The stderr rejects below are the live guards and
# are unchanged; a refusal here fails the client, which `expect=exit:code=0`
# already catches.
reject=stderr:pattern=code \-32021
reject=stderr:pattern=code \-32602
