# task-rib-routes - run rib routes as a task, poll to completed, retrieve result
# Exercises: createTask -> worker dispatch -> tasks/get poll -> tasks/result

# ze-peer: send one route then expect EOR from ze
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
option=update:value=send-route:prefix=10.0.0.0/24:next-hop=10.0.0.1:origin-as=65001
# EOR from ze
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# MCP commands: wait for session, then run rib routes as a task
stdin=mcp:terminator=EOF_MCP
wait-established
wait 1s
task-call ze_rib {"action":"routes","peer":"*"}
task-wait $LAST completed
task-result $LAST
EOF_MCP

# Ze config: single peer
stdin=ze-bgp:terminator=EOF_CONF
bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=background:seq=2:exec=ze --mcp $PORT2 -:stdin=ze-bgp
cmd=foreground:seq=3:exec=ze-test mcp --port $PORT2 --tasks:stdin=mcp:timeout=15s
