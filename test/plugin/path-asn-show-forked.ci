# Test: a forked reject-asn command process receives both policy and BGP roots
# VALIDATES: real TLS config delivery installs the named list and its attachment
# count, and the command dispatcher returns both positive and unknown-name answers.
# PREVENTS: forked show commands reporting empty lists because WantsConfig omitted policy.
# Method: reuse the unchanged path-asn-show native observer, which checks list
# NO-TRANSIT, ASN3356, transit+origin, import-peers=1, a named query and an unknown
# name error. Only the transport of the command owner differs from the live test.

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=20s
option=asn:value=65001
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

stdin=ze-bgp:terminator=EOF_CONF
plugin {
    hub { server local { ip 127.0.0.1; port 0; secret path-asn-show-forked-secret-00000001; } }
    external bgp-filter-path-asn {
        run "ze plugin bgp-filter-path-asn"
    }
    external test-path-asn-show {
        run "le test fixture plugin/path-asn-show"
        encoder json
    }
}
policy {
    reject-asn NO-TRANSIT {
        indirect [ 3356 ]
    }
    match reject-asn-NO-TRANSIT {
        reject-asn NO-TRANSIT
    }
}
bgp {
    peer peer1 {
        connection {
            remote { ip 127.0.0.1; }
            local { ip 127.0.0.1; accept false; }
        }
        session {
            asn { local 65000; remote 65001; }
            router-id 1.2.3.4
            family { ipv4/unicast { prefix { maximum 10000; } } }
        }
        filter {
            export { final accept; }
            import { filters [ reject-asn-NO-TRANSIT ]; final accept; }
        }
        attach process test-path-asn-show { receive [ update state ]; }
    }
}
EOF_CONF

cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
expect=stderr:pattern=OK: reject-asn show answered
reject=stderr:pattern=ZE-OBSERVER-FAIL
