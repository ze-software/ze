# Test: a second config apply keeps the VPP loopback the first one made.
# Spec: plan/spec-fixit-vpp-loopback-recreated-per-apply.md AC-1, AC-2
#
# VALIDATES: AC-1 -- two applies of the same `dummy` entry leave ONE loopback
#            in the dataplane. create_loopback carries a MAC and nothing else,
#            so VPP allocates a fresh interface and a fresh sw_if_index for
#            every call: a create on the second apply leaks the first
#            interface, which keeps its addresses and its bridge port while no
#            ze name points at it any more.
#            AC-2 -- the address lands on the interface the name resolves to
#            (sw_if_index 1, the one the first apply made).
# PREVENTS:  one leaked VPP interface per daemon reload, without bound.
#
# Method: driver.py starts test/scripts/vpp_stub.py on a per-test Unix socket
# with a JSONL request log, then `ze start ze.conf` with interface.backend=vpp
# and `dummy lo0`. It waits for the first create_loopback, rewrites ze.conf to
# add an address to lo0, and sends SIGHUP. The address request is the marker
# that the SECOND apply reached phase 3, and phase 1 (the dummy create) runs
# before phase 3 in the same applyConfig, so counting create_loopback in the
# log after that marker is a settled count rather than a race.
#
# Discriminates: with the name check removed from ifacevpp.CreateDummy the log
# holds two create_loopback entries with sw_if_index 1 and 2, and the count
# assertion fails.

tmpfs=driver.py:mode=755:terminator=EOF_PY
#!/usr/bin/env python3
"""Apply a vpp `dummy` twice and assert exactly one create_loopback."""
import json
import os
import signal
import subprocess
import sys
import tempfile

from ze_api import wait_until

# Both waits below are bounded polls on a real condition, and both run their
# poll interval inside ze_api.wait_until rather than here. wait_until counts
# attempts rather than wall clock, so the bound is attempts x POLL_DELAY of
# sleeping plus the predicate's own cost: the same 10s and 40s each wait always
# had, never shorter. Predicate and deadline are unchanged; only the loop moved.
POLL_DELAY = 0.05
SOCKET_ATTEMPTS = 200  # x POLL_DELAY = 10s for the stub socket to appear
LOG_ATTEMPTS = 800  # x POLL_DELAY = 40s for a request to reach the stub log

BASE_CONFIG = """environment {{
}}

bgp {{
\trouter-id 10.0.0.1;
\tsession {{ asn {{ local 65533; }} }}
}}

vpp {{
\tenabled true;
\texternal true;
\tapi-socket {sock};
}}

interface {{
\tbackend vpp;
\tdummy lo0 {{
{unit}\t}}
}}
"""

ADDRESS_UNIT = (
    "\t\tunit 0 {\n"
    "\t\t\tipv4 {\n"
    "\t\t\t\taddress [ 10.42.0.1/32 ];\n"
    "\t\t\t}\n"
    "\t\t}\n"
)


def _find_repo_root():
    for p in os.environ.get("PYTHONPATH", "").split(os.pathsep):
        if p and os.path.basename(p) == "scripts":
            return os.path.dirname(os.path.dirname(p))
    d = os.getcwd()
    while d and d != "/":
        if os.path.isfile(os.path.join(d, "go.mod")):
            return d
        d = os.path.dirname(d)
    raise SystemExit("driver: cannot locate repo root")


def _read_log(path):
    """Return the decoded JSONL entries written so far, ignoring a torn tail."""
    entries = []
    try:
        with open(path, "r", encoding="utf-8") as fh:
            for line in fh:
                line = line.strip()
                if not line:
                    continue
                try:
                    entries.append(json.loads(line))
                except json.JSONDecodeError:
                    break
    except FileNotFoundError:
        return []
    return entries


def _wait_for_msg(path, name, attempts):
    """Wait until the stub log holds an entry for name; return the entries.

    The predicate reads the stub's own JSONL request log, so it stays here
    rather than in ze_api: the log format belongs to test/scripts/vpp_stub.py
    and nothing else polls it. Only the poll loop is shared, through
    ze_api.wait_until. On exhaustion the last read is returned, so the caller
    reports its own per-criterion failure against a real readback.
    """
    entries = []

    def _seen():
        nonlocal entries
        entries = _read_log(path)
        return any(e.get("msg") == name for e in entries)

    wait_until(_seen, attempts=attempts, delay=POLL_DELAY)
    return entries


def _terminate(proc):
    """Stop proc, SIGTERM then SIGKILL, and never raise out of a finally block.

    Both waits are bounded. A loaded machine can take several seconds to reap a
    daemon, and a TimeoutExpired escaping the teardown would replace the real
    assertion result with a traceback.
    """
    if proc.poll() is not None:
        return
    proc.send_signal(signal.SIGTERM)
    try:
        proc.wait(timeout=15.0)
        return
    except subprocess.TimeoutExpired:
        pass
    proc.kill()
    try:
        proc.wait(timeout=15.0)
    except subprocess.TimeoutExpired:
        sys.stderr.write(f"driver: pid {proc.pid} outlived SIGKILL\n")


def run(tmp):
    repo = _find_repo_root()
    stub_py = os.path.join(repo, "test", "scripts", "vpp_stub.py")
    if not os.path.isfile(stub_py):
        sys.stderr.write(f"driver: stub not found at {stub_py}\n")
        return 1

    sock = os.path.join(tmp, "api.sock")
    if len(sock) >= 108:
        sys.stderr.write(f"driver: socket path too long: {sock}\n")
        return 1
    log = os.path.join(tmp, "vpp-requests.jsonl")
    conf = os.path.join(tmp, "ze.conf")

    with open(conf, "w", encoding="utf-8") as fh:
        fh.write(BASE_CONFIG.format(sock=sock, unit=""))

    ze_log = os.path.join(tmp, "ze.log")
    entries = []

    def fail(reason):
        sys.stderr.write(f"FAIL: {reason}\n")
        for entry in entries:
            sys.stderr.write(f"stub: {entry.get('msg')} {entry.get('fields')}\n")
        try:
            with open(ze_log, "r", encoding="utf-8") as fh:
                sys.stderr.write(fh.read())
        except OSError:
            pass
        return 1

    stub = subprocess.Popen(
        ["python3", stub_py, "--socket", sock, "--log", log, "--deadline", "120", "-v"],
        stderr=subprocess.DEVNULL,
        text=True,
    )
    try:
        if not wait_until(
            lambda: os.path.exists(sock),
            attempts=SOCKET_ATTEMPTS,
            delay=POLL_DELAY,
        ):
            return fail("the stub socket never appeared")

        # Per-run config directory. Without it ze derives one from the binary's
        # location, and `ze start` then restores the config that directory's
        # database already holds: a second run of this test would boot the
        # FIRST run's stub socket path, which no longer exists.
        cfgdir = os.path.join(tmp, "etc")
        os.makedirs(cfgdir, exist_ok=True)
        env = os.environ.copy()
        env["ze.config.dir"] = cfgdir
        env["ze.log.vpp"] = "info"
        env["ze.log.interface"] = "info"
        env["ze.log.bgp"] = "warn"
        ze_out = open(ze_log, "w", encoding="utf-8")  # noqa: SIM115 -- closed below
        ze = subprocess.Popen(
            ["ze", "start", conf],
            stdout=ze_out,
            stderr=subprocess.STDOUT,
            env=env,
        )
        try:
            entries = _wait_for_msg(log, "create_loopback", LOG_ATTEMPTS)
            if not any(e.get("msg") == "create_loopback" for e in entries):
                return fail("the first apply never created the loopback")

            # Second apply: add an address, so the reload has work whose request
            # marks that phase 3 ran, and phase 1 ran before it.
            with open(conf, "w", encoding="utf-8") as fh:
                fh.write(BASE_CONFIG.format(sock=sock, unit=ADDRESS_UNIT))
            ze.send_signal(signal.SIGHUP)

            entries = _wait_for_msg(log, "sw_interface_add_del_address", LOG_ATTEMPTS)
        finally:
            _terminate(ze)
            ze_out.close()
    finally:
        _terminate(stub)

    creates = [e for e in entries if e.get("msg") == "create_loopback"]
    adds = [
        e for e in entries
        if e.get("msg") == "sw_interface_add_del_address" and e.get("fields", {}).get("is_add")
    ]
    if not adds:
        return fail("the second apply never programmed the address")

    # Both criteria are reported, never the first one only. One defect breaks
    # both, and a run that printed AC-1 alone would leave AC-2 looking untested.
    problems = []
    indices = [e.get("fields", {}).get("sw_if_index") for e in creates]
    if len(creates) != 1:
        problems.append(
            f"AC-1: create_loopback count is {len(creates)} (sw_if_index {indices}), "
            "want 1: the reload leaked a loopback"
        )
    # AC-2: the address is on the interface the ze name resolves to, which is
    # the one the FIRST apply made. A second create rebinds the name, and the
    # address then lands on the new interface while the first one keeps the
    # addresses it was already given and no name points at it.
    live = creates[0].get("fields", {}).get("sw_if_index")
    strays = [e.get("fields", {}).get("sw_if_index") for e in adds
              if e.get("fields", {}).get("sw_if_index") != live]
    if strays:
        problems.append(
            f"AC-2: address programmed on sw_if_index {strays}, want {live}: "
            "the name resolves to an interface the first apply did not make"
        )
    if problems:
        return fail("; ".join(problems))

    for entry in entries:
        sys.stderr.write(f"stub: {entry.get('msg')} {entry.get('fields')}\n")
    sys.stderr.write("OK: one create_loopback across two applies\n")
    return 0


def main() -> int:
    with tempfile.TemporaryDirectory(prefix="ze-vpp-reapply-") as tmp:
        return run(tmp)


sys.exit(main())
EOF_PY

cmd=foreground:seq=1:exec=python3 ./driver.py:timeout=60s
expect=exit:code=0
expect=stderr:pattern=OK: one create_loopback across two applies
reject=stderr:pattern=the reload leaked a loopback
