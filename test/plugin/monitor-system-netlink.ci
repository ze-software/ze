# Test: `monitor system netlink` (and monitor system netlink route) dispatched from a plugin is refused
# VALIDATES: a streaming-only command, typed in full on a route that answers once,
# is refused with an error naming `ze monitor system netlink`, the terminal command that streams it
# PREVENTS: the old reply {"status":"monitor-configured"}, shaped like success and
# carrying no events (the streaming path itself is proved where it streams)

# ze-peer expectations
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
option=asn:value=65001
# The observer waits for eor-sent before checking the monitor API. The peer MUST
# stay alive after receiving EOR until all API assertions finish.
option=linger:value=true
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# Native observer exercises monitor system netlink and its group validation.

# ze bgp configuration
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external monitor-system-netlink-test {
		run "le test fixture plugin/monitor-system-netlink"
		encoder json
	}
}

bgp {
	filter {
		import {
			final accept
		}
		export {
			final accept
		}
	}
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
reject=stderr:pattern=ZE-OBSERVER-FAIL
