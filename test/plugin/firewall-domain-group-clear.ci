# Test: `clear firewall domain-group <name>` drops the group's cached addresses
#       and the set they were programmed into leaves the kernel.
# Spec: plan/spec-firewall-domain-group.md -- user story 6
# VALIDATES: the deliberate exit from last-known-good. The command is typed at
#            `ze cli` over SSH and reaches clearDomainGroup
#            (internal/component/firewall/plugins/domain/command.go), which
#            purges the cache, re-applies the tables through applyTables, and
#            reports how many entries it removed.
# PREVENTS: a clear that empties the plugin's memory and leaves the addresses
#           enforced in nftables until the next restart, which is the failure an
#           operator clearing a compromised name is trying to prevent.
#
# RUN GREEN on 2026-09-06, and observed RED first: with the applyTables call in
# clearDomainGroup (internal/component/firewall/plugins/domain/command.go)
# skipped, the addresses stay in the kernel and the fixture reports "the table
# the group's addresses were programmed into is still in the kernel after the
# clear", which is the exact failure this file exists to catch. The command that
# runs it is `./le functional plugin`; on a host without CAP_NET_ADMIN and
# CAP_NET_BIND_SERVICE it is skipped by the option below, and the runner that
# executes it in the gate is `./le qemu netns-test suites plugin`.
#
# The fixture is domainGroupClear
# (internal/test/fixture/netfilter_fixture_domain_group.go). It drives the
# daemon over the real SSH `ze cli` path rather than over a plugin channel: a
# `plugin { external ... }` block would hand it a channel to dispatch on and
# would change what the daemon under test is running. In order it:
#   1. Waits for the daemon, waits for the SSH port, and provisions client
#      credentials with `ze init`.
#   2. Serves DNS on 127.0.0.1:53 from the stub's default zone, which answers
#      web.example.test with A 203.0.113.10.
#   3. Runs `update firewall domain-group web | json` and prints the answer,
#      which carries the counts and no address.
#   4. Reads the kernel back until the group's set holds the address, and prints
#      NOTHING while doing it. Without this read the absence asserted at the end
#      of this file would also pass against a daemon that programmed nothing.
#   5. Runs `clear firewall domain-group web | json` and prints the answer.
#   6. Reads the kernel back AFTER the clear and prints the result once: the
#      table's contents if it is still there, and one line saying it is gone if
#      it is not.
# It prints no address of its own anywhere. The absence asserted at the end is
# read from the whole accumulated output, so an address printed for any reason
# would fail it, and the failure message in step 4 is worded to name neither the
# address nor the set for that reason.
#
# The term matching the group is declared in the config below, not committed
# later. A daemon START reads its config through OnConfigure alone and runs no
# verify (configure, internal/component/firewall/plugins/domain/domain.go), so
# the table is held back until the update in step 3 resolves the group.
#
# ONE SCENARIO PER FILE, and here that is load-bearing rather than tidy. An
# expect=stdout: assertion is FILE-level: the runner checks it against the
# concatenated output of every command in the file (runner_exec.go,
# rec.ClientOutput), stdout and stderr together. This file says an address is
# ABSENT, so it cannot also be the file that watches the address arrive. That
# half is test/plugin/firewall-domain-group-update.ci.
#
# For the same reason the firewall debug log stays OFF here. Every other
# firewall test raises it, and a debug line naming the address the plugin just
# purged would land in the same buffer the absence below reads.
#
# This test programs nftables and binds port 53, so it needs CAP_NET_ADMIN and
# CAP_NET_BIND_SERVICE, not merely Linux.
option=needs-linux:caps=net-admin,net-bind
# Serialize against every other test that binds port 53, the two `ze-test dns`
# scenarios included. The port is NODE-WIDE and the address is fixed by the type
# of the `system name-server` leaf. One group covers the nftables contention
# too: the ruleset is node-wide and the set names come from the group name
# (setNames, sets.go). A test carries ONE exclusive group
# (Record.ExclusiveGroup, record_parse.go), so this has to be the one that
# covers both.
option=exclusive:group=dns-stub-port-53
# error, not warn and not the default. The two absences at the end of this file
# read the same buffer the daemon's own log lands in, and
# dropTablesMissingAProvidedSet (internal/component/firewall/registry.go) logs
# `set=domain_v4_web` at WARN every time this table is held back: once at boot
# before the group has resolved, and once again after the clear empties it.
# Both are the product working, and both would fail an absence assertion that is
# about the KERNEL. The plugin's own logs are safe at any level -- they carry
# group names and counts, never an address (recordSteadyAnswer and
# resolveAndRecord, domain.go).
option=env:var=ze.log.firewall:value=error
# Each test gets its own persisted address cache. DefaultConfigDir
# (internal/core/paths/paths.go) otherwise resolves to the directory the binary
# sits in, which every test in the run shares, and a `web` group left cached by
# a sibling would let this daemon program the set at boot rather than at step 3.
option=env:var=ze.config.dir:value=.
option=timeout:value=30s

stdin=ze-fw:terminator=EOF_CONF
system {
	# The hub resolver reads NameServers[0] as its server (newResolvers,
	# cmd/ze/hub/main_system.go), so this points every lookup at the fixture's
	# stub rather than at the host's real DNS.
	name-server 127.0.0.1;
	dns {
		resolv-conf-path "";
	}
	# The account the fixture logs in as. The hash is of "testpass".
	authentication {
		user operator {
			password "$2a$04$UlwuiuH82Unfsq.XEMPGJeDkXwbm3KW.nvVaVXOd/JeFK8VjMjrQO";
		}
	}
}

firewall {
	backend nft;
	domain-group web {
		domain-names [ web.example.test ];
		ttl-floor 60;
	}
	table fw_dgc {
		family inet;
		chain input {
			type filter;
			hook input;
			priority 0;
			policy accept;
			# The rule that matches the group. It is what makes the plugin
			# register a set at all (buildTables, sets.go), and it is what
			# leaves the kernel with the set when the clear empties the cache.
			term allow-web {
				from { source-domain-group web; }
				then { accept; }
			}
		}
	}
}

environment {
	ssh {
		enabled true;
		server main {
			ip 127.0.0.1;
			# $PORT2 is the second of the two ports the runner leases to this
			# test (TestPortSpan, internal/test/runner/ports.go). A fixed port
			# would collide with a sibling in this suite, which shares one
			# network namespace.
			port $PORT2;
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze -:stdin=ze-fw
cmd=foreground:seq=2:exec=ze-test fixture plugin/firewall-domain-group-clear $PORT2:timeout=25s
expect=exit:code=0

# The resolution really happened. Without this line the absence at the end would
# also pass against a daemon that never resolved, which is the vacuity this pair
# exists to close: the update answer reports the addresses it cached, and it
# reports them as counts, so asserting it costs the absence nothing.
expect=stdout:contains="ipv4-count"

# The clear found entries to remove. clearDomainGroup answers with an ERROR when
# the cache held nothing ("no cached addresses for web"), so this needle is only
# produced by a purge that had something to purge.
expect=stdout:contains="cleared"

# And the addresses are gone from the kernel. The read-back is of the whole
# table, so a set left behind with its elements in place fails here, and so does
# a set emptied in the plugin's memory alone.
reject=stdout:contains=203.0.113.10
reject=stdout:contains=domain_v4_web
