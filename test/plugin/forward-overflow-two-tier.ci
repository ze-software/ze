action=send:conn=1:seq=45:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00300200000015400101004002004003040101010140050400000064180A002C
action=send:conn=1:seq=46:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00300200000015400101004002004003040101010140050400000064180A002D
action=send:conn=1:seq=47:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00300200000015400101004002004003040101010140050400000064180A002E
action=send:conn=1:seq=48:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00300200000015400101004002004003040101010140050400000064180A002F
action=send:conn=1:seq=49:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00300200000015400101004002004003040101010140050400000064180A0030
action=send:conn=1:seq=50:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00300200000015400101004002004003040101010140050400000064180A0031
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_SOURCE

# Dest peer (ASN 65002) -- verify every forwarded route arrives, in order
stdin=dest:terminator=EOF_DEST
option=tcp_connections:value=1
option=timeout:value=20s
# // reframed seq=N:contains= (one NLRI per message) to seq=1:ordered=
# (same 50 needles, strict in-order consumption across message boundaries).
# The old framing asserted a property ze does not owe: the forward rail packs
# same-attr NLRIs into one UPDATE (fwdBucketMerge), which is legal BGP UPDATE
# packing. ordered= still fails on any lost or out-of-order NLRI, so the
# coverage this test claims (delivery without loss, in order) is unchanged.
expect=bgp:conn=1:seq=1:ordered=180A0000
expect=bgp:conn=1:seq=1:ordered=180A0001
expect=bgp:conn=1:seq=1:ordered=180A0002
expect=bgp:conn=1:seq=1:ordered=180A0003
expect=bgp:conn=1:seq=1:ordered=180A0004
expect=bgp:conn=1:seq=1:ordered=180A0005
expect=bgp:conn=1:seq=1:ordered=180A0006
expect=bgp:conn=1:seq=1:ordered=180A0007
expect=bgp:conn=1:seq=1:ordered=180A0008
expect=bgp:conn=1:seq=1:ordered=180A0009
expect=bgp:conn=1:seq=1:ordered=180A000A
expect=bgp:conn=1:seq=1:ordered=180A000B
expect=bgp:conn=1:seq=1:ordered=180A000C
expect=bgp:conn=1:seq=1:ordered=180A000D
expect=bgp:conn=1:seq=1:ordered=180A000E
expect=bgp:conn=1:seq=1:ordered=180A000F
expect=bgp:conn=1:seq=1:ordered=180A0010
expect=bgp:conn=1:seq=1:ordered=180A0011
expect=bgp:conn=1:seq=1:ordered=180A0012
expect=bgp:conn=1:seq=1:ordered=180A0013
expect=bgp:conn=1:seq=1:ordered=180A0014
