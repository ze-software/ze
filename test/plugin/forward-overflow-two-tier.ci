expect=bgp:conn=1:seq=1:ordered=180A0016
expect=bgp:conn=1:seq=1:ordered=180A0017
expect=bgp:conn=1:seq=1:ordered=180A0018
expect=bgp:conn=1:seq=1:ordered=180A0019
expect=bgp:conn=1:seq=1:ordered=180A001A
expect=bgp:conn=1:seq=1:ordered=180A001B
expect=bgp:conn=1:seq=1:ordered=180A001C
expect=bgp:conn=1:seq=1:ordered=180A001D
expect=bgp:conn=1:seq=1:ordered=180A001E
expect=bgp:conn=1:seq=1:ordered=180A001F
expect=bgp:conn=1:seq=1:ordered=180A0020
expect=bgp:conn=1:seq=1:ordered=180A0021
expect=bgp:conn=1:seq=1:ordered=180A0022
expect=bgp:conn=1:seq=1:ordered=180A0023
expect=bgp:conn=1:seq=1:ordered=180A0024
expect=bgp:conn=1:seq=1:ordered=180A0025
expect=bgp:conn=1:seq=1:ordered=180A0026
expect=bgp:conn=1:seq=1:ordered=180A0027
expect=bgp:conn=1:seq=1:ordered=180A0028
expect=bgp:conn=1:seq=1:ordered=180A0029
expect=bgp:conn=1:seq=1:ordered=180A002A
expect=bgp:conn=1:seq=1:ordered=180A002B
expect=bgp:conn=1:seq=1:ordered=180A002C
expect=bgp:conn=1:seq=1:ordered=180A002D
expect=bgp:conn=1:seq=1:ordered=180A002E
expect=bgp:conn=1:seq=1:ordered=180A002F
expect=bgp:conn=1:seq=1:ordered=180A0030
expect=bgp:conn=1:seq=1:ordered=180A0031
# // the removed End-of-RIB rule was unsatisfiable by construction, so
# it asserted nothing and only produced a red the runner used to mask. This peer's
# EOR is emitted by its OWN initial sync the moment it establishes
# (peer_initial_sync.go), which is BEFORE any route is forwarded to it from
# another peer. That early EOR does not match the route rule(s) above, and
# checker.go silently swallows an unmatched EOR instead of re-offering it, so the
# trailing EOR slot could never be filled. RFC 4724 orders the EOR only against
# this speaker's own initial dump, never against routes learned afterwards, so
# there is no ordering here for a test to assert. The forwarded-route rule(s)
# above are this test's actual subject and are unchanged.
EOF_DEST

# Python test plugin: smoke-checks metric registration while the dest peer proves
# every UPDATE was delivered.
tmpfs=overflow-test.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
"""Test: overflow pool delivers all routes under burst."""
import json
import sys
from ze_api import API, runtime_fail, result_json_data, result_text_data

def dispatch(api, command):
    resp = api._call_engine('ze-plugin-engine:dispatch-command', {'command': command})
    return resp.get('result', {})

def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()

    # Every prefix the source announced must reach adj-rib-in. The receive path
    # is not throttled by ZE_FWD_CHAN_SIZE, so this fills quickly and only
    # proves nothing was lost on ingest before we drain forwarding to the dest.
    EXPECTED_ROUTES = 50
    result = api.dispatch_until(
        'show bgp adj-rib-in status',
        lambda r: result_json_data(r, {}).get('total-routes', 0) >= EXPECTED_ROUTES,
        attempts=80,
    )
    total = result_json_data(result, {}).get('total-routes', 0)
    if total < EXPECTED_ROUTES:  # negative = query failed; short = ingest incomplete
        msg = f'adj-rib-in has {total}/{EXPECTED_ROUTES} routes'
        print(f'FAIL: {msg}', file=sys.stderr)
        sys.stderr.flush()
        runtime_fail(msg)

    print(f'OK: {total} routes in adj-rib-in', file=sys.stderr)

    # Drain forwarding deterministically before shutting down. The tiny forward
    # channel leaves routes queued in the per-destination overflow buffer well
    # after adj-rib-in is full; 'request peer * flush' blocks until the forward
    # pool has written every queued item to the wire (BarrierPeer), so an early
    # shutdown cannot truncate the dest. This replaces a shutdown-races-forwarding
    # window that made the test fail under load.
    fr = api.dispatch_until_done('request peer * flush', attempts=40)
    if fr.get('status') != 'done':
        msg = f'forward-pool flush did not complete: {fr}'
        print(f'FAIL: {msg}', file=sys.stderr)
        sys.stderr.flush()
        runtime_fail(msg)

    print('OK: forward pool flushed to all peers', file=sys.stderr)

    # Verify overflow-related metrics are registered.
    r = dispatch(api, 'show metrics values')
    data_str = result_text_data(r, '{}')
    try:
        data = json.loads(data_str) if isinstance(data_str, str) else data_str
    except (json.JSONDecodeError, TypeError):
        data = {}
    metrics = data.get('metrics', '')
    if 'ze_bgp_pool_used_ratio' not in metrics:
        msg = 'ze_bgp_pool_used_ratio not in metrics output'
        print(f'FAIL: {msg}', file=sys.stderr)
        sys.stderr.flush()
        runtime_fail(msg)

    print('OK: overflow metrics present', file=sys.stderr)

    dispatch(api, 'request shutdown')
    api.wait_for_shutdown()

if __name__ == '__main__':
    main()
EOF_RUN

# ze configuration: source -> ze -> dest, with guaranteed overflow
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	internal adj-rib-in {
		use bgp-adj-rib-in
	}
	internal rs {
		use bgp-rs
	}
	external overflow-test {
		run ./overflow-test.run
		encoder json
	}
}

telemetry {
	prometheus {
		enabled true
		server main {
			ip 127.0.0.1;
			port $PORT2;
		}
	}
}

bgp {
	peer source-peer {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
		attach process adj-rib-in {
			receive [ update-received state ]
			send [ update ]
		}
	}

	peer dest-peer {
		connection {
			remote {
				ip 127.0.0.2
			}
			local {
				ip 127.0.0.2
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65002
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
		attach process adj-rib-in {
			receive [ update-received state ]
			send [ update ]
		}
	}
}
EOF_CONF

# Force small channel size so overflow is guaranteed with 50 routes.
option=env:var=ZE_FWD_CHAN_SIZE:value=2

# Process orchestration
cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=source
cmd=background:seq=2:exec=ze-peer --bind 127.0.0.2 --port $PORT:stdin=dest
cmd=foreground:seq=3:exec=ze -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
reject=stderr:pattern=panic recovered
reject=stderr:pattern=fatal error
reject=stderr:pattern=treat-as-withdraw
reject=stderr:pattern=ZE-OBSERVER-FAIL
