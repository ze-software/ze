# Test: update bgp irr asn fails when PeeringDB returns no AS-SET
# VALIDATES: ISSUE-2 -- command-failure path returns error, state preserved
# PREVENTS: Refresh silently succeeds with empty prefix-list when AS-SET undiscoverable
#
# Flow:
# 1. Mock PeeringDB server returns empty irr_as_set for ASN 65100 (65100 % 3 == 0)
# 2. ze starts with IRR filter configured, no explicit as-set (forces PeeringDB discovery)
# 3. Observer issues "update bgp irr asn 65100" and verifies it returns status=error
# 4. Observer verifies "show bgp irr" reports error status for ASN 65100
#
# ASN 65100 chosen because: (a) 65100 % 3 == 0, so mock PeeringDB returns empty
# irr_as_set; (b) no other filter-irr test uses this ASN, so no cache interference.

option=env:var=ze.log.bgp.filter.irr:value=info

# Peer UPDATE carries AS_PATH with AS 65100 so the filter name resolves.
# Marker(16) + Len=0x002F(47) + Type=02 + WdLen=0000 + AttrLen=0x0014(20)
#   ORIGIN: 40010100 (IGP)
#   AS_PATH: 40020602010000FE4C (AS_SEQ [65100=0xFE4C])
#   NEXT_HOP: 40030401010101
#   NLRI: 180A0000 (10.0.0.0/24)
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=20s
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002F02000000144001010040020602010000FE4C40030401010101180A0000
EOF_PEER

tmpfs=test-filter-irr-fail.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
"""Verify update bgp irr asn fails when PeeringDB returns no AS-SET."""
import json
import sys
from ze_api import API, result_json_data, runtime_fail

def dispatch(api, command):
    resp = api._call_engine('ze-plugin-engine:dispatch-command', {'command': command})
    return resp.get('result', {})

def wait_for_irr_settled(api):
    """Poll show bgp irr until the initial refresh for ASN 65100 completes."""
    for _ in range(20):
        result = dispatch(api, 'show bgp irr')
        data = result_json_data(result, {})
        for entry in data.get('entries', []):
            if entry.get('asn') == 65100 and entry.get('status') != 'pending':
                return
        api.wait_for_event(timeout=0.5)

def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()

    wait_for_irr_settled(api)

    # Update command must fail: IRR server unreachable for AS65100.
    result = dispatch(api, 'update bgp irr asn 65100')
    status = result.get('status', '')
    if status != 'error':
        runtime_fail(f'expected status=error from update bgp irr asn 65100, got status={status}')

    # Show command must report error status for the ASN.
    result = dispatch(api, 'show bgp irr')
    status = result.get('status', '')
    if status != 'done':
        runtime_fail(f'show bgp irr status={status}, expected done')

    data = result_json_data(result, {})
    entries = data.get('entries', [])
    found_error = False
    for entry in entries:
        if entry.get('asn') == 65100 and entry.get('status') == 'error':
            found_error = True
            break

    if not found_error:
        runtime_fail('show bgp irr does not show error status for ASN 65100')

    print('OK: update bgp irr asn 65100 correctly failed, show bgp irr shows error', file=sys.stderr)
    dispatch(api, 'request shutdown')
    api.wait_for_shutdown()

if __name__ == '__main__':
    main()
EOF_RUN

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external test-filter-irr-fail {
		run ./test-filter-irr-fail.run
		encoder json
	}
}
bgp {
	policy {
		irr {
			server 127.0.0.1:1
			peeringdb-url http://127.0.0.1:$PORT2
			refresh-interval 3600
		}
	}

	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65100
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
		}

		filter {
			import [ bgp-filter-irr:65100 ]
		}

		attach process test-filter-irr-fail {
			receive [ update state ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-test peeringdb --port $PORT2
cmd=background:seq=2:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=3:exec=ze --plugin ze.bgp-filter-irr --plugin ze.bgp-adj-rib-in -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
expect=stderr:pattern=irr: lookup failed
