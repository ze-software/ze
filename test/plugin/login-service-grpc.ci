# Question: does gRPC refuse a rest-only account identically to a wrong
# password on BOTH unary Execute and Stream open (stepping
# ze_aaa_login_service_refused_total{service="grpc"} >= 2) while admitting
# that same account on REST and admitting a grpc-only account on both gRPC
# unary Execute and Stream open?
# Why a unit test cannot decide it: unary and streaming RPCs pass through two
# distinct gRPC server interceptors on the live hub; only real protobuf calls
# against a running daemon prove both interceptors enforce service "grpc".
#
# VALIDATES: AC-2, AC-17 -- gRPC unary and stream open gate + complementary REST pair
# PREVENTS: gRPC streaming interceptor or unary interceptor bypassing the grpc gate

option=timeout:value=45s

tmpfs=grpc.conf:terminator=EOF_CONF
system {
	authentication {
		user restonly {
			password "$2a$04$UlwuiuH82Unfsq.XEMPGJeDkXwbm3KW.nvVaVXOd/JeFK8VjMjrQO"
			login-service rest-set
		}
		user grpconly {
			password "$2a$04$UlwuiuH82Unfsq.XEMPGJeDkXwbm3KW.nvVaVXOd/JeFK8VjMjrQO"
			login-service grpc-set
		}
	}
	authorization {
		login-service rest-set { service [ rest ] }
		login-service grpc-set { service [ grpc ] }
	}
}
environment {
	api-server {
		grpc {
			enabled true
			server main { ip 127.0.0.1; port $PORT; }
		}
		rest {
			enabled true
			server main { ip 127.0.0.1; port $PORT2; }
		}
	}
}
telemetry {
	prometheus {
		enabled true
		server main { ip 127.0.0.1; port $PORT3; }
		netdata { enabled false; }
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze start grpc.conf:name=daemon:ready=Ze running.
cmd=foreground:seq=2:exec=le test fixture plugin/login-service-grpc $PORT $PORT2 $PORT3:timeout=35s
expect=exit:code=0
expect=stderr:contains=OK: gRPC unary and stream open refused rest-only account identically to wrong password
expect=stderr:contains=OK: gRPC and REST complementary pair, stream open, and metric verified
reject=stderr:contains=ZE-OBSERVER-FAIL
