# rfc6793-narrow-to-old-speaker -- the reconciled path is narrowed for an OLD peer
#
# VALIDATES: RFC 6793 Section 4.2.2 -- "When communicating with an OLD BGP
# speaker, a NEW BGP speaker MUST send the AS path information in the AS_PATH
# attribute encoded with two-octet AS numbers", non-mappable AS numbers are
# represented by AS_TRANS, and "the AS path information ... MUST be carried in
# the AS4_PATH attribute" when it holds a four-octet AS number.
# VALIDATES: AC-11 of
# plan/immediate/spec-forwarded-as-path-obeys-rfc6793-for-every-destination.md.
#
# PREVENTS: sending four-octet AS numbers on a session that negotiated two
# octets, and omitting the AS4_PATH companion that carries the real ones.
#
# WHAT IT PROVES, AND WHAT IT DOES NOT. This file drives the NARROWING rail:
# the AS path ze holds is four-octet truth and this peer negotiated two octets,
# so ze substitutes AS_TRANS and derives the AS4_PATH from the OUTGOING path,
# ze's own 65000 included. It does NOT discriminate the ingest collapse. Both
# sessions here are two-octet, so with the collapse removed the received
# AS4_PATH reaches the prepend rail instead, AS4PathForRewrite takes its
# MergeAS4Path branch (internal/component/bgp/wireu/aspath_as4.go), and the
# reconstruction lands on the same three AS numbers. The collapse's
# discriminators are rfc6793-ingest-collapse.ci, rfc6793-no-as4path-from-new-
# speaker.ci and the interop scenario as-path-mixed-width-relay-frr.
#
# RFC requirement: RFC6793-4.1-6 negative -- the MUST NOT is scoped to a pair of NEW
# BGP speakers, and ze is not applying a blanket drop: this destination negotiated
# two octets, so the UPDATE ze puts on its wire DOES carry an AS4_PATH, asserted as
# exact wire hex on a running daemon (Section 4.1 against Section 4.2.2).
#
# NO RS-CLIENT HERE, and that is the difference from the other two files. This
# destination is a plain eBGP peer, so ze prepends 65000 and the AS4_PATH ze
# derives has to carry that prepend too. rs-client would take the RFC 7947
# non-prepending path and leave nothing for the derivation to get wrong.
#
# ASN4 IS DISABLED ON BOTH PEERS: conn=1 is the OLD speaker the route is
# learned from, conn=2 is the OLD speaker it is relayed to.
#
# NO LOCAL_PREF: the source is an eBGP peer and RFC 4271 Section 5.1.5 forbids
# it there, so ze would overwrite it with an ATTR_TOMBSTONE marker and the
# byte-equality rule would pin the marker (bgp-rs-fastpath-ebgp-shared.ci).

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=2
option=timeout:value=45s
option=bind:value=0.0.0.0
option=conn_map:value=remote-ip

# Source peer (conn=1), the OLD speaker the route is learned from. Identical to
# the frame rfc6793-ingest-collapse.ci sends, so the two files differ only in
# the destination's negotiated width:
#   40 01 01 00                        ORIGIN igp
#   40 02 06 0202 FDE9 5BA0            AS_PATH [65001, AS_TRANS], two-octet
#   40 03 04 01010101                  NEXT_HOP 1.1.1.1
#   C0 11 0A 0202 0000FDE9 FA56EA7B    AS4_PATH [65001, 4200000123]
#   18 0A0000                          NLRI 10.0.0.0/24
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF003C0200000021400101004002060202FDE95BA040030401010101C0110A02020000FDE9FA56EA7B180A0000

# The SOURCE's own EOR (conn=1). See rfc6793-ingest-collapse.ci for why the
# receiver's EOR is not pinned on the wire.
expect=bgp:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000

# Receiver peer (conn=2), the OLD speaker the route is relayed to, asserted by
# full byte-equality. Derived from RFC 6793 Section 4.2.2:
#   40 01 01 00                        ORIGIN igp
#   40 02 08 0203 FDE8 FDE9 5BA0       AS_PATH, two-octet AS_SEQUENCE
#                                      [65000, 65001, AS_TRANS]. 65000 is ze's
#                                      eBGP prepend and 4200000123 is not
#                                      mappable, so it travels as AS_TRANS.
#   40 03 04 01010101                  NEXT_HOP 1.1.1.1
#   C0 11 0E 0203 0000FDE8 0000FDE9 FA56EA7B
#                                      AS4_PATH, the WHOLE outgoing path at four
#                                      octets. Section 4.2.3 reconstructs by
#                                      count, so the prepend has to appear in
#                                      both attributes or the receiver loses an
#                                      AS number off the head.
#   18 0A0000                          NLRI 10.0.0.0/24
# attr len = 4 + 11 + 7 + 17 = 39 = 0x27; total = 19 + 2 + 2 + 39 + 4 = 66 = 0x42.
expect=bgp:conn=2:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00420200000027400101004002080203FDE8FDE95BA040030401010101C0110E02030000FDE80000FDE9FA56EA7B180A0000
EOF_PEER

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	internal rs {
		use bgp-rs
	}
	internal adj-rib-in {
		use bgp-adj-rib-in
	}
	external shutdown-after-up {
		run "ze-test fixture plugin/rfc6793-narrow-to-old-speaker"
		encoder json
	}
}
bgp {
	peer source-old {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				asn4 disable
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
			rs-fast-path enable
		}
		attach process adj-rib-in {
			receive [ update-received state ]
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
		attach process shutdown-after-up {
			receive [ update ]
		}
	}
	peer receiver-old {
		connection {
			remote {
				ip 127.0.0.2
			}
			local {
				ip 127.0.0.2
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65002
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				asn4 disable
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
			rs-fast-path enable
		}
		attach process adj-rib-in {
			send [ update ]
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
		attach process shutdown-after-up {
			receive [ update ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=45s
expect=exit:code=0
reject=stderr:pattern=panic
reject=stderr:pattern=fatal error
