# --- Run 1: API v6 ---
cmd=foreground:seq=2:exec=cp v6-initial.conf running.conf:exit=0
cmd=background:seq=3:name=edge1-v6:exec=le test peer --bind 127.0.0.2 --port $PORT:stdin=edge1-v6
cmd=background:seq=4:name=lab-v6:exec=le test peer --bind 127.0.0.3 --port $PORT:stdin=lab-v6
cmd=background:seq=5:name=daemon1:exec=ze start running.conf:ready=Ze running.
reject=stderr:pattern=panic

cmd=foreground:seq=6:exec=le test fixture plugin/bus-wait-file v6.p0.done:exit=0
expect=stdout:contains=OK: marker file v6.p0.done appeared
cmd=foreground:seq=7:exec=le test fixture plugin/bus-assert-refused-count $PORT3 /bus/endpoint/s1 0:exit=0
expect=stdout:contains=OK: ze_bus_send_refused_total for /bus/endpoint/s1 = 0

# Reload omitting "cli:send bgp" -> trigger post-reload announce -> refusal counter = 1, same wrapper PID.
cmd=foreground:seq=8:exec=le test fixture plugin/bus-sighup-reload v6-narrowed.conf running.conf v6.reloaded:exit=0
expect=stdout:contains=OK: SIGHUP reload v6-narrowed.conf applied
