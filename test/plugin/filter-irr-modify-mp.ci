# Test: IRR import filter partial modify on an MP_REACH_NLRI UPDATE
# VALIDATES: bgp-filter-irr answers modify for an ipv6/unicast MP_REACH_NLRI
#            that carries one prefix the AS-SET authorizes and one it does not;
#            the relayed UPDATE carries only the authorized prefix, with the
#            MP_REACH_NLRI rebuilt, asserted as wire hex.
# PREVENTS: the whole reject the filter gave such an UPDATE while only the
#           legacy NLRI block was rewritable, which dropped the authorized
#           prefix and left the re-admission worker asking for it again.
#
# Flow:
# 1. The mock IRR serves AS-TEST with ipv6 2001:db8::/32. The irr plugin stores
#    it and the filter enforces it; the observer sees show bgp irr report it and
#    writes irr-listed, which releases source-peer.
# 2. source-peer (AS65001) sends one UPDATE whose MP_REACH_NLRI (ipv6/unicast)
#    carries 2001:db8::/32 (authorized) and 2001:db9::/48 (not authorized).
# 3. bgp-filter-irr answers modify with "mp ipv6/unicast add 2001:db8::/32".
# 4. bgp-rs relays the filtered route to dest-peer, which expects it byte for byte.

# Linux-only: static `next { interface lo { } }` resolves loopback `lo` via Linux netlink.
option=needs-linux
option=env:var=ze.log.bgp.filter.irr:value=info

# MP_REACH_NLRI value: AFI 0002, SAFI 01, NH length 10, NH 2001:db8::1,
# reserved 00, NLRI 20 20010db8 (2001:db8::/32), 30 20010db90000 (2001:db9::/48).
stdin=source:terminator=EOF_SOURCE
option=tcp_connections:value=1
option=timeout:value=20s
option=linger:value=true
# A first start stores nothing: the irr plugin fetches AS-TEST from the mock
# and the filter enforces it on the owner's notice, while the session may
# already be up. An UPDATE judged before that is rejected whole and held by
# design (docs/architecture/bgp/filter-irr.md), and this peer negotiates no
# route-refresh to be asked again, so no modify would ever be answered. The
# peer holds its UPDATE until the observer writes irr-listed, which it does
# once show bgp irr reports AS-TEST enforced.
option=await-file:path=irr-listed
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF004802000000314001010040020602010000FDE9800E210002011020010DB8000000000000000000000001002020010DB83020010DB90000
EOF_SOURCE

# The relayed UPDATE: AS_PATH [65000 65001], MP_REACH_NLRI with 2001:db8::/32 only
# (value length 1A, attribute section length 2E).
stdin=dest:terminator=EOF_DEST
option=tcp_connections:value=1
option=timeout:value=20s
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0045020000002E800E1A0002011020010DB8000000000000000000000001002020010DB84001010040020A02020000FDE80000FDE9
EOF_DEST

stdin=ze-bgp:terminator=EOF_CONF
bus {
	endpoint rs {
		internal bgp-rib;
	}
	endpoint adj-rib-in {
		internal bgp-adj-rib-in;
		send {
			message bgp:update {
				to none;
			}
		}
	}
	endpoint test-strip {
		external {
			run "le test fixture plugin/filter-irr-modify-mp";
		}
		encoding json;
	}
}
system {
	irr {
		server 127.0.0.1:$PORT2
		refresh-interval 3600
	}
}

fib {
	dummy { }
}
static {
	table default {
		route 2001:db8::1/128 { next { interface lo { } } }
	}
}
bgp {
	# RFC 8212: an EBGP direction with no policy is refused; this test exchanges routes.
	filter {
		import { final accept; }
		export { final accept; }
	}
	peer source-peer {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv6/unicast { prefix { maximum 10000; } }
			}
			irr {
				as-set AS-TEST
			}
		}
		filter {
			import { filters [ bgp-filter-irr:65001 ]; final accept; }
		}
	}

	peer dest-peer {
		connection {
			remote {
				ip 127.0.0.2
			}
			local {
				ip 127.0.0.2
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65002
			}
			router-id 1.2.3.4
			family {
				ipv6/unicast { prefix { maximum 10000; } }
			}
		}
		# The relayed route keeps the source next hop (asserted in the hex
		# above). next-hop:auto toward an eBGP peer writes self, which here
		# is 127.0.0.2, the peer's own address, and that route is withheld
		# (RFC 4271 Section 5.1.3). This test asks about the IRR modify, not
		# the next-hop default, so it pins the transparent next hop.
		filter {
			export { filters [ next-hop:unchanged ]; final accept; }
		}
		# bgp-rs asks adj-rib-in to replay the stored route here when this
		# session establishes, so adj-rib-in needs the send permission.
	}
}
EOF_CONF

cmd=background:seq=1:exec=le mock irr --port $PORT2
cmd=background:seq=2:exec=le test peer --port $PORT:stdin=source
cmd=background:seq=3:exec=le test peer --bind 127.0.0.2 --port $PORT:stdin=dest
cmd=foreground:seq=4:exec=ze --plugin ze.bgp-filter-irr -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
expect=stderr:pattern=irr filter modify
expect=stderr:pattern=accepted=1
expect=stderr:pattern=rejected=1
expect=stderr:pattern=INFO: adj-rib-in total=1
reject=stderr:pattern=modify answer cannot be applied
reject=stderr:pattern=panic recovered
reject=stderr:pattern=fatal error
