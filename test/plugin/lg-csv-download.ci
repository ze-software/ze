# Test: Looking glass per-peer CSV download (W-5 / AC-11 narrowed surface)
# VALIDATES: handleUIPeerDownload (internal/component/lg/handler_ui.go:266) streams a
#            peer's routes as a gzip-compressed CSV attachment. Producer-verified
#            response contract:
#              Content-Type:        application/gzip        (handler_ui.go:293)
#              Content-Disposition: attachment; filename="routes-<addr>.csv.gz"
#                                                           (handler_ui.go:294-295)
#              gzip body, first line: prefix,next-hop,as-path,origin,local-pref,med
#                                                           (handler_ui.go:300)
# PREVENTS: the download route unregistering, the attachment filename losing its
#           routes-*.csv.gz shape, the Content-Type drifting, or the body no longer
#           being gzip CSV.
#
# WHY A PLUGIN-DRIVEN HTTP CHECK (not an http= directive): the runner's http=
# assertion checks only status code + body substring, not response headers, and
# the body here is gzip. The native fixture checks Content-Disposition,
# Content-Type, and the decompressed CSV body. ZE_LG_PORT reaches the external
# fixture through the daemon's inherited environment.
# (internal/component/plugin/process/process.go:568).

# ze-peer expectations (minimal handshake)
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=25s
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# Pass the looking-glass listen port ($PORT2) to the plugin process.
option=env:var=ZE_LG_PORT:value=$PORT2

# Native observer injects one route, downloads its CSV, and verifies headers and body.

# ze bgp configuration with LG enabled
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external lg-csv {
		run "ze-test fixture plugin/lg-csv-download"
		encoder json
	}
	internal bgp-rib {
		use bgp-rib
	}
}

environment {
	looking-glass {
		enabled true
		# TLS defaults ON since spec-fixit-mgmt-listener-auth-guard AC-5.
		# This test asserts looking-glass CONTENT over plain HTTP, so it takes
		# the documented opt-out rather than terminating a self-signed TLS
		# handshake; the opt-out working is part of AC-5.
		tls false
		server main {
			ip 127.0.0.1
			port $PORT2
		}
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65000
			}
			router-id 10.0.0.1
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}

		attach process bgp-rib {
			receive [ update state refresh ]
			send [ update ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
