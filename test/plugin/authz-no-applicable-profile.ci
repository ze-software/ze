# Test: an authenticated user who resolves no applicable profile is denied.
# VALIDATES: configured authorization never falls through to the built-in admin profile.
# PREVENTS: privilege escalation for authenticated identities without a resolved profile.

cmd=foreground:seq=1:exec=ze-test fixture plugin/authz-no-applicable-profile:timeout=30s
expect=exit:code=0
expect=stderr:pattern=OK: refusal names access control
expect=stderr:pattern=OK: nobody authenticated, then was denied by authorization
expect=stderr:pattern=OK: daemon logged 'denied: no applicable profile'
expect=stderr:pattern=OK: nonexistent command reports unknown command
