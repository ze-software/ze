# Test: an authenticated user who resolves NO applicable profile is DENIED, not
#       silently granted the admin default. This is the privilege-escalation the
#       fix closes (S-2, authz.go).
#
# Flow:
# 1. Daemon starts with system.authorization profiles configured (a "locked"
#    profile) and a single config user "nobody" that is assigned NO profile.
#    Because no user is assigned any profile, s.assignments is empty (the former
#    hasUsers == false shape) -- exactly the box on which the old code fell
#    through to BuiltinAdminProfile allow-all. This is the local, no-external-AAA
#    reproduction of the TACACS/RADIUS-only "authenticated but no resolved
#    profile" case: the same S-2 branch decides for both.
# 2. "nobody" authenticates over SSH (real credential) and runs "show version",
#    a real, registered command.
# 3. The command is refused: the authorization store exists, so RBAC is in use,
#    and an identity with no applicable profile fails closed.
#
# VALIDATES: AC-1 / User Story 2 -- a user with no applicable profile is denied,
#            and the box does not silently authorize them as admin
#            (spec-fixit-authz-admin-fallthrough, Q-2 "deny always").
# LOAD-BEARING: under the OLD allow-all fall-through this exact scenario
#            (profiles present, no assignments, authenticated user with no
#            resolved profile) returned BuiltinAdminProfile, so "show version"
#            would have SUCCEEDED (exit 0). The assertions below require a
#            refusal AND the specific daemon decision line
#            "denied: no applicable profile" (emitted only by the S-2 branch of
#            Store.Authorize) -- both would fail against the pre-fix behavior.
#            The "unknown command" check keeps the refusal distinguishable from
#            command-resolution failure, and the auth-success check proves the
#            refusal is authorization, not a bad credential.

tmpfs=test-authz-no-applicable-profile.sh:mode=755:terminator=EOF_SH
#!/bin/sh
set -e

touch daemon.ready

# Surface every authorization decision in the daemon log (defaults to WARN; the
# deny line is WARN, but raise to INFO to be explicit and future-proof).
export ze_log_authz=info

# operator-secret plaintext is "oppass"; bcrypt cost-4 hash reused from authz-*.ci.
NOBODY_HASH='$2a$04$MdupNBXL8iUHgRUDfsFl0ue/.FEH3db8U.LPd/XtMhiBmd4MoRM0m'

cat > authz-no-applicable-profile.conf <<ZECONF
environment {
	ssh {
		enabled true
		server main { ip 127.0.0.1; port 0; }
	}
}

system {
	authorization {
		profile locked {
			run {
				default-action deny
			}
			edit {
				default-action deny
			}
		}
	}
	authentication {
		user nobody {
			password ${NOBODY_HASH}
		}
	}
}
ZECONF

ze authz-no-applicable-profile.conf 2>daemon.log &
DAEMON_PID=$!
trap 'kill $DAEMON_PID 2>/dev/null || true; wait $DAEMON_PID 2>/dev/null || true' EXIT

# Poll for the ephemeral ssh port.
SSH_PORT=""
for i in $(seq 1 50); do
	SSH_PORT=$(grep -o '127\.0\.0\.1:[0-9]*' daemon.log 2>/dev/null | head -1 | cut -d: -f2 || true)
	if [ -n "$SSH_PORT" ]; then
		break
	fi
	sleep 0.2
done
if [ -z "$SSH_PORT" ]; then
	echo "FAIL: SSH server did not start" >&2
	cat daemon.log >&2
	exit 1
fi
echo "ssh on :$SSH_PORT" >&2

# Client credential pointer (host/port); the daemon authenticates "nobody"
# against the config user's bcrypt hash using the plaintext env password.
ADMIN_DIR=$(mktemp -d)
trap 'rm -rf "$ADMIN_DIR"; kill $DAEMON_PID 2>/dev/null || true; wait $DAEMON_PID 2>/dev/null || true' EXIT
printf 'admin\ntestpass\n127.0.0.1\n%s\n\n' "$SSH_PORT" | ZE_CONFIG_DIR="$ADMIN_DIR" ze init >/dev/null

run_as_nobody() {
	ZE_CONFIG_DIR="$ADMIN_DIR" ZE_SSH_PASSWORD="oppass" ze cli --user nobody -c "$1" 2>&1
}

# "show version" is a real, registered, read-only command. On a box with
# authorization configured, "nobody" resolves no applicable profile, so it is
# refused. Under the pre-fix allow-all default this returned admin and succeeded.
if OUTPUT=$(run_as_nobody "show version"); then
	echo "FAIL: 'show version' must be refused for a user with no applicable profile" >&2
	echo "OUTPUT: $OUTPUT" >&2
	cat daemon.log >&2
	exit 1
fi
echo "DENIED-OUTPUT: $OUTPUT" >&2

# The refusal must name access control -- proving it is authorization, not a
# bad credential (which would fail the SSH handshake) or an unknown command.
case "$OUTPUT" in
	*"command restricted by access control"*)
		echo "OK: refusal names access control" >&2
		;;
	*)
		echo "FAIL: refusal must say 'command restricted by access control', got: $OUTPUT" >&2
		cat daemon.log >&2
		exit 1
		;;
esac

# Prove the user actually authenticated, so the refusal is an authorization
# decision and not a rejected login.
if ! grep -q 'SSH auth success.*username=nobody' daemon.log; then
	echo "FAIL: daemon did not record a successful login for nobody" >&2
	cat daemon.log >&2
	exit 1
fi
echo "OK: nobody authenticated, then was denied by authorization" >&2

# Load-bearing: the specific S-2 branch decided. This line is emitted only by
# the "authenticated but no applicable profile resolved" deny in Store.Authorize.
if ! grep -q "denied: no applicable profile" daemon.log; then
	echo "FAIL: daemon did not log the no-applicable-profile deny reason" >&2
	cat daemon.log >&2
	exit 1
fi
echo "OK: daemon logged 'denied: no applicable profile'" >&2

# A genuinely unknown command must stay distinguishable from a refusal, so an
# operator can tell a policy denial from a typo.
if OUTPUT=$(run_as_nobody "show no-such-command-anywhere"); then
	echo "FAIL: a nonexistent command must not succeed" >&2
	exit 1
fi
case "$OUTPUT" in
	*"unknown command"*)
		echo "OK: nonexistent command reports unknown command" >&2
		;;
	*)
		echo "FAIL: nonexistent command must report 'unknown command', got: $OUTPUT" >&2
		exit 1
		;;
esac

exit 0
EOF_SH

cmd=foreground:seq=1:exec=./test-authz-no-applicable-profile.sh:timeout=30s
expect=exit:code=0
# The user was refused, and the refusal named access control.
expect=stderr:pattern=OK: refusal names access control
# The user authenticated first, so the refusal is authorization, not auth failure.
expect=stderr:pattern=OK: nobody authenticated, then was denied by authorization
# The specific no-applicable-profile deny branch decided.
expect=stderr:pattern=OK: daemon logged 'denied: no applicable profile'
# A genuinely unknown command stays distinguishable from a policy refusal.
expect=stderr:pattern=OK: nonexistent command reports unknown command
