			local { ip 127.0.0.1; port $PORT; accept true; }
		}
		session {
			asn { remote 65002; }
			family { ipv4/unicast { prefix { maximum 10000; } } }
			capability { graceful-restart disable; }
		}
		filter {
			export {
				filters [ next-hop:unchanged ];
				final accept;
			}
		}
	}
	peer t1 {
		connection {
			remote { ip 127.0.0.4; connect false; }
			local { ip 127.0.0.1; port $PORT; accept true; }
		}
		session {
			asn { remote 65003; }
			family { ipv4/unicast { prefix { maximum 10000; } } }
			capability { graceful-restart disable; }
		}
		filter {
			export {
				filters [ next-hop:auto ];
				final accept;
			}
		}
	}
	peer t2 {
		connection {
			remote { ip 127.0.0.5; connect false; }
			local { ip 127.0.0.1; port $PORT; accept true; }
		}
		session {
			asn { remote 65004; }
			family { ipv4/unicast { prefix { maximum 10000; } } }
			capability { graceful-restart disable; }
		}
		bus {
			send {
				message bgp:update {
					to [ /bus/endpoint/bgp-rib /bus/endpoint/collector ];
				}
			}
		}
	}
}
EOF_NOROLE

cmd=foreground:seq=1:exec=ze init:stdin=init-answers:exit=0
cmd=background:seq=2:name=daemon:exec=ze start running.conf:ready=Ze running.
reject=stderr:pattern=ZE-OBSERVER-FAIL
reject=stderr:pattern=panic

cmd=foreground:seq=3:exec=le test fixture plugin/bus-assert-implied s43-running:exit=0
expect=stdout:contains=OK: s43-running verified text, json, yaml, match, and pure json

# Negative case: reload removing role from edge1 drops otc-ingress/otc-egress everywhere.
cmd=foreground:seq=4:exec=le test fixture plugin/bus-sighup-reload norole.conf running.conf reload.applied:exit=0
expect=stdout:contains=OK: SIGHUP reload norole.conf applied

cmd=foreground:seq=5:exec=le test fixture plugin/bus-assert-implied s43-no-role:exit=0
expect=stdout:contains=OK: s43-no-role verified role filters gone and built-in filters retained

cmd=stop:seq=6:name=daemon:signal=term
