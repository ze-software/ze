# Test: show interface rate command dispatch and error paths
# Exercises: dispatch-command -> ze-show:interface -> handleShowInterface -> handleShowInterfaceRate
# Verifies: command is wired, graceful error when iface plugin not loaded,
#           graceful error for nonexistent interface name

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
option=asn:value=65001
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

tmpfs=show-interface-rate-test.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
import json
import sys
from ze_api import API, runtime_fail, result_text_data

def dispatch(api, command):
    resp = api._call_engine(
        'ze-plugin-engine:dispatch-command', {'command': command})
    if resp is None:
        return {'status': 'error', 'data': 'engine call returned None'}
    return resp.get('result', {})

def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()
    api.wait_for_post_startup(timeout=5.0)

    try:
        # `show interface rate` now has its own wire method, ze-show:interface-rate,
        # so the dispatcher hands handleShowInterfaceRateCmd the tokens after the
        # key rather than eating "rate" as part of it
        # (internal/component/iface/cmd/show_interface.go). While the four
        # subcommands shared ze-show:interface they were alias paths of it, and
        # this reached showInterfaceAll instead: with no iface backend in this
        # config that surfaced as "no backend loaded", which is what the assertion
        # below used to require. The rate tracker is what is absent now.
        resp = dispatch(api, 'show interface rate')
        status = resp.get('status')
        if status is None:
            runtime_fail(f'interface-rate: dispatch returned no status: {resp}')
        data = result_text_data(resp)
        if 'unknown command' in str(data):
            runtime_fail(f'interface-rate: command does not resolve: {data}')
        if 'rate tracker not running' not in str(data):
            runtime_fail(f'unexpected error message: {data}')
        print(f'OK: show interface rate resolves: {data}', file=sys.stderr)
    finally:
        dispatch(api, 'request shutdown')
        api.wait_for_shutdown()

if __name__ == '__main__':
    main()
EOF_RUN

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external show-interface-rate-test {
		run ./show-interface-rate-test.run
		encoder json
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast {
					prefix {
						maximum 10000
					}
				}
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}

		process show-interface-rate-test {
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
