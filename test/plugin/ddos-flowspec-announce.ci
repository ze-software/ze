# Test: the ddos-flowspec responder's rendered update-text command reaches the
# wire as a valid RFC 8955 FlowSpec UPDATE. Drives the exact grammar
# renderFlowspecCommand produces (internal/plugins/ddos/flowspec/responder.go)
# via the plugin send() path and asserts the peer receives the FlowSpec route
# with the traffic-rate (rate-limit) extended community.

# ze-peer expectations
stdin=peer:terminator=EOF_PEER
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0030020000001540010100400200400304650165014005040000006418010100
# FlowSpec UPDATE: MP_REACH (nexthop 127.0.0.2 = nhop self, ze's own address on
# this session), destination 192.0.2.0/24 + protocol tcp + destination-port 80,
# with the traffic-rate (rate-limit:9600) extended community.
# RFC 8955 Section 4: "When advertising Flow Specifications, the Length of the
# Next-Hop Network Address MUST be set to 0.  The Network Address of the
# Next-Hop field MUST be ignored." The expectation below therefore carries
# `85 00 00` where it used to carry `85 04 <address> 00`, and is four octets
# shorter. The `nhop` on the command line is still parsed and still reaches the
# encoder; the family is what refuses to put it on the wire
# (family.NeedsNextHop, internal/core/family/family.go).
expect=bgp:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0044020000002D4001010040020040050400000064800E1100018500000B0118C00002038106058150C010088006000046160000
EOF_PEER

# Plugin script sends the responder's rendered announce command.

# ze bgp configuration
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external ddos-flowspec-announce {
		run "ze-test fixture plugin/ddos-flowspec-announce"
		encoder json
	}
}
bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			# Ze's own address on this session, and what `nhop self` puts in the
			# MP_REACH. It is deliberately NOT the peer's 127.0.0.1: RFC 4271
			# Section 5.1.3 forbids a peer its own address as NEXT_HOP, and
			# originatedNextHopIsPeerOwn (reactor/forward_next_hop.go) withholds
			# the route when the two match.
			local {
				ip 127.0.0.2
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
				ipv4/flow { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart
			}
		}
		behavior {
			group-updates disable
		}

		attach process ddos-flowspec-announce {
			send [ update ]
		}
	}
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze --plugin ze.bgp-nlri-flowspec -:stdin=ze-bgp:timeout=10s
