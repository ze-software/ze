# Test: pipe operators | first N and | last N bound output
# VALIDATES: first/last pipe operators limit RIB query output server-side
# PREVENTS: first/last not truncating results or failing on RIB commands

# ze-peer: send 5 routes into ze's adj-rib-in, then check ze's EOR.
#
# The routes are really injected (option=update:value=send-route below), and that
# is what makes the pipe assertions non-vacuous. Five `expect=bgp` UPDATE hexes
# stood here instead until aaefef8ce, and they were unsatisfiable by
# construction, for two reasons. (1) Nothing announced them: their paired `cmd=api:...text=peer * update
# text ...` lines are inert in the plugin runner -- cmd=api text is parsed into
# messageExpect.Cmd (internal/test/runner/record.go:85, set at
# record_parse.go:700) which ONLY the reporter reads (report.go:149), and ze-peer
# discards cmd= lines outright (internal/test/peer/expect.go:112 "Ignore -
# documentation only"). ze was never told to announce anything. (2) The hexes are
# malformed: 48 bytes on the wire but a Length field of 0x002E = 46, violating RFC
# 4271 section 4.3 (Length counts the whole message including the 19-byte header),
# and their NLRI `18 01 01 00` is 1.1.0.0/24, not the 10.1.0.0/24 the cmd= text
# names (`18 0A 01 00`). No well-formed UPDATE could ever match them, and the file
# stayed green because the run script's `finally` requests shutdown, so ze still
# exited 0 and only `expect=exit:code=0` was consulted.
#
# option=update:value=send-route is the ze-peer-consumed injection directive
# (internal/test/peer/expect.go parseOptionConfig -> Config.SendRoutes ->
# peer.go:371 runMessageLoop -> BuildRouteMsg, message.go:147).
#
# origin-as is deliberately omitted: this is an iBGP session (local asn 1 ==
# remote asn 1), so the routes carry an empty AS_PATH, as an iBGP-originated
# route must.
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=20s
# A check-mode peer closes the instant its expectations are met, and the only
# one here is ze's End-of-RIB, which ze owes immediately (it has nothing to
# announce). That close reaches ze as a peer-down, and a peer-down with
# graceful-restart disabled DELETES the peer's Adj-RIB-In
# (rib.go handleState -> delete(r.bgpPeers, peerAddr), RFC 4271 section 9), so
# every `show bgp rib received` below would read an empty table. linger holds
# the session open until teardown, which is what makes the five injected routes
# observable for the length of the script.
option=linger:value=true
option=update:value=send-route:prefix=10.1.0.0/24:next-hop=10.0.0.1
option=update:value=send-route:prefix=10.2.0.0/24:next-hop=10.0.0.1
option=update:value=send-route:prefix=10.3.0.0/24:next-hop=10.0.0.1
option=update:value=send-route:prefix=10.4.0.0/24:next-hop=10.0.0.1
option=update:value=send-route:prefix=10.5.0.0/24:next-hop=10.0.0.1
# ze has nothing to announce back on this session, so the only message it owes the
# peer is its own End-of-RIB for ipv4/unicast: an UPDATE with no withdrawn routes
# and no path attributes (RFC 4724 section 2), length 23 = 19 + 2 + 2. This
# expectation is the file's own, kept unchanged.
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER


# ze bgp configuration
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external pipe-first-last-test {
		run "ze-test fixture plugin/test-pipe-first-last"
		encoder json
	}
	internal bgp-rib {
		use bgp-rib
	}
	internal adj-rib-in {
		use bgp-adj-rib-in
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}

		attach process bgp-rib {
			receive [ update state refresh ]
			send [ update ]
		}
		attach process adj-rib-in {
			receive [ update-received state ]
		}
	}
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
