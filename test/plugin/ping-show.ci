# Test: show ping to localhost via dispatch-command
# Exercises: dispatch-command -> ze-show:ping -> handleShowPing -> doPing ->
#            doPingCtx -> runPingBatch (paced, seq-keyed batch over raw ICMP).
# Verifies: when privileged, JSON has destination/sent/received/loss-percent/
#           replies[] (each reply seq/status[/rtt-ms]). When the daemon lacks
#           CAP_NET_RAW (unprivileged runner) the handler returns a deterministic
#           error that names CAP_NET_RAW; both branches are asserted, so the test
#           is green unprivileged and green under a privileged/QEMU-root run.
#           Also asserts the `size` argument is wired: a valid size is accepted
#           (never a parse error) and an out-of-range size is rejected by name.
#           parsePingArgs runs before any socket, so the rejection is
#           deterministic even unprivileged. Finally a count=3 batch exercises the
#           multi-probe paced path runPingBatch introduced (spec
#           fixit-show-ping-serial-pacing): count 1 alone never spaced two sends,
#           so it could not catch a shape regression under a real batch.
# NOTE: raw ICMP (ip4:icmp) needs CAP_NET_RAW; the default bin/ze-test runner is
#       unprivileged, so the error branch is what executes here. The boundedness
#       the spec targets (a lossy batch finishing in ~timeout, not count*timeout)
#       is proven by the fake-clock unit tests (TestDoPing* in ping_test.go); a
#       privileged/QEMU run against a black hole is what turns it into evidence.

# ze-peer: accepts connection
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
option=asn:value=65001
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

tmpfs=show-ping-test.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
import json
import sys
from ze_api import API, runtime_fail, result_text_data

def dispatch(api, command):
    # Convert an RPC-level failure (e.g. an unwired/unknown command, which makes
    # _call_engine raise) into a status=error dict so the assertions below fire a
    # loud runtime_fail instead of crashing the plugin and passing vacuously.
    try:
        resp = api._call_engine(
            'ze-plugin-engine:dispatch-command', {'command': command})
    except Exception as e:
        return {'status': 'error', 'error': f'engine call raised: {e}'}
    if resp is None:
        return {'status': 'error', 'error': 'engine call returned None'}
    return resp.get('result', {})

def check_happy_path(resp):
    data = result_text_data(resp)
    if isinstance(data, str) and data:
        data = json.loads(data)
    if not isinstance(data, dict):
        runtime_fail(f'ping: expected dict, got {type(data).__name__}')
    if data.get('destination') != '127.0.0.1':
        runtime_fail(f'ping: expected destination=127.0.0.1, got {data.get("destination")!r}')
    if data.get('sent') != 1:
        runtime_fail(f'ping: expected sent=1, got {data.get("sent")!r}')
    if data.get('received') != 1:
        runtime_fail(f'ping: expected received=1 (loopback), got {data.get("received")!r}')
    replies = data.get('replies')
    if not isinstance(replies, list) or len(replies) != 1:
        runtime_fail(f'ping: expected 1 reply, got {replies!r}')
    reply = replies[0]
    if reply.get('status') != 'ok':
        runtime_fail(f'ping: expected reply status=ok, got {reply!r}')
    if 'rtt-ms' not in reply:
        runtime_fail(f'ping: missing "rtt-ms" in reply: {reply}')
    print(f'OK: show ping (privileged) received={data["received"]} loss={data["loss-percent"]}', file=sys.stderr)

def check_size_accepted(api):
    # A valid size must reach doPing. Unprivileged that surfaces as the same
    # CAP_NET_RAW error as the plain ping; privileged it completes. What must
    # never appear is a parse error -- that would mean `size` is not wired.
    resp = dispatch(api, 'show ping 127.0.0.1 count 1 size 1400 timeout 2s')
    status = resp.get('status')
    err = resp.get('error') or ''
    if status == 'done':
        print('OK: show ping size 1400 accepted (privileged)', file=sys.stderr)
        return
    if status != 'error':
        runtime_fail(f'ping size: unexpected status={status!r} resp={resp}')
    if 'CAP_NET_RAW' not in err:
        runtime_fail(f'ping size: size not wired, got parse/other error: {err!r}')
    print(f'OK: show ping size 1400 reached doPing: {err}', file=sys.stderr)

def check_multiprobe_batch(api):
    # A count=3 batch drives the paced multi-probe path (runPingBatch): the old
    # single-probe test never spaced two sends, so it could not catch a shape
    # regression under a real batch. Loopback answers every probe, so privileged
    # the run is sent=3/received=3 with 3 seq-ordered replies; unprivileged it is
    # the same deterministic CAP_NET_RAW error. Either way the map shape must hold.
    resp = dispatch(api, 'show ping 127.0.0.1 count 3 timeout 2s')
    status = resp.get('status')
    if status == 'error':
        err = resp.get('error') or ''
        if 'CAP_NET_RAW' not in err:
            runtime_fail(f'ping batch: unexpected error (want CAP_NET_RAW): {err!r}')
        print(f'OK: show ping count 3 wired; raw ICMP needs CAP_NET_RAW: {err}', file=sys.stderr)
        return
    if status != 'done':
        runtime_fail(f'ping batch: unexpected status={status!r} resp={resp}')
    data = result_text_data(resp)
    if isinstance(data, str) and data:
        data = json.loads(data)
    if not isinstance(data, dict):
        runtime_fail(f'ping batch: expected dict, got {type(data).__name__}')
    if data.get('sent') != 3:
        runtime_fail(f'ping batch: expected sent=3, got {data.get("sent")!r}')
    if data.get('received') != 3:
        runtime_fail(f'ping batch: expected received=3 (loopback), got {data.get("received")!r}')
    replies = data.get('replies')
    if not isinstance(replies, list) or len(replies) != 3:
        runtime_fail(f'ping batch: expected 3 replies, got {replies!r}')
    for i, r in enumerate(replies):
        if r.get('seq') != i:
            runtime_fail(f'ping batch: reply {i} out of order, seq={r.get("seq")!r} (runPingBatch must sort by seq)')
        if 'status' not in r:
            runtime_fail(f'ping batch: reply {i} missing status: {r}')
    print(f'OK: show ping count 3 batch shape held received={data["received"]}', file=sys.stderr)

def check_size_rejected(api):
    # Rejection happens before any socket, so this is deterministic regardless
    # of CAP_NET_RAW. Two layers can reject, and either is a pass as long as the
    # 65507 bound is named:
    #   - the range "1..65507" on the show/ping size leaf (ze-ping-cmd.yang),
    #     which the dispatcher enforces -> "value 99999 out of range 1..65507";
    #   - parsePingArgs' own maxPingSize check (ping.go), which guards the
    #     offline `show ping` path that never goes through YANG validation
    #     -> "ping: size must be 1-65507".
    resp = dispatch(api, 'show ping 127.0.0.1 count 1 size 99999 timeout 2s')
    err = resp.get('error') or result_text_data(resp) or ''
    if resp.get('status') != 'error':
        runtime_fail(f'ping size: expected error for size 99999, got {resp!r}')
    if '65507' not in err:
        runtime_fail(f'ping size: expected a bound error naming 65507, got {err!r}')
    print(f'OK: show ping rejects out-of-range size: {err}', file=sys.stderr)

def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()
    api.wait_for_post_startup(timeout=5.0)

    try:
        resp = dispatch(api, 'show ping 127.0.0.1 count 1 timeout 2s')
        status = resp.get('status')
        if status == 'done':
            check_happy_path(resp)
        elif status == 'error':
            err = resp.get('error') or result_text_data(resp)
            if 'CAP_NET_RAW' not in (err or ''):
                runtime_fail(f'ping: unexpected error (want CAP_NET_RAW): {err!r}')
            print(f'OK: show ping wired; raw ICMP needs CAP_NET_RAW: {err}', file=sys.stderr)
        else:
            runtime_fail(f'ping: unexpected status={status!r} resp={resp}')

        check_size_accepted(api)
        check_size_rejected(api)
        check_multiprobe_batch(api)
    finally:
        dispatch(api, 'request shutdown')
        api.wait_for_shutdown()

if __name__ == '__main__':
    main()
EOF_RUN

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external show-ping-test {
		run ./show-ping-test.run
		encoder json
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast {
					prefix {
						maximum 10000
					}
				}
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
