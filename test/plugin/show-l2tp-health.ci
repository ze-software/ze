# Test: show l2tp health dispatches to the l2tp health handler
# Exercises: dispatch-command -> ze-show:l2tp-health -> handleShowL2TPHealth
# Verifies the R9 rename `show l2tp health` (was `show l2tp-health`) resolves to
# its handler end-to-end. With the l2tp service up but no login sessions and CQM
# off, the handler returns its own "observer not enabled (CQM disabled)" error;
# with CQM + sessions it returns {logins, count, degraded} status=done. Either
# proves the renamed command reaches its handler -- a broken rename would 404.
# Native (l2tp control-plane, kernel probe skipped).

option=env:var=ze.l2tp.skip-kernel-probe:value=true
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

tmpfs=show-l2tp-health-test.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
import json
import sys
from ze_api import API, runtime_fail, result_text_data

def dispatch(api, command):
    resp = api._call_engine(
        'ze-plugin-engine:dispatch-command', {'command': command})
    if resp is None:
        return {'status': 'error', 'data': 'engine call returned None'}
    return resp.get('result', {})

def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()
    api.wait_for_post_startup(timeout=5.0)

    try:
        r = dispatch(api, 'show l2tp health')
        status = r.get('status')
        blob = json.dumps(r)
        if status == 'done':
            data = result_text_data(r)
            if isinstance(data, str) and data:
                data = json.loads(data)
            if not isinstance(data, dict) or 'logins' not in data or 'count' not in data:
                runtime_fail(f'l2tp-health: done but unexpected shape {data!r}')
            print(f'OK: l2tp health done count={data.get("count")}', file=sys.stderr)
        elif status == 'error' and ('observer not enabled' in blob or 'CQM' in blob or 'l2tp subsystem' in blob):
            print('OK: l2tp health reached handler (CQM/observer off in harness)', file=sys.stderr)
        else:
            runtime_fail(f'l2tp-health: did not reach handler: {blob}')
    finally:
        dispatch(api, 'request shutdown')
        api.wait_for_shutdown()

if __name__ == '__main__':
    main()
EOF_RUN

stdin=ze-conf:terminator=EOF_CONF
plugin {
	external show-l2tp-health-test {
		run ./show-l2tp-health-test.run
		encoder json
	}
}

environment {
	l2tp {
		server main {
			ip 127.0.0.1
			port $PORT2
		}
	}
}

l2tp {
	enabled true
	shared-secret l2tp-health-secret
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-conf:timeout=15s
expect=exit:code=0
