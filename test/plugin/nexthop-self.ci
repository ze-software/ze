# Test: next-hop self config parses and peer detail reports it
# VALIDATES: cmd-1 AC-7 -- next-hop self configured on peer
# VALIDATES: cmd-1 AC-13 -- peer detail shows next-hop mode
# PREVENTS: next-hop self config not wired to PeerSettings

# One iBGP peer with next-hop self. Python observer verifies the peer
# detail output shows the next-hop mode. Wire-level NH rewriting is
# covered by unit tests (TestNextHopSelf in reactor_forward_test.go)
# and the config parse test (test/parse/rr-nexthop-config.ci).

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s

# Send a basic IPv4 UPDATE
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0036020000001B4001010040020602010000FDE94003040A000001400504000000C8180A0100
# Assert ze's ipv4/unicast End-of-RIB (RFC 4724 S2: the empty UPDATE). This is a
# real wire assertion, not just a TCP-hold: the observer gates `request shutdown`
# on eor-sent >= 1 (see wait_eor_sent below), so ze is given the chance to emit it.
# It also keeps the peer from closing TCP while the observer polls for peer state.
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

tmpfs=nh-test.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
import json
import sys
from ze_api import API, runtime_fail, result_text_data, result_json_data
# // test-relax: removed unused 'import time'; hand-rolled established poll -> dispatch_until

def dispatch(api, command):
    resp = api._call_engine(
        'ze-plugin-engine:dispatch-command', {'command': command})
    if resp is None:
        return {'status': 'error', 'data': 'engine call returned None'}
    return resp.get('result', {})

def eor_sent(result):
    """True once ze has written its End-of-RIB to at least one peer.

    `show bgp peer <sel> detail` returns {"peers": {"<ip>": {..., "eor-sent": N}}}
    (peer.go:217, :341-345). The counter is incremented at the EOR write itself
    (peer_initial_sync.go:334-335), so eor-sent >= 1 proves the marker is on the
    wire rather than merely scheduled.
    """
    if result.get('status') != 'done':
        return False
    try:
        peers = result_json_data(result, {}).get('peers', {})
    except (json.JSONDecodeError, TypeError, ValueError):
        return False
    return any(p.get('eor-sent', 0) >= 1 for p in peers.values())

def wait_eor_sent(api, selector):
    """Block until ze has sent its EOR, so `request shutdown` cannot pre-empt it.

    The peer block asserts ze's End-of-RIB on the wire. ze emits it only after the
    initial-sync barrier: peer_initial_sync.go:174-178 sleeps 500ms and then waits
    for the plugin ready signal before :332-337 builds and sends the EOR. The
    session reaches `established` long before that, so a shutdown gated on
    establishment (or on the RIB check) closes TCP first and the peer's expectation
    can never fire. Gate on the EOR the test actually asserts.
    """
    if not eor_sent(api.dispatch_until(
            f'show bgp peer {selector} detail', eor_sent, attempts=40)):
        runtime_fail(f'ze never sent its End-of-RIB to {selector}')

def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()

    # Poll until peer session is established.
    # // test-relax: hand-rolled sleep/poll loop -> dispatch_until on peer detail (established)
    result = api.dispatch_until(
        'show bgp peer peer1 detail',
        lambda r: r.get('status') == 'done' and 'established' in result_text_data(r).lower(),
    )
    if 'established' not in result_text_data(result).lower():
        runtime_fail('peer1 never reached established state')

    # Verify peer detail shows next-hop self
    result = dispatch(api, 'show bgp peer peer1 detail')
    if result.get('status') != 'done':
        runtime_fail(f'peer detail failed: {result}')

    detail = result_text_data(result)
    if '"next-hop"' not in detail:
        runtime_fail(f'peer detail missing next-hop field: {detail[:200]}')
    if '"self"' not in detail:
        runtime_fail(f'peer detail should show next-hop self: {detail[:200]}')

    # Verify RIB has the route.
    # // test-relax: poll show bgp rib best until the wire UPDATE lands (deterministic; the
    # removed establishment sleep-loop had masked the route-propagation race)
    def rib_has_route(res):
        if res.get('status') != 'done':
            return False
        try:
            rows = json.loads(result_text_data(res, '{}')).get('best-path', [])
        except (json.JSONDecodeError, TypeError):
            return False
        return any(e.get('prefix') == '10.1.0.0/24' for e in rows)

    result = api.dispatch_until('show bgp rib best', rib_has_route)
    if result.get('status') != 'done':
        runtime_fail(f'rib show best failed: {result}')

    data = result_text_data(result, '{}')
    parsed = json.loads(data) if isinstance(data, str) else data
    entries = parsed.get('best-path', [])

    found = any(e.get('prefix') == '10.1.0.0/24' for e in entries)
    if not found:
        runtime_fail(f'route 10.1.0.0/24 not in RIB')

    print('OK: next-hop self configured and route in RIB', file=sys.stderr)

    wait_eor_sent(api, 'peer1')

    dispatch(api, 'request shutdown')
    api.wait_for_shutdown()

if __name__ == '__main__':
    main()
EOF_RUN

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external nh-test {
		run ./nh-test.run
		encoder json
	}
	internal bgp-rib {
		use bgp-rib
	}
}
bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65000
			}
			router-id 1.2.3.4
			next-hop self
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}

		process nh-test {
		}
		process bgp-rib {
			receive [ state ]
			send [ update ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
reject=stderr:pattern=panic recovered
reject=stderr:pattern=fatal error
reject=stderr:pattern=ZE-OBSERVER-FAIL
