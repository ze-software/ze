# Test: family-filter remove drops a received family without tearing the session
# VALIDATES: AC-4 -- import remove ipv4/flow: a received FlowSpec UPDATE is dropped
#            (whole-UPDATE suppress, MP-only) and the session stays Established.
# PREVENTS: a removed family tearing the session down, or leaking past the filter.
#
# Flow:
# 1. ze-peer sends a raw-hex FlowSpec UPDATE (ipv4/flow, MP-only).
# 2. The import chain calls bgp-filter-family:NoFlow (family ipv4/flow, action remove).
# 3. Stripping the only NLRI empties the UPDATE -> the handler rejects it (suppress).
# 4. No tear-down occurs; the decision log confirms the suppress.

option=env:var=ze.log.bgp.filter.family:value=info

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
# FlowSpec UPDATE (same wire as flowspec-fw-add.ci): MP_REACH ipv4/flow, dest 10.1.0.0/24 protocol tcp dport 80
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF004802000000314001010040020040050400000064C010080800000000000001800E150001850401020304000B01180A0100038106058150
EOF_PEER


stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external test-family-remove {
		run "ze-test fixture plugin/filter-family-import-remove"
		encoder json
	}
}
bgp {
	policy {
		family-filter NoFlow {
			family ipv4/flow
			action remove
		}
	}

	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/flow { prefix { maximum 10000; } }
			}
		}

		filter {
			import [ bgp-filter-family:NoFlow ]
		}

		attach process test-family-remove {
			receive [ update state ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze --plugin ze.bgp-filter-family --plugin ze.bgp-nlri-flowspec -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
# The family filter must have removed (suppressed) the FlowSpec UPDATE.
expect=stderr:pattern=filter-family remove \(suppress\)
expect=stderr:pattern=filter=NoFlow
# The session must NOT be torn down on a remove.
reject=stderr:pattern=filter-family tear-down
