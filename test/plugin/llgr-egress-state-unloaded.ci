# Test: LLGR egress filter with the GR plugin engine in ANOTHER process.
#
# The daemon registers LLGREgressFilter from init() (bgp/plugins/gr/register.go),
# so the filter is live in every ze_bgp build. The only writer of the state it
# reads is setEgressState, called from RunGRPlugin's OnConfigure callback. This
# config runs bgp-gr with `run` rather than `use`, so ExtractPluginsFromTree
# leaves PluginConfig.Internal false, Process.StartWithContext takes
# startExternal, and RunGRPlugin executes in the CHILD. The daemon's own egress
# state is therefore nil for the whole life of the process while the filter keeps
# being called on the readvertise rail.
#
# RFC 9494 Section 4.3 keys the decision on whether the LLGR Capability "has been
# received" from the neighbor. With nothing recorded in this process it has not,
# so the filter treats the destination as LLGR-incapable and Section 4.6 applies:
# the internal neighbor still receives the stale route, depreferenced with
# NO_EXPORT and LOCAL_PREF 0.
#
# RFC requirement: RFC9494-4.3-3 positive -- "The route SHOULD NOT be advertised to
#   any neighbor from which the Long-Lived Graceful Restart Capability has not been
#   received. The exception is described in Section 4.6." This process records no
#   capability for any neighbor, so the stale route leaves only by the Section 4.6
#   exception: obsn's seq=2 expectation is the depreferenced form (NO_EXPORT,
#   0xFFFFFF01), never the route as the source sent it. This is the daemon-level
#   proof of the same decision the unit tests make on the filter
#   (internal/component/bgp/plugins/gr/gr_egress_test.go).
#
# This is a config-only route to the unloaded state. It needs no test hook, which
# is what plan/spec-fixit-egress-filter-non-decision-channel.md's withdrawn `.ci`
# row wrongly claimed was impossible. `ze doctor` reports this arrangement as
# doctor-bgp-gr-out-of-process (bgp/plugins/gr/doctor.go).
#
# VALIDATES: an unloaded LLGR egress state depreferences a stale route toward a
#            non-LLGR internal neighbor, in the daemon, on the wire.
# PREVENTS: the daemon advertising a stale route unchanged because the GR plugin
#           engine runs in another process.
#
# Discrimination: reverting LLGREgressFilter to accept on a nil state re-sends the
# route with no modification, so the NO_EXPORT expectation below never arrives.
#
# The state-LOADED contrast is llgr-readvertise-multipeer.ci: the same scenario
# with `internal gr { use bgp-gr }`, which loads the state in the daemon.


# --- source: LLGR RR-client, announces 10.0.0.0/24 then waits on ze's EOR ---
stdin=source:terminator=EOF_SOURCE
option=tcp_connections:value=1
option=timeout:value=20s
# Hold the session open past this peer's own expect. A check-mode ze-peer closes
# the instant its expectations are met, and the close reaches ze as a peer-down
# that withdraws 10.0.0.0/24 from obsn: obsn then reads that withdrawal as its
# seq=2 and the depreference never arrives. The header above states the intent
# this restores: the stale transition is driven by mark-stale and clear-rib-out,
# never by a disconnect.
option=linger:value=true
# iBGP UPDATE: ORIGIN igp, AS_PATH [65001], NEXT_HOP 10.0.0.1, LOCAL_PREF 200,
# NLRI 10.0.0.0/24.
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0036020000001B4001010040020602010000FDE94003040A000001400504000000C8180A0000
# Wait for ze's End-of-RIB so the peer stays established long enough for the
# reflection to land.
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_SOURCE

# --- obsn: non-LLGR RR-client, observes the reflected route then depreference ---
# Both peers are RR clients in AS 65000, and ze-peer's default OPEN mirrors ze's
# router-id with the last octet incremented, so without an explicit identifier
# BOTH would present 1.2.3.5 -- two RR clients sharing a BGP Identifier, which ze
# rejects (RFC 6286 Section 2.1).
stdin=obsn:terminator=EOF_OBSN
option=tcp_connections:value=1
option=timeout:value=20s
option=open:value=router-id:id=1.2.3.6
# 1. Reflected route lands (NLRI 10.0.0.0/24). EORs and keepalives auto-skip.
expect=bgp:conn=1:seq=1:contains=180A0000
# 2. The readvertise depreferences it with no egress state in THIS process: the
#    NO_EXPORT community (well-known 0xFFFFFF01) is stamped on.
expect=bgp:conn=1:seq=2:contains=FFFFFF01
EOF_OBSN

tmpfs=observer.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
import sys
from ze_api import (
    API,
    dispatch,
    dispatch_until,
    result_text_data,
    runtime_fail,
)

OBSN = '127.0.0.2'


def obsn_counter(api, field):
    """Return one integer counter from obsn's `show bgp peer * detail` row.

    Indexed out of the all-peers dict rather than dispatched with the address as
    the selector, because peer_fields keys its rows by address while this config
    names its peers `source` and `obsn`. A row that is not there yet reads as 0,
    which is what a poller wants.
    """
    row = api.peer_fields('*').get(OBSN, {})
    if not isinstance(row, dict):
        return 0
    try:
        return int(row.get(field, 0) or 0)
    except (TypeError, ValueError):
        return 0


def obsn_routes_sent(api):
    """UPDATEs written to obsn that are not its End-of-RIB.

    updates-sent counts every UPDATE written to the session, End-of-RIB
    included: session_write.go calls onMessageReceived with DirectionSent once
    the bytes are on the socket, and reactor_notify.go increments the counter on
    TypeUPDATE. eor-sent is the separate marker, so the difference counts real
    routes toward obsn -- the same two writes obsn's own expect rules read.
    """
    return obsn_counter(api, 'updates-sent') - obsn_counter(api, 'eor-sent')


def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()

    # Barrier 1: the source route is selected best, so it can be reflected.
    best = dispatch_until(
        api,
        'show bgp rib best',
        lambda r: r.get('status') == 'done'
        and '10.0.0.0/24' in result_text_data(r),
        attempts=60,
    )
    if '10.0.0.0/24' not in result_text_data(best):
        runtime_fail(f'source route never became best: {best}')

    # Barrier 2: both peers have their initial-sync End-of-RIB on the wire. That
    # frame IS the source peer's only expect, and eor-sent counts markers ze has
    # flushed to the socket. It also makes the readvertise below a clean post-EOR
    # incremental instead of a write racing a sync that is still draining.
    if not api.wait_peer_eor_sent(expected_peers=2, attempts=60):
        runtime_fail('ze never sent both peers their End-of-RIB')

    # Barrier 3: the reflection has been WRITTEN to obsn, which is obsn's seq=1
    # expect. The reflection and the readvertise below reach obsn over the same
    # session, so this counter is what orders them; a duration only guessed.
    if not api.wait_until(lambda: obsn_routes_sent(api) >= 1, attempts=60):
        runtime_fail('obsn was never sent the reflected route '
                     f'(routes sent={obsn_routes_sent(api)})')

    # Mark the source's routes stale at the depreference level and readvertise.
    base = obsn_routes_sent(api)
    ms = dispatch(api, 'request bgp rib mark-stale 127.0.0.1 60 2')
    if ms.get('status') != 'done':
        runtime_fail(f'mark-stale failed: {ms}')
    cr = dispatch(api, 'clear bgp rib out * ipv4/unicast')
    if cr.get('status') != 'done':
        runtime_fail(f'clear-rib-out failed: {cr}')

    print('OK: mark-stale + clear-rib-out dispatched', file=sys.stderr)

    # Barrier 4: the depreferenced readvertise is on the wire, which is obsn's
    # seq=2 expect. Shutting down on a duration raced that write; this cannot.
    if not api.wait_until(lambda: obsn_routes_sent(api) >= base + 1,
                          attempts=60):
        runtime_fail('the readvertise never reached obsn '
                     f'(routes sent={obsn_routes_sent(api)}, want {base + 1})')

    dispatch(api, 'request shutdown')
    api.wait_for_shutdown()


if __name__ == '__main__':
    main()
EOF_RUN

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	internal rs {
		use bgp-rs
	}
	internal adj-rib-in {
		use bgp-adj-rib-in
	}
	external observer {
		run ./observer.run
		encoder json
	}
	external gr {
		run "ze plugin bgp-gr"
	}
	internal bgp-rib {
		use bgp-rib
	}
}

bgp {
	peer source {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65000
			}
			router-id 1.2.3.4
			route-reflector-client true
			cluster-id 10.10.10.10
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart {
					restart-time 60
					long-lived-stale-time 300
				}
			}
		}
		behavior {
			group-updates disable
		}

		attach process gr {
			receive [ open-received state eor ]
			send [ update ]
		}
		attach process bgp-rib {
			receive [ update state refresh ]
			send [ update ]
		}
		attach process adj-rib-in {
			receive [ update-received state ]
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
	}

	peer obsn {
		connection {
			remote {
				ip 127.0.0.2
			}
			local {
				ip 127.0.0.2
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65000
			}
			router-id 1.2.3.4
			route-reflector-client true
			cluster-id 10.10.10.10
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}

		attach process bgp-rib {
			receive [ update state refresh ]
			send [ update ]
		}
		attach process adj-rib-in {
			send [ update ]
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=source
cmd=background:seq=2:exec=ze-peer --bind 127.0.0.2 --port $PORT:stdin=obsn
cmd=foreground:seq=3:exec=ze -:stdin=ze-bgp:timeout=25s
expect=exit:code=0
reject=stderr:pattern=panic recovered
reject=stderr:pattern=fatal error
