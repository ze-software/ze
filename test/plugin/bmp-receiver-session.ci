# Test: BMP receiver starts listener from config
# VALIDATES: AC-10 -- receiver binds TCP listener from config
#
# Flow:
# 1. ze starts with BMP receiver enabled on $PORT2
# 2. Observer waits for BMP listener log, then shuts down
# 3. Assertion verifies receiver is listening

option=env:var=ze.log.bgp.bmp:value=info
option=timeout:value=15s


stdin=ze-bgp:terminator=EOF_CONF
environment {
    bmp {
        enabled true;
        server default {
            ip 127.0.0.1;
            port $PORT2;
        }
    }
}
plugin {
    external bmp-observer {
        run "ze-test fixture plugin/bmp-receiver-session $PORT2;"
        encoder json;
    }
}
bgp {
    router-id 1.2.3.5;
    peer test {
        connection {
            remote {
                ip 127.0.0.1
            }
            local {
                ip 127.0.0.1
                accept false
            }
        }
        session {
            asn {
                local 65000;
                remote 65001;
            }
            router-id 1.2.3.5;
            family {
                ipv4/unicast { prefix { maximum 10000; } }
            }
        }
    }
}
EOF_CONF

stdin=peer:terminator=EOF_PEER
EOF_PEER

cmd=background:seq=1:exec=ze-peer --mode sink --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze --plugin ze.bgp-bmp -:stdin=ze-bgp
expect=exit:code=0
expect=stderr:pattern=bmp: receiver listening
