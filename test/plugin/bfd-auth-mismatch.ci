# Test: BFD plugin rejects `auth { type simple-password }` at parse time.
#
# VALIDATES: spec-bfd-5 AC-10 -- Simple Password is refused by the
#            YANG enum (only the four keyed variants are accepted)
#            and the parser emits a descriptive error pointing at
#            RFC 5880 Section 6.7.2.
# PREVENTS:  accidental acceptance of Simple Password via config
#            drift; regression that silently falls back to no auth.
#
# Method: a native Go fixture launches ze with a simple-password
# auth block, waits briefly, and looks for the rejection message in
# stderr. ze continues running after the bfd configure callback
# fails (BFD is non-fatal) so the orchestrator SIGTERMs on success.

option=env:var=ze.bfd.test-parallel:value=true
# BFD listens on the RFC 5881 / RFC 5883 FIXED ports, so every concurrently
# running BFD test's daemon binds the same wildcard (0.0.0.0, 3784/3785) tuple.
# SO_REUSEPORT above lets them co-bind, and the kernel then HASHES each inbound
# datagram to one socket in the group (internal/component/bfd/transport/
# udp_linux.go applySocketOptions) -- so a control reply or a reflected echo meant
# for this daemon can be delivered to a sibling test's daemon instead. That is the
# kernel-global surface option=exclusive exists for: unique addresses cannot
# partition a port number the RFC fixes. Tests outside the group still run
# alongside these.
option=exclusive:group=bfd-ports



cmd=foreground:seq=1:exec=ze-test fixture plugin/bfd-auth-mismatch:timeout=15s
expect=exit:code=0
expect=stderr:pattern=simple-password rejected
