# Test: a firewall TABLE TERM matching by AS-SET commits and reaches the kernel.
# VALIDATES: spec-fixit-firewall-irr-term-fails-validation AC-1, AC-2, AC-7 --
#            the operator workflow the firewall guide documents, end to end:
#            fetch the prefixes, commit a term whose from-block names the AS-SET,
#            and find the rule in the kernel ruleset. Two AS-SETs are committed:
#            AS-TEST announces both families, AS-V4ONLY announces IPv4 alone.
# PREVENTS:  the table form staying dead. ValidateTables refused every IRR term
#            with `match references unknown set "irr_v4_AS-TEST"`, because the
#            set belongs to the firewall-irr owner and the two owners meet only
#            at ApplyAll.
#            It also prevents the single-family case costing the operator the
#            WHOLE table. The parser emits an IPv6 twin of every IRR term
#            because it cannot see the prefix data (expandIRRTermV6,
#            internal/component/firewall/config.go), so an IPv4-only AS-SET left
#            that twin naming a set no owner declared and
#            dropTablesMissingAProvidedSet
#            (internal/component/firewall/registry.go) removed the whole table
#            while the commit reported success. An AS-SET with no IPv6 space is
#            the common case, which a fixture answering both families never
#            reaches.
#
# Flow:
# 1. The daemon starts with no firewall table, so nothing references the set yet.
# 2. The observer fetches AS-TEST and AS-V4ONLY from the mock IRR server.
# 3. trigger.sh swaps in a config carrying both table terms and sends SIGHUP.
# 4. The observer waits for the reload, then reads the kernel ruleset back.

# This test programs nftables, so it needs CAP_NET_ADMIN, not merely Linux.
option=needs-linux:caps=net-admin
# Serialize against every other firewall-irr test. The nftables ruleset is
# NODE-WIDE, and the table names these tests program cannot be varied from a
# .ci: ifaceTableName is the Go constant "ze_irr_iface"
# (internal/component/firewall/plugins/irr/sets.go) and the config-derived names
# collide as ze_wan and ze_lan. Apply
# (internal/plugins/firewall/nft/backend_linux.go) lists the node's tables and
# deletes every ze_* table it is about to program, so one daemon removes a
# sibling's live table and the sibling reads back terms it never wrote. The
# persisted prefix store is shared too: DefaultConfigDir
# (internal/core/paths/paths.go) derives it from the binary path, so every
# daemon in the run opens one database.zefs, and a sibling that fetches AS-TEST
# destroys the cold-cache precondition firewall-irr-cold-cache-recovers asserts
# on its first line. MEASURED 2026-08-22 in one privileged container: run in
# parallel 2 of 12 failed, run serially 12 of 12 pass.
option=exclusive:group=firewall-irr-nft
option=env:var=ze.log.firewall.irr:value=debug
option=timeout:value=30s

tmpfs=firewall-irr-table-term-commit.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
"""Fetch two AS-SETs, commit a table term for each, read the ruleset back."""
import os
import sys
from ze_api import API, runtime_fail, result_json_data

def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()

    result = api.dispatch_until_done('update firewall irr as-set AS-TEST')
    if result.get('status') != 'done':
        runtime_fail(f'update failed: {result}')
    data = result_json_data(result, {})
    if data.get('ipv4-count', 0) < 1 or data.get('ipv6-count', 0) < 1:
        runtime_fail(f'AS-TEST must cache both families: {result}')

    # AS-V4ONLY announces IPv4 and no IPv6, which is the ordinary case for most
    # networks. Its term still reaches the kernel as two rules, so the table
    # must declare the IPv6 set too, empty.
    result = api.dispatch_until_done('update firewall irr as-set AS-V4ONLY')
    if result.get('status') != 'done':
        runtime_fail(f'update failed for AS-V4ONLY: {result}')
    data = result_json_data(result, {})
    if data.get('ipv4-count', 0) < 1:
        runtime_fail(f'no IPv4 prefixes cached for AS-V4ONLY: {result}')
    if data.get('ipv6-count', 0) != 0:
        runtime_fail(f'AS-V4ONLY must cache no IPv6 prefixes: {result}')

    with open('observer.fetched', 'w') as f:
        f.write('ok')

    if not api.wait_until(lambda: os.path.exists('reload.done'), attempts=200, delay=0.1):
        runtime_fail('trigger.sh never created reload.done marker')

    result = api.dispatch_until(
        'show firewall ruleset wan',
        lambda res: res.get('status') == 'done' and 'from-v4only_v6' in str(result_json_data(res, {})),
        attempts=100,
        delay=0.1,
    )
    dumped = str(result_json_data(result, {}))
    if result.get('status') != 'done':
        runtime_fail(f'ruleset dump failed after the commit: {result}')
    for term in ('from-as-test', 'from-as-test_v6', 'from-v4only', 'from-v4only_v6'):
        if term not in dumped:
            runtime_fail(f'term {term} is not in the kernel ruleset: {dumped}')
    # The dump lists terms, not sets. A programmed match-in-set rule is the
    # proof the set is on the table: lowerMatchInSet refuses to lower a match
    # against a set the table does not carry, and the whole apply fails with it.
    # from-v4only_v6 is therefore the single-family assertion: it names
    # irr_v6_AS-V4ONLY, a set the AS-SET has no prefixes for.
    print('OK: both table terms and their IPv6 twins are in the kernel ruleset', file=sys.stderr)

    api._call_engine('ze-plugin-engine:dispatch-command', {'command': 'request shutdown'})
    api.wait_for_shutdown()

if __name__ == '__main__':
    main()
EOF_RUN

tmpfs=trigger.sh:mode=755:terminator=EOF_TRIGGER
#!/bin/sh
# Swap in the config carrying the table terms once the prefixes are cached.
while [ ! -f daemon.pid ]; do sleep 0.1; done
while [ ! -f daemon.ready ]; do sleep 0.1; done
while [ ! -f observer.fetched ]; do sleep 0.1; done
cp config2.conf ze-bgp.conf
kill -HUP $(cat daemon.pid)
touch reload.done
EOF_TRIGGER

tmpfs=config2.conf:terminator=EOF_CONF2
plugin {
	external firewall-irr-table-term-test {
		run ./firewall-irr-table-term-commit.run
		encoder json
	}
}
firewall {
	backend nft;
	irr {
		server 127.0.0.1:$PORT2;
	}
	table wan {
		family inet;
		chain input {
			type filter;
			hook input;
			priority 0;
			policy accept;
			term from-as-test {
				from {
					source-as-set AS-TEST;
				}
				then {
					accept;
				}
			}
			term from-v4only {
				from {
					source-as-set AS-V4ONLY;
				}
				then {
					accept;
				}
			}
		}
	}
}
bgp {
	peer peer1 {
		connection {
			remote { ip 127.0.0.1; }
			local { ip 127.0.0.1; accept false; }
		}
		session {
			asn { local 1; remote 1; }
			router-id 1.2.3.4;
			family { ipv4/unicast { prefix { maximum 10000; } } }
		}
	}
}
EOF_CONF2

stdin=ze-fw:terminator=EOF_CONF
plugin {
	external firewall-irr-table-term-test {
		run ./firewall-irr-table-term-commit.run
		encoder json
	}
}
firewall {
	backend nft;
	irr {
		server 127.0.0.1:$PORT2;
	}
}
bgp {
	peer peer1 {
		connection {
			remote { ip 127.0.0.1; }
			local { ip 127.0.0.1; accept false; }
		}
		session {
			asn { local 1; remote 1; }
			router-id 1.2.3.4;
			family { ipv4/unicast { prefix { maximum 10000; } } }
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-test irr --port $PORT2
cmd=background:seq=2:exec=sh trigger.sh
cmd=foreground:seq=3:exec=ze --plugin ze.firewall-irr -:stdin=ze-fw:timeout=30s
expect=exit:code=0
expect=stderr:pattern=both table terms and their IPv6 twins are in the kernel ruleset
reject=stderr:pattern=references unknown set
