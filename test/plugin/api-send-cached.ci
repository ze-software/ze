# Test: `send bgp <selector> cached <id>` puts a cached UPDATE on a peer's wire
# VALIDATES: the ze-bgp:cache-forward wire method dispatches through the engine
#            at the path it answers at since 2026-09-05. The fixture asks for an
#            id the cache does not hold, so what is proven is that the command
#            REACHES the handler and the handler answers about the cache, not
#            about an unknown command.
# PREVENTS: the cached form broken or not wired. It is the one send form whose
#           old spelling sat under `request` rather than under `peer`, so it is
#           the one a peer-shaped sweep of the old paths would miss.

# ze-peer expectations
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# Native test plugin: exercises dispatch-command for send bgp cached

# ze bgp configuration
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external send-cached-test {
		run "ze-test fixture plugin/api-send-cached"
		encoder json
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}

		attach process send-cached-test {
			send [ update ]
		}
	}
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
