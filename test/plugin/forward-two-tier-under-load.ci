expect=bgp:conn=1:seq=1:ordered=180A004F
# // the removed End-of-RIB rule was unsatisfiable by construction, so
# it asserted nothing and only produced a red the runner used to mask. This peer's
# EOR is emitted by its OWN initial sync the moment it establishes
# (peer_initial_sync.go), which is BEFORE any route is forwarded to it from
# another peer. That early EOR does not match the route rule(s) above, and
# checker.go silently swallows an unmatched EOR instead of re-offering it, so the
# trailing EOR slot could never be filled. RFC 4724 orders the EOR only against
# this speaker's own initial dump, never against routes learned afterwards, so
# there is no ordering here for a test to assert. The forwarded-route rule(s)
# above are this test's actual subject and are unchanged.
EOF_DEST

# compiled Go test plugin: smoke-checks metric registration while the dest peer proves
# every UPDATE was delivered.

# ze configuration: source -> ze (RS) -> dest
# ze.fwd.chan.size=2 forces tiny channel, guaranteeing overflow with 80 routes
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	internal adj-rib-in {
		use bgp-adj-rib-in
	}
	internal rs {
		use bgp-rs
	}
    external two-tier-load-test {
        run "ze-test fixture plugin/forward-two-tier-under-load"
        encoder json
    }
}

telemetry {
    prometheus {
        enabled true
        server main {
            ip 127.0.0.1;
            port $PORT2;
        }
    }
}

bgp {
    peer source-peer {
        connection {
            remote {
                ip 127.0.0.1
            }
            local {
                ip 127.0.0.1
                accept false
            }
        }
        session {
            asn {
                local 65000
                remote 65001
            }
            router-id 1.2.3.4
            family {
                ipv4/unicast { prefix { maximum 10000; } }
            }
            capability {
                graceful-restart disable
            }
        }
        behavior {
            group-updates disable
        }
    	attach process rs {
    		receive [ update-received state open-received refresh ]
    		send [ update ]
    	}
    	attach process adj-rib-in {
    		receive [ update-received state ]
    		send [ update ]
    	}
    }

    peer dest-peer {
        connection {
            remote {
                ip 127.0.0.2
            }
            local {
                ip 127.0.0.2
                accept false
            }
        }
        session {
            asn {
                local 65000
                remote 65002
            }
            router-id 1.2.3.4
            family {
                ipv4/unicast { prefix { maximum 10000; } }
            }
            capability {
                graceful-restart disable
            }
        }
    	attach process rs {
    		receive [ update-received state open-received refresh ]
    		send [ update ]
    	}
    	attach process adj-rib-in {
    		receive [ update-received state ]
    		send [ update ]
    	}
    }
}
EOF_CONF

# Force small channel size so overflow is guaranteed with 80 routes
option=env:var=ZE_FWD_CHAN_SIZE:value=2

# Process orchestration
cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=source
cmd=background:seq=2:exec=ze-peer --bind 127.0.0.2 --port $PORT:stdin=dest
cmd=foreground:seq=3:exec=ze -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
reject=stderr:pattern=panic recovered
reject=stderr:pattern=fatal error
reject=stderr:pattern=treat-as-withdraw
reject=stderr:pattern=ZE-OBSERVER-FAIL
