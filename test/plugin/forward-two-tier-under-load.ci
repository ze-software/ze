# Test: two-tier dispatch delivers all routes under load with overflow
# VALIDATES: AC-10/AC-11/AC-12 -- burst exceeding channel capacity triggers
#   overflow dispatch, all routes delivered without loss and in order
# PREVENTS: routes dropped during overflow, two-tier dispatch path untested
#   end-to-end through real reactor
#
# Flow:
# 1. ze.fwd.chan.size=2 forces a tiny per-worker channel (overflow guaranteed)
# 2. Source peer sends 80 UPDATEs in a burst
# 3. Destination peer asserts all 80 NLRIs arrive in order (ordered= needles:
#    the forward rail may legally pack several same-attr NLRIs into one
#    UPDATE via fwdBucketMerge, so per-message framing is not asserted)
# 4. compiled Go observer smoke-checks metric registration while the tiny channel
#    and full destination delivery prove the overflow path was taken

# Source peer (ASN 65001) -- sends 80 prefixes in a burst
option=env:var=ze.log.bgp.reactor.session:value=debug
stdin=source:terminator=EOF_SOURCE
option=tcp_connections:value=1
option=timeout:value=20s
# linger: hold the source session open after its script completes. Closing it
# makes ze correctly withdraw the source's routes toward dest, racing the very
# forwarding burst this test asserts.
option=linger:value=true

# 80 UPDATEs: 10.0.{0..79}.0/24
# ORIGIN=IGP, AS_PATH=[65001], NEXT_HOP=1.1.1.1, LOCAL_PREF=100
