# Dest peer (ASN 65002) -- verify every forwarded route arrives, in order
stdin=dest:terminator=EOF_DEST
option=tcp_connections:value=1
option=timeout:value=20s
# // reframed seq=N:contains= (one NLRI per message) to seq=1:ordered=
# (same 80 needles, strict in-order consumption across message boundaries).
# The old framing asserted a property ze does not owe: the forward rail packs
# same-attr NLRIs into one UPDATE (fwdBucketMerge), which is legal BGP UPDATE
# packing. ordered= still fails on any lost or out-of-order NLRI, so the
# coverage this test claims (delivery without loss, in order) is unchanged.
expect=bgp:conn=1:seq=1:ordered=180A0000
expect=bgp:conn=1:seq=1:ordered=180A0001
expect=bgp:conn=1:seq=1:ordered=180A0002
expect=bgp:conn=1:seq=1:ordered=180A0003
expect=bgp:conn=1:seq=1:ordered=180A0004
