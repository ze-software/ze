# Migrated from test/data/plugin/mup6.*

# ze-peer expectations
stdin=peer:terminator=EOF_PEER
# Test IPv6 unicast functionality
cmd=api:conn=1:seq=1:text=peer * update text origin igp local-preference 200 nhop 2001::11 nlri ipv6/unicast add fc00:1::/64
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0046020000002F40010100400200400504000000C8800E1E00020110200100000000000000000000000000110040FC00000100000000
expect=json:conn=1:seq=1:json={"meta":{"version":"1.0.0","format":"ze-bgp"},"message":{"type":"update"},"peer":{"address":"127.0.0.1","remote":{"as":65533}},"direction":"in","local-preference":200,"origin":"igp","ipv6/unicast":[{"action":"add","nlri":["fc00:1::/64"],"next-hop":"2001::11"}]}
# // the End-of-RIB rule that used to sit here asserted an ordering
# the product does not define. Nothing in this test sends an EOR -- the marker is
# peer1's OWN initial-sync one (sendInitialRoutes), and whether it lands before or
# after the announce depends on which side of the drain the plugin's send arrived
# on. The observer now takes the product's eor-sent barrier BEFORE announcing, so
# the marker always precedes the announce and checker.go silently accepts it (it
# matches no expectation at that point). The frame is still proven to reach the
# wire: eor-sent counts only markers IncrEORSent recorded after the socket flush,
# and the barrier fails the test if it never arrives.
cmd=api:conn=1:seq=2:text=peer * update text nlri ipv6/unicast del fc00:1::/64
expect=bgp:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0026020000000F800F0C00020140FC00000100000000
expect=json:conn=1:seq=2:json={"meta":{"version":"1.0.0","format":"ze-bgp"},"message":{"type":"update"},"peer":{"address":"127.0.0.1","remote":{"as":65533}},"direction":"in","ipv6/unicast":[{"action":"del","nlri":["fc00:1::/64"]}]}
# Note: MUP-specific tests commented out pending update text MUP support
# 4:cmd:announce eor ipv6/mup
# 4:cmd:announce ipv6/mup mup-isd 2001::/64 rd 100:100 next-hop 2001::2 extended-community [target:10:10] bgp-prefix-sid-srv6 ( l3-service 2001:db8:1:1:: 0x47 [64,24,16,0,0,0] )
# 5:cmd:group attributes origin igp local-preference 100 extended-community [target:10:10] bgp-prefix-sid-srv6 ( l3-service 2001:db8:1:1:: 0x47 [64,24,16,0,0,0] ) ; withdraw ipv6/mup mup-isd 2001::/64 rd 100:100 next-hop 0.0.0.0
EOF_PEER

# Python plugin script
tmpfs=mup6.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3

from ze_api import API, runtime_fail


def main() -> None:
    api = API()
    # The full 5-stage handshake, as the module-level ready() helper does it.
    # api.ready() alone is stage 5 only, and the engine rejects it with
    # "expected declare-registration, got ze-plugin-engine:ready".
    api.declare_done()
    api.wait_for_config(timeout=10.0)
    api.capability_done()
    api.wait_for_registry(timeout=10.0)
    api.ready()

    # Put this script's sends on ONE side of the peer's initial route sync.
    #
    # A route announced while the sync is still draining joins the initial dump
    # and is written BEFORE the End-of-RIB marker; the same route announced after
    # the drain goes out on its own, with the marker already spent (RFC 4724
    # Section 2 allows one per family per session). Both are correct BGP, and
    # which one happens is decided purely by how promptly the host scheduled the
    # daemon -- so the ordered wire expectations below could only ever match one
    # of them, and under load matched the other: the withdraw landed where the
    # End-of-RIB was expected.
    #
    # wait_peer_eor_sent is the product's own barrier for exactly this window (it
    # reads the eor-sent counter that IncrEORSent bumps only after the marker has
    # been flushed to the socket). Behind it, every send here is post-dump, so the
    # peer sees marker, announce, withdraw, every run.
    if not api.wait_peer_eor_sent():
        runtime_fail('peer1 never sent its initial-sync End-of-RIB')

    # Test unicast functionality using update text syntax
    announce_unicast = 'peer * update text origin igp local-preference 200 nhop 2001::11 nlri ipv6/unicast add fc00:1::/64'
    withdraw_unicast = 'peer * update text nlri ipv6/unicast del fc00:1::/64'

    # Note: MUP commands commented out pending update text MUP support
    # announce_mup = 'announce ipv6/mup mup-isd 2001::/64 rd 100:100 next-hop 2001::2 extended-community [ target:10:10 ] bgp-prefix-sid-srv6 ( l3-service 2001:db8:1:1:: 0x47 [64,24,16,0,0,0] )'
    # withdraw_mup = 'withdraw ipv6/mup mup-isd 2001::/64 rd 100:100 next-hop 2001::2 extended-community [ target:10:10 ] bgp-prefix-sid-srv6 ( l3-service 2001:db8:1:1:: 0x47 [64,24,16,0,0,0] )'

    messages = [
        announce_unicast,
        withdraw_unicast,
    ]

    for message in messages:
        api.send(message)
        api.quiesce()

    api.wait_for_ack(expected_count=2)
    api.wait_for_shutdown()


if __name__ == '__main__':
    main()
EOF_RUN

# ze bgp configuration
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external announce-routes {
		run ./mup6.run
		encoder json
	}
}
bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65000
			}
			router-id 10.0.0.1
			family {
				# ipv6/mup; # MUP not supported by update text yet
				ipv6/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart
			}
		}
		behavior {
			group-updates disable
		}
	
		attach process announce-routes {
			send [ update ]
		}
	}
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=10s
