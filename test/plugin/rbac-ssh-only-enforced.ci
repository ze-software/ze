# Test: RBAC command authorization is enforced on an ssh-only daemon (no bgp{})
#
# Flow:
# 1. Config has environment.ssh + system.authorization profiles + a noc user,
#    and deliberately NO bgp{} block (the gokrazy appliance / ssh-only shape).
# 2. `ze cli --user noc -c "show version"` succeeds (read-only run: default allow).
# 3. `ze cli --user noc -c "clear interface counters"` is refused: the read-only
#    profile denies the "clear" prefix.
#
# VALIDATES: AC -- system.authorization profiles apply to a daemon started without a
#            bgp{} block. Authorization is wired from main.go's standalone ssh path,
#            not only from the bgp infra hook's reactor post-start callback.
# VALIDATES: AC -- a refused command reports "command restricted by access control",
#            distinct from "unknown command".
# VALIDATES: AC -- the refusal carries exactly one "error: " prefix.
# PREVENTS: Regression to the fail-open bug where an ssh-only daemon accepted
#           system.authorization config, logged the user's profiles at login, and
#           then enforced none of it: the dispatcher's authorizer stayed nil so
#           Dispatcher.isAuthorized allowed every command. `configure` masked this
#           because it is interactive-CLI-only and returned "unknown command" for
#           every user, denied or not.
# PREVENTS: Regression of the doubled prefix ("error: error: ...") produced when the
#           ssh exec handler's "error: " text became the client's error value and the
#           client prefixed it again.

tmpfs=rbac-ssh-only.conf:terminator=EOF_CONF
environment {
	ssh {
		enabled enable
		server main { ip 127.0.0.1; port $PORT2; }
	}
}

system {
	authorization {
		profile read-only {
			run {
				default-action allow
				entry 10 { action deny; match debug; }
				entry 20 { action deny; match clear; }
			}
			edit { default-action deny; }
		}
	}
	authentication {
		user noc {
			# bcrypt hash of noc-secret.
			password "$2a$10$EHVw7e4FvIc2NlB.sTHrGuRGv8PHte7aHyGQkiuvHWdC6NxQx/TIO"
			profile read-only
		}
	}
}
EOF_CONF

cmd=foreground:seq=1:exec=ze start rbac-ssh-only.conf:timeout=30s
cmd=foreground:seq=2:exec=ze-test fixture plugin/rbac-ssh-only-enforced $PORT2:timeout=30s
expect=exit:code=0
# The read-only profile still allows operational reads.
expect=stderr:pattern=OK: 'show version' allowed
# The denied command was refused with the access-control wording.
expect=stderr:pattern=OK: refusal names access control
# The refusal carried one "error: " prefix, not two.
expect=stderr:pattern=OK: single error prefix
# A genuinely unknown command still reports "unknown command".
expect=stderr:pattern=OK: nonexistent command reports unknown command
