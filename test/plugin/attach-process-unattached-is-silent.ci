# Test: a running program that no peer attaches is fed nothing, while the peer
#       that does attach one is served.
# Exercises: peer config -> DeliveryGraph -> Server.PeerScopedProcs -> the
#            peer-scoped delivery sites in internal/component/bgp/server/events.go.
# VALIDATES: AC-2, both halves in one run. The two programs declare the SAME
#            subscription, so what separates them is the config alone.
# PREVENTS: the fail-open reading of an empty edge set. A peer that names no
#           process must feed nobody, and an index that cannot find an edge must
#           never answer "everything" (ai/rules/evidence.md).

# ze-peer: one session, then one UPDATE, so both an update and a state event
# exist for the unattached program to be wrongly handed.
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=20s
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0036020000001B4001010040020602010000FDE94003040101010140050400000064180A0000
EOF_PEER

# The program the peer attaches. It drives the run.

# The program NO peer attaches. It declares the same subscription and must be
# fed nothing at all.

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external unattached-served {
		run "ze-test fixture plugin/attach-process-unattached-served"
		encoder json
	}
	external unattached-silent {
		run "ze-test fixture plugin/attach-process-unattached-silent"
		encoder json
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		attach process unattached-served {
			receive [ update state ]
		}
	}
}
EOF_CONF

expect=stderr:pattern=UNATTACHED-SERVED: fed by the peer that attaches it
expect=stderr:pattern=UNATTACHED-SILENT: fed nothing, as no peer attaches it
# The daemon SAYS it, and this is the assertion for the one disagreement that
# names no peer. The per-edge report walks the index's edges, so the process no
# peer attaches HAS no edge and was reported nowhere, which is the case where
# nothing is delivered at all (reconcileDelivery, delivery_reconcile.go). The
# pattern pins the process name: every other unattached program in this daemon
# gets its own line, and the one under test must be among them.
expect=stderr:pattern=no peer attaches it.*process=unattached-silent

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=25s
expect=exit:code=0
