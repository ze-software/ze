# Test: bgp-redistribute -- non-zero NextHop on the entry is passed through to the
# UPDATE as-is (no peer LocalAddress substitution).
# VALIDATES: AC-11 -- producer-supplied NextHop != 0 reaches the wire as `nhop <addr>`.
# PREVENTS: Reactor accidentally substituting peer LocalAddress when explicit NH is supplied.

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
# Wire expectation (this is what makes ze-peer bind and check): ORIGIN incomplete,
# empty AS_PATH (iBGP), NEXT_HOP 192.0.2.1 passed through verbatim, LOCAL_PREF 100,
# NLRI 10.0.0.1/32. LOCAL_PREF is well-known mandatory on an iBGP session
# (RFC 4271 5.1.5), emitted by reactor_api_batch.go buildWireModeUpdate.
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0031020000001540010102400200400304C000020140050400000064200A000001
expect=json:conn=1:seq=1:json={"meta":{"version":"1.0.0","format":"ze-bgp"},"message":{"type":"update"},"peer":{"address":"127.0.0.1","remote":{"as":65533}},"direction":"in","origin":"incomplete","local-preference":100,"ipv4/unicast":[{"action":"add","nlri":["10.0.0.1/32"],"next-hop":"192.0.2.1"}]}
EOF_PEER

tmpfs=nhop-test.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
import time
from ze_api import API, runtime_fail


def dispatch(api, command):
    return api._call_engine('ze-plugin-engine:dispatch-command', {'command': command}) or {}


def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()

    # Wait on the peer's own state, then on its initial-sync EOR reaching the
    # wire, instead of holding a fixed 2s and hoping establishment fitted in it.
    if not api.wait_peer_eor_sent():
        runtime_fail('initial-sync EOR never reached the wire')
        return

    resp = dispatch(api, 'request fakeredist emit add ipv4/unicast 10.0.0.1/32 192.0.2.1')
    result = resp.get('result', {})
    if result.get('status') != 'done':
        runtime_fail(f'request fakeredist emit failed: {result}')
        return

    # There IS a queryable signal: `request quiesce` returns once the BGP
    # forward pool and every peer's initial-sync opQueue have settled, which is
    # exactly "the emitted route finished dispatching".
    if not api.quiesce():
        runtime_fail('quiesce barrier did not complete')
        return
    dispatch(api, 'request shutdown')
    api.wait_for_shutdown()


if __name__ == '__main__':
    main()
EOF_RUN

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external nhop-test {
		run ./nhop-test.run
		encoder json
	}
	internal redistribute-orchestrator {
		use redistribute-orchestrator
	}
	internal fakeredist {
		use fakeredist
	}
}

redistribute {
	destination bgp {
		import fakeredist {
			family [ ipv4/unicast ];
		}
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65533
				remote 65533
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		attach process redistribute-orchestrator {
			send [ update ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
# // test-relax: expect=exit:code=0 removed -- this STRENGTHENS the test. Coverage
# is replaced by the ze-peer wire expectation above, which now governs the verdict.
# The exit-code line asserted nothing about BGP and, until 2026-07-16, actively
# disabled the peer check and validateJSON (spec-fixit-redistribute-establishment-stall, D2).
