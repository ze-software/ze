# Test: bgp-redistribute -- non-zero NextHop on the entry is passed through to the
# UPDATE as-is (no peer LocalAddress substitution).
# VALIDATES: AC-11 -- producer-supplied NextHop != 0 reaches the wire as `nhop <addr>`.
# PREVENTS: Reactor accidentally substituting peer LocalAddress when explicit NH is supplied.

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
# Wire expectation (this is what makes ze-peer bind and check): ORIGIN incomplete,
# empty AS_PATH (iBGP), NEXT_HOP 192.0.2.1 passed through verbatim, LOCAL_PREF 100,
# NLRI 10.0.0.1/32. LOCAL_PREF is well-known mandatory on an iBGP session
# (RFC 4271 5.1.5), emitted by reactor_api_batch.go buildWireModeUpdate.
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0031020000001540010102400200400304C000020140050400000064200A000001
expect=json:conn=1:seq=1:json={"meta":{"version":"1.0.0","format":"ze-bgp"},"message":{"type":"update"},"peer":{"address":"127.0.0.1","remote":{"as":65533}},"direction":"in","origin":"incomplete","local-preference":100,"ipv4/unicast":[{"action":"add","nlri":["10.0.0.1/32"],"next-hop":"192.0.2.1"}]}
EOF_PEER


stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external nhop-test {
		run "ze-test fixture plugin/bgp-redistribute-explicit-nhop"
		encoder json
	}
	internal redistribute-orchestrator {
		use redistribute-orchestrator
	}
	internal fakeredist {
		use fakeredist
	}
}

redistribute {
	destination bgp {
		import fakeredist {
			family [ ipv4/unicast ];
		}
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65533
				remote 65533
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		attach process redistribute-orchestrator {
			send [ update ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
# // expect=exit:code=0 removed -- this STRENGTHENS the test. Coverage
# is replaced by the ze-peer wire expectation above, which now governs the verdict.
# The exit-code line asserted nothing about BGP and, until 2026-07-16, actively
# disabled the peer check and validateJSON (spec-fixit-redistribute-establishment-stall, D2).
