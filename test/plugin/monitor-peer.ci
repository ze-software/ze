# Test: bgp monitor peer 10.0.0.1 returns correct peer in response
# VALIDATES: monitor RPC handler parses peer filter and returns peer address
# PREVENTS: peer filtering silently ignored or returning wrong peer

# ze-peer expectations
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# Python test plugin: exercises dispatch-command for bgp monitor with peer filter
tmpfs=monitor-peer-test.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
import json
import sys
import time
from ze_api import API, dispatch, runtime_fail


def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()
    api.wait_for_post_startup(timeout=5.0)

    try:
        result = dispatch(api, 'monitor bgp peer 10.0.0.1')
        if result.get('status') != 'done':
            runtime_fail(f'monitor bgp peer: status={result.get("status")} data={result.get("data")}')

        data = result.get('data', {})
        if isinstance(data, str):
            data = json.loads(data)
        peer = data.get('peer', '')
        if peer != '10.0.0.1':
            runtime_fail(f'monitor bgp peer: expected peer 10.0.0.1, got {peer!r}')

        print(f'OK: monitor peer={peer}', file=sys.stderr)
    finally:
        dispatch(api, 'request shutdown')
        api.wait_for_shutdown()

if __name__ == '__main__':
    main()
EOF_RUN

# ze bgp configuration
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external monitor-peer-test {
		run ./monitor-peer-test.run
		encoder json
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
