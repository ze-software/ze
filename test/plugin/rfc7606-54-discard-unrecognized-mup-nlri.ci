# rfc7606-54-discard-unrecognized-mup-nlri -- RFC 7606 Section 5.4 through the relay, for
# the family whose NLRI envelope is NOT the two-octet one EVPN and MCAST-VPN share.
#
# RFC requirement: RFC7606-5.4-1 positive -- a peer sends a BGP-MUP UPDATE mixing route types
# ze implements with one it does not; the unrecognized route is NOT relayed to the other
# client, and the implemented ones are.
#
# WHY A SECOND RELAY TEST.
#
# rfc7606-54-discard-unrecognized-nlri proves the relay path for EVPN. That path is
# family-generic, so this file is not re-proving it. What it proves is the per-family pair
# the generic path calls into: SplitMUP (nlrisplit/mup.go) carves on a length octet at
# offset 3 inside a 4-octet header, and mup.RecognizeNLRI (plugins/nlri/mup/rfc7606.go)
# reads a 2-octet route type after a 1-octet architecture type. A splitter or recognizer
# written on EVPN's offsets would misread every BGP-MUP boundary here, and would do it in a
# real daemon rather than against a stand-in ruling.
#
# The two halves confine each other, as in the EVPN file. The `contains` proves the two
# implemented NLRIs arrive ADJACENT, which they can only be if the one between them was
# removed. The `reject` proves the removed one reached the peer in no form at all.

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=2
option=timeout:value=20s
option=bind:value=0.0.0.0
# Bind conn=N by remote IP: which client connects first is a race (peer_connmap.go).
option=conn_map:value=remote-ip

# Source peer (conn=1, AS 65001) announces three BGP-MUP routes in one MP_REACH_NLRI:
#   ORIGIN:   40010100                 IGP
#   AS_PATH:  40020602010000FDE9       AS_SEQUENCE[65001], 4-byte ASNs
#   MP_REACH: 800E20 000155 04 01010101 00   AFI 1 / SAFI 85, next-hop 1.1.1.1
# draft-ietf-bess-mup-safi Section 3.1 frames each NLRI as
# [architecture-type:1][route-type:2][length:1][value], so the length octet is the FOURTH:
#     NLRI 1: 01 0001 04 DEADBEEF       arch 1, route type 1 (ISD)  -- IMPLEMENTED
#     NLRI 2: 01 0005 04 CAFEBABE       arch 1, route type 5        -- no such route type
#     NLRI 3: 01 0004 03 112233         arch 1, route type 4 (T2ST) -- IMPLEMENTED
# The unrecognized route sits BETWEEN two implemented ones on purpose: a fix that gave up on
# the first unfamiliar type would take the third with it, and the assertion below would fail.
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF004702000000304001010040020602010000FDE9800E2000015504010101010001000104DEADBEEF01000504CAFEBABE01000403112233

# An ordinary IPv4 route, sent after the MUP one, is the processing fence. ze reads this
# connection in TCP order on one goroutine, so the observer seeing 10.0.0.0/24 forwarded
# proves the MUP UPDATE above was already handled. That is what makes the reject below an
# assertion rather than a race with shutdown.
action=send:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002F02000000144001010040020602010000FDE940030401010101180A0000

# Receiver (conn=2, AS 65002, rs-client so RFC 7947 leaves AS_PATH alone): the two
# implemented BGP-MUP NLRIs arrive back to back.
expect=bgp:conn=2:seq=1:contains=01000104DEADBEEF01000403112233

# And the unrecognized one never arrives, in any framing.
reject=bgp:conn=2:pattern=01000504CAFEBABE
EOF_PEER

# Observer: wait until the route server has replayed the fence prefix to every client, then
# shut down.
tmpfs=shutdown-after-up.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
from ze_api import API

API().run_rs_observer(expected_peers=2, forward_prefix="10.0.0.0/24")
EOF_RUN

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	internal rs {
		use bgp-rs
	}
	external shutdown-after-up {
		run ./shutdown-after-up.run
		encoder json
	}
}
bgp {
	peer source-peer {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
				ipv4/mup { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
		attach process shutdown-after-up {
			receive [ update ]
		}
	}
	peer receiver-peer {
		connection {
			remote {
				ip 127.0.0.2
			}
			local {
				ip 127.0.0.2
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65002
			}
			router-id 1.2.3.4
			rs-client true
			family {
				ipv4/unicast { prefix { maximum 10000; } }
				ipv4/mup { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
		attach process shutdown-after-up {
			receive [ update ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
reject=stderr:pattern=panic
reject=stderr:pattern=fatal error
