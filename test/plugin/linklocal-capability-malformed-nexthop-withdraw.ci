# linklocal-capability-malformed-nexthop-withdraw -- draft-ietf-idr-linklocal-capability
# Section 6, treat-as-withdraw, end to end through the route server.
#
# Both sessions negotiate the Link-Local Next Hop capability (77): Ze advertises it
# from `capability link-local-nexthop enable`, and ze-peer mirrors Ze's OPEN. The
# source peer announces 2001:db8:5701::/48 with a well-formed 32-octet Next Hop
# (Global 2001:db8:9::9, then Link-Local fe80::9), then re-announces it with the
# halves swapped (Link-Local first). Section 6: "If the Next Hop field is malformed,
# the implementation MUST handle the malformed UPDATE message using the approach of
# "treat-as- withdraw", as described in section 7.3 of [RFC7606]." So the receiving
# peer, which already holds the route, sees it withdrawn, then a fence route sent
# after it, and never the swapped Next Hop. No session is reset.
#
# VALIDATES: draft-ietf-idr-linklocal-capability Section 6 (DRAFT-IETF-IDR-LINKLOCAL-
# CAPABILITY-6-1) through the real receive path. The tagged proofs of both polarities
# are the unit tests TestLinkLocalCapabilityMalformedThirtyTwoOctet and
# TestLinkLocalCapabilityWellFormedThirtyTwoOctet (internal/component/bgp/message/
# draft_ietf_idr_linklocal_capability_malformed_test.go); this test shows the verdict reaches the wire: the
# Global then Link-Local pair is relayed, the swapped pair withdraws the route.
#
# FRR (bgp_attr.c) and BIRD (packets.c) instead drop the Link-Local half of a
# malformed pair and keep the route. Ze follows the draft's MUST, not them
# (plan/immediate/spec-bgp-unowned-rfc-rows.md, review N4).

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=2
option=timeout:value=20s
option=bind:value=0.0.0.0
option=linger:value=true
# Bind conn=N by remote IP: which client connects first is a race (peer_connmap.go).
option=conn_map:value=remote-ip

# Source peer (conn=1, AS 65001). Every UPDATE carries ORIGIN IGP, AS_PATH [65001]
# (4-byte ASNs) and one MP_REACH_NLRI for IPv6 unicast with a 32-octet Next Hop:
#   800E2C 0002 01 20 <first 16> <second 16> 00 30 <prefix>
#   Global 2001:db8:9::9  = 20010DB8000900000000000000000009
#   Link-Local fe80::9    = FE800000000000000000000000000009
# seq=1: 2001:db8:5701::/48, Global then Link-Local (well formed).
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0053020000003C4001010040020602010000FDE9800E2C0002012020010DB8000900000000000000000009FE800000000000000000000000000009003020010DB85701

# seq=2: the same prefix, Link-Local then Global (malformed). This is the subject.
action=send:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0053020000003C4001010040020602010000FDE9800E2C00020120FE80000000000000000000000000000920010DB8000900000000000000000009003020010DB85701

# seq=3: the fence, 2001:db8:5702::/48, Global then Link-Local, on the same connection.
action=send:conn=1:seq=3:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0053020000003C4001010040020602010000FDE9800E2C0002012020010DB8000900000000000000000009FE800000000000000000000000000009003020010DB85702

# Receiver (conn=2, AS 65002, rs-client). An MP_REACH_NLRI announcement puts the
# Reserved octet 00 directly before the NLRI; an MP_UNREACH_NLRI puts the SAFI there.
# 2001:db8:5701::/48 announced first.
expect=bgp:conn=2:seq=1:contains=003020010DB85701
# Then withdrawn: MP_UNREACH_NLRI 0002 01 30 2001:db8:5701::/48.
expect=bgp:conn=2:seq=2:contains=0002013020010DB85701
# And the fence announced after it.
expect=bgp:conn=2:seq=3:contains=003020010DB85702

# The swapped Next Hop is never relayed.
reject=bgp:conn=2:pattern=FE80000000000000000000000000000920010DB8000900000000000000000009

EOF_PEER

# Observer: wait until the route server has relayed the fence prefix, then shut down.

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	internal rs {
		use bgp-rs
	}
	internal adj-rib-in {
		use bgp-adj-rib-in
	}
	external shutdown-after-up {
		run "le test fixture plugin/linklocal-capability-malformed-nexthop-withdraw"
		encoder json
	}
}
bgp {
	peer source-peer {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			# Capability 77 is refused without the address it promises to send.
			link-local fe80::1
			family {
				ipv6/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
				link-local-nexthop enable
			}
		}
		behavior {
			group-updates disable
		}
		attach process adj-rib-in {
			receive [ update-received state ]
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
		attach process shutdown-after-up {
			receive [ update ]
		}
	}
	peer receiver-peer {
		connection {
			remote {
				ip 127.0.0.2
			}
			local {
				ip 127.0.0.2
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65002
			}
			router-id 1.2.3.4
			rs-client true
			link-local fe80::1
			family {
				ipv6/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
				link-local-nexthop enable
			}
		}
		behavior {
			group-updates disable
		}
		attach process adj-rib-in {
			send [ update ]
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
		attach process shutdown-after-up {
			receive [ update ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze --plugin ze.bgp-llnh -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
reject=stderr:pattern=panic
reject=stderr:pattern=fatal error
