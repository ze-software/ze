# Test: audit log survives daemon restart and records reloads
# VALIDATES: AC-11 and AC-14 -- daemon reload is audited and persisted records are reloaded on daemon restart.
# PREVENTS: audit entries being visible only in the process that created them.

option=timeout:value=30s

tmpfs=test-audit-persistence.sh:mode=755:terminator=EOF_SH
#!/bin/sh
set -e

SSH_PORT=$((20000 + ($$ % 30000)))
ADMIN_DIR=$(mktemp -d)
DAEMON_PID=""

cleanup() {
	rm -rf "$ADMIN_DIR"
	if [ -n "$DAEMON_PID" ]; then
		kill "$DAEMON_PID" 2>/dev/null || true
		wait "$DAEMON_PID" 2>/dev/null || true
	fi
}
trap cleanup EXIT

cat > audit-persistence.conf << ZECONF
system {
	authentication {
		user admin {
			password "\$2a\$04\$UlwuiuH82Unfsq.XEMPGJeDkXwbm3KW.nvVaVXOd/JeFK8VjMjrQO"
		}
	}
}

environment {
	ssh {
		enabled true
		server main {
			ip 127.0.0.1;
			port $SSH_PORT;
		}
	}
}
ZECONF

printf 'admin\ntestpass\n127.0.0.1\n%s\n' "$SSH_PORT" | ZE_CONFIG_DIR="$ADMIN_DIR" ze init >/dev/null

start_daemon() {
	LOG=$1
	ze start audit-persistence.conf 2>"$LOG" &
	DAEMON_PID=$!
	for i in $(seq 1 50); do
		if ZE_CONFIG_DIR="$ADMIN_DIR" ZE_SSH_PASSWORD="testpass" ze cli -c "show version" >/dev/null 2>&1; then
			return 0
		fi
		sleep 0.2
	done
	echo "FAIL: SSH server did not start" >&2
	cat "$LOG" >&2
	exit 1
}

stop_daemon() {
	kill $DAEMON_PID 2>/dev/null || true
	wait $DAEMON_PID 2>/dev/null || true
	DAEMON_PID=""
}

start_daemon daemon1.log
if ZE_CONFIG_DIR="$ADMIN_DIR" ZE_SSH_PASSWORD="wrongpass" ze cli -c "show bgp summary" >/dev/null 2>&1; then
	echo "FAIL: wrong SSH password succeeded" >&2
	exit 1
fi
echo "OK: wrong SSH password denied" >&2

if ! grep -q 'auth-fail' audit-persistence.audit.jsonl; then
	echo "FAIL: audit file missing auth-fail before restart" >&2
	cat audit-persistence.audit.jsonl >&2 2>/dev/null || true
	exit 1
fi
stop_daemon

start_daemon daemon2.log
OUTPUT=$(ZE_CONFIG_DIR="$ADMIN_DIR" ZE_SSH_PASSWORD="testpass" ze cli -c "show audit action auth-fail" 2>&1) || {
	echo "FAIL: show audit failed after restart" >&2
	echo "$OUTPUT" >&2
	exit 1
}

case "$OUTPUT" in
	*auth-fail*admin*|*admin*auth-fail*) echo "OK: restarted daemon loaded persisted auth-fail" >&2 ;;
	*)
		echo "FAIL: restarted daemon did not load auth-fail" >&2
		echo "$OUTPUT" >&2
		exit 1
		;;
esac

RELOAD_OUTPUT=$(ZE_CONFIG_DIR="$ADMIN_DIR" ZE_SSH_PASSWORD="testpass" ze cli -c "request reload" 2>&1) || {
	echo "FAIL: request reload failed" >&2
	echo "$RELOAD_OUTPUT" >&2
	exit 1
}

RELOAD_AUDIT=$(ZE_CONFIG_DIR="$ADMIN_DIR" ZE_SSH_PASSWORD="testpass" ze cli -c "show audit action daemon-reload" 2>&1) || {
	echo "FAIL: show audit daemon-reload failed" >&2
	echo "$RELOAD_AUDIT" >&2
	exit 1
}
case "$RELOAD_AUDIT" in
	*daemon-reload*admin*|*admin*daemon-reload*) echo "OK: show audit includes daemon reload" >&2 ;;
	*)
		echo "FAIL: show audit missing daemon-reload/admin" >&2
		echo "$RELOAD_AUDIT" >&2
		exit 1
		;;
esac

stop_daemon
exit 0
EOF_SH

cmd=foreground:seq=1:exec=./test-audit-persistence.sh:timeout=30s
expect=exit:code=0
