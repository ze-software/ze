# FlowSpec-to-firewall bridge: verify FlowSpec add+withdraw via process plugin
# A compiled process plugin sends a FlowSpec add then withdraw, and both wire
# messages must reach the peer with the bridge plugin loaded.
#
# The observer is the ONLY producer of the asserted bytes. A static
# `update { nlri { ipv4/flow add destination-ipv4 10.1.0.0/24 } }` block used to
# stand in this config and produce the announce in the observer's place. That was
# a crutch: the observer's command carried no add/del verb, so the grammar
# rejected it (route/route.go ErrMissingAddDel) and the observer produced
# nothing, while the static route satisfied the wire assertion. The failure was
# invisible on darwin and red on linux, decided only by whether the observer's
# ZE-OBSERVER-FAIL sentinel reached the runner before ze stopped. The same crutch
# was removed from test/plugin/flowspec-announce.ci for the same reason.
#
# VALIDATES: FlowSpec add and withdraw wire encoding correct with bridge plugin
# VALIDATES: a FlowSpec withdrawal sent through the external process API reaches
#            the wire as MP_UNREACH_NLRI
# PREVENTS: an observer command the grammar rejects passing unnoticed, because a
#           static config route produced the asserted bytes in its place

stdin=peer:terminator=EOF_PEER
# Route announced by the plugin script
cmd=api:conn=1:seq=1:text=peer * update text extended-community [copy-to-nexthop] nhop 1.2.3.4 nlri ipv4/flow add destination-ipv4 10.1.0.0/24
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0042020000002B4001010040020040050400000064800E0F0001850401020304000501180A0100C010080800000000000001
# Same route withdrawn by the plugin script
cmd=api:conn=1:seq=2:text=peer * update text nlri ipv4/flow del destination-ipv4 10.1.0.0/24
expect=bgp:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0023020000000C800F090001850501180A0100
EOF_PEER


stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external flowspec-fw-process {
		run "ze-test fixture plugin/flowspec-fw-withdraw"
		encoder json
	}
}
bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/flow { prefix { maximum 10000; } }
			}
		}
		behavior {
			group-updates disable
		}
		# the static `update { nlri { ipv4/flow add ... } }` block that
		# stood here is DELETED, and coverage goes up rather than down. It produced
		# the announce in the observer's place, so the observer's own rejected
		# command changed no asserted byte and the test passed while proving
		# nothing about the external process API. The observer is now the only
		# producer, and the withdraw this file is named for is asserted for the
		# first time.
		attach process flowspec-fw-process {
			send [ update ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=10s
