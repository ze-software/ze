# Test: data-authz-read-only
# VALIDATES: AC-14 -- a user whose profile is the read-only one is refused `delete data key`, `update data key`, `update data config` and `request data repair` over SSH exec with the access-control refusal (plugin.UnauthorizedMessage), and nothing they name changes: the seeded key keeps its bytes, the other config has no active version, no salvage folder exists; the same user is allowed `show data check`, answered by the daemon on its own tree; an admin is allowed all five, each proven by its effect.
# PREVENTS: a store write reachable by the read-only profile, a denial that comes from the handler rather than from authorization, or a read-only profile that cannot check the store.
# QUESTION: does the dispatcher's authorizer judge the four new commands by their verb before any handler runs, on the real SSH route with a configured read-only profile? A unit test of IsReadOnlyPath sees neither the login-resolved profile nor the dispatcher order.
# The read-only profile is defined here: production never installs authz.builtinReadOnlyProfile. The block is test/plugin/rbac-ssh-only-enforced.ci's.

option=storage:value=disk
option=timeout:value=90s

tmpfs=stale.txt:terminator=EOF_STALE
stale runtime state
EOF_STALE

tmpfs=data-authz-read-only.conf:terminator=EOF_CONF
system {
    authorization {
        profile admin { run { default-action allow; } edit { default-action allow; } }
        profile read-only {
            run {
                default-action allow
                entry 10 { action deny; match debug; }
                entry 20 { action deny; match clear; }
            }
            edit { default-action deny; }
        }
    }
    authentication {
        user admin {
            password "$2a$04$UlwuiuH82Unfsq.XEMPGJeDkXwbm3KW.nvVaVXOd/JeFK8VjMjrQO"
            profile admin
        }
        user noc {
            # bcrypt hash of noc-secret.
            password "$2a$10$EHVw7e4FvIc2NlB.sTHrGuRGv8PHte7aHyGQkiuvHWdC6NxQx/TIO"
            profile read-only
        }
    }
}

environment {
    ssh {
        enabled true
        server main {
            ip 127.0.0.1;
            port $PORT2;
        }
    }
}

bgp {
    router-id 1.2.3.4
    session {
        asn {
            local 65000
        }
    }
}
EOF_CONF

# The first start creates the store; the key is seeded while ze is stopped,
# the only time the offline writer may open it.
cmd=background:seq=1:exec=ze start data-authz-read-only.conf:name=first:ready=Ze running.
cmd=stop:seq=2:name=first:signal=term
cmd=foreground:seq=3:exec=ze data write meta/test/stale-state stale.txt:exit=0
cmd=background:seq=4:exec=ze start data-authz-read-only.conf:name=daemon:ready=Ze running.
cmd=foreground:seq=5:exec=le test fixture storage/data-authz-read-only $PORT2:exit=0
expect=stdout:contains=OK: data-authz-read-only
cmd=stop:seq=6:name=daemon:signal=term
