# Test: SSH public key authentication via wish server.
#
# VALIDATES: AC-2 -- SSH client with matching key authenticates successfully.
# VALIDATES: AC-3 -- SSH client with non-matching key is rejected.
# VALIDATES: AC-9 -- Auth success log includes username, source=public-key, profiles.
# PREVENTS: regression where public key handler is not wired into wish.
#
# Flow:
# 1. Compiled setup generates an ed25519 key pair and writes the daemon config.
# 2. Daemon starts with YANG user "keyuser" whose public-keys block contains the generated key.
# 3. Compiled SSH client with matching key succeeds; a wrong key is rejected.
# 4. Daemon log shows "source=public-key" for the successful auth.

cmd=foreground:seq=1:exec=ze-test fixture plugin/ssh-pubkey-auth-setup $PORT2:timeout=15s
cmd=foreground:seq=2:exec=ze start ssh-pubkey.conf:timeout=15s
cmd=foreground:seq=3:exec=ze-test fixture plugin/ssh-pubkey-auth $PORT2:timeout=15s
expect=exit:code=0
expect=stderr:contains=OK: public key authentication succeeded
expect=stderr:contains=OK: wrong key rejected
expect=stderr:pattern=SSH auth success.*username=keyuser.*source=public-key
