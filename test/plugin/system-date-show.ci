# Test: `show system date` reports the daemon wall clock in three agreeing forms
# Exercises: dispatch-command -> ze-show:system-date -> handleShowSystemDate
#            (internal/component/cmd/show/system.go)
# VALIDATES: time / unix / unix-nano / timezone / utc-offset-secs are all produced,
#            agree with each other, and track the observer's own clock.
# PREVENTS:  a handler that answers `done` with a zero or constant timestamp --
#            a value the caller cannot tell from a real one (ai/rules/evidence.md).

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=30s
option=asn:value=65001
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER


stdin=ze-conf:terminator=EOF_CONF
plugin {
	external system-date-show-test {
		run "ze-test fixture plugin/system-date-show"
		encoder json
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-conf:timeout=30s
expect=exit:code=0
expect=stderr:contains=OK: show system date unix=
reject=stderr:pattern=panic
