# med-not-propagated-across-as -- a MULTI_EXIT_DISC learned from one neighboring
# AS does not reach another, with its two confining negatives in the same run.
#
# RFC requirement: RFC4271-5.1.4-1 positive -- "The MULTI_EXIT_DISC attribute received from a
# neighboring AS MUST NOT be propagated to other neighboring ASes" (Section 5.1.4). The plain
# eBGP receiver in AS 65003 gets the route with ORIGIN, AS_PATH and NEXT_HOP only: attribute 4
# is gone from the wire.
# RFC requirement: RFC4271-5.1.4-1 negative -- the strip is confined by PROVENANCE and by
# DESTINATION, never by destination alone. The RS-client receiver gets the source frame
# byte-identical, metric included.
# RFC requirement: RFC7947-x-3 positive -- "if applied to an NLRI UPDATE sent to a route server,
# this attribute SHOULD be propagated to other route server clients, and the route server SHOULD
# NOT modify its value" (RFC 7947 Section 2.2.3). That exemption is why the two receivers, both
# external, are told apart by rs-client alone.
# RFC requirement: RFC7947-x-3 negative -- that preservation is CONFINED to route server clients.
# The receiver that leaves rs-client at its default loses the metric, which is what makes the
# positive above non-vacuous: a daemon that never touched attribute 4 would pass the positive
# with the exemption deleted.
#
# WHY THIS FILE EXISTS. applyFactsMED (reactor/forward_med.go) is called from two rails, and
# this drives the PLUGIN rail (forwardUpdateCore, reactor_api_forward.go), which is also what
# every peer-up replay reaches through RelayStoredRoute. rs-fast-path is deliberately ABSENT
# from every peer here: setting it would move the UPDATE onto reactorForwardRS and give back the
# coverage this file exists to add, exactly as bgp-rs-relay-aspath-transparency.ci records for
# the AS_PATH gate.
#
# NO LOCAL_PREF in the source frame: the source is an eBGP peer and RFC 4271 Section 5.1.5
# forbids LOCAL_PREF towards external peers, so ze would overwrite it with an ATTR_DISCARD
# marker (message/rfc7606.go) and the byte-equality below would pin the marker rather than the
# metric.

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=3
option=timeout:value=20s
option=bind:value=0.0.0.0
# Bind conn=N by remote IP rather than accept order: which client connects first is a race,
# and the two receivers must be told apart by identity, not arrival (peer_connmap.go).
option=conn_map:value=remote-ip

# Source peer (conn=1, AS 65001): announce 10.0.0.0/24 carrying a metric.
#   ORIGIN:    40010100            IGP
#   AS_PATH:   40020602010000FDE9  AS_SEQUENCE[65001], 4-byte ASNs
#   NEXT_HOP:  40030401010101      1.1.1.1
#   MED:       80040400000064      100
#   NLRI:      180A0000            10.0.0.0/24
# attr len = 4+9+7+7 = 27 = 0x1B; total = 19+2+2+27+4 = 54 = 0x36.
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0036020000001B4001010040020602010000FDE94003040101010180040400000064180A0000

# The source's own EOR. Only conn=1's is asserted on the wire: RFC 4724 Section 4.1 constrains
# no ordering between a peer's EOR and routes it learns afterwards, so pinning a receiver's EOR
# turns a permitted ordering into a flake under load.
expect=bgp:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000

# Receiver A (conn=2, AS 65002, rs-client TRUE): byte-identical to what the source sent, so the
# metric 00000064 is still there under an 80 04 04 header.
expect=bgp:conn=2:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0036020000001B4001010040020602010000FDE94003040101010180040400000064180A0000

# Receiver B (conn=3, AS 65003, an ordinary eBGP neighbor): no attribute 4 at all, and the local
# AS prepended per RFC 4271 Section 5.1.2.
#   AS_PATH:   40020A02020000FDE80000FDE9   AS_SEQUENCE[65000, 65001]
# attr len = 4+13+7 = 24 = 0x18; total = 19+2+2+24+4 = 51 = 0x33.
expect=bgp:conn=3:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF003302000000184001010040020A02020000FDE80000FDE940030401010101180A0000
EOF_PEER

# Observer: wait until every client has been replayed to, then shut down.

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	internal rs {
		use bgp-rs
	}
	internal adj-rib-in {
		use bgp-adj-rib-in
	}
	external shutdown-after-up {
		run "ze-test fixture plugin/med-not-propagated-across-as"
		encoder json
	}
}
bgp {
	peer source-peer {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		attach process adj-rib-in {
			receive [ update-received state ]
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
		attach process shutdown-after-up {
			receive [ update ]
		}
	}
	peer rs-client-receiver {
		connection {
			remote {
				ip 127.0.0.2
			}
			local {
				ip 127.0.0.2
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65002
			}
			router-id 1.2.3.4
			# The ONLY leaf that selects the RFC 7947 exemption. It defaults to false
			# (plugins/rs/yang/ze-rs-conf.yang) and facts.rsClient is populated from it
			# alone (peer_forward_facts.go <- reactor/config.go). Remove it and this peer
			# becomes receiver B below.
			rs-client true
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		attach process adj-rib-in {
			send [ update ]
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
		attach process shutdown-after-up {
			receive [ update ]
		}
	}
	peer plain-ebgp-receiver {
		connection {
			remote {
				ip 127.0.0.3
			}
			local {
				ip 127.0.0.3
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65003
			}
			router-id 1.2.3.4
			# rs-client deliberately NOT set: this peer is another neighboring AS and must
			# never see AS 65001's metric.
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		attach process adj-rib-in {
			send [ update ]
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
		attach process shutdown-after-up {
			receive [ update ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
reject=stderr:pattern=panic
reject=stderr:pattern=fatal error
reject=stderr:pattern=forward-cached failed
reject=stderr:pattern=release-cached failed
