# Question: does a real daemon retain an external command's warning terminator
# after short and streamed rows, while healthy controls remain done?
# A unit cannot prove external declaration, authenticated startup and the two
# live SDK connections. This public SDK API declares the warning kind but no
# warning lines; separate wire tests cover preservation of supplied lines.

stdin=ze-bgp:terminator=EOF_CONF
bus {
	endpoint answer-outcome-provider {
		external {
			run "le test fixture plugin/command-outcome-provider";
		}
		encoding json;
	}
	endpoint answer-outcome-observer {
		external {
			run "le test fixture plugin/command-outcome-observer warning";
		}
		encoding json;
	}
}
EOF_CONF

cmd=foreground:seq=1:exec=ze -:stdin=ze-bgp:timeout=30s
expect=exit:code=0
expect=stderr:contains=OK: warning outcome and healthy control survived external daemon dispatch
reject=stderr:contains=ZE-OBSERVER-FAIL
reject=stderr:contains=panic recovered
