# RFC 7606 session-reset test
# Verifies: Peer sends UPDATE with MP_REACH_NLRI too short (length=2, minimum is 5).
# Expected: ze sends NOTIFICATION (code=3 UPDATE Message Error, subcode=9 Optional Attribute Error,
#           Data = the whole MP_REACH_NLRI attribute) and resets the session: RFC 7606 Section 5.3
#           makes the attribute incorrect, RFC 4760 Section 7 names the subcode, and RFC 4271
#           Section 6.3 puts the attribute in the Data field.
#
# RFC requirement: RFC7606-5.3-6 negative — MP_REACH_NLRI length < 5 makes the attribute incorrect
# RFC requirement: RFC7606-3.a-1 negative — a session-reset error is indicated by NOTIFICATION
#   with Error Code UPDATE Message Error (this test asserts code 3 / subcode 9 with the MP_REACH_NLRI
#   attribute as Data on the wire)
# RFC requirement: RFC7606-3.j-1 negative — an MP attribute that cannot be parsed requires session reset

# ze-peer expectations
stdin=peer:terminator=EOF_PEER
# The peer has no expectation left once it sends, so without linger it closes
# the instant its write lands. ze reads that as session-down and purges the
# peer's routes, which is what a session down owes under RFC 4271. A real
# peer stays up; this one closing is the artifact, so it is corrected here
# rather than worked around at the observer.
option=linger:value=true
option=timeout:value=10s

# Step 1: Expect automatic EOR (empty UPDATE for IPv4/unicast) after session establishment
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000

# Step 2: Send malformed UPDATE with MP_REACH_NLRI length=2 (minimum is 5 per Section 5.3)
# UPDATE: withdrawn=0, attrs=[ORIGIN(IGP)+AS_PATH(empty)+MP_REACH_NLRI(len=2,data=0001)]
action=send:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0023020000000C40010100400200800E020001

# Step 3: Expect NOTIFICATION (code=3 UPDATE Message Error, subcode=9 Optional Attribute Error,
# Data=800E020001: flags 0x80, type 14, length 2, value 0001)
expect=bgp:conn=1:seq=3:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF001A030309800E020001
EOF_PEER

# Minimal plugin (ze needs at least one plugin process)

# ze bgp configuration (IBGP)
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external rfc7606-test {
		run "le test fixture plugin/rfc7606-reset"
		encoder json
	}
}
bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=10s
