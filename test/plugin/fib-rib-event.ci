# Test: BGP RIB best-path change events published to Bus
#
# Flow:
# 1. Inject a route via rib inject
# 2. Verify "rib show best" shows the route with correct next-hop
# 3. Inject a better route from another peer
# 4. Verify best path updates
#
# VALIDATES: AC-1 -- BGP RIB publishes best-change events on best path change
# VALIDATES: AC-17 -- ze show bgp rib shows best routes per prefix
# PREVENTS: Best-path tracking not wired into production path

# ze-peer expectations
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER


# ze bgp configuration
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external fib-rib-event-test {
		run "ze-test fixture plugin/fib-rib-event"
		encoder json
	}
	internal bgp-rib {
		use bgp-rib
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}

		attach process bgp-rib {
			receive [ update state refresh ]
			send [ update ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
