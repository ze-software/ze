# Test: the configured looking-glass token gates the running daemon's routes
# VALIDATES: spec-fixit-mgmt-listener-auth-guard AC-5 -- the optional bearer
# token reaches the server through the whole daemon path (YANG leaf or
# ze.looking-glass.token -> hub resolution -> serviceDeps.LGToken ->
# lg.LGConfig.Token -> the middleware). A unit test that builds LGConfig
# directly proves the middleware; only this proves the wiring that feeds it.
# It also pins the settings/listener split: the token is read from a block that
# supplies settings, so it cannot be discarded on the way to the server.
# PREVENTS: an operator writing a token, believing the looking glass is gated,
# and getting an open one -- the defect class recorded as finding 5 for MCP.

option=timeout:value=60s

tmpfs=test-lg-token.sh:mode=755:terminator=EOF_SH
#!/bin/sh
set -e

LG_PORT=$((22000 + ($$ % 8000)))
DAEMON_PID=""

cleanup() {
	if [ -n "$DAEMON_PID" ]; then
		kill "$DAEMON_PID" 2>/dev/null || true
		wait "$DAEMON_PID" 2>/dev/null || true
	fi
}
trap cleanup EXIT

# tls false keeps the transport out of the way: this test is about the token.
cat > lg-token.conf << ZECONF
environment {
	looking-glass {
		enabled true
		tls false
		token lg-s3cret-token
		server main {
			ip 127.0.0.1;
			port $LG_PORT;
		}
	}
}
ZECONF

ze - < lg-token.conf 2>daemon.log &
DAEMON_PID=$!
i=0
while [ $i -lt 100 ]; do
	if grep -q "looking glass listening on" daemon.log 2>/dev/null; then
		break
	fi
	sleep 0.2
	i=$((i + 1))
done
if ! grep -q "looking glass listening on" daemon.log; then
	echo "FAIL: looking glass never started" >&2
	cat daemon.log >&2
	exit 1
fi

# status() prints the HTTP status code for a GET with the given Authorization
# header ("" sends none).
status() {
	python3 -c '
import sys, urllib.error, urllib.request
url = "http://127.0.0.1:" + sys.argv[1] + sys.argv[2]
req = urllib.request.Request(url)
if sys.argv[3]:
    req.add_header("Authorization", sys.argv[3])
try:
    print(urllib.request.urlopen(req, timeout=10).status)
except urllib.error.HTTPError as e:
    print(e.code)
' "$LG_PORT" "$1" "$2"
}

for path in /api/looking-glass/status /lg/peers; do
	CODE=$(status "$path" "")
	if [ "$CODE" != "401" ]; then
		echo "FAIL: $path without a token returned $CODE, want 401" >&2
		exit 1
	fi
	CODE=$(status "$path" "Bearer wrong-token")
	if [ "$CODE" != "401" ]; then
		echo "FAIL: $path with a wrong token returned $CODE, want 401" >&2
		exit 1
	fi
	CODE=$(status "$path" "Bearer lg-s3cret-token")
	if [ "$CODE" = "401" ]; then
		echo "FAIL: $path rejected the configured token" >&2
		exit 1
	fi
done
echo "OK: the configured token gates every looking glass route" >&2

exit 0
EOF_SH

cmd=foreground:seq=1:exec=./test-lg-token.sh:timeout=60s
expect=exit:code=0
expect=stderr:contains=OK: the configured token gates every looking glass route
