# Test: a native event predicate matches a specific event by decoded content.
# Spec: spec-payload-predicate-waits (AC-4, observer SDK).
#
# NOTE: an earlier draft waited on peer STATE events, but external observers
# received no state deliveries here; this uses the exabgp-style echo path instead
# (internal/test/peer/peer.go ModeEcho reflects the announced UPDATE back).
#
# VALIDATES: the observer skips non-matching events and returns the first
#            delivered event whose content satisfies the predicate. It
#            subscribes to bgp update events, announces a route, and the
#            echo-mode ze-peer reflects the UPDATE straight back
#            (internal/test/peer/peer.go ModeEcho); the daemon receives it and
#            delivers a bgp update event, which the predicate matches by prefix,
#            end to end through the daemon with no fixed delay.
# PREVENTS:  payload-predicate event waits regressing.


stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external event-predicate-test {
		run "ze-test fixture plugin/event-predicate-wait"
		encoder json
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}

		attach process event-predicate-test {
			receive [ update ]
			send [ update ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT --mode echo
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
expect=stderr:contains=matched the echoed update
reject=stderr:pattern=ZE-OBSERVER-FAIL
reject=stderr:pattern=panic recovered
