# Forked variant of modify-increment-localpref.ci: bgp-filter-modify runs as
# `external bgp-filter-modify { run "ze plugin bgp-filter-modify" }`, so the
# same wire expectation holds only when its CLIHandler runs cli.RunPlugin and
# the forked process connects back, receives the policy root its Stage 1
# declaration names, and answers the chain over filter-update.
# Test: modify filter increments local-preference on import
# VALIDATES: AC-15 -- increment local-preference from the declared base (100) by 50,
#   read on the wire: the iBGP receiver gets LOCAL_PREF 150.
# PREVENTS: Increment not computed, or computed from 0 rather than the base.
#
# Flow:
# 1. The source peer (eBGP, AS 65001) sends an UPDATE with no LOCAL_PREF, as RFC 4271
#    Section 5.1.5 requires on an external session.
# 2. The import chain calls bgp-filter-modify:INC-LP, which answers the set
#    "local-preference increment 50" (the log line's delta "local-preference +50").
# 3. The engine resolves it (policychain Sets): the route carries no LOCAL_PREF, so the
#    chain's base from bgp defaults attribute applies, 100 here because no defaults
#    block is written (RFC 4271 Section 9.1.1 leaves the value to local policy; 100 is
#    what FRR and BIRD use), and the route takes LOCAL_PREF 150.
# 4. The route server forwards the route to the iBGP receiver, which reads LOCAL_PREF.
#    LOCAL_PREF is the one place the number can be read: RFC 4271 Section 5.1.5 keeps it
#    off every external session.
#
# test/plugin/attribute-default-localpref-configured.ci is the other half: the same
# route and chain with a configured base of 80, where the receiver reads 130.

option=env:var=ze.log.bgp.filter.modify:value=info

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=2
option=timeout:value=20s
option=bind:value=0.0.0.0
# Bind conn=N by remote IP rather than accept order: which client connects first is a race
# (peer_connmap.go).
option=conn_map:value=remote-ip

# Source peer (conn=1, AS 65001): announce 10.0.0.0/24 with no LOCAL_PREF.
#   ORIGIN:    40010100            IGP
#   AS_PATH:   40020602010000FDE9  AS_SEQUENCE[65001], 4-byte ASNs
#   NEXT_HOP:  40030401010101      1.1.1.1
#   NLRI:      180A0000            10.0.0.0/24
# attr len = 4+9+7 = 20 = 0x14; total = 19+2+2+20+4 = 47 = 0x2F.
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002F02000000144001010040020602010000FDE940030401010101180A0000

# The source's own EOR.
expect=bgp:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000

# Receiver (conn=2, iBGP AS 65000): the source frame plus LOCAL_PREF 150. AS_PATH and
# NEXT_HOP are unchanged on an internal session.
#   LOCAL_PREF: 40050400000096  150
# attr len = 20+7 = 27 = 0x1B; total = 47+7 = 54 = 0x36.
expect=bgp:conn=2:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0036020000001B4001010040020602010000FDE94003040101010140050400000096180A0000
EOF_PEER

# Observer: wait until both peers have synced and 10.0.0.0/24 is forwarded, then stop.

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external bgp-filter-modify {
		run "ze plugin bgp-filter-modify"
	}
	internal rs {
		use bgp-rs
	}
	internal adj-rib-in {
		use bgp-adj-rib-in
	}
	external shutdown-after-up {
		run "le test fixture plugin/modify-increment-localpref"
		encoder json
	}
}
policy {
	modify INC-LP {
		increment {
			local-preference 50
		}
	}
}

bgp {
	# RFC 8212: an EBGP direction with no policy is refused; this test exchanges routes.
	filter {
		import { final accept; }
		export { final accept; }
	}
	peer source-peer {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		filter {
			import { filters [ modify:INC-LP ]; final accept; }
		}
		attach process adj-rib-in {
			receive [ update-received state ]
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
		attach process shutdown-after-up {
			receive [ update ]
		}
	}
	peer ibgp-receiver {
		connection {
			remote {
				ip 127.0.0.2
			}
			local {
				ip 127.0.0.2
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65000
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		attach process adj-rib-in {
			send [ update ]
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
		attach process shutdown-after-up {
			receive [ update ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
# The forked plugin logs in its own process, so the proof is the wire: without
# its answer the route meets on-error reject and the receiver never sees it.
reject=stderr:pattern=policy filter failed
reject=stderr:pattern=panic
reject=stderr:pattern=fatal error
