# Test: init-from-refused
# VALIDATES: `ze init --from` refuses an unsupported scheme naming it and the supported list, a SHA-256 mismatch, a body that is not a blob, and an existing store; each refusal imports nothing and leaves no fetched copy.
# PREVENTS: a substituted or truncated download becoming the live store, or a scheme typo read as a local path.
option=timeout:value=90s
cmd=foreground:seq=1:exec=le test fixture storage/init-from-refused:timeout=90s:exit=0
expect=exit:code=0
expect=stdout:contains=OK: init-from-refused
