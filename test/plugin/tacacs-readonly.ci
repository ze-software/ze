# Test: TACACS+ priv-lvl 1 maps to read-only and blocks an edit command.
# VALIDATES: AC-7.

stdin=ze-conf:terminator=EOF_CONF
bgp {
	peer peer1 {
		connection { remote { ip 127.0.0.2; } local { ip 127.0.0.1; accept false; } }
		session { asn { local 65533; remote 65533; } }
	}
}
system {
	authentication {
		tacacs {
			server 127.0.0.1 { port $PORT; key "ze-mock-key"; }
			timeout 2
		}
		tacacs-profile 1 { profile [ read-only ]; }
	}
	authorization {
		profile read-only {
			run { default-action allow; }
			edit { default-action deny; }
		}
	}
}
environment { ssh { enabled true; server main { ip 127.0.0.1; port $PORT2; } } }
plugin {
	external tacacs-readonly-test {
		run "ze-test fixture plugin/tacacs-readonly $PORT $PORT2"
		encoder json
	}
}
EOF_CONF

cmd=foreground:seq=1:exec=ze -:stdin=ze-conf:timeout=25s
expect=exit:code=0
expect=stderr:pattern=auth success.*source=tacacs
expect=stderr:pattern=profiles=\[read-only\]
expect=stderr:pattern=OK: noc refused write \(edit default-action deny\)
reject=stderr:pattern=ZE-OBSERVER-FAIL
