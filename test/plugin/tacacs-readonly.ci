# Test: TACACS+ priv-lvl 1 maps to read-only profile, blocks edit-only commands
#
# Flow:
# 1. Mock accepts noc:nocpass at priv-lvl 1
# 2. Daemon maps priv-lvl 1 -> [ read-only ]; profile read-only allows run, denies edit
# 3. ze cli -c "show bgp" succeeds (run section, default allow)
# 4. ze cli -c "request quiesce" is refused (edit section, default deny)
#
# VALIDATES: AC-7 -- TACACS+ priv-lvl 1 mapped to read-only profile.
# PREVENTS: priv-lvl mapping table parsed but never consulted, every TACACS+ user
#           getting admin by accident.
#
# Step 4 must use a command Ze actually has, and must assert WHY it failed. This
# test previously described a `configure` step it never ran, so only the allow side
# was covered: nothing here would have failed if priv-lvl 1 had wrongly mapped to
# admin. `configure` could not have covered it either, being an interactive-CLI mode
# switch that fails as "unknown command" for every user, denied or not.

tmpfs=test-tacacs-readonly.sh:mode=755:terminator=EOF_SH
#!/bin/sh
set -e

touch daemon.ready

ze-test tacacs-mock --port 0 --key ze-mock-key \
	--user noc:nocpass:1 --addr-file mock.addr 2>mock.log &
MOCK_PID=$!
trap 'kill $MOCK_PID 2>/dev/null || true; wait $MOCK_PID 2>/dev/null || true' EXIT

MOCK_ADDR=""
for i in $(seq 1 30); do
	if [ -s mock.addr ]; then
		MOCK_ADDR=$(cat mock.addr)
		break
	fi
	sleep 0.1
done
if [ -z "$MOCK_ADDR" ]; then
	echo "FAIL: mock did not report address" >&2
	cat mock.log >&2
	exit 1
fi
MOCK_IP=$(echo "$MOCK_ADDR" | cut -d: -f1)
MOCK_PORT=$(echo "$MOCK_ADDR" | cut -d: -f2)
echo "mock at $MOCK_ADDR" >&2

cat > tacacs-readonly.conf <<ZECONF
bgp {
	peer peer1 {
		connection {
			remote { ip 127.0.0.1; }
			local  { ip 127.0.0.1; accept false; }
		}
		session { asn { local 65533; remote 65533; } }
	}
}

system {
	authentication {
		tacacs {
			server ${MOCK_IP} { port ${MOCK_PORT}; key "ze-mock-key"; }
			timeout 2;
		}
		tacacs-profile 1 { profile [ read-only ]; }
	}
	authorization {
		profile read-only {
			run  { default-action allow; }
			edit { default-action deny;  }
		}
	}
}

environment {
	ssh {
		enabled true
		server main { ip 127.0.0.1; port 0; }
	}
}
ZECONF

export ze_test_bgp_port=$((10000 + ($$ % 50000)))

ze start tacacs-readonly.conf 2>daemon.log &
DAEMON_PID=$!
trap 'kill $DAEMON_PID 2>/dev/null || true; wait $DAEMON_PID 2>/dev/null || true; kill $MOCK_PID 2>/dev/null || true; wait $MOCK_PID 2>/dev/null || true' EXIT

SSH_PORT=""
for i in $(seq 1 50); do
	SSH_PORT=$(grep -o '127\.0\.0\.1:[0-9]*' daemon.log 2>/dev/null | head -1 | cut -d: -f2 || true)
	if [ -n "$SSH_PORT" ]; then
		break
	fi
	sleep 0.2
done
if [ -z "$SSH_PORT" ]; then
	echo "FAIL: SSH server did not start" >&2
	cat daemon.log >&2
	exit 1
fi
echo "ssh on :$SSH_PORT" >&2

sleep 0.5

NOC_DIR=$(mktemp -d)
trap 'rm -rf "$NOC_DIR"; kill $DAEMON_PID 2>/dev/null || true; wait $DAEMON_PID 2>/dev/null || true; kill $MOCK_PID 2>/dev/null || true; wait $MOCK_PID 2>/dev/null || true' EXIT
printf 'noc\nnocpass\n127.0.0.1\n%s\n' "$SSH_PORT" | ZE_CONFIG_DIR="$NOC_DIR" ze init >/dev/null

# noc should be allowed to run "show bgp" (read-only profile, run defaults allow)
OUTPUT=$(ZE_CONFIG_DIR="$NOC_DIR" ZE_SSH_PASSWORD="nocpass" ze cli -c "show bgp" 2>&1) || {
	echo "FAIL: noc should be allowed to run 'show summary'" >&2
	echo "OUTPUT: $OUTPUT" >&2
	echo "--- daemon log ---" >&2
	cat daemon.log >&2
	exit 1
}
echo "OK: noc allowed summary (priv-lvl 1 -> read-only)" >&2

# The deny side: this profile's edit section defaults to deny, so a command the
# dispatcher classifies as a write must be refused. This is what proves priv-lvl 1
# mapped to read-only rather than admin -- the allow above passes under either
# mapping.
#
# `request quiesce` is a write command, so it lands in the edit section. A `clear`
# would NOT work here: clears are operational commands evaluated against the run
# section, which this profile leaves at default-action allow (the built-in
# read-only profile is the one that denies `clear` explicitly, in run).
if OUTPUT=$(ZE_CONFIG_DIR="$NOC_DIR" ZE_SSH_PASSWORD="nocpass" ze cli -c "request quiesce" 2>&1); then
	echo "FAIL: noc (priv-lvl 1 -> read-only) must not be allowed a write command" >&2
	echo "OUTPUT: $OUTPUT" >&2
	echo "--- daemon log ---" >&2
	cat daemon.log >&2
	exit 1
fi
case "$OUTPUT" in
	*"command restricted by access control"*)
		echo "OK: noc refused write (edit default-action deny)" >&2
		;;
	*)
		echo "FAIL: expected an access-control refusal, got: $OUTPUT" >&2
		cat daemon.log >&2
		exit 1
		;;
esac

sleep 0.3
cat daemon.log >&2

exit 0
EOF_SH

cmd=foreground:seq=1:exec=./test-tacacs-readonly.sh:timeout=20s
expect=exit:code=0
# noc was authenticated via TACACS+ AND mapped to read-only profile.
expect=stderr:pattern=auth success.*source=tacacs
# The profiles list in the SSH auth log comes from the priv-lvl mapping
# (handlePass). If the mapping is broken, profiles=[] and the assertion fails.
expect=stderr:pattern=profiles=\[read-only\]
# The mapped profile is actually enforced: a login-time profiles=[read-only] log
# line proves only that the mapping was read, not that any command obeys it.
expect=stderr:pattern=OK: noc refused write \(edit default-action deny\)
