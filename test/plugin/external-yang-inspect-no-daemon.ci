# Test: with no ze running, dump, fmt, graph and diff query external plugins in declare mode and fail closed when a program cannot declare
#
# Question: with no ze running, does each local inspection command (`dump`,
# `fmt`, `graph`, `diff`), on a file declaring an external endpoint whose
# program exits without writing a Stage 1 declaration in declare mode, fail
# closed naming the endpoint, its `run` line, the cause, and the one conformance
# fix, without starting the program's run loop?
# Why not a unit test: TestInspectRouteFallsBackWhenNoZeAnswers proves the
# fallback over a stub ask. Only the real binary proves the local fallback
# reaches `SchemaWithDeclaredPlugins` -> `QueryDeclaration` with
# `ZE_PLUGIN_MODE=declare`, never starts the run loop, and prints the refusal.
#
# The program honors `ZE_PLUGIN_MODE=declare` by exiting 0 with no declaration
# line, and writes `started-by-ze.marker` only if started outside declare mode
# (the run loop).
#
# VALIDATES: S-3 / AC-18 of spec-explicit-plugin-and-attach-config.md for the
#   four inspection commands when no daemon listens: query mode fails closed on
#   a non-declaring program and never starts its run loop.
# PREVENTS: silently accepting a config whose external plugin failed to declare;
#   a fix that names `ze config validate` instead of `ze show plugin conformance
#   run`; starting an external program's run loop offline.

option=timeout:value=60s
option=env:var=ze.ssh.username:value=admin
option=env:var=ze.ssh.password:value=testpass
option=env:var=ze.ssh.port:value=$PORT

tmpfs=marker.run:terminator=EOF_RUN
if [ "$ZE_PLUGIN_MODE" = "declare" ]; then
	exit 0
fi
echo started > started-by-ze.marker
EOF_RUN

tmpfs=ze.conf:terminator=EOF_CONF
bus {
	endpoint acme-shell {
		external {
			run "sh marker.run";
		}
		encoding json;
	}
}

acme-shell {
	interval 5
}
EOF_CONF

cmd=foreground:seq=1:exec=ze config dump ze.conf:exit=1
expect=stderr:contains=bus endpoint "acme-shell" (run "sh marker.run"): declaration query failed: program exited without writing a Stage 1 declaration
expect=stderr:contains=offline validation queries each declared external program in declare mode without starting its run loop
expect=stderr:contains=fix: ze show plugin conformance run "sh marker.run"
reject=stderr:contains=fix: ze config validate

cmd=foreground:seq=2:exec=ze config fmt ze.conf:exit=2
expect=stderr:contains=bus endpoint "acme-shell" (run "sh marker.run"): declaration query failed: program exited without writing a Stage 1 declaration
expect=stderr:contains=fix: ze show plugin conformance run "sh marker.run"
reject=stderr:contains=fix: ze config validate

cmd=foreground:seq=3:exec=ze config graph ze.conf:exit=2
expect=stderr:contains=bus endpoint "acme-shell" (run "sh marker.run"): declaration query failed: program exited without writing a Stage 1 declaration
expect=stderr:contains=fix: ze show plugin conformance run "sh marker.run"
reject=stderr:contains=fix: ze config validate

cmd=foreground:seq=4:exec=ze config diff ze.conf ze.conf:exit=2
expect=stderr:contains=bus endpoint "acme-shell" (run "sh marker.run"): declaration query failed: program exited without writing a Stage 1 declaration
expect=stderr:contains=fix: ze show plugin conformance run "sh marker.run"
reject=stderr:contains=fix: ze config validate

cmd=foreground:seq=5:exec=ze config dump ze.conf:exit=1
expect=file:path=started-by-ze.marker:absent=true
