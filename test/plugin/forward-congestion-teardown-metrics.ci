# Test: congestion teardown metrics registered and visible via metrics values endpoint
#
# Flow:
# 1. BGP session establishes with telemetry enabled
# 2. Python plugin dispatches "show metrics values" via dispatch-command
# 3. Verifies Phase 5 congestion metrics appear in output
# 4. Shuts down daemon
#
# VALIDATES: AC-2/AC-4 -- buffer denial and congestion teardown metrics are registered.
# PREVENTS: Phase 5 metrics not wired or not reachable via dispatch chain.

# ze-peer expectations
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s

# EOR
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# Python test plugin: verifies congestion metrics appear in Prometheus output
tmpfs=congestion-teardown-test.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
"""Test: congestion teardown metrics visible in metrics values output."""

import json
import sys

from ze_api import API, result_text_data
# // test-relax: removed unused 'import time'; range/sleep metrics poll -> dispatch_until


def dispatch(api, command):
    """Call dispatch-command and return result dict."""
    resp = api._call_engine(
        'ze-plugin-engine:dispatch-command', {'command': command})
    return resp.get('result', {})


def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()

    # Wait for peer1 to establish and for its initial sync (the EOR this test's
    # ze-peer expects) to reach the wire, BEFORE asserting anything or shutting
    # down. Without this barrier the peer's EOR expectation is unreachable by
    # construction: every metric this test checks is a scalar counter registered
    # at telemetry setup with value 0, so `show metrics values` is already
    # non-empty when the plugin becomes ready -- which is BEFORE peers are even
    # started (plugin/server/startup.go signalStartupComplete fans out
    # post-startup, then calls SignalPluginStartupComplete -> StartPeers). The
    # script could therefore complete and dispatch `request shutdown` in the
    # window before the OPEN handshake, closing the session under the peer:
    # observed on an idle host as `failed: connection closed before completion`
    # with no "session established" line in the daemon log at all.
    # PendingSync stays set from establishment (peer_run.go sendingInitialRoutes)
    # until after the EOR is sent (peer_initial_sync.go), and the bgp-peer-sync
    # quiescer blocks on exactly that, so this barrier cannot return early.
    established = api.dispatch_until(
        'show bgp peer peer1 detail',
        lambda r: r.get('status') == 'done' and 'established' in result_text_data(r).lower(),
        attempts=40,
    )
    if 'established' not in result_text_data(established).lower():
        print('FAIL: peer1 never reached established state', file=sys.stderr)
        dispatch(api, 'request shutdown')
        api.wait_for_shutdown()
        sys.exit(1)
    api.quiesce()

    # Poll for metrics -- under parallel load, BGP session establishment can
    # take longer than a fixed sleep allows.
    # // test-relax: range/sleep(0.5) poll -> dispatch_until until metrics values are populated
    def has_metrics(res):
        if res.get('status') != 'done':
            return False
        try:
            data = json.loads(result_text_data(res, '{}'))
        except (json.JSONDecodeError, TypeError):
            return False
        return bool(data.get('metrics', ''))

    r = api.dispatch_until('show metrics values', has_metrics, attempts=10, delay=0.5)
    metrics_text = ''
    if r.get('status') == 'done':
        try:
            metrics_text = json.loads(result_text_data(r, '{}')).get('metrics', '')
        except (json.JSONDecodeError, TypeError):
            metrics_text = ''

    if not metrics_text:
        print('FAIL: empty metrics after dispatch_until poll', file=sys.stderr)
        sys.exit(1)

    # Phase 5 scalar counters: always registered, value 0 at startup
    required = [
        'ze_forward_buffer_denied_total',
        'ze_forward_congestion_teardown_total',
        'ze_bgp_pool_used_ratio',
    ]
    missing = []
    for name in required:
        if name not in metrics_text:
            missing.append(name)

    if missing:
        print(f'FAIL: missing congestion metrics: {missing}', file=sys.stderr)
        for line in metrics_text.split('\n'):
            if 'ze_' in line and not line.startswith('#'):
                print(f'  {line}', file=sys.stderr)
        sys.exit(1)

    print(f'OK: congestion teardown metrics present', file=sys.stderr)

    # Shutdown daemon
    dispatch(api, 'request shutdown')
    api.wait_for_shutdown()


if __name__ == '__main__':
    main()
EOF_RUN

# ze bgp configuration with telemetry enabled
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external congestion-teardown-test {
		run ./congestion-teardown-test.run
		encoder json
	}
}

telemetry {
	prometheus {
		enabled true
		server main {
			ip 127.0.0.1;
			port $PORT2;
		}
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}

		process congestion-teardown-test {
		}
	}
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
