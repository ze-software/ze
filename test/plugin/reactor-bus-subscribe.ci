# Test: reactor Bus subscription lifecycle — clean start/stop with Bus infrastructure
# VALIDATES: AC-6 — reactor starts and stops cleanly with the Bus wired
# VALIDATES: a plugin subscribed to `state` RECEIVES the peer-up event
#            (onPeerStateChange, internal/component/bgp/server/events.go:547)
# VALIDATES: ze emits End-of-RIB on the wire when the initial route sync drains
# PREVENTS: Bus lifecycle breaking reactor startup or shutdown
# PREVENTS: the peer-up state event silently never reaching a subscribed plugin

# ze-peer expectations
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# Python test plugin: observes the peer-up state event, then triggers clean shutdown.
#
# This observer used to dispatch `peer * update text nlri ipv4/unicast eor` here.
# That dispatch could never succeed and proved nothing about the Bus:
#   - the End-of-RIB the wire expectation below asserts is emitted by ze ITSELF
#     when the initial route sync drains (log: "end-of-rib suppressed: peer is
#     still draining its initial route sync ... marker will be emitted by
#     sendInitialRoutes when the drain completes"), so the dispatch was a second,
#     redundant EOR;
#   - ze-peer is a check-mode peer: it closes the connection the moment its
#     expectations are met, which is BEFORE this callback runs, so the dispatch
#     lost the race every time and failed with "no established peers to send to".
# Subscribing to `state` asserts the thing the header actually claims -- the
# peer-up event reaching a subscribed plugin -- and it cannot race the peer's
# teardown, because the event fires while the peer is coming UP.
tmpfs=bus-test.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
import json
import sys
from ze_api import API, dispatch, runtime_fail


def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()

    # Subscriptions ride the ready RPC, so there is no window in which the peer
    # could come up unobserved.
    api.subscribe(['state'])
    api.ready()

    def is_peer_up(event):
        if not isinstance(event, dict):
            return False
        bgp = event.get('bgp', {})
        return bgp.get('message', {}).get('type') == 'state' and bgp.get('state') == 'up'

    try:
        # Read events STRAIGHT after ready(), with nothing in between that also
        # reads. wait_for_post_startup loops on read_line() and throws away what
        # it reads (ze_api.py:1281-1297), so calling it here would consume the
        # peer-up event and this wait would then time out with nothing left to
        # read -- observed exactly once, which is why it now runs below instead.
        # refresh.ci:54-58 reads events directly after ready() for this reason.
        if api.wait_for_event(timeout=10.0, predicate=is_peer_up) is None:
            runtime_fail('no bgp state=up event delivered to the subscribed plugin')

        print('OK: Bus lifecycle — peer-up state event delivered', file=sys.stderr)
    finally:
        # Post-startup means the dispatcher's command registry is frozen, which
        # is what makes the shutdown dispatch below safe. This is where the wait
        # belongs: after the events have been read, not before.
        api.wait_for_post_startup(timeout=5.0)
        dispatch(api, 'request shutdown')
        api.wait_for_shutdown()

if __name__ == '__main__':
    main()
EOF_RUN

# ze bgp configuration
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external bus-test {
		run ./bus-test.run
		encoder json
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}

		process bus-test {
		}
	}
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
