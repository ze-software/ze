# Test: reactor Bus subscription lifecycle — clean start/stop with Bus infrastructure
# VALIDATES: AC-6 — reactor starts and stops cleanly with the Bus wired
# VALIDATES: a plugin subscribed to `state` RECEIVES the peer-up event
#            (onPeerStateChange, internal/component/bgp/server/events.go:547)
# VALIDATES: ze emits End-of-RIB on the wire when the initial route sync drains
# PREVENTS: Bus lifecycle breaking reactor startup or shutdown
# PREVENTS: the peer-up state event silently never reaching a subscribed plugin

# ze-peer expectations
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# ze bgp configuration
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external bus-test {
		run "ze-test fixture plugin/reactor-bus-subscribe"
		encoder json
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}

		attach process bus-test {
			receive [ state ]
		}
	}
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
