# RFC 7606 treat-as-withdraw test
# Verifies: Peer sends UPDATE with malformed ORIGIN (length=2 instead of 1).
# Expected: ze applies treat-as-withdraw (RFC 7606 Section 2) — the routes the malformed
# UPDATE announced are rewritten into a withdrawal and dispatched, so nothing is left
# installed and stale — and the session stays up.
# Proof: A subsequent valid route from the plugin reaches the peer successfully.
#
# RFC requirement: RFC7606-7.1-1 negative — ORIGIN length != 1 is malformed, treat-as-withdraw
# The session staying up is the load-bearing half: it is what distinguishes
# treat-as-withdraw from session reset end-to-end.
#
# NOT tagged RFC7606-2-1 ("treated as though all contained routes had been withdrawn").
# ze now DOES dispatch the malformed UPDATE as a synthesized withdrawal (Section 2), but this
# test still only observes session survival and the updates-received counter, never the RIB.
# It cannot prove the synthesized withdrawal actually removed a previously-installed prefix,
# so tagging RFC7606-2-1 here would still manufacture false coverage. The RIB-removal proof
# lives at the unit layer (session_test.go TestSessionRFC7606...DispatchesWithdrawal asserts
# the withdrawal bytes).

# ze-peer expectations
stdin=peer:terminator=EOF_PEER
option=timeout:value=15s

# Step 1: Expect automatic EOR (empty UPDATE for IPv4/unicast) after session establishment
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000

# Step 2: Expect first valid route from plugin (10.0.0.0/24 via 10.0.0.1)
# UPDATE: withdrawn=0, attrs=[ORIGIN(IGP)+AS_PATH(empty)+NEXT_HOP(10.0.0.1)+LOCAL_PREF(100)], NLRI=10.0.0.0/24
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00300200000015400101004002004003040A00000140050400000064180A0000

# Step 3: Send malformed UPDATE with ORIGIN length=2 (RFC 7606 Section 7.1: must be 1)
# UPDATE: withdrawn=0, attrs=[ORIGIN(len=2,MALFORMED)+AS_PATH(empty)+NEXT_HOP(10.0.0.1)], NLRI=10.0.0.0/24
action=send:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002A020000000F40010200004002004003040A000001180A0000
# Step 3b: Send a well-formed EOR (empty IPv4/unicast UPDATE) as a processing fence,
# in the same seq=2 group so the peer emits it immediately after the malformed above.
# ze increments updates-received for BOTH the malformed treat-as-withdraw (Section 2 now
# synthesizes and dispatches a withdrawal, which counts) and this EOR. Because ze processes
# this connection in TCP order on one session-read goroutine, the observer seeing
# updates-received >= 1 proves the malformed UPDATE was already handled. This lets the
# observer gate Route 2 on real processing instead of a blind sleep(1.0).
action=send:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000

# Step 4: Expect second valid route from plugin (10.0.1.0/24) — proves session survived
expect=bgp:conn=1:seq=3:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00300200000015400101004002004003040A00000140050400000064180A0001
EOF_PEER

# Python plugin script
tmpfs=rfc7606-withdraw.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
"""RFC 7606 treat-as-withdraw test plugin.

Sends two routes: one before and one after the peer sends a malformed UPDATE.
If the second route reaches the peer, the session survived the malformed UPDATE.
"""

import json
import sys
import time

from ze_api import API


def dispatch(api, command):
    resp = api._call_engine(
        'ze-plugin-engine:dispatch-command', {'command': command})
    if resp is None:
        return {'status': 'error', 'data': 'engine call returned None'}
    return resp.get('result', {})


def updates_received(api):
    r = dispatch(api, 'show bgp peer peer1 detail')
    return r.get('data', {}).get('peers', {}).get('127.0.0.1', {}).get(
        'updates-received', 0)


def main() -> None:
    api = API()
    api.declare_done()
    api.wait_for_config(timeout=10.0)
    api.capability_done()
    api.wait_for_registry(timeout=10.0)
    api.subscribe(['state'])
    api.ready()

    # Wait for peer up
    start = time.time()
    while time.time() - start < 5:
        line = api.read_line(0.5)
        if line is None:
            continue
        try:
            event = json.loads(line)
        except (json.JSONDecodeError, TypeError):
            continue
        bgp = event.get('bgp', {})
        msg = bgp.get('message', {})
        if msg.get('type') == 'state' and bgp.get('state') == 'up':
            break

    # Route 1: sent immediately after peer up
    api.send('peer * update text nhop 10.0.0.1 nlri ipv4/unicast add 10.0.0.0/24')

    # Deterministic replacement for sleep(1.0): the peer sends the malformed UPDATE
    # followed by a well-formed EOR (see the peer block, Step 3/3b). ze counts both the
    # malformed treat-as-withdraw (Section 2 dispatches a synthesized withdrawal) and the
    # EOR, and processes the connection in TCP order, so updates-received >= 1 proves the
    # malformed UPDATE was already handled. Only then is it valid to send Route 2 as proof
    # the session survived the malformed UPDATE.
    if not api.wait_until(lambda: updates_received(api) >= 1, attempts=100, delay=0.1):
        print('FAIL: ze never counted the post-malformed EOR fence', file=sys.stderr)
        sys.exit(1)

    # Route 2: proves session survived the malformed UPDATE
    api.send('peer * update text nhop 10.0.0.1 nlri ipv4/unicast add 10.0.1.0/24')

    api.wait_for_shutdown()


if __name__ == '__main__':
    main()
EOF_RUN

# ze bgp configuration (IBGP)
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external rfc7606-test {
		run ./rfc7606-withdraw.run
		encoder json
	}
}
bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
		}
		behavior {
			group-updates disable
		}

		attach process rfc7606-test {
			receive [ state ]
			send [ update ]
		}
	}
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
