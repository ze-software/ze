# Test: `ze config validate` and `ze - < file` agree on every config shape.
#
# The class: a config the validator ACCEPTS must BOOT, and a config it REJECTS
# must be refused at boot too. The two used to disagree because a config whose
# top-level blocks were only `plugin` and `env` selected a second runtime, the
# standalone hub orchestrator, whose hand-written parser accepted the literal
# word `external` and nothing else. So
# `plugin { internal static { use static } }` printed "configuration valid" and
# then died with "line 2: expected 'external', got internal".
#
# The fix deleted that runtime. Every config now boots through runYANGConfig
# (cmd/ze/hub/main.go), on the one parser `ze config validate` already used.
#
# VALIDATES: a pure `plugin { internal ... }` config boots through `ze -`.
# VALIDATES: validate-accepts and boot-succeeds agree over a table of shapes,
#            in both directions -- a rejected config is refused at boot too.
# PREVENTS: a second config runtime with its own parser, in any form.
#
# DISCRIMINATION: restoring the ConfigTypeHub route in
# internal/component/config/probe.go turns the plugin_internal and plugin_two
# rows red with "expected 'external', got internal" -- the pre-fix error.

tmpfs=shapes/plugin_internal.conf:terminator=EOF_PLUGIN_INTERNAL
plugin {
	internal static {
		use static
	}
}
EOF_PLUGIN_INTERNAL

tmpfs=shapes/plugin_two.conf:terminator=EOF_PLUGIN_TWO
plugin {
	internal static {
		use static
	}
	internal rt {
		use routing-table
	}
}
EOF_PLUGIN_TWO

# The `env {}` block was the deleted runtime's own syntax and has no YANG home.
# It must be refused by both validation and boot.
tmpfs=shapes/legacy_env.conf:terminator=EOF_LEGACY_ENV
env {
	log-level debug
}
plugin {
}
EOF_LEGACY_ENV

tmpfs=shapes/unknown_internal.conf:terminator=EOF_UNKNOWN_INTERNAL
plugin {
	internal bogus {
		use no-such-plugin
	}
}
EOF_UNKNOWN_INTERNAL

cmd=foreground:seq=1:exec=ze-test fixture plugin/config-validate-agrees-with-boot:timeout=60s
expect=exit:code=0
expect=stderr:contains=OK[plugin_internal]: validate=valid boot=yes
expect=stderr:contains=OK[plugin_two]: validate=valid boot=yes
expect=stderr:contains=OK[legacy_env]: validate=invalid boot=no
expect=stderr:contains=OK[unknown_internal]: validate=invalid boot=no
reject=stderr:pattern=expected 'external'
