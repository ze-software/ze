# Test: a second OPEN on an ESTABLISHED session is refused with NOTIFICATION Cease.
#
# VALIDATES: spec-fixit-bgp-session-fsm-lifecycle AC-4a -- an established peer
# that sends another OPEN on the same connection gets a Cease (code 6) and the
# connection is closed, and the negotiated capability set is NOT rebuilt.
#
# PREVENTS: the defect this closed. handleOpen had no state gate, so an OPEN
# arriving on a live session ran the whole path again: it overwrote s.peerOpen
# and called negotiateWith, letting a peer REWRITE the agreed capability set of
# an already-established peering (measured: peerCodes went from {0x1, 0x41} to
# {0x1, 0x41, 0x45}, the peer injecting AddPath mid-session).
#
# Why a .ci and not only the unit tests: the unit tests
# (TestSecondOpenOnEstablishedSessionIsRefused,
# TestSecondOpenInOpenConfirmIsRefused) drive Session directly. This proves the
# behaviour through the real daemon over a real socket -- that the message
# actually reaches handleOpen through the production read path
# (session_coalesce.go -> processMessage), which the unit tests bypass by
# calling ReadAndProcess, a function with no production callers.
#
# Code 6 not code 5: RFC 4271 Section 8.2.2 excludes BGPOpen (Event 19) from the
# FSM-Error branch in both states that can see it -- Established scopes that
# branch to "Events 9, 12-13, 20-22" and OpenConfirm to "Events 9, 12-13, 20,
# 27-28" -- and routes Event 19 through collision detection, whose termination
# action is "sends a NOTIFICATION with a Cease".

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s

# Sent AFTER the peer's own handshake completes, so ze is Established when this
# arrives. A minimal OPEN: version 4, AS 65000 (matching the configured remote
# so it is not rejected for an AS mismatch first), hold 90, BGP Identifier
# 1.2.3.5, no optional parameters.
#
# The identifier deliberately differs from ze's router-id 1.2.3.4: this is an
# iBGP session, and RFC 6286 Section 2.2 has ze reject an internal peer that
# presents ze's OWN identifier with a Bad BGP Identifier. Reusing 1.2.3.4 here
# would trip that check instead and the test would pass for the wrong reason.
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF001D0104FDE8005A0102030500

# NOTIFICATION, Cease (6), subcode 0, no data: 21 bytes total.
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0015030600
EOF_PEER

# Native observer polls the monotonic session-drop counter after the exact Cease
# frame has been observed.

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external watch-down {
		run "ze-test fixture plugin/open-in-established"
		encoder json
	}
}

telemetry {
	prometheus {
		enabled true
		server main {
			ip 127.0.0.1;
			port $PORT2;
		}
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65000
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
expect=stderr:contains=OK: peer went down after the second OPEN was refused
reject=stderr:pattern=panic
reject=stderr:pattern=fatal error
