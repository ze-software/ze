# Test: ddos direction classification -- an attack on a box-owned (local) victim is
# classified Direction=local and surfaced on the incident.
#
# VALIDATES: spec-ddos-direction-allowlist AC-13/AC-9 (classification) -- an attack on
#            a box-owned address (127.0.0.3, RTN_LOCAL) opens an incident whose
#            direction field is "local" (show ddos incidents), proving the detector
#            classifies direction via iface.AddressIsLocal end-to-end.
# PREVENTS:  direction being unset/wrong (e.g. defaulting to remote) for a box-owned
#            victim.
#
# // test-relax: this test asserts the direction CLASSIFICATION only, not the INPUT-hook
# drop install. The on-host drop needs the firewall nft backend, and loading it
# (firewall {} block) deadlocked the daemon's command dispatch under the flood (the
# firewall component and the ddos-local responder drive nft concurrently). The
# local->INPUT vs remote->FORWARD hook selection is covered exhaustively by the unit
# test TestLocalHookByDirection (local/responder_test.go).
#
# STATUS: option=needs-linux. Full daemon path on the QEMU Alpine VM via an in-daemon
#   observer plugin (ze_api handshake), same harness as ddos-bps-amplification.

option=needs-linux
# Every ddos test floods the SAME loopback interface, and the detector picks the
# victim by top-destination-bytes over that interface's counters, so a sibling's
# concurrent flood is indistinguishable from this test's own. Unique victim
# addresses only stop the bind collision; they cannot partition the counters.
# Without this, QEMU pass 4 had test 155 resolve 127.0.0.4 (test 157's victim)
# and this test resolve no victim at all (direction fell back to remote).
option=exclusive:group=ddos-flood
option=env:var=ze.log.ddos.detect:value=info
option=env:var=ze.log.ddos.local:value=info
option=timeout:value=90s

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=90s
option=asn:value=65001
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

tmpfs=ddos-direction-probe.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
"""Flood a loopback (box-owned) victim; assert an incident opens with direction=local.
In-daemon observer plugin (5-stage handshake); pacing is sleep-free."""
import json
import socket
import sys
import time

from ze_api import API, result_text_data, runtime_fail

# Unique per test: the ddos plugin-suite tests share ONE network namespace (the
# QEMU suite runs `bgp plugin -p 4`, no ZE_TEST_NETNS), so a victim/sink pair reused
# by a sibling makes the second binder die EADDRINUSE and two detectors resolve the
# same target. Allocation table in ddos-bps-amplification.ci.
VICTIM = "127.0.0.3"
DPORT = 9999
PAYLOAD = b"x" * 64


def dispatch(api, command):
    resp = api._call_engine("ze-plugin-engine:dispatch-command", {"command": command})
    if resp is None:
        return {"status": "error", "data": "engine call returned None"}
    return resp.get("result", {})


def incidents(api):
    r = dispatch(api, "show ddos incidents")
    if r.get("status") != "done":
        return []
    data = result_text_data(r)
    if isinstance(data, str) and data:
        data = json.loads(data)
    if not isinstance(data, dict):
        return []
    return data.get("incidents", []) or []


def blast(sock, n):
    sent = 0
    for _ in range(n):
        try:
            sock.sendto(PAYLOAD, (VICTIM, DPORT))
            sent += 1
        except OSError:
            pass
    return sent


def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()
    api.wait_for_post_startup(timeout=5.0)

    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    # Bind a sink on the victim port so the flood is absorbed and no ICMP
    # port-unreachable backscatter makes trafficusage mis-resolve the victim (learned/1109).
    sink = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    sink.bind((VICTIM, DPORT))
    sink.setblocking(False)
    found_local = False
    incs = []
    sent = 0
    deadline = time.monotonic() + 45.0
    while time.monotonic() < deadline:
        sent += blast(sock, 4000)
        incs = incidents(api)
        if any(inc.get("direction") == "local" for inc in incs):
            found_local = True
            break
        api.read_line(timeout=0.3)
    sock.close()
    sink.close()

    if not found_local:
        runtime_fail(f"no incident with direction=local opened for a box-owned victim "
                     f"(sent {sent} packets, incidents={incs})")

    print(f"OK: box-owned victim {VICTIM} classified direction=local on the incident "
          f"(sent {sent} packets)", file=sys.stderr)
    dispatch(api, "request shutdown")
    api.wait_for_shutdown()


if __name__ == "__main__":
    main()
EOF_RUN

stdin=ze-bgp:terminator=EOF_CONF
ddos {
	detect {
		enabled true
		absolute-floor 1000
		confirm-duration 1
		startup-grace 0
		baseline-window 10
		check-interval 1
		characterize-enable false
	}
	observe {
		incident-ring-size 100
	}
	local {
		response-level enforce
	}
}

traffic {
	usage {
		enabled true
		track-ip true
		interfaces {
			interface lo {
				enabled true
			}
		}
	}
}

plugin {
	external ddos-direction-probe {
		run ./ddos-direction-probe.run
		encoder json
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast {
					prefix {
						maximum 10000
					}
				}
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}

		process ddos-direction-probe {
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=85s
expect=exit:code=0
