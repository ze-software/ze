# bgp-local-as-inbound-route-server -- route-server AS_PATH transparency and
# AC-3 config-load refusal for rs-client + import as-path-prepend.
#
# VALIDATES: spec-bgp-import-prepend-guards AC-3, A-3, and User Story 1:
#   1. `ze config validate` refuses a configuration that attaches an active
#      import `policy { modify }` with `as-path-prepend` to a route-server
#      client (`session { rs-client true; }`), naming the peer, the modify
#      definition, `as-path-prepend`, RFC 7947 Section 2.2.2.1, and the
#      removal fix (Stage 2 configure and reload verify share the same parser
#      and are covered by `TestRouteServerRefusesInboundASPathPrepend`).
#   2. On a valid route-server configuration with two `rs-client true` peers
#      exchanging routes through `bgp-rs`, client 2 receives client 1's UPDATE
#      with `AS_PATH` byte-identical (no route-server AS 65000 prepended).
#
# PREVENTS: an ingress import `as-path-prepend` silently rewriting `AS_PATH` on
# a route-server client's received UPDATE before caching and forwarding to
# other route-server clients.
#
# NO LOCAL_PREF in the source frame: the source is an eBGP peer and RFC 4271
# Section 5.1.5 forbids LOCAL_PREF toward external peers, so ze would overwrite
# it with an ATTR_DISCARD marker and byte-equality would pin the marker instead
# of the AS_PATH.

tmpfs=bad-rs-prepend.conf:refused=config-plugin-verify:terminator=EOF_BAD
bus {
	endpoint rs {
		internal bgp-rs;
	}
	endpoint adj-rib-in {
		internal bgp-adj-rib-in;
	}
}
policy {
	modify PREPEND-IN {
		set {
			as-path-prepend 1;
		}
	}
}
bgp {
	router-id 1.2.3.4;
	session {
		asn {
			local 65000;
		}
	}
	peer client-1 {
		connection {
			remote {
				ip 127.0.0.1;
			}
			local {
				ip 127.0.0.1;
				accept false;
			}
		}
		session {
			asn {
				local 65000;
				remote 65001;
			}
			router-id 1.2.3.4;
			rs-client true;
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable;
			}
		}
		filter {
			import { filters [ modify:PREPEND-IN ]; final accept; }
			export { final accept; }
		}
	}
}
EOF_BAD

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=2
option=timeout:value=20s
option=linger:value=true
option=bind:value=0.0.0.0
# Map conn=N by remote IP rather than accept order so client-1 and client-2
# cannot swap roles under load.
option=conn_map:value=remote-ip

# Client 1 (conn=1, AS 65001): announce 10.0.0.0/24 with populated AS_PATH.
#   ORIGIN:    40010100            IGP
#   AS_PATH:   40020602010000FDE9  AS_SEQUENCE[65001], 4-byte ASNs
#   NEXT_HOP:  40030401010101      1.1.1.1
#   NLRI:      180A0000            10.0.0.0/24
# attr len = 4+9+7 = 20 = 0x14; total = 19+2+2+20+4 = 47 = 0x2F.
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002F02000000144001010040020602010000FDE940030401010101180A0000

# Client 1's own End-of-RIB from initial sync.
expect=bgp:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000

# Client 2 (conn=2, AS 65002, rs-client true): receives Client 1's UPDATE
# byte-identical, with AS_PATH still AS_SEQUENCE[65001] and no 65000 prepended
# (RFC 7947 Section 2.2.2.1). No EOR rule on conn=2 because the forwarded
# UPDATE and the receiver's EOR are unordered on the wire.
expect=bgp:conn=2:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002F02000000144001010040020602010000FDE940030401010101180A0000
EOF_PEER

stdin=ze-bgp:terminator=EOF_CONF
bus {
	endpoint rs {
		internal bgp-rs;
	}
	endpoint adj-rib-in {
		internal bgp-adj-rib-in;
	}
	endpoint shutdown-after-up {
		external {
			run "le test fixture plugin/bgp-rs-community-strip-multi";
		}
		encoding json;
	}
}
bgp {
	router-id 1.2.3.4;
	filter {
		import { final accept; }
		export { final accept; }
	}
	peer client-1 {
		connection {
			remote {
				ip 127.0.0.1;
			}
			local {
				ip 127.0.0.1;
				accept false;
			}
		}
		session {
			asn {
				local 65000;
				remote 65001;
			}
			router-id 1.2.3.4;
			rs-client true;
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable;
			}
		}
		behavior {
			group-updates disable;
		}
	}
	peer client-2 {
		connection {
			remote {
				ip 127.0.0.2;
			}
			local {
				ip 127.0.0.2;
				accept false;
			}
		}
		session {
			asn {
				local 65000;
				remote 65002;
			}
			router-id 1.2.3.4;
			rs-client true;
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable;
			}
		}
		behavior {
			group-updates disable;
		}
	}
}
EOF_CONF

# Step 1: config validation refuses rs-client + import as-path-prepend.
cmd=foreground:seq=1:exec=ze config validate bad-rs-prepend.conf:timeout=15s:exit=1
expect=stdout:contains=peer client-1
expect=stdout:contains=PREPEND-IN
expect=stdout:contains=as-path-prepend
expect=stdout:contains=RFC 7947 Section 2.2.2.1
expect=stdout:contains=fix:

# Step 2: valid route server relays Client 1's AS_PATH byte-identically to Client 2.
cmd=background:seq=2:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=3:exec=ze -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
reject=stderr:pattern=panic
reject=stderr:pattern=fatal error
reject=stderr:pattern=forward-cached failed
reject=stderr:pattern=release-cached failed
