		encoding json;
		send {
			allow [ bgp:update ];
			to [ /bgp/group/transit ];
		}
	}
}
bgp {
	router-id 192.0.2.254;
	filter {
		import { final accept; }
		export { final accept; }
	}
	group transit {
		peer t1 {
			connection {
				remote { ip 127.0.0.2; }
				local { ip 127.0.0.1; accept false; }
			}
			session {
				asn { local 65000; remote 65001; }
