			run "le test fixture plugin/bus-bgp-sender update-and-refresh s7-1.go 127.0.0.2 203.0.113.0/24 ok ok s7-1.done";
		}
		encoding json;
	}
}
bgp {
	router-id 192.0.2.254;
	filter {
		import { final accept; }
		export { final accept; }
	}
	peer edge1 {
		connection {
			remote { ip 127.0.0.2; }
			local { ip 127.0.0.1; accept false; }
		}
		session {
			asn { local 65000; remote 65001; }
			family { ipv4/unicast { prefix { maximum 10000; } } }
			capability {
				route-refresh enable;
				graceful-restart disable;
			}
		}
		behavior { group-updates disable; }
	}
}
EOF_S7_1

