cmd=foreground:seq=1:exec=ze init:stdin=init-answers:exit=0

# --- S7 Run 1: no send allow-list -> update & refresh succeed, counter = 0 ---
cmd=background:seq=2:name=e-s7-1:exec=le test peer --bind 127.0.0.2 --port $PORT:stdin=edge1-s7-1
cmd=background:seq=3:name=d-s7-1:exec=ze start s7-none.conf:ready=Ze running.
reject=stderr:pattern=ZE-OBSERVER-FAIL
reject=stderr:pattern=panic

cmd=foreground:seq=4:exec=le test fixture plugin/bus-wait-file edge1-s7-1.up:exit=0
cmd=foreground:seq=5:exec=le test fixture plugin/bus-touch-file s7-1.go:exit=0
cmd=foreground:seq=6:exec=le test fixture plugin/bus-wait-file s7-1.done:exit=0
cmd=foreground:seq=7:exec=le test fixture plugin/bus-assert-refused-count $PORT3 /bus/endpoint/sender 0:exit=0

cmd=stop:seq=8:name=d-s7-1:signal=term
cmd=stop:seq=9:name=e-s7-1

# --- S7 Run 2: send { allow [ bgp:update ]; } -> update succeeds, refresh refused, counter = 1 ---
cmd=background:seq=10:name=e-s7-2:exec=le test peer --bind 127.0.0.2 --port $PORT:stdin=edge1-s7-2
cmd=background:seq=11:name=d-s7-2:exec=ze start s7-partial.conf:ready=Ze running.
reject=stderr:pattern=ZE-OBSERVER-FAIL
reject=stderr:pattern=panic

cmd=foreground:seq=12:exec=le test fixture plugin/bus-wait-file edge1-s7-2.up:exit=0
cmd=foreground:seq=13:exec=le test fixture plugin/bus-touch-file s7-2.go:exit=0
cmd=foreground:seq=14:exec=le test fixture plugin/bus-wait-file s7-2.done:exit=0
cmd=foreground:seq=15:exec=le test fixture plugin/bus-assert-refused-series $PORT3 /bus/endpoint/sender bgp:refresh 1:exit=0
cmd=foreground:seq=16:exec=le test fixture plugin/bus-assert-refused-count $PORT3 /bus/endpoint/sender 1:exit=0

cmd=stop:seq=17:name=d-s7-2:signal=term
cmd=stop:seq=18:name=e-s7-2

# --- S7 Run 3: send { allow none; } -> both refused, counter = 2 ---
cmd=background:seq=19:name=e-s7-3:exec=le test peer --bind 127.0.0.2 --port $PORT:stdin=edge1-s7-3
cmd=background:seq=20:name=d-s7-3:exec=ze start s7-empty.conf:ready=Ze running.
reject=stderr:pattern=ZE-OBSERVER-FAIL
reject=stderr:pattern=panic

cmd=foreground:seq=21:exec=le test fixture plugin/bus-wait-file edge1-s7-3.up:exit=0
cmd=foreground:seq=22:exec=le test fixture plugin/bus-touch-file s7-3.go:exit=0
cmd=foreground:seq=23:exec=le test fixture plugin/bus-wait-file s7-3.done:exit=0
cmd=foreground:seq=24:exec=le test fixture plugin/bus-assert-refused-count $PORT3 /bus/endpoint/sender 2:exit=0

cmd=stop:seq=25:name=d-s7-3:signal=term
cmd=stop:seq=26:name=e-s7-3

# S7 commit refusal: undeclared bgp:raw lists declared bgp:update and bgp:refresh.
cmd=foreground:seq=27:exec=ze config validate s7-undeclared.conf:exit=1
expect=stdout:contains=bgp:raw
expect=stdout:contains=bgp:update
expect=stdout:contains=bgp:refresh

# --- S8 Run 4: no receive allow-list -> collector records state and update; Loc-RIB holds route ---
cmd=background:seq=28:name=e-s8-1:exec=le test peer --bind 127.0.0.2 --port $PORT:stdin=edge1-s8-1
cmd=background:seq=29:name=d-s8-1:exec=ze start s8-all.conf:ready=Ze running.
reject=stderr:pattern=ZE-OBSERVER-FAIL
reject=stderr:pattern=panic

cmd=foreground:seq=30:exec=le test fixture daemon/await-answer-all "show bgp rib" 203.0.113.0/24:exit=0
cmd=foreground:seq=31:exec=le test fixture plugin/bus-assert-implied poll-file-contains s8-all.log '"state":"up"':exit=0
cmd=foreground:seq=32:exec=le test fixture plugin/bus-assert-implied poll-file-contains s8-all.log 203.0.113.0/24:exit=0

cmd=stop:seq=33:name=d-s8-1:signal=term
cmd=stop:seq=34:name=e-s8-1

# --- S8 Run 5: receive { allow [ bgp:state ]; } -> state only; Loc-RIB holds route ---
cmd=background:seq=35:name=e-s8-2:exec=le test peer --bind 127.0.0.2 --port $PORT:stdin=edge1-s8-2
cmd=background:seq=36:name=d-s8-2:exec=ze start s8-state.conf:ready=Ze running.
reject=stderr:pattern=ZE-OBSERVER-FAIL
reject=stderr:pattern=panic

cmd=foreground:seq=37:exec=le test fixture daemon/await-answer-all "show bgp rib" 203.0.113.0/24:exit=0
cmd=foreground:seq=38:exec=le test fixture plugin/bus-assert-implied poll-file-contains s8-state.log '"state":"up"':exit=0
cmd=foreground:seq=39:exec=le test fixture plugin/bus-assert-implied file-not-contains s8-state.log 203.0.113.0/24:exit=0
cmd=foreground:seq=40:exec=le test fixture plugin/bus-assert-implied file-not-contains s8-state.log '"type":"update"':exit=0

cmd=stop:seq=41:name=d-s8-2:signal=term
cmd=stop:seq=42:name=e-s8-2

# --- S8 Run 6: receive { allow none; } -> nothing recorded; Loc-RIB holds route ---
cmd=background:seq=43:name=e-s8-3:exec=le test peer --bind 127.0.0.2 --port $PORT:stdin=edge1-s8-3
cmd=background:seq=44:name=d-s8-3:exec=ze start s8-none.conf:ready=Ze running.
reject=stderr:pattern=ZE-OBSERVER-FAIL
reject=stderr:pattern=panic

cmd=foreground:seq=45:exec=le test fixture daemon/await-answer-all "show bgp rib" 203.0.113.0/24:exit=0
cmd=foreground:seq=46:exec=le test fixture plugin/bus-assert-implied file-not-contains s8-none.log 127.0.0.2:exit=0
cmd=foreground:seq=47:exec=le test fixture plugin/bus-assert-implied file-not-contains s8-none.log 203.0.113.0/24:exit=0

cmd=stop:seq=48:name=d-s8-3:signal=term
cmd=stop:seq=49:name=e-s8-3

# --- S9 Run 7: send { allow [ bgp:update ]; to [ /bgp/group/transit ]; } ---
cmd=background:seq=50:name=t1-s9:exec=le test peer --bind 127.0.0.2 --port $PORT:stdin=t1-s9
cmd=background:seq=51:name=t2-s9:exec=le test peer --bind 127.0.0.3 --port $PORT:stdin=t2-s9
cmd=background:seq=52:name=edge1-s9:exec=le test peer --bind 127.0.0.4 --port $PORT:stdin=edge1-s9
cmd=background:seq=53:name=lab-s9:exec=le test peer --bind 127.0.0.5 --port $PORT:stdin=lab-s9
cmd=background:seq=54:name=d-s9:exec=ze start s9-combined.conf:ready=Ze running.
reject=stderr:pattern=ZE-OBSERVER-FAIL
reject=stderr:pattern=panic

cmd=foreground:seq=55:exec=le test fixture plugin/bus-wait-file t1-s9.up:exit=0
cmd=foreground:seq=56:exec=le test fixture plugin/bus-wait-file t2-s9.up:exit=0
cmd=foreground:seq=57:exec=le test fixture plugin/bus-wait-file edge1-s9.up:exit=0
cmd=foreground:seq=58:exec=le test fixture plugin/bus-wait-file lab-s9.up:exit=0
cmd=foreground:seq=59:exec=le test fixture plugin/bus-touch-file s9.go:exit=0
cmd=foreground:seq=60:exec=le test fixture plugin/bus-wait-file s9.done:exit=0

# t1 and t2 received the update (EOR + 10.0.1.0/24 = 2 updates-sent); edge1 and lab stayed at EOR only (1).
cmd=foreground:seq=61:exec=le test fixture daemon/await-answer-all "show bgp peer t1 detail | json" '"updates-sent": 2':exit=0
cmd=foreground:seq=62:exec=le test fixture daemon/await-answer-all "show bgp peer t2 detail | json" '"updates-sent": 2':exit=0
cmd=foreground:seq=63:exec=ze cli -c "show bgp peer edge1 detail | json":exit=0
expect=stdout:contains="updates-sent": 1
cmd=foreground:seq=64:exec=ze cli -c "show bgp peer lab detail | json":exit=0
expect=stdout:contains="updates-sent": 1
# Refresh was refused by the send allow-list (counter = 1 for bgp:refresh).
cmd=foreground:seq=65:exec=le test fixture plugin/bus-assert-refused-series $PORT3 /bus/endpoint/sender bgp:refresh 1:exit=0

cmd=stop:seq=66:name=d-s9:signal=term
cmd=stop:seq=67:name=t1-s9
cmd=stop:seq=68:name=t2-s9
cmd=stop:seq=69:name=edge1-s9
cmd=stop:seq=70:name=lab-s9

# S9 commit refusal: per-message bgp:refresh contradicts send > allow [ bgp:update ].
cmd=foreground:seq=71:exec=ze config validate s9-contradictory.conf:exit=1
expect=stdout:contains=send > allow
expect=stdout:contains=bgp:refresh
