# Test: redistribute-l2tp -- L2TP route-change add event becomes a BGP UPDATE.
# VALIDATES: AC-6 -- with redistribute import l2tp configured, peer receives
#            UPDATE with /32 NLRI + NEXT_HOP=127.0.0.4 + origin=incomplete.
# VALIDATES: AC-1 -- IPCP-up emits (l2tp, route-change) batch (fakel2tp
#            drives the same typed handle the real observer uses).
# PREVENTS: L2TP route-change events not reaching the orchestrator, or
#           auto-load regression silently dropping the redistribution path.

# ze-peer expectations
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
# UPDATE for 10.0.0.1/32 with NEXT_HOP=127.0.0.4 (ze's OWN address on this
# session, which is what `nhop self` resolves to -- not the peer's 127.0.0.1).
# The wire expectation is what makes ze-peer bind and check: ORIGIN incomplete,
# empty AS_PATH (iBGP), NEXT_HOP 127.0.0.4, LOCAL_PREF 100, NLRI 10.0.0.1/32.
# LOCAL_PREF is well-known mandatory on an iBGP session (RFC 4271 5.1.5); the
# reactor emits it at reactor_api_batch.go buildWireModeUpdate.
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00310200000015400101024002004003047F00000440050400000064200A000001
expect=json:conn=1:seq=1:json={"meta":{"version":"1.0.0","format":"ze-bgp"},"message":{"type":"update"},"peer":{"address":"127.0.0.1","remote":{"as":65533}},"direction":"in","origin":"incomplete","local-preference":100,"ipv4/unicast":[{"action":"add","nlri":["10.0.0.1/32"],"next-hop":"127.0.0.4"}]}
EOF_PEER

# Python observer plugin: drive `fakel2tp emit add` via dispatch-command, then exit.
tmpfs=l2tp-announce-test.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
from ze_api import API, runtime_fail, result_json_data


def dispatch(api, command):
    return api._call_engine('ze-plugin-engine:dispatch-command', {'command': command}) or {}


def peer_field(api, field, default):
    result = dispatch(api, 'show bgp peer peer1 detail').get('result', {})
    if result.get('status') != 'done':
        return default
    data = result_json_data(result, {})
    return data.get('peers', {}).get('127.0.0.1', {}).get(field, default)


# // removes this conversion's own transient DEBUG-instrumented
# wait_peer helper. What remains is unused because main() below is
# dispatch-silent pending its sleep/wait conversion, NOT because of any engine
# defect -- see the note in main().
def wait_peer(api, predicate, what, cycles=100):
    for _ in range(cycles):
        if predicate():
            return
        api.wait_for_event(timeout=0.2)
    runtime_fail(f'timeout waiting for {what}')


def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()

    # There is NO engine defect here, and observer polling is innocent. An earlier
    # revision of this file claimed both, and was refuted on 2026-07-16.
    #
    # The real cause of "state=connecting indefinitely" was in the harness: this
    # file's peer block declared only expect=json, which ze-peer does not consume
    # (internal/test/peer/expect.go ConsumesLine), so ze-peer printed "no test data
    # available to test against" and exited BEFORE binding a listening socket. Every
    # ze dial then hit connection refused and backed off 5->10->20->40s, which looks
    # exactly like a poll-induced stall. Polling during the connect window is
    # provably harmless (spec-fixit-redistribute-establishment-stall, root cause and
    # evidence E6/E9). The wire expectation added above is what makes the peer bind.
    #
    # This observer stays dispatch-silent for one reason only: its sleep/wait
    # conversion has not been done. Nothing here is waiting on an engine fix. The
    # event window below is a delivery window, not a workaround, and the runner's
    # wire JSON expectation is what decides the verdict.
    for _ in range(10):
        api.wait_for_event(timeout=0.2)

    resp = dispatch(api, 'request fakel2tp emit add ipv4/unicast 10.0.0.1/32')
    result = resp.get('result', {})
    if result.get('status') != 'done':
        runtime_fail(f'request fakel2tp emit failed: {result}')
        return

    # Bounded delivery window (event-wait backoff): the runner's JSON
    # expectation gates the UPDATE content on the wire.
    for _ in range(10):
        api.wait_for_event(timeout=0.2)
    dispatch(api, 'request shutdown')
    api.wait_for_shutdown()


if __name__ == '__main__':
    main()
EOF_RUN

# ze configuration
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external l2tp-announce-test {
		run ./l2tp-announce-test.run
		encoder json
	}
	internal redistribute-orchestrator {
		use redistribute-orchestrator
	}
	internal fakel2tp {
		use fakel2tp
	}
}

redistribute {
	destination bgp {
		import l2tp {
			family [ ipv4/unicast ];
		}
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			# Ze's own address on this session, and what `nhop self` puts on the
			# wire. Deliberately NOT the peer's 127.0.0.1: RFC 4271 Section 5.1.3
			# forbids advertising a peer an address of that peer as NEXT_HOP.
			local {
				ip 127.0.0.4
				accept false
			}
		}
		session {
			asn {
				local 65533
				remote 65533
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		attach process redistribute-orchestrator {
			send [ update ]
		}
	}
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
# // expect=exit:code=0 removed -- this STRENGTHENS the test. Coverage
# is replaced by the ze-peer wire expectation above, which now governs the verdict.
# The exit-code line asserted nothing about BGP and, until 2026-07-16, actively
# disabled the peer check and validateJSON (spec-fixit-redistribute-establishment-stall, D2).
