# Test: redistribute-l2tp -- L2TP route-change add event becomes a BGP UPDATE.
# VALIDATES: AC-6 -- with redistribute import l2tp configured, peer receives
#            UPDATE with /32 NLRI + NEXT_HOP=127.0.0.4 + origin=incomplete.
# VALIDATES: AC-1 -- IPCP-up emits (l2tp, route-change) batch (fakel2tp
#            drives the same typed handle the real observer uses).
# PREVENTS: L2TP route-change events not reaching the orchestrator, or
#           auto-load regression silently dropping the redistribution path.

# ze-peer expectations
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
# UPDATE for 10.0.0.1/32 with NEXT_HOP=127.0.0.4 (ze's OWN address on this
# session, which is what `nhop self` resolves to -- not the peer's 127.0.0.1).
# The wire expectation is what makes ze-peer bind and check: ORIGIN incomplete,
# empty AS_PATH (iBGP), NEXT_HOP 127.0.0.4, LOCAL_PREF 100, NLRI 10.0.0.1/32.
# LOCAL_PREF is well-known mandatory on an iBGP session (RFC 4271 5.1.5); the
# reactor emits it at reactor_api_batch.go buildWireModeUpdate.
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00310200000015400101024002004003047F00000440050400000064200A000001
expect=json:conn=1:seq=1:json={"meta":{"version":"1.0.0","format":"ze-bgp"},"message":{"type":"update"},"peer":{"address":"127.0.0.1","remote":{"as":65533}},"direction":"in","origin":"incomplete","local-preference":100,"ipv4/unicast":[{"action":"add","nlri":["10.0.0.1/32"],"next-hop":"127.0.0.4"}]}
EOF_PEER

# ze configuration
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external l2tp-announce-test {
		run "ze-test fixture plugin/redistribute-l2tp-announce"
		encoder json
	}
	internal redistribute-orchestrator {
		use redistribute-orchestrator
	}
	internal fakel2tp {
		use fakel2tp
	}
}

redistribute {
	destination bgp {
		import l2tp {
			family [ ipv4/unicast ];
		}
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			# Ze's own address on this session, and what `nhop self` puts on the
			# wire. Deliberately NOT the peer's 127.0.0.1: RFC 4271 Section 5.1.3
			# forbids advertising a peer an address of that peer as NEXT_HOP.
			local {
				ip 127.0.0.4
				accept false
			}
		}
		session {
			asn {
				local 65533
				remote 65533
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		attach process redistribute-orchestrator {
			send [ update ]
		}
	}
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
# // expect=exit:code=0 removed -- this STRENGTHENS the test. Coverage
# is replaced by the ze-peer wire expectation above, which now governs the verdict.
# The exit-code line asserted nothing about BGP and, until 2026-07-16, actively
# disabled the peer check and validateJSON (spec-fixit-redistribute-establishment-stall, D2).
