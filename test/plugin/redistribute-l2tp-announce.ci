# Test: redistribute-l2tp -- L2TP route-change add event becomes a BGP UPDATE.
# VALIDATES: AC-6 -- with redistribute import l2tp configured, peer receives
#            UPDATE with /32 NLRI + NEXT_HOP=127.0.0.1 + origin=incomplete.
# VALIDATES: AC-1 -- IPCP-up emits (l2tp, route-change) batch (fakel2tp
#            drives the same typed handle the real observer uses).
# PREVENTS: L2TP route-change events not reaching the orchestrator, or
#           auto-load regression silently dropping the redistribution path.

# ze-peer expectations
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
# UPDATE for 10.0.0.1/32 with NEXT_HOP=127.0.0.1 (peer's local session address)
expect=json:conn=1:seq=1:json={"meta":{"version":"1.0.0","format":"ze-bgp"},"message":{"type":"update"},"peer":{"address":"127.0.0.1","remote":{"as":65533}},"direction":"in","origin":"incomplete","ipv4/unicast":[{"action":"add","nlri":["10.0.0.1/32"],"next-hop":"127.0.0.1"}]}
EOF_PEER

# Python observer plugin: drive `fakel2tp emit add` via dispatch-command, then exit.
tmpfs=l2tp-announce-test.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
from ze_api import API, runtime_fail, result_json_data


def dispatch(api, command):
    return api._call_engine('ze-plugin-engine:dispatch-command', {'command': command}) or {}


def peer_field(api, field, default):
    result = dispatch(api, 'show bgp peer peer1 detail').get('result', {})
    if result.get('status') != 'done':
        return default
    data = result_json_data(result, {})
    return data.get('peers', {}).get('127.0.0.1', {}).get(field, default)


# // test-relax: removes this conversion's own transient DEBUG-instrumented
# wait_peer helper (now unused -- main() below is dispatch-silent while the
# engine issue documented there stands; see spec-test-coverage-gaps W-2).
def wait_peer(api, predicate, what, cycles=100):
    for _ in range(cycles):
        if predicate():
            return
        api.wait_for_event(timeout=0.2)
    runtime_fail(f'timeout waiting for {what}')


def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()

    # // test-relax: KNOWN ENGINE ISSUE (tracked in spec-test-coverage-gaps,
    # W-2 findings): with `internal fakel2tp` + `redistribute import l2tp`
    # configured, ANY observer dispatch-command polling during the connect
    # phase keeps peer1 at state=connecting indefinitely (100 polls / 20s,
    # instrumented), while the poll-free flow establishes in ~1-2s. The
    # fakeas112 twins of this test tolerate identical polling, and the
    # no-import fakel2tp sibling (redistribute-l2tp-not-configured) also
    # polls fine, so the trigger is the import+fakel2tp composition. Until
    # fixed at source, this observer stays dispatch-silent before the emit
    # (subscribed-event windows only -- no time.sleep, no polling); the
    # runner's wire JSON expectation remains the test's gate, exactly as in
    # the original sleep-based version.
    for _ in range(10):
        api.wait_for_event(timeout=0.2)

    resp = dispatch(api, 'request fakel2tp emit add ipv4/unicast 10.0.0.1/32')
    result = resp.get('result', {})
    if result.get('status') != 'done':
        runtime_fail(f'request fakel2tp emit failed: {result}')
        return

    # Bounded delivery window (event-wait backoff): the runner's JSON
    # expectation gates the UPDATE content on the wire.
    for _ in range(10):
        api.wait_for_event(timeout=0.2)
    dispatch(api, 'request shutdown')
    api.wait_for_shutdown()


if __name__ == '__main__':
    main()
EOF_RUN

# ze configuration
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external l2tp-announce-test {
		run ./l2tp-announce-test.run
		encoder json
	}
	internal redistribute-orchestrator {
		use redistribute-orchestrator
	}
	internal fakel2tp {
		use fakel2tp
	}
}

redistribute {
	destination bgp {
		import l2tp {
			family [ ipv4/unicast ];
		}
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65533
				remote 65533
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
