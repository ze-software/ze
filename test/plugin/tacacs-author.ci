# Test: TACACS+ per-command authorization consumes PASS_ADD and FAIL replies.
# VALIDATES: AC-9 and AC-10.

option=env:var=ze.log.hub.infra:value=info
stdin=ze-conf:terminator=EOF_CONF
bgp {
	peer peer1 {
		connection { remote { ip 127.0.0.2; } local { ip 127.0.0.1; accept false; } }
		session { asn { local 65533; remote 65533; } }
	}
}
system {
	authentication {
		tacacs {
			server 127.0.0.1 { port $PORT; key "ze-mock-key"; }
			timeout 2
			authorization true
		}
		tacacs-profile 15 { profile [ admin ]; }
	}
	authorization {
		profile admin { run { default-action allow; } edit { default-action allow; } }
	}
}
environment { ssh { enabled true; server main { ip 127.0.0.1; port $PORT2; } } }
plugin {
	external tacacs-author-test {
		run "ze-test fixture plugin/tacacs-author $PORT $PORT2"
		encoder json
	}
}
EOF_CONF

cmd=foreground:seq=1:exec=ze -:stdin=ze-conf:timeout=25s
expect=exit:code=0
expect=stderr:pattern=tacacs-mock: AUTHOR cmd=\\"show bgp\\" reply=PASS_ADD
expect=stderr:pattern=tacacs-mock: AUTHOR cmd=\\"clear interface counters\\" reply=FAIL
expect=stderr:pattern=OK: 'clear interface counters' blocked
expect=stderr:pattern=OK: TACACS\+ refusal names access control
reject=stderr:pattern=ZE-OBSERVER-FAIL
