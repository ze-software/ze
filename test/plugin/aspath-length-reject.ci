# Test: as-path-length filter rejects routes with long AS paths
# VALIDATES: AC-9 -- as-path-length max rejects paths exceeding limit
# PREVENTS: as-path-length plugin not loaded, filter not dispatched
#
# Flow:
# 1. ze-peer sends UPDATE with 4-hop AS_PATH [65001 65002 65003 65004]
# 2. Filter chain calls bgp-filter-aspath-length:REJECT-LONG (max=3)
# 3. Plugin counts 4 hops > max 3, returns reject
# 4. Route is dropped

option=env:var=ze.log.bgp.filter.aspath-length:value=info

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
# UPDATE: ORIGIN=IGP, AS_PATH=AS_SEQ[65001 65002 65003 65004], NEXT_HOP=1.1.1.1, NLRI=10.0.0.0/24
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF003B02000000204001010040021202040000FDE90000FDEA0000FDEB0000FDEC40030401010101180A0000
EOF_PEER

tmpfs=test-aspath-len.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
"""Observer for as-path-length test: clean shutdown."""
from ze_api import API

def dispatch(api, command):
    resp = api._call_engine('ze-plugin-engine:dispatch-command', {'command': command})
    return (resp or {}).get('result', {})

def updates_received(api):
    r = dispatch(api, 'show bgp peer peer1 detail')
    return r.get('data', {}).get('peers', {}).get('127.0.0.1', {}).get('updates-received', 0)

def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()
    # Deterministic replacement for sleep(3.0): wait until ze has RECEIVED the
    # UPDATE from ze-peer, then quiesce so the filter decision (reject + Info log)
    # is fully drained before ze shuts down.
    for _ in range(100):
        if updates_received(api) >= 1:
            break
        api.wait_for_event(timeout=0.2)
    api.quiesce()
    dispatch(api, 'request shutdown')
    api.wait_for_shutdown()

if __name__ == '__main__':
    main()
EOF_RUN

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external test-aspath-len {
		run ./test-aspath-len.run
		encoder json
	}
}
bgp {
	policy {
		as-path-length REJECT-LONG {
			max 3
		}
	}

	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
		}

		filter {
			import [ as-path-length:REJECT-LONG ]
		}

		attach process test-aspath-len {
			receive [ update state ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze --plugin ze.bgp-filter-aspath-length --plugin ze.bgp-adj-rib-in -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
expect=stderr:pattern=as-path-length reject
expect=stderr:pattern=filter=REJECT-LONG
expect=stderr:pattern=length=4
