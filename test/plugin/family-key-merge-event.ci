# Test: an UPDATE that announces and withdraws in one family reaches a plugin
# with both operations under ONE key of that family.
# VALIDATES: ze-peer sends two UPDATEs. The first carries MP_REACH_NLRI ipv6
# unicast (next hop 2001:db8::1, 2001:db8::/32) and MP_UNREACH_NLRI ipv6 unicast
# (2001:db8:1::/48). The second carries body NLRI 10.0.0.0/8 (NEXT_HOP
# 192.0.2.1) and MP_UNREACH_NLRI ipv4 unicast (198.51.100.0/24). The JSON event
# the attached plugin receives states "ipv6/unicast" once, holding the add and
# then the del, and "ipv4/unicast" once, the same way. The fixture decodes the
# event into a map, as every map-based consumer does, prints one
# FAMILY-KEY-EVENT line per operation, and fails when a family lacks either.
# PREVENTS: the fast path writing a family as two keys, one per attribute: a
# map-based reader keeps only the last copy, so the announce of the same UPDATE
# vanished from the event.
# RFC 7606 Section 5.1: "Since older BGP speakers may not implement these
# restrictions, an implementation MUST still be prepared to receive these
# fields in any position or combination."

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
option=linger:value=true
option=asn:value=65001
# ORIGIN IGP, AS_PATH [65001],
# MP_REACH_NLRI AFI 2 SAFI 1 next hop 2001:db8::1 NLRI [32][2001:db8],
# MP_UNREACH_NLRI AFI 2 SAFI 1 withdrawn [48][2001:db8:1].
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF004E02000000374001010040020602010000FDE9800E1A0002011020010DB8000000000000000000000001002020010DB8800F0A0002013020010DB80001
# ORIGIN IGP, AS_PATH [65001], NEXT_HOP 192.0.2.1,
# MP_UNREACH_NLRI AFI 1 SAFI 1 withdrawn [24][198.51.100], NLRI [8][10].
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0037020000001E4001010040020602010000FDE9400304C0000201800F0700010118C63364080A
EOF_PEER

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external family-key-merge-event {
		run "le test fixture plugin/family-key-merge-event"
		encoder json
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
				ipv6/unicast { prefix { maximum 10000; } }
			}
		}
		behavior {
			group-updates disable
		}

		attach process family-key-merge-event {
			receive [ update-received ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=30s
expect=stderr:contains=FAMILY-KEY-EVENT: ipv6/unicast add 2001:db8::/32
expect=stderr:contains=FAMILY-KEY-EVENT: ipv6/unicast del 2001:db8:1::/48
expect=stderr:contains=FAMILY-KEY-EVENT: ipv4/unicast add 10.0.0.0/8
expect=stderr:contains=FAMILY-KEY-EVENT: ipv4/unicast del 198.51.100.0/24
