# Test: show metrics name <name> dispatches to the metrics-query handler
# Exercises: dispatch-command -> ze-show:metrics-query -> handleShowMetricsQuery
# Verifies the R9 rename `show metrics name <name>` (was `show metrics-query`)
# resolves to its handler end-to-end. The plugin harness has no Prometheus
# registry, so the handler returns "metrics not available"; with a registry the
# named form returns {metric, series, count} status=done. Either outcome proves
# the renamed command reaches its handler -- a broken rename would 404 / reach
# no handler. The happy-path metric filtering is unit-tested separately. Native.

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
option=asn:value=65001
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER


stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external metrics-name-show-test {
		run "ze-test fixture plugin/metrics-name-show"
		encoder json
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast {
					prefix {
						maximum 10000
					}
				}
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
