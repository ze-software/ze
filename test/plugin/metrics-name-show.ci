# Test: show metrics name <name> dispatches to the metrics-query handler
# Exercises: dispatch-command -> ze-show:metrics-query -> handleShowMetricsQuery
# Verifies the R9 rename `show metrics name <name>` (was `show metrics-query`)
# resolves to its handler end-to-end. The plugin harness has no Prometheus
# registry, so the handler returns "metrics not available"; with a registry the
# named form returns {metric, series, count} status=done. Either outcome proves
# the renamed command reaches its handler -- a broken rename would 404 / reach
# no handler. The happy-path metric filtering is unit-tested separately. Native.

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
option=asn:value=65001
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

tmpfs=show-metrics-name-test.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
import json
import sys
from ze_api import API, runtime_fail, result_text_data

def dispatch(api, command):
    resp = api._call_engine(
        'ze-plugin-engine:dispatch-command', {'command': command})
    if resp is None:
        return {'status': 'error', 'data': 'engine call returned None'}
    return resp.get('result', {})

def reached_handler(api, cmd):
    """Return 'done' or 'no-registry' if cmd routed to handleShowMetricsQuery;
    fail otherwise (a broken rename would not reach the handler)."""
    r = dispatch(api, cmd)
    status = r.get('status')
    blob = json.dumps(r)
    if status == 'done':
        data = result_text_data(r)
        if isinstance(data, str) and data:
            data = json.loads(data)
        if not isinstance(data, dict) or 'series' not in data or 'metric' not in data:
            runtime_fail(f'metrics-name: {cmd!r} done but bad shape {data!r}')
        return 'done'
    if status == 'error' and 'metrics not available' in blob:
        return 'no-registry'
    runtime_fail(f'metrics-name: {cmd!r} did not reach handler: {blob}')

def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()
    api.wait_for_post_startup(timeout=5.0)

    try:
        # Both the named and no-name forms must resolve to the handler.
        got = reached_handler(api, 'show metrics name go_goroutines')
        reached_handler(api, 'show metrics name')
        print(f'OK: show metrics name reaches handler ({got})', file=sys.stderr)
    finally:
        dispatch(api, 'request shutdown')
        api.wait_for_shutdown()

if __name__ == '__main__':
    main()
EOF_RUN

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external show-metrics-name-test {
		run ./show-metrics-name-test.run
		encoder json
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast {
					prefix {
						maximum 10000
					}
				}
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
