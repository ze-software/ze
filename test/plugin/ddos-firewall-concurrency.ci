# Test: command dispatch stays responsive while the firewall engine and the
# ddos-local responder drive the same nft backend under a sustained flood.
#
# VALIDATES: spec-fixit-firewall-concurrency-deadlock AC-3 -- with a
#            `firewall { backend nft }` block loaded AND ddos-local installing an
#            on-host drop under a flood, every `ze-plugin-engine:dispatch-command`
#            answers inside a bounded time. This is the shape that was observed to
#            wedge dispatch on 2026-07-12 and made test/plugin/ddos-direction.ci
#            drop its firewall block.
# VALIDATES: spec-fixit-firewall-concurrency-deadlock AC-4 end to end -- the
#            firewall engine's own table survives every ddos-local reconcile.
#            `show firewall ruleset fwconc` reads the KERNEL through
#            GetCounters (internal/plugins/firewall/nft/backend_linux.go), so it
#            answers `error: table "ze_fwconc" not found` if a concurrent apply
#            ever dropped that table. The unit test that proves the same property
#            (TestApplyAllConcurrentOwnersConverge) runs against a fake backend;
#            this is the same claim against a real kernel.
# PREVENTS:  the 2026-07-12 regression returning -- a firewall block plus a flood
#            making the daemon's management plane stop answering.
#
# WHAT MAKES THE PROBE SHARP. `show firewall ruleset` is the one show command that
# reaches the kernel on the dispatch goroutine: GetCounters calls ListTables,
# ListChainsOfTableFamily and GetRules on the SAME *nftables.Conn that
# Backend.Apply flushes, and Conn.Flush holds Conn.mu across dial, SendMessages
# and the whole ack-receive loop (vendor/github.com/google/nftables/conn.go).
# A dispatch of this command therefore waits out whatever the in-flight reconcile
# is doing. That is the coupling this spec exists to bound, so the test dispatches
# it continuously rather than once.
#
# HOW A STALL IS DIAGNOSED, not merely detected. The dispatcher thread publishes
# the command it is inside and when it entered; a watchdog thread sends SIGQUIT to
# the daemon once any single dispatch passes STALL_SIGQUIT seconds. ze installs no
# SIGQUIT handler, so the Go runtime dumps every goroutine stack to the daemon's
# stderr, which the runner reports. A failure of this test therefore carries the
# blocked stacks that AC-1 asks for, instead of only a timeout.
#
# STATUS: option=needs-linux:caps=net-admin,bpf. Full daemon path on the QEMU VM
#   via an in-daemon observer plugin (ze_api handshake), same harness as
#   test/plugin/ddos-direction.ci.

# Two capability families, for the same reasons ddos-direction.ci states in full:
#   - bpf (CAP_BPF + CAP_SYS_RESOURCE): traffic-usage calls rlimit.RemoveMemlock()
#     then link.AttachTCX() (internal/plugins/trafficusage/attach_linux.go).
#     Without it eBPF accounting runs inert and no attack is ever detected.
#   - net-admin: the nft backend programs kernel tables, and AttachTCX programs
#     the interface's tc hooks.
# Declaring only one fails OPEN: a host holding that one passes the gate and the
# test fails exactly as it would with no marker at all.
option=needs-linux:caps=net-admin,bpf
# Every ddos test floods the SAME loopback interface and the detector picks the
# victim by top-destination-bytes over that interface's counters, so a sibling's
# concurrent flood is indistinguishable from this test's own. Rationale in full:
# test/plugin/ddos-direction.ci.
option=exclusive:group=ddos-flood
option=env:var=ze.log.ddos.detect:value=info
option=env:var=ze.log.ddos.local:value=info
option=env:var=ze.log.firewall:value=info
option=timeout:value=170s

tmpfs=ddos-firewall-concurrency-probe.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
"""Flood a loopback victim with a firewall block loaded; assert dispatch stays bounded.

One thread owns the engine connection and dispatches; one thread floods; one
thread watches for a stalled dispatch and SIGQUITs the daemon so its goroutine
stacks reach the log. The API object is touched by the dispatcher thread only.
"""
import json
import os
import signal
import socket
import sys
import threading
import time

from ze_api import API, result_text_data, runtime_fail

# Unique per test: the ddos plugin-suite tests share ONE network namespace, so a
# victim/sink pair reused by a sibling makes the second binder die EADDRINUSE and
# two detectors resolve the same target. Allocation table in
# test/plugin/ddos-bps-amplification.ci.
VICTIM = "127.0.0.8"
DPORT = 9999
PAYLOAD = b"x" * 64

# The table the firewall {} block below owns. Written bare here and prefixed in
# the kernel (firewall.tableNamePrefix), which is what `show firewall ruleset`
# takes: it strips the prefix before matching (cmd_show.go).
FW_TABLE = "fwconc"

# AC-3's bound. A reconcile of a handful of rules on loopback is a few
# milliseconds, and the netlink deadline that bounds a WEDGED dataplane is 10s
# (internal/plugins/firewall/nft/deadline_linux.go), so 3s sits above every
# healthy reconcile and below every bounded-failure one. The observed maximum is
# printed on the passing path so a later session can see the margin rather than
# guess at it.
DISPATCH_BOUND = 3.0

# When a single dispatch passes this, the daemon is dumped rather than waited on.
# Well above DISPATCH_BOUND so the SIGQUIT is a diagnosis of a real hang and not
# a second copy of the same assertion.
STALL_SIGQUIT = 20.0

# How long the flood may run before the drop must be installed. ddos-direction.ci
# allows 45s to reach the incident with the same detector settings on the same
# interface; 60s here because this probe also spends its loop on three dispatches
# per pass. Measured install: 2.1s after the daemon reported configured.
INSTALL_BUDGET = 60.0
# How long dispatch keeps being exercised after the drop is installed, so the
# bound is asserted over a window rather than at one instant.
SOAK_SECONDS = 12.0

state = {
    "inflight": None,      # (command, entered_monotonic) while a dispatch is open
    "max_latency": 0.0,
    "max_command": "",
    "calls": 0,
    "local": None,         # last `show ddos local` payload
    "ruleset_error": None, # first `show firewall ruleset` failure seen
    "fatal": None,
    "stop": False,
    "quit_sent": False,
}
lock = threading.Lock()


def daemon_pid():
    """The ze process this plugin was forked from.

    External plugins are started as `/bin/sh -c <run>`
    (internal/component/plugin/process/process.go), and whether that shell execs
    or forks is the shell's choice, so the parent is not reliably ze. Climb the
    PPid chain instead and take the first process named ze.
    """
    pid = os.getppid()
    for _ in range(6):
        if pid <= 1:
            break
        try:
            with open(f"/proc/{pid}/comm") as fh:
                if fh.read().strip() == "ze":
                    return pid
            with open(f"/proc/{pid}/stat") as fh:
                pid = int(fh.read().split(") ", 1)[1].split()[1])
        except OSError:
            break
    return None


def watchdog():
    """SIGQUIT the daemon when one dispatch outlives STALL_SIGQUIT.

    ze installs no SIGQUIT handler, so the Go runtime writes every goroutine
    stack to stderr and exits. The blocked read in the dispatcher then fails with
    EOF and the test reports the stall with the stacks beside it.
    """
    while not state["stop"]:
        with lock:
            pending = state["inflight"]
        if pending is not None:
            command, entered = pending
            waited = time.monotonic() - entered
            if waited > STALL_SIGQUIT and not state["quit_sent"]:
                state["quit_sent"] = True
                pid = daemon_pid()
                print(f"STALLED: dispatch {command!r} has been open for {waited:.1f}s; "
                      f"sending SIGQUIT to ze (pid={pid}) for a goroutine dump",
                      file=sys.stderr, flush=True)
                if pid is not None:
                    try:
                        os.kill(pid, signal.SIGQUIT)
                    except OSError as exc:
                        print(f"STALLED: SIGQUIT failed: {exc}", file=sys.stderr, flush=True)
                return
        time.sleep(0.2)


def flooder(sock):
    """Send until told to stop. Never touches the API object.

    An OSError is swallowed: main closes the socket once the assertions are done,
    and this thread can be mid-batch when it does. The count is what the failure
    messages quote, so it counts SENDS rather than attempts.
    """
    sent = 0
    while not state["stop"]:
        for _ in range(2000):
            try:
                sock.sendto(PAYLOAD, (VICTIM, DPORT))
                sent += 1
            except OSError:
                pass
        state["sent"] = sent


def dispatch(api, command):
    """One dispatch-command round trip, timed, with the watchdog told about it."""
    entered = time.monotonic()
    with lock:
        state["inflight"] = (command, entered)
    try:
        resp = api._call_engine("ze-plugin-engine:dispatch-command", {"command": command})
    finally:
        waited = time.monotonic() - entered
        with lock:
            state["inflight"] = None
            state["calls"] += 1
            if waited > state["max_latency"]:
                state["max_latency"] = waited
                state["max_command"] = command
    if waited > DISPATCH_BOUND and state["fatal"] is None:
        state["fatal"] = (f"dispatch {command!r} took {waited:.2f}s, over the {DISPATCH_BOUND}s "
                          f"bound, while ddos-local mitigated under a flood with a firewall "
                          f"block loaded")
    if resp is None:
        return {"status": "error", "data": "engine call returned None"}
    return resp.get("result", {})


def payload(result):
    data = result_text_data(result)
    if isinstance(data, str) and data:
        data = json.loads(data)
    return data if isinstance(data, dict) else {}


def probe_round(api):
    """Dispatch the three commands once and record what they said."""
    state["local"] = payload(dispatch(api, "show ddos local"))
    dispatch(api, "show ddos incidents")
    ruleset = dispatch(api, f"show firewall ruleset {FW_TABLE}")
    if ruleset.get("status") != "done" and state["ruleset_error"] is None:
        # The firewall engine's table is gone from the kernel, or the backend
        # answered an error: either way a ddos-local reconcile has taken the
        # other owner's table with it, which is the lost update D-1 forbids.
        state["ruleset_error"] = (f"show firewall ruleset {FW_TABLE}: status="
                                  f"{ruleset.get('status')} data={ruleset.get('data')}")
    return payload(ruleset)


def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()
    api.wait_for_post_startup(timeout=10.0)

    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    # Bind a sink on the victim port so the flood is absorbed and no ICMP
    # port-unreachable backscatter makes trafficusage mis-resolve the victim.
    sink = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    sink.bind((VICTIM, DPORT))
    sink.setblocking(False)

    threading.Thread(target=watchdog, daemon=True).start()
    threading.Thread(target=flooder, args=(sock,), daemon=True).start()

    # The firewall block's own table must be in the kernel before the flood
    # matters: it is the control for the AC-4 assertion below. Without this a
    # ruleset error later could mean "never applied" rather than "lost".
    first = None
    control_deadline = time.monotonic() + 20.0
    while time.monotonic() < control_deadline:
        first = probe_round(api)
        if state["ruleset_error"] is None and first.get("table") == FW_TABLE:
            break
        state["ruleset_error"] = None
    if first is None or first.get("table") != FW_TABLE:
        state["stop"] = True
        runtime_fail(f"CONTROL: the firewall block's table {FW_TABLE!r} never reached the "
                     f"kernel, so this test could not have detected losing it: {first}")
    print(f"CONTROL: {FW_TABLE} applied and readable from the kernel before the flood",
          file=sys.stderr, flush=True)

    # --- the drop must install while the firewall block owns its own table ---
    install_deadline = time.monotonic() + INSTALL_BUDGET
    while time.monotonic() < install_deadline:
        probe_round(api)
        if state["fatal"] or state["ruleset_error"]:
            break
        if (state["local"] or {}).get("active") is True:
            break

    if state["fatal"] is None and state["ruleset_error"] is None:
        if (state["local"] or {}).get("active") is not True:
            state["fatal"] = (f"ddos-local never installed a drop for {VICTIM} within "
                              f"{INSTALL_BUDGET}s (sent {state.get('sent', 0)} packets, "
                              f"last show ddos local={state['local']})")

    # --- soak: keep dispatching while the mitigation is live and the flood runs ---
    if state["fatal"] is None and state["ruleset_error"] is None:
        soak_deadline = time.monotonic() + SOAK_SECONDS
        while time.monotonic() < soak_deadline:
            probe_round(api)
            if state["fatal"] or state["ruleset_error"]:
                break

    state["stop"] = True
    sock.close()
    sink.close()

    if state["ruleset_error"]:
        runtime_fail(f"the firewall engine's table did not survive a concurrent ddos-local "
                     f"reconcile: {state['ruleset_error']}")
    if state["fatal"]:
        runtime_fail(state["fatal"])

    # Every marker goes to stderr. A plugin talks to the engine on fds 3 and 4
    # (ze_api.API), and the daemon relays only its stderr into the log the runner
    # reads, so a print to stdout reaches no expectation and no reader.
    print(f"DISPATCH-BOUNDED max={state['max_latency']:.3f}s calls={state['calls']} "
          f"slowest-command={state['max_command']!r} bound={DISPATCH_BOUND}s",
          file=sys.stderr, flush=True)
    print(f"DROP-INSTALLED {VICTIM}", file=sys.stderr, flush=True)
    print(f"FIREWALL-TABLE-INTACT {FW_TABLE}", file=sys.stderr, flush=True)

    dispatch(api, "request shutdown")
    api.wait_for_shutdown()


if __name__ == "__main__":
    main()
EOF_RUN

stdin=ze-bgp:terminator=EOF_CONF
firewall {
	backend nft;
	table fwconc {
		family inet;
		chain input {
			type filter;
			hook input;
			priority 0;
			policy accept;
			term allow-ssh {
				from {
					destination-port 22;
				}
				then {
					accept;
				}
			}
		}
	}
}

ddos {
	detect {
		enabled true
		absolute-floor 1000
		confirm-duration 1
		startup-grace 0
		baseline-window 10
		check-interval 1
		characterize-enable false
	}
	observe {
		incident-ring-size 100
	}
	local {
		response-level enforce
	}
}

traffic {
	usage {
		enabled true
		track-ip true
		interfaces {
			interface lo {
				enabled true
			}
		}
	}
}

plugin {
	external ddos-firewall-concurrency-probe {
		run ./ddos-firewall-concurrency-probe.run
		encoder json
	}
}
EOF_CONF

cmd=foreground:seq=1:exec=ze -:stdin=ze-bgp:timeout=165s
expect=exit:code=0
expect=stderr:contains=CONTROL: fwconc applied and readable from the kernel before the flood
expect=stderr:contains=DISPATCH-BOUNDED
expect=stderr:contains=DROP-INSTALLED 127.0.0.8
expect=stderr:contains=FIREWALL-TABLE-INTACT fwconc
expect=stderr:contains=ddos-local: drop rule installed
expect=stderr:contains=hook=ingress
