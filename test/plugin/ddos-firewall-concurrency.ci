# Test: command dispatch stays responsive while the firewall engine and the
# ddos-local responder drive the same nft backend under a sustained flood.
#
# VALIDATES: spec-fixit-firewall-concurrency-deadlock AC-3 -- with a
#            `firewall { backend nft }` block loaded AND ddos-local installing an
#            on-host drop under a flood, every `ze-plugin-engine:dispatch-command`
#            answers inside a bounded time. This is the shape that was observed to
#            wedge dispatch on 2026-07-12 and made test/plugin/ddos-direction.ci
#            drop its firewall block.
# VALIDATES: spec-fixit-firewall-concurrency-deadlock AC-4 end to end -- the
#            firewall engine's own table survives every ddos-local reconcile.
#            `show firewall ruleset fwconc` reads the KERNEL through
#            GetCounters (internal/plugins/firewall/nft/backend_linux.go), so it
#            answers `error: table "ze_fwconc" not found` if a concurrent apply
#            ever dropped that table. The unit test that proves the same property
#            (TestApplyAllConcurrentOwnersConverge) runs against a fake backend;
#            this is the same claim against a real kernel.
# PREVENTS:  the 2026-07-12 regression returning -- a firewall block plus a flood
#            making the daemon's management plane stop answering.
#
# WHAT MAKES THE PROBE SHARP. `show firewall ruleset` is the one show command that
# reaches the kernel on the dispatch goroutine: GetCounters calls ListTables,
# ListChainsOfTableFamily and GetRules on the SAME *nftables.Conn that
# Backend.Apply flushes, and Conn.Flush holds Conn.mu across dial, SendMessages
# and the whole ack-receive loop (vendor/github.com/google/nftables/conn.go).
# A dispatch of this command therefore waits out whatever the in-flight reconcile
# is doing. That is the coupling this spec exists to bound, so the test dispatches
# it continuously rather than once.
#
# HOW A STALL IS DIAGNOSED, not merely detected. The dispatcher thread publishes
# the command it is inside and when it entered; a watchdog thread sends SIGQUIT to
# the daemon once any single dispatch passes STALL_SIGQUIT seconds. ze installs no
# SIGQUIT handler, so the Go runtime dumps every goroutine stack to the daemon's
# stderr, which the runner reports. A failure of this test therefore carries the
# blocked stacks that AC-1 asks for, instead of only a timeout.
#
# STATUS: option=needs-linux:caps=net-admin,bpf. Full daemon path on the QEMU VM
#   via an in-daemon observer plugin (ze_api handshake), same harness as
#   test/plugin/ddos-direction.ci.

# Two capability families, for the same reasons ddos-direction.ci states in full:
#   - bpf (CAP_BPF + CAP_SYS_RESOURCE): traffic-usage calls rlimit.RemoveMemlock()
#     then link.AttachTCX() (internal/plugins/trafficusage/attach_linux.go).
#     Without it eBPF accounting runs inert and no attack is ever detected.
#   - net-admin: the nft backend programs kernel tables, and AttachTCX programs
#     the interface's tc hooks.
# Declaring only one fails OPEN: a host holding that one passes the gate and the
# test fails exactly as it would with no marker at all.
option=needs-linux:caps=net-admin,bpf
# Every ddos test floods the SAME loopback interface and the detector picks the
# victim by top-destination-bytes over that interface's counters, so a sibling's
# concurrent flood is indistinguishable from this test's own. Rationale in full:
# test/plugin/ddos-direction.ci.
option=exclusive:group=ddos-flood
option=env:var=ze.log.ddos.detect:value=info
option=env:var=ze.log.ddos.local:value=info
option=env:var=ze.log.firewall:value=info
option=timeout:value=170s


stdin=ze-bgp:terminator=EOF_CONF
firewall {
	backend nft;
	table fwconc {
		family inet;
		chain input {
			type filter;
			hook input;
			priority 0;
			policy accept;
			term allow-ssh {
				from {
					destination-port 22;
				}
				then {
					accept;
				}
			}
		}
	}
}

ddos {
	detect {
		enabled true
		absolute-floor 1000
		confirm-duration 1
		startup-grace 0
		baseline-window 10
		check-interval 1
		characterize-enable false
	}
	observe {
		incident-ring-size 100
	}
	local {
		response-level enforce
	}
}

traffic {
	usage {
		enabled true
		track-ip true
		interfaces {
			interface lo {
				enabled true
			}
		}
	}
}

plugin {
	external ddos-firewall-concurrency-probe {
		run "ze-test fixture plugin/ddos-firewall-concurrency"
		encoder json
	}
}
EOF_CONF

cmd=foreground:seq=1:exec=ze -:stdin=ze-bgp:timeout=165s
expect=exit:code=0
expect=stderr:contains=CONTROL: fwconc applied and readable from the kernel before the flood
expect=stderr:contains=DISPATCH-BOUNDED
expect=stderr:contains=DROP-INSTALLED 127.0.0.8
expect=stderr:contains=FIREWALL-TABLE-INTACT fwconc
expect=stderr:contains=ddos-local: drop rule installed
expect=stderr:contains=hook=ingress
