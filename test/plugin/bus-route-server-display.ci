# Test: a route server serving three established clients appears once as a registered sender in `| implied | json` and `show event delivery | json`, listing all three clients.
# QUESTION: with `bgp-rs` loaded and nothing written under its `bus` block, and three
# route server clients `c1`, `c2`, `c3` (`rs-client true;`) established over real TCP,
# does `/bgp/route-server` appear as EXACTLY ONE `bgp:update` send entry with
# `origin: "registered"` listing `/bgp/peer/c1`, `/bgp/peer/c2`, and `/bgp/peer/c3` in
# both `show config running | implied | json` and `show event delivery | json` (not
# three per-peer copies)? A unit test cannot decide this because the path spans live
# `bgp-rs` registration under `/bgp/route-server`, three real established BGP sessions,
# and live `DeliveryGraph.InspectEdges` + `show config running | implied | json`.
#
# VALIDATES: spec-explicit-plugin-and-attach-config S29 / AC-37.
# PREVENTS: per-client duplicate rows for registered multi-destination senders in
# `| implied` or `show event delivery`.

option=timeout:value=90s
option=env:var=ZE_CONFIG_DIR:value=.
option=env:var=XDG_DATA_HOME:value=.
option=env:var=ze.ssh.password:value=testpass

stdin=init-answers:terminator=EOF_INIT
admin
testpass
127.0.0.1
$PORT2
EOF_INIT

stdin=peer-c1:terminator=EOF_C1
option=tcp_connections:value=1
option=timeout:value=60s
option=asn:value=65001
option=linger:value=true
option=established-file:path=c1.up
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_C1

stdin=peer-c2:terminator=EOF_C2
option=tcp_connections:value=1
option=timeout:value=60s
option=asn:value=65002
option=linger:value=true
option=established-file:path=c2.up
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_C2

stdin=peer-c3:terminator=EOF_C3
option=tcp_connections:value=1
option=timeout:value=60s
option=asn:value=65003
option=linger:value=true
option=established-file:path=c3.up
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_C3

tmpfs=running.conf:terminator=EOF_CONF
system {
	authentication {
		# bcrypt cost-4 hash of "testpass".
		user admin {
			password "$2a$04$UlwuiuH82Unfsq.XEMPGJeDkXwbm3KW.nvVaVXOd/JeFK8VjMjrQO"
		}
	}
}
environment {
	ssh {
		enabled true
		server main {
			ip 127.0.0.1;
			port $PORT2;
		}
	}
}
bus {
	endpoint bgp-rs {
		internal bgp-rs;
	}
}
bgp {
	filter {
		import { final accept; }
		export { final accept; }
	}
	peer c1 {
		connection {
			remote { ip 127.0.0.2; }
			local { ip 127.0.0.1; accept false; }
		}
		session {
			asn { local 65000; remote 65001; }
			router-id 1.2.3.4;
			rs-client true;
			family { ipv4/unicast { prefix { maximum 10000; } } }
			capability { graceful-restart disable; }
		}
		behavior { group-updates disable; }
	}
	peer c2 {
		connection {
			remote { ip 127.0.0.3; }
			local { ip 127.0.0.1; accept false; }
		}
		session {
			asn { local 65000; remote 65002; }
			router-id 1.2.3.4;
			rs-client true;
			family { ipv4/unicast { prefix { maximum 10000; } } }
			capability { graceful-restart disable; }
		}
		behavior { group-updates disable; }
	}
	peer c3 {
		connection {
			remote { ip 127.0.0.4; }
			local { ip 127.0.0.1; accept false; }
		}
		session {
			asn { local 65000; remote 65003; }
			router-id 1.2.3.4;
			rs-client true;
			family { ipv4/unicast { prefix { maximum 10000; } } }
			capability { graceful-restart disable; }
		}
		behavior { group-updates disable; }
	}
}
EOF_CONF

cmd=foreground:seq=1:exec=ze init:stdin=init-answers:exit=0
cmd=background:seq=2:name=peer-c1:exec=le test peer --bind 127.0.0.2 --port $PORT:stdin=peer-c1
cmd=background:seq=3:name=peer-c2:exec=le test peer --bind 127.0.0.3 --port $PORT:stdin=peer-c2
cmd=background:seq=4:name=peer-c3:exec=le test peer --bind 127.0.0.4 --port $PORT:stdin=peer-c3
cmd=background:seq=5:name=daemon:exec=ze start running.conf:ready=Ze running.
reject=stderr:pattern=ZE-OBSERVER-FAIL
reject=stderr:pattern=panic

cmd=foreground:seq=6:exec=le test fixture plugin/bus-wait-file c1.up:exit=0
cmd=foreground:seq=7:exec=le test fixture plugin/bus-wait-file c2.up:exit=0
cmd=foreground:seq=8:exec=le test fixture plugin/bus-wait-file c3.up:exit=0

cmd=foreground:seq=9:exec=le test fixture plugin/bus-assert-implied rs-display /bgp/peer/c1 /bgp/peer/c2 /bgp/peer/c3:exit=0
expect=stdout:contains=OK: rs-display verified single /bgp/route-server bgp:update entry listing all clients

cmd=stop:seq=10:name=daemon:signal=term
cmd=stop:seq=11:name=peer-c1
cmd=stop:seq=12:name=peer-c2
cmd=stop:seq=13:name=peer-c3
