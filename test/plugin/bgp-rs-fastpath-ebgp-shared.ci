# bgp-rs-fastpath-ebgp-shared -- eBGP prepend with byte-equality (rs-fastpath-3)
#
# VALIDATES: AC-6b -- eBGP source peer goes through bgp-rs forwarding via the
# Plugin.ForwardCached fast path; the receiver gets the UPDATE with local AS
# 65000 prepended to AS_PATH. Deep byte-equality assertion confirms exact wire
# content, not just wiring.
#
# PREVENTS: silent regression where the fast path is not engaged for eBGP
# forwarding, or where AS_PATH prepend produces incorrect wire bytes.
#
# Two eBGP peers: source (65001) sends one UPDATE with empty AS_PATH,
# receiver (65002) must get the forwarded UPDATE with AS_PATH=[65000].
# Peers use different loopback IPs to avoid duplicate peer key collision.
#
# NO LOCAL_PREF: this test's UPDATE is sourced from an EBGP peer, and RFC 4271
# Section 5.1.5 forbids LOCAL_PREF in UPDATEs sent to external peers. An earlier
# revision of this file put LOCAL_PREF=100 in the source frame, which is invalid
# input on an EBGP session: ze correctly applies RFC 7606 Section 7.5
# ("LOCAL_PREF from an external neighbor must be discarded",
# message/rfc7606.go) and overwrites it in place with an ATTR_TOMBSTONE
# marker (message/attr_discard.go, applyInPlace), so the receiver saw
# C0FC0405010000 (ATTR_TOMBSTONE, code 252 = 0xFC per attribute.AttrTombstone,
# orig code 5, reason 1 = EBGP-invalid) where the
# expectation demanded 40050400000064. That was correct product behavior on an
# invalid frame, not a fastpath bug -- so the fix is to make the input valid
# rather than to bless the marker in the expectation. LOCAL_PREF was incidental
# filler here; AS_PATH prepend is what this test validates, and it is unaffected.

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=2
option=timeout:value=15s
option=bind:value=0.0.0.0
# Map conn=N to a peer by remote IP instead of accept order (peer_connmap.go).
# Without this, conn=N binds to ACCEPT ORDER, and which RS client connects first
# is a race: the receiver was observed arriving as conn=1 in 5/5 runs, so the
# source's UPDATE was sent to the receiver and no forwarding could occur. It also
# handshakes the whole batch before running any conn's script, so both RS clients
# are established simultaneously (check-mode accept is otherwise sequential:
# peer.go:265-267) -- which is what makes the announce below reachable at all.
option=conn_map:value=remote-ip

# Source peer (conn=1): send one UPDATE with NLRI 10.0.0.0/24.
# ORIGIN=IGP, AS_PATH=empty, NEXT_HOP=1.1.1.1 (no LOCAL_PREF -- EBGP source, see above)
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0029020000000E4001010040020040030401010101180A0000

# Receiver peer (conn=2): expect the forwarded UPDATE with exact byte content.
# RS prepends local AS 65000 (0x0000FDE8) to the empty AS_PATH, producing
# AS_PATH=AS_SEQUENCE[65000]. All other attributes preserved as-is.
#
# Expected UPDATE breakdown:
#   Marker:    FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF (16 bytes)
#   Length:    002F (47 bytes)
#   Type:      02 (UPDATE)
#   WdLen:     0000 (no withdrawals)
#   AttrLen:   0014 (20 bytes)
#   ORIGIN:    40010100 (IGP)
#   AS_PATH:   40020602010000FDE8 (AS_SEQUENCE[65000])
#   NEXT_HOP:  40030401010101 (1.1.1.1)
#   NLRI:      180A0000 (10.0.0.0/24)
# NOTE: exact hex= match is intentional (not contains=). This is the byte-equality
# assertion that verifies the RS produces correct wire bytes, not just wiring.
# If attribute ordering changes, update the expected hex to match.
#
# The SOURCE's own EOR (conn=1). RFC 4724 Section 4.1 (rfc/full/rfc4724.txt:303):
# the EOR MUST be sent once the initial routing update completes -- and the RFC
# constrains no ordering against routes learned AFTER it. The receiver's EOR is
# therefore NOT asserted on the wire: under load the forwarded route can reach
# conn=2 before conn=2's own EOR (RFC-conformant), and pinning the EOR at
# conn=2:seq=1 turned that permitted ordering into a flake -- the forward hits the
# still-pending EOR rule. Same conclusion as bgp-rs-asn4-transcode.ci and
# bgp-rs-reactor-fastpath.ci. That both EORs ARE sent (the RFC MUST) is still
# enforced by run_rs_observer(expected_peers=2), which fails closed if either is
# missing; conn=1's EOR (no forward races it) stays as a direct wire assertion.
expect=bgp:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
expect=bgp:conn=2:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002F02000000144001010040020602010000FDE840030401010101180A0000
EOF_PEER

# Observer: shut down cleanly after forwarding completes.
tmpfs=shutdown-after-up.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
# // the observer's synchronous `show bgp summary` eor-sent poll +
# `request shutdown` is replaced by ze_api.run_rs_observer -- event-driven readiness
# (subscribe + wait_for_event on the async channel) plus a fire-and-forget shutdown.
# A more robust rewrite, not a relaxation: same "wait until the RS replayed to every
# peer" semantics, no expect/action/reject assertion removed. The old poll's dispatch
# RPC could stall ~30s under load and strand the shutdown until ze was killed.
from ze_api import API

API().run_rs_observer(expected_peers=2, forward_prefix="10.0.0.0/24")
EOF_RUN

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	internal rs {
		use bgp-rs
	}
	external shutdown-after-up {
		run ./shutdown-after-up.run
		encoder json
	}
}
bgp {
	peer source-peer {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
			rs-fast-path enable
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
		attach process shutdown-after-up {
			receive [ update ]
		}
	}
	peer receiver-peer {
		connection {
			remote {
				ip 127.0.0.2
			}
			local {
				ip 127.0.0.2
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65002
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
			rs-fast-path enable
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
		attach process shutdown-after-up {
			receive [ update ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
reject=stderr:pattern=panic
reject=stderr:pattern=fatal error
reject=stderr:pattern=cache .* forward
reject=stderr:pattern=forward-cached failed
reject=stderr:pattern=release-cached failed
reject=stderr:pattern=BUG: ForwardUpdatesDirect
