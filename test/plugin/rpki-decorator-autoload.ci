# Test: rpki-decorator auto-loaded when consumer subscribes to update-rpki
# VALIDATES: AC-6: Decorator auto-loaded when config references update-rpki event type
# PREVENTS: Consumers forced to explicitly configure decorator plugin

# ze-peer: send one route
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=linger:value=true
option=timeout:value=20s
option=update:value=send-route:prefix=10.0.0.0/24:origin-as=65001:next-hop=10.0.0.1
# EOR from ze
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# native test plugin: subscribes to update-rpki, verifies decorator was auto-loaded
# Native compiled fixture: plugin/rpki-decorator-autoload
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	hub {
		server local {
			ip 127.0.0.1;
			port 0;
			secret rpki-autoload-test-secret-0123456789abcdef;
		}
	}
	# NOTE: No explicit rpki, rpki-decorator, or adj-rib-in plugins!
	# The engine should auto-load bgp-rpki-decorator (and its dependency bgp-rpki)
	# because rpki-auto-test has receive [ update-rpki ].
	external rpki-auto-test {
		run "ze-test fixture plugin/rpki-decorator-autoload"
		encoder json
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}

		attach process rpki-auto-test {
			receive [ update-rpki ]
		}
		attach process bgp-rpki {
			receive [ update-received ]
		}
		attach process bgp-rpki-decorator {
			receive [ update-received rpki ]
		}
	}
}
EOF_CONF

# No RTR mock -- decorator will timeout and emit UPDATE without rpki section
cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
