# Test: explicit bus endpoint for bgp-rpki-decorator pulls bgp-rpki via
# dependencies and delivers update-rpki events to a consumer (Q-11 option (c)).
# VALIDATES: explicit bgp-rpki-decorator endpoint loads its bgp-rpki dependency
# and correlates peer UPDATEs into bgp:update-rpki events on the bus.
# PREVENTS: missing dependency auto-load or broken update-rpki delivery when
# bgp-rpki-decorator is declared explicitly without manual bgp-rpki wiring.

# ze-peer: send one route
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=linger:value=true
option=timeout:value=20s
option=update:value=send-route:prefix=10.0.0.0/24:origin-as=65001:next-hop=10.0.0.1
# EOR from ze
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# native test plugin: subscribes to update-rpki, verifies decorator was auto-loaded
# Native compiled fixture: plugin/rpki-decorator-autoload
stdin=ze-bgp:terminator=EOF_CONF
bus {
	hub {
		server local {
			ip 127.0.0.1;
			port 0;
			secret rpki-autoload-test-secret-0123456789abcdef;
		}
	}
	# Per Q-11 option (c), bgp-rpki-decorator is declared explicitly and pulls
	# its dependency bgp-rpki (and bgp-adj-rib-in) via registered Dependencies.
	endpoint rpki-decorator {
		internal bgp-rpki-decorator;
	}
	endpoint rpki-auto-test {
		external {
			run "le test fixture plugin/rpki-decorator-autoload";
		}
		encoding json;
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

# No RTR mock -- decorator will timeout and emit UPDATE without rpki section
cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
