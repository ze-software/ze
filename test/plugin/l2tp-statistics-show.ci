# Test: `show l2tp statistics` reports tunnels-active and
#       sessions-active counters after a real handshake.
#
# VALIDATES: spec-l2tp-7 AC-10 -- protocol statistics surface the
#            aggregate active-tunnel and active-session counts as
#            fresh values (not zero-initialized stubs).
# PREVENTS:  regression where the handler returns hard-coded zeros,
#            or reports stale counters from a prior sampling window.

option=env:var=ze.l2tp.skip-kernel-probe:value=true
option=env:var=TEST_SECRET:value=stats-secret
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=20s

# ze-peer runs as a sink: only a dial target, asserts nothing. This test is about
# `show l2tp statistics`; the BGP peer exists so ze has a session to configure.
#
# // the ipv4/unicast EOR this block declared was unreachable BY
# CONSTRUCTION -- the run-script calls `request shutdown` at post-startup, so ze
# closes during the OPEN handshake ("open recv / open sent / connection closed
# before completion") and the EOR is never sent. It could not fail for a real
# reason, only pass vacuously (pre-F1) or hang the verdict (post-F1). Coverage is
# NOT reduced: this test never asserted BGP wire content -- its l2tp assertions and
# expect=exit:code=0 are what it proves. Per
# plan/spec-fixit-redistribute-establishment-stall.md the honest fixes are
# --mode sink (peer is scaffolding, as here) or reaching Established first, which
# would test BGP rather than l2tp.
EOF_PEER


stdin=ze-conf:terminator=EOF_CONF
plugin {
	external l2tp-statistics-show-test {
		run "ze-test fixture plugin/l2tp-statistics-show"
		encoder json
	}
}

environment {
	log {
		l2tp debug
	}
	l2tp {
		server main {
			ip 127.0.0.1
			port $PORT2
		}
	}
}

l2tp {
	enabled true
	shared-secret stats-secret
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --mode sink --port $PORT:stdin=peer
cmd=background:seq=2:exec=ze-test fixture plugin/l2tp-statistics-show-peer $PORT2 0x0123
cmd=foreground:seq=3:exec=ze -:stdin=ze-conf:timeout=20s
expect=exit:code=0
expect=stderr:contains=tunnel now established
