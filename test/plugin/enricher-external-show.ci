# Test: external plugin declares enricher at registration, engine calls back at show time
# VALIDATES: AC-1 (enricher declared), AC-2 (callback invoked, data merged), AC-10 (compiled fixture)
# PREVENTS: external enrichment pipeline broken or callback not dispatched

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER


stdin=ze-conf:terminator=EOF_CONF
plugin {
    internal fakeenrich {
        use fakeenrich
    }
    external enricher-provider {
        run "ze-test fixture plugin/enricher-external-show-provider"
        encoder json
    }
    external enricher-checker {
        run "ze-test fixture plugin/enricher-external-show-checker"
        encoder json
    }
}

bgp {
    peer peer1 {
        connection {
            remote {
                ip 127.0.0.1
            }
            local {
                ip 127.0.0.1
                accept false
            }
        }
        session {
            asn {
                local 1
                remote 1
            }
            router-id 1.2.3.4
            family {
                ipv4/unicast { prefix { maximum 10000; } }
            }
            capability {
                graceful-restart disable
            }
        }
        behavior {
            group-updates disable
        }
    }
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-conf:timeout=15s
expect=exit:code=0
