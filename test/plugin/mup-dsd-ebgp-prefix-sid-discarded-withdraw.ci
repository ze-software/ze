# mup-dsd-ebgp-prefix-sid-discarded-withdraw -- draft-ietf-bess-mup-safi Section 3.3.6
# and RFC 8669 Section 4 EBGP Prefix-SID discard arm, end to end through the route server.
#
# An EBGP source peer WITHOUT `accept-srv6-prefix-sid true` sends an UPDATE carrying
# a Direct Segment Discovery route D4 and a sibling Type 2 ST route T4 with a valid
# Prefix-SID attribute (type 40). RFC 8669 Section 4 discards the Prefix-SID attribute
# from an untrusted EBGP peer before the typed-NLRI UPDATE check runs, leaving D4
# without a Prefix-SID. draft-ietf-bess-mup-safi Section 3.3.6 treats D4 as withdrawn
# while continuing to process T4: receiver-peer receives T4 and never D4, Adj-RIB-In
# holds T4 and omits D4, and no session is reset.

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=2
option=timeout:value=20s
option=bind:value=0.0.0.0
option=linger:value=true
# Bind conn=N by remote IP: which client connects first is a race (peer_connmap.go).
option=conn_map:value=remote-ip

# Source peer (conn=1, AS 65001, EBGP without accept-srv6-prefix-sid).
#   D4: 0100020C0000FDE900000001C0000201 (DSD, RD 65001:1, addr 192.0.2.1)
#   T4: 010004110000FDE90000000140C000020100000001 (T2ST, RD 65001:1, ep 192.0.2.1, TEID 1)
#   Prefix-SID (type 40): SRv6 L3 Service TLV, SID 2001:db8::1, End.DT4
# seq=1 announces D4 + T4 carrying a Prefix-SID attribute.
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0074020000005D4001010040020602010000FDE9800E2E0001550401010101000100020C0000FDE900000001C0000201010004110000FDE90000000140C000020100000001C0281C050019000100150020010DB800000000000000000000000100001300

# Ordinary IPv4 route fences the MUP UPDATE on the same source connection.
action=send:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002F02000000144001010040020602010000FDE940030401010101180A0000

# Receiver (conn=2, AS 65002, rs-client): T4 is announced and the fence follows.
expect=bgp:conn=2:seq=1:contains=010004110000FDE90000000140C000020100000001
expect=bgp:conn=2:seq=2:announced=180A0000

# D4 is never announced: RFC 8669 Section 4 discarded its Prefix-SID, so Section 3.3.6
# treated D4 as withdrawn before installation or relay.
reject=bgp:conn=2:pattern=0100020C0000FDE900000001C0000201

EOF_PEER

stdin=ze-bgp:terminator=EOF_CONF
bus {
	endpoint bgp-rib {
		internal bgp-rib;
		receive {
			allow none;
		}
		send {
			allow none;
		}
	}
	endpoint rs {
		internal bgp-rs;
	}
	endpoint adj-rib-in {
		internal bgp-adj-rib-in;
		send {
			message bgp:update {
				to none;
			}
		}
	}
	endpoint mup-sd-observer {
		external {
			run "le test fixture plugin/mup-segment-discovery-observer --keep=010004110000fde90000000140c000020100000001 --absent=0100020c0000fde900000001c0000201";
		}
		encoding json;
	}
}
bgp {
	# RFC 8212: an EBGP direction with no policy is refused; this test exchanges routes.
	filter {
		import { final accept; }
		export { final accept; }
	}
	peer source-peer {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			rs-client true;
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			# Deliberately omit accept-srv6-prefix-sid (default false): RFC 8669 Section 4
			# discards Prefix-SID on EBGP receipt before MUP's UpdateCheck runs.
			family {
				ipv4/unicast { prefix { maximum 10000; } }
				ipv4/mup { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
	peer receiver-peer {
		connection {
			remote {
				ip 127.0.0.2
			}
			local {
				ip 127.0.0.2
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65002
			}
			router-id 1.2.3.4
			rs-client true
			family {
				ipv4/unicast { prefix { maximum 10000; } }
				ipv4/mup { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
reject=stderr:pattern=panic
reject=stderr:pattern=fatal error
