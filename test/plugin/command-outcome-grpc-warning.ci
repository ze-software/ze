# Question: does actual TLS gRPC retain warning status and every external row
# on both sides of the record threshold, while healthy controls remain done?
# The SDK record callback supplies warning kind without warning text.
# A unit cannot prove the daemon listener, TLS and protobuf result together.

stdin=ze-conf:terminator=EOF_CONF
bus {
    endpoint answer-outcome-provider {
        external {
            run "le test fixture plugin/command-outcome-provider";
        }
        encoding json;
    }
    endpoint answer-outcome-observer {
        external {
            run "le test fixture plugin/command-outcome-grpc $PORT command-outcome.pem warning";
        }
        encoding json;
    }
}
environment {
    api-server {
        token "command-outcome-token";
        grpc {
            enabled true;
            tls-cert "command-outcome.pem";
            tls-key "command-outcome.key";
            server main { ip 127.0.0.1; port $PORT; }
        }
    }
}
EOF_CONF

cmd=foreground:seq=1:exec=le test fixture config-refusal/tls command-outcome.pem command-outcome.key
expect=exit:code=0
cmd=foreground:seq=2:exec=ze -:stdin=ze-conf:timeout=40s
expect=exit:code=0
expect=stderr:contains=OK: TLS gRPC warning outcome and healthy control preserved rows across the record threshold
reject=stderr:contains=ZE-OBSERVER-FAIL
reject=stderr:contains=panic recovered
