# Test: an external drain plugin outlives a SIGTERM to ze's process group
# Exercises: process.startExternal (internal/component/plugin/process/process.go)
#            -> plugin.KillGroupOnCancel -> NewSysProcAttr Setpgid
#            (internal/component/plugin/sysproc_linux.go); the plugin sends
#            SIGTERM to ze's whole process group, as a terminal or gokrazy does
#            -> runStopDrain (cmd/ze/hub/drain.go) -> the plugin's OnDrain.
# VALIDATES: spec-daemon-drain-before-stop AC-16: the subprocess plugin's
#            process group differs from ze's, the group SIGTERM reaches ze and
#            not the plugin, and the plugin receives the drain and answers.
# PREVENTS:  a plugin in ze's group dying on the operator's Ctrl+C before ze
#            can drain it.

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=20s

expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

tmpfs=ze-bgp.conf:terminator=EOF_CONF
plugin {
	external drain-group {
		run "le test fixture plugin/drain-group"
		encoder json
	}
}
bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze start ze-bgp.conf:timeout=20s
expect=exit:code=0
expect=stderr:contains=drain-fixture: plugin process group differs from ze's
expect=stderr:contains=drain-fixture: sent SIGTERM to ze's process group
expect=stderr:contains=drain-fixture: drain received kind=stop
expect=stderr:contains=drain-fixture: drain answered
reject=stderr:contains=drain-fixture: FAIL
