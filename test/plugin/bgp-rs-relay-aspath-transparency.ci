# bgp-rs-relay-aspath-transparency -- RS-client AS_PATH transparency on the
# PLUGIN forwarding rail, with its confining negative in the same run.
#
# rfc-test-change-approved: 2026-08-16 Thomas approved adding the optional
# bgp-adj-rib-in replay provider and its source/destination attachments. This
# repairs route-server replay when the source UPDATE precedes receiver peer-up;
# every RFC assertion and expected wire outcome below is unchanged.
#
# RFC requirement: RFC7947-x-1 positive -- the route server SHOULD NOT prepend its own AS to
# AS_PATH for an RS client. The receiver configured with session/rs-client true gets the
# forwarded UPDATE byte-identical to the one the source sent: AS_SEQUENCE[65001] unchanged, and
# the route server's own AS 65000 nowhere in it.
# RFC requirement: RFC7947-x-1 negative -- that transparency is CONFINED to RS clients. The
# second receiver, identical except that it leaves rs-client at its default of false, gets
# AS_SEQUENCE[65000, 65001] -- the local AS prepended per RFC 4271 Section 5.1.2. One source
# UPDATE, two destinations, opposite transforms, so neither assertion can pass by accident.
#
# WHY THIS FILE EXISTS, and why it does NOT set rs-fast-path.
#
# There are TWO copies of the prepend gate, `facts.isEBGP && !facts.rsClient`:
#   - forward_rs.go, in reactorForwardRS -- the reactor fast path, taken when the SOURCE peer
#     sets behavior/rs-fast-path.
#   - reactor_api_forward.go, in forwardUpdateCore -- the plugin rail, reached by
#     ForwardUpdate (bgp-rs dispatch) and by RelayStoredRoute (peer-up replay).
# Every pre-existing RFC7947-x-1 binding drives the FIRST copy: the unit tests
# (forward_rs_test.go) call reactorForwardRS directly, and bgp-rs-asn4-transcode.ci and
# bgp-rs-fastpath-ebgp-shared.ci both enable rs-fast-path. Mutating the forwardUpdateCore copy
# to prepend for everyone, or for no one, left all of them GREEN -- so RFC 7947 transparency
# could be reverted on the plugin rail and on every peer-up replay with the suite passing.
#
# rs-fast-path is therefore deliberately ABSENT from both peers here: it is what routes the
# UPDATE to the other copy of the gate. Adding it to the source would silently move this test
# onto the rail that was already covered and give back the coverage it exists to add.
#
# NO LOCAL_PREF in the source frame: the source is an eBGP peer and RFC 4271 Section 5.1.5
# forbids LOCAL_PREF towards external peers, so ze would correctly overwrite it with an
# ATTR_DISCARD marker (message/rfc7606.go) and the byte-equality below would pin the marker
# rather than the AS_PATH.

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=3
option=timeout:value=20s
option=bind:value=0.0.0.0
# Bind conn=N by remote IP rather than accept order: which client connects first is a race,
# and the two receivers must be told apart by identity, not arrival (peer_connmap.go).
option=conn_map:value=remote-ip

# Source peer (conn=1, AS 65001): announce 10.0.0.0/24 with a POPULATED AS_PATH.
#   ORIGIN:    40010100          IGP
#   AS_PATH:   40020602010000FDE9  AS_SEQUENCE[65001], 4-byte ASNs
#   NEXT_HOP:  40030401010101    1.1.1.1
#   NLRI:      180A0000          10.0.0.0/24
# attr len = 4+9+7 = 20 = 0x14; total = 19+2+2+20+4 = 47 = 0x2F.
# A non-empty AS_PATH is what makes "unchanged" a real assertion: with an empty one, both the
# transparent and the prepended form would differ only by the presence of a segment.
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002F02000000144001010040020602010000FDE940030401010101180A0000

# The source's own EOR. Only conn=1's is asserted on the wire: RFC 4724 Section 4.1 constrains
# no ordering between a peer's EOR and routes it learns afterwards, so pinning a receiver's EOR
# turns a permitted ordering into a flake under load. That both receivers DO send one is still
# enforced, fail-closed, by run_rs_observer(expected_peers=3).
expect=bgp:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000

# Receiver A (conn=2, AS 65002, rs-client TRUE): byte-identical to what the source sent.
# RFC 7947 Section 2.2.2.1 -- no 0000FDE8 (65000) anywhere, AS_PATH still AS_SEQUENCE[65001].
expect=bgp:conn=2:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002F02000000144001010040020602010000FDE940030401010101180A0000

# Receiver B (conn=3, AS 65003, rs-client left at its default FALSE): local AS prepended.
#   AS_PATH:   40020A02020000FDE80000FDE9   AS_SEQUENCE[65000, 65001]
# attr len = 4+13+7 = 24 = 0x18; total = 19+2+2+24+4 = 51 = 0x33.
expect=bgp:conn=3:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF003302000000184001010040020A02020000FDE80000FDE940030401010101180A0000
EOF_PEER

# Observer: wait until the route server has replayed to every client, then shut down.
tmpfs=shutdown-after-up.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
from ze_api import API

API().run_rs_observer(expected_peers=3, forward_prefix="10.0.0.0/24")
EOF_RUN

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	internal rs {
		use bgp-rs
	}
	internal adj-rib-in {
		use bgp-adj-rib-in
	}
	external shutdown-after-up {
		run ./shutdown-after-up.run
		encoder json
	}
}
bgp {
	peer source-peer {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		attach process adj-rib-in {
			receive [ update-received state ]
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
		attach process shutdown-after-up {
			receive [ update ]
		}
	}
	peer rs-client-receiver {
		connection {
			remote {
				ip 127.0.0.2
			}
			local {
				ip 127.0.0.2
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65002
			}
			router-id 1.2.3.4
			# The ONLY leaf that selects the RFC 7947 transparent path. It defaults to
			# false (plugins/rs/yang/ze-rs-conf.yang), and facts.rsClient is populated
			# from it alone (peer_forward_facts.go <- reactor/config.go). Remove it and
			# this peer becomes receiver B below.
			rs-client true
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		attach process adj-rib-in {
			send [ update ]
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
		attach process shutdown-after-up {
			receive [ update ]
		}
	}
	peer plain-ebgp-receiver {
		connection {
			remote {
				ip 127.0.0.3
			}
			local {
				ip 127.0.0.3
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65003
			}
			router-id 1.2.3.4
			# rs-client deliberately NOT set: this peer is an ordinary eBGP neighbor and
			# must receive the local AS prepended.
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		attach process adj-rib-in {
			send [ update ]
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
		attach process shutdown-after-up {
			receive [ update ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
reject=stderr:pattern=panic
reject=stderr:pattern=fatal error
reject=stderr:pattern=forward-cached failed
reject=stderr:pattern=release-cached failed
