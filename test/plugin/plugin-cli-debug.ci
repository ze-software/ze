# Test: plugin debug shell completes 5-stage handshake and dispatches commands
#
# 1. Daemon starts with SSH + BGP peer
# 2. Compiled driver opens the SSH plugin-protocol channel
# 3. SDK completes the five-stage handshake
# 4. Verifies dispatch-command and help return command data
# 5. The driver closes the channel cleanly
#
# VALIDATES: AC-9 -- debug shell completes 5-stage handshake with defaults via SSH.
# VALIDATES: AC-11 -- dispatch-command works after handshake and returns data.
# PREVENTS: Plugin protocol SSH handler not wired, handshake failing over SSH channel.

tmpfs=cli-debug.conf:terminator=EOF_CONF
bgp {
	peer peer1 {
		connection {
			remote { ip 127.0.0.1 }
			local { ip 127.0.0.1; accept false }
		}
		session { asn { local 65533; remote 65533 } }
	}
}

system {
	authentication {
		user admin {
			password "$2a$04$UlwuiuH82Unfsq.XEMPGJeDkXwbm3KW.nvVaVXOd/JeFK8VjMjrQO"
		}
	}
}

environment {
	ssh {
		enabled true
		server main {
			ip 127.0.0.1;
			port $PORT2;
		}
	}
}
EOF_CONF

cmd=foreground:seq=1:exec=ze start cli-debug.conf:timeout=20s
cmd=foreground:seq=2:exec=ze-test fixture plugin/plugin-cli-debug $PORT2:timeout=20s
expect=exit:code=0
expect=stderr:contains=OK: handshake completed
expect=stderr:contains=OK: dispatch-command returned command data
expect=stderr:contains=OK: help command returned command descriptions
