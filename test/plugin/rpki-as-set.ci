# Test: a route with an AS_SET never reaches RPKI validation
# VALIDATES: RFC 9774 Section 3 treat-as-withdraw on reception: the AS_SET route
#   10.0.1.0/24 is absent from adj-rib-in once the AS_SEQUENCE sentinel
#   10.0.2.0/24, sent after it on the same session, is validated Valid
# PREVENTS: an AS_SET route retained and judged by RPKI instead of withdrawn
# RFC 6811 OriginNone -> Invalid for an AS_SET path stays covered by the unit
#   tests in internal/component/bgp/plugins/rpki/rfc6811_validate_test.go

# ze-peer: send 10.0.1.0/24 with AS_SET {65001}, then the AS_SEQUENCE sentinel
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=linger:value=true
option=timeout:value=15s
option=update:value=send-route:prefix=10.0.1.0/24:origin-as=65001:next-hop=10.0.0.1:as-set=true
option=update:value=send-route:prefix=10.0.2.0/24:origin-as=65001:next-hop=10.0.0.1
# EOR from ze
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# Native compiled fixture: plugin/rpki-as-set
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	hub {
		server local {
			ip 127.0.0.1;
			port 0;
			secret rpki-test-secret-key-01234567890;
		}
	}
	external rpki-asset-test {
		run "le test fixture plugin/rpki-as-set"
		encoder json
	}
	internal rpki {
		use bgp-rpki
	}
	internal adj-rib-in {
		use bgp-adj-rib-in
	}
}

bgp {
	rpki {
		cache-server 127.0.0.1 {
			trusted-network true
			port $PORT2
		}
	}
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}

		attach process rpki-asset-test {
			receive [ update state ]
		}
		attach process rpki {
			receive [ update-received state ]
		}
		attach process adj-rib-in {
			receive [ update-received state ]
		}
	}
}
EOF_CONF

# VRP: 10.0.0.0/8 maxlen=24 AS=65001 (the sentinel validates Valid)
cmd=background:seq=1:exec=le test rtr-mock --port $PORT2 --vrp 10.0.0.0/8,24,65001:ready=le test rtr-mock: listening on
cmd=background:seq=2:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=3:exec=ze -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
