# Test: RPKI rejects route with AS_SET origin
# VALIDATES: AS_PATH ending in AS_SET yields OriginNone -> Invalid for covered prefix (AC-8)
# PREVENTS: RPKI plugin accepting routes with AS_SET aggregation

# ze-peer: send route 10.0.1.0/24 with AS_SET {65001} (not AS_SEQUENCE)
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
option=update:value=send-route:prefix=10.0.1.0/24:origin-as=65001:next-hop=10.0.0.1:as-set=true
# EOR from ze
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

tmpfs=rpki-asset-test.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
import json
import sys
from ze_api import API, result_text_data, result_json_data

def dispatch(api, command):
    resp = api._call_engine(
        'ze-plugin-engine:dispatch-command', {'command': command})
    if resp is None:
        return {'status': 'error', 'data': 'engine call returned None'}
    return resp.get('result', {})

def vrp_count(api):
    d = result_json_data(dispatch(api, 'show bgp rpki status'), {})
    return d.get('vrp-count-ipv4', 0) if isinstance(d, dict) else 0

def updates_received(api):
    r = dispatch(api, 'show bgp peer peer1 detail')
    return r.get('data', {}).get('peers', {}).get('127.0.0.1', {}).get('updates-received', 0)

def wait_until(api, pred, cycles=150):
    for _ in range(cycles):
        if pred():
            return True
        api.wait_for_event(timeout=0.2)
    return False

def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()

    # Deterministic replacement for sleep(4.0): wait for RTR sync (VRP loaded) so
    # validation has data, then for ze to receive the UPDATE, then quiesce so the
    # RPKI validation decision has drained before asserting the route is absent.
    if not wait_until(api, lambda: vrp_count(api) >= 1):
        print('FAIL: RTR never synced a VRP', file=sys.stderr)
        sys.exit(1)
    if not wait_until(api, lambda: updates_received(api) >= 1):
        print('FAIL: ze never received the UPDATE', file=sys.stderr)
        sys.exit(1)
    api.quiesce()

    try:
        result = dispatch(api, 'show bgp rib received')
        if result.get('status') != 'done':
            print(f'FAIL: rib routes received status={result.get("status")}', file=sys.stderr)
            sys.exit(1)

        data = result_text_data(result)
        # AS_SET -> OriginNone -> covered prefix -> Invalid -> rejected
        if '10.0.1.0/24' in data:
            print(f'FAIL: route with AS_SET should be rejected: {data}', file=sys.stderr)
            sys.exit(1)

        print('OK: route with AS_SET correctly rejected (OriginNone -> Invalid)', file=sys.stderr)
    finally:
        dispatch(api, 'request shutdown')
        api.wait_for_shutdown()

if __name__ == '__main__':
    main()
EOF_RUN

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	hub {
		server local {
			ip 127.0.0.1;
			port 0;
			secret rpki-test-secret-key-01234567890;
		}
	}
	external rpki-asset-test {
		run ./rpki-asset-test.run
		encoder json
	}
	internal rpki {
		use bgp-rpki
	}
	internal adj-rib-in {
		use bgp-adj-rib-in
	}
}

bgp {
	rpki {
		cache-server 127.0.0.1 {
			port $PORT2
		}
	}
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}

		attach process rpki-asset-test {
			receive [ update state ]
		}
		attach process rpki {
			receive [ update-received ]
		}
		attach process adj-rib-in {
			receive [ update-received state ]
		}
	}
}
EOF_CONF

# VRP: 10.0.0.0/8 maxlen=24 AS=65001 (AS_SET -> OriginNone -> Invalid)
cmd=background:seq=1:exec=ze-test rtr-mock --port $PORT2 --vrp 10.0.0.0/8,24,65001
cmd=background:seq=2:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=3:exec=ze -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
