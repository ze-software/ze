# Test: the remove-private-as filter works through its short-form reference
# VALIDATES: a filter-type short form `remove-private-as:NAME` resolves to the
#   bgp-filter-remove-private-as plugin (policy.CanonicalName through
#   registry.FilterTypesMap), a second type beside prefix-filter-shortform's
#   `modify:NAME`.
# VALIDATES: composable (standalone chain with a short-form reference)
# PREVENTS: Short-form reference "<type>:NAME" not resolved to its plugin
#
# The as-path-list type no longer owns a filter role (a chain reaches an
# as-path-list through a match instance, which has no short form), so the
# type-prefix form is proven with `remove-private-as`, a type that still
# serves one.
#
# Flow:
# 1. ze-peer sends UPDATE: ORIGIN=IGP, AS_PATH=[65001], NEXT_HOP=1.1.1.1, NLRI=10.0.0.0/24
# 2. Filter chain resolves short-form "remove-private-as:CUSTOMERS" to
#    bgp-filter-remove-private-as:CUSTOMERS
# 3. The plugin answers modify for the private AS 65001.
# 4. Assertions on stderr confirm the decision log and no "unknown plugin".
option=env:var=ze.log.bgp.filter.remove-private-as:value=info

stdin=peer:terminator=EOF_PEER
# The peer has no expectation left once it sends, so without linger it closes
# the instant its write lands. ze reads that as session-down and purges the
# peer's routes, which is the state this test's observer polls for.
option=linger:value=true
option=tcp_connections:value=1
option=timeout:value=15s
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002F02000000144001010040020602010000FDE940030401010101180A0000
EOF_PEER

# Observer: wait for filter dispatch then clean shutdown

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external test-aspath-short {
		run "le test fixture plugin/aspath-filter-shortform"
		encoder json
	}
}
policy {
	remove-private-as CUSTOMERS {
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
		}

		filter {
			import { filters [ remove-private-as:CUSTOMERS ]; final accept; }
		}

		attach process bgp-adj-rib-in {
			receive [ update-received state ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze --plugin ze.bgp-filter-remove-private-as --plugin ze.bgp-adj-rib-in -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
expect=stderr:pattern=remove-private-as modify
expect=stderr:pattern=filter=CUSTOMERS
reject=stderr:pattern=unknown plugin
