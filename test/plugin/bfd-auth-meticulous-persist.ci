# Test: BFD plugin persists a Meticulous SHA1 TX sequence across a process
# restart via the shared zefs state store (database.zefs).
#
# VALIDATES: spec-bfd-5 AC-7 -- the SeqPersister writes the last-sent sequence to
#            the managed state store and a fresh ze process resumes from that
#            floor so the peer does not reject our packets as replays. Since the
#            zefs-persistence migration the sequence lives in
#            {ze.config.dir}/database.zefs (via internal/core/statestore), not a
#            loose <session>.seq file; persist-dir is a vestigial opt-in flag.
# PREVENTS:  a regression where the persister drops the pending flush, writes
#            nowhere on the filesystem/CLI path (statestore not registered there),
#            or fails to restore the sequence on restart.
#
# Method: a Python orchestrator launches ze twice over the SAME ze.config.dir, so
# both runs share one database.zefs. The first run creates a Meticulous session
# and waits until a sequence has actually reached the store. It then SIGTERMs
# cleanly (Close flushes the sequence). The second run restores the persisted
# sequence -- the engine logs "bfd auth sequence restored ... seq=N" (N>0), the
# observable proof it survived.
#
# Every wait here is on a condition, never on a duration. The earlier version
# ran each ze for a flat 6.0 seconds and then SIGKILLed the daemon 5.0 seconds
# after SIGTERM. Both are fixed durations standing in for conditions
# (ai/rules/fix-dont-record.md) and both failed under load:
#   * the 6.0s run expired before startup finished, giving
#     "FAIL: first run did not reach 'bfd plugin running'";
#   * the 5.0s SIGKILL cut database.zefs mid-flush. zefs updates an entry in
#     place with one pwrite for the data and a second for the container CRC
#     (pkg/zefs/store.go flushInPlace), so a kill between them leaves the CRC
#     disagreeing with the data. That is the accepted, documented consequence of
#     the in-place design, and the storage
#     layer then moves the unreadable blob aside and recreates it
#     (internal/component/config/storage/blob.go), destroying the very sequence
#     this test asserts. ze is therefore never SIGKILLed on a passing path.
#
# // test-relax: the pre-migration assertion read a <session>.seq file; that file
# no longer exists (the sequence persists to database.zefs via statestore). The
# load-bearing check is unchanged in intent -- the sequence must survive a restart
# -- and is now observed through the engine's restored-sequence debug log.

option=env:var=ze.bfd.test-parallel:value=true
# BFD listens on the RFC 5881 / RFC 5883 FIXED ports, so every concurrently
# running BFD test's daemon binds the same wildcard (0.0.0.0, 3784/3785) tuple.
# SO_REUSEPORT above lets them co-bind, and the kernel then HASHES each inbound
# datagram to one socket in the group (internal/component/bfd/transport/
# udp_linux.go applySocketOptions) -- so a control reply or a reflected echo meant
# for this daemon can be delivered to a sibling test's daemon instead. That is the
# kernel-global surface option=exclusive exists for: unique addresses cannot
# partition a port number the RFC fixes. Tests outside the group still run
# alongside these.
option=exclusive:group=bfd-ports


tmpfs=test-bfd-meticulous-persist.py:mode=755:terminator=EOF_PY
#!/usr/bin/env python3
"""Verify a Meticulous SHA1 TX sequence survives a ze restart via database.zefs."""

import os
import re
import signal
import subprocess
import sys
import tempfile
import threading
import time


# Interval between condition polls. Each polling loop below returns as soon as
# its condition holds, so this bounds latency only, never the wait itself.
POLL = 0.05

# Per-run budget for the condition waits, counted from the moment each ze
# starts. This is a FAILURE bound, not a success bound: nothing here waits for
# it to elapse, so a slow host cannot turn a pass into a pass-by-timing the way
# the old flat 6.0s run duration could. It exists because an unbounded wait is
# worse than a short one -- this script owns a ze child that keeps the runner's
# output pipe open, so a hang outlives the .ci timeout= and wedges the suite
# instead of failing it. On expiry the script names the condition it was waiting
# for and dumps the daemon log, so the failure is diagnosable instead of silent.
#
# Counted per run rather than across the test, so a slow first run cannot starve
# the second. Conditions normally hold in under two seconds.
BUDGET = 12.0

# Grace for one clean SIGTERM exit. A CONSTANT, deliberately: deriving it from
# what the startup budget had left gave ze less time to flush the slower the
# host was, which is backwards, and the SIGKILL that followed is the mid-flush
# database.zefs corruption this test was redesigned to stop causing.
SHUTDOWN_BUDGET = 5.0

# Cap on one `ze data` fork. The store probe forks ze, and a fork that hangs
# must not outlive the budget that exists to bound the wait: the .ci timeout=
# would fire first and take the diagnostic dump with it. Every probe is bounded
# by this AND by the time left in the run, whichever is smaller.
PROBE_TIMEOUT = 5.0

# The .ci timeout= is 40s and this script must always fail before it, so the
# diagnostic survives. The worst path runs both daemons, and each is bounded by
# BUDGET for its conditions plus SHUTDOWN_BUDGET for its exit. That is
# 2 * (12.0 + 5.0) = 34s, which leaves the runner its margin.


def remaining(since: float) -> float:
    """Seconds left in the budget of a run that started at `since`."""
    return BUDGET - (time.monotonic() - since)


def build_config(persist_dir: str) -> str:
    return f"""environment {{
}}

bfd {{
\tenabled true;
\tpersist-dir "{persist_dir}";
\tprofile fast-meticulous {{
\t\tdetect-multiplier 3
\t\tdesired-min-tx-us 50000
\t\trequired-min-rx-us 50000
\t\tauth {{
\t\t\ttype meticulous-keyed-sha1
\t\t\tkey-id 1
\t\t\tsecret "k-persist"
\t\t}}
\t}}
\tsingle-hop-session 203.0.113.9 {{
\t\tprofile fast-meticulous
\t}}
}}
"""


class Daemon:
    """One ze process with its output drained continuously.

    The drain thread matters twice. It lets a caller wait on a log condition
    while ze still runs, and it keeps the pipe from filling. Nothing read the
    pipe until after exit before, so a daemon that outgrew the 64 KiB pipe
    buffer would have blocked inside its own shutdown.
    """

    def __init__(self, state_dir: str) -> None:
        self._started = time.monotonic()
        env = os.environ.copy()
        env["ze.log.bfd"] = "debug"
        env["ze.bfd.test-parallel"] = "true"
        # Both runs share one database.zefs here, so the sequence run 1 flushes is
        # the sequence run 2 restores (statestore lives at {config-dir}/database.zefs).
        env["ze.config.dir"] = state_dir
        self.proc = subprocess.Popen(
            ["ze", "-"],
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            env=env,
        )
        assert self.proc.stdin is not None
        self.proc.stdin.write(build_config(state_dir))
        self.proc.stdin.close()

        self._lock = threading.Lock()
        self._chunks: list[str] = []
        self._drain = threading.Thread(target=self._pump, daemon=True)
        self._drain.start()

    def _pump(self) -> None:
        assert self.proc.stdout is not None
        for line in self.proc.stdout:
            with self._lock:
                self._chunks.append(line)

    def log(self) -> str:
        with self._lock:
            return "".join(self._chunks)

    def deadline(self) -> float:
        """The monotonic instant this run's budget expires.

        A predicate that forks a child passes this down, so no child outlives
        the budget it is waited on under.
        """
        return self._started + BUDGET

    def wait_for(self, predicate, what: str, poll: float = POLL) -> bool:
        """Poll until predicate() holds. Returns False if it never does.

        The condition decides a pass. BUDGET only decides how long a FAILURE
        takes to report, so a slow host delays this loop, it does not fail it.
        ze exiting early is a decisive negative and is reported as itself
        rather than as a timeout.

        The budget is read BEFORE the predicate runs. Read after it, one slow
        predicate delays the check by however long the predicate takes, and the
        store probe forks ze. A hung fork then held the check off past the .ci
        timeout=, the runner killed the test, and this loop's diagnostic never
        reached anyone.

        `poll` is the interval, not a limit. A predicate that forks a process
        passes a larger one so a loaded host is not asked to fork 20 times a
        second per test.
        """
        while True:
            if remaining(self._started) <= 0:
                sys.stderr.write(
                    f"FAIL: gave up after {BUDGET}s waiting for {what}\n"
                )
                sys.stderr.write(self.log())
                # Kill before returning. The test is already failing, so this
                # cannot corrupt a passing run, and an orphaned ze would hold
                # the runner's output pipe open and wedge the suite rather
                # than let it record this failure.
                self.abandon()
                return False
            if predicate():
                return True
            if self.proc.poll() is not None:
                sys.stderr.write(
                    f"FAIL: ze exited (code {self.proc.returncode}) before {what}\n"
                )
                sys.stderr.write(self.log())
                return False
            # poll interval; the loop above returns as soon as the condition holds
            time.sleep(poll)

    def stop(self) -> str | None:
        """SIGTERM and wait for a clean exit. Returns None if it never came.

        No SIGKILL while the test can still pass. A kill -9 can cut a zefs
        in-place flush between its data pwrite and its container-CRC pwrite,
        which corrupts database.zefs and erases the persisted sequence.
        That is what the old fixed
        `wait(timeout=5.0)` then `kill()` did on a loaded host, and it is the
        whole reason this test was flaky.

        The grace is SHUTDOWN_BUDGET, a constant. It was once whatever the
        startup budget had left, so the slower the host ran, the less time ze
        got to flush, and a run that spent 14s on its conditions left ze the
        1.0s floor. That inverts the relationship: a loaded host is exactly the
        host that needs the grace, and the SIGKILL below then corrupted the
        store this test reads (ai/rules/fix-dont-record.md).

        The wait is bounded only so a wedged daemon fails loudly rather than
        hanging the suite. Reaching that bound is already a failure, so the
        kill that follows cannot corrupt a passing run.
        """
        limit = time.monotonic() + SHUTDOWN_BUDGET
        self.proc.send_signal(signal.SIGTERM)
        try:
            self.proc.wait(timeout=SHUTDOWN_BUDGET)
        except subprocess.TimeoutExpired:
            sys.stderr.write(
                f"FAIL: ze did not exit within {SHUTDOWN_BUDGET}s of SIGTERM\n"
            )
            sys.stderr.write(self.log())
            self.abandon()
            return None
        # ze has exited, so stdout is at EOF and the drain thread ends as soon
        # as it empties the pipe. The bound keeps the whole of stop() inside
        # SHUTDOWN_BUDGET, and the floor keeps it positive.
        self._drain.join(timeout=max(limit - time.monotonic(), 0.5))
        captured = self.log()
        if captured:
            sys.stderr.write(captured)
            sys.stderr.flush()
        return captured

    def abandon(self) -> None:
        """Kill a daemon we have already decided to fail on, so none leaks."""
        if self.proc.poll() is None:
            self.proc.kill()
            self.proc.wait()


def restored_seq(log: str) -> int:
    """Return the restored TX sequence the engine logged, or 0 if none."""
    m = re.search(r"bfd auth sequence restored.*?seq=(\d+)", log)
    return int(m.group(1)) if m else 0


class StoreProbe:
    """Reads the TX sequence out of database.zefs, or 0 while none is there.

    Reads go through `ze data`, which opens the store read-only (zefs.Open) and
    never rewrites or moves it. Any error means the value is not observable
    yet: the store can be absent, and a flush can be in flight. The caller then
    polls again.

    The key is remembered once found. Each poll used to fork ze twice, one fork
    to list the keys and one to read the chosen key, and that fork cost is what
    a loaded host pays on every iteration of the wait.
    """

    def __init__(self, state_dir: str) -> None:
        self.store = os.path.join(state_dir, "database.zefs")
        self.key: str | None = None

    def _run(self, args: list[str], deadline: float):
        """Run one `ze data` fork, bounded by PROBE_TIMEOUT and the deadline."""
        left = deadline - time.monotonic()
        if left <= 0:
            return None
        try:
            return subprocess.run(
                args,
                capture_output=True,
                text=True,
                timeout=min(PROBE_TIMEOUT, left),
            )
        except (subprocess.SubprocessError, OSError):
            return None

    def seq(self, deadline: float) -> int:
        if not os.path.exists(self.store):
            return 0
        if self.key is None:
            listing = self._run(["ze", "data", "--path", self.store, "ls"], deadline)
            if listing is None or listing.returncode != 0:
                return 0
            keys = [
                k for k in listing.stdout.split() if k.startswith("meta/bfd/auth/")
            ]
            if not keys:
                return 0
            self.key = keys[0]
        got = self._run(
            ["ze", "data", "--path", self.store, "cat", self.key], deadline
        )
        if got is None or got.returncode != 0:
            return 0
        try:
            return int(got.stdout.strip())
        except ValueError:
            return 0


def main() -> int:
    # The per-test sandbox, never /tmp (ai/rules/testing.md). Absolute, because
    # ze.config.dir and persist-dir are resolved by the daemon, not by this
    # script, and a relative path would depend on the daemon's directory.
    state_dir = os.path.abspath(
        tempfile.mkdtemp(prefix="ze-bfd-auth-persist-", dir=".")
    )

    # ---- Run 1: create the session and let a sequence reach the store. ----
    probe = StoreProbe(state_dir)
    first = Daemon(state_dir)
    try:
        if not first.wait_for(
            lambda: "bfd plugin running" in first.log(), "'bfd plugin running'"
        ):
            sys.stderr.write("FAIL: first run did not reach 'bfd plugin running'\n")
            return 1
        # Wait for the exact thing run 2 must restore, rather than for a duration.
        # The persister coalesces at a 500ms cadence, so a 250ms poll never
        # misses a flush and keeps the `ze data` forks to a handful. The written
        # sequence stays readable once written, so a coarser poll would only add
        # latency. The deadline goes to the probe, so no fork outlives the wait.
        if not first.wait_for(
            lambda: probe.seq(first.deadline()) > 0,
            "a sequence reached database.zefs",
            poll=0.25,
        ):
            sys.stderr.write("FAIL: first run never persisted a sequence\n")
            return 1
    except BaseException:
        first.abandon()
        raise
    captured1 = first.stop()
    if captured1 is None:
        return 1

    # The first run is fresh: nothing to restore, so it must NOT log a restore.
    if restored_seq(captured1) != 0:
        sys.stderr.write("FAIL: first (fresh) run restored a sequence unexpectedly\n")
        return 1

    # ---- Run 2: the fresh process must resume from the persisted floor. ----
    second = Daemon(state_dir)
    try:
        if not second.wait_for(
            lambda: "bfd plugin running" in second.log(), "'bfd plugin running'"
        ):
            sys.stderr.write("FAIL: second run did not reach 'bfd plugin running'\n")
            return 1
        if not second.wait_for(
            lambda: restored_seq(second.log()) > 0, "the restored-sequence log line"
        ):
            sys.stderr.write(
                "FAIL: second run did not restore a persisted sequence from "
                "database.zefs (statestore not registered on the CLI path, or the "
                "sequence was never flushed)\n"
            )
            return 1
    except BaseException:
        second.abandon()
        raise
    captured2 = second.stop()
    if captured2 is None:
        return 1

    seq = restored_seq(captured2)
    if seq <= 0:
        sys.stderr.write("FAIL: restored sequence vanished from the second run log\n")
        return 1

    sys.stderr.write(
        f"OK: TX sequence persisted and restored across restart (seq={seq})\n"
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
EOF_PY

cmd=foreground:seq=1:exec=python3 ./test-bfd-meticulous-persist.py:timeout=40s
expect=exit:code=0
expect=stderr:pattern=persisted and restored across restart
