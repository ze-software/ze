# Test: an operator who writes plaintext-password in a config FILE can log in.
#
# VALIDATES: spec-netlab-integration AC-1 and AC-3 -- a config loaded at daemon
#            start hashes the plaintext-password sibling into the canonical
#            password leaf, so LocalAuthenticator accepts the login, and the
#            daemon warns once that the plaintext is still in the file.
# PREVENTS:  the defect recorded in plan/journal/silent-fall-through.md on
#            2026-08-14. ApplyPasswordHashing (internal/component/config/
#            password_hash.go) had callers only on the editor commit path, so a
#            config FILE carrying plaintext-password loaded with an empty
#            canonical leaf. CheckPassword (internal/component/authz/auth.go)
#            then refused every login for that user, `ze config validate` called
#            the file valid, and nothing anywhere said why.
#
# This is the user-visible half of the fix. The unit tests in
# internal/component/config/loader_test.go prove the transform on the tree; only
# a running daemon proves the credential the transform produced authenticates.
#
# DISCRIMINATOR: revert the ApplyPasswordHashing call in LoadConfig and seq 1
# fails at the login step with "SSH auth failure", because the canonical leaf is
# empty and CheckPassword refuses an empty hash. Nothing else in the file
# changes: the daemon still starts and still answers on the SSH port.
#
# The config dir is emptied for the CLI (as in cli-credential-resolution.ci,
# whose shape this test follows) so no credential store can supply a login: the
# only credential in play is the one the config file declared.
#
# SUITE: this lives in test/plugin, not test/parse where the spec first placed
# it. The parse runner (internal/test/runner/parsing.go runOneCommand) rewrites
# a leading `ze ` in an exec= line and gives the child no PATH entry for the
# binary, so a script that runs `ze start` finds no `ze`. The plugin runner
# prepends the bare-name shim dir (runner.go setupBinShims/childPathEnv), which
# is what a daemon-plus-login test needs. `make ze-plugin-test` runs it.

tmpfs=test-plaintext-password-at-boot.sh:mode=755:terminator=EOF_SH
#!/bin/sh
set -e

cat > plaintext-at-boot.conf << 'ZECONF'
bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65533
				remote 65533
			}
		}
	}
}

system {
	authentication {
		user lab {
			plaintext-password "labsecret"
		}
	}
}

environment {
	ssh {
		enabled true
		server main {
			ip 127.0.0.1;
			port 0;
		}
	}
}
ZECONF

export ze_test_bgp_port=$((10000 + ($$ % 50000)))

ze start plaintext-at-boot.conf 2>daemon.log &
DAEMON_PID=$!
trap 'kill $DAEMON_PID 2>/dev/null; wait $DAEMON_PID 2>/dev/null' EXIT

SSH_PORT=""
for i in $(seq 1 50); do
	SSH_PORT=$(grep -o '127\.0\.0\.1:[0-9]*' daemon.log 2>/dev/null | head -1 | cut -d: -f2 || true)
	if [ -n "$SSH_PORT" ]; then
		break
	fi
	sleep 0.2
done
if [ -z "$SSH_PORT" ]; then
	echo "FAIL: SSH server did not start (no address in daemon.log)" >&2
	cat daemon.log >&2
	exit 1
fi

sleep 0.5

EMPTY_DIR=$(mktemp -d)
trap 'rm -rf "$EMPTY_DIR"; kill $DAEMON_PID 2>/dev/null; wait $DAEMON_PID 2>/dev/null' EXIT

# AC-1: the password the operator typed in the file logs the user in.
OUTPUT=$(ZE_CONFIG_DIR="$EMPTY_DIR" ZE_SSH_HOST="127.0.0.1" ZE_SSH_PORT="$SSH_PORT" \
	ZE_SSH_PASSWORD="labsecret" ze cli --user lab -c "show bgp peer list" 2>&1) || {
	echo "FAIL: plaintext-password in a config file must authenticate" >&2
	echo "OUTPUT: $OUTPUT" >&2
	cat daemon.log >&2
	exit 1
}

# Discriminator: the daemon must have authenticated THIS request as lab, rather
# than the CLI having reached some other credential.
if ! grep -q 'SSH auth success.*username=lab' daemon.log; then
	echo "FAIL: daemon did not log auth success for username=lab" >&2
	cat daemon.log >&2
	exit 1
fi
echo "OK: AC-1 -- the config file's plaintext-password logged lab in" >&2

# AC-3: the warning names the file, because the plaintext is still in it.
if ! grep -q 'plaintext-at-boot.conf' daemon.log; then
	echo "FAIL: the daemon must warn, naming the config file that still holds the plaintext" >&2
	cat daemon.log >&2
	exit 1
fi
if grep -q 'labsecret' daemon.log; then
	echo "FAIL: the secret reached the log" >&2
	exit 1
fi
echo "OK: AC-3 -- one warning names the file and carries no secret" >&2

# The file the operator wrote is NOT rewritten: the load path hashes in memory.
if ! grep -q 'plaintext-password "labsecret"' plaintext-at-boot.conf; then
	echo "FAIL: the load path must not rewrite the operator's config file" >&2
	exit 1
fi
echo "OK: the operator's file is untouched" >&2

exit 0
EOF_SH

cmd=foreground:seq=1:exec=./test-plaintext-password-at-boot.sh:timeout=25s
expect=exit:code=0
