# Test: peer detail, show policy chain and show policy test report each
# direction's effective final (RFC 8212 Section 3).
#
# VALIDATES: spec-bgp-rfc8212-ebgp-default-reject AC-8 -- through the real
#            command dispatcher, on five sessions:
#   127.0.0.1 EBGP, no policy: final reject, final-source rfc8212, both directions
#   127.0.0.2 EBGP, explicit final accept: final accept, no final-source
#   127.0.0.3 EBGP, explicit final reject: final reject, no final-source, so a
#             configured reject reads differently from the RFC 8212 default
#   127.0.0.4 IBGP, no policy: no final; import keeps its automatic filters
#   127.0.0.6 dynamic peer whose OPEN never arrives (remote AS unresolved):
#             export (absent) reports undetermined, import (explicit accept)
#             keeps its configured final, and dry-run answers undetermined with
#             no trace and no resulting route
# Every import direction carries the automatic loop-detection filter, so
# 127.0.0.1 and 127.0.0.4 import are the automatic-only case: the filter is
# reported and never supplies a final.
# The dry-run withdrawal stays accepted under a default reject, and a mixed
# UPDATE keeps its withdrawal while the announcement is removed.
# PREVENTS: a default reject shown as operator configuration, an absent EBGP
#           direction omitted as if it accepted, and an unknown session type
#           reported as reject or accept.
#
# The observer is the compiled fixture plugin/rfc8212-policy-status
# (internal/test/fixture/rfc8212_policy_status.go). It waits for the four static
# peers to send End-of-RIB, opens a TCP connection from 127.0.0.6 to the group
# listener on 127.0.0.5 without sending OPEN, polls until the dynamic peer is
# published, then checks every surface in both directions.

stdin=p1:terminator=EOF_P1
option=tcp_connections:value=1
option=timeout:value=60s
option=asn:value=65001
option=linger:value=true
EOF_P1

stdin=p2:terminator=EOF_P2
option=tcp_connections:value=1
option=timeout:value=60s
option=asn:value=65002
option=linger:value=true
EOF_P2

stdin=p3:terminator=EOF_P3
option=tcp_connections:value=1
option=timeout:value=60s
option=asn:value=65003
option=linger:value=true
EOF_P3

stdin=p4:terminator=EOF_P4
option=tcp_connections:value=1
option=timeout:value=60s
option=asn:value=65000
option=linger:value=true
EOF_P4

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external rfc8212-policy-status {
		run "le test fixture plugin/rfc8212-policy-status $PORT"
		encoder json
	}
}
# A loop-detection entry makes the daemon prepend its automatic filter to every
# import chain (prependDefaultFilters, bgp/config/peers.go): the automatic-only
# case on the peers with no import policy.
policy {
	loop-detection no-self-as {
		allow-own-as 0
	}
}
bgp {
	peer absent-ebgp {
		connection {
			remote { ip 127.0.0.1; }
			local { ip 127.0.0.5; accept false; }
		}
		session {
			asn { local 65000; remote 65001; }
			router-id 1.2.3.4
			family { ipv4/unicast { prefix { maximum 10000; } } }
			capability { graceful-restart disable; }
		}
		behavior { group-updates disable; }
	}
	peer explicit-accept {
		connection {
			remote { ip 127.0.0.2; }
			local { ip 127.0.0.5; accept false; }
		}
		session {
			asn { local 65000; remote 65002; }
			router-id 1.2.3.4
			family { ipv4/unicast { prefix { maximum 10000; } } }
			capability { graceful-restart disable; }
		}
		behavior { group-updates disable; }
		filter {
			import { final accept; }
			export { final accept; }
		}
	}
	peer explicit-reject {
		connection {
			remote { ip 127.0.0.3; }
			local { ip 127.0.0.5; accept false; }
		}
		session {
			asn { local 65000; remote 65003; }
			router-id 1.2.3.4
			family { ipv4/unicast { prefix { maximum 10000; } } }
			capability { graceful-restart disable; }
		}
		behavior { group-updates disable; }
		filter {
			import { final reject; }
			export { final reject; }
		}
	}
	peer absent-ibgp {
		connection {
			remote { ip 127.0.0.4; }
			local { ip 127.0.0.5; accept false; }
		}
		session {
			asn { local 65000; remote 65000; }
			router-id 1.2.3.4
			family { ipv4/unicast { prefix { maximum 10000; } } }
			capability { graceful-restart disable; }
		}
		behavior { group-updates disable; }
	}
	group unresolved {
		connection {
			remote {
				ip dynamic
				connect false
				range 127.0.0.6/32
			}
			local {
				ip 127.0.0.5
				accept true
			}
		}
		session {
			asn { local 65000; }
			router-id 1.2.3.4
			family { ipv4/unicast { prefix { maximum 10000; } } }
			capability { graceful-restart disable; }
		}
		behavior { group-updates disable; }
		filter {
			import { final accept; }
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=le test peer --mode sink --bind 127.0.0.1 --port $PORT:stdin=p1
cmd=background:seq=2:exec=le test peer --mode sink --bind 127.0.0.2 --port $PORT:stdin=p2
cmd=background:seq=3:exec=le test peer --mode sink --bind 127.0.0.3 --port $PORT:stdin=p3
cmd=background:seq=4:exec=le test peer --mode sink --bind 127.0.0.4 --port $PORT:stdin=p4
cmd=foreground:seq=5:exec=ze -:stdin=ze-bgp:timeout=60s
expect=exit:code=0
reject=stderr:pattern=ZE-OBSERVER-FAIL
reject=stderr:pattern=panic
reject=stderr:pattern=fatal error
