# rfc6793-ingest-collapse -- the AS-path family is reconciled once, at ingest
#
# VALIDATES: RFC 6793 Section 4.2.3 -- a route learned from an OLD speaker
# carries AS_TRANS in AS_PATH and the real four-octet AS numbers in AS4_PATH.
# ze reconciles the pair when it reads the UPDATE (CollapseAS4Family,
# internal/component/bgp/wireu/aspath_collapse.go, called from processMessage,
# internal/component/bgp/reactor/session_read.go), so every destination reads
# one four-octet truth.
# VALIDATES: AC-1 and AC-10 of
# plan/immediate/spec-forwarded-as-path-obeys-rfc6793-for-every-destination.md.
#
# PREVENTS: relaying AS 23456 to a four-octet peer. Before the collapse the
# forward path widened the two-octet AS_PATH it received and dropped the
# AS4_PATH beside it without reading it, so the real AS was lost permanently
# and every downstream speaker saw AS_TRANS where an AS number belonged.
#
# WHAT MAKES IT DISCRIMINATE: with the collapse removed the received payload
# keeps its two-octet label, the forward path widens [65001, 23456] to four
# octets, and conn=2 receives 4002 0A 0202 0000FDE9 00005BA0 rather than the
# hex below. The byte-equality rule fails on the last four octets of AS_PATH.
#
# ASN4 IS DISABLED ON THE SOURCE PEER ONLY, and that is what makes conn=1 an
# OLD speaker: neg.ASN4 is localASN4 && remoteASN4
# (internal/core/bgp/capability/negotiated.go), so ze withholding the
# capability puts the session in two-octet mode whatever ze-peer offers.
#
# RS-CLIENT IS LOAD-BEARING on both peers, for the same reason
# bgp-rs-asn4-transcode.ci records: it selects the RFC 7947 non-prepending
# forward path, so the AS_PATH conn=2 reads is the reconciled path itself
# rather than the reconciled path with 65000 on top. The prepend rail is what
# rfc6793-narrow-to-old-speaker.ci drives.
#
# NO LOCAL_PREF: the source is an eBGP peer and RFC 4271 Section 5.1.5 forbids
# LOCAL_PREF toward an external peer, so ze would overwrite it in place with an
# ATTR_TOMBSTONE marker and the byte-equality rule would pin that marker rather
# than the AS path (bgp-rs-fastpath-ebgp-shared.ci records the same trap).

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=2
option=timeout:value=45s
option=bind:value=0.0.0.0
# Map conn=N to a peer by remote IP instead of accept order, and handshake both
# sessions before either script runs, so the receiver is established when the
# source announces (bgp-rs-fastpath-ebgp-shared.ci records the race this closes).
option=conn_map:value=remote-ip

# Source peer (conn=1), the OLD speaker. The UPDATE, field by field:
#   40 01 01 00                  ORIGIN igp
#   40 02 06 0202 FDE9 5BA0      AS_PATH, two-octet AS_SEQUENCE [65001, AS_TRANS]
#   40 03 04 01010101            NEXT_HOP 1.1.1.1
#   C0 11 0A 0202 0000FDE9 FA56EA7B
#                                AS4_PATH, AS_SEQUENCE [65001, 4200000123]
#   18 0A0000                    NLRI 10.0.0.0/24
# The AS4_PATH holds as many AS numbers as the AS_PATH, so RFC 6793
# Section 4.2.3 takes no leading AS number from the AS_PATH and the reconciled
# path is the AS4_PATH itself: [65001, 4200000123].
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF003C0200000021400101004002060202FDE95BA040030401010101C0110A02020000FDE9FA56EA7B180A0000

# The SOURCE's own EOR (conn=1). RFC 4724 Section 4.1 makes the marker a MUST
# once the initial update completes, and constrains no ordering against routes
# learned after it, so the RECEIVER's EOR is not pinned on the wire here: the
# forward can legitimately overtake it. The compiled observer still gates
# shutdown on both eor-sent counters.
expect=bgp:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000

# Receiver peer (conn=2), the NEW speaker, asserted by full byte-equality.
# Derived from RFC 6793 Sections 4.1 and 4.2.3, not from observed output:
#   40 01 01 00                        ORIGIN igp, copied through
#   40 02 0A 0202 0000FDE9 FA56EA7B    AS_PATH, four-octet AS_SEQUENCE
#                                      [65001, 4200000123]: the reconciled path
#   40 03 04 01010101                  NEXT_HOP 1.1.1.1, ze does not rewrite it
#   18 0A0000                          NLRI 10.0.0.0/24
# NO AS4_PATH. Section 4.1: "The new attributes, AS4_PATH and AS4_AGGREGATOR,
# MUST NOT be carried in an UPDATE message between NEW BGP speakers."
# attr len = 4 + 13 + 7 = 24 = 0x18; total = 19 + 2 + 2 + 24 + 4 = 51 = 0x33.
expect=bgp:conn=2:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF003302000000184001010040020A02020000FDE9FA56EA7B40030401010101180A0000
EOF_PEER

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	internal rs {
		use bgp-rs
	}
	internal adj-rib-in {
		use bgp-adj-rib-in
	}
	external shutdown-after-up {
		run "ze-test fixture plugin/rfc6793-ingest-collapse"
		encoder json
	}
}
bgp {
	peer source-old {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			rs-client true
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				asn4 disable
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
			rs-fast-path enable
		}
		attach process adj-rib-in {
			receive [ update-received state ]
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
		attach process shutdown-after-up {
			receive [ update ]
		}
	}
	peer receiver-new {
		connection {
			remote {
				ip 127.0.0.2
			}
			local {
				ip 127.0.0.2
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65002
			}
			router-id 1.2.3.4
			rs-client true
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
			rs-fast-path enable
		}
		attach process adj-rib-in {
			send [ update ]
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
		attach process shutdown-after-up {
			receive [ update ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=45s
expect=exit:code=0
reject=stderr:pattern=panic
reject=stderr:pattern=fatal error
