# Test: show bgp summary carries per-peer route counts merged from the bgp-rib plugin
# VALIDATES: handleBgpSummary dispatches `show bgp rib status` via ForwardToPlugin
#            and merges the per-peer route-counts into each summary row
#            (routes-received/routes-accepted from Adj-RIB-In, routes-sent from
#            Adj-RIB-Out). This is the birdwatcher Phase-4 data source; the LG
#            consumer (handler_api.go) already reads the keys.
# PREVENTS: the birdwatcher routes_* fields staying 0 because the summary emitted
#           no per-peer route counts (Alice-LG showed zeros for every peer).

# ze-peer sends a default route so the peer's Adj-RIB-In is non-empty.
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
option=update:value=send-default-route
# EOR from ze
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

tmpfs=summary-counts-test.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
import json
import sys
from ze_api import API, result_json_data

def dispatch(api, command):
    resp = api._call_engine(
        'ze-plugin-engine:dispatch-command', {'command': command})
    if resp is None:
        return {'status': 'error', 'data': 'engine call returned None'}
    return resp.get('result', {})

def find_peer(summary, addr):
    for p in summary.get('peers', []):
        if p.get('address') == addr:
            return p
    return None

def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()

    try:
        # Wait for the inbound route to reach the bgp-rib plugin's Adj-RIB-In,
        # polling its per-peer route-counts (the map summary.go merges). This is
        # the same structure the summary reads, so a hit here means the summary
        # will see it too.
        # // test-relax: dispatch_until poll, not a blind sleep -- outbound
        # quiesce cannot wait on an inbound route landing in a plugin.
        api.dispatch_until(
            'show bgp rib status',
            lambda r: result_json_data(r, {})
                .get('route-counts', {})
                .get('127.0.0.1', {})
                .get('in', 0) >= 1,
        )

        result = dispatch(api, 'show bgp summary')
        if result.get('status') != 'done':
            print(f'FAIL: summary status={result.get("status")}', file=sys.stderr)
            sys.exit(1)
        summary = result_json_data(result, {}).get('summary', {})

        peer = find_peer(summary, '127.0.0.1')
        if peer is None:
            print(f'FAIL: 127.0.0.1 not in summary peers', file=sys.stderr)
            sys.exit(1)

        # The merge must have added the route-count keys from the bgp-rib dispatch.
        recv = peer.get('routes-received')
        acc = peer.get('routes-accepted')
        sent = peer.get('routes-sent')
        if recv is None or acc is None or sent is None:
            print(f'FAIL: summary peer row missing route-count keys: {peer}', file=sys.stderr)
            sys.exit(1)
        if recv < 1:
            print(f'FAIL: routes-received={recv}, want >=1 (peer sent a default route)', file=sys.stderr)
            sys.exit(1)
        if acc != recv:
            print(f'FAIL: routes-accepted={acc} != routes-received={recv} (Ze retains only accepted)', file=sys.stderr)
            sys.exit(1)
        # Ze does not retain filtered routes: the key must be absent.
        if 'routes-filtered' in peer:
            print(f'FAIL: routes-filtered present ({peer["routes-filtered"]}); Ze does not track filtered routes', file=sys.stderr)
            sys.exit(1)

        print(f'OK: summary route counts merged: received={recv} accepted={acc} sent={sent}', file=sys.stderr)
    finally:
        dispatch(api, 'request shutdown')
        api.wait_for_shutdown()

if __name__ == '__main__':
    main()
EOF_RUN

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external summary-counts-test {
		run ./summary-counts-test.run
		encoder json
	}
	internal bgp-rib {
		use bgp-rib
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}

		process summary-counts-test {
		}
		process bgp-rib {
			receive [ update state ]
			send [ update ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
