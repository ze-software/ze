# Test: config set/delete/commit lifecycle with live BGP session state verification
# Start with peer-alpha, add peer-beta via REST config commit, delete peer-alpha, re-add it.
# After each commit, verify BGP sessions via show bgp peer (engine state, not config).
# VALIDATES: config commit creates/removes/restores BGP sessions in the reactor
# PREVENTS: config commit updating config file without propagating to the BGP engine

option=timeout:value=60s

# ze-peer in sink mode: accept any connection, respond with keepalive. The mode
# is declared by --mode sink on the cmd= exec line below, which is the only
# place ze-peer reads it from; there is no option=mode directive.
stdin=peer:terminator=EOF_PEER
option=bind:value=0.0.0.0
EOF_PEER


# ze bgp configuration with plugin + REST
stdin=ze-bgp:terminator=EOF_CONF
plugin {
    external lifecycle-driver {
        run "ze-test fixture plugin/rest-peer-set-delete-lifecycle $PORT2 $PORT"
        encoder json
    }
}

environment {
    api-server {
        token "secret";
        rest {
            enabled true;
            server main {
                ip 127.0.0.1;
                port $PORT2;
            }
        }
    }
}

bgp {
    router-id 1.2.3.4
    session {
        asn {
            local 65000
        }
    }
    peer peer-alpha {
        connection {
            remote {
                ip 127.0.0.1
            }
            local {
                ip 127.0.0.1
                accept false
            }
        }
        session {
            asn {
                local 65000
                remote 65001
            }
            router-id 1.2.3.4
            family {
                ipv4/unicast { prefix { maximum 10000; } }
            }
        }
        behavior {
            group-updates false
        }
    }
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=ze-peer --mode sink --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=60s
expect=exit:code=0
