# Test: session lifecycle metrics increment on session up/down cycle
#
# Flow:
# 1. BGP session establishes with telemetry enabled
# 2. Native observer verifies ze_peer_sessions_established_total incremented
# 3. Verifies ze_peer_state_transitions_total has entries
# 4. Verifies message type labels on ze_peer_messages_received_total
# 5. Shuts down daemon
#
# VALIDATES: AC-2 — session established/flap counters on FSM transitions.
# VALIDATES: AC-3 — message type labels on ze_peer_messages_received_total.
# PREVENTS: Session lifecycle metrics not wired into FSM state changes.

# ze-peer expectations
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s

# EOR
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# Native observer verifies session lifecycle metrics after session establishment.

# ze bgp configuration with telemetry enabled
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external session-lifecycle-test {
		run "ze-test fixture plugin/metrics-session-lifecycle"
		encoder json
	}
}

telemetry {
	prometheus {
		enabled true
		server main {
			ip 127.0.0.1;
			port $PORT2;
		}
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
