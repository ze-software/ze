# Test: `show bgp rib best` answers with a walk, and the answer an operator
#       reads is the answer the command produced before it did.
#
# VALIDATES: AC-8 of spec-record-answers-3-zero-alloc, through the real daemon.
#            The best-path pipeline hands its rows over one at a time now, and
#            the document a bounded walk collapses to is still the object under
#            "best-path" that every consumer of this command reads. It also
#            validates that a bound folded into the command bounds the WALK:
#            `first 2` produces two rows and not two of twelve.
# PREVENTS:  the conversion changing the payload. The rows travel as records and
#            are rebuilt into one document by the collapse, so a wrong envelope
#            key, a wrong row shape or a lost row all land here as a diff.
#
# WHAT THIS FILE DOES NOT MEASURE, deliberately. It does not prove the STREAMED
# form, where one line carries one row. A streamed plugin answer opens with a
# head and the whole buffering window in one burst, which is 259 lines at the
# shortest, and the engine holds 256 lines for a consumer that has not been
# scheduled yet: any streamed plugin answer can therefore be abandoned under
# load, at about 1 invocation in 30 (plan/journal/bound-too-small-for-its-own-burst.md).
# A fixture built on a 260-row dump would be flaky through no fault of the walk.
# Twelve routes stay far inside that bound, so this file measures the walk it was
# written for and never the queue. The line-per-row form is proven in
# TestBestPipelineStreams, which writes the same walk to a writer that counts
# lines.

# ze-peer runs as a sink: only a dial target, asserts nothing (routes injected via API)
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=20s
EOF_PEER

# Python test plugin
tmpfs=rib-best-walk-test.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
"""Test: show bgp rib best answers a walk whose document is unchanged."""

import sys

from ze_api import API, runtime_fail, result_json_data


failures = 0

# Twelve routes: enough that a lost row or a reordered walk is visible, and far
# inside the 256 lines the engine's answer queue guarantees.
ROUTES = 12


def dispatch(api, command):
    resp = api._call_engine(
        'ze-plugin-engine:dispatch-command', {'command': command})
    return resp.get('result', {})


def fail(message):
    global failures
    print(f'FAIL {message}', file=sys.stderr)
    failures += 1


def check_status(label, result):
    actual = result.get('status')
    if actual != 'done':
        fail(f'{label}: expected status=done, got={actual} data={result.get("data")!r}')
        return False
    print(f'OK {label}: status=done', file=sys.stderr)
    return True


def best_entries(label, result):
    data = result_json_data(result, {})
    if not isinstance(data, dict) or 'best-path' not in data:
        fail(f'{label}: no best-path envelope in {data!r}')
        return []
    entries = data['best-path']
    if not isinstance(entries, list):
        fail(f'{label}: best-path is not an array: {entries!r}')
        return []
    return entries


def main():
    global failures
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()

    api.wait_for_post_startup(timeout=5.0)
    if api.dispatch_until_done('show bgp rib status').get('status') != 'done':
        fail('rib plugin did not become ready')

    for i in range(ROUTES):
        cmd = (f'request bgp rib inject 10.0.0.1 ipv4/unicast 10.10.{i}.0/24 '
               f'aspath 64501,{64600 + i} nhop 10.0.0.1 localpref 100')
        if not check_status(f'inject-{i}', dispatch(api, cmd)):
            break

    # The whole walk. The envelope, the row shape and the row count are what an
    # operator and every buffered surface read.
    r = dispatch(api, 'show bgp rib best')
    if check_status('best', r):
        entries = best_entries('best', r)
        if len(entries) != ROUTES:
            fail(f'best: expected {ROUTES} rows, got {len(entries)}')
        else:
            print(f'OK best: {len(entries)} rows', file=sys.stderr)
        prefixes = sorted(e.get('prefix') for e in entries)
        want = sorted(f'10.10.{i}.0/24' for i in range(ROUTES))
        if prefixes != want:
            fail(f'best: prefixes {prefixes!r} != {want!r}')
        else:
            print('OK best: every injected prefix is a row', file=sys.stderr)
        first = entries[0] if entries else {}
        for field in ('family', 'prefix', 'best-peer', 'attributes'):
            if field not in first:
                fail(f'best: row is missing {field!r}: {first!r}')
        attrs = first.get('attributes', {})
        if attrs.get('next-hop') != '10.0.0.1':
            fail(f'best: row lost its next-hop: {attrs!r}')
        else:
            print('OK best: the row carries the attributes it was selected with', file=sys.stderr)

    # A bound folded into the command bounds the walk itself.
    r = dispatch(api, 'show bgp rib best first 2')
    if check_status('best-first', r):
        entries = best_entries('best-first', r)
        if len(entries) != 2:
            fail(f'best-first: expected 2 rows, got {len(entries)}')
        else:
            print('OK best-first: the walk stopped at two rows', file=sys.stderr)

    # A terminal still folds the same walk into one number.
    r = dispatch(api, 'show bgp rib best count')
    if check_status('best-count', r):
        data = result_json_data(r, {})
        if data.get('count') != ROUTES:
            fail(f'best-count: expected count={ROUTES}, got {data!r}')
        else:
            print(f'OK best-count: count={ROUTES}', file=sys.stderr)

    if failures > 0:
        msg = f'{failures} best-path walk assertions failed (see FAIL lines above)'
        print(f'\n{msg}', file=sys.stderr)
        sys.stderr.flush()
        runtime_fail(msg)
    dispatch(api, 'request shutdown')
    api.wait_for_shutdown()


if __name__ == '__main__':
    main()
EOF_RUN

# ze bgp configuration
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external rib-best-walk-test {
		run ./rib-best-walk-test.run
		encoder json
	}
	internal bgp-rib {
		use bgp-rib
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}

		attach process bgp-rib {
			receive [ update state refresh ]
			send [ update ]
		}
	}
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=ze-peer --mode sink --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=25s
expect=exit:code=0

# Readback: the plugin's own OK lines, one per walk shape. Without them this
# file's only assertion is a zero exit, which a plugin that never reached its
# assertions would also produce.
expect=stderr:contains=OK best: 12 rows
expect=stderr:contains=OK best-first: the walk stopped at two rows
expect=stderr:contains=OK best-count: count=12
