# Test: update bgp peer * prefix queries PeeringDB and updates config draft
# AC-1: PeeringDB query returns prefix counts, config updated with margin.
# AC-5: Custom PeeringDB URL is used.

# ze-peer expectations (session established, receives EOR)
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# Native test plugin: dispatches prefix update, verifies result

# ze bgp configuration with PeeringDB pointed at fake server
stdin=ze-bgp:terminator=EOF_CONF
system {
	peeringdb {
		url http://127.0.0.1:$PORT2
		margin 10
	}
}

plugin {
	external prefix-update-test {
		run "ze-test fixture plugin/api-peer-prefix-update"
		encoder json
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=ze-test peeringdb --port $PORT2
cmd=background:seq=2:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=3:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
