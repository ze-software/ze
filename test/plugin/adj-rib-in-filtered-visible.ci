# QUESTION: Does an rs-client peer's loop-denied UPDATE appear in `show bgp adj-rib-in` (json/yaml/table) marked filtered with filter-step "loop", stay absent from `show bgp rib`, and update `ze_adjribin_routes_filtered`?
# A unit test cannot decide real daemon startup, BGP session ingress loop denial, plugin delivery, CLI pipe rendering, and Prometheus metric export end to end.

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=30s
option=asn:value=65001
# 1. Loop-denied UPDATE (AS_PATH [65001, 65000]): 10.0.1.0/24. Retained in Adj-RIB-In marked filtered, excluded from RIB.
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF003302000000184001010040020A02020000FDE90000FDE840030401010101180A0001
# 2. Accepted control UPDATE (AS_PATH [65001]): 10.0.0.0/24. Stored in both Adj-RIB-In (filtered=false) and RIB.
action=send:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002F02000000144001010040020602010000FDE940030401010101180A0000
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
expect=bgp:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002D0306021741646D696E6973747261746976652053687574646F776E
EOF_PEER

stdin=ze-bgp:terminator=EOF_CONF
bus {
	endpoint rib {
		internal bgp-rib;
	}
	endpoint adj-rib-in {
		internal bgp-adj-rib-in;
	}
	endpoint filtered-visible-check {
		external {
			run "le test fixture plugin/adj-rib-in-filtered-visible";
		}
		encoding json;
	}
}
telemetry {
	prometheus {
		enabled true
		server main {
			ip 127.0.0.1;
			port $PORT2;
		}
	}
}
bgp {
	filter {
		import { final accept; }
		export { final accept; }
	}
	peer rs-client-peer {
		connection {
			remote { ip 127.0.0.1; }
			local { ip 127.0.0.1; accept false; }
		}
		session {
			asn { local 65000; remote 65001; }
			router-id 1.2.3.4
			rs-client true
			family { ipv4/unicast { prefix { maximum 10000; } } }
			capability { graceful-restart disable; }
		}
		behavior { group-updates disable; }
	}
}
EOF_CONF

cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=30s
expect=exit:code=0
expect=stderr:pattern=OK: adj-rib-in holds loop-denied 10.0.1.0/24
reject=stderr:pattern=panic
reject=stderr:pattern=fatal error
