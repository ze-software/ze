# Test: RIB show pipeline dispatch wiring
#
# Flow:
# 1. BGP session establishes, rib plugin sends EOR
# 2. Native test fixture dispatches rib show commands with pipeline args
# 3. Verifies community, path, family filters reach rib pipeline correctly
# 4. Verifies unknown pipeline keyword returns error status
# 5. Shuts down daemon via dispatch-command
#
# VALIDATES: Pipeline parameters are dispatched through the full command chain
#   (dispatch-command → tokenizer → longest-match → execute-command → parsePipelineArgs).
# PREVENTS: Pipeline args silently dropped or command routing broken.

# ze-peer expectations
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s

# ze sends its ipv4/unicast EOR after session setup, with no static routes ahead of
# it (RFC 4724 S2: the empty UPDATE). The observer gates `request shutdown` on
# eor-sent >= 1 (see wait_eor_sent below), so ze is given the chance to emit it
# rather than being torn down mid initial-sync.
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# Native test fixture: exercises dispatch-command with filter args

# ze bgp configuration
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external filter-test {
		run "ze-test fixture plugin/rib-filter-show"
		encoder json
	}
	internal bgp-rib {
		use bgp-rib
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}

		attach process bgp-rib {
			receive [ update state refresh ]
			send [ update ]
		}
	}
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
# runtime_fail emits this sentinel on the observer's stderr; without the reject the
# observer's assertion failures would be invisible to the runner.
reject=stderr:pattern=ZE-OBSERVER-FAIL
