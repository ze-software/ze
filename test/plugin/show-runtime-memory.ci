# Test: show runtime memory returns Go allocator stats (all platforms)
# Exercises: dispatch-command -> ze-show:system-memory -> handleShowSystemMemory
# Verifies the R9 rename `show runtime memory` dispatches and returns a JSON
# map of runtime.MemStats (alloc, heap-in-use, num-gc, ...). Unlike `show
# system memory` (OS /proc view, Linux-only), this is the Go runtime view and
# works on every platform, so no needs-linux gating.

# ze-peer: accepts connection
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
option=asn:value=65001
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

tmpfs=show-runtime-memory-test.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
import json
import sys
from ze_api import API, dispatch, runtime_fail, result_text_data


def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()
    api.wait_for_post_startup(timeout=5.0)

    try:
        resp = dispatch(api, 'show runtime memory')
        status = resp.get('status')
        data = result_text_data(resp)
        if status != 'done':
            runtime_fail(f'runtime-memory: status={status} data={data}')

        if isinstance(data, str) and data:
            data = json.loads(data)
        if not isinstance(data, dict):
            runtime_fail(f'runtime-memory: expected dict, got {type(data).__name__}')

        # runtime.MemStats-derived fields present on every platform.
        for key in ('alloc', 'heap-in-use', 'num-gc'):
            if key not in data:
                runtime_fail(f'runtime-memory: missing key {key!r} in {list(data.keys())}')

        print(f'OK: runtime memory returned {list(data.keys())}', file=sys.stderr)
    finally:
        dispatch(api, 'request shutdown')
        api.wait_for_shutdown()

if __name__ == '__main__':
    main()
EOF_RUN

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external show-runtime-memory-test {
		run ./show-runtime-memory-test.run
		encoder json
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast {
					prefix {
						maximum 10000
					}
				}
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}

		process show-runtime-memory-test {
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
