# Test: ze cli resolves credentials without a zefs credential store.
#
# VALIDATES: AC-6 -- a YANG user supplies --user + ze.ssh.password and logs in
#            with NO credential store readable at all.
# VALIDATES: AC-7 -- with no store and no username, the CLI fails with an error
#            naming --user and ze.ssh.password, and never attempts super-admin.
# PREVENTS: the production lockout. The store is a single shared 0600 file under
#           a binary-derived config dir (/usr/local/bin/ze -> /etc/ze), so every
#           user who did not install ze was refused with "open database:
#           permission denied" before their credentials were even considered --
#           even though the flag, env and defaults supplied everything needed.
#
# The store is made absent (an empty ZE_CONFIG_DIR, never `ze init`-ed) rather
# than chmod-ed: chmod cannot deny root, which would make this test pass
# vacuously wherever the suite runs as root. Absent and unreadable take the same
# errStoreUnavailable path in openStoreIfReadable.
#
# Flow:
# 1. Daemon starts with YANG user "alice".
# 2. ze cli --user alice, empty config dir -- AC-6: logs in, daemon says alice.
# 3. ze cli with no user, empty config dir -- AC-7: clear error, no super-admin.

tmpfs=test-cli-credential-resolution.sh:mode=755:terminator=EOF_SH
#!/bin/sh
set -e

touch daemon.ready

# bcrypt cost-4 hash of "testpass" -- same fixture as ssh-user-login-yang.ci.
PASSHASH='$2a$04$UlwuiuH82Unfsq.XEMPGJeDkXwbm3KW.nvVaVXOd/JeFK8VjMjrQO'

cat > cli-credential-resolution.conf << ZECONF
bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65533
				remote 65533
			}
		}
	}
}

system {
	authentication {
		user alice {
			password "$PASSHASH"
		}
	}
}

environment {
	ssh {
		enabled true
		server main {
			ip 127.0.0.1;
			port 0;
		}
	}
}
ZECONF

export ze_test_bgp_port=$((10000 + ($$ % 50000)))

ze start cli-credential-resolution.conf 2>daemon.log &
DAEMON_PID=$!
trap 'kill $DAEMON_PID 2>/dev/null; wait $DAEMON_PID 2>/dev/null' EXIT

SSH_PORT=""
for i in $(seq 1 50); do
	SSH_PORT=$(grep -o '127\.0\.0\.1:[0-9]*' daemon.log 2>/dev/null | head -1 | cut -d: -f2 || true)
	if [ -n "$SSH_PORT" ]; then
		break
	fi
	sleep 0.2
done
if [ -z "$SSH_PORT" ]; then
	echo "FAIL: SSH server did not start (no address in daemon.log)" >&2
	cat daemon.log >&2
	exit 1
fi
echo "SSH port: $SSH_PORT" >&2

sleep 0.5

# An empty config dir: no database.zefs, so no store, no super-admin username,
# and no default host/port pointer. Everything must come from flag and env.
EMPTY_DIR=$(mktemp -d)
trap 'rm -rf "$EMPTY_DIR"; kill $DAEMON_PID 2>/dev/null; wait $DAEMON_PID 2>/dev/null' EXIT

if [ -e "$EMPTY_DIR/database.zefs" ]; then
	echo "FAIL: test setup wrong -- the store must not exist" >&2
	exit 1
fi

# Test 1 (AC-6): --user alice + env password + explicit host/port, no store.
# ze.ssh.host / ze.ssh.port are required because the default pointer lives in the
# store we cannot read; this is the documented limitation, not a workaround.
DLOG_BEFORE=$(wc -c < daemon.log)
OUTPUT=$(ZE_CONFIG_DIR="$EMPTY_DIR" ZE_SSH_HOST="127.0.0.1" ZE_SSH_PORT="$SSH_PORT" \
	ZE_SSH_PASSWORD="testpass" ze cli --user alice -c "show bgp peer list" 2>&1) || {
	echo "FAIL: ze cli --user alice must log in with no credential store" >&2
	echo "OUTPUT: $OUTPUT" >&2
	cat daemon.log >&2
	exit 1
}

# Discriminator: the daemon must have authenticated THIS request as alice.
NEW_LOG=$(tail -c +$((DLOG_BEFORE + 1)) daemon.log)
if ! echo "$NEW_LOG" | grep -q 'SSH auth success.*username=alice'; then
	echo "FAIL: daemon did not log auth success for username=alice" >&2
	echo "NEW LOG: $NEW_LOG" >&2
	exit 1
fi
echo "OK: AC-6 -- alice logged in with no credential store" >&2

# Test 2 (AC-7): no username anywhere. Must fail with an actionable error and
# must NOT attempt the super-admin hash-as-token path (there is no store to read).
OUTPUT=$(ZE_CONFIG_DIR="$EMPTY_DIR" ZE_SSH_HOST="127.0.0.1" ZE_SSH_PORT="$SSH_PORT" \
	ze cli -c "show bgp peer list" 2>&1) && {
	echo "FAIL: ze cli with no store and no --user must not succeed" >&2
	echo "OUTPUT: $OUTPUT" >&2
	exit 1
}
if ! echo "$OUTPUT" | grep -q -- '--user'; then
	echo "FAIL: error must name --user as the way forward" >&2
	echo "OUTPUT: $OUTPUT" >&2
	exit 1
fi
if ! echo "$OUTPUT" | grep -q 'ze.ssh.password'; then
	echo "FAIL: error must name ze.ssh.password as the way forward" >&2
	echo "OUTPUT: $OUTPUT" >&2
	exit 1
fi
echo "OK: AC-7 -- no credentials gives an actionable error" >&2

echo "OK: all credential-resolution tests passed" >&2
exit 0
EOF_SH

cmd=foreground:seq=1:exec=./test-cli-credential-resolution.sh:timeout=15s
expect=exit:code=0
