# Test: redistribute-l2tp -- remove event becomes a BGP WITHDRAWN_ROUTES.
# VALIDATES: AC-9 -- session teardown after AC-6 results in peer receiving
#            WITHDRAWN_ROUTES for the previously announced /32.
# PREVENTS: Withdraw path missing or building wrong NLRI for L2TP routes.

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
# First the announce, then the withdraw. The wire expectations are what make
# ze-peer bind and check; the announce and the withdraw have DIFFERENT shapes:
#  seq=1 announce: attrs ORIGIN incomplete, empty AS_PATH (iBGP), NEXT_HOP
#        127.0.0.4 (ze's OWN address on this session, what `nhop self` resolves
#        to, not the peer's 127.0.0.1), LOCAL_PREF 100 (well-known mandatory on
#        iBGP, RFC 4271 5.1.5), then NLRI 10.0.0.1/32.
#  seq=2 withdraw: WITHDRAWN_ROUTES carries 10.0.0.1/32 and Total Path Attribute
#        Length is 0 (RFC 4271 4.3) -- a withdrawal carries NO attributes, so no
#        NEXT_HOP and no LOCAL_PREF. The announce recipe does not transfer.
# The two lines previously both used seq=1, which collides on one message index
# (connSeqToIndex) so the withdraw silently overwrote the announce expectation.
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00310200000015400101024002004003047F00000440050400000064200A000001
expect=json:conn=1:seq=1:json={"meta":{"version":"1.0.0","format":"ze-bgp"},"message":{"type":"update"},"peer":{"address":"127.0.0.1","remote":{"as":65533}},"direction":"in","origin":"incomplete","local-preference":100,"ipv4/unicast":[{"action":"add","nlri":["10.0.0.1/32"],"next-hop":"127.0.0.4"}]}
expect=bgp:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF001C020005200A0000010000
expect=json:conn=1:seq=2:json={"meta":{"version":"1.0.0","format":"ze-bgp"},"message":{"type":"update"},"peer":{"address":"127.0.0.1","remote":{"as":65533}},"direction":"in","ipv4/unicast":[{"action":"del","nlri":["10.0.0.1/32"]}]}
EOF_PEER

tmpfs=l2tp-withdraw-test.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
from ze_api import API, runtime_fail, result_json_data


def dispatch(api, command):
    return api._call_engine('ze-plugin-engine:dispatch-command', {'command': command}) or {}


def peer_field(api, field, default):
    result = dispatch(api, 'show bgp peer peer1 detail').get('result', {})
    if result.get('status') != 'done':
        return default
    data = result_json_data(result, {})
    return data.get('peers', {}).get('127.0.0.1', {}).get(field, default)


def wait_peer(api, predicate, what, cycles=100):
    for _ in range(cycles):
        if predicate():
            return
        api.wait_for_event(timeout=0.2)
    runtime_fail(f'timeout waiting for {what}')


def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()

    # There is NO engine defect here, and observer polling is innocent. An earlier
    # revision of this file claimed both, and was refuted on 2026-07-16; the full
    # account is in redistribute-l2tp-announce.ci. In short: an expect=json-only
    # peer block leaves ze-peer with nothing to check, so it exits before binding
    # and ze dials a dead port. Polling during connect is provably harmless
    # (spec-fixit-redistribute-establishment-stall, E6/E9).
    #
    # This observer stays dispatch-silent for one reason only: its sleep/wait
    # conversion has not been done. Nothing here is waiting on an engine fix. The
    # runner's wire expectations (add then withdraw) decide the verdict.
    for _ in range(10):
        api.wait_for_event(timeout=0.2)

    for cmd in (
        'request fakel2tp emit add ipv4/unicast 10.0.0.1/32',
        'request fakel2tp emit remove ipv4/unicast 10.0.0.1/32',
    ):
        resp = dispatch(api, cmd)
        result = resp.get('result', {})
        if result.get('status') != 'done':
            runtime_fail(f'{cmd}: {result}')
            return
        # Ordered-delivery window between add and remove (event-wait backoff).
        for _ in range(3):
            api.wait_for_event(timeout=0.2)

    for _ in range(10):
        api.wait_for_event(timeout=0.2)
    dispatch(api, 'request shutdown')
    api.wait_for_shutdown()


if __name__ == '__main__':
    main()
EOF_RUN

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external l2tp-withdraw-test {
		run ./l2tp-withdraw-test.run
		encoder json
	}
	internal redistribute-orchestrator {
		use redistribute-orchestrator
	}
	internal fakel2tp {
		use fakel2tp
	}
}

redistribute {
	destination bgp {
		import l2tp {
			family [ ipv4/unicast ];
		}
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			# Ze's own address on this session, and what `nhop self` puts on the
			# wire. Deliberately NOT the peer's 127.0.0.1: RFC 4271 Section 5.1.3
			# forbids advertising a peer an address of that peer as NEXT_HOP.
			local {
				ip 127.0.0.4
				accept false
			}
		}
		session {
			asn {
				local 65533
				remote 65533
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		attach process redistribute-orchestrator {
			send [ update ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
# // expect=exit:code=0 removed -- this STRENGTHENS the test. Coverage
# is replaced by the ze-peer wire expectations above, which now govern the verdict.
# The exit-code line asserted nothing about BGP and, until 2026-07-16, actively
# disabled the peer check and validateJSON (spec-fixit-redistribute-establishment-stall, D2).
