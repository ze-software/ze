cmd=foreground:seq=1:exec=ze init:stdin=init-answers:exit=0

# --- Run 1: default respawn ---
cmd=background:seq=2:name=peer1:exec=le test peer --bind 127.0.0.2 --port $PORT:stdin=edge1-r1
cmd=background:seq=3:name=daemon1:exec=ze start run1-respawn.conf:ready=Ze running.
reject=stderr:pattern=capability conflict
reject=stderr:pattern=panic

cmd=foreground:seq=4:exec=le test fixture plugin/bus-wait-file r1.gen1:exit=0
expect=stdout:contains=OK: marker file r1.gen1 appeared
cmd=foreground:seq=5:exec=le test fixture daemon/await-answer-all "show bgp rib" 203.0.113.0/24:exit=0
expect=stdout:contains=OK:

# Trigger exit 3 -> withdraw -> ProcessManager respawns wrapper with NEW PID -> Stage 3 accepted -> re-announce.
cmd=foreground:seq=6:exec=le test fixture plugin/bus-touch-file exit1.go:exit=0
expect=stdout:contains=OK: wrote marker file exit1.go

cmd=foreground:seq=7:exec=le test fixture plugin/bus-wait-file r1.gen2:exit=0
expect=stdout:contains=OK: marker file r1.gen2 appeared

cmd=foreground:seq=8:exec=le test fixture daemon/await-answer-all "show bgp peer edge1 detail | json" '"updates-sent": 4':exit=0
expect=stdout:contains=OK:
cmd=foreground:seq=9:exec=le test fixture daemon/await-answer-all "show bgp rib" 203.0.113.0/24:exit=0
expect=stdout:contains=OK:
cmd=foreground:seq=10:exec=python3 verify-pids.py two-distinct respawn.pids:exit=0
expect=stdout:contains=OK: wrapper respawned with new PID

cmd=stop:seq=11:name=daemon1:signal=term
cmd=stop:seq=12:name=peer1

# --- Run 2: external { respawn false; } ---
cmd=background:seq=13:name=peer2:exec=le test peer --bind 127.0.0.2 --port $PORT:stdin=edge1-r2
cmd=background:seq=14:name=daemon2:exec=ze start run2-norespawn.conf:ready=Ze running.
reject=stderr:pattern=panic

cmd=foreground:seq=15:exec=le test fixture plugin/bus-wait-file r2.gen1:exit=0
expect=stdout:contains=OK: marker file r2.gen1 appeared
cmd=foreground:seq=16:exec=le test fixture daemon/await-answer-all "show bgp rib" 203.0.113.0/24:exit=0
expect=stdout:contains=OK:

cmd=foreground:seq=17:exec=le test fixture plugin/bus-touch-file exit2.go:exit=0
expect=stdout:contains=OK: wrote marker file exit2.go

cmd=foreground:seq=18:exec=le test fixture daemon/await-answer-all "show warnings | json" doctor-plugin-stopped:exit=0
expect=stdout:contains=OK:
cmd=foreground:seq=19:exec=le test fixture daemon/await-answer-all "show bgp peer edge1 detail | json" '"updates-sent": 3':exit=0
expect=stdout:contains=OK:
cmd=foreground:seq=20:exec=ze cli -c "show bgp rib":exit=0
reject=stdout:contains=203.0.113.0/24
cmd=foreground:seq=21:exec=python3 verify-pids.py exactly-one norespawn.pids:exit=0
expect=stdout:contains=OK: respawn false kept single wrapper PID

cmd=stop:seq=22:name=daemon2:signal=term
cmd=stop:seq=23:name=peer2

# --- Run 3: external { on-exit keep; respawn false; } ---
cmd=background:seq=24:name=peer3:exec=le test peer --bind 127.0.0.2 --port $PORT:stdin=edge1-r3
