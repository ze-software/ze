# Test: rpki event shows "unavailable" when no RTR cache data
# VALIDATES: Empty ROA cache produces "unavailable" rpki event (AC-6)
# PREVENTS: rpki plugin crashing or sending empty results when cache is empty

# ze-peer: send route
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
option=update:value=send-route:prefix=10.0.1.0/24:origin-as=65001:next-hop=10.0.0.1
# EOR from ze
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# native test plugin: verifies rpki event shows "unavailable"
# Native compiled fixture: plugin/rpki-event-unavailable
# Config with rpki plugin but NO RTR server (cache will be empty)
stdin=ze-bgp:terminator=EOF_CONF
bus {
	endpoint rpki {
		internal bgp-rpki;
	}
	endpoint adj-rib-in {
		internal bgp-adj-rib-in;
	}
	endpoint rpki-unavail-test {
		external {
			run "le test fixture plugin/rpki-event-unavailable";
		}
		encoding json;
	}
	hub {
		server local {
			ip 127.0.0.1;
			port 0;
			secret rpki-test-secret-key-01234567890;
		}
	}
}

bgp {
	rpki {
		cache-server 127.0.0.1 {
			trusted-network true
			port 19999
		}
	}
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}

	}
}
EOF_CONF

# No RTR server -- cache will be empty
cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
