# Test: show ping with do-not-fragment over a clamped path reports the MTU
# Spec: spec-probe-do-not-fragment -- user story 1, AC-2, AC-3, AC-5, AC-6 (closed 2026-09-15)
# VALIDATES: an operator runs `show ping <address> size 1500 do-not-fragment`
#            over a path whose middle router clamps its far link to 1400. The
#            probe socket carries IP_MTU_DISCOVER, the router refuses the probe,
#            the kernel queues the ICMP error, and the payload names the router's
#            answer: reply status `too-big`, `next-hop-mtu-reported` true and
#            `next-hop-mtu` 1400, on the reply and on the summary. The
#            `bypass-cache` value gives the same answer because the router, not
#            the cache, refuses it. A 1300-octet DF probe is answered first, so
#            the refusal is the size and never the path.
# PREVENTS: a DF keyword the grammar accepts and the socket never honors, a
#           probe fragmented in silence and answered as if it fit, and a
#           reported MTU dropped by the receive loop as a datagram that is not
#           an echo reply.
#
# The path is three network namespaces joined by veth pairs: the daemon runs in
# the sender namespace, the router forwards with its far link at 1400, and the
# far namespace answers. Building them needs CAP_NET_ADMIN and the raw ICMP
# socket needs CAP_NET_RAW, so the test runs in the QEMU guest as root
# (`./le qemu all-tests`, `packages "iproute2"` for `ip netns`) and skips in the
# unprivileged merge gate. The script removes the namespaces when the daemon
# exits, whatever its exit code.

option=needs-linux:caps=net-admin,net-raw
option=env:var=ze.storage.blob:value=false

tmpfs=probe.conf:terminator=EOF_CONF
plugin {
	external ping-df-test {
		run "ze-test fixture plugin/ping-do-not-fragment"
		encoder json
	}
}
EOF_CONF

tmpfs=clamped-path.sh:mode=755:terminator=EOF_SH
#!/bin/sh
# sender (10.99.1.1) -- 1600 -- router -- 1400 -- far (10.99.2.1). The near link
# carries the 1528-octet probe, so the router and not the sender refuses it.
S=zedfs$PORT
R=zedfr$PORT
F=zedff$PORT
cleanup() {
	ip netns del "$S" 2>/dev/null
	ip netns del "$R" 2>/dev/null
	ip netns del "$F" 2>/dev/null
}
trap cleanup EXIT
set -e
ip netns add "$S"
ip netns add "$R"
ip netns add "$F"
ip -n "$S" link add sr0 type veth peer name rs0 netns "$R"
ip -n "$R" link add rf0 type veth peer name fr0 netns "$F"
ip -n "$S" link set lo up
ip -n "$R" link set lo up
ip -n "$F" link set lo up
ip -n "$S" link set sr0 up mtu 1600
ip -n "$R" link set rs0 up mtu 1600
ip -n "$R" link set rf0 up mtu 1400
ip -n "$F" link set fr0 up mtu 1400
ip -n "$S" addr add 10.99.1.1/24 dev sr0
ip -n "$R" addr add 10.99.1.2/24 dev rs0
ip -n "$R" addr add 10.99.2.2/24 dev rf0
ip -n "$F" addr add 10.99.2.1/24 dev fr0
ip -n "$S" route add 10.99.2.0/24 via 10.99.1.2 dev sr0
ip -n "$F" route add 10.99.1.0/24 via 10.99.2.2 dev fr0
ip netns exec "$R" sh -c 'echo 1 > /proc/sys/net/ipv4/ip_forward'
set +e
ip netns exec "$S" ze start probe.conf
exit $?
EOF_SH

cmd=foreground:seq=1:exec=sh clamped-path.sh:timeout=40s
expect=exit:code=0
expect=stderr:contains=OK: a DF probe over the clamp reported next-hop-mtu 1400 in both modes, and one under it was answered
reject=stderr:pattern=ZE-OBSERVER-FAIL
reject=stderr:pattern=panic recovered
