# Test: RPKI validation timeout promotes route (fail-open)
# VALIDATES: Route promoted after timeout when RPKI plugin cannot validate (AC-9)
# PREVENTS: Routes stuck in pending state forever when RTR server unreachable

# ze-peer: send route (no RTR server -> RPKI has no VRPs -> validation hangs in pending)
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=45s
option=linger:value=true
option=update:value=send-route:prefix=10.0.1.0/24:origin-as=65001:next-hop=10.0.0.1
# EOR from ze
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# Native observer fixture: plugin/rpki-timeout.

# Use short validation timeout (5s) for testing
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	hub {
		server local {
			ip 127.0.0.1;
			port 0;
			secret rpki-test-secret-key-01234567890;
		}
	}
	external rpki-timeout-test {
		run "ze-test fixture plugin/rpki-timeout"
		encoder json
	}
	internal rpki {
		use bgp-rpki
	}
	internal adj-rib-in {
		use bgp-adj-rib-in
	}
}

bgp {
	rpki {
		cache-server 127.0.0.1 {
			port 19999
		}
		validation-timeout 5
	}
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}

		attach process rpki {
			receive [ update-received ]
		}
		attach process adj-rib-in {
			receive [ update-received state ]
		}
	}
}
EOF_CONF

# NO ze-test rtr-mock: RPKI plugin has no cache, validation cannot complete
cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=40s
expect=exit:code=0
