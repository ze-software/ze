# Test: RPKI validation timeout promotes route (fail-open)
# VALIDATES: Route promoted after timeout when RPKI plugin cannot validate (AC-9)
# PREVENTS: Routes stuck in pending state forever when RTR server unreachable

# ze-peer: send route (no RTR server -> RPKI has no VRPs -> validation hangs in pending)
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=45s
option=update:value=send-route:prefix=10.0.1.0/24:origin-as=65001:next-hop=10.0.0.1
# EOR from ze
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

tmpfs=rpki-timeout-test.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
import json
import sys
import time
from ze_api import API, result_text_data

def dispatch(api, command):
    resp = api._call_engine(
        'ze-plugin-engine:dispatch-command', {'command': command})
    if resp is None:
        return {'status': 'error', 'data': 'engine call returned None'}
    return resp.get('result', {})

def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()

    # Poll adj-rib-in until the route is promoted out of pending (fail-open).
    # The route starts in validation-state 4 (pending) and, after the 5s
    # validation-timeout, is promoted to a non-pending state. Deterministic
    # replacement for a blind time.sleep: poll until present AND not state 4.
    # // test-relax: blind sleep(12.0) -> dispatch_until poll (route present, promoted out of state 4)
    def _promoted(r):
        d = result_text_data(r)
        return '10.0.1.0/24' in d and (
            '"validation-state":4' not in d and '"validation-state": 4' not in d)

    try:
        result = api.dispatch_until('show bgp rib received', _promoted, attempts=60, delay=0.5)
        if result.get('status') != 'done':
            print(f'FAIL: rib routes received status={result.get("status")}', file=sys.stderr)
            sys.exit(1)

        data = result_text_data(result)
        # Route should be promoted after timeout (fail-open)
        if '10.0.1.0/24' not in data:
            print(f'FAIL: route 10.0.1.0/24 not promoted after timeout: {data}', file=sys.stderr)
            sys.exit(1)

        # Fail-open means the route must be PROMOTED, not merely present: reject
        # a route still stuck in validation-state 4 (pending) after the timeout.
        if '"validation-state":4' in data or '"validation-state": 4' in data:
            print(f'FAIL: route 10.0.1.0/24 still pending (state 4) after timeout: {data}', file=sys.stderr)
            sys.exit(1)

        print('OK: route 10.0.1.0/24 promoted after timeout (fail-open)', file=sys.stderr)
    finally:
        dispatch(api, 'request shutdown')
        api.wait_for_shutdown()

if __name__ == '__main__':
    main()
EOF_RUN

# Use short validation timeout (5s) for testing
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	hub {
		server local {
			ip 127.0.0.1;
			port 0;
			secret rpki-test-secret-key-01234567890;
		}
	}
	external rpki-timeout-test {
		run ./rpki-timeout-test.run
		encoder json
	}
	internal rpki {
		use bgp-rpki
	}
	internal adj-rib-in {
		use bgp-adj-rib-in
	}
}

bgp {
	rpki {
		cache-server 127.0.0.1 {
			port 19999
		}
		validation-timeout 5
	}
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}

		attach process rpki {
			receive [ update-received ]
		}
		attach process adj-rib-in {
			receive [ update-received state ]
		}
	}
}
EOF_CONF

# NO ze-test rtr-mock: RPKI plugin has no cache, validation cannot complete
cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=40s
expect=exit:code=0
