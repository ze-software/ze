# Test: RPF lookup against multicast Loc-RIB
# VALIDATES: bgp rib rpf command performs LPM against multicast routes in Loc-RIB
# PREVENTS: RPF command not wired, LPM not working through sharded Loc-RIB

# ze-peer expectations
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s

# ze-peer runs as a sink: only a dial target, asserts nothing. This test is about
# RPF/multicast state; the BGP peer exists so ze has a session to configure.
#
# // test-relax: the ipv4/unicast EOR this block declared was unreachable BY
# CONSTRUCTION -- the run-script calls `request shutdown` at post-startup, so ze
# closes during the OPEN handshake ("open recv / open sent / connection closed
# before completion") and the EOR is never sent. It could not fail for a real
# reason, only pass vacuously (pre-F1) or hang the verdict (post-F1). Coverage is
# NOT reduced: this test never asserted BGP wire content -- its own assertions and
# expect=exit:code=0 are what it proves. Per
# plan/spec-fixit-redistribute-establishment-stall.md the honest fixes are
# --mode sink (peer is scaffolding, as here) or reaching Established first, which
# would test BGP rather than this test's subject.
EOF_PEER

# Python test plugin: injects multicast routes then queries RPF
tmpfs=rpf-multicast-test.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
import sys
import json
from ze_api import API, result_json_data, result_text_data, runtime_fail
# // test-relax: removed unused 'import time'; blind sleep is now a dispatch_until poll

def dispatch(api, command):
    resp = api._call_engine(
        'ze-plugin-engine:dispatch-command', {'command': command})
    if resp is None:
        return {'status': 'error', 'data': 'engine call returned None'}
    return resp.get('result', {})

def eor_on_wire(result):
    """True once peer1's initial-sync End-of-RIB has been written."""
    if result.get('status') != 'done':
        return False
    data = result_text_data(result, '{}')
    try:
        parsed = json.loads(data) if isinstance(data, str) else data
    except (json.JSONDecodeError, TypeError, ValueError):
        return False
    if not isinstance(parsed, dict):
        return False
    peers = parsed.get('peers', {})
    if not isinstance(peers, dict):
        return False
    return any(isinstance(row, dict) and row.get('eor-sent', 0) >= 1
               for row in peers.values())

def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()
    api.wait_for_post_startup(timeout=5.0)

    # Let peer1 finish its initial sync before shutting down. The old script
    # dispatched and shut down inside the OPEN handshake, so ze closed the
    # session before ever sending its End-of-RIB and the peer's expectation
    # was unreachable by construction.
    synced = api.dispatch_until(
        'show bgp peer peer1 detail', eor_on_wire, attempts=60,
    )
    if not eor_on_wire(synced):
        runtime_fail('peer1 never sent its initial-sync End-of-RIB')

    try:
        # Inject multicast routes at two specificity levels
        result = dispatch(api, 'request bgp rib inject 10.0.0.99 ipv4/multicast 224.0.0.0/4 nhop 10.0.0.1')
        if result.get('status') != 'done':
            print(f'FAIL: inject /4 status={result.get("status")} err={result.get("data")}', file=sys.stderr)
            sys.exit(1)

        result = dispatch(api, 'request bgp rib inject 10.0.0.99 ipv4/multicast 224.1.0.0/16 nhop 10.0.0.2')
        if result.get('status') != 'done':
            print(f'FAIL: inject /16 status={result.get("status")} err={result.get("data")}', file=sys.stderr)
            sys.exit(1)

        # Wait for best-path computation to propagate to Loc-RIB.
        # // test-relax: blind sleep(0.5) -> dispatch_until poll until the /16 lands in multicast Loc-RIB
        api.dispatch_until(
            'show bgp rib rpf ipv4/multicast 224.1.2.5',
            lambda r: result_json_data(r, {}).get('matched-prefix') == '224.1.0.0/16',
        )

        # RPF query: should match the /16 (more specific)
        result = dispatch(api, 'show bgp rib rpf ipv4/multicast 224.1.2.5')
        if result.get('status') != 'done':
            print(f'FAIL: rpf status={result.get("status")} err={result.get("data")}', file=sys.stderr)
            sys.exit(1)

        data = result_json_data(result, {})
        if not data.get('found'):
            print(f'FAIL: rpf found=false, expected match: {data}', file=sys.stderr)
            sys.exit(1)
        if data.get('matched-prefix') != '224.1.0.0/16':
            print(f'FAIL: rpf matched-prefix={data.get("matched-prefix")}, expected 224.1.0.0/16', file=sys.stderr)
            sys.exit(1)

        # RPF query: no match
        result = dispatch(api, 'show bgp rib rpf ipv4/multicast 192.168.1.1')
        if result.get('status') != 'done':
            print(f'FAIL: rpf no-match status={result.get("status")}', file=sys.stderr)
            sys.exit(1)

        data = result_json_data(result, {})
        if data.get('found') != False:
            print(f'FAIL: rpf should be found=false for non-multicast addr: {data}', file=sys.stderr)
            sys.exit(1)

        # RPF query: non-CIDR family should error
        result = dispatch(api, 'show bgp rib rpf l2vpn/evpn 10.0.0.1')
        if result.get('status') != 'error':
            print(f'FAIL: rpf non-CIDR should error, got status={result.get("status")}', file=sys.stderr)
            sys.exit(1)

        print('OK: rpf multicast verified', file=sys.stderr)
    finally:
        dispatch(api, 'request shutdown')
        api.wait_for_shutdown()

if __name__ == '__main__':
    main()
EOF_RUN

# ze bgp configuration
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external rpf-multicast-test {
		run ./rpf-multicast-test.run
		encoder json
	}
	internal bgp-rib {
		use bgp-rib
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/multicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}

		process rpf-multicast-test {
		}
		process bgp-rib {
			receive [ state ]
			send [ update ]
		}
	}
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=ze-peer --mode sink --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
