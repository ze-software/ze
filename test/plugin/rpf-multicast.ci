# Test: RPF lookup against multicast Loc-RIB
# VALIDATES: bgp rib rpf command performs LPM against multicast routes in Loc-RIB
# PREVENTS: RPF command not wired, LPM not working through sharded Loc-RIB

# ze-peer expectations
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s

# peer1 negotiates ipv4/multicast ONLY (see the session family block below), so
# ze's initial-sync End-of-RIB for this session is the ipv4/multicast EOR.
#
# Derived from RFC 4724 Section 2 + RFC 4760, BEFORE reading ze's encoder:
#   "For any other address family, it [the End-of-RIB marker] is an UPDATE
#    message that contains only the MP_UNREACH_NLRI attribute with no withdrawn
#    routes for that <AFI, SAFI>."
#   ipv4/multicast = AFI 1, SAFI 2. MP_UNREACH_NLRI = attr type 15 (0x0F),
#   optional => flag bit 0x80; value = AFI(0001) + SAFI(02), no withdrawn routes.
#   UPDATE body = Withdrawn Routes Length(0000) + Total Path Attr Length + attr.
#
# RFC 4271 Section 4.3 leaves the Extended Length bit (0x10) to the SENDER for
# attributes shorter than 256 octets: it MUST be set when the value exceeds 255
# octets, and is otherwise permitted but not mandated. So the derivation above
# fixes the EOR's semantics but NOT this one bit. ze chooses the extended-length
# encoding unconditionally here (message/eor.go BuildEOR passes
# FlagOptional|FlagExtLength; attribute.WriteHeaderTo then writes a 4-byte
# header), giving a 7-byte attribute 900F0003000102 and total path attr len 7:
#   marker(16 x FF) 001E 02 0000 0007 900F0003000102   => length 19+11 = 30 = 0x1E
# Both encodings are RFC-legal and semantically identical; the bytes below are
# ze's choice, and every field except that bit is pinned by the derivation.
#
# The run-script gates `request shutdown` on eor-sent >= 1, so this EOR is
# reachable: ze reaches Established and writes it before the session closes.
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF001E0200000007900F0003000102
EOF_PEER

# native test plugin: injects multicast routes then queries RPF
# Native compiled fixture: plugin/rpf-multicast
# ze bgp configuration
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external rpf-multicast-test {
		run "ze-test fixture plugin/rpf-multicast"
		encoder json
	}
	internal bgp-rib {
		use bgp-rib
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/multicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}

		attach process bgp-rib {
			receive [ update state refresh ]
			send [ update ]
		}
	}
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
