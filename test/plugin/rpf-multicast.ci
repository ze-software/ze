# Test: RPF lookup against multicast Loc-RIB
# VALIDATES: bgp rib rpf command performs LPM against multicast routes in Loc-RIB
# PREVENTS: RPF command not wired, LPM not working through sharded Loc-RIB

# ze-peer expectations
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# Python test plugin: injects multicast routes then queries RPF
tmpfs=rpf-multicast-test.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
import sys
import json
import time
from ze_api import API

def dispatch(api, command):
    resp = api._call_engine(
        'ze-plugin-engine:dispatch-command', {'command': command})
    if resp is None:
        return {'status': 'error', 'data': 'engine call returned None'}
    return resp.get('result', {})

def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()
    api.wait_for_post_startup(timeout=5.0)

    try:
        # Inject multicast routes at two specificity levels
        result = dispatch(api, 'request bgp rib inject 10.0.0.99 ipv4/multicast 224.0.0.0/4 nhop 10.0.0.1')
        if result.get('status') != 'done':
            print(f'FAIL: inject /4 status={result.get("status")} err={result.get("data")}', file=sys.stderr)
            sys.exit(1)

        result = dispatch(api, 'request bgp rib inject 10.0.0.99 ipv4/multicast 224.1.0.0/16 nhop 10.0.0.2')
        if result.get('status') != 'done':
            print(f'FAIL: inject /16 status={result.get("status")} err={result.get("data")}', file=sys.stderr)
            sys.exit(1)

        # Wait for best-path computation to propagate to Loc-RIB
        time.sleep(0.5)

        # RPF query: should match the /16 (more specific)
        result = dispatch(api, 'show bgp rib rpf ipv4/multicast 224.1.2.5')
        if result.get('status') != 'done':
            print(f'FAIL: rpf status={result.get("status")} err={result.get("data")}', file=sys.stderr)
            sys.exit(1)

        data = json.loads(result.get('data', '{}'))
        if not data.get('found'):
            print(f'FAIL: rpf found=false, expected match: {data}', file=sys.stderr)
            sys.exit(1)
        if data.get('matched-prefix') != '224.1.0.0/16':
            print(f'FAIL: rpf matched-prefix={data.get("matched-prefix")}, expected 224.1.0.0/16', file=sys.stderr)
            sys.exit(1)

        # RPF query: no match
        result = dispatch(api, 'show bgp rib rpf ipv4/multicast 192.168.1.1')
        if result.get('status') != 'done':
            print(f'FAIL: rpf no-match status={result.get("status")}', file=sys.stderr)
            sys.exit(1)

        data = json.loads(result.get('data', '{}'))
        if data.get('found') != False:
            print(f'FAIL: rpf should be found=false for non-multicast addr: {data}', file=sys.stderr)
            sys.exit(1)

        # RPF query: non-CIDR family should error
        result = dispatch(api, 'show bgp rib rpf l2vpn/evpn 10.0.0.1')
        if result.get('status') != 'error':
            print(f'FAIL: rpf non-CIDR should error, got status={result.get("status")}', file=sys.stderr)
            sys.exit(1)

        print('OK: rpf multicast verified', file=sys.stderr)
    finally:
        dispatch(api, 'daemon shutdown')
        api.wait_for_shutdown()

if __name__ == '__main__':
    main()
EOF_RUN

# ze bgp configuration
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external rpf-multicast-test {
		run ./rpf-multicast-test.run
		encoder json
	}
	internal bgp-rib {
		use bgp-rib
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/multicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}

		process rpf-multicast-test {
		}
		process bgp-rib {
			receive [ state ]
			send [ update ]
		}
	}
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
