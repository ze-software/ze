# Test: RPF lookup against multicast Loc-RIB
# VALIDATES: bgp rib rpf command performs LPM against multicast routes in Loc-RIB
# PREVENTS: RPF command not wired, LPM not working through sharded Loc-RIB

# ze-peer expectations
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s

# peer1 negotiates ipv4/multicast ONLY (see the session family block below), so
# ze's initial-sync End-of-RIB for this session is the ipv4/multicast EOR.
#
# Derived from RFC 4724 Section 2 + RFC 4760, BEFORE reading ze's encoder:
#   "For any other address family, it [the End-of-RIB marker] is an UPDATE
#    message that contains only the MP_UNREACH_NLRI attribute with no withdrawn
#    routes for that <AFI, SAFI>."
#   ipv4/multicast = AFI 1, SAFI 2. MP_UNREACH_NLRI = attr type 15 (0x0F),
#   optional => flag bit 0x80; value = AFI(0001) + SAFI(02), no withdrawn routes.
#   UPDATE body = Withdrawn Routes Length(0000) + Total Path Attr Length + attr.
#
# RFC 4271 Section 4.3 leaves the Extended Length bit (0x10) to the SENDER for
# attributes shorter than 256 octets: it MUST be set when the value exceeds 255
# octets, and is otherwise permitted but not mandated. So the derivation above
# fixes the EOR's semantics but NOT this one bit. ze chooses the extended-length
# encoding unconditionally here (message/eor.go BuildEOR passes
# FlagOptional|FlagExtLength; attribute.WriteHeaderTo then writes a 4-byte
# header), giving a 7-byte attribute 900F0003000102 and total path attr len 7:
#   marker(16 x FF) 001E 02 0000 0007 900F0003000102   => length 19+11 = 30 = 0x1E
# Both encodings are RFC-legal and semantically identical; the bytes below are
# ze's choice, and every field except that bit is pinned by the derivation.
#
# The run-script gates `request shutdown` on eor-sent >= 1, so this EOR is
# reachable: ze reaches Established and writes it before the session closes.
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF001E0200000007900F0003000102
EOF_PEER

# Python test plugin: injects multicast routes then queries RPF
tmpfs=rpf-multicast-test.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
import sys
import json
from ze_api import API, result_json_data, result_text_data, runtime_fail
# // test-relax: removed unused 'import time'; blind sleep is now a dispatch_until poll

def dispatch(api, command):
    """Dispatch a command and return its result envelope.

    An RPC-level error means the command never reached the plugin at all -- it
    is not declared in the plugin's sdk.Registration.Commands, so the engine's
    registry cannot route it. That is a WIRING failure, distinct from a plugin
    handler that ran and returned status=error (the non-CIDR case below), so
    surface it through runtime_fail rather than letting it surface as a bare
    traceback whose sentinel a later shutdown could race away.
    """
    try:
        resp = api._call_engine(
            'ze-plugin-engine:dispatch-command', {'command': command})
    except RuntimeError as exc:
        runtime_fail(f'dispatch {command!r} rejected by the engine: {exc}')
        raise
    if resp is None:
        runtime_fail(f'dispatch {command!r}: engine call returned None')
    return resp.get('result', {})

def eor_on_wire(result):
    """True once peer1's initial-sync End-of-RIB has been written."""
    if result.get('status') != 'done':
        return False
    data = result_text_data(result, '{}')
    try:
        parsed = json.loads(data) if isinstance(data, str) else data
    except (json.JSONDecodeError, TypeError, ValueError):
        return False
    if not isinstance(parsed, dict):
        return False
    peers = parsed.get('peers', {})
    if not isinstance(peers, dict):
        return False
    return any(isinstance(row, dict) and row.get('eor-sent', 0) >= 1
               for row in peers.values())

def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()
    api.wait_for_post_startup(timeout=5.0)

    # Let peer1 finish its initial sync before shutting down. This gate is what
    # makes the peer's EOR expectation reachable: `eor-sent` is incremented at
    # the EOR write itself, so polling it (rather than trusting state=established,
    # which is reached BEFORE the EOR is sent) guarantees the marker is on the
    # wire before the run-script asks ze to shut down. Without it the script
    # shut down inside the OPEN handshake and no EOR was ever written.
    synced = api.dispatch_until(
        'show bgp peer peer1 detail', eor_on_wire, attempts=60,
    )
    if not eor_on_wire(synced):
        runtime_fail('peer1 never sent its initial-sync End-of-RIB')

    # Every check below reports through runtime_fail, never `print(...) +
    # sys.exit(1)`: ze_api.runtime_fail's own docstring records that the old
    # pattern is a silent no-op (ze exits 0, the observer's exit code never
    # reaches the runner, the runner reports success). This test carried that
    # pattern AND a `finally: request shutdown`, which additionally tore down
    # the engine -- and with it the plugin stderr relay -- before an uncaught
    # exception's ZE-OBSERVER-FAIL sentinel could ever be relayed. Both defects
    # are why `# PREVENTS: RPF command not wired` never fired while the command
    # was in fact unreachable. Shutdown is now on the success path only;
    # runtime_fail performs its own clean shutdown on the failure path.

    # Inject multicast routes at two specificity levels
    result = dispatch(api, 'request bgp rib inject 10.0.0.99 ipv4/multicast 224.0.0.0/4 nhop 10.0.0.1')
    if result.get('status') != 'done':
        runtime_fail(f'inject /4 status={result.get("status")} err={result.get("data")}')

    result = dispatch(api, 'request bgp rib inject 10.0.0.99 ipv4/multicast 224.1.0.0/16 nhop 10.0.0.2')
    if result.get('status') != 'done':
        runtime_fail(f'inject /16 status={result.get("status")} err={result.get("data")}')

    # Wait for best-path computation to propagate to Loc-RIB.
    # // test-relax: blind sleep(0.5) -> dispatch_until poll until the /16 lands in multicast Loc-RIB
    api.dispatch_until(
        'show bgp rib rpf ipv4/multicast 224.1.2.5',
        lambda r: result_json_data(r, {}).get('matched-prefix') == '224.1.0.0/16',
    )

    # RPF query: should match the /16 (more specific)
    result = dispatch(api, 'show bgp rib rpf ipv4/multicast 224.1.2.5')
    if result.get('status') != 'done':
        runtime_fail(f'rpf status={result.get("status")} err={result.get("data")}')

    data = result_json_data(result, {})
    if not data.get('found'):
        runtime_fail(f'rpf found=false, expected match: {data}')
    if data.get('matched-prefix') != '224.1.0.0/16':
        runtime_fail(f'rpf matched-prefix={data.get("matched-prefix")}, expected 224.1.0.0/16')

    # RPF query: no match
    result = dispatch(api, 'show bgp rib rpf ipv4/multicast 192.168.1.1')
    if result.get('status') != 'done':
        runtime_fail(f'rpf no-match status={result.get("status")}')

    data = result_json_data(result, {})
    if data.get('found') is not False:
        runtime_fail(f'rpf should be found=false for non-multicast addr: {data}')

    # RPF query: non-CIDR family should error. The handler RUNS and returns
    # status=error, so this arrives as a result envelope, not an RPC error.
    result = dispatch(api, 'show bgp rib rpf l2vpn/evpn 10.0.0.1')
    if result.get('status') != 'error':
        runtime_fail(f'rpf non-CIDR should error, got status={result.get("status")}')

    print('OK: rpf multicast verified', file=sys.stderr)
    dispatch(api, 'request shutdown')
    api.wait_for_shutdown()

if __name__ == '__main__':
    main()
EOF_RUN

# ze bgp configuration
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external rpf-multicast-test {
		run ./rpf-multicast-test.run
		encoder json
	}
	internal bgp-rib {
		use bgp-rib
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/multicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}

		attach process bgp-rib {
			receive [ update state refresh ]
			send [ update ]
		}
	}
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
