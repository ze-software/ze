# Test: `receive > from` narrows one receiver without affecting sibling receivers, and per-message `send > message <name> > to` overrides the block-level `send > to`.
# QUESTION: across three configs on `collector` (no `receive > from`,
# `receive { from [ /bgp/peer/edge1 ]; }`, and `receive { from none; }`), does `collector`
# record both `edge1` and `lab`, `edge1` only (while Loc-RIB still holds `lab`'s route),
# and neither peer respectively; and with per-message override
# `bgp { peer lab { bus { send { to [ /bus/endpoint/bgp-rib ]; message bgp:state { to [ /bus/endpoint/bgp-rib /bus/endpoint/collector ]; } } } } }`,
# does `collector` record `bgp:state` for `lab` and NO `bgp:update` while Loc-RIB holds
# `lab`'s route (and removing the per-message entry stops `collector` recording anything
# for `lab`)? A unit test cannot decide this because it spans live BGP sessions, compiled
# per-message and receiver-side filtering in `DeliveryGraph`, and live Loc-RIB storage.
#
# VALIDATES: spec-explicit-plugin-and-attach-config S4, S5 / AC-3, AC-4.
# PREVENTS: `receive > from` on one receiver starving sibling receivers like `bgp-rib`,
# `from none` leaking events, or per-message `to` failing to override block-level `to`.

option=timeout:value=150s
option=env:var=ZE_CONFIG_DIR:value=.
option=env:var=XDG_DATA_HOME:value=.
option=env:var=ze.ssh.password:value=testpass

stdin=init-answers:terminator=EOF_INIT
admin
testpass
127.0.0.1
$PORT2
EOF_INIT

# Peer scripts for S4 Run A (no receive > from).
stdin=edge1-a:terminator=EOF_EDGE1_A
option=tcp_connections:value=1
option=timeout:value=60s
option=asn:value=65001
option=open:value=router-id:id=127.0.0.2
option=linger:value=true
option=established-file:path=edge1-a.up
option=update:value=send-route:prefix=203.0.113.0/24:next-hop=192.0.2.1
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_EDGE1_A

stdin=lab-a:terminator=EOF_LAB_A
option=tcp_connections:value=1
option=timeout:value=60s
option=asn:value=65002
option=open:value=router-id:id=127.0.0.3
option=linger:value=true
option=established-file:path=lab-a.up
option=update:value=send-route:prefix=198.51.100.0/24:next-hop=192.0.2.2
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_LAB_A

# Peer scripts for S4 Run B (receive > from [ /bgp/peer/edge1 ]).
stdin=edge1-b:terminator=EOF_EDGE1_B
option=tcp_connections:value=1
option=timeout:value=60s
option=asn:value=65001
option=open:value=router-id:id=127.0.0.2
option=linger:value=true
option=established-file:path=edge1-b.up
option=update:value=send-route:prefix=203.0.113.0/24:next-hop=192.0.2.1
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_EDGE1_B

stdin=lab-b:terminator=EOF_LAB_B
option=tcp_connections:value=1
option=timeout:value=60s
option=asn:value=65002
option=open:value=router-id:id=127.0.0.3
option=linger:value=true
option=established-file:path=lab-b.up
option=update:value=send-route:prefix=198.51.100.0/24:next-hop=192.0.2.2
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_LAB_B

# Peer scripts for S4 Run C (receive > from none).
stdin=edge1-c:terminator=EOF_EDGE1_C
option=tcp_connections:value=1
option=timeout:value=60s
option=asn:value=65001
option=open:value=router-id:id=127.0.0.2
option=linger:value=true
option=established-file:path=edge1-c.up
option=update:value=send-route:prefix=203.0.113.0/24:next-hop=192.0.2.1
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_EDGE1_C

stdin=lab-c:terminator=EOF_LAB_C
option=tcp_connections:value=1
option=timeout:value=60s
option=asn:value=65002
option=open:value=router-id:id=127.0.0.3
option=linger:value=true
option=established-file:path=lab-c.up
option=update:value=send-route:prefix=198.51.100.0/24:next-hop=192.0.2.2
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_LAB_C

# Peer scripts for S5 Run D (per-message override on lab).
stdin=lab-d:terminator=EOF_LAB_D
option=tcp_connections:value=1
option=timeout:value=60s
option=asn:value=65002
option=open:value=router-id:id=127.0.0.3
option=linger:value=true
option=established-file:path=lab-d.up
option=update:value=send-route:prefix=198.51.100.0/24:next-hop=192.0.2.2
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_LAB_D

# Peer scripts for S5 Run E (negative: without message bgp:state override on lab).
stdin=lab-e:terminator=EOF_LAB_E
option=tcp_connections:value=1
option=timeout:value=60s
option=asn:value=65002
option=open:value=router-id:id=127.0.0.3
option=linger:value=true
option=established-file:path=lab-e.up
option=update:value=send-route:prefix=198.51.100.0/24:next-hop=192.0.2.2
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_LAB_E

tmpfs=s4-all.conf:terminator=EOF_S4_ALL
system {
	authentication {
		user admin {
			password "$2a$04$UlwuiuH82Unfsq.XEMPGJeDkXwbm3KW.nvVaVXOd/JeFK8VjMjrQO"
		}
	}
}
environment {
	ssh {
		enabled true
		server main { ip 127.0.0.1; port $PORT2; }
	}
}
bus {
	endpoint collector {
		external {
			run "le test fixture plugin/bus-bgp-collector col-a.log";
		}
		encoding json;
	}
}
bgp {
	router-id 192.0.2.254;
	filter {
		import { final accept; }
		export { final accept; }
	}
	peer edge1 {
		connection {
			remote { ip 127.0.0.2; }
			local { ip 127.0.0.1; accept false; }
		}
		session {
			asn { local 65000; remote 65001; }
			family { ipv4/unicast { prefix { maximum 10000; } } }
			capability { graceful-restart disable; }
		}
		behavior { group-updates disable; }
	}
	peer lab {
		connection {
			remote { ip 127.0.0.3; }
			local { ip 127.0.0.1; accept false; }
		}
		session {
			asn { local 65000; remote 65002; }
			family { ipv4/unicast { prefix { maximum 10000; } } }
			capability { graceful-restart disable; }
		}
		behavior { group-updates disable; }
	}
}
EOF_S4_ALL

