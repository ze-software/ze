cmd=foreground:seq=1:exec=ze init:stdin=init-answers:exit=0

# --- S4 Run A: no receive > from -> collector records both edge1 and lab ---
cmd=background:seq=2:name=edge1-a:exec=le test peer --bind 127.0.0.2 --port $PORT:stdin=edge1-a
cmd=background:seq=3:name=lab-a:exec=le test peer --bind 127.0.0.3 --port $PORT:stdin=lab-a
cmd=background:seq=4:name=daemon-a:exec=ze start s4-all.conf:ready=Ze running.
reject=stderr:pattern=ZE-OBSERVER-FAIL
reject=stderr:pattern=panic

cmd=foreground:seq=5:exec=le test fixture plugin/bus-assert-implied poll-file-contains col-a.log 203.0.113.0/24:exit=0
cmd=foreground:seq=6:exec=le test fixture plugin/bus-assert-implied poll-file-contains col-a.log 198.51.100.0/24:exit=0
cmd=foreground:seq=7:exec=le test fixture plugin/bus-assert-implied file-contains col-a.log 127.0.0.2:exit=0
cmd=foreground:seq=8:exec=le test fixture plugin/bus-assert-implied file-contains col-a.log 127.0.0.3:exit=0

cmd=stop:seq=9:name=daemon-a:signal=term
cmd=stop:seq=10:name=edge1-a
cmd=stop:seq=11:name=lab-a

# --- S4 Run B: receive > from [ /bgp/peer/edge1 ] -> collector gets edge1 only; Loc-RIB keeps lab ---
cmd=background:seq=12:name=edge1-b:exec=le test peer --bind 127.0.0.2 --port $PORT:stdin=edge1-b
cmd=background:seq=13:name=lab-b:exec=le test peer --bind 127.0.0.3 --port $PORT:stdin=lab-b
cmd=background:seq=14:name=daemon-b:exec=ze start s4-edge1.conf:ready=Ze running.
reject=stderr:pattern=ZE-OBSERVER-FAIL
reject=stderr:pattern=panic

# Positive fence & S4 negative check: Loc-RIB receives BOTH routes, and collector receives edge1's route.
cmd=foreground:seq=15:exec=le test fixture daemon/await-answer-all "show bgp rib" 203.0.113.0/24 198.51.100.0/24:exit=0
cmd=foreground:seq=16:exec=le test fixture plugin/bus-assert-implied poll-file-contains col-b.log 203.0.113.0/24:exit=0
cmd=foreground:seq=17:exec=le test fixture plugin/bus-assert-implied file-contains col-b.log 127.0.0.2:exit=0
cmd=foreground:seq=18:exec=le test fixture plugin/bus-assert-implied file-not-contains col-b.log 127.0.0.3:exit=0
cmd=foreground:seq=19:exec=le test fixture plugin/bus-assert-implied file-not-contains col-b.log 198.51.100.0/24:exit=0

cmd=stop:seq=20:name=daemon-b:signal=term
cmd=stop:seq=21:name=edge1-b
cmd=stop:seq=22:name=lab-b

# --- S4 Run C: receive > from none -> collector records neither peer; Loc-RIB keeps both ---
cmd=background:seq=23:name=edge1-c:exec=le test peer --bind 127.0.0.2 --port $PORT:stdin=edge1-c
cmd=background:seq=24:name=lab-c:exec=le test peer --bind 127.0.0.3 --port $PORT:stdin=lab-c
cmd=background:seq=25:name=daemon-c:exec=ze start s4-none.conf:ready=Ze running.
reject=stderr:pattern=ZE-OBSERVER-FAIL
reject=stderr:pattern=panic

cmd=foreground:seq=26:exec=le test fixture daemon/await-answer-all "show bgp rib" 203.0.113.0/24 198.51.100.0/24:exit=0
cmd=foreground:seq=27:exec=le test fixture plugin/bus-assert-implied file-not-contains col-c.log 127.0.0.2:exit=0
cmd=foreground:seq=28:exec=le test fixture plugin/bus-assert-implied file-not-contains col-c.log 127.0.0.3:exit=0

cmd=stop:seq=29:name=daemon-c:signal=term
cmd=stop:seq=30:name=edge1-c
cmd=stop:seq=31:name=lab-c

# --- S5 Run D: per-message send > message bgp:state > to [ /bus/endpoint/collector ] ---
cmd=background:seq=32:name=lab-d:exec=le test peer --bind 127.0.0.3 --port $PORT:stdin=lab-d
cmd=background:seq=33:name=daemon-d:exec=ze start s5-per-msg.conf:ready=Ze running.
reject=stderr:pattern=ZE-OBSERVER-FAIL
reject=stderr:pattern=panic

# Loc-RIB holds lab's route (block-level send > to), collector records lab's bgp:state and NO bgp:update.
cmd=foreground:seq=34:exec=le test fixture daemon/await-answer-all "show bgp rib" 198.51.100.0/24:exit=0
cmd=foreground:seq=35:exec=le test fixture plugin/bus-assert-implied poll-file-contains col-d.log '"state":"up"':exit=0
cmd=foreground:seq=36:exec=le test fixture plugin/bus-assert-implied file-contains col-d.log 127.0.0.3:exit=0
cmd=foreground:seq=37:exec=le test fixture plugin/bus-assert-implied file-not-contains col-d.log 198.51.100.0/24:exit=0
cmd=foreground:seq=38:exec=le test fixture plugin/bus-assert-implied file-not-contains col-d.log '"type":"update"':exit=0

cmd=stop:seq=39:name=daemon-d:signal=term
cmd=stop:seq=40:name=lab-d

# --- S5 Run E (negative): removing message bgp:state entry leaves collector with nothing for lab ---
cmd=background:seq=41:name=lab-e:exec=le test peer --bind 127.0.0.3 --port $PORT:stdin=lab-e
cmd=background:seq=42:name=daemon-e:exec=ze start s5-no-override.conf:ready=Ze running.
reject=stderr:pattern=ZE-OBSERVER-FAIL
reject=stderr:pattern=panic

cmd=foreground:seq=43:exec=le test fixture daemon/await-answer-all "show bgp rib" 198.51.100.0/24:exit=0
cmd=foreground:seq=44:exec=le test fixture plugin/bus-assert-implied file-not-contains col-e.log 127.0.0.3:exit=0

cmd=stop:seq=45:name=daemon-e:signal=term
cmd=stop:seq=46:name=lab-e
