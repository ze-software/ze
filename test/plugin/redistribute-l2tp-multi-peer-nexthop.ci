# Test: redistribute-l2tp-multi-peer-nexthop -- Two BGP peers get distinct NEXT_HOP.
# VALIDATES: AC-1 -- peer1 (ze local 127.0.0.4) receives NEXT_HOP=127.0.0.4;
#            peer2 (ze local 127.0.0.5) receives NEXT_HOP=127.0.0.5.
# PREVENTS: resolveNextHop regression where all peers get the same NEXT_HOP
#           regardless of their local session address.

# // test-relax: the expect=json lines here are REPLACED by byte-exact expect=bgp
# wire expectations, which strictly strengthens the fan-out assertion. An
# expect=json in a block named peer1/peer2 was consumed by NOBODY: ze-peer drops
# expect=json (peer/expect.go ConsumesLine) and the runner only parses the block
# literally named "peer" into Record.Messages (runner/record_parse.go parseAndAdd),
# so validateJSON never saw these. The peer therefore had nothing to check and
# exited before binding. The decoded shape each line asserted is spelled out below
# and is now enforced on the wire instead.
#
# ze-peer 1 (127.0.0.1) expectations
# UPDATE: ORIGIN incomplete, empty AS_PATH (iBGP), NEXT_HOP 127.0.0.4 -- ze's OWN
# address on this session, never the peer's own 127.0.0.1 (RFC 4271 Section
# 5.1.3). LOCAL_PREF 100, NLRI 10.0.0.1/32. LOCAL_PREF is well-known mandatory on
# an iBGP session (RFC 4271 5.1.5), emitted by reactor_api_batch.go
# buildWireModeUpdate.
stdin=peer1:terminator=EOF_PEER1
option=tcp_connections:value=1
option=timeout:value=15s
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00310200000015400101024002004003047F00000440050400000064200A000001
EOF_PEER1

# ze-peer 2 (127.0.0.2) expectations
# Same UPDATE but NEXT_HOP 127.0.0.5, ze's own address on THAT session -- the
# per-peer substitution this test exists to prove. Byte-identical to peer1's
# apart from the NEXT_HOP attribute value, and neither value is its own peer's.
# Both peers are in AS 65533 and ze-peer's default OPEN mirrors ze's router-id with the
# last octet incremented, so without an explicit identifier BOTH would present 1.2.3.5 --
# two distinct routers of one AS sharing a BGP Identifier, which ze rejects by default
# (RFC 6286 Section 2.1). This test models two separate neighbours, so give it its own.
stdin=peer2:terminator=EOF_PEER2
option=tcp_connections:value=1
option=timeout:value=15s
option=open:value=router-id:id=1.2.3.6
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00310200000015400101024002004003047F00000540050400000064200A000001
EOF_PEER2

# Python observer: wait for all plugins ready, drive fakel2tp emit, shut down.
tmpfs=l2tp-nexthop-test.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
from ze_api import API, runtime_fail, result_json_data

PEERS = (('peer1', '127.0.0.1'), ('peer2', '127.0.0.2'))


def dispatch(api, command):
    return api._call_engine('ze-plugin-engine:dispatch-command', {'command': command}) or {}


def peer_field(api, name, addr, field, default):
    result = dispatch(api, f'show bgp peer {name} detail').get('result', {})
    if result.get('status') != 'done':
        return default
    data = result_json_data(result, {})
    return data.get('peers', {}).get(addr, {}).get(field, default)


def wait_all(api, predicate, what, cycles=100):
    for _ in range(cycles):
        if all(predicate(name, addr) for name, addr in PEERS):
            return
        api.wait_for_event(timeout=0.2)
    runtime_fail(f'timeout waiting for {what}')


def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()

    # Wait for engine post-startup: all plugins loaded, BGP connecting.
    if not api.wait_for_post_startup(timeout=10.0):
        runtime_fail('post-startup callback never received')
        return

    # There is NO engine defect here, and observer polling is innocent. An earlier
    # revision of this file claimed both, and was refuted on 2026-07-16; the full
    # account is in redistribute-l2tp-announce.ci. In short: an expect=json-only
    # peer block leaves ze-peer with nothing to check, so it exits before binding
    # and ze dials a dead port. Polling during connect is provably harmless
    # (spec-fixit-redistribute-establishment-stall, E6/E9).
    #
    # This observer stays dispatch-silent for one reason only: its sleep/wait
    # conversion has not been done. Nothing here is waiting on an engine fix. The
    # runner's per-peer expectations decide the fan-out verdict.
    for _ in range(10):
        api.wait_for_event(timeout=0.2)

    resp = dispatch(api, 'request fakel2tp emit add ipv4/unicast 10.0.0.1/32')
    result = resp.get('result', {})
    if result.get('status') != 'done':
        runtime_fail(f'request fakel2tp emit failed: {result}')
        return

    # Bounded fan-out window (event-wait backoff): the runner's per-peer JSON
    # expectations gate the UPDATE content on both wires.
    for _ in range(15):
        api.wait_for_event(timeout=0.2)

    dispatch(api, 'request shutdown')
    api.wait_for_shutdown()


if __name__ == '__main__':
    main()
EOF_RUN

# ze configuration: two peers with distinct local addresses
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external l2tp-nexthop-test {
		run ./l2tp-nexthop-test.run
		encoder json
	}
	internal redistribute-orchestrator {
		use redistribute-orchestrator
	}
	internal fakel2tp {
		use fakel2tp
	}
}

redistribute {
	destination bgp {
		import l2tp {
			family [ ipv4/unicast ];
		}
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			# Ze's own address on this session, and what `nhop self` puts on the
			# wire. Deliberately NOT the peer's 127.0.0.1: RFC 4271 Section 5.1.3
			# forbids advertising a peer an address of that peer as NEXT_HOP.
			local {
				ip 127.0.0.4
				accept false
			}
		}
		session {
			asn {
				local 65533
				remote 65533
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		attach process redistribute-orchestrator {
			send [ update ]
		}
	}

	peer peer2 {
		connection {
			remote {
				ip 127.0.0.2
			}
			# Ze's own address on this session, and what `nhop self` puts on the
			# wire. Deliberately NOT the peer's 127.0.0.2: RFC 4271 Section 5.1.3
			# forbids advertising a peer an address of that peer as NEXT_HOP.
			local {
				ip 127.0.0.5
				accept false
			}
		}
		session {
			asn {
				local 65533
				remote 65533
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		attach process redistribute-orchestrator {
			send [ update ]
		}
	}
}
EOF_CONF

# Process orchestration: two ze-peer instances on different loopback addresses
cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer1
cmd=background:seq=2:exec=ze-peer --bind 127.0.0.2 --port $PORT:stdin=peer2
cmd=foreground:seq=3:exec=ze -:stdin=ze-bgp:timeout=20s
# // test-relax: expect=exit:code=0 removed -- this STRENGTHENS the test. Coverage
# is replaced by the per-peer ze-peer wire expectations above, which now govern the
# verdict. The exit-code line asserted nothing about BGP and, until 2026-07-16,
# actively disabled the peer check (spec-fixit-redistribute-establishment-stall, D2).
reject=stderr:pattern=panic recovered
reject=stderr:pattern=fatal error
reject=stderr:pattern=ZE-OBSERVER-FAIL
