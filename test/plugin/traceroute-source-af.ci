# Test: the source address of `resolve traceroute` decides the destination family
# Exercises: dispatch-command -> ze-resolve:traceroute -> handleResolveTraceroute -> probe.ResolveTarget
# VALIDATES: spec-traceroute-source-af AC-1, AC-2, AC-3 -- a dual-stack name traced
#   from an IPv6 source reaches its IPv6 address, from an IPv4 source its IPv4
#   address, and a target with no address in the source's family is refused with
#   a message naming both arguments.
# PREVENTS: the destination resolving in one family while the source binds the
#   other, which reached the operator as a socket bind failure naming neither.
#
# localhost is the dual-stack name: the guest's /etc/hosts carries 127.0.0.1
# first and ::1 second, so a resolver that ignores the source answers 127.0.0.1
# for both polarities and the IPv6 run fails at the bind.
#
# caps=net-raw, not skip-os: doTracerouteCtx builds ICMP itself through
# net.ListenPacket("ip4:icmp"/"ip6:ipv6-icmp"), which the kernel refuses without
# CAP_NET_RAW. Declaring the capability relocates the test to
# `./le qemu all-tests`, which has it, instead of failing where it cannot pass.
option=needs-linux:caps=net-raw

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=20s
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER


stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external traceroute-source-af-test {
		run "ze-test fixture plugin/traceroute-source-af"
		encoder json
	}
}
bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65000
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
reject=stderr:pattern=panic recovered
reject=stderr:pattern=fatal error
reject=stderr:pattern=ZE-OBSERVER-FAIL
