# QUESTION: Does an rs-client peer's import-policy-denied UPDATE appear in `show bgp adj-rib-in status` as filtered-routes alongside total-routes through the live daemon?
# A unit test cannot decide full config loading, policy-chain rejection, update-filtered delivery, and CLI pipe rendering end to end.

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=30s
option=asn:value=65001
# 1. Policy-denied announcement: 10.0.2.0/24, ORIGIN IGP, AS_PATH [65001], NEXT_HOP 1.1.1.1.
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002F02000000144001010040020602010000FDE940030401010101180A0002
# 2. Accepted control announcement: 10.0.0.0/24, ORIGIN IGP, AS_PATH [65001], NEXT_HOP 1.1.1.1.
action=send:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002F02000000144001010040020602010000FDE940030401010101180A0000
# Keep session alive until observer verifies status and requests graceful shutdown.
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
expect=bgp:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002D0306021741646D696E6973747261746976652053687574646F776E
EOF_PEER

stdin=ze-bgp:terminator=EOF_CONF
bus {
	endpoint adj-rib-in {
		internal bgp-adj-rib-in;
	}
	endpoint bgp-filter-prefix {
		internal bgp-filter-prefix;
	}
	endpoint filtered-status-check {
		external {
			run "le test fixture plugin/adj-rib-in-filtered-status";
		}
		encoding json;
	}
}
policy {
	prefix-list DENY-ONE {
		entry 10.0.2.0/24 { action reject; }
		entry 10.0.0.0/24 { action accept; }
	}
	match match-deny-one { prefix-list DENY-ONE; }
}
bgp {
	peer rs-client-peer {
		connection {
			remote { ip 127.0.0.1; }
			local { ip 127.0.0.1; accept false; }
		}
		session {
			asn { local 65000; remote 65001; }
			router-id 1.2.3.4
			rs-client true
			family { ipv4/unicast { prefix { maximum 10000; } } }
			capability { graceful-restart disable; }
		}
		behavior { group-updates disable; }
		filter {
			import { filters [ match-deny-one ]; final accept; }
			export { final accept; }
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=30s
expect=exit:code=0
expect=stderr:pattern=OK: adj-rib-in status reports total-routes=2 filtered-routes=1
reject=stderr:pattern=panic
reject=stderr:pattern=fatal error
