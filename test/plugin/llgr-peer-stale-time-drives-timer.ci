# Test: the remote Long-Lived Stale Time controls real received-route expiry.
# VALIDATES: source's 3-second LLST expires while control's 60-second LLST
# retains its route, although ze advertises 3600 seconds to both peers.
# PREVENTS: using ze's local LLST, purging at peer-down, or retaining only
# locally configured routes while claiming received-route retention.
#
# RFC 9494 Section 4.2: "For each AFI/SAFI for which it has received a nonzero
# Long-Lived Stale Time, the helper router MUST start a timer for that
# Long-Lived Stale Time." Both OPEN directions reach GR. The observer releases
# TCP close only after received-store and destination-wire acknowledgments.
# The live receiver checks NO_LLGR removal, LLGR_STALE readvertisement, and
# expiry withdrawals; its final acknowledgment fences observer completion.
#
# This topology uses both leased ports. Disable the runner's single-port
# override, which otherwise replaces even receiver's explicit $PORT2.
option=env:var=ze_test_bgp_port:value=
stdin=source:terminator=EOF_SOURCE
option=tcp_connections:value=1
option=timeout:value=40s
option=linger:value=true
option=open:value=router-id:id=192.0.2.1
option=open:value=graceful-restart:restart-time=3
option=open:value=llgr:stale-time=3
expect=bgp:conn=1:seq=1:contains=18C63363
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00300200000015400101004002004003040A00000240050400000064180A0000
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0037020000001C400101004002004003040A00000240050400000064C00804FFFF0007180A0001
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00300200000015400101004002004003040A00000240050400000064180A0002
expect=bgp:conn=1:seq=2:contains=18C63364
action=close:conn=1:seq=3
EOF_SOURCE

stdin=control:terminator=EOF_CONTROL
option=tcp_connections:value=1
option=timeout:value=40s
option=linger:value=true
option=open:value=router-id:id=192.0.2.2
option=open:value=graceful-restart:restart-time=3
option=open:value=llgr:stale-time=60
expect=bgp:conn=1:seq=1:contains=18C63363
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00300200000015400101004002004003040A00000240050400000064180A0003
expect=bgp:conn=1:seq=2:contains=18C63364
action=close:conn=1:seq=3
EOF_CONTROL

stdin=receiver:terminator=EOF_RECEIVER
option=tcp_connections:value=1
option=timeout:value=40s
option=linger:value=true
option=open:value=router-id:id=192.0.2.3
option=open:value=graceful-restart:restart-time=3
option=open:value=llgr:stale-time=60
# Establish the long-lived control before the short-lived source sends routes.
# Each acknowledgment is sent only after the receiver's full phase matches.
expect=bgp:conn=1:seq=1:announced=180A0003
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00300200000015400101004002004003040A0000024005040000006418CB006E
expect=bgp:conn=1:seq=2:announced=180A0003:attribute=8,FFFF0006
action=send:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00300200000015400101004002004003040A0000024005040000006418CB006F
# Only now may source advertise its plain and NO_LLGR routes.
expect=bgp:conn=1:seq=3:announced=180A0000
expect=bgp:conn=1:seq=3:announced=180A0001:attribute=8,FFFF0007
expect=bgp:conn=1:seq=3:announced=180A0002
action=send:conn=1:seq=3:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00300200000015400101004002004003040A0000024005040000006418CB0070
# Source's LLGR entry replays the entire receiver family, including control's
# already-stale route. Every retained prefix MUST carry LLGR_STALE in its own
# UPDATE; packed announcements may satisfy several checks in this group.
expect=bgp:conn=1:seq=4:withdrawn=180A0001
expect=bgp:conn=1:seq=4:announced=180A0000:attribute=8,FFFF0006
expect=bgp:conn=1:seq=4:announced=180A0002:attribute=8,FFFF0006
expect=bgp:conn=1:seq=4:announced=180A0003:attribute=8,FFFF0006
action=send:conn=1:seq=4:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00300200000015400101004002004003040A0000024005040000006418CB0071
# Expiry MUST withdraw both short-LLST routes on this live destination socket.
expect=bgp:conn=1:seq=5:withdrawn=180A0000
expect=bgp:conn=1:seq=5:withdrawn=180A0002
action=send:conn=1:seq=5:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00300200000015400101004002004003040A0000024005040000006418CB0072
# The control must survive every phase, not merely exist in the received store.
reject=bgp:conn=1:scope=withdrawn:pattern=180A0003
EOF_RECEIVER

stdin=ze-bgp:terminator=EOF_CONF
plugin {
 internal gr { use bgp-gr; }
 internal bgp-rib { use bgp-rib; }
 internal rs { use bgp-rs; }
 internal adj-rib-in { use bgp-adj-rib-in; }
 external observer { run "le test fixture plugin/llgr-peer-stale-time-drives-timer"; encoder json; }
}
bgp {
 peer source {
  connection { remote { ip 127.0.0.1; port $PORT; } local { ip 127.0.0.1; accept false; } }
  session {
   asn { local 1; remote 1; }
   router-id 1.2.3.4
   family { ipv4/unicast { prefix { maximum 10000; } } }
   capability { graceful-restart { restart-time 120; long-lived-stale-time 3600; } }
   route-reflector-client true
   cluster-id 10.10.10.10
  }
  behavior { group-updates disable; }
  timer { connect-retry 60; }
  attach process gr { receive [ open state eor ]; send [ update ]; }
  # These strict input peers accept only observer markers. Only receiver grants
  # rs/RIB output, so cross-reflections and receiver ACKs cannot reach them.
  attach process bgp-rib { receive [ update state refresh ]; }
  attach process observer { receive [ state ]; send [ update ]; }
  attach process adj-rib-in { receive [ update-received state ]; }
  attach process rs { receive [ update-received state open-received refresh ]; }
 }
 peer control {
  connection { remote { ip ::1; port $PORT; } local { ip ::1; accept false; } }
  session {
   asn { local 1; remote 1; }
   router-id 1.2.3.4
   family { ipv4/unicast { prefix { maximum 10000; } } }
   capability { graceful-restart { restart-time 120; long-lived-stale-time 3600; } }
   route-reflector-client true
   cluster-id 10.10.10.10
  }
  behavior { group-updates disable; }
  timer { connect-retry 60; }
  attach process gr { receive [ open state eor ]; send [ update ]; }
  attach process bgp-rib { receive [ update state refresh ]; }
  attach process observer { receive [ state ]; send [ update ]; }
  attach process adj-rib-in { receive [ update-received state ]; }
  attach process rs { receive [ update-received state open-received refresh ]; }
 }
 peer receiver {
  connection { remote { ip 127.0.0.2; port $PORT2; } local { ip 127.0.0.1; accept false; } }
  session {
   asn { local 1; remote 1; }
   router-id 1.2.3.4
   family { ipv4/unicast { prefix { maximum 10000; } } }
   capability { graceful-restart { restart-time 120; long-lived-stale-time 3600; } }
   route-reflector-client true
   cluster-id 10.10.10.10
  }
  behavior { group-updates disable; }
  timer { connect-retry 60; }
  attach process gr { receive [ open state eor ]; send [ update ]; }
  attach process bgp-rib { receive [ update state refresh ]; send [ update ]; }
  attach process observer { receive [ state ]; send [ update ]; }
  attach process adj-rib-in { receive [ update-received state ]; }
  attach process rs { receive [ update-received state open-received refresh ]; send [ update ]; }
 }
}
EOF_CONF

cmd=background:seq=1:exec=le test peer --port $PORT:stdin=source
cmd=background:seq=2:exec=le test peer --bind ::1 --port $PORT:stdin=control
# The third receiver listens on its own leased port.
cmd=background:seq=3:exec=le test peer --bind 0.0.0.0 --port $PORT2:stdin=receiver
cmd=foreground:seq=4:exec=ze -:stdin=ze-bgp:timeout=45s
await=stderr:contains=OK: received LLGR lifecycle timer:then=stop
expect=exit:code=0
expect=stderr:contains=OK: received LLGR lifecycle timer
reject=stderr:pattern=panic
