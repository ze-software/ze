# Test: an answer past the buffer threshold streams its records
#
# Flow:
# 1. Daemon starts with one external plugin on one BGP peer
# 2. The plugin declares "record-answers" at Stage 3
# 3. It dispatches `system command list`, whose rows are every command the
#    daemon can dispatch: far more than the 256-record threshold
# 4. It asserts the head names type=ndjson, that one item= line carries each
#    record, and that the terminator counts them all
#
# The type is decided at RUN TIME from the output and never by the command
# (WriteAnswer, internal/component/plugin/dispatch.go). The encoder holds up to
# rpc.AnswerBufferThreshold records: a walk that ends within them is answered as
# one type=json document, and a walk that passes them switches to a stream and
# flushes what it held. This test drives the second branch on a running daemon,
# which is the only place the decision is observable end to end -- an operator
# reading `ze cli` sees the same rendering either way, by design.
#
# `system command list` is the driver because it is the longest answer the
# daemon has and because it answers a single-key array today, so the streamed
# records and the document a bounded answer would carry are the same data.
#
# VALIDATES: AC-1 -- a successful answer is a head, its records, and a
# terminator.
# VALIDATES: AC-1c -- a walk past the threshold streams, and the records held
# while the type was being decided go out in walk order ahead of the rest.
# VALIDATES: AC-6 -- a generator of N rows produces N record lines and a
# terminator carrying count=N, with no count before it.
# PREVENTS: the answer being built whole and flattened into one line, which
# makes the 16 MB message ceiling a ceiling on the whole answer.

# ze-peer expectations: one session, so the daemon runs its whole startup.
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=25s
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# Negotiated plugin: it names record-answers, so every answer is a sequence.
tmpfs=answer-records.run:mode=755:terminator=EOF_RECORDS
#!/usr/bin/env python3
"""A negotiated peer reading a long answer record by record."""

import json
import sys

from ze_api import API, runtime_fail

# THRESHOLD is rpc.AnswerBufferThreshold (pkg/plugin/rpc/message.go). It is the
# number of records the encoder holds while it decides the type, so an answer
# must pass it to be streamed at all.
THRESHOLD = 256


def tail_of(line, want_verb="ok"):
    """Return the key=value tail of one answer line."""
    parts = line.split(" ", 2)
    if len(parts) != 3 or parts[1] != want_verb:
        runtime_fail(f"unexpected answer line: {line[:120]}")
    return parts[2]


def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    # Stage 3 naming the wire shape this peer reads.
    api.capability_done(protocol=["record-answers"])
    api.wait_for_registry()
    api.ready()
    api.wait_for_post_startup(timeout=5.0)

    lines = api.dispatch_wire_lines("system command list", timeout=10.0)
    if len(lines) < 3:
        runtime_fail(f"answer was {len(lines)} lines, want a head, records and a terminator: {lines}")

    head = tail_of(lines[0])
    if head != "status=done type=ndjson key=commands":
        runtime_fail(f"head was {head!r}, want 'status=done type=ndjson key=commands'")

    terminator = tail_of(lines[-1])
    if not terminator.startswith("count="):
        runtime_fail(f"last line was {terminator!r}, want the terminator's count=")
    counted = int(terminator[len("count=") :])

    records = lines[1:-1]
    if len(records) != counted:
        runtime_fail(f"the answer carries {len(records)} record lines and states count={counted}")
    if counted <= THRESHOLD:
        runtime_fail(
            f"fixture problem: the daemon registers {counted} commands, "
            f"which is inside the {THRESHOLD}-record threshold, so nothing streams"
        )

    # No count reaches the peer before the terminator: nothing states a total
    # the records can contradict.
    for i, line in enumerate(records):
        tail = tail_of(line)
        if not tail.startswith("item="):
            runtime_fail(f"record {i} was {tail[:120]!r}, want an item=")
        row = json.loads(tail[len("item=") :])
        if "value" not in row:
            runtime_fail(f"record {i} carries no command name: {tail[:120]!r}")
        if "commands" in row:
            runtime_fail(f"record {i} carries the envelope; the head carries it as key=: {tail[:120]!r}")

    print(f"OK: {counted} records streamed, one line each", file=sys.stderr)

    # A negotiated peer reads EVERY dispatch answer as a sequence, so the
    # shutdown goes out the same way.
    api.dispatch_wire_lines("request shutdown", timeout=2.0, settle=0.2)
    api.wait_for_shutdown()


if __name__ == "__main__":
    main()
EOF_RECORDS

# ze bgp configuration
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external answer-records {
		run ./answer-records.run
		encoder json
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=25s
expect=exit:code=0
expect=stderr:pattern=OK: [0-9]+ records streamed, one line each
reject=stderr:pattern=ZE-OBSERVER-FAIL
reject=stderr:pattern=panic recovered
