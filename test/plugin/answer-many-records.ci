# Test: a large answer reaches the operator record by record
#
# Flow:
# 1. Daemon starts with SSH and two configured BGP peers
# 2. Shell script creates SSH credentials via ze init
# 3. `show bgp peer list` names both peers, so the answer carries two records
# 4. `show bgp peer list | ndjson` renders one line for each of those records
#
# An answer is a head, one line for each record, and a terminator. Each peer is
# one record under the head's `key=peers` envelope, so ndjson, which renders one
# record per line, prints one line for each peer. Today the whole answer is one
# JSON object built before any byte is written, and ndjson prints it as one
# line: that is the materialization this test exists to detect.
#
# VALIDATES: AC-1 -- a successful answer is a head, its records, and a
# terminator, and the operator reads one record per line.
# VALIDATES: AC-6 -- a generator of N rows produces N record lines.
# PREVENTS: the answer being built whole and flattened into one line, which
# makes the 16 MB message ceiling a ceiling on the whole answer.

# Test script: two peers answered as two records over the SSH exec channel
tmpfs=test-answer-many-records.sh:mode=755:terminator=EOF_SH
#!/bin/sh
set -e

# Signal test runner readiness
touch daemon.ready

# Generate config with SSH on port 0 (OS-assigned)
cat > answer-many-records.conf << 'ZECONF'
bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.2
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65533
				remote 65533
			}
		}
	}
	peer peer2 {
		connection {
			remote {
				ip 127.0.0.3
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65533
				remote 65533
			}
		}
	}
}

system {
	authentication {
		user admin {
			password "$2a$04$UlwuiuH82Unfsq.XEMPGJeDkXwbm3KW.nvVaVXOd/JeFK8VjMjrQO"
			profile [ admin ]
		}
	}
	authorization {
		profile admin {
			run {
				default-action allow
			}
			edit {
				default-action allow
			}
		}
	}
}

environment {
	ssh {
		enabled true
		server main {
			ip 127.0.0.1;
			port 0;
		}
	}
}
ZECONF

# Use a PID-derived high port for BGP to avoid needing root for port 179
export ze_test_bgp_port=$((10000 + ($$ % 50000)))

# Start daemon, capture stderr to parse SSH port
ze start answer-many-records.conf 2>daemon.log &
DAEMON_PID=$!
trap 'kill $DAEMON_PID 2>/dev/null; wait $DAEMON_PID 2>/dev/null' EXIT

# Wait for SSH server to report its listening address
SSH_PORT=""
for i in $(seq 1 50); do
	SSH_PORT=$(grep -o '127\.0\.0\.1:[0-9]*' daemon.log 2>/dev/null | head -1 | cut -d: -f2 || true)
	if [ -n "$SSH_PORT" ]; then
		break
	fi
	sleep 0.2
done

if [ -z "$SSH_PORT" ]; then
	echo "FAIL: SSH server did not start (no address in daemon.log)" >&2
	cat daemon.log >&2
	exit 1
fi
echo "SSH port: $SSH_PORT" >&2

# Brief delay for postStartFunc to wire the authorizer
sleep 0.5

ADMIN_DIR=$(mktemp -d)
trap 'rm -rf "$ADMIN_DIR"; kill $DAEMON_PID 2>/dev/null; wait $DAEMON_PID 2>/dev/null' EXIT
printf 'admin\ntestpass\n127.0.0.1\n%s\n' "$SSH_PORT" | ZE_CONFIG_DIR="$ADMIN_DIR" ze init >/dev/null

# Precondition: the answer covers both peers. A failure here is a fixture
# problem, not a framing one.
PEERS=$(ZE_CONFIG_DIR="$ADMIN_DIR" ZE_SSH_PASSWORD="testpass" ze cli -c "show bgp peer list" 2>&1) || {
	echo "FAIL: show bgp peer list did not answer" >&2
	echo "OUTPUT: $PEERS" >&2
	exit 1
}
for PEER in 127.0.0.2 127.0.0.3; do
	echo "$PEERS" | grep -q "$PEER" || {
		echo "FAIL: fixture problem -- $PEER is missing from the peer list" >&2
		echo "OUTPUT: $PEERS" >&2
		exit 1
	}
done
echo "OK: both peers are in the answer" >&2

# One record per peer: ndjson renders one line for each record of the answer.
NDJSON=$(ZE_CONFIG_DIR="$ADMIN_DIR" ZE_SSH_PASSWORD="testpass" ze cli -c "show bgp peer list | ndjson" 2>&1) || {
	echo "FAIL: show bgp peer list | ndjson did not answer" >&2
	echo "OUTPUT: $NDJSON" >&2
	exit 1
}

RECORDS=$(printf '%s\n' "$NDJSON" | grep -c '^{' || true)
if [ "$RECORDS" -ne 2 ]; then
	echo "FAIL: answer rendered $RECORDS record lines, want 2 (one for each peer)" >&2
	echo "OUTPUT: $NDJSON" >&2
	exit 1
fi

for PEER in 127.0.0.2 127.0.0.3; do
	SEEN=$(printf '%s\n' "$NDJSON" | grep -c "$PEER" || true)
	if [ "$SEEN" -ne 1 ]; then
		echo "FAIL: $PEER appears on $SEEN record lines, want 1" >&2
		echo "OUTPUT: $NDJSON" >&2
		exit 1
	fi
done

if printf '%s\n' "$NDJSON" | grep -q '"peers"'; then
	echo "FAIL: a record line carries the peers envelope; the head carries it as key=" >&2
	echo "OUTPUT: $NDJSON" >&2
	exit 1
fi

echo "OK: the answer reached the operator as one record for each peer" >&2
exit 0
EOF_SH

# Process orchestration
cmd=foreground:seq=1:exec=./test-answer-many-records.sh:timeout=20s
expect=exit:code=0
