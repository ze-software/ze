# QUESTION: Does a peer without rs-client leave a loop-denied UPDATE absent from Adj-RIB-In in the live daemon while storing its accepted control route?
# A unit test cannot decide full config resolution of default rs-client=false through reactor delivery and CLI show output.

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=30s
option=asn:value=65001
# 1. Loop-denied UPDATE (AS_PATH [65001, 65000]): 10.0.1.0/24. Must NOT be stored for a plain peer.
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF003302000000184001010040020A02020000FDE90000FDE840030401010101180A0001
# 2. Accepted control UPDATE (AS_PATH [65001]): 10.0.0.0/24. Acts as FIFO fence proving the denied UPDATE was processed first.
action=send:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002F02000000144001010040020602010000FDE940030401010101180A0000
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
expect=bgp:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002D0306021741646D696E6973747261746976652053687574646F776E
EOF_PEER

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external plain-peer-check {
		run "le test fixture plugin/adj-rib-in-filtered-absent-for-plain-peer"
		encoder json
	}
	internal adj-rib-in {
		use bgp-adj-rib-in
	}
}
bgp {
	filter {
		import { final accept; }
		export { final accept; }
	}
	peer plain-peer {
		connection {
			remote { ip 127.0.0.1; }
			local { ip 127.0.0.1; accept false; }
		}
		session {
			asn { local 65000; remote 65001; }
			router-id 1.2.3.4
			family { ipv4/unicast { prefix { maximum 10000; } } }
			capability { graceful-restart disable; }
		}
		behavior { group-updates disable; }
		attach process adj-rib-in {
			receive [ update-received update-filtered-received state ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=30s
expect=exit:code=0
expect=stderr:pattern=OK: plain peer adj-rib-in holds only accepted control
reject=stderr:pattern=panic
reject=stderr:pattern=fatal error
