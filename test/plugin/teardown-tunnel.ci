# Test: `l2tp tunnel teardown <id>` fans a StopCCN at the peer and
#       removes the tunnel from the subsystem's snapshot.
#
# VALIDATES: spec-l2tp-7 AC-22 -- operator-initiated teardown is
#            a real FSM transition that ends with the tunnel gone
#            from `show l2tp tunnels`. The teardown response must
#            report status=sent (not a silent no-op).
# PREVENTS:  regression where the teardown only logs and never calls
#            the tunnel FSM, or where the response reports success
#            for an unknown tunnel id.

option=env:var=ze.l2tp.skip-kernel-probe:value=true
option=env:var=TEST_SECRET:value=teardown-secret
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=20s
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER



stdin=ze-conf:terminator=EOF_CONF
plugin {
	external teardown-tunnel-test {
		run "ze-test fixture plugin/teardown-tunnel"
		encoder json
	}
}

environment {
	log {
		l2tp debug
	}
	l2tp {
		server main {
			ip 127.0.0.1
			port $PORT2
		}
	}
}

l2tp {
	enabled true
	shared-secret teardown-secret
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=background:seq=2:exec=ze-test fixture plugin/teardown-tunnel-peer $PORT2 0x0123
cmd=foreground:seq=3:exec=ze -:stdin=ze-conf:timeout=20s
expect=exit:code=0
expect=stderr:contains=tunnel now established
