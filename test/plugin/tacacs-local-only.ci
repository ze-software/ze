# Test: with no TACACS+ block the authentication chain remains local-only.
# VALIDATES: AC-5.

stdin=ze-conf:terminator=EOF_CONF
bgp {
	peer peer1 {
		connection { remote { ip 127.0.0.1; } local { ip 127.0.0.1; accept false; } }
		session { asn { local 65533; remote 65533; } }
	}
}
system {
	authentication {
		user admin {
			password "$2a$04$UlwuiuH82Unfsq.XEMPGJeDkXwbm3KW.nvVaVXOd/JeFK8VjMjrQO"
			profile [ admin ]
		}
	}
	authorization {
		profile admin { run { default-action allow; } edit { default-action allow; } }
	}
}
environment { ssh { enabled true; server main { ip 127.0.0.1; port $PORT2; } } }
plugin {
	external tacacs-local-only-test {
		run "ze-test fixture plugin/tacacs-local-only $PORT2"
		encoder json
	}
}
EOF_CONF

cmd=foreground:seq=1:exec=ze -:stdin=ze-conf:timeout=25s
expect=exit:code=0
expect=stderr:pattern=auth success.*source=local
reject=stderr:pattern=source=tacacs
expect=stderr:pattern=OK: summary ran via local auth
reject=stderr:pattern=ZE-OBSERVER-FAIL
