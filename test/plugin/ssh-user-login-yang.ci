# Test: YANG-configured users authenticate over SSH with explicit usernames.
#
# VALIDATES: AC-6 -- YANG user with bcrypt password authenticates via SSH.
# VALIDATES: AC-9 -- an explicit alice login with the environment password succeeds.
# VALIDATES: AC-12 -- the short username form resolves to the same alice login.
# VALIDATES: AC-7 -- a wrong password is rejected.

stdin=ze-conf:terminator=EOF_CONF
bgp {
	peer peer1 {
		connection {
			remote { ip 127.0.0.1; }
			local { ip 127.0.0.1; accept false; }
		}
		session { asn { local 65533; remote 65533; } }
	}
}
system {
	authentication {
		user operator {
			password "$2a$04$UlwuiuH82Unfsq.XEMPGJeDkXwbm3KW.nvVaVXOd/JeFK8VjMjrQO"
		}
		user alice {
			password "$2a$04$UlwuiuH82Unfsq.XEMPGJeDkXwbm3KW.nvVaVXOd/JeFK8VjMjrQO"
		}
	}
}
environment {
	ssh {
		enabled true
		server main { ip 127.0.0.1; port $PORT2; }
	}
}
plugin {
	external ssh-user-login-test {
		run "ze-test fixture plugin/ssh-user-login-yang $PORT2"
		encoder json
	}
}
EOF_CONF

cmd=foreground:seq=1:exec=ze -:stdin=ze-conf:timeout=20s
expect=exit:code=0
expect=stderr:pattern=OK: super-admin baseline
expect=stderr:pattern=OK: --user alice authenticated and was identified as alice
expect=stderr:pattern=OK: -u alice authenticated as alice
expect=stderr:pattern=OK: wrong password rejected
reject=stderr:pattern=ZE-OBSERVER-FAIL
