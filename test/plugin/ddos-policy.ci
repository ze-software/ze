# Test: ddos/detect traffic policy -- an allow rule at mitigation scope exempts the
# victim from the mitigation ACTION while detection still fires.
#
# VALIDATES: spec-ddos-direction-allowlist AC-2 -- with a
#            `rule <victim> { action allow; match destination; scope mitigation; }`
#            the detector still opens an incident (show ddos status active-attacks > 0)
#            but the local responder installs NO nft drop (show ddos local active=false).
# PREVENTS:  the policy having no effect (a drop installed anyway) or suppressing
#            detection entirely (no incident opened).
#
# STATUS: option=needs-linux. Runs the full daemon path on the QEMU Alpine VM via an
#   in-daemon observer plugin (ze_api handshake), same harness as ddos-bps-amplification.
#   The loopback victim 127.0.0.7 is box-owned (RTN_LOCAL, direction local); the policy
#   under test exempts it from mitigation regardless of direction.

# This test needs a fully privileged host, not merely Linux, and needs TWO
# distinct capability families. Its `traffic { usage { track-ip true } }` block
# drives rlimit.RemoveMemlock() + link.AttachTCX()
# (internal/plugins/trafficusage/attach_linux.go:33,46), so it needs bpf
# (CAP_BPF + CAP_SYS_RESOURCE) to account at all and net-admin to program the
# interface's tc hooks. Without them eBPF accounting runs inert, no incident is
# ever opened, and the observer's runtime_fail fires -- which is what a bare
# needs-linux produced on the unprivileged GitHub runner
# (ai/rules/qemu-testing.md).
option=needs-linux:caps=net-admin,bpf
# Serialize against every other ddos test: they all flood the SAME loopback
# interface and the detector picks the victim by top-destination-bytes over that
# interface, so a sibling's concurrent flood is indistinguishable from this
# test's own. Rationale in full: test/plugin/ddos-direction.ci.
option=exclusive:group=ddos-flood
option=env:var=ze.log.ddos.detect:value=info
option=env:var=ze.log.ddos.local:value=info
option=timeout:value=90s

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=90s
option=asn:value=65001
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER


stdin=ze-bgp:terminator=EOF_CONF
ddos {
	detect {
		enabled true
		absolute-floor 1000
		confirm-duration 1
		startup-grace 0
		baseline-window 10
		check-interval 1
		characterize-enable false
		policy {
			default-action deny
			rule 127.0.0.7/32 {
				action allow
				match destination
				scope mitigation
			}
		}
	}
	observe {
		incident-ring-size 100
	}
	local {
		response-level enforce
	}
}

traffic {
	usage {
		enabled true
		track-ip true
		interfaces {
			interface lo {
				enabled true
			}
		}
	}
}

# // no firewall {} backend block here. An allow/mitigation policy exempts
# the victim in the responder BEFORE any firewall call (applyMitigation returns at the
# "policy exempts mitigation" branch), so no nft backend is needed. Adding one
# deadlocked the daemon's command dispatch under the flood (firewall component + the
# responder both drive nft concurrently). Validity comes from the expect=stderr
# "policy exempts mitigation" assertion, which fires only when the policy set the
# event's SuppressMitigation flag -- i.e. only when the policy actually worked.
plugin {
	external ddos-policy-probe {
		run "ze-test fixture plugin/ddos-policy"
		encoder json
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast {
					prefix {
						maximum 10000
					}
				}
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=85s
expect=exit:code=0
expect=stderr:contains=ddos-local: policy exempts mitigation
