# Test: show anomaly-shape reaches the shadow-first responder plugin
# Exercises: config anomaly-shape{mode shadow} -> RunEngine -> setGlobalResponder,
#            then dispatch-command -> ze-show:anomaly-shape -> handleShowAnomalyShape.
# Verifies AC-1/AC-11 (the wire method resolves; shadow is the wired default with
# nothing armed). The armed/auto-revert/blast-radius/kill-switch paths are covered
# by the unit responder tests (fake clock + mocked firewall) since the .ci harness
# cannot synthesize anomalyevent incidents without the detector + traffic.

# ze-peer: accepts connection
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
option=asn:value=65001
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER


stdin=ze-bgp:terminator=EOF_CONF
anomaly {
	shape {
		mode shadow
	}
}

plugin {
	external anomaly-shape-test {
		run "ze-test fixture plugin/anomaly-shape-shadow"
		encoder json
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast {
					prefix {
						maximum 10000
					}
				}
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
