# Test: show anomaly-shape reaches the shadow-first responder plugin
# Exercises: config anomaly-shape{mode shadow} -> RunEngine -> setGlobalResponder,
#            then dispatch-command -> ze-show:anomaly-shape -> handleShowAnomalyShape.
# Verifies AC-1/AC-11 (the wire method resolves; shadow is the wired default with
# nothing armed). The armed/auto-revert/blast-radius/kill-switch paths are covered
# by the unit responder tests (fake clock + mocked firewall) since the .ci harness
# cannot synthesize anomalyevent incidents without the detector + traffic.

# ze-peer: accepts connection
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
option=asn:value=65001
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

tmpfs=anomaly-shape-test.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
import json
import sys
from ze_api import API, runtime_fail, result_text_data

def dispatch(api, command):
    resp = api._call_engine(
        'ze-plugin-engine:dispatch-command', {'command': command})
    if resp is None:
        return {'status': 'error', 'data': 'engine call returned None'}
    return resp.get('result', {})

def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()
    api.wait_for_post_startup(timeout=5.0)

    try:
        resp = dispatch(api, 'show anomaly shape')
        status = resp.get('status')
        if status != 'done':
            runtime_fail(f'anomaly-shape: status={status} data={resp.get("data")}')

        data = result_text_data(resp)
        if isinstance(data, str) and data:
            data = json.loads(data)

        if data.get('enabled') is not True:
            runtime_fail(f'anomaly-shape: enabled != true (plugin not wired): {data}')
        if data.get('mode') != 'shadow':
            runtime_fail(f'anomaly-shape: mode != shadow (default): {data}')
        if data.get('armed-count', -1) != 0:
            runtime_fail(f'anomaly-shape: armed-count != 0 in shadow: {data}')

        print(f'OK: show anomaly shape mode={data["mode"]} armed={data["armed-count"]}', file=sys.stderr)
    finally:
        dispatch(api, 'request shutdown')
        api.wait_for_shutdown()

if __name__ == '__main__':
    main()
EOF_RUN

stdin=ze-bgp:terminator=EOF_CONF
anomaly {
	shape {
		mode shadow
	}
}

plugin {
	external anomaly-shape-test {
		run ./anomaly-shape-test.run
		encoder json
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast {
					prefix {
						maximum 10000
					}
				}
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
