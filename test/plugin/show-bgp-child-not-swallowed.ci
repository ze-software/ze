# Test: the four plugin subtrees under `show bgp` still reach their own handler.
#
# VALIDATES: spec-cli-dispatch-child-guard AC-2 and assumption A-1. rpki, rs,
#            adj-rib-in and healthcheck register their commands as PLUGIN names,
#            which the daemon reaches only after the builtin match fails. The
#            guard in matchBuiltinTokens refuses the `show bgp` match for each of
#            them, so the plugin fallback answers.
# PREVENTS:  R-2, a guard that reads the builtin keys alone. It passes every
#            builtin test and still sends `show bgp rpki status` to the summary
#            handler, which reports "rpki" as an invalid address family.

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=20s
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

tmpfs=child-not-swallowed.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
"""Assert no plugin subtree under `show bgp` is swallowed by the parent."""
import json
import sys

from ze_api import API

SUBTREES = (
    'show bgp rpki status',
    'show bgp rs peers',
    'show bgp adj-rib-in',
    'show bgp healthcheck',
)


def dispatch(api, command):
    try:
        resp = api._call_engine(
            'ze-plugin-engine:dispatch-command', {'command': command})
    except RuntimeError as exc:
        # A command registered nowhere is an RPC-level error, which is the same
        # answer Dispatch gives for any unknown command.
        return {'status': 'error', 'data': str(exc)}
    if resp is None:
        return {'status': 'error', 'data': 'engine call returned None'}
    return resp.get('result', {})


def payload(result):
    data = result.get('data', {})
    if isinstance(data, str):
        try:
            data = json.loads(data)
        except json.JSONDecodeError:
            return {}
    return data if isinstance(data, dict) else {}


def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()
    api.wait_for_post_startup(timeout=5.0)

    failed = False
    try:
        for command in SUBTREES:
            result = dispatch(api, command)
            message = str(result.get('data', ''))
            if result.get('status') != 'done':
                print(f'FAIL: {command} status={result.get("status")} data={message}', file=sys.stderr)
                failed = True
                continue
            if 'peers-configured' in payload(result):
                print(f'FAIL: {command} reached the summary handler', file=sys.stderr)
                failed = True
                continue
            print(f'OK: {command} reached its own handler', file=sys.stderr)

        # The parent is still a command, and it still answers.
        bare = dispatch(api, 'show bgp')
        if bare.get('status') != 'done':
            print(f'FAIL: show bgp status={bare.get("status")}', file=sys.stderr)
            failed = True
    finally:
        dispatch(api, 'request shutdown')
        api.wait_for_shutdown()

    if failed:
        sys.exit(1)


if __name__ == '__main__':
    main()
EOF_RUN

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external child-not-swallowed {
		run ./child-not-swallowed.run
		encoder json
	}
	internal bgp-rib {
		use bgp-rib
	}
	internal adj-rib-in {
		use bgp-adj-rib-in
	}
	internal rpki {
		use bgp-rpki
	}
	internal rs {
		use bgp-rs
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze --plugin ze.bgp-healthcheck -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
