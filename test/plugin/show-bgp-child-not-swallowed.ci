# Test: the four plugin subtrees under `show bgp` still reach their own handler.
#
# VALIDATES: spec-cli-dispatch-child-guard AC-2 and assumption A-1. rpki, rs,
#            adj-rib-in and healthcheck register their commands as PLUGIN names,
#            which the daemon reaches only after the builtin match fails. The
#            guard in matchBuiltinTokens refuses the `show bgp` match for each of
#            them, so the plugin fallback answers.
# PREVENTS:  R-2, a guard that reads the builtin keys alone. It passes every
#            builtin test and still sends `show bgp rpki status` to the summary
#            handler, which reports "rpki" as an invalid address family.

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=20s
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# Native observer fixture: plugin/show-bgp-child-not-swallowed.

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external child-not-swallowed {
		run "ze-test fixture plugin/show-bgp-child-not-swallowed"
		encoder json
	}
	internal bgp-rib {
		use bgp-rib
	}
	internal adj-rib-in {
		use bgp-adj-rib-in
	}
	internal rpki {
		use bgp-rpki
	}
	internal rs {
		use bgp-rs
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze --plugin ze.bgp-healthcheck -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
