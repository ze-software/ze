# Migrated from test/data/plugin/notification.*

# ze-peer expectations
stdin=peer:terminator=EOF_PEER
action=notification:conn=1:seq=1:text=closing session because we can
EOF_PEER

# native plugin script

# ze bgp configuration
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external announce-routes {
		run "ze-test fixture plugin/notification"
		encoder json
	}
}
bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		attach process announce-routes {
			send [ update ]
		}
	}
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=10s
