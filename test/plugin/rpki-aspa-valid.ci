# Test: ASPA verification yields Valid when all hops authorized
# VALIDATES: AC-2 — route with all authorized provider hops -> aspa-state=valid
# PREVENTS: ASPA verification not running or not emitting state in event

# ze-peer: send route 10.0.1.0/24 with AS_PATH [64500, 64501, 64502]
# 64501 authorizes 64500, 64502 authorizes 64501 -> all hops Valid
option=needs-linux:caps=net-admin
option=netns-link:name=eth1:address=10.0.0.254/24

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=linger:value=true
option=timeout:value=15s
# NEXT_HOP is nonlocal and on eth1's connected subnet in the isolated test namespace.
option=update:value=send-route:prefix=10.0.1.0/24:origin-as=64502:next-hop=10.0.0.1:as-path=64500,64501,64502
# EOR from ze
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# native observer: subscribe to rpki events, check aspa-state=valid
# Native compiled fixture: plugin/rpki-aspa-valid
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	hub {
		server local {
			ip 127.0.0.1;
			port 0;
			secret rpki-test-secret-key-01234567890;
		}
	}
	external rpki-aspa-valid-test {
		run "le test fixture plugin/rpki-aspa-valid"
		encoder json
	}
	internal rpki {
		use bgp-rpki
	}
	internal adj-rib-in {
		use bgp-adj-rib-in
	}
}

bgp {
	policy { reject-asn NO-TRANSIT { indirect [ 64496 ]; } }
	rpki {
		cache-server 127.0.0.1 {
			trusted-network true
			port $PORT2
		}
		aspa {
			validation true;
		}
	}
	peer peer1 {
		role { import provider; }
		# Isolate ASPA from the independent transit-leak filter.
		filter { import [ inactive:NO-TRANSIT ]; }
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 64500
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}

		attach process rpki-aspa-valid-test {
			receive [ rpki-received ]
		}
		attach process rpki {
			receive [ update-received state ]
		}
		attach process adj-rib-in {
			receive [ update-received state ]
		}
	}
}
EOF_CONF

# RTR mock: VRP covers 10.0.0.0/8 for origin 64502 + ASPA records for Valid path
# ASPA: 64501 authorizes 64500 as provider, 64502 authorizes 64501 as provider
cmd=background:seq=1:exec=le test rtr-mock --port $PORT2 --vrp 10.0.0.0/8,24,64502 --aspa 64501:64500 --aspa 64502:64501:ready=le test rtr-mock: listening on
cmd=background:seq=2:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=3:exec=ze -:stdin=ze-bgp:timeout=25s
expect=exit:code=0
