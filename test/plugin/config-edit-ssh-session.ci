# Test: SSH session gets editor for concurrent config editing
#
# Flow:
# 1. BGP daemon starts with SSH configured and config path wired
# 2. Plugin verifies SSH server is listening on configured port
# 3. Plugin dispatches a config-related command to verify wiring
# 4. Daemon shuts down
#
# VALIDATES: AC-22 -- SSH sessions get editor with session identity.
# PREVENTS: SSH server starting without ConfigPath, sessions stuck in command-only mode.
# NOTE: Interactive SSH session editing tested via Go unit test TestSSHSessionGetsEditor.

# ze-peer expectations
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s

# EOR

# ze-peer runs as a sink: only a dial target, asserts nothing. This test is about
# the SSH editor session; the BGP peer exists so ze has a session to configure.
#
# // the ipv4/unicast EOR this block declared RACED the run-script's
# `request shutdown`, which fires at post-startup while ze is still in the OPEN
# handshake. Observed both ways on a quiet tree: usually the peer logs "open recv /
# open sent / connection closed before completion" and the EOR never arrives (red),
# occasionally ze wins the race and sends it (green). That flip is why
# plan/deferrals.md files this test under "load-sensitive"; the failure signature is
# identical to the deterministic EOR reds, so the cause is the race, not machine
# load. Whether ze SHOULD delay shutdown for the EOR is a real question, owned by
# plan/spec-fixit-redistribute-establishment-stall.md and the "who is entitled to
# delay a BGP session's EOR" spec -- sinking here does not answer it and must not be
# read as answering it. Coverage is NOT reduced: this test never asserted BGP wire
# content -- its editor/SSH assertions and expect=exit:code=0 are what it proves.
EOF_PEER

# ze bgp configuration with SSH and authentication
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external ssh-session-test {
		run "ze-test fixture plugin/config-edit-ssh-session $PORT2"
		encoder json
	}
}

system {
	authentication {
		user admin {
			password "$2a$10$abcdefghijklmnopqrstuuABCDEFGHIJKLMNOPQRSTUVWXYZ0123"
		}
	}
}

environment {
	ssh {
		enabled true
		server main {
			ip 127.0.0.1;
			port $PORT2;
		}
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --mode sink --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
