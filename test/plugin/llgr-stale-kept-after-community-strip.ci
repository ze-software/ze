# Test: an operator community strip of LLGR_STALE does not hide the stale
# marking from the LLGR procedure (spec-filter-wire-6-stage-filters D-6).
# VALIDATES: bgp-gr's inserted llgr-ingress member runs before the operator's
#   bgp-filter-community:ingress member, so 10.0.0.0/8 from peer llgr (Ze sent
#   it LLGR) carrying LLGR_STALE is marked stale and still loses Step 0
#   (stale-level) to peer plain's fresh copy, although peer llgr's import chain
#   strips LLGR_STALE (65535:6) from the route.
# PREVENTS: the 9501e4a6f5 ordering, where the community strip ran in the
#   policy stage ahead of the chain, removed LLGR_STALE before llgr-ingress read
#   it, and the stale route won on LOCAL_PREF 200.

stdin=llgr:terminator=EOF_LLGR
option=tcp_connections:value=1
option=open:value=router-id:id=192.0.2.1
option=timeout:value=30s
option=linger:value=true
# 10.0.0.0/8: ORIGIN IGP, AS_PATH empty, NEXT_HOP 10.0.0.1, LOCAL_PREF 200, COMMUNITIES LLGR_STALE.
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0035020000001C400101004002004003040A000001400504000000C8C00804FFFF0006080A
# 10.1.0.0/16: ORIGIN IGP, AS_PATH empty, NEXT_HOP 10.0.0.1, LOCAL_PREF 100.
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002F0200000015400101004002004003040A00000140050400000064100A01
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_LLGR

stdin=plain:terminator=EOF_PLAIN
option=tcp_connections:value=1
option=open:value=router-id:id=192.0.2.2
option=timeout:value=30s
option=linger:value=true
# 10.0.0.0/8: ORIGIN IGP, AS_PATH empty, NEXT_HOP 10.0.0.2, LOCAL_PREF 100.
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002E0200000015400101004002004003040A00000240050400000064080A
# 10.1.0.0/16: ORIGIN IGP, AS_PATH empty, NEXT_HOP 10.0.0.2, LOCAL_PREF 200, COMMUNITIES LLGR_STALE.
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0036020000001C400101004002004003040A000002400504000000C8C00804FFFF0006100A01
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PLAIN

stdin=ze-bgp:terminator=EOF_CONF
plugin {
 internal gr { use bgp-gr; }
 internal bgp-rib { use bgp-rib; }
 external observer { run "le test fixture plugin/llgr-stale-received-depreferenced"; encoder json; }
}
bgp {
 community { standard llgr-stale { value 65535:6; } }
 peer llgr {
  connection { remote { ip 127.0.0.1; } local { ip 127.0.0.1; accept false; } }
  session {
   asn { local 65000; remote 65000; }
   router-id 1.2.3.4
   family { ipv4/unicast { prefix { maximum 10000; } } }
   capability { graceful-restart { restart-time 120; long-lived-stale-time 3600; } }
  }
  filter {
   import { filters [ bgp-filter-community:ingress ]; final accept; }
   ingress { community { strip llgr-stale; } }
  }
  attach process gr { receive [ open state eor ]; send [ update ]; }
  attach process bgp-rib { receive [ update state refresh ]; send [ update ]; }
  attach process observer { receive [ state ]; }
 }
 peer plain {
  connection { remote { ip ::1; } local { ip ::1; accept false; } }
  session {
   asn { local 65000; remote 65000; }
   router-id 1.2.3.4
   family { ipv4/unicast { prefix { maximum 10000; } } }
   capability { graceful-restart disable }
  }
  attach process gr { receive [ open state eor ]; send [ update ]; }
  attach process bgp-rib { receive [ update state refresh ]; send [ update ]; }
  attach process observer { receive [ state ]; }
 }
}
EOF_CONF

cmd=background:seq=1:exec=le test peer --port $PORT:stdin=llgr
cmd=background:seq=2:exec=le test peer --bind ::1 --port $PORT:stdin=plain
cmd=foreground:seq=3:exec=ze --plugin ze.bgp-filter-community -:stdin=ze-bgp:timeout=35s
await=stderr:contains=OK: llgr received 10.1.0.0/16:then=stop
expect=stderr:contains=OK: llgr received 10.0.0.0/8 best ::1 by stale-level
expect=stderr:contains=OK: llgr received 10.1.0.0/16 best ::1 by local-preference
reject=stderr:pattern=panic
reject=stderr:pattern=ZE-OBSERVER-FAIL
