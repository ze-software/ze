# Test: a BGP multipath best-path change delivers the full ECMP next-hop set to
#       the system RIB in realtime (rib-arch-4).
# VALIDATES: two equal-cost BGP routes (distinct next-hops) produce a sysrib
#            entry whose ecmp-paths carries the sibling next-hop, and shrinking
#            the ECMP set (withdraw one) empties ecmp-paths -- i.e. BGP multipath
#            reaches sysrib, not just the `show bgp rib best` display.
# PREVENTS: BGP ECMP collapsing to a single next-hop because SelectMultipath's
#           siblings never reached the Loc-RIB / sysrib.

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=20s
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER


stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external fib-ecmp-realtime {
		run "ze-test fixture plugin/fib-ecmp-realtime"
		encoder json
	}
	internal bgp-rib {
		use bgp-rib
	}
	internal rib {
		use rib
	}
}

bgp {
	multipath {
		maximum-paths 4
		relax-as-path true
	}

	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65000
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}

		attach process bgp-rib {
			receive [ update state refresh ]
			send [ update ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
