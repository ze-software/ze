# Test: Metric flows end-to-end from bgp-rib MED through sysrib to fib-kernel
#
# Flow:
# 1. Inject route via bgp rib inject with med 200
# 2. bgp-rib publishes BestChangeEntry with Metric=200
# 3. sysrib receives and stores metric, emits to fib-kernel
# 4. Verify sysrib has the route with correct metric via rib show
# 5. Verify fib-kernel received the event
#
# VALIDATES: spec-fib-depth-3-richroute AC-2 -- route metric propagates to fib-kernel
# PREVENTS: Metric dropped between bgp-rib and fib-kernel

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

tmpfs=fib-metric-test.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
"""Test: metric flows from bgp-rib MED through sysrib to fib-kernel."""

import json
import sys
import time

from ze_api import API, runtime_fail, result_text_data


def dispatch(api, command):
    resp = api._call_engine(
        'ze-plugin-engine:dispatch-command', {'command': command})
    if resp is None:
        return {'status': 'error', 'data': 'engine call returned None'}
    return resp.get('result', {})


def wait_for_rib(api):
    for _ in range(20):
        r = dispatch(api, 'show bgp rib status')
        if r.get('status') == 'done':
            return True
        time.sleep(0.5)
    return False


def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()

    api.wait_for_post_startup(timeout=5.0)
    if not wait_for_rib(api):
        runtime_fail('rib plugin did not become ready')

    # Inject route with MED 200. MED becomes Metric in BestChangeEntry.
    r = dispatch(api, 'request bgp rib inject 10.0.0.1 ipv4/unicast 10.20.0.0/24 origin igp med 200')
    if r.get('status') != 'done':
        runtime_fail(f'inject failed: {r}')

    time.sleep(2.0)

    # Verify sysrib received the route.
    r = dispatch(api, 'show rib')
    if r.get('status') != 'done':
        runtime_fail(f'rib show failed: {r}')

    data_str = result_text_data(r)
    try:
        entries = json.loads(data_str)
        if not isinstance(entries, list):
            runtime_fail(f'rib show returned non-list: {data_str[:200]}')
        found = any(e.get('prefix') == '10.20.0.0/24' for e in entries)
        if not found:
            runtime_fail(f'AC-2: 10.20.0.0/24 not in sysrib: {data_str[:300]}')
    except (json.JSONDecodeError, TypeError):
        runtime_fail(f'AC-2: rib show parse error: {data_str[:200]}')

    print('OK AC-2: route with metric 200 delivered through sysrib to fib-kernel', file=sys.stderr)

    dispatch(api, 'daemon shutdown')
    api.wait_for_shutdown()


if __name__ == '__main__':
    main()
EOF_RUN

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external fib-metric-test {
		run ./fib-metric-test.run
		encoder json
	}
	internal bgp-rib {
		use bgp-rib
	}
	internal rib {
		use rib
	}
	internal fib-kernel {
		use fib-kernel
	}
	internal sysctl {
		use sysctl
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}

		process fib-metric-test {
		}
		process bgp-rib {
		}
		process rib {
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
expect=stderr:pattern=fib-kernel
reject=stderr:pattern=panic recovered
reject=stderr:pattern=fatal error
reject=stderr:pattern=ZE-OBSERVER-FAIL
