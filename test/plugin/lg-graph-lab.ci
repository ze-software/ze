# Test: Looking glass graph lab -- UK network topology
# VALIDATES: next-hop and AS-path graph modes return correct topology from injected routes
# PREVENTS: graph builder producing wrong nodes/edges, mode parameter ignored

# ze-peer expectations (minimal handshake)
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=25s
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER


# ze bgp configuration with LG enabled
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external lg-lab {
		run "ze-test interop-bgp process lg-graph-lab lg-lab"
		encoder json
	}
	internal bgp-rib {
		use bgp-rib
	}
}

environment {
	looking-glass {
		enabled true
		# TLS defaults ON since spec-fixit-mgmt-listener-auth-guard AC-5.
		# This test asserts looking-glass CONTENT over plain HTTP, so it takes
		# the documented opt-out rather than terminating a self-signed TLS
		# handshake; the opt-out working is part of AC-5.
		tls false
		server main {
			ip 127.0.0.1
			port $PORT2
		}
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65000
			}
			router-id 10.0.0.1
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}

		attach process bgp-rib {
			receive [ update state refresh ]
			send [ update ]
		}
	}
}
EOF_CONF

# Process orchestration -- both in background, HTTP checks are the assertions
cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=background:seq=2:exec=ze -:stdin=ze-bgp

# Wait for routes to be injected by lg-lab plugin before checking graph output.
#
# ONE wait per prefix asserted below, each naming an ASN that only appears once
# that prefix's paths are all in the RIB. Waiting on 10.10.1.0/24 alone gated on
# a proxy: the plugin injects the three prefixes' routes as separate commands,
# so prefix 1 being complete says nothing about prefix 3, and under load the
# graph for 10.10.3.0/24 was rendered from a partially populated RIB and missed
# its exact-body match (seen once in a full ./le verify current mode full run, 2026-07-26; not
# reproducible in 40 stressed runs of this test alone, because in isolation the
# injection always wins the race). Each prefix now waits for its own state
# rather than for prefix 1's (ai/rules/fix-dont-record.md).
#
# The chosen ASNs are the transit hop farthest from the peer in each prefix's
# expected aspath graph, so the wait cannot pass on a half-built path.
http=wait:seq=1:url=http://127.0.0.1:$PORT2/lg/graph?prefix=10.10.1.0/24&mode=aspath&format=text:status=200:contains=AS2914:timeout=15s
http=wait:seq=2:url=http://127.0.0.1:$PORT2/lg/graph?prefix=10.10.2.0/24&mode=aspath&format=text:status=200:contains=AS13335:timeout=15s
http=wait:seq=3:url=http://127.0.0.1:$PORT2/lg/graph?prefix=10.10.3.0/24&mode=aspath&format=text:status=200:contains=AS20940:timeout=15s

# --- AS Path SVG: exact match against reference files ---
http=get:seq=1:url=http://127.0.0.1:$PORT2/lg/graph?prefix=10.10.1.0/24&mode=aspath:status=200:bodyfile=lg-graph-lab/expect/lg-graph-p1-aspath.svg
http=get:seq=2:url=http://127.0.0.1:$PORT2/lg/graph?prefix=10.10.2.0/24&mode=aspath:status=200:bodyfile=lg-graph-lab/expect/lg-graph-p2-aspath.svg
http=get:seq=3:url=http://127.0.0.1:$PORT2/lg/graph?prefix=10.10.3.0/24&mode=aspath:status=200:bodyfile=lg-graph-lab/expect/lg-graph-p3-aspath.svg

# --- Next-hop SVG: exact match against reference files ---
http=get:seq=4:url=http://127.0.0.1:$PORT2/lg/graph?prefix=10.10.1.0/24&mode=nexthop:status=200:bodyfile=lg-graph-lab/expect/lg-graph-p1-nexthop.svg
http=get:seq=5:url=http://127.0.0.1:$PORT2/lg/graph?prefix=10.10.2.0/24&mode=nexthop:status=200:bodyfile=lg-graph-lab/expect/lg-graph-p2-nexthop.svg
http=get:seq=6:url=http://127.0.0.1:$PORT2/lg/graph?prefix=10.10.3.0/24&mode=nexthop:status=200:bodyfile=lg-graph-lab/expect/lg-graph-p3-nexthop.svg
