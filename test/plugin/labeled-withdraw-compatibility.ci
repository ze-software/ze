# Test: a labeled unicast withdrawal whose Compatibility field is 0x800000
# reaches a plugin as a del of the prefix it names.
# VALIDATES: ze-peer announces 10.0.0.0/8 in ipv4/mpls-label under label 100,
# then withdraws it with MP_UNREACH_NLRI [Length 32][0x800000][10]; the JSON
# event the attached plugin receives carries
# "ipv4/mpls-label":[{"action":"del","nlri":["10.0.0.0/8"]}], which the fixture
# decodes and prints as "LABELED-EVENT: del 10.0.0.0/8" (ze relays plugin
# stderr through its logger, which escapes quotes, so the line holds none).
# PREVENTS: the withdrawal framed by the announcement reader, which walks
# 0x800000 as a label entry with the S bit clear, runs past the NLRI, and hands
# the plugin no withdrawal at all.
# RFC 8277 Section 2.4: "Upon reception, the value of the Compatibility field
# MUST be ignored."

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
option=linger:value=true
option=asn:value=65001
option=open:value=add-capability:code=1:hex=00010004
# ORIGIN IGP, AS_PATH [65001], MP_REACH_NLRI ipv4/mpls-label next hop
# 127.0.0.1, NLRI [Length 32][label 100, S set][10].
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0035020000001E4001010040020602010000FDE9800E0E000104047F00000100200006410A
# MP_UNREACH_NLRI ipv4/mpls-label [Length 32][Compatibility 0x800000][10].
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0022020000000B800F08000104208000000A
EOF_PEER

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external labeled-withdraw-event {
		run "le test fixture plugin/labeled-withdraw-event"
		encoder json
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/mpls-label { prefix { maximum 10000; } }
			}
		}
		behavior {
			group-updates disable
		}

		attach process labeled-withdraw-event {
			receive [ update-received ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=30s
expect=stderr:contains=LABELED-EVENT: add object
expect=stderr:contains=LABELED-EVENT: del 10.0.0.0/8
