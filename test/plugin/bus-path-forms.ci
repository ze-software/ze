expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PT2_2

# Form 1: /bgp/group/transit
tmpfs=f1-group.conf:terminator=EOF_F1
system {
	authentication {
		user admin {
			password "$2a$04$UlwuiuH82Unfsq.XEMPGJeDkXwbm3KW.nvVaVXOd/JeFK8VjMjrQO"
		}
	}
}
environment {
	ssh {
		enabled true
		server main { ip 127.0.0.1; port $PORT2; }
	}
}
bus {
	endpoint collector {
		external {
			run "le test fixture plugin/bus-bgp-collector f1.log";
		}
		encoding json;
		receive {
			from [ /bgp/group/transit ];
		}
	}
}
bgp {
	router-id 192.0.2.254;
	filter {
		import { final accept; }
		export { final accept; }
	}
	peer edge1 {
		connection { remote { ip 127.0.0.2; } local { ip 127.0.0.1; accept false; } }
		session { asn { local 65000; remote 65001; } family { ipv4/unicast { prefix { maximum 10000; } } } capability { graceful-restart disable; } }
		behavior { group-updates disable; }
	}
	peer lab {
		connection { remote { ip 127.0.0.3; } local { ip 127.0.0.1; accept false; } }
		session { asn { local 65000; remote 65002; } family { ipv4/unicast { prefix { maximum 10000; } } } capability { graceful-restart disable; } }
		behavior { group-updates disable; }
	}
	group transit {
		peer t1 {
			connection { remote { ip 127.0.0.4; } local { ip 127.0.0.1; accept false; } }
			session { asn { local 65000; remote 65003; } family { ipv4/unicast { prefix { maximum 10000; } } } capability { graceful-restart disable; } }
			behavior { group-updates disable; }
		}
		peer t2 {
			connection { remote { ip 127.0.0.5; } local { ip 127.0.0.1; accept false; } }
			session { asn { local 65000; remote 65004; } family { ipv4/unicast { prefix { maximum 10000; } } } capability { graceful-restart disable; } }
			behavior { group-updates disable; }
		}
	}
}
EOF_F1

