cmd=foreground:seq=1:exec=ze init:stdin=init-answers:exit=0

# --- Form 1: /bgp/group/transit -> t1 and t2 only ---
cmd=background:seq=2:name=e1-1:exec=le test peer --bind 127.0.0.2 --port $PORT:stdin=p-edge1-1
cmd=background:seq=3:name=lab-1:exec=le test peer --bind 127.0.0.3 --port $PORT:stdin=p-lab-1
cmd=background:seq=4:name=t1-1:exec=le test peer --bind 127.0.0.4 --port $PORT:stdin=p-t1-1
cmd=background:seq=5:name=t2-1:exec=le test peer --bind 127.0.0.5 --port $PORT:stdin=p-t2-1
cmd=background:seq=6:name=d1:exec=ze start f1-group.conf:ready=Ze running.
reject=stderr:pattern=ZE-OBSERVER-FAIL
reject=stderr:pattern=panic

cmd=foreground:seq=7:exec=le test fixture daemon/await-answer-all "show bgp rib" 10.0.1.0/24 10.0.2.0/24 10.0.3.0/24 10.0.4.0/24:exit=0
cmd=foreground:seq=8:exec=le test fixture plugin/bus-assert-implied poll-file-contains f1.log 10.0.3.0/24:exit=0
cmd=foreground:seq=9:exec=le test fixture plugin/bus-assert-implied poll-file-contains f1.log 10.0.4.0/24:exit=0
cmd=foreground:seq=10:exec=le test fixture plugin/bus-assert-implied file-not-contains f1.log 127.0.0.2:exit=0
cmd=foreground:seq=11:exec=le test fixture plugin/bus-assert-implied file-not-contains f1.log 127.0.0.3:exit=0
cmd=foreground:seq=12:exec=ze cli -c "show config running | implied":exit=0
expect=stdout:contains=from /bgp/group/transit

cmd=stop:seq=13:name=d1:signal=term
cmd=stop:seq=14:name=e1-1
cmd=stop:seq=15:name=lab-1
cmd=stop:seq=16:name=t1-1
cmd=stop:seq=17:name=t2-1

# --- Form 2: /bgp/group/transit/peer/t1 -> t1 only ---
