# Test: startup and reload stay responsive when every external service is unreachable.
#
# VALIDATES: startup-resilience AC-2, AC-3, AC-5 and the managed-hub doctor check.
# PREVENTS: a dead RPKI, BMP, NTP, RADIUS, or hub peer blocking startup or reload.

tmpfs=unreachable.conf:mode=600:terminator=EOF_CONF
bgp {
	router-id 1.2.3.4
	session { asn { local 65000; } }
	rpki { cache-server 203.0.113.2 { port 3323; } }
	bmp {
		sender {
			collector c1 { address 203.0.113.3; port 11019; }
		}
	}
}
system {
	authentication {
		radius {
			server 203.0.113.1 { port 1812; key "unused-probe-secret"; }
			timeout 1
			retries 1
		}
	}
}
environment {
	ntp {
		enabled true
		interval 3600
		server dead1 { address 203.0.113.4; }
		server dead2 { address 203.0.113.6; }
		server dead3 { address 203.0.113.7; }
	}
}
plugin {
	hub {
		client edge-01 {
			host 203.0.113.5
			port 8443
			secret "startup-resilience-32char-min-secret"
		}
	}
	external startup-unreachable-test {
		run "ze-test fixture plugin/startup-unreachable-services unreachable.conf"
		encoder json
	}
}
EOF_CONF

# The offline command remains a declarative runner command, so the exact ze doctor
# entry point is exercised without an embedded helper program.
cmd=foreground:seq=1:exec=ze doctor --json unreachable.conf:exit=0:timeout=60s
cmd=foreground:seq=2:exec=ze start unreachable.conf:timeout=60s
expect=exit:code=0
expect=stdout:contains=doctor-hub-unreachable
expect=stdout:contains=doctor-ntp-server-unreachable
expect=stdout:contains=doctor-rpki-unreachable
expect=stdout:contains=doctor-bmp-unreachable
expect=file:path=daemon.ready:exists=true
expect=stderr:pattern=OK: daemon reached ready with all external services blackholed
expect=stderr:pattern=OK: environment/ntp reload applied within budget while servers blackholed
expect=stderr:contains=received SIGHUP
reject=stderr:pattern=apply timeout
reject=stderr:pattern=reload error
reject=stderr:pattern=ZE-OBSERVER-FAIL
