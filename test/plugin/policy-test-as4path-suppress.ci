# Test: show policy test over a two-octet UPDATE whose private ASN sits in
#       AS4_PATH explains the route the live import produces
# VALIDATES: spec-pol-4-explain AC-10 -- the paste is merged into the four-octet
#            form (RFC 6793 Section 4.2.3), remove-private-as removes the
#            AS4_PATH-carried 4200000000 from the merged as-path, and the
#            wire-changes section names the AS_PATH rewrite
# PREVENTS: AS4_PATH (RFC 6793) effects being invisible because the flat filter
#           text only carries the merged "as-path"

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=20s
option=bind:value=0.0.0.0
EOF_PEER


stdin=ze-bgp:terminator=EOF_CONF
plugin {
	internal rs {
		use bgp-rs
	}
	external policy-test-as4 {
		run "le test fixture plugin/policy-test-as4path-suppress"
		encoder json
	}
}
policy {
	remove-private-as STRIP {
	}
}

bgp {
	peer test-peer {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		filter {
			export { filters [ STRIP ]; final accept; }
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=le test peer --mode sink --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze --plugin ze.bgp-filter-remove-private-as -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
reject=stderr:pattern=ZE-OBSERVER-FAIL
reject=stderr:pattern=panic
reject=stderr:pattern=fatal error
