# Test: show policy test surfaces AS4_PATH suppression in the wire-changes section
# VALIDATES: spec-pol-4-explain AC-10 -- AS4_PATH suppressed by remove-private-as
#            appears in the dry-run wire-diff section
# PREVENTS: AS4_PATH (RFC 6793) effects being invisible because the flat filter
#           text only carries the merged "as-path"

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=20s
option=bind:value=0.0.0.0
EOF_PEER


stdin=ze-bgp:terminator=EOF_CONF
plugin {
	internal rs {
		use bgp-rs
	}
	external policy-test-as4 {
		run "ze-test fixture plugin/policy-test-as4path-suppress"
		encoder json
	}
}
bgp {
	policy {
		remove-private-as STRIP {
		}
	}
	peer test-peer {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		filter {
			export [ STRIP ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --mode sink --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze --plugin ze.bgp-filter-remove-private-as -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
reject=stderr:pattern=ZE-OBSERVER-FAIL
reject=stderr:pattern=panic
reject=stderr:pattern=fatal error
