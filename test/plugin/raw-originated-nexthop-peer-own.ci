# Question: do both raw operator command forms withhold a peer-own NEXT_HOP
# while preserving the original withdrawal and permitted routes on one socket?
# Unit tests cannot prove command authorization, parsing and the external plugin
# dispatch reach the running daemon's final writer and an independent receiver.
# RFC 4271 Section 5.1.3: "A route originated by a BGP speaker SHALL NOT be
# advertised to a peer using an address of that peer as NEXT_HOP."
# RFC requirement: RFC4271-5.1.3-1 positive -- raw body and full-packet commands never announce their peer-own IPv4 subjects to the recipient, including a mixed original withdrawal.
# RFC requirement: RFC4271-5.1.3-1 negative -- both raw command forms emit the exact useful before/after prefixes with literal third-party NEXT_HOP and retain each original withdrawal on that same connection.

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=asn:value=65001
option=timeout:value=40s
option=linger:value=true
expect=bgp:conn=1:seq=1:announced=180A5A00:attribute=3,CB007101
expect=bgp:conn=1:seq=2:withdrawn=180A5A00
expect=bgp:conn=1:seq=3:announced=180A5A02:attribute=3,CB007101
expect=bgp:conn=1:seq=4:announced=180A5B00:attribute=3,CB007101
expect=bgp:conn=1:seq=5:withdrawn=180A5B00
expect=bgp:conn=1:seq=6:announced=180A5B02:attribute=3,CB007101
reject=bgp:conn=1:scope=announced:pattern=180A5A01
reject=bgp:conn=1:scope=announced:pattern=180A5B01
EOF_PEER

stdin=ze-bgp:terminator=EOF_CONF
bus {
	endpoint raw-originated-nh {
		external {
			run "le test fixture plugin/raw-originated-nexthop-peer-own";
		}
		encoding json;
	}
}
bgp {
	filter {
		import { final accept; }
		export { final accept; }
	}
	peer under-test {
		connection {
			remote { ip 127.0.0.1; }
			local { ip 127.0.0.2; accept false; }
		}
		session {
			asn { local 65000; remote 65001; }
			router-id 1.2.3.4;
			family { ipv4/unicast { prefix { maximum 10000; } } }
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=40s
expect=exit:code=0
reject=stderr:pattern=panic recovered
reject=stderr:pattern=fatal error
reject=stderr:pattern=ZE-OBSERVER-FAIL
