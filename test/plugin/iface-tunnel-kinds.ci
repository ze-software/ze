# Test: every tunnel kind ze models can be created on the running kernel
# Exercises: interface config -> iface OnConfigure -> netlink CreateTunnel ->
#            RTM_NEWLINK -> `show interface` (internal/component/iface/cmd/show_interface.go)
# VALIDATES: all nine kinds in tunnelKindNames (internal/component/iface/tunnel.go)
#            reach the kernel and leave a link behind, read back by name.
# PREVENTS:  a kind ze models, YANG accepts, and the kernel cannot build. Eight of
#            the nine had no symbol in gokrazy/kernel/runtime.config until
#            2026-08-11, so the daemon answered `operation not supported` to a
#            config it had already validated.
#
# This test is the RUNTIME half of the guard. The build half is
# gokrazy/kernel/runtime.require, which fails the kernel build when a symbol
# resolves to anything but =y, and TestTunnelKindsAllHaveKernelSupport
# (internal/component/iface/tunnel_test.go), which fails when a kind is added
# to tunnelKindNames with no symbol behind it.
#
# Why the assertion discriminates: a kind whose kernel symbol is absent never
# produces a link, so its name never appears in `show interface`. Reverting one
# symbol in runtime.config removes every name that symbol carries: two for
# NET_IPGRE, IPV6_GRE and IPV6_TUNNEL, one for each of the rest.
#
# Every endpoint pair is unique. ip6tnl and ipip6 are both the ip6_tunnel
# module, and ip6_tnl_newlink returns -EEXIST for a second tunnel with the same
# local and remote (net/ipv6/ip6_tunnel.c), so the two rows must not share a pair.
#
# The pairs must also be unique ACROSS tests, not only within this one. The
# kernel answers EEXIST on a duplicate local/remote whatever the device is
# named, and the suites share one VM: this file first shipped on 192.0.2.1-.5 /
# 198.51.100.1-.5, which test/reload/tx-iface-tunnel-create.ci already uses
# for the same encapsulation kinds. This test ran first, left its links behind,
# and the reload test then failed its whole config transaction on
# `create tunnel "tgretap" (kind gretap): file exists` -- a name it had never
# created. Hence the .201+ offset and the 2001:db8:c8:: prefix. A tunnel test
# added later needs its own block, not the next free number in this one.
#
# That constraint is enforced, not left to this comment:
# TestCITunnelEndpointsAreUniqueAcrossTests
# (internal/test/runner/tunnel_endpoint_lint_test.go) reads every .ci that
# declares caps=net-admin and fails when two of them claim one pair.

# Creating links needs CAP_NET_ADMIN, not merely Linux (ai/rules/platform-linux.md).
option=needs-linux:caps=net-admin

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=20s
option=asn:value=65001
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER


stdin=ze-conf:terminator=EOF_CONF
plugin {
	external iface-tunnel-kinds-test {
		run "ze-test fixture plugin/iface-tunnel-kinds"
		encoder json
	}
}

interface {
	backend netlink

	tunnel tkgre {
		encapsulation {
			gre {
				local { ip 192.0.2.201; }
				remote { ip 198.51.100.201; }
			}
		}
	}
	tunnel tkgretap {
		encapsulation {
			gretap {
				local { ip 192.0.2.202; }
				remote { ip 198.51.100.202; }
			}
		}
	}
	tunnel tkipip {
		encapsulation {
			ipip {
				local { ip 192.0.2.203; }
				remote { ip 198.51.100.203; }
			}
		}
	}
	tunnel tksit {
		encapsulation {
			sit {
				local { ip 192.0.2.204; }
				remote { ip 198.51.100.204; }
			}
		}
	}
	tunnel tkvxlan {
		encapsulation {
			vxlan {
				local { ip 192.0.2.205; }
				remote { ip 198.51.100.205; }
				vni 1000
			}
		}
	}
	tunnel tkip6gre {
		encapsulation {
			ip6gre {
				local { ip 2001:db8:c8::1; }
				remote { ip 2001:db8:c8::2; }
			}
		}
	}
	tunnel tkip6gretap {
		encapsulation {
			ip6gretap {
				local { ip 2001:db8:c8::3; }
				remote { ip 2001:db8:c8::4; }
			}
		}
	}
	tunnel tkip6tnl {
		encapsulation {
			ip6tnl {
				local { ip 2001:db8:c8::5; }
				remote { ip 2001:db8:c8::6; }
			}
		}
	}
	tunnel tkipip6 {
		encapsulation {
			ipip6 {
				local { ip 2001:db8:c8::7; }
				remote { ip 2001:db8:c8::8; }
			}
		}
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-conf:timeout=20s
expect=exit:code=0
expect=stderr:contains=OK: all 9 tunnel kinds created
reject=stderr:pattern=panic
