# Test: Successful 5-stage plugin registration protocol
# Validates full protocol: declare, config, capability, registry, ready
# Uses full API (not simple ready()) to test all protocol stages explicitly

# ze-peer expectations
stdin=peer:terminator=EOF_PEER
# Plugin sends EOR after successful registration
cmd=api:conn=1:seq=1:text=peer * update text nlri ipv4/unicast eor
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# native plugin script with full 5-stage protocol

# ze bgp configuration
# Note: graceful-restart NOT enabled - we send EOR manually from plugin
stdin=ze-bgp:terminator=EOF_CONF
plugin {
    external test-plugin {
        run "ze-test fixture plugin/registration"
        encoder json
    }
}
bgp {
    peer peer1 {
    	connection {
    		remote {
    			ip 127.0.0.1
    		}
    		local {
    			ip 127.0.0.1
    			accept false
    		}
    	}
    	session {
    		asn {
    			local 65000
    			remote 65000
    		}
    		router-id 10.0.0.1
    		family {
    		    ipv4/unicast { prefix { maximum 10000; } }
    		}
    	}
    	behavior {
    		group-updates disable
    	}

        # No graceful-restart - prevents auto EOR
        attach process test-plugin {
            send [ update ]
        }
    }
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
