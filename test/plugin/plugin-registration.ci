# Test: Successful 5-stage plugin registration protocol
# Validates full protocol: declare, config, capability, registry, ready
# The SDK completes all five stages before the observer checks its registered
# command and sends an EOR to the established peer.

# ze-peer expectations
stdin=peer:terminator=EOF_PEER
# The plugin owns shutdown after it observes its EOR on the wire.
option=linger:value=true
# Plugin sends EOR after successful registration and initial-sync quiescence.
cmd=api:conn=1:seq=1:text=send bgp * update text nlri ipv4/unicast eor
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# native plugin script with full 5-stage protocol

# ze bgp configuration
# manual-eor, not the absence of graceful restart, suppresses the automatic EOR.
stdin=ze-bgp:terminator=EOF_CONF
plugin {
    external test-plugin {
        run "le test fixture plugin/registration"
        encoder json
    }
}
bgp {
    peer peer1 {
    	connection {
    		remote {
    			ip 127.0.0.1
    		}
    		local {
    			ip 127.0.0.1
    			accept false
    		}
    	}
    	session {
    		asn {
    			local 65000
    			remote 65000
    		}
    		router-id 10.0.0.1
    		family {
    		    ipv4/unicast { prefix { maximum 10000; } }
    		}
    	}
    	behavior {
    		group-updates disable
    		manual-eor true
    	}

        # Only the registered plugin may satisfy the expected EOR.
        attach process test-plugin {
            send [ update ]
        }
    }
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
