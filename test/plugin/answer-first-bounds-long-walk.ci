# Test: `| first N` still bounds a walk past the buffering threshold
#
# Flow:
# 1. Daemon starts with SSH and one configured BGP peer
# 2. Shell script creates SSH credentials via ze init
# 3. `system command list` is measured: it must answer past the 256-record
#    threshold, so the walk this test bounds is a streamed one
# 4. `| first 10 | raw`, `| first 10 | ndjson` and `| first 10 | count` each
#    report ten records
# 5. Those ten records are compared byte for byte with the records of the
#    unbounded walk
#
# The pipe runs over the records as they are pulled (ApplyPipesRecords,
# internal/component/command/pipe_records.go), so `first 10` bounds the WALK
# rather than the rendering of it. An operator who pipes a million-row table
# through `first 10` must pay for ten rows, and the count is where that is
# observable from the operator's seat.
#
# Step 5 is what says the answer frame carries the operator's data unchanged.
# Every record's payload states its own byte count on the wire now, and a count
# that disagreed with the bytes behind it would reach the operator as a record
# that is not the one the walk produced.
#
# `system command list` is the driver because it is the longest answer the
# daemon has, so the unbounded walk is certainly past the threshold and the
# bound is certainly doing something.
#
# VALIDATES: user story 2 -- a long walk piped to `first N` still bounds the
# read after the answer line's payload became a counted field.
# VALIDATES: AC-8 -- the payload bytes an operator receives are the bytes the
# command produced.
# PREVENTS: a pipe that filters the rendering rather than the walk, which makes
# `first 10` cost the whole table; and a counted payload whose count and bytes
# disagree, which reaches the operator as altered data.

# Test script: the bound holds over a streamed walk
tmpfs=test-answer-first-bounds.sh:mode=755:terminator=EOF_SH
#!/bin/sh
set -e

# Signal test runner readiness
touch daemon.ready

# Generate config with SSH on port 0 (OS-assigned)
cat > answer-first-bounds.conf << 'ZECONF'
bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.2
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65533
				remote 65533
			}
		}
	}
}

system {
	authentication {
		user admin {
			password "$2a$04$UlwuiuH82Unfsq.XEMPGJeDkXwbm3KW.nvVaVXOd/JeFK8VjMjrQO"
			profile [ admin ]
		}
	}
	authorization {
		profile admin {
			run {
				default-action allow
			}
			edit {
				default-action allow
			}
		}
	}
}

environment {
	ssh {
		enabled true
		server main {
			ip 127.0.0.1;
			port 0;
		}
	}
}
ZECONF

# Use a PID-derived high port for BGP to avoid needing root for port 179
export ze_test_bgp_port=$((10000 + ($$ % 50000)))

# Start daemon, capture stderr to parse SSH port
ze start answer-first-bounds.conf 2>daemon.log &
DAEMON_PID=$!
trap 'kill $DAEMON_PID 2>/dev/null; wait $DAEMON_PID 2>/dev/null' EXIT

# Wait for SSH server to report its listening address
SSH_PORT=""
for i in $(seq 1 50); do
	SSH_PORT=$(grep -o '127\.0\.0\.1:[0-9]*' daemon.log 2>/dev/null | head -1 | cut -d: -f2 || true)
	if [ -n "$SSH_PORT" ]; then
		break
	fi
	# poll interval; the loop above breaks as soon as the address is logged
	sleep 0.2
done

if [ -z "$SSH_PORT" ]; then
	echo "FAIL: SSH server did not start (no address in daemon.log)" >&2
	cat daemon.log >&2
	exit 1
fi
echo "SSH port: $SSH_PORT" >&2

# the authorizer is wired by postStartFunc, which logs nothing to wait on
sleep 0.5

ADMIN_DIR=$(mktemp -d)
trap 'rm -rf "$ADMIN_DIR"; kill $DAEMON_PID 2>/dev/null; wait $DAEMON_PID 2>/dev/null' EXIT
printf 'admin\ntestpass\n127.0.0.1\n%s\n' "$SSH_PORT" | ZE_CONFIG_DIR="$ADMIN_DIR" ze init >/dev/null

run_cli() {
	ZE_CONFIG_DIR="$ADMIN_DIR" ZE_SSH_PASSWORD="testpass" ze cli -c "$1"
}

# rows_in answers how many records a document carries under its envelope.
rows_in() {
	printf '%s' "$1" | python3 -c 'import json,sys; print(len(json.load(sys.stdin)["commands"]))'
}

WANT=10

# Precondition: the walk this test bounds is a STREAMED one. A bound over a walk
# that already fits the buffering threshold would prove nothing.
FULL=$(run_cli "system command list | raw") || {
	echo "FAIL: system command list did not answer" >&2
	exit 1
}
FULL_ROWS=$(rows_in "$FULL")
if [ "$FULL_ROWS" -le 256 ]; then
	echo "FAIL: fixture problem -- the daemon registers $FULL_ROWS commands, inside the 256-record threshold" >&2
	exit 1
fi
echo "OK: the unbounded walk answers $FULL_ROWS records" >&2

# The bound, in the three renderings an operator reaches it through.
BOUNDED=$(run_cli "system command list | first $WANT | raw") || {
	echo "FAIL: the bounded chain did not answer" >&2
	exit 1
}
BOUNDED_ROWS=$(rows_in "$BOUNDED")
if [ "$BOUNDED_ROWS" -ne "$WANT" ]; then
	echo "FAIL: | first $WANT carries $BOUNDED_ROWS records, want $WANT" >&2
	exit 1
fi

# The bound reaches the ENCODER, not just the rendering. A walk of $FULL_ROWS
# records passes the 256-record buffering threshold and streams, so `| ndjson`
# writes one line for each record. The same walk bounded to $WANT fits the
# threshold, is answered as ONE document, and `| ndjson` writes that one line.
# A `first` that filtered the rendering would leave the encoder streaming and
# this would render $WANT lines.
STREAMED_LINES=$(run_cli "system command list | ndjson" | grep -c '^{' || true)
if [ "$STREAMED_LINES" -ne "$FULL_ROWS" ]; then
	echo "FAIL: the unbounded walk rendered $STREAMED_LINES ndjson lines, want $FULL_ROWS" >&2
	exit 1
fi

BOUNDED_LINES=$(run_cli "system command list | first $WANT | ndjson" | grep -c '^{' || true)
if [ "$BOUNDED_LINES" -ne 1 ]; then
	echo "FAIL: | first $WANT | ndjson rendered $BOUNDED_LINES lines, want the one document a bounded walk is" >&2
	exit 1
fi

COUNTED=$(run_cli "system command list | first $WANT | count") || {
	echo "FAIL: the counted chain did not answer" >&2
	exit 1
}
case "$COUNTED" in
	*"$WANT"*) ;;
	*)
		echo "FAIL: | first $WANT | count reported $COUNTED, want $WANT" >&2
		exit 1
		;;
esac
echo "OK: | first $WANT bounds a walk of $FULL_ROWS records to $WANT" >&2

# Every bounded record is a record of the walk, byte for byte. A counted payload
# whose count and bytes disagreed would reach the operator here as data the walk
# never produced. The walk order follows a registry map, so this compares the
# SET rather than the position.
printf '%s' "$FULL" > full.json
printf '%s' "$BOUNDED" > bounded.json
python3 - "$WANT" <<'PYEOF' || exit 1
import json
import sys

want = int(sys.argv[1])
with open("full.json", encoding="utf-8") as handle:
	full = json.load(handle)["commands"]
with open("bounded.json", encoding="utf-8") as handle:
	bounded = json.load(handle)["commands"]

if len(bounded) != want:
	print(f"FAIL: the bounded answer carries {len(bounded)} records, want {want}", file=sys.stderr)
	sys.exit(1)

known = {json.dumps(row, sort_keys=True) for row in full}
for row in bounded:
	if json.dumps(row, sort_keys=True) not in known:
		print(f"FAIL: a bounded record is not a record of the walk: {row!r}", file=sys.stderr)
		sys.exit(1)
print(f"OK: the {want} bounded records are records of the walk, byte for byte", file=sys.stderr)
PYEOF

exit 0
EOF_SH

# Process orchestration
cmd=foreground:seq=1:exec=./test-answer-first-bounds.sh:timeout=25s
expect=exit:code=0
expect=stderr:pattern=OK: \| first [0-9]+ bounds a walk of [0-9]+ records to [0-9]+
expect=stderr:pattern=OK: the [0-9]+ bounded records are records of the walk, byte for byte
