# Test: a bridge member naming an interface entry enslaves the KERNEL DEVICE
#       that entry's selector resolves to, not the entry's logical name.
#
# VALIDATES: spec-fixit-iface-selector-ignored-by-apply, AC-3 at the naming site
#            its Phase 2 enumeration missed. The bridge member loop resolves each
#            member through the same map every other phase reads
#            (deviceFor + the Phase 2a loop, internal/component/iface/config_apply.go).
# PREVENTS:  the measured defect. The member loop ran in Phase 1, BEFORE devices
#            is computed in Phase 2, so it handed BridgeAddPort the logical entry
#            name. Two outcomes, both wrong: with no device of that name the
#            netlink call answered "Link not found" and applyConfig rolled the
#            WHOLE interface config back, and with a device coincidentally
#            carrying the name that stranger was put in the bridge -- the
#            wrong-physical-port landing this spec exists to remove, with a whole
#            broadcast domain behind it. Exit code 0 is therefore half the
#            assertion: pre-fix the daemon failed its own startup config.
#
# The aliased device is created by ze itself as a dummy in the same config,
# because a functional test has no NIC of its own to alias. Phase 1 creates it
# before Phase 2 reads the interface list the selectors resolve against, so the
# member binds on this same startup.
#
# needs-linux:caps=net-admin: creating a netdev and a bridge, and enslaving one
# to the other, need CAP_NET_ADMIN, which the verify runner does not have. Runs
# as root under `./le qemu all-tests`.
#
# KERNEL STATE THIS TEST OWNS: the devices zebmsel0 and zebmbr0, and the address
# block 198.51.100.144/28. No other file under test/ puts any of them in a
# kernel. The per-test /28 matters because the plugin suite runs 8-wide in ONE
# namespace (ZE_PLUGIN_PARALLEL, internal/le/functional/budget.go).
option=needs-linux:caps=net-admin
option=timeout:value=30s


stdin=ze-conf:terminator=EOF_CONF
plugin {
	external iface-bridge-member-selector-apply {
		run "ze-test fixture plugin/iface-bridge-member-selector-apply"
		encoder json
	}
}

interface {
	backend netlink

	# The device the alias names. ze creates it in Phase 1, before Phase 2
	# reads the interface list the member resolves against.
	dummy zebmsel0 {
	}

	# The entry an operator writes: a human-readable name aliased onto the
	# kernel device. Nothing in the kernel is named zebmwan.
	ethernet zebmwan {
		os-name zebmsel0
		unit 0 {
			ipv4 {
				address [198.51.100.145/28]
			}
		}
	}

	# The member names the ENTRY, which is the only name an operator has.
	bridge zebmbr0 {
		member [zebmwan]
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65000
			}
			router-id 10.0.0.1
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

cmd=foreground:seq=1:exec=ze -:stdin=ze-conf:timeout=30s
expect=exit:code=0
expect=stderr:contains=bridge zebmbr0 holds zebmsel0
reject=stderr:pattern=panic
reject=stderr:pattern=fatal error
