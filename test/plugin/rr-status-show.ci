# Test: show rr status and show rr peers return valid JSON
# VALIDATES: spec-cli-1-command-grammar AC-6 -- show rr status returns JSON with running state
# VALIDATES: spec-cli-1-command-grammar AC-7 -- show rr peers returns JSON array of RR peers
#
# Flow:
# 1. ze starts with BGP + RR plugin enabled
# 2. Test plugin queries "show rr status" and verifies {"running":true}
# 3. Test plugin queries "show rr peers" and verifies JSON array

option=env:var=ze.log.bgp:value=info
option=timeout:value=20s

# Native observer fixture: plugin/rr-status-show.

stdin=ze-bgp:terminator=EOF_CONF
plugin {
    external rr-status-test {
        run "ze-test fixture plugin/rr-status-show";
        encoder json;
    }
}
bgp {
    router-id 1.2.3.5;
    peer test-client {
        connection {
            remote {
                ip 127.0.0.1
            }
            local {
                ip 127.0.0.1
                accept false
            }
        }
        session {
            asn {
                local 65000;
                remote 65001;
            }
            router-id 1.2.3.5;
            family {
                ipv4/unicast { prefix { maximum 10000; } }
            }
            route-reflector-client true
        }
        attach process rr-status-test {
            receive [ state ]
        }
    }
}
EOF_CONF

stdin=peer:terminator=EOF_PEER
EOF_PEER

cmd=background:seq=1:exec=ze-peer --mode sink --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze --plugin ze.bgp-rr -:stdin=ze-bgp
expect=exit:code=0
expect=stderr:pattern=PASS: show rr status
expect=stderr:pattern=PASS: show rr peers
