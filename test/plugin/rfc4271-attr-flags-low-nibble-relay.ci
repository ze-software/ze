# rfc4271-attr-flags-low-nibble-relay -- RFC 4271 Section 4.3, the reserved flag bits of a
# relayed attribute, from a peer's socket to two other peers' sockets.
#
# RFC requirement: RFC4271-4.3-3 positive -- an UPDATE received with bits 0x0F set in the flags of ORIGIN, AS_PATH, NEXT_HOP and an unrecognized optional transitive attribute is relayed to a route-server client and to a plain eBGP peer with those four bits zero in every flags octet and the attribute values unchanged.
# RFC requirement: RFC4271-4.3-4 positive -- the same UPDATE draws no RFC 7606 action on receipt: the route is installed and relayed to both peers.
#
# RFC 4271 Section 4.3: "The lower-order four bits of the Attribute Flags octet are unused.
# They MUST be zero when sent and MUST be ignored when received." The relay rails copy the
# received attribute bytes; normalizeTransmittedUpdate (reactor/session_egress_normalize.go),
# called by writeUpdateBody, clears the bits in the session's private copy.
#
# ONE UPDATE from AS 65001: ORIGIN 0x4F, AS_PATH [65001] 0x4F, NEXT_HOP 1.1.1.1 0x4F,
# attribute 241 (unrecognized, value AABBCC) 0xCF, NLRI 10.0.0.0/24.
#   conn 2, rs-client: the received bytes with every flags octet's low nibble cleared.
#   conn 3, plain eBGP: AS_PATH [65000 65001] and the low nibble cleared.
# On both, attribute 241 also carries Partial (RFC 4271 Section 5, set by each relay rail
# as before this test) on top of the cleared octet: 0xE0.
# A writer that copies the flags verbatim fails both expectations octet for octet.

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=3
option=timeout:value=20s
option=bind:value=0.0.0.0
option=conn_map:value=remote-ip

# malformed-frame: low nibble 0x0F set in every attribute's flags on purpose; RFC 4271 4.3 says receivers MUST ignore it, which is what this test proves
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0035020000001A4F0101004F020602010000FDE94F030401010101CFF103AABBCC180A0000
expect=bgp:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
expect=bgp:conn=2:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0035020000001A4001010040020602010000FDE940030401010101E0F103AABBCC180A0000
expect=bgp:conn=3:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0039020000001E4001010040020A02020000FDE80000FDE940030401010101E0F103AABBCC180A0000
EOF_PEER

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	internal rs {
		use bgp-rs
	}
	internal adj-rib-in {
		use bgp-adj-rib-in
	}
	external shutdown-after-up {
		run "le test fixture plugin/bgp-rs-relay-aspath-transparency"
		encoder json
	}
}
bgp {
	peer source-peer {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		attach process adj-rib-in {
			receive [ update-received state ]
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
		attach process shutdown-after-up {
			receive [ update ]
		}
	}
	peer rs-client-receiver {
		connection {
			remote {
				ip 127.0.0.2
			}
			local {
				ip 127.0.0.2
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65002
			}
			router-id 1.2.3.4
			rs-client true
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		attach process adj-rib-in {
			send [ update ]
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
		attach process shutdown-after-up {
			receive [ update ]
		}
	}
	peer plain-ebgp-receiver {
		connection {
			remote {
				ip 127.0.0.3
			}
			local {
				ip 127.0.0.3
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65003
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		attach process adj-rib-in {
			send [ update ]
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
		attach process shutdown-after-up {
			receive [ update ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
reject=stderr:pattern=panic
reject=stderr:pattern=fatal error
reject=stderr:pattern=forward-cached failed
reject=stderr:pattern=release-cached failed
