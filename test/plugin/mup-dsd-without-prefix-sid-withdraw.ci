# mup-dsd-without-prefix-sid-withdraw -- draft-ietf-bess-mup-safi Section 3.3.6,
# end to end through the route server.
#
# A peer announces a Direct Segment Discovery route D with a Prefix-SID attribute,
# then sends an UPDATE carrying D again, beside an ISD route L, with no Prefix-SID.
# Section 3.3.6: "When a BGP speaker receives a MP_REACH_NLRI attribute update
# message with a Direct Segment Discovery route without a prefix SID attribute,
# than it MUST be treated as if it contained a malformed prefix SID attribute and
# the "Treat-as-withdraw procedure of [RFC7606] is applied.  A BGP speaker MUST
# skip such NLRIs and continue processing of rest of the Update message." The
# receiving peer, which already holds D, sees D withdrawn and L announced, and no
# session is reset.

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=2
option=timeout:value=20s
option=bind:value=0.0.0.0
option=linger:value=true
# Bind conn=N by remote IP: which client connects first is a race (peer_connmap.go).
option=conn_map:value=remote-ip

# Source peer (conn=1, AS 65001). Every UPDATE carries ORIGIN IGP, AS_PATH [65001]
# (4-byte ASNs) and an MP_REACH_NLRI for AFI 1 / SAFI 85 with next hop 1.1.1.1.
# draft-ietf-bess-mup-safi Section 3.1 frames each NLRI as
# [architecture-type:1][route-type:2][length:1][value], RD 65001:1.
#   D:  0100020C0000FDE900000001C0000201
#       DSD (Section 3.1.2), address 192.0.2.1
#   L:  0100010C0000FDE900000001180A0002
#       ISD (Section 3.1.1), 10.0.2.0/24
# The Prefix-SID (type 40) holds an SRv6 L3 Service TLV (RFC 9252 Section 2) with
# one SRv6 SID Information Sub-TLV: SID 2001:db8::1, behavior End.DT4.
#   C0281C050019000100150020010DB800000000000000000000000100001300
# seq=1 announces D with the Prefix-SID.
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF005F02000000484001010040020602010000FDE9800E190001550401010101000100020C0000FDE900000001C0000201C0281C050019000100150020010DB800000000000000000000000100001300

# seq=2 carries D then L in one MP_REACH_NLRI, with no Prefix-SID.
action=send:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF005002000000394001010040020602010000FDE9800E290001550401010101000100020C0000FDE900000001C00002010100010C0000FDE900000001180A0002

# An ordinary IPv4 route fences the MUP UPDATEs on the same source connection.
action=send:conn=1:seq=3:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002F02000000144001010040020602010000FDE940030401010101180A0000

# Receiver (conn=2, AS 65002, rs-client): D first.
expect=bgp:conn=2:seq=1:contains=0100020C0000FDE900000001C0000201
# Then D withdrawn: an MP_UNREACH_NLRI for AFI 1 / SAFI 85 whose first route is D.
# AFI and SAFI directly followed by an NLRI occur only in MP_UNREACH_NLRI, because
# MP_REACH_NLRI carries the next hop between them.
expect=bgp:conn=2:seq=2:contains=0001550100020C0000FDE900000001C0000201
# And L announced.
expect=bgp:conn=2:seq=2:contains=0100010C0000FDE900000001180A0002
expect=bgp:conn=2:seq=3:announced=180A0000

# D is never re-announced beside L: the UPDATE without a Prefix-SID is not relayed whole.
reject=bgp:conn=2:pattern=0100020C0000FDE900000001C00002010100010C0000FDE900000001180A0002

EOF_PEER

# Observer: wait until the route server has replayed the fence prefix to every client, then
# shut down. The T1ST test's fixture is reused: it waits for the same fence, 10.0.0.0/24.

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	internal rs {
		use bgp-rs
	}
	internal adj-rib-in {
		use bgp-adj-rib-in
	}
	external shutdown-after-up {
		run "le test fixture plugin/mup-t1st-malformed-treat-as-withdraw"
		encoder json
	}
}
bgp {
	# RFC 8212: an EBGP direction with no policy is refused; this test exchanges routes.
	filter {
		import { final accept; }
		export { final accept; }
	}
	peer source-peer {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			# RFC 8669 Section 4: accept the Prefix-SID from this eBGP peer, so the
			# first DSD route keeps it and only the second arrives without one.
			accept-srv6-prefix-sid true
			family {
				ipv4/unicast { prefix { maximum 10000; } }
				ipv4/mup { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		attach process adj-rib-in {
			receive [ update-received state ]
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
		attach process shutdown-after-up {
			receive [ update ]
		}
	}
	peer receiver-peer {
		connection {
			remote {
				ip 127.0.0.2
			}
			local {
				ip 127.0.0.2
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65002
			}
			router-id 1.2.3.4
			rs-client true
			family {
				ipv4/unicast { prefix { maximum 10000; } }
				ipv4/mup { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		attach process adj-rib-in {
			send [ update ]
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
		attach process shutdown-after-up {
			receive [ update ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
reject=stderr:pattern=panic
reject=stderr:pattern=fatal error
