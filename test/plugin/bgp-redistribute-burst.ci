tmpfs=burst-test.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
import time
from ze_api import API, runtime_fail


def dispatch(api, command):
    return api._call_engine('ze-plugin-engine:dispatch-command', {'command': command}) or {}


def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()

    # Wait on the peer's own state, then on its initial-sync EOR reaching the
    # wire, instead of holding a fixed 2s and hoping establishment fitted in it.
    if not api.wait_peer_eor_sent():
        runtime_fail('initial-sync EOR never reached the wire')
        return

    resp = dispatch(api, 'request fakeredist emit-burst 500 add ipv4/unicast 10.0.0.0/32')
    result = resp.get('result', {})
    if result.get('status') != 'done':
        runtime_fail(f'emit-burst failed: {result}')
        return

    # There IS a queryable signal: `request quiesce` returns once the BGP
    # forward pool and every peer's initial-sync opQueue have settled, which is
    # exactly "the emitted route finished dispatching".
    if not api.quiesce():
        runtime_fail('quiesce barrier did not complete')
        return
    dispatch(api, 'request shutdown')
    api.wait_for_shutdown()


if __name__ == '__main__':
    main()
EOF_RUN

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external burst-test {
		run ./burst-test.run
		encoder json
	}
	internal redistribute-orchestrator {
		use redistribute-orchestrator
	}
	internal fakeredist {
		use fakeredist
	}
}

redistribute {
	destination bgp {
		import fakeredist {
			family [ ipv4/unicast ];
		}
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			# Ze's own address on this session, and what `nhop self` puts on the
			# wire. Deliberately NOT the peer's 127.0.0.1: RFC 4271 Section 5.1.3
			# forbids advertising a peer an address of that peer as NEXT_HOP.
			local {
				ip 127.0.0.4
				accept false
			}
		}
		session {
			asn {
				local 65533
				remote 65533
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		attach process redistribute-orchestrator {
			send [ update ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=60s
# // test-relax: expect=exit:code=0 removed -- this STRENGTHENS the test. Coverage
# is replaced by the 500 ze-peer wire expectations above, which now govern the
# verdict. The exit-code line asserted nothing about BGP and, until 2026-07-16,
# actively disabled the peer check (spec-fixit-redistribute-establishment-stall, D2).
