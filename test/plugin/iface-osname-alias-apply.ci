# Test: an interface entry aliased with os-name gets its address, its MTU and
#       its admin state on the KERNEL device the alias names.
#
# VALIDATES: spec-fixit-iface-selector-ignored-by-apply, AC-3. The config apply
#            path resolves each ethernet entry through its selector and keys
#            every backend call by the resolved device (bindDevices + deviceFor,
#            internal/component/iface/config_apply.go).
# PREVENTS:  the measured defect. desiredState keyed addresses by unitOSName,
#            which returned the LOGICAL entry name, so an aliased entry made the
#            daemon call AddAddress on a name the kernel does not carry. The
#            backend answered "not found", applyConfig rolled the whole apply
#            back, and the commit failed -- an aliased interface carrying an
#            address could not be committed at all. That is why this test asserts
#            exit code 0 as well as the address: pre-fix the daemon never got
#            past its own startup config.
#
# The aliased device is created by ze itself as a dummy in the same config,
# because a functional test has no NIC of its own to alias. That stands in for
# the operator case (a physical port named enp1s0 aliased to `wan`): what the
# apply path resolves is the same map either way, and Phase 1 creates the dummy
# before Phase 2 reads the interface list.
#
# needs-linux:caps=net-admin: creating a netdev and assigning an address needs
# CAP_NET_ADMIN, which the verify runner does not have. Runs as root under
# `make ze-qemu-needs-linux-test`.
#
# KERNEL STATE THIS TEST OWNS: the device zeosnsel0 and the address block
# 198.51.100.112/28. No other file under test/ puts either in a kernel. The
# per-test /28 matters because the plugin suite runs 8-wide in ONE namespace
# (ZE_PLUGIN_PARALLEL, mk/test-functional.mk).
option=needs-linux:caps=net-admin
option=timeout:value=30s

tmpfs=iface-osname-alias-apply.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
"""Assert the aliased entry's settings landed on the kernel device, not on its
logical name.

The read goes straight to the kernel through `ip -j addr show`, not through a ze
command, so nothing in the assertion shares a resolver with the code under test.
"""

import json
import subprocess
import sys

from ze_api import API
from ze_api import runtime_fail

DEVICE = "zeosnsel0"     # the kernel device the alias names
LOGICAL = "zeosnwan"     # the entry name; no kernel device carries it
CIDR = "198.51.100.113/28"
MTU = 1400


def ip_json(*args):
    result = subprocess.run(["ip", "-j", *args], capture_output=True, text=True, check=False)
    if result.returncode != 0:
        return None
    return json.loads(result.stdout or "[]")


def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()
    api.wait_for_post_startup(timeout=5.0)

    try:
        links = ip_json("link", "show", DEVICE)
        if not links:
            runtime_fail(f'{DEVICE} was not created: the apply never reached the aliased device')
        link = links[0]
        if link.get("mtu") != MTU:
            runtime_fail(f'{DEVICE} mtu={link.get("mtu")!r}, want {MTU}: the entry MTU did not follow the alias')
        if "UP" not in (link.get("flags") or []):
            runtime_fail(f'{DEVICE} flags={link.get("flags")!r}: the admin-up did not follow the alias')

        addrs = ip_json("addr", "show", DEVICE) or []
        found = [
            f'{a["local"]}/{a["prefixlen"]}'
            for entry in addrs for a in (entry.get("addr_info") or [])
        ]
        if CIDR not in found:
            runtime_fail(f'{DEVICE} carries {found!r}, not {CIDR}: the address did not follow the alias')

        if ip_json("link", "show", LOGICAL):
            runtime_fail(f'a device named {LOGICAL} exists: the apply worked on the logical name')

        print(f'OK: os-name alias applied {CIDR}, mtu {MTU} and admin-up to {DEVICE}', file=sys.stderr)
    finally:
        api._call_engine('ze-plugin-engine:dispatch-command', {'command': 'request shutdown'})
        api.wait_for_shutdown()


if __name__ == '__main__':
    main()
EOF_RUN

stdin=ze-conf:terminator=EOF_CONF
plugin {
	external iface-osname-alias-apply {
		run ./iface-osname-alias-apply.run
		encoder json
	}
}

interface {
	backend netlink

	# The device the alias names. ze creates it in Phase 1, before Phase 2
	# reads the interface list the selectors resolve against.
	dummy zeosnsel0 {
	}

	# The entry an operator writes: a human-readable name aliased onto the
	# kernel device. Nothing in the kernel is named zeosnwan.
	ethernet zeosnwan {
		os-name zeosnsel0
		mtu 1400
		unit 0 {
			ipv4 {
				address [198.51.100.113/28]
			}
		}
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65000
			}
			router-id 10.0.0.1
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

cmd=foreground:seq=1:exec=ze -:stdin=ze-conf:timeout=30s
expect=exit:code=0
expect=stderr:contains=os-name alias applied
reject=stderr:pattern=panic
reject=stderr:pattern=fatal error
