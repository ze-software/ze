# QUESTION: Does an establishing rs-client peer receive accepted routes via peer-up replay while never receiving a loop-denied route retained in Adj-RIB-In?
# A unit test cannot decide live TCP forwarding, stored filtered retention, reconnect replay, and exact wire bytes on the second session.

stdin=source:terminator=EOF_SOURCE
option=tcp_connections:value=1
option=timeout:value=30s
option=asn:value=65001
option=linger:value=true
option=await-file:path=destination.up
# 1. Loop-denied UPDATE (AS_PATH [65001, 65000]): 10.0.1.0/24 (seq 1 in Adj-RIB-In).
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF003302000000184001010040020A02020000FDE90000FDE840030401010101180A0001
# 2. Accepted control UPDATE (AS_PATH [65001]): 10.0.0.0/24 (seq 2 in Adj-RIB-In).
action=send:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002F02000000144001010040020602010000FDE940030401010101180A0000
EOF_SOURCE

stdin=destination:terminator=EOF_DESTINATION
option=tcp_connections:value=2
option=timeout:value=30s
option=asn:value=65002
option=bind:value=127.0.0.2
option=linger:value=true
option=established-file:path=destination.up
# conn=1: receives ONLY the accepted route (rs-client true => no AS 65000 prepended).
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002F02000000144001010040020602010000FDE940030401010101180A0000
action=close:conn=1:seq=2
# conn=2: peer-up replay walks seq 1 (filtered 10.0.1.0/24) then seq 2 (accepted 10.0.0.0/24).
# Any replayed filtered route arrives ahead of 10.0.0.0/24 and fails this expectation immediately.
expect=bgp:conn=2:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002F02000000144001010040020602010000FDE940030401010101180A0000
EOF_DESTINATION

stdin=ze-bgp:terminator=EOF_CONF
bus {
	endpoint replay-filtered-check {
		external {
			run "le test fixture plugin/adj-rib-in-filtered-not-replayed";
		}
		encoding json;
	}
	endpoint rs {
		internal bgp-rs;
	}
	endpoint adj-rib-in {
		internal bgp-adj-rib-in;
		send {
			message bgp:update {
				to none;
			}
		}
	}
}
bgp {
	filter {
		import { final accept; }
		export { final accept; }
	}
	peer source {
		connection {
			remote { ip 127.0.0.1; }
			local { ip 127.0.0.1; accept false; }
		}
		session {
			asn { local 65000; remote 65001; }
			router-id 1.2.3.4
			rs-client true
			family { ipv4/unicast { prefix { maximum 10000; } } }
			capability { graceful-restart disable; }
		}
		behavior { group-updates disable; }
	}
	peer destination {
		connection {
			remote { ip 127.0.0.2; }
			local { ip 127.0.0.2; accept false; }
		}
		session {
			asn { local 65000; remote 65002; }
			router-id 1.2.3.4
			rs-client true
			family { ipv4/unicast { prefix { maximum 10000; } } }
			capability { graceful-restart disable; }
		}
		behavior { group-updates disable; }
		timer { connect-retry 5; }
	}
}
EOF_CONF

cmd=background:seq=1:exec=le test peer --port $PORT:stdin=source
cmd=background:seq=2:exec=le test peer --bind 127.0.0.2 --port $PORT:stdin=destination
cmd=foreground:seq=3:exec=ze -:stdin=ze-bgp:timeout=60s
await=stderr:contains=OK: adj-rib-in stored filtered route before replay:then=stop
expect=exit:code=0
reject=stderr:pattern=panic
reject=stderr:pattern=fatal error
reject=stderr:pattern=send refused
