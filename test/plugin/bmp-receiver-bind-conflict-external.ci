# QUESTION: does an actual forked BMP process report startup bind refusal,
# release its sibling socket and leave the daemon available with that failed
# process absent from the process manager? Unit callbacks cannot prove the
# CLI launcher, TLS callback response, process removal and failure policy.
# Explicit external plugins default to ignore on failure. Daemon exit 1 is
# deliberately NOT the expected outcome for this mode.

option=timeout:value=60s
option=env:var=ZE_CONFIG_DIR:value=.
option=env:var=XDG_DATA_HOME:value=.
option=env:var=ze.ssh.password:value=testpass

stdin=init-answers:terminator=EOF_INIT
admin
testpass
127.0.0.1
$PORT
EOF_INIT

tmpfs=bmp-bind-external.conf:terminator=EOF_CONF
system {
    authentication {
        user admin {
            password "$2a$04$UlwuiuH82Unfsq.XEMPGJeDkXwbm3KW.nvVaVXOd/JeFK8VjMjrQO"
        }
    }
}
environment {
    ssh {
        enabled true
        server main { ip 127.0.0.1; port $PORT; }
    }
    bmp {
        enabled true
        max-sessions 1
        server available { ip 127.0.0.1; port $PORT2; }
        server blocked { ip 127.0.0.1; port $PORT3; }
    }
}
bus {
    endpoint bgp-bmp {
        internal bgp-bmp;
        process separate;
        encoding json;
    }
    hub {
        server local {
            ip 127.0.0.1;
            port 0;
            secret bmp-bind-external-test-0123456789;
        }
    }
}
EOF_CONF

cmd=foreground:seq=1:exec=ze init:stdin=init-answers:exit=0
cmd=background:seq=2:name=holder:exec=le test fixture plugin/bmp-bind-holder $PORT3:ready=BMP-BIND-HELD
cmd=background:seq=3:name=daemon:exec=ze start bmp-bind-external.conf:ready=Ze running.
expect=stderr:contains=BMP receiver server \"blocked\" cannot listen on
expect=stderr:contains=delete environment bmp server blocked
reject=stderr:pattern=panic

cmd=foreground:seq=4:exec=ze cli -c "show system subsystem list | json":exit=0
expect=stdout:pattern="subsystems".*\[
expect=stdout:pattern="count".*[0-9]
reject=stdout:pattern="name".*"bgp-bmp"
expect=exit:code=0

cmd=foreground:seq=5:exec=le test fixture plugin/bmp-bind-free $PORT2:exit=0
expect=stdout:contains=BMP bind release verified at

cmd=stop:seq=6:name=daemon:signal=term
cmd=stop:seq=7:name=holder:signal=term
