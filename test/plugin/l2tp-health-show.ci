# Test: show l2tp health dispatches to the l2tp health handler
# Exercises: dispatch-command -> ze-show:l2tp-health -> handleShowL2TPHealth
# Verifies the R9 rename `show l2tp health` (was `show l2tp-health`) resolves to
# its handler end-to-end. With the l2tp service up but no login sessions and CQM
# off, the handler returns its own "observer not enabled (CQM disabled)" error;
# with CQM + sessions it returns {logins, count, degraded} status=done. Either
# proves the renamed command reaches its handler -- a broken rename would 404.
# Native (l2tp control-plane, kernel probe skipped).

option=env:var=ze.l2tp.skip-kernel-probe:value=true
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER


stdin=ze-conf:terminator=EOF_CONF
plugin {
	external l2tp-health-show-test {
		run "ze-test fixture plugin/l2tp-health-show"
		encoder json
	}
}

environment {
	l2tp {
		server main {
			ip 127.0.0.1
			port $PORT2
		}
	}
}

l2tp {
	enabled true
	shared-secret l2tp-health-secret
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-conf:timeout=15s
expect=exit:code=0
