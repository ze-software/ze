# mup-isd-originator-mismatch-withdraw -- draft-ietf-bess-mup-safi Section 3.3.3
# (rows 13 & 15: DRAFT-IETF-BESS-MUP-SAFI-3.3.3-1 and 3.3.3-4), end to end through
# the route server with a known SRv6 locator-originator snapshot published over TLS RPC.
#
# RFC requirement: DRAFT-IETF-BESS-MUP-SAFI-3.3.3-4 positive -- an ISD route whose NLRI Address does not belong to the proven Prefix-SID locator originator is treated as withdrawn (MP_UNREACH_NLRI sent to peers and removed from Adj-RIB-In) while its sibling T2ST route is kept and relayed, and an ISD route whose NLRI Address matches the originator is kept even when MP_REACH_NLRI next hop differs.
#
# The external locator-publisher publishes 2001:db8::/48 -> originator 0100.0000.0001
# (Addresses: [2001:db8:140::1], Prefixes: [2001:db8:140::1/128, 2001:db8:236:10::/64]).
#
# 1. seq=1 announces IPv6 ISD I6_OK (2001:db8:140::1/128, matching Address) with a
#    DIFFERENT MP_REACH_NLRI next hop 2001:db8:999::9 and Prefix-SID 2001:db8::1 ->
#    KEPT and relayed to receiver-peer (Section 3.3.3 ignores MP_REACH_NLRI next hop).
# 2. seq=2 announces IPv6 ISD I6_BAD (2001:db8:999::9/128) with an uncovered SID
#    2001:db8:beef::1 (unresolved locator) -> kept unverified and relayed to receiver-peer
#    so Adj-RIB-In holds I6_BAD prior to the mismatch update.
# 3. seq=3 announces IPv6 ISD I6_BAD (2001:db8:999::9/128, MISMATCHING Address) +
#    IPv6 T2ST T6_1 with matching MP_REACH_NLRI next hop 2001:db8:140::1 and covered
#    Prefix-SID 2001:db8::1 -> I6_BAD is treated as withdrawn (MP_UNREACH_NLRI sent to
#    receiver-peer, removed from Adj-RIB-In, doctor-bgp-mup-locator-mismatch raised)
#    while T6_1 is kept and relayed and I6_OK remains in Adj-RIB-In.

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=2
option=timeout:value=25s
option=bind:value=0.0.0.0
option=linger:value=true
option=conn_map:value=remote-ip
option=await-file:path=peers-isd.ready

#   I6_OK:  010001190000FDE9000000018020010DB8014000000000000000000001 (ISD 2001:db8:140::1/128)
#   I6_BAD: 010001190000FDE9000000018020010DB8099900000000000000000009 (ISD 2001:db8:999::9/128)
#   T6_1:   0100041D0000FDE900000001A020010DB801400000000000000000000100000001 (T2ST TEID 1)
# seq=1: matching Address ISD I6_OK with differing next hop 2001:db8:999::9 and SID 2001:db8::1.
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF007802000000614001010040020602010000FDE9800E320002551020010DB809990000000000000000000900010001190000FDE9000000018020010DB8014000000000000000000001C0281C050019000100150020010DB800000000000000000000000100001300
# seq=2: I6_BAD with uncovered SID 2001:db8:beef::1 (kept unverified so Adj-RIB-In holds it).
action=send:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF007802000000614001010040020602010000FDE9800E320002551020010DB801400000000000000000000100010001190000FDE9000000018020010DB8099900000000000000000009C0281C050019000100150020010DB8BEEF0000000000000000000100001300
# seq=3: mismatching Address ISD I6_BAD + T6_1 with matching next hop 2001:db8:140::1 and SID 2001:db8::1.
action=send:conn=1:seq=3:
# seq=4: IPv4 unicast fence 10.0.0.0/24.
action=send:conn=1:seq=4:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002F02000000144001010040020602010000FDE940030401010101180A0000

# Receiver (conn=2): I6_OK announced first (despite differing next hop), then I6_BAD announced
# unverified, then I6_BAD withdrawn via MP_UNREACH_NLRI while T6_1 is announced, then fence.
expect=bgp:conn=2:seq=1:contains=010001190000FDE9000000018020010DB8014000000000000000000001
expect=bgp:conn=2:seq=2:contains=010001190000FDE9000000018020010DB8099900000000000000000009
expect=bgp:conn=2:seq=3:contains=000255010001190000FDE9000000018020010DB8099900000000000000000009
expect=bgp:conn=2:seq=3:contains=0100041D0000FDE900000001A020010DB801400000000000000000000100000001
expect=bgp:conn=2:seq=4:announced=180A0000

# Mismatched ISD I6_BAD is never re-announced beside its T2ST sibling T6_1.
reject=bgp:conn=2:pattern=010001190000FDE9000000018020010DB80999000000000000000000090100041D0000FDE900000001A020010DB801400000000000000000000100000001

EOF_PEER

stdin=ze-bgp:terminator=EOF_CONF
bus {
	endpoint bgp-rib {
		internal bgp-rib;
		receive { allow none; }
		send { allow none; }
	}
	endpoint rs {
		internal bgp-rs;
	}
	endpoint adj-rib-in {
		internal bgp-adj-rib-in;
		send {
			message bgp:update { to none; }
		}
	}
	endpoint locator-publisher {
		external {
			run "le test fixture plugin/mup-locator-origin-publisher locator-isd.ready";
		}
		encoding json;
	}
	endpoint mup-sd-observer {
		external {
			run "le test fixture plugin/mup-segment-discovery-observer --wait-file=locator-isd.ready --ready-file=peers-isd.ready --keep=010001190000fde9000000018020010db8014000000000000000000001 --keep=0100041d0000fde900000001a020010db801400000000000000000000100000001 --absent=010001190000fde9000000018020010db8099900000000000000000009 --expect-error=doctor-bgp-mup-locator-mismatch";
		}
		encoding json;
	}
}
bgp {
	filter {
		import { final accept; }
		export { final accept; }
	}
	peer source-peer {
		connection {
			remote { ip 127.0.0.1 }
			local { ip 127.0.0.1; accept false }
		}
		session {
			rs-client true;
			asn { local 65000; remote 65001 }
			router-id 1.2.3.4
			accept-srv6-prefix-sid true
			family {
				ipv4/unicast { prefix { maximum 10000; } }
				ipv6/mup { prefix { maximum 10000; } }
			}
			capability { graceful-restart disable }
		}
		behavior { group-updates disable }
	}
	peer receiver-peer {
		connection {
			remote { ip 127.0.0.2 }
			local { ip 127.0.0.2; accept false }
		}
		session {
			rs-client true;
			asn { local 65000; remote 65002 }
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
				ipv6/mup { prefix { maximum 10000; } }
			}
			capability { graceful-restart disable }
		}
		behavior { group-updates disable }
	}
}
EOF_CONF

cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=25s
expect=exit:code=0
expect=stderr:contains=doctor-bgp-mup-locator-mismatch
reject=stderr:pattern=panic
reject=stderr:pattern=fatal error
