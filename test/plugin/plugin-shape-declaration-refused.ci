# Test: a plugin declares an answer shape no shape spells, the plugin does not
# start, and the daemon keeps running.
#
# VALIDATES: spec-plugin-declares-answer-shape AC-2. A shape spelling that is
#            not doc, map or tab fails Stage 1, the daemon log names the plugin,
#            the command and the value, and the plugin's command answers
#            nothing.
# PREVENTS:  two failures. A typo read as `doc` publishes the operators of a
#            document and refuses the row operators the command supports, in
#            silence. And a declaration reaching the shape registry through the
#            in-tree route panics on a conflict, which would let one plugin
#            string take the daemon down.
#
# Method: the plugin declares one command of its own, `show shape typo`, and
# spells its shape `table`. Nothing else about the plugin is wrong, so the
# refusal is the shape and nothing else. The operator then reads the daemon log,
# and reads that the daemon still answers.
#
# The daemon log is the surface this reads because a refused plugin is torn down
# as soon as the tier handshake ends, so it cannot report its own refusal. The
# operator's surface is the log line, and it names the plugin.
#
# The timeout is DECLARED because this file starts a daemon, waits for a plugin
# to be refused and torn down, and launches `ze` twice.
option=timeout:value=60s

# The plugin under test: one command, one shape spelling no shape writes.
tmpfs=shape-typo.run:mode=755:terminator=EOF_PLUGIN
#!/usr/bin/env python3
"""Declare an answer shape that is not doc, map or tab."""

from ze_api import API


def main():
    api = API()
    api.declare_command(
        'show shape typo',
        shape='table',
        columns=['address', 'state'],
    )
    try:
        api.declare_done()
    except RuntimeError:
        # Stage 1 was refused, which is what this test asks for. The engine tears
        # this process down; the assertions read the daemon log.
        return
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()
    api.wait_for_shutdown(timeout=45.0)


if __name__ == '__main__':
    main()
EOF_PLUGIN

tmpfs=run.py:terminator=EOF_PY
"""Start ze with the refused plugin attached, then read what the daemon says."""

import os
import subprocess

from ze_api import wait_until


def require(condition, message):
    if not condition:
        raise SystemExit(message)


def run(argv, env):
    result = subprocess.run(
        argv, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, env=env, check=False
    )
    return result.returncode, result.stdout, result.stderr


password_hash = subprocess.check_output(['ze', 'passwd'], input='secret\n', text=True).strip()
with open('shape.conf', 'w', encoding='utf-8') as fh:
    fh.write('''bgp {
    router-id 10.255.255.254
    session {
        asn {
            local 65000
        }
    }
    group transit {
        peer peer1 {
            connection {
                remote {
                    ip 192.0.2.1
                }
                local {
                    ip 127.0.0.1
                }
            }
            session {
                asn {
                    remote 65001
                }
            }
        }
    }
}

plugin {
    external shape-typo {
        run ./shape-typo.run
        encoder json
    }
}

system {
    authentication {
        user ci {
            password "''' + password_hash + '''"
            profile [ admin ]
        }
    }
}
''')

daemon_env = os.environ.copy()
daemon_env['ZE_SSH_EPHEMERAL'] = os.path.abspath('ssh.addr')
daemon_env['ZE_READY_FILE'] = os.path.abspath('ready')
daemon_env['ZE_CONFIG_DIR'] = os.getcwd()
# Leave port 179 alone: this suite runs unprivileged and a bind failure there
# takes the daemon down before it writes `ready`.
daemon_env['ze_test_bgp_port'] = str(12000 + os.getpid() % 40000)
daemon = subprocess.Popen(
    ['ze', '-f', 'shape.conf'],
    stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, env=daemon_env,
)


def daemon_ready():
    if daemon.poll() is not None:
        out, err = daemon.communicate()
        raise SystemExit('daemon exited early\nstdout:\n' + out + '\nstderr:\n' + err)
    return os.path.exists('ssh.addr') and os.path.exists('ready')


try:
    # The plugin phase runs before the daemon signals readiness, so the refusal
    # has already been decided and logged by the time this returns. Reaching
    # this point at all is half the test: a declaration registry panics on a
    # conflicting declaration, and a plugin message MUST NOT be able to reach
    # that panic.
    if not wait_until(daemon_ready, attempts=300, delay=0.1):
        raise SystemExit('daemon did not become ready')

    host, port = open('ssh.addr', encoding='utf-8').read().strip().rsplit(':', 1)
    cli_env = os.environ.copy()
    cli_env.update({
        'ZE_SSH_HOST': host,
        'ZE_SSH_PORT': port,
        'ZE_SSH_USERNAME': 'ci',
        'ZE_SSH_PASSWORD': 'secret',
        'ZE_CONFIG_DIR': os.getcwd(),
    })

    # The daemon serves its own commands, which is what a refused plugin costs
    # nobody else.
    code, out, err = run(['ze', 'cli', '-c', 'show bgp | json'], cli_env)
    require(code == 0, 'the daemon stopped answering after the refusal: %s%s' % (out, err))
    require('10.255.255.254' in out, 'the daemon answers, but not with its own state: %r' % out)

    # The refused plugin's command reaches nobody.
    code, out, err = run(['ze', 'cli', '-c', 'show shape typo'], cli_env)
    require(code != 0, 'the refused plugin still serves its command: %s%s' % (out, err))
finally:
    daemon.terminate()
    try:
        daemon_out, daemon_err = daemon.communicate(timeout=5)
    except subprocess.TimeoutExpired:
        daemon.kill()
        daemon_out, daemon_err = daemon.communicate(timeout=5)

# The operator reads the refusal in the daemon log. It names the plugin that
# asked, the command it declared, the value it sent, and what the values are.
tail = daemon_err[-4000:]
for word in ('answer shape', 'shape-typo', 'show shape typo', 'table', 'doc, map or tab'):
    require(word in daemon_err, 'the daemon log does not name %s: %r' % (word, tail))

print('OK')
EOF_PY

cmd=foreground:seq=1:exec=python3 run.py
expect=exit:code=0
expect=stdout:contains=OK
