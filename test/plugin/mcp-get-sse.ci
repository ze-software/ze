# mcp-get-sse - GET /mcp SSE stream delivers a server-initiated frame.
# Exercises handleGET draining the session outbound queue (streamable.go) after
# a task worker completes: runTaskWorker -> sess.Send(buildTaskStatusNotification)
# -> notifications/tasks/status frame on the GET stream. The ze-test mcp client
# opens the GET stream (sse-listen) concurrently with the task-triggering POST,
# then asserts the notification arrives (sse-expect).

stdin=mcp:terminator=EOF_MCP
wait-tool ze_execute
sse-listen
task-call ze_execute {"command":"show version"}
sse-expect notifications/tasks/status
EOF_MCP

# Minimal ze config so the daemon serves MCP.
stdin=ze-bgp:terminator=EOF_CONF
bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze --mcp $PORT -:stdin=ze-bgp
cmd=foreground:seq=2:exec=ze-test mcp --port $PORT --tasks:stdin=mcp:timeout=15s
expect=exit:code=0
expect=stdout:contains=notifications/tasks/status
