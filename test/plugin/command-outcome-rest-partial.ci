# Question: does REST retain every completed and refused row, with a partial
# status, for short and streamed answers from a real external SDK provider?
# A unit cannot prove the daemon's HTTP listener and external process wiring.
# A healthy answer at each size is the successful control.

stdin=ze-conf:terminator=EOF_CONF
bus {
    endpoint answer-outcome-provider {
        external {
            run "le test fixture plugin/command-outcome-provider";
        }
        encoding json;
    }
    endpoint answer-outcome-observer {
        external {
            run "le test fixture plugin/command-outcome-rest $PORT partial";
        }
        encoding json;
    }
}
environment {
    api-server {
        token "command-outcome-token";
        rest {
            enabled true;
            server main { ip 127.0.0.1; port $PORT; }
        }
    }
}
EOF_CONF

cmd=foreground:seq=1:exec=ze -:stdin=ze-conf:timeout=40s
expect=exit:code=0
expect=stderr:contains=OK: REST partial outcome and healthy control preserved rows across the record threshold
reject=stderr:contains=ZE-OBSERVER-FAIL
reject=stderr:contains=panic recovered
