# Test: the `send` half of an attach block is a PERMISSION, and ze enforces it
#       at the point a process originates a message toward a peer.
# Exercises: peer config -> PeerSettings.ProcessBindings ->
#            reactorAPIAdapter.getMatchingPeersSel (internal/component/bgp/reactor/
#            reactor_api.go) -> Peer.maySend (send_permission.go), the one resolver
#            every send command shares.
# VALIDATES: AC-9 (a `peer *` announce reaches the peer that attached the program
#            with send [ update ] and NOT the peer that never attached it, and the
#            refusal is REPORTED), AC-10 (an announce aimed at the unattached peer
#            is refused, and the refusal names the peer and the process), AC-11
#            (the attached peer's block carries a send list and NO receive line:
#            the program MAY announce to it and is fed nothing by it).
# PREVENTS: route injection through an unenforced permission. Before this, a
#           process issuing `peer * update ...` reached every peer in the config,
#           including peers whose operator never linked it to them.
#
# How "peer 127.0.0.2 received nothing" is proven, since the peer harness has no
# absence-on-wire primitive: by ze's OWN per-peer record, `updates-sent` from
# `show bgp peer <addr> detail`, baselined AFTER both End-of-RIB markers are on
# the wire and re-read after the announce has quiesced. It is the counter
# reactor_notify.go increments once per UPDATE that reached a peer's socket, so an
# unchanged value is ze stating it wrote nothing to that peer. The refusal WARN
# and the refused explicit announce are two further independent signals.
#
# Why this cannot pass by luck: the injector is granted send on 127.0.0.1 only,
# and every assertion below is about the DIFFERENCE between the two peers under
# one command. With the permission filter removed, 127.0.0.2's updates-sent moves,
# the explicit announce to it succeeds, and no refusal is logged -- three
# independent failures.

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=2
option=timeout:value=30s
option=bind:value=0.0.0.0
# Map conn=N to a peer by remote IP rather than by accept order: both sessions
# are handshaked concurrently (127.0.0.1 -> conn=1 permitted, 127.0.0.2 -> conn=2
# unattached).
option=conn_map:value=remote-ip

# conn=1 is the peer that attaches the injector with send [ update ]. Its
# End-of-RIB comes first (the script holds that barrier before announcing), then
# the announce carrying 203.0.113.0/24 -- prefix length 0x18, then CB 00 71.
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
expect=bgp:conn=1:seq=2:contains=18CB0071

# conn=2 is the peer that attaches nothing. Its only message is its own
# End-of-RIB: ze originates that marker itself, and the injector may originate
# nothing at all toward this peer.
expect=bgp:conn=2:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER


expect=stderr:pattern=SEND-PERMISSION: announce reached the attached peer
expect=stderr:pattern=SEND-PERMISSION: the unattached peer was sent nothing
expect=stderr:pattern=SEND-PERMISSION: refused for the unattached peer
expect=stderr:pattern=SEND-PERMISSION: a send-only binding is fed nothing
# ze's own report of the refusal, naming the peer and the process. AC-9 requires
# the drop to be REPORTED rather than silent, and this is the line that reports it.
expect=stderr:pattern=send refused.*peer=127\.0\.0\.2 process=send-permission-injector send-type=update

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external send-permission-injector {
		run "ze-test fixture plugin/attach-process-send-permission"
		encoder json
	}
}

bgp {
	peer permitted {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		attach process send-permission-injector {
			send [ update ]
		}
	}
	peer unattached {
		connection {
			remote {
				ip 127.0.0.2
			}
			local {
				ip 127.0.0.2
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.5
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=40s
expect=exit:code=0
