# Test: `show l2tp tunnels` returns the established tunnel after a
#       real SCCRQ/SCCCN handshake.
#
# VALIDATES: spec-l2tp-7 AC-8 -- per-tunnel snapshot surfaces the
#            established tunnel through the CLI handler. The handler
#            must see the reactor-owned tunnel via the service
#            locator, not stale state.
# PREVENTS:  regression where the handler reads from an unrelated
#            reactor pool, or where the tunnel list is populated
#            only after a timer tick.
#
# Architecture:
#   seq=1: ze-peer (BGP) — triggers TLS plugin hub setup so the
#          external observer process can reach the engine.
#   seq=2: native L2TP peer brings up one tunnel via SCCRQ / SCCRP
#          / SCCCN, then blocks on a marker file so the tunnel stays
#          established while the observer reads.
#   seq=3: ze daemon.
#   The external observer (spawned by ze via plugin/external) dispatches
#   `show l2tp tunnels`, asserts the tunnel is visible, then writes
#   the marker file so the peer exits cleanly.

option=env:var=ze.l2tp.skip-kernel-probe:value=true
option=env:var=TEST_SECRET:value=show-tunnels-secret
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=20s

# ze-peer runs as a sink: only a dial target, asserts nothing. This test is about
# `show l2tp tunnels`; the BGP peer exists so ze has a session to configure.
#
# // the ipv4/unicast EOR this block declared RACED the run-script's
# `request shutdown`, which fires at post-startup while ze is still in the OPEN
# handshake. Observed both ways on a quiet tree: usually the peer logs "open recv /
# open sent / connection closed before completion" and the EOR never arrives (red),
# occasionally ze wins the race and sends it (green). That flip is why
# plan/deferrals.md files this test under "load-sensitive"; the failure signature is
# identical to the deterministic EOR reds, so the cause is the race, not machine
# load. Whether ze SHOULD delay shutdown for the EOR is a real question, owned by
# plan/spec-fixit-redistribute-establishment-stall.md and the "who is entitled to
# delay a BGP session's EOR" spec -- sinking here does not answer it and must not be
# read as answering it. Coverage is NOT reduced: this test never asserted BGP wire
# content -- its l2tp assertions and expect=exit:code=0 are what it proves.
EOF_PEER


stdin=ze-conf:terminator=EOF_CONF
plugin {
	external l2tp-tunnels-show-test {
		run "ze-test fixture plugin/l2tp-tunnels-show"
		encoder json
	}
}

environment {
	log {
		l2tp debug
	}
	l2tp {
		server main {
			ip 127.0.0.1
			port $PORT2
		}
	}
}

l2tp {
	enabled true
	shared-secret show-tunnels-secret
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --mode sink --port $PORT:stdin=peer
cmd=background:seq=2:exec=ze-test fixture plugin/l2tp-tunnels-show-peer $PORT2 0x0123
cmd=foreground:seq=3:exec=ze -:stdin=ze-conf:timeout=20s
expect=exit:code=0
expect=stderr:contains=tunnel now established
