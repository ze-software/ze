	peer edge1 {
		filter {
			import { final accept; }
			export { final accept; }
		}
		connection {
			remote { ip 127.0.0.2; connect false; }
			local { ip 127.0.0.1; port $PORT; accept true; }
		}
		session {
			asn { remote 65001; }
			family {
				ipv4/unicast { prefix { maximum 10000; } }
				ipv4/flow { prefix { maximum 10000; } }
			}
			capability { graceful-restart disable; }
		}
	}
}
EOF_CONF

tmpfs=verify-inspect.py:mode=755:terminator=EOF_VERIFY
#!/usr/bin/env python3
import json
import subprocess
import sys


def cli_json(cmd):
    out = subprocess.check_output(["ze", "cli", "-c", cmd + " | json"], text=True)
    return json.loads(out)


def must(cond, msg):
    if not cond:
        raise SystemExit("FAIL: " + msg)


# 1. Internal plugin establishes the daemon PID baseline.
in_mem = cli_json("show runtime memory | plugin in-hostname")
must(in_mem.get("plugin") == "in-hostname", f"in-hostname plugin field: {in_mem}")
must(in_mem.get("process-mode") == "internal", f"in-hostname process-mode: {in_mem}")
daemon_pid = in_mem.get("pid", 0)
must(daemon_pid > 0, f"in-hostname pid invalid: {in_mem}")
must(in_mem.get("alloc", 0) > 0, f"in-hostname alloc invalid: {in_mem}")
must(in_mem.get("num-goroutines", 0) > 0, f"in-hostname num-goroutines invalid: {in_mem}")

in_sysmem = cli_json("show system memory | plugin in-hostname")
must(in_sysmem.get("process-mode") == "internal", f"in-hostname sysmem mode: {in_sysmem}")
must(in_sysmem.get("pid") == daemon_pid, f"in-hostname sysmem pid: {in_sysmem}")
must(in_sysmem.get("shared-daemon-process") is True, f"in-hostname shared flag: {in_sysmem}")
must(in_sysmem.get("vm-rss-kb", 0) > 0, f"in-hostname vm-rss-kb: {in_sysmem}")

# 2. Forked separate-process Go plugin (my-ddos): all five commands return external PID != daemon_pid.
ext_g = cli_json("show system goroutines mode summary | plugin my-ddos")
must(ext_g.get("plugin") == "my-ddos", f"my-ddos goroutines plugin: {ext_g}")
must(ext_g.get("process-mode") == "external", f"my-ddos goroutines mode: {ext_g}")
ext_pid = ext_g.get("pid", 0)
must(ext_pid > 0 and ext_pid != daemon_pid, f"my-ddos pid {ext_pid} vs daemon {daemon_pid}")
must(ext_g.get("total", 0) > 0, f"my-ddos goroutines total: {ext_g}")
must(isinstance(ext_g.get("by-state"), dict) and len(ext_g["by-state"]) > 0, f"my-ddos by-state: {ext_g}")

ext_gb = cli_json("show system goroutines mode blocked | plugin my-ddos")
must(ext_gb.get("mode") == "blocked" and ext_gb.get("pid") == ext_pid, f"my-ddos blocked: {ext_gb}")

ext_heap = cli_json("show system profile type heap | plugin my-ddos | summary")
must(ext_heap.get("process-mode") == "external" and ext_heap.get("pid") == ext_pid, f"my-ddos heap: {ext_heap}")
must(ext_heap.get("format") == "summary" and ext_heap.get("type") == "heap", f"my-ddos heap format: {ext_heap}")

ext_mutex = cli_json("show system profile type mutex | plugin my-ddos | summary")
must(ext_mutex.get("process-mode") == "external" and ext_mutex.get("pid") == ext_pid, f"my-ddos mutex: {ext_mutex}")
must(ext_mutex.get("sampling-rate") == 10, f"my-ddos mutex sampling-rate: {ext_mutex}")

ext_rt = cli_json("show runtime memory | plugin my-ddos")
must(ext_rt.get("process-mode") == "external" and ext_rt.get("pid") == ext_pid, f"my-ddos rt mem: {ext_rt}")
must(ext_rt.get("alloc", 0) > 0 and ext_rt.get("num-goroutines", 0) > 0, f"my-ddos rt stats: {ext_rt}")
must(bool(ext_rt.get("go-version")), f"my-ddos go-version: {ext_rt}")

ext_os = cli_json("show system memory | plugin my-ddos")
must(ext_os.get("process-mode") == "external" and ext_os.get("pid") == ext_pid, f"my-ddos os mem: {ext_os}")
must(ext_os.get("vm-rss-kb", 0) > 0 and ext_os.get("threads", 0) > 0, f"my-ddos os rss/threads: {ext_os}")

ext_log = cli_json("show log recent | plugin my-ddos")
must(ext_log.get("process-mode") == "external" and ext_log.get("pid") == ext_pid, f"my-ddos log: {ext_log}")
must(isinstance(ext_log.get("entries"), list), f"my-ddos log entries: {ext_log}")

# 3. Non-Go external plugin (ext-norpc): triggers non-destructive host fallback and stays alive.
fb_g = cli_json("show system goroutines | plugin ext-norpc")
must(fb_g.get("fallback") is True, f"ext-norpc goroutines fallback: {fb_g}")
must(fb_g.get("fallback-reason") == "unsupported", f"ext-norpc fallback-reason: {fb_g}")
must(fb_g.get("process-mode") == "external", f"ext-norpc process-mode: {fb_g}")
norpc_pid = fb_g.get("pid", 0)
must(norpc_pid > 0 and norpc_pid != daemon_pid and norpc_pid != ext_pid, f"ext-norpc pid: {fb_g}")
must(fb_g.get("running") is True, f"ext-norpc running: {fb_g}")
host = fb_g.get("host") or {}
must(host.get("threads", 0) > 0 and host.get("vm-rss-kb", 0) > 0, f"ext-norpc host procfs: {fb_g}")
must(host.get("fd-count", 0) > 0, f"ext-norpc host fd-count: {fb_g}")
tail = fb_g.get("stderr-tail") or []
must(any("EXT-FALLBACK-MARKER: non-go helper alive" in line for line in tail), f"ext-norpc stderr-tail: {fb_g}")

fb_log = cli_json("show log recent | plugin ext-norpc")
must(fb_log.get("fallback") is True and fb_log.get("pid") == norpc_pid, f"ext-norpc log fallback: {fb_log}")
must(any("EXT-FALLBACK-MARKER: non-go helper alive" in line for line in (fb_log.get("stderr-tail") or [])), f"ext-norpc log stderr-tail: {fb_log}")

# Confirm ext-norpc is still running (read-only show never signalled it).
subs = cli_json("show system subsystem list")
by_name = {s["name"]: s for s in subs.get("subsystems", [])}
must("ext-norpc" in by_name and by_name["ext-norpc"].get("running") is True, f"ext-norpc stopped after inspect: {subs}")

# 4. Unknown plugin returns structured refusal naming ze show system subsystem list.
proc = subprocess.run(
    ["ze", "cli", "-c", "show system goroutines | plugin does-not-exist"],
    capture_output=True,
    text=True,
)
combined = proc.stdout + proc.stderr
must(proc.returncode != 0 or "does-not-exist" in combined, f"unknown plugin should fail: rc={proc.returncode} out={combined}")
must("ze show system subsystem list" in combined, f"unknown plugin missing fix hint: {combined}")

print(f"OK: verified internal pid={daemon_pid}, separate pid={ext_pid}, fallback pid={norpc_pid}")
EOF_VERIFY

cmd=background:seq=1:name=daemon:exec=ze start running.conf:ready=Ze running.
reject=stderr:pattern=panic

cmd=foreground:seq=2:exec=python3 verify-inspect.py:exit=0
expect=stdout:contains=OK: verified internal pid=

cmd=stop:seq=3:name=daemon:signal=term
