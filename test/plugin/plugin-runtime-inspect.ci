# Test: `| plugin <name>` runtime introspection works end-to-end for a forked separate-process Go plugin, an in-daemon internal plugin, and non-destructive host fallback for a non-Go external plugin.
# QUESTION: on a live daemon running a compiled-in `process separate` plugin (`my-ddos`),
# an in-daemon plugin (`in-hostname`), and a non-Go external plugin (`ext-norpc`) that
# refuses `ze-plugin-callback:runtime-inspect` with `unknown method`, do
# `show system goroutines`, `show system profile` (including `| summary` and `mutex` sampling-rate),
# `show runtime memory`, `show system memory`, and `show log recent` with `| plugin <name>`
# return distinct external PIDs and live runtime data for `my-ddos`, daemon-shared internal
# data for `in-hostname`, non-destructive `/proc/<pid>` + `stderr-tail` fallback for `ext-norpc`
# while keeping `ext-norpc` running, and a structured refusal for an unknown plugin?
# A unit test cannot decide this because the path spans live separate-process forking of
# `ze plugin ddos-flowspec`, separate-process profiling initialization, TLS connect-back
# independent callback routing, real Linux `/proc/<pid>` inspection, stderr tail capture,
# and CLI pipe parsing/dispatch end-to-end.
#
# VALIDATES: spec-ai-diagnostics-3-external-plugin-introspection AC-5, AC-7, AC-8.
# PREVENTS: `| plugin <name>` routing only in-process, missing separate-process mutex
# sampling defaults, missing `/proc/<pid>` or `stderr-tail` host fallback, or signalling
# a non-Go/wedged external plugin on read-only `show` inspection.

option=storage:value=disk
option=timeout:value=120s
option=env:var=ZE_CONFIG_DIR:value=.
option=env:var=XDG_DATA_HOME:value=.
option=env:var=ze.ssh.username:value=admin
option=env:var=ze.ssh.password:value=testpass
option=env:var=ze.ssh.port:value=$PORT2

tmpfs=ext-norpc.py:mode=755:terminator=EOF_EXTPY
#!/usr/bin/env python3
import json
import os
import socket
import ssl
import sys

if os.environ.get("ZE_PLUGIN_MODE") == "declare":
    sys.stdout.write('#1 ze-plugin-engine:declare-registration {"protocol-version":1}\n')
    sys.stdout.flush()
    sys.exit(0)

sys.stderr.write("EXT-FALLBACK-MARKER: non-go helper alive\n")
sys.stderr.flush()

host = os.environ["ZE_PLUGIN_HUB_HOST"]
port = int(os.environ["ZE_PLUGIN_HUB_PORT"])
token = os.environ["ZE_PLUGIN_HUB_TOKEN"]
name = os.environ["ZE_PLUGIN_NAME"]
ca_pem = os.environ["ZE_PLUGIN_CA_PEM"]

ctx = ssl.create_default_context(cadata=ca_pem)
raw_sock = socket.create_connection((host, port), timeout=15)
tls_sock = ctx.wrap_socket(raw_sock, server_hostname=host)
tls_sock.settimeout(None)
rfile = tls_sock.makefile("r", encoding="utf-8", newline="\n")
wfile = tls_sock.makefile("w", encoding="utf-8", newline="\n")


def send_line(line):
    wfile.write(line + "\n")
    wfile.flush()


def parse_line(line):
    line = line.rstrip("\r\n")
    parts = line.split(" ", 2)
    req_id = parts[0]
    verb = parts[1] if len(parts) > 1 else ""
    payload = parts[2] if len(parts) > 2 else ""
    return req_id, verb, payload


def wait_for_ok(expected_id):
    while True:
        line = rfile.readline()
        if not line:
            raise SystemExit("unexpected EOF waiting for " + expected_id)
        req_id, verb, _ = parse_line(line)
        if req_id == expected_id:
            if verb != "ok":
                raise SystemExit("expected ok for " + expected_id + ", got: " + line.strip())
            return
        if verb.startswith("ze-plugin-callback:"):
            send_line(f"{req_id} ok")


def wait_for_callback(expected_verb):
    while True:
        line = rfile.readline()
        if not line:
            raise SystemExit("unexpected EOF waiting for " + expected_verb)
        req_id, verb, _ = parse_line(line)
        if verb == expected_verb:
            send_line(f"{req_id} ok")
            return
        if verb.startswith("ze-plugin-callback:"):
            send_line(f"{req_id} ok")


# Auth handshake (#0 auth)
send_line("#0 auth " + json.dumps({"token": token, "name": name}))
wait_for_ok("#0")

# Stage 1: declare-registration
send_line('#1 ze-plugin-engine:declare-registration {"protocol-version":1}')
wait_for_ok("#1")

# Stage 2: configure callback
wait_for_callback("ze-plugin-callback:configure")

# Stage 3: declare-capabilities
send_line("#2 ze-plugin-engine:declare-capabilities {}")
wait_for_ok("#2")

# Stage 4: share-registry callback
wait_for_callback("ze-plugin-callback:share-registry")

# Stage 5: ready
send_line("#3 ze-plugin-engine:ready {}")
wait_for_ok("#3")

# Runtime loop: refuse runtime-inspect as unknown method; answer bye cleanly.
while True:
    line = rfile.readline()
    if not line:
        break
    req_id, verb, _ = parse_line(line)
    if verb == "ze-plugin-callback:bye":
        send_line(f"{req_id} ok")
        break
    if verb.startswith("ze-plugin-callback:"):
        err = json.dumps({"code": "error", "message": "unknown method: " + verb})
        send_line(f"{req_id} error {err}")
EOF_EXTPY

tmpfs=running.conf:terminator=EOF_CONF
