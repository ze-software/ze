# Test: SIGHUP reload applies a changed `shared-secret` to the
#       running subsystem's effective config.
#
# VALIDATES: spec-l2tp-7 AC-14 -- shared-secret is hot-applied by
#            Subsystem.Reload and surfaces as "<set>" / "<unset>"
#            through EffectiveConfig. `show l2tp config` must not
#            leak the actual secret; the redaction must respond to
#            reload-time changes.
# PREVENTS:  regression where a reload parses the new secret but
#            does not update the redacted indicator (operators would
#            believe the old state still applies), and regression
#            where the reload silently no-ops when the secret flips.

option=env:var=ze.l2tp.skip-kernel-probe:value=true
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=20s
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER


# Post-SIGHUP config: adds the shared-secret. Everything else unchanged.
tmpfs=config2.conf:terminator=EOF_CONF2
plugin {
	external reload-shared-secret-test {
		run "ze-test fixture plugin/reload-shared-secret"
		encoder json
	}
}

environment {
	log {
		l2tp debug
	}
	l2tp {
		server main {
			ip 127.0.0.1
			port $PORT2
		}
	}
}

l2tp {
	enabled true
	shared-secret reload-secret-v2
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF2


stdin=ze-conf:terminator=EOF_CONF
plugin {
	external reload-shared-secret-test {
		run "ze-test fixture plugin/reload-shared-secret"
		encoder json
	}
}

environment {
	log {
		l2tp debug
	}
	l2tp {
		server main {
			ip 127.0.0.1
			port $PORT2
		}
	}
}

l2tp {
	enabled true
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=background:seq=2:exec=ze-test fixture plugin/reload-shared-secret-trigger
cmd=foreground:seq=3:exec=ze -:stdin=ze-conf:timeout=20s
expect=exit:code=0
expect=stderr:contains=l2tp reload: shared-secret updated
