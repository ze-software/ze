# rfc6793-no-as4aggregator-from-new-speaker -- an AS4_AGGREGATOR from a NEW speaker is not relayed
#
# VALIDATES: RFC 6793 Section 4.1 -- "The new attributes, AS4_PATH and
# AS4_AGGREGATOR, MUST NOT be carried in an UPDATE message between NEW BGP
# speakers." rfc6793-no-as4path-from-new-speaker.ci holds the AS4_PATH half.
# This file holds the AS4_AGGREGATOR half, with an input that carries one.
#
# THE TWO AGGREGATOR VALUES DIFFER ON PURPOSE. AGGREGATOR names AS 4200000123
# and AS4_AGGREGATOR names AS 4200000000, so a merge into AGGREGATOR would be
# visible in the forwarded bytes rather than hidden behind an identical value.
#
# RFC requirement: RFC6793-4.1-6 positive -- the UPDATE ze puts on the wire between
# two NEW BGP speakers carries no AS4_AGGREGATOR although the UPDATE ze read carried
# one: conn=2 receives exactly ORIGIN, AS_PATH, NEXT_HOP and the unchanged
# four-octet AGGREGATOR (35 attribute octets, asserted as exact wire hex on a
# running daemon), and attribute type 18 is not among them (Section 4.1).
#
# BOTH PEERS ARE NEW SPEAKERS: neither session block disables asn4, so both
# negotiate four octets.

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=2
option=timeout:value=45s
option=bind:value=0.0.0.0
option=conn_map:value=remote-ip

# Source peer (conn=1), a NEW speaker sending what Section 4.1 forbids:
#   40 01 01 00                        ORIGIN igp
#   40 02 0A 0202 0000FDE9 FA56EA7B    AS_PATH [65001, 4200000123], four-octet
#   40 03 04 01010101                  NEXT_HOP 1.1.1.1
#   C0 07 08 FA56EA7B 01010101         AGGREGATOR AS 4200000123, 1.1.1.1
#   C0 12 08 FA56EA00 01010101         AS4_AGGREGATOR AS 4200000000, 1.1.1.1,
#                                      which must never reach conn=2
#   18 0A0000                          NLRI 10.0.0.0/24
# attr len = 4 + 13 + 7 + 11 + 11 = 46 = 0x2E; total = 19 + 2 + 2 + 46 + 4 = 73 = 0x49.
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0049020000002E4001010040020A02020000FDE9FA56EA7B40030401010101C00708FA56EA7B01010101C01208FA56EA0001010101180A0000

# The SOURCE's own EOR (conn=1).
expect=bgp:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000

# Receiver peer (conn=2), asserted by full byte-equality:
#   40 01 01 00                        ORIGIN igp
#   40 02 0A 0202 0000FDE9 FA56EA7B    AS_PATH unchanged
#   40 03 04 01010101                  NEXT_HOP 1.1.1.1
#   C0 07 08 FA56EA7B 01010101         AGGREGATOR unchanged. The dropped
#                                      AS4_AGGREGATOR contributed nothing.
#   18 0A0000                          NLRI 10.0.0.0/24
# attr len = 4 + 13 + 7 + 11 = 35 = 0x23; total = 19 + 2 + 2 + 35 + 4 = 62 = 0x3E.
expect=bgp:conn=2:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF003E02000000234001010040020A02020000FDE9FA56EA7B40030401010101C00708FA56EA7B01010101180A0000
EOF_PEER

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	internal rs {
		use bgp-rs
	}
	internal adj-rib-in {
		use bgp-adj-rib-in
	}
	external shutdown-after-up {
		run "le test fixture plugin/rfc6793-no-as4path-from-new-speaker"
		encoder json
	}
}
bgp {
	peer source-new {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			rs-client true
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
			rs-fast-path enable
		}
		attach process adj-rib-in {
			receive [ update-received state ]
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
		attach process shutdown-after-up {
			receive [ update ]
		}
	}
	peer receiver-new {
		connection {
			remote {
				ip 127.0.0.2
			}
			local {
				ip 127.0.0.2
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65002
			}
			router-id 1.2.3.4
			rs-client true
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
			rs-fast-path enable
		}
		attach process adj-rib-in {
			send [ update ]
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
		attach process shutdown-after-up {
			receive [ update ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=45s
expect=exit:code=0
reject=stderr:pattern=panic
reject=stderr:pattern=fatal error
