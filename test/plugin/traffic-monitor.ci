# Test: `show traffic stat` RPC dispatches through the plugin engine
# VALIDATES: the trafficstat component's ze-show:traffic-stat RPC returns
#   StatusDone with a snapshot map (a `degraded` flag plus an `interfaces`
#   list) via handleShowTraffic, proving the RPC handler, YANG command
#   registration, and the lazy service lifecycle (EnsureGlobal) are wired
#   end-to-end. Dispatch succeeding also proves the command is registered and
#   discoverable, so no separate `show help` step is needed.
# PREVENTS: the traffic-stat command/schema not being registered, the handler
#   crashing on cold start, or the lazy service failing to initialize (a
#   wiring + data-path regression).


stdin=ze-conf:terminator=EOF_CONF
plugin {
    external traffic-monitor-done {
        run "ze-test fixture plugin/traffic-monitor"
        encoder json
    }
}

bgp {
    peer peer1 {
        connection {
            remote {
                ip 127.0.0.1
            }
            local {
                ip 127.0.0.1
                accept false
            }
        }
        session {
            asn {
                local 1
                remote 1
            }
            router-id 1.2.3.4
            family {
                ipv4/unicast { prefix { maximum 10000; } }
            }
            capability {
                graceful-restart disable
            }
        }
        behavior {
            group-updates disable
        }
    }
}
EOF_CONF

cmd=foreground:seq=1:exec=ze -:stdin=ze-conf:timeout=15s
expect=exit:code=0
