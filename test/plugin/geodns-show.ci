# Test: show geodns returns GeoDNS server status.
# Exercises: dispatch-command -> ze-show:geodns -> handleShowGeoDNS
# Verifies: spec-geodns-3 AC-1 - returns JSON with enabled + listeners fields
# from the live resolver snapshot the geodns engine published on configure.
#
# The observer dispatches the FULL CLI path "show geodns" (NOT "geodns"): a bare
# plugin-command name falls through to routeToProcess and blocks, so the observer
# would never reach its assertions (a silent false pass). See learned 996.

# ze-peer: accepts connection
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
option=asn:value=65001
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

tmpfs=geodns-show-test.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
import json
import sys
from ze_api import API, runtime_fail, result_text_data

def dispatch(api, command):
    resp = api._call_engine(
        'ze-plugin-engine:dispatch-command', {'command': command})
    if resp is None:
        return {'status': 'error', 'data': 'engine call returned None'}
    return resp.get('result', {})

def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()
    api.wait_for_post_startup(timeout=5.0)

    try:
        resp = dispatch(api, 'show geodns')
        status = resp.get('status')
        if status != 'done':
            runtime_fail(f'geodns: status={status} data={resp.get("data")}')

        data = result_text_data(resp)
        if isinstance(data, str) and data:
            data = json.loads(data)
        if not isinstance(data, dict):
            runtime_fail(f'geodns: expected dict, got {type(data).__name__}')
        if 'enabled' not in data:
            runtime_fail(f'geodns: missing "enabled" in {data}')
        if data.get('enabled') is not True:
            runtime_fail(f'geodns: expected enabled=true, got {data.get("enabled")}')
        if 'listeners' not in data:
            runtime_fail(f'geodns: missing "listeners" in {data}')

        print(f'OK: geodns enabled={data["enabled"]} listeners={data["listeners"]}', file=sys.stderr)
    finally:
        dispatch(api, 'request shutdown')
        api.wait_for_shutdown()

if __name__ == '__main__':
    main()
EOF_RUN

stdin=ze-bgp:terminator=EOF_CONF
service {
	geodns {
		enabled true
		listener loopback {
			ip 127.0.0.1
			port 5300
		}
		zone geodns.example.
		nameserver 82.219.4.22
		host-set external {
			host proxy.geodns.example. {
				address 10.0.0.2
			}
		}
		source 0.0.0.0/0 {
			host-set external
		}
	}
}

plugin {
	external geodns-show-test {
		run ./geodns-show-test.run
		encoder json
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast {
					prefix {
						maximum 10000
					}
				}
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
