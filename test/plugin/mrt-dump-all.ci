# Test: mrt all-messages stream -- an operator configures MRT all-message
# dumping; the BGP messages exchanged on a session (and the end-of-RIB UPDATE)
# are written to the MRT file as RFC 6396 BGP4MP records.
#
# VALIDATES: `mrt { all { file ... } }` auto-loads the mrt plugin and its
#            all-messages stream records the session's BGP messages. The file is
#            created lazily on the first record, so its presence after a clean
#            shutdown proves the config -> mrt component -> asyncWriter -> file
#            path fired for the all stream (distinct from the updates stream).
# PREVENTS: the all-messages stream regressing to silent (dead writer, or the
#           config-root unwrap bug that left mrt idle).
#
# Mutation check: reverting the ParseConfig root-unwrap (mrt/register.go) leaves
# mrt-all.dump absent -> RED.

option=skip-os:value=darwin

# Give the runner one private working directory for both the daemon's relative
# MRT path and the file assertion below.
tmpfs=.mrt-workdir:terminator=EOF_WORKDIR
mrt
EOF_WORKDIR

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
option=asn:value=65001
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# Native observer waits for the EOR UPDATE before requesting clean shutdown.

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external mrt-observer {
		run "ze-test fixture plugin/mrt-dump-all"
		encoder json
	}
}

mrt {
	all {
		file "mrt-all.dump"
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast {
					prefix {
						maximum 10000
					}
				}
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

expect=file:path=mrt-all.dump:exists=true

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
reject=stderr:pattern=panic recovered
reject=stderr:pattern=mrt plugin failed
