# Test: mrt all-messages stream -- an operator configures MRT all-message
# dumping; the BGP messages exchanged on a session (and the end-of-RIB UPDATE)
# are written to the MRT file as RFC 6396 BGP4MP records.
#
# VALIDATES: `mrt { all { file ... } }` auto-loads the mrt plugin and its
#            all-messages stream records the session's BGP messages. The file is
#            created lazily on the first record, so its presence after a clean
#            shutdown proves the config -> mrt component -> asyncWriter -> file
#            path fired for the all stream (distinct from the updates stream).
# PREVENTS: the all-messages stream regressing to silent (dead writer, or the
#           config-root unwrap bug that left mrt idle).
#
# Mutation check: reverting the ParseConfig root-unwrap (mrt/register.go) leaves
# mrt-all.dump absent -> RED.

option=skip-os:value=darwin

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
option=asn:value=65001
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

tmpfs=mrt-observer.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
from ze_api import API, runtime_fail, result_json_data


def dispatch(api, command):
    return api._call_engine('ze-plugin-engine:dispatch-command', {'command': command}) or {}


def peer_field(api, name, addr, field, default):
    result = dispatch(api, f'show bgp peer {name} detail').get('result', {})
    if result.get('status') != 'done':
        return default
    data = result_json_data(result, {})
    return data.get('peers', {}).get(addr, {}).get(field, default)


def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()

    for _ in range(100):
        if peer_field(api, 'peer1', '127.0.0.1', 'updates-sent', 0) >= 1:
            break
        api.wait_for_event(timeout=0.2)
    else:
        runtime_fail('timeout waiting for ze to exchange BGP messages with peer1')

    dispatch(api, 'request shutdown')
    api.wait_for_shutdown()


if __name__ == '__main__':
    main()
EOF_RUN

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external mrt-observer {
		run ./mrt-observer.run
		encoder json
	}
}

mrt {
	all {
		file "mrt-all.dump"
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast {
					prefix {
						maximum 10000
					}
				}
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

expect=file:path=mrt-all.dump:exists=true

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
reject=stderr:pattern=panic recovered
reject=stderr:pattern=mrt plugin failed
