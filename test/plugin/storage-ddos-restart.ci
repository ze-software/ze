# Test: storage-1 AC18 ddos consumer survives a selected-folder daemon restart.
# VALIDATES: Waits for the periodic save after 300 real collector ticks, then restarts with detection disabled and checks both baselines restored ready.
# PREVENTS: a working generic state RPC hiding a consumer that never restores.
# The fixture launches ze start <selected>/router.conf without a config-dir pin.
option=needs-linux
option=exclusive:group=ddos-flood
option=timeout:value=450s
cmd=foreground:seq=1:exec=le test fixture storage/consumer-restart ddos:timeout=430s
expect=exit:code=0
expect=stderr:contains=OK: ddos consumer restored operational state from selected tree without config-dir pin
