# RFC requirement: RFC1997-Well-1 negative -- "All routes received carrying a communities
# attribute containing this value [NO_EXPORT] MUST NOT be ADVERTISED outside a BGP
# confederation boundary" (RFC 1997, Well-known Communities). The verb bounds the clause: a
# route being taken back is not being advertised, so the prohibition covers the announcement
# half of an UPDATE and not the withdrawal half riding in the same message.
#
# WHAT THIS GUARDS. One UPDATE can carry both halves -- RFC 7606 Section 5.1 tells a SENDER
# not to emit that shape, and ze must still handle it on receipt (wireu.MixesNLRIFields).
# Refusing the whole message leaves the external peer holding a prefix ze can no longer
# withdraw until the session resets. That trades a leak the RFC forbids for a stale route it
# says nothing about, which is not the trade the clause asks for.
#
# WHY A .ci AND NOT ONLY THE UNIT TESTS. The unit tests prove both rails split the message.
# Only a running daemon proves the withdrawal reaches a socket while the announcement does
# not, and the egress rails are where a stranded route actually happens.
#
# NON-VACUITY (ai/rules/interop-and-goal-validation.md). Three controls, all on the SAME
# external session:
#   1. the withdrawal 198.51.100.0/24 IS delivered there -- reverting the split to a whole
#      message skip reddens this;
#   2. the FENCE route 192.0.2.0/24 IS delivered there, so a build forwarding nothing is red;
#   3. the internal session receives BOTH halves, so a build suppressing on the wrong side
#      is red.
# The reject rule covers the leak in the other direction.
#
# ORDERING. The source sends the mixed UPDATE BEFORE the fence, on one TCP stream ze
# processes in order on one goroutine. The observer waiting for the fence therefore proves
# the mixed UPDATE was already decided.

# The three ze-peer connections belong to ONE process, and they must.
# option=conn_map:value=remote-ip numbers them and option=await_eor:value=true is
# the barrier, which is per accepted BATCH (peer_connmap.go) and so cannot span
# processes. A destination that comes up late loses the WITHDRAWAL for good: an
# announcement is replayed from the Adj-RIB-In when the session comes up, and a
# withdrawal has nothing to replay from, so the race lands exactly on the
# assertion this file exists to make. Measured 5/6 serially before the barrier.

# ONE peer process holds all three sessions, and the conn number is the peer's address
# rather than the order ze happened to connect in (option=conn_map, peer_connmap.go).
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=3
option=timeout:value=30s
option=bind:value=0.0.0.0
# conn=1 is 127.0.0.1 (the source), conn=2 is 127.0.0.2 (internal), conn=3 is 127.0.0.3
# (external): remote-ip sorts the accepted batch by TCP source address, which is each
# peer's `local ip` below.
option=conn_map:value=remote-ip
# THE BARRIER. ze emits its End-of-RIB to a peer only after that peer's initial sync, so
# the EoR is the first frame proving the peer is a live forward target. Same reasoning,
# and the same option, as rfc7606-relay-one-field.ci.
option=await_eor:value=true
# The peers must outlive the assertions: a source that closes makes ze withdraw its
# routes, which would deliver the destinations messages they never asked for.
option=linger:value=true

# conn=1, the SOURCE -- external, AS 65001, on 127.0.0.1.
# seq=1 -- the MIXED UPDATE. Withdrawn Routes = 198.51.100.0/24 (18C63364). NLRI =
# 10.0.0.0/24 (180A0000) with ORIGIN=IGP, AS_PATH=[65001], NEXT_HOP=1.1.1.1,
# COMMUNITY=NO_EXPORT (0xFFFFFF01). The community rides in the attribute section, which
# governs the NLRI only: the Withdrawn Routes field carries no attributes at all.
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF003A02000418C63364001B4001010040020602010000FDE940030401010101C00804FFFFFF01180A0000
# seq=2 -- the FENCE, 192.0.2.0/24, an ordinary community 64985:100 (0xFDE90064). RFC 1997
# says nothing about it, so it must be advertised to both destinations.
action=send:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0036020000001B4001010040020602010000FDE940030401010101C00804FDE9006418C00002

# conn=2, the INTERNAL destination -- AS 65000, the same AS ze runs, on 127.0.0.2.
# CONTROL 3: an internal peer is inside the confederation boundary, so it receives BOTH
# halves. ze splits the mixed shape before sending it (RFC 7606 Section 5.1), withdrawal
# first, so the withdrawal and the announcement arrive as two messages in that order.
expect=bgp:conn=2:seq=1:contains=18C63364
expect=bgp:conn=2:seq=2:contains=180A0000

# conn=3, the EXTERNAL destination -- AS 65002, on 127.0.0.3. Every assertion about the
# prohibition and its limit lives here.
# CONTROL 1, and the point of this test: the withdrawal half REACHES the refused peer.
expect=bgp:conn=3:seq=1:contains=18C63364
# CONTROL 2: the fence route reaches this session too, so control 1 cannot pass by way of
# some unrelated message.
expect=bgp:conn=3:seq=2:contains=18C00002
# THE ASSERTION: 10.0.0.0/24 never reaches this external session, in any framing.
reject=bgp:conn=3:pattern=180A0000
EOF_PEER

# Observer: hold the daemon up until the fence has been written to the external
# destination, which proves the mixed UPDATE ahead of it was already decided.
tmpfs=wellknown-withdraw.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
"""Sequence shutdown behind the fence route reaching the external destination."""
import sys
from ze_api import API, runtime_fail

EXTERNAL = '127.0.0.3'
INTERNAL = '127.0.0.2'


def real_updates(api, peer):
    """UPDATEs written to peer, End-of-RIB markers excluded.

    updates-sent counts every UPDATE written, the initial-sync EoR included
    (IncrUpdatesSent, reactor/reactor_notify.go sees only the message type).
    eor-sent is the separate marker counter, so the difference is route traffic.
    """
    return api.peer_counter('updates-sent', peer=peer) - api.peer_counter('eor-sent', peer=peer)


def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()

    # quiesce FIRST so the polls behind it are a safety net rather than the
    # mechanism: it drains the forward pool in one RPC.
    api.quiesce()

    # The internal peer gets three: the withdrawal, the announcement, the fence.
    if not api.wait_until(lambda: real_updates(api, INTERNAL) >= 3, attempts=40):
        runtime_fail('internal peer was not sent both halves and the fence')
    print('OK: internal peer received both halves and the fence', file=sys.stderr)

    # The external peer gets two: the withdrawal and the fence. Two, not three: three
    # would mean the announcement leaked, which the reject rule also catches on the wire.
    if not api.wait_until(lambda: real_updates(api, EXTERNAL) >= 2, attempts=40):
        runtime_fail('external peer was not sent the withdrawal and the fence')
    if real_updates(api, EXTERNAL) != 2:
        runtime_fail('external peer was sent more than the withdrawal and the fence')
    print('OK: external peer received the withdrawal and the fence, nothing else', file=sys.stderr)

    api.dispatch('request shutdown')
    api.wait_for_shutdown()


if __name__ == '__main__':
    main()
EOF_RUN

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	internal adj-rib-in {
		use bgp-adj-rib-in
	}
	internal rs {
		use bgp-rs
	}
	external wellknown-withdraw {
		run ./wellknown-withdraw.run
		encoder json
	}
}
bgp {
	peer source-peer {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
		attach process adj-rib-in {
			receive [ update-received state ]
			send [ update ]
		}
	}

	peer internal-peer {
		connection {
			remote {
				ip 127.0.0.2
			}
			local {
				ip 127.0.0.2
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65000
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
		attach process adj-rib-in {
			receive [ update-received state ]
			send [ update ]
		}
	}

	peer external-peer {
		connection {
			remote {
				ip 127.0.0.3
			}
			local {
				ip 127.0.0.3
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65002
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
		attach process adj-rib-in {
			receive [ update-received state ]
			send [ update ]
		}
	}
}
EOF_CONF

# One process holding three connections is the only shape in which these RFC 1997
# assertions are not a race: the await_eor barrier is per accepted batch
# (peer_connmap.go) and cannot span processes.
cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=30s
expect=exit:code=0
reject=stderr:pattern=panic recovered
reject=stderr:pattern=fatal error
reject=stderr:pattern=ZE-OBSERVER-FAIL
