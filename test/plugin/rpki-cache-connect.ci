# Test: RPKI cache server connection via RTR protocol
# VALIDATES: RTR session connects to cache server, VRPs are populated (AC-1)
# PREVENTS: RPKI plugin not receiving config or not starting RTR sessions

# ze-peer expectations (minimal -- just accept connection)
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
# EOR from ze
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# Python test plugin: queries rpki status after RTR sync
tmpfs=rpki-cache-test.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
import json
import sys
from ze_api import API, result_json_data, result_text_data, runtime_fail
# // test-relax: removed unused 'import time'; blind sleep is now a dispatch_until poll

def dispatch(api, command):
    resp = api._call_engine(
        'ze-plugin-engine:dispatch-command', {'command': command})
    if resp is None:
        return {'status': 'error', 'data': 'engine call returned None'}
    return resp.get('result', {})

def eor_on_wire(result):
    """True once peer1's initial-sync End-of-RIB has been written."""
    if result.get('status') != 'done':
        return False
    data = result_text_data(result, '{}')
    try:
        parsed = json.loads(data) if isinstance(data, str) else data
    except (json.JSONDecodeError, TypeError, ValueError):
        return False
    if not isinstance(parsed, dict):
        return False
    peers = parsed.get('peers', {})
    if not isinstance(peers, dict):
        return False
    return any(isinstance(row, dict) and row.get('eor-sent', 0) >= 1
               for row in peers.values())

def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()

    # Let peer1 finish its initial sync before shutting down. The old script
    # queried RPKI and shut down inside the OPEN handshake, so ze closed the
    # session before ever sending its End-of-RIB and the peer's expectation was
    # unreachable by construction. peer1 binds no send [ update ] plugin, so
    # apiSendCount is 0 and the EOR follows establishment immediately.
    synced = api.dispatch_until(
        'show bgp peer peer1 detail', eor_on_wire, attempts=60,
    )
    if not eor_on_wire(synced):
        runtime_fail('peer1 never sent its initial-sync End-of-RIB')

    try:
        # Query rpki status to verify VRPs loaded.
        # // test-relax: blind sleep(3.0) + single-shot query -> dispatch_until poll (RTR VRP sync landed)
        result = api.dispatch_until(
            'show bgp rpki status',
            lambda r: result_json_data(r, {}).get('vrp-count-ipv4', 0) >= 1
            and result_json_data(r, {}).get('sessions', 0) >= 1,
        )
        if result.get('status') != 'done':
            runtime_fail(f'rpki status={result.get("status")}, want done')

        data = result_json_data(result, {})
        vrp_count = data.get('vrp-count-ipv4', 0)
        sessions = data.get('sessions', 0)

        if vrp_count < 1:
            runtime_fail(f'vrp-count-ipv4={vrp_count}, expected >= 1')

        if sessions < 1:
            runtime_fail(f'sessions={sessions}, expected >= 1')

        print(f'OK: rpki status vrp-count-ipv4={vrp_count} sessions={sessions}', file=sys.stderr)
    finally:
        dispatch(api, 'request shutdown')
        api.wait_for_shutdown()

if __name__ == '__main__':
    main()
EOF_RUN

# ze bgp configuration with RPKI plugin
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	hub {
		server local {
			ip 127.0.0.1;
			port 0;
			secret rpki-test-secret-key-01234567890;
		}
	}
	external rpki-cache-test {
		run ./rpki-cache-test.run
		encoder json
	}
	internal rpki {
		use bgp-rpki
	}
	internal adj-rib-in {
		use bgp-adj-rib-in
	}
}

bgp {
	rpki {
		cache-server 127.0.0.1 {
			port $PORT2
		}
	}
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}

		attach process rpki {
			receive [ update-received ]
		}
		attach process adj-rib-in {
			receive [ update-received state ]
		}
	}
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=ze-test rtr-mock --port $PORT2 --vrp 10.0.0.0/8,24,65001
cmd=background:seq=2:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=3:exec=ze -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
# Prove the observer reached its assertion. Without this the plugin could die
# before querying RPKI at all and the file would still be green on exit=0.
expect=stderr:pattern=OK: rpki status vrp-count-ipv4=[1-9]
reject=stderr:pattern=ZE-OBSERVER-FAIL
