# Test: RPKI cache server connection via RTR protocol
# VALIDATES: RTR session connects to cache server, VRPs are populated (AC-1)
# PREVENTS: RPKI plugin not receiving config or not starting RTR sessions

# ze-peer expectations (minimal -- just accept connection)
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
# EOR from ze
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# native test plugin: queries rpki status after RTR sync
# Native compiled fixture: plugin/rpki-cache-connect
# ze bgp configuration with RPKI plugin
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	hub {
		server local {
			ip 127.0.0.1;
			port 0;
			secret rpki-test-secret-key-01234567890;
		}
	}
	external rpki-cache-test {
		run "ze-test fixture plugin/rpki-cache-connect"
		encoder json
	}
	internal rpki {
		use bgp-rpki
	}
	internal adj-rib-in {
		use bgp-adj-rib-in
	}
}

bgp {
	rpki {
		cache-server 127.0.0.1 {
			port $PORT2
		}
	}
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}

		attach process rpki {
			receive [ update-received ]
		}
		attach process adj-rib-in {
			receive [ update-received state ]
		}
	}
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=ze-test rtr-mock --port $PORT2 --vrp 10.0.0.0/8,24,65001
cmd=background:seq=2:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=3:exec=ze -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
# Prove the observer reached its assertion. Without this the plugin could die
# before querying RPKI at all and the file would still be green on exit=0.
expect=stderr:pattern=OK: rpki status vrp-count-ipv4=[1-9]
reject=stderr:pattern=ZE-OBSERVER-FAIL
