# Test: ASPA policy unknown-reject - route with ASPA Unknown path rejected when unknown-action=reject
# VALIDATES: AC-4 — aspa-unknown-action reject + ASPA Unknown -> route rejected
# PREVENTS: ASPA Unknown routes accepted when operator configured reject

# ze-peer: send route 10.0.1.0/24 with AS_PATH [64500, 64501, 64502]
# 64501 and 64502 have NO ASPA records -> Unknown
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=linger:value=true
option=timeout:value=15s
option=update:value=send-route:prefix=10.0.1.0/24:origin-as=64502:next-hop=10.0.0.1:as-path=64500,64501,64502
# EOR from ze
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# native observer: verify route is NOT in adj-rib-in (rejected by ASPA unknown policy)
# Native compiled fixture: plugin/rpki-aspa-policy-unknown-reject
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	hub {
		server local {
			ip 127.0.0.1;
			port 0;
			secret rpki-test-secret-key-01234567890;
		}
	}
	external rpki-aspa-policy-unknown-reject-test {
		run "ze-test fixture plugin/rpki-aspa-policy-unknown-reject"
		encoder json
	}
	internal rpki {
		use bgp-rpki
	}
	internal adj-rib-in {
		use bgp-adj-rib-in
	}
}

bgp {
	rpki {
		cache-server 127.0.0.1 {
			port $PORT2
		}
		aspa {
			validation true;
			action {
				unknown reject;
			}
		}
	}
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 64500
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}

		attach process rpki-aspa-policy-unknown-reject-test {
			receive [ rpki-received ]
		}
		attach process rpki {
			receive [ update-received ]
		}
		attach process adj-rib-in {
			receive [ update-received state ]
		}
	}
}
EOF_CONF

# RTR mock: VRP covers route (ROA Valid), NO ASPA records for 64501 or 64502 -> Unknown
cmd=background:seq=1:exec=ze-test rtr-mock --port $PORT2 --vrp 10.0.0.0/8,24,64502
cmd=background:seq=2:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=3:exec=ze -:stdin=ze-bgp:timeout=25s
expect=exit:code=0
