# Test: ASPA policy unknown-reject - route with ASPA Unknown path rejected when unknown-action=reject
# VALIDATES: AC-4 — aspa-unknown-action reject + ASPA Unknown -> route rejected
# PREVENTS: ASPA Unknown routes accepted when operator configured reject

# ze-peer: send route 10.0.1.0/24 with AS_PATH [64500, 64501, 64502]
# 64501 and 64502 have NO ASPA records -> Unknown
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
option=update:value=send-route:prefix=10.0.1.0/24:origin-as=64502:next-hop=10.0.0.1:as-path=64500,64501,64502
# EOR from ze
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# Python observer: verify route is NOT in adj-rib-in (rejected by ASPA unknown policy)
tmpfs=rpki-aspa-policy-unknown-reject-test.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
import json
import sys
from ze_api import API, result_text_data
# // test-relax: removed unused 'import time'; blind lead-in/mid sleeps deleted (rpki event loop is the barrier)

def dispatch(api, command):
    resp = api._call_engine(
        'ze-plugin-engine:dispatch-command', {'command': command})
    if resp is None:
        return {'status': 'error', 'data': 'engine call returned None'}
    return resp.get('result', {})

def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()

    api.subscribe(['rpki direction received'])
    api.ready()

    # // test-relax: deleted blind sleep(5.0); the event read loop below polls up to ~15s for the unknown event
    try:
        # Wait for ASPA event confirming Unknown state
        found_event = False
        for _ in range(30):
            event_str = api.read_line(timeout=0.5)
            if event_str is None:
                continue
            try:
                evt = json.loads(event_str)
            except (json.JSONDecodeError, TypeError):
                continue
            bgp = evt.get('bgp', {})
            msg = bgp.get('message', {})
            if msg.get('type') != 'rpki':
                continue
            rpki = bgp.get('rpki', {})
            if not isinstance(rpki, dict):
                continue
            if rpki.get('status') == 'unavailable':
                continue
            aspa_state = rpki.get('aspa-state')
            if aspa_state == 'unknown':
                found_event = True
                print('OK: rpki event has aspa-state=unknown', file=sys.stderr)
                break

        if not found_event:
            print('FAIL: no rpki event with aspa-state=unknown', file=sys.stderr)
            sys.exit(1)

        # Query adj-rib-in: route should be rejected. The confirmed rpki unknown event above
        # is the inbound barrier -- validation ran and the reject dropped the route before it
        # reached adj-rib-in, so its absence is stable here.
        # // test-relax: deleted blind sleep(1.0); the confirmed rpki unknown event is the barrier
        result = dispatch(api, 'show bgp rib received')
        if result.get('status') != 'done':
            print(f'FAIL: rib routes received status={result.get("status")}', file=sys.stderr)
            sys.exit(1)

        data = result_text_data(result)
        if '10.0.1.0/24' in data:
            print(f'FAIL: route 10.0.1.0/24 should have been rejected by ASPA unknown policy: {data}', file=sys.stderr)
            sys.exit(1)

        print('OK: route 10.0.1.0/24 correctly rejected by ASPA unknown-action=reject', file=sys.stderr)
    finally:
        dispatch(api, 'request shutdown')
        api.wait_for_shutdown()

if __name__ == '__main__':
    main()
EOF_RUN

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	hub {
		server local {
			ip 127.0.0.1;
			port 0;
			secret rpki-test-secret-key-01234567890;
		}
	}
	external rpki-aspa-policy-unknown-reject-test {
		run ./rpki-aspa-policy-unknown-reject-test.run
		encoder json
	}
	internal rpki {
		use bgp-rpki
	}
	internal adj-rib-in {
		use bgp-adj-rib-in
	}
}

bgp {
	rpki {
		cache-server 127.0.0.1 {
			port $PORT2
		}
		aspa {
			validation true;
			action {
				unknown reject;
			}
		}
	}
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 64500
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}

		process rpki-aspa-policy-unknown-reject-test {
		}
		process rpki {
			receive [ update ]
		}
		process adj-rib-in {
			receive [ update state ]
		}
	}
}
EOF_CONF

# RTR mock: VRP covers route (ROA Valid), NO ASPA records for 64501 or 64502 -> Unknown
cmd=background:seq=1:exec=ze-test rtr-mock --port $PORT2 --vrp 10.0.0.0/8,24,64502
cmd=background:seq=2:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=3:exec=ze -:stdin=ze-bgp:timeout=25s
expect=exit:code=0
