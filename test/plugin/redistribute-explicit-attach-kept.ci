# Test: redistribute-explicit-attach-kept -- an operator's explicit narrowed bus
#       filter on the Loc-RIB survives a `redistribute` rule importing BGP
#       without being widened back to every declared message, and the daemon
#       reports the declared events the narrower filter omits.
#
# VALIDATES: spec-fixit-redistribution-chain-drops-silently AC-4 and bus S4/S8
# at the process boundary. The config combines `redistribute { destination
# fakedest { import bgp } }` with an explicit `bus` filter on `bgp-rib` that
# permits the required redistribution feed (`bgp:update`, `bgp:state`,
# `bgp:refresh`) while omitting `bgp:eor` and `bgp:negotiated` and blocking
# `bgp:update`/`bgp:refresh` sends toward `peer1`. Three things must hold:
#
#   1. the operator's narrowed receive filter is in force: the Loc-RIB counts
#      the peer as up (`show bgp rib status`)
#   2. `show event delivery` reports exactly one `bgp-rib` edge carrying only
#      `refresh`, `state`, and `update`, with no `send` grants (so redistribution
#      neither widened `receive` back to `eor`/`negotiated` nor added `send`)
#   3. the daemon reports that the filter is narrower than what the Loc-RIB
#      declared (`reconcileDelivery` reasonUngranted naming `peer=127.0.0.1`,
#      `process=bgp-rib`, and omitted declared events such as `eor`/`negotiated`)
#
# PREVENTS: redistribution silently widening an explicit bus filter back to
# every declared message or duplicating the `bgp-rib` delivery edge.

# ze-peer expectations
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=25s
# Hold the session open: a closed peer is a session-down event, which takes the
# peer out of the Loc-RIB's count the observer is reading.
option=linger:value=true
option=asn:value=65001
option=update:value=send-route:prefix=10.0.0.0/24:next-hop=10.0.0.1
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# ze configuration
stdin=ze-bgp:terminator=EOF_CONF
bus {
	endpoint bgp-rib {
		internal bgp-rib;
		receive {
			allow [ bgp:update bgp:state bgp:refresh ];
			from [ /bgp/peer/peer1 ];
		}
		send {
			message bgp:update {
				to none;
			}
			message bgp:refresh {
				to none;
			}
		}
	}
	endpoint redist-explicit-attach-test {
		external {
			run "le test fixture plugin/redistribute-explicit-source-grant";
		}
		encoding json;
	}
	# Declares the fakedest destination the rule names. Nothing here registers a
	# consumer: the assertion is about the Loc-RIB's bus filter, not delivery.
	endpoint fakeredist {
		internal fakeredist;
	}
}

policy {
	match redistribute-fakedest-bgp {
		family [ ipv4/unicast ];
	}
}
redistribute {
	destination fakedest {
		import bgp {
			filters [ redistribute-fakedest-bgp ];
			final accept;
		}
	}
}

bgp {
	# RFC 8212: an EBGP direction with no policy is refused; this test exchanges routes.
	filter {
		import { final accept; }
		export { final accept; }
	}
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 10.0.0.1
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=25s
expect=stderr:pattern=OK: the operator's state grant brought the peer up in the Loc-RIB
expect=stderr:contains=EXPLICIT-SOURCE-GRANT: bindings=1 receive=[refresh state update] send=[] implicit=[] unresolved=[]
# The daemon's report for the types the operator's narrower bus filter omitted.
# The pattern pins the peer and the process, so another plugin's line cannot satisfy it.
expect=stderr:pattern=the plugin declared an event the peer does not grant it.*peer=127.0.0.1.*process=bgp-rib.*declared=[^ ]*(eor|negotiated)
expect=exit:code=0
