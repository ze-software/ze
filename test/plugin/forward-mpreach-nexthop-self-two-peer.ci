# Test: forward-mpreach-nexthop-self-two-peer -- a redistributed route fans out to
# two peers, each receiving it in an MP_REACH_NLRI attribute with a distinct,
# per-session next-hop (next-hop-self on the wire, not just RIB state).
# VALIDATES: peer1 (ze local 127.0.0.4) and peer2 (ze local 127.0.0.5) each observe
#            the 224.1.1.0/24 UPDATE carried in MP_REACH with the next-hop resolved
#            to ze's own address on THAT session (7f000004 vs 7f000005 on the wire).
# PREVENTS:  an MP_REACH next-hop-self regression where every peer gets the same
#            next-hop regardless of its session, or the route is only in the RIB
#            and never re-encoded onto the wire.
#
# // RFC-correct coverage replacement (spec-fixit-redistribute-establishment-stall
# F4, class A1). The committed IPv6 config asked ze to put an IPv4 next-hop in an
# IPv6 MP_REACH; RFC 8950 (rfc/short/rfc8950.md) defines only the REVERSE (IPv4 NLRI
# with an IPv6 next hop), so that combination is not a valid extended-next-hop tuple
# and ze correctly refused to emit it (Peer.resolveNextHop -> ErrNextHopIncompatible,
# reactor/peer.go). The committed expectation therefore never matched, and only the
# vacuous no-listen peer block hid it. ipv4/multicast is an MP family (RFC 4760) that
# legitimately carries a 4-byte IPv4 next-hop, so it exercises the SAME per-session
# MP_REACH next-hop-self path with the two IPv4 loopbacks the harness already provides
# (a native-IPv6 two-peer variant would need a second bindable IPv6 loopback the
# darwin/no-root harness cannot supply). The wire hex below is captured from ze.

# ze-peer 1 (127.0.0.1): the per-session MP_REACH next-hop is 7f000004, ze's own
# address on this session and never the peer's own (RFC 4271 Section 5.1.3).
stdin=peer1:terminator=EOF_PEER1
option=tcp_connections:value=1
option=timeout:value=15s
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0035020000001E4001010240020040050400000064800E0D000102047F0000040018E00101
expect=json:conn=1:seq=1:json={"meta":{"version":"1.0.0","format":"ze-bgp"},"message":{"type":"update"},"peer":{"address":"127.0.0.1","remote":{"as":65533}},"direction":"in","origin":"incomplete","local-preference":100,"ipv4/multicast":[{"action":"add","nlri":["224.1.1.0/24"],"next-hop":"127.0.0.4"}]}
EOF_PEER1

# ze-peer 2 (127.0.0.2): the per-session MP_REACH next-hop is 7f000005 (distinct).
# Both peers are in AS 65533 and ze-peer's default OPEN mirrors ze's router-id with the
# last octet incremented, so without an explicit identifier BOTH would present 1.2.3.5 --
# two distinct routers of one AS sharing a BGP Identifier, which ze rejects by default
# (RFC 6286 Section 2.1). They model two separate neighbours, so give this one its own.
stdin=peer2:terminator=EOF_PEER2
option=tcp_connections:value=1
option=timeout:value=15s
option=open:value=router-id:id=1.2.3.6
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0035020000001E4001010240020040050400000064800E0D000102047F0000050018E00101
expect=json:conn=1:seq=1:json={"meta":{"version":"1.0.0","format":"ze-bgp"},"message":{"type":"update"},"peer":{"address":"127.0.0.2","remote":{"as":65533}},"direction":"in","origin":"incomplete","local-preference":100,"ipv4/multicast":[{"action":"add","nlri":["224.1.1.0/24"],"next-hop":"127.0.0.5"}]}
EOF_PEER2

# Python observer: wait for all plugins ready, drive fakel2tp emit, shut down.
# It stays dispatch-silent before the emit (event-wait windows only, no polling),
# so it never touches the peers during the connect/establish window.
tmpfs=mpreach-nexthop-test.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
from ze_api import API, runtime_fail


def dispatch(api, command):
    return api._call_engine('ze-plugin-engine:dispatch-command', {'command': command}) or {}


def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()

    if not api.wait_for_post_startup(timeout=10.0):
        runtime_fail('post-startup callback never received')
        return

    # Let both sessions establish (subscribed-event windows, no dispatch traffic).
    for _ in range(10):
        api.wait_for_event(timeout=0.2)

    resp = dispatch(api, 'request fakel2tp emit add ipv4/multicast 224.1.1.0/24')
    result = resp.get('result', {})
    if result.get('status') != 'done':
        runtime_fail(f'request fakel2tp emit failed: {result}')
        return

    # Bounded delivery window; the per-peer wire expectations gate the content.
    for _ in range(15):
        api.wait_for_event(timeout=0.2)

    dispatch(api, 'request shutdown')
    api.wait_for_shutdown()


if __name__ == '__main__':
    main()
EOF_RUN

# ze configuration: two peers with distinct local addresses, ipv4/multicast family
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external mpreach-nexthop-test {
		run ./mpreach-nexthop-test.run
		encoder json
	}
	internal redistribute-orchestrator {
		use redistribute-orchestrator
	}
	internal fakel2tp {
		use fakel2tp
	}
}

redistribute {
	destination bgp {
		import l2tp {
			family [ ipv4/multicast ];
		}
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			# Ze's own address on this session, and what next-hop-self puts in
			# MP_REACH. Deliberately NOT the peer's 127.0.0.1: RFC 4271 Section
			# 5.1.3 forbids a peer's own address as NEXT_HOP.
			local {
				ip 127.0.0.4
				accept false
			}
		}
		session {
			asn {
				local 65533
				remote 65533
			}
			router-id 1.2.3.4
			family {
				ipv4/multicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		attach process redistribute-orchestrator {
			send [ update ]
		}
	}

	peer peer2 {
		connection {
			remote {
				ip 127.0.0.2
			}
			# Ze's own address on this session, and what next-hop-self puts in
			# MP_REACH. Deliberately NOT the peer's 127.0.0.2: RFC 4271 Section
			# 5.1.3 forbids a peer's own address as NEXT_HOP.
			local {
				ip 127.0.0.5
				accept false
			}
		}
		session {
			asn {
				local 65533
				remote 65533
			}
			router-id 1.2.3.4
			family {
				ipv4/multicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		attach process redistribute-orchestrator {
			send [ update ]
		}
	}
}
EOF_CONF

# Process orchestration: two ze-peer instances on different loopback addresses.
# No expect=exit:code=0 -- the per-peer wire hex expectations govern the verdict.
# (These are check-mode peers, so F1 runs the peer-exchange check and validateJSON
# regardless of any exit-code assertion, runner_exec.go:1196-1226; the directive is
# simply omitted per the F4 recipe as noise, not to avoid a mask F1 already removed.)
cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer1
cmd=background:seq=2:exec=ze-peer --bind 127.0.0.2 --port $PORT:stdin=peer2
cmd=foreground:seq=3:exec=ze -:stdin=ze-bgp:timeout=20s
reject=stderr:pattern=panic recovered
reject=stderr:pattern=fatal error
reject=stderr:pattern=ZE-OBSERVER-FAIL
