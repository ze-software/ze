# Test: an unknown SSH exec command is reported as not understood.
# VALIDATES: a typo produces a non-zero result with an operator message and no frame leakage.
# PREVENTS: confusing command-resolution failure with a command that ran and failed.

cmd=foreground:seq=1:exec=ze-test fixture plugin/answer-unknown-command:timeout=25s
expect=exit:code=0
expect=stderr:contains=OK: the typo was reported as an unknown command
expect=stderr:contains=OK: a command that exists is not reported as unknown
