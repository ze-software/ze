# Test: bgp-redistribute -- accepted add event from fakeredist becomes a BGP UPDATE.
# VALIDATES: AC-2 -- batch with `add` action and matching import rule produces an
#            UPDATE on the wire whose attributes / NLRI match the canonical
#            `update text origin incomplete nhop self nlri ipv4/unicast add 10.0.0.1/32` shape.
# VALIDATES: auto-load via ConfigRoots -- this scenario deliberately omits an
#            explicit `internal redistribute-orchestrator { use redistribute-orchestrator }`
#            block, so the only way the orchestrator runs is via the auto-load
#            triggered by the `redistribute {}` config root.
# PREVENTS: redistribute-orchestrator not wired to consumers, or fakeredist event
#           not reaching the consumer, or auto-load regression silently dropping
#           the orchestrator.

# ze-peer expectations
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
# UPDATE for 10.0.0.1/32 with NEXT_HOP=127.0.0.4 (ze's OWN address on this
# session, which is what `nhop self` resolves to -- not the peer's 127.0.0.1).
# The wire expectation is what makes ze-peer bind and check: ORIGIN incomplete,
# empty AS_PATH (iBGP), NEXT_HOP 127.0.0.4, LOCAL_PREF 100, NLRI 10.0.0.1/32.
# LOCAL_PREF is well-known mandatory on an iBGP session (RFC 4271 5.1.5); the
# reactor emits it at reactor_api_batch.go buildWireModeUpdate.
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00310200000015400101024002004003047F00000440050400000064200A000001
expect=json:conn=1:seq=1:json={"meta":{"version":"1.0.0","format":"ze-bgp"},"message":{"type":"update"},"peer":{"address":"127.0.0.1","remote":{"as":65533}},"direction":"in","origin":"incomplete","local-preference":100,"ipv4/unicast":[{"action":"add","nlri":["10.0.0.1/32"],"next-hop":"127.0.0.4"}]}
EOF_PEER

# Python observer plugin: drive `fakeredist emit add` via dispatch-command, then exit.
tmpfs=announce-test.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
import time
from ze_api import API, runtime_fail

# Both sleeps are converted. The claim that blocked this -- "redistribute
# UPDATEs bypass the updates-sent counter via the forward-pool send path" -- is
# false: writeRawUpdateBody (reactor/session_write.go), the forward-pool raw-body
# write invoked from fwdBatchHandler (reactor/forward_pool.go), calls
# onMessageReceived(..., rpc.DirectionSent, ...), which reaches
# peer.IncrUpdatesSent() (reactor/reactor_notify.go) on the sent branch for
# TypeUPDATE. So the counter DOES see a redistribute UPDATE, and this test now
# gates on it. The other half of that comment was right and still is: quiesce
# blocks ~10s on the forward-pool quiescer, which is why the two ABSENCE tests
# in this family (filtered-out, metrics) cannot use it inside a 15s budget.


def dispatch(api, command):
    return api._call_engine('ze-plugin-engine:dispatch-command', {'command': command}) or {}


def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()

    # Wait for BGP session up so the UPDATE has a destination peer.
    # Baseline AFTER the initial-sync EOR settles: the EOR counts into
    # updates-sent, so a threshold taken before it would be met by
    # establishment alone rather than by the redistribute UPDATE.
    if not api.wait_peer_eor_sent():
        runtime_fail('initial-sync EOR never reached the wire')
        return
    base = api.peer_counter('updates-sent')

    resp = dispatch(api, 'request fakeredist emit add ipv4/unicast 10.0.0.1/32')
    result = resp.get('result', {})
    if result.get('status') != 'done':
        runtime_fail(f'request fakeredist emit failed: {result}')
        return

    # Wait for the redistribute UPDATE to be COUNTED as sent, rather than
    # holding a blind 2s and hoping. writeRawUpdateBody increments this counter
    # after the body reaches the session, and TCP FIFO then delivers it ahead of
    # the shutdown below.
    if not api.wait_peer_counter('updates-sent', base + 1):
        runtime_fail('redistribute UPDATE never counted as sent')
        return
    dispatch(api, 'request shutdown')
    api.wait_for_shutdown()


if __name__ == '__main__':
    main()
EOF_RUN

# ze configuration
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external announce-test {
		run ./announce-test.run
		encoder json
	}
	# redistribute-orchestrator is intentionally NOT listed here. The
	# `redistribute {}` block below carries `ConfigRoots: ["redistribute"]`,
	# which auto-loads the orchestrator. This validates the auto-load
	# wiring -- if the orchestrator fails to start, no UPDATE reaches the peer
	# and the test times out.
	internal fakeredist {
		use fakeredist
	}
}

redistribute {
	destination bgp {
		import fakeredist {
			family [ ipv4/unicast ];
		}
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			# Ze's own address on this session, and what `nhop self` puts on the
			# wire. Deliberately NOT the peer's 127.0.0.1: RFC 4271 Section 5.1.3
			# forbids advertising a peer an address of that peer as NEXT_HOP.
			local {
				ip 127.0.0.4
				accept false
			}
		}
		session {
			asn {
				local 65533
				remote 65533
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		attach process redistribute-orchestrator {
			send [ update ]
		}
	}
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
# // expect=exit:code=0 removed -- this STRENGTHENS the test. Coverage
# is replaced by the ze-peer wire expectation above, which now governs the verdict.
# The exit-code line asserted nothing about BGP and, until 2026-07-16, actively
# disabled the peer check and validateJSON (spec-fixit-redistribute-establishment-stall, D2).
