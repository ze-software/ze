# Test: failed SSH authentication is visible through show audit
# VALIDATES: AC-16 -- failed authentication attempts emit auth-fail audit entries.
# PREVENTS: SSH login failures being visible only in logs.

option=timeout:value=25s

tmpfs=test-audit-auth-fail.sh:mode=755:terminator=EOF_SH
#!/bin/sh
set -e

cat > audit-auth-fail.conf << 'ZECONF'
system {
	authentication {
		user admin {
			password "$2a$04$UlwuiuH82Unfsq.XEMPGJeDkXwbm3KW.nvVaVXOd/JeFK8VjMjrQO"
		}
	}
}

environment {
	ssh {
		enabled true
		server main {
			ip 127.0.0.1;
			port 0;
		}
	}
}
ZECONF

ze start audit-auth-fail.conf 2>daemon.log &
DAEMON_PID=$!
trap 'kill $DAEMON_PID 2>/dev/null || true; wait $DAEMON_PID 2>/dev/null || true' EXIT

SSH_PORT=""
for i in $(seq 1 50); do
	SSH_PORT=$(grep -o '127\.0\.0\.1:[0-9]*' daemon.log 2>/dev/null | head -1 | cut -d: -f2 || true)
	if [ -n "$SSH_PORT" ]; then
		break
	fi
	sleep 0.2
done

if [ -z "$SSH_PORT" ]; then
	echo "FAIL: SSH server did not start" >&2
	cat daemon.log >&2
	exit 1
fi

ADMIN_DIR=$(mktemp -d)
trap 'rm -rf "$ADMIN_DIR"; kill $DAEMON_PID 2>/dev/null || true; wait $DAEMON_PID 2>/dev/null || true' EXIT
printf 'admin\ntestpass\n127.0.0.1\n%s\n' "$SSH_PORT" | ZE_CONFIG_DIR="$ADMIN_DIR" ze init >/dev/null

if ZE_CONFIG_DIR="$ADMIN_DIR" ZE_SSH_PASSWORD="wrongpass" ze cli -c "show bgp" >/dev/null 2>&1; then
	echo "FAIL: wrong SSH password succeeded" >&2
	exit 1
fi
echo "OK: wrong SSH password denied" >&2

OUTPUT=$(ZE_CONFIG_DIR="$ADMIN_DIR" ZE_SSH_PASSWORD="testpass" ze cli -c "show audit action auth-fail" 2>&1) || {
	echo "FAIL: show audit failed" >&2
	echo "$OUTPUT" >&2
	exit 1
}

case "$OUTPUT" in
	*auth-fail*admin*) echo "OK: show audit includes auth-fail for admin" >&2 ;;
	*admin*auth-fail*) echo "OK: show audit includes auth-fail for admin" >&2 ;;
	*)
		echo "FAIL: show audit missing auth-fail/admin" >&2
		echo "$OUTPUT" >&2
		exit 1
		;;
esac

kill $DAEMON_PID 2>/dev/null || true
wait $DAEMON_PID || true
echo "OK: daemon stopped" >&2
exit 0
EOF_SH

cmd=foreground:seq=1:exec=./test-audit-auth-fail.sh:timeout=25s
expect=exit:code=0
