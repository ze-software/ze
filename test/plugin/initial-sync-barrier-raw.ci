# Test: a raw-injected route and the independent initial-sync End-of-RIB both
# reach the peer, without imposing an order between them.
#
# VALIDATES: RFC 4724 Section 4 -- "The End-of-RIB marker MUST be sent by a BGP
# speaker to its peer once it completes the initial routing update (including
# the case when there is no update to send) for an address family after the BGP
# session is established."
#
# The marker follows ze's own table, without waiting for plugin session ready
# (docs/architecture/api/architecture.md, API Sync Protocol). The observer
# captures the original peer-UP initial-replay token before injection, not on
# EOR, so its raw write can race the independent marker. Session.SendRawMessage
# serializes that write with sendInitialRoutes through writeMu; raw messages do
# not enter opQueue. Completion reports the same captured token.
#
# PREVENTS: losing the raw route or the initial-sync marker when injection
# starts at establishment. The peer MUST remain connected until the observer
# has seen eor-sent, even when its own wire expectations finish first.
#
# NON-VACUITY: only `send [ raw ]` is granted. Removing that grant refuses the
# raw command; dropping its bytes fails the exact route expectation. Dropping
# the initial-sync marker fails the EOR expectation and the observer's counter
# barrier. Both expectations share a sequence so either arrival order is valid.

# ze-peer expectations
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=20s
option=linger:value=true
# seq=1 is an unordered pair: the raw route and ze's initial-sync EOR.
# ORIGIN=IGP, AS_PATH empty (iBGP, both sides 65000), NEXT_HOP=10.0.1.254,
# LOCAL_PREF=200, NLRI 10.0.1.0/24. Neither frame may substitute for the other.
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00300200000015400101004002004003040A0001FE400504000000C8180A0001
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# ze bgp configuration
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external raw-injector {
		run "le test fixture plugin/initial-sync-barrier-raw"
		encoder json
	}
}
bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65000
			}
			router-id 10.0.0.1
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
		}
		behavior {
			group-updates disable
		}

		attach process raw-injector {
			send [ raw ]
			# Keep the session-ready reporter's state grant, but do not use its
			# ready signal as an EOR-order assertion: the marker is independent.
			receive [ state ]
		}
	}
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
reject=stderr:pattern=panic recovered
reject=stderr:pattern=ZE-OBSERVER-FAIL
