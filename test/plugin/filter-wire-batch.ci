CONFIG
cmd=foreground:seq=1:exec=ze -:stdin=config:timeout=35s
expect=exit:code=0
expect=stderr:contains=WIRE malformed 64-route batch
expect=stderr:contains=WIRE OK bounded batches=
expect=stderr:contains=failed batch absent; next batch intact
expect=stderr:contains=OK: batch ordered sets
