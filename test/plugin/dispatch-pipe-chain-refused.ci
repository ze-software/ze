# Test: a forked plugin's dispatch-command that carries a pipe chain is refused
# VALIDATES: AC-1, AC-1b and AC-6 of spec-plugin-dispatch-pipe-chain-reaches-the-handler,
#   end to end: a forked plugin over TLS connect-back, against a running daemon
#   whose adj-rib-in holds five received routes, dispatches
#   `show bgp rib received | count` and must receive a refusal whose fix line is
#   exactly the folded form `show bgp rib received count`; that fix line must
#   then count 5. `show system platform | json` (a format, which never folds)
#   must be refused with the command part and the `ze cli -c` form of the line.
# PREVENTS: the dispatcher handing the pipe token and the operator to the handler
#   as arguments, so the plugin reads an unfiltered or refused-as-argument answer.
#
# The one question: does the refusal reach a plugin in another process, through
# the real engine, and is the line it names a line the daemon answers? A unit
# test holds the dispatcher in process with a test command and no RIB, so it
# cannot show that the folded line the refusal names is the one the RIB's own
# registered pipe filters produce, nor that it answers over the socket.
#
# The fixture (plugin/dispatch-pipe-chain-refused, internal/test/fixture
# plugin_fixture_16.go plugin16DispatchPipeChainRefused) returns an error, and
# so a non-zero exit, on every assertion it makes.
#
# Routes are injected by ze-peer (option=update:value=send-route), as in
# test-pipe-first-last.ci, which this file is modelled on. The fixture polls
# the folded count to 5 before any assertion, so the RIB is populated first.
# iBGP (local asn 1 == remote asn 1), so the routes carry an empty AS_PATH.
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=20s
# A check-mode peer closes as soon as its expectations are met, and a peer-down
# with graceful-restart disabled deletes the peer's Adj-RIB-In, so every
# `show bgp rib received` below would read an empty table. linger holds the
# session open until teardown.
option=linger:value=true
option=update:value=send-route:prefix=10.1.0.0/24:next-hop=10.0.0.1
option=update:value=send-route:prefix=10.2.0.0/24:next-hop=10.0.0.1
option=update:value=send-route:prefix=10.3.0.0/24:next-hop=10.0.0.1
option=update:value=send-route:prefix=10.4.0.0/24:next-hop=10.0.0.1
option=update:value=send-route:prefix=10.5.0.0/24:next-hop=10.0.0.1
# ze has nothing to announce, so the one message it owes the peer is its
# End-of-RIB for ipv4/unicast: an UPDATE with no withdrawn routes and no path
# attributes (RFC 4724 section 2), length 23 = 19 + 2 + 2.
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER


# ze bgp configuration
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external dispatch-pipe-chain-refused-test {
		run "le test fixture plugin/dispatch-pipe-chain-refused"
		encoder json
	}
	internal bgp-rib {
		use bgp-rib
	}
	internal adj-rib-in {
		use bgp-adj-rib-in
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}

		attach process bgp-rib {
			receive [ update state refresh ]
			send [ update ]
		}
		attach process adj-rib-in {
			receive [ update-received state ]
		}
	}
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
