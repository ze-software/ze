# Test: redistribute-as112-withdraw -- `emit del` retracts the covering prefixes.
# After an add announces the two v4 covering prefixes (origin igp, AS_PATH [112]),
# a del produces WITHDRAWN_ROUTES for each, mirroring redistribute-l2tp-withdraw.
#
# VALIDATES: RouteAction remove on the as112 source -> BGP WITHDRAWN_ROUTES for
#            each covering prefix; the add path (AS_PATH [112]) still holds.
# PREVENTS: the withdraw path missing or building the wrong NLRI for as112 routes.

# ze-peer -- iBGP session. Two add contains= rules (AS_PATH [112] + NEXT_HOP +
# LOCAL_PREF + NLRI) and two withdraw contains= rules (WITHDRAWN len 4 + NLRI +
# empty path-attr) -- matching all four completes the peer so the JSON validator
# runs over both the add and the del UPDATEs.
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
expect=bgp:conn=1:seq=1:contains=4002060201000000704003047F0000024005040000006418C0AF30
expect=bgp:conn=1:seq=1:contains=4002060201000000704003047F0000024005040000006418C01FC4
expect=bgp:conn=1:seq=2:contains=000418C0AF300000
expect=bgp:conn=1:seq=2:contains=000418C01FC40000
expect=json:conn=1:seq=1:json={"meta":{"version":"1.0.0","format":"ze-bgp"},"message":{"type":"update"},"origin":"igp","as-path":[112],"local-preference":100,"ipv4/unicast":[{"action":"add","nlri":["192.175.48.0/24"],"next-hop":"127.0.0.2"}]}
expect=json:conn=1:seq=3:json={"meta":{"version":"1.0.0","format":"ze-bgp"},"message":{"type":"update"},"ipv4/unicast":[{"action":"del","nlri":["192.175.48.0/24"]}]}
expect=json:conn=1:seq=4:json={"meta":{"version":"1.0.0","format":"ze-bgp"},"message":{"type":"update"},"ipv4/unicast":[{"action":"del","nlri":["192.31.196.0/24"]}]}
EOF_PEER

# Python observer plugin: emit add, then emit del. Synchronization is
# deterministic: poll `show bgp peer peer1 detail` (state / eor-sent /
# updates-sent counters) with wait_for_event as backoff -- no fixed sleeps.
# TCP FIFO ordering means once the engine counts an UPDATE as sent, the peer
# reads it before any later shutdown NOTIFICATION.
tmpfs=as112-withdraw-test.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
from ze_api import API, runtime_fail, result_json_data


def dispatch(api, command):
    return api._call_engine('ze-plugin-engine:dispatch-command', {'command': command}) or {}


def peer_field(api, field, default):
    result = dispatch(api, 'show bgp peer peer1 detail').get('result', {})
    if result.get('status') != 'done':
        return default
    data = result_json_data(result, {})
    return data.get('peers', {}).get('127.0.0.1', {}).get(field, default)


def wait_peer(api, predicate, what, cycles=100):
    for _ in range(cycles):
        if predicate():
            return
        api.wait_for_event(timeout=0.2)
    runtime_fail(f'timeout waiting for {what}')


def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()

    # Session up and initial sync done (EOR counts into updates-sent, so
    # baseline the counter only after eor-sent settles).
    wait_peer(api, lambda: peer_field(api, 'state', '') == 'established',
              'peer1 established')
    wait_peer(api, lambda: peer_field(api, 'eor-sent', 0) >= 1,
              'initial EOR sent')
    base = peer_field(api, 'updates-sent', 0)

    for step, cmd in enumerate((
        'request fakeas112 emit add asn 112',
        'request fakeas112 emit del asn 112',
    ), start=1):
        resp = dispatch(api, cmd)
        result = resp.get('result', {})
        if result.get('status') != 'done':
            runtime_fail(f'{cmd}: {result}')
            return
        wait_peer(api,
                  lambda step=step: peer_field(api, 'updates-sent', 0) >= base + step,
                  f'UPDATE {step} on the wire')

    dispatch(api, 'request shutdown')
    api.wait_for_shutdown()


if __name__ == '__main__':
    main()
EOF_RUN

# ze configuration
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external as112-withdraw-test {
		run ./as112-withdraw-test.run
		encoder json
	}
	internal redistribute-orchestrator {
		use redistribute-orchestrator
	}
	internal fakeas112 {
		use fakeas112
	}
}

redistribute {
	destination bgp {
		import as112 {
			family [ ipv4/unicast ];
		}
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			# Ze's own address on this session, and what `nhop self` puts on the
			# wire. It is deliberately NOT peer1's 127.0.0.1: RFC 4271 Section
			# 5.1.3 forbids a peer its own address as NEXT_HOP, and
			# originatedNextHopIsPeerOwn (reactor/forward_next_hop.go) withholds
			# the route when the two match.
			local {
				ip 127.0.0.2
				accept false
			}
		}
		session {
			asn {
				local 65533
				remote 65533
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		attach process redistribute-orchestrator {
			send [ update ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
reject=stderr:pattern=panic recovered
reject=stderr:pattern=fatal error
