# Test: redistribute-as112-withdraw -- `emit del` retracts the covering prefixes.
# After an add announces the two v4 covering prefixes (origin igp, AS_PATH [112]),
# a del produces WITHDRAWN_ROUTES for each, mirroring redistribute-l2tp-withdraw.
#
# VALIDATES: RouteAction remove on the as112 source -> BGP WITHDRAWN_ROUTES for
#            each covering prefix; the add path (AS_PATH [112]) still holds.
# PREVENTS: the withdraw path missing or building the wrong NLRI for as112 routes.

# ze-peer -- iBGP session. Two add contains= rules (AS_PATH [112] + NEXT_HOP +
# LOCAL_PREF + NLRI) and two withdraw contains= rules (WITHDRAWN len 4 + NLRI +
# empty path-attr) -- matching all four completes the peer so the JSON validator
# runs over both the add and the del UPDATEs.
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
expect=bgp:conn=1:seq=1:contains=4002060201000000704003047F0000024005040000006418C0AF30
expect=bgp:conn=1:seq=1:contains=4002060201000000704003047F0000024005040000006418C01FC4
expect=bgp:conn=1:seq=2:contains=000418C0AF300000
expect=bgp:conn=1:seq=2:contains=000418C01FC40000
expect=json:conn=1:seq=1:json={"meta":{"version":"1.0.0","format":"ze-bgp"},"message":{"type":"update"},"origin":"igp","as-path":[112],"local-preference":100,"ipv4/unicast":[{"action":"add","nlri":["192.175.48.0/24"],"next-hop":"127.0.0.2"}]}
expect=json:conn=1:seq=3:json={"meta":{"version":"1.0.0","format":"ze-bgp"},"message":{"type":"update"},"ipv4/unicast":[{"action":"del","nlri":["192.175.48.0/24"]}]}
expect=json:conn=1:seq=4:json={"meta":{"version":"1.0.0","format":"ze-bgp"},"message":{"type":"update"},"ipv4/unicast":[{"action":"del","nlri":["192.31.196.0/24"]}]}
EOF_PEER

# ze configuration
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external as112-withdraw-test {
		run "ze-test fixture plugin/redistribute-as112-withdraw"
		encoder json
	}
	internal redistribute-orchestrator {
		use redistribute-orchestrator
	}
	internal fakeas112 {
		use fakeas112
	}
}

redistribute {
	destination bgp {
		import as112 {
			family [ ipv4/unicast ];
		}
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			# Ze's own address on this session, and what `nhop self` puts on the
			# wire. It is deliberately NOT peer1's 127.0.0.1: RFC 4271 Section
			# 5.1.3 forbids a peer its own address as NEXT_HOP, and
			# originatedNextHopIsPeerOwn (reactor/forward_next_hop.go) withholds
			# the route when the two match.
			local {
				ip 127.0.0.2
				accept false
			}
		}
		session {
			asn {
				local 65533
				remote 65533
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		attach process redistribute-orchestrator {
			send [ update ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
reject=stderr:pattern=panic recovered
reject=stderr:pattern=fatal error
