# Test: subsystem-list returns real plugin data (not hardcoded ["bgp"])
# Exercises: dispatch-command -> ze-system:subsystem-list -> handleSystemSubsystemList
# Verifies AC-9: returns JSON array with name, stage, running, command-count per plugin
#
# command-count is asserted by VALUE, not by presence. It read 0 for every plugin
# from 2026-03-27 to 2026-08-18 because Process kept a registeredCommands mirror
# that the YANG RPC migration stopped feeding, and a presence-only check passed
# throughout. This plugin declares two commands and requires its own row to say 2.

# ze-peer: accepts connection
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
option=asn:value=65001
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# Native observer fixture: plugin/subsystem-list.

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external subsystem-list-test {
		run "ze-test fixture plugin/subsystem-list"
		encoder json
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast {
					prefix {
						maximum 10000
					}
				}
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
