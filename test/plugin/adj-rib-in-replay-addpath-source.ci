# QUESTION: Does live and replayed forwarding preserve negotiated framing and
# distinguish two sources that chose the same Path Identifier for one prefix?
# A unit test cannot decide live negotiation, stored-route replay and the
# identifiers and framing delivered on the running daemon's peer connections.
#
# Test: adj-rib-in replays a route learned from an ADD-PATH source to BOTH kinds
#       of destination, and each one receives the framing it negotiated.
# VALIDATES: RFC 7911 Section 3 -- "the NLRI encoding MUST be extended by prepending
#            the Path Identifier field, which is of four octets". The stored route
#            carries the identifier beside the bare prefix (rpc.StoredRoute.PathID
#            plus NLRIFraming), buildRelayUpdate rebuilds the SOURCE framing from
#            the pair, and fwdReencodeNLRIs converts per destination.
# PREVENTS: the regression this replaces. RelayStoredRoute refused every route whose
#           SOURCE session negotiated ADD-PATH, and the refusal keyed on the source,
#           so ONE add-path client killed peer-up replay of its routes to EVERY
#           destination -- including the destinations without ADD-PATH that worked
#           before. On a route server, which is the deployment this replay exists
#           for, that is the common case. The batch also returned an error, which
#           costs bgp-rs its delta-convergence loop for the whole peer.
#
# RFC requirement: RFC7911-3-1 positive -- the destination that negotiated ADD-PATH
# receives 00000000180A0000, the four-octet Path Identifier prepended to the
# 10.0.0.0/24 prefix, asserted as exact wire hex on a running daemon (Section 3).
# RFC requirement: RFC7911-3-1 negative -- the destination that negotiated no
# ADD-PATH receives 180A0000, the same prefix with no Path Identifier, from the same
# source UPDATE. One run asserts both framings, so the four octets are shown to
# follow the negotiation rather than the code path (Section 3).
# RFC requirement: RFC7911-2-2 positive -- two sources announce 10.0.0.0/24
# under the same received Path Identifier 1. The ADD-PATH destination receives
# the first source under local identifier 0 on both live forwarding and replay,
# then the second source under distinct local identifier 2, preserving two paths
# instead of replacing the first with the second (Section 2). These exact local
# values belong to this deterministic fixture; numerical inequality between a
# local identifier and the source's identifier is not an RFC requirement.
#
# NON-VACUITY (ai/rules/interop-and-goal-validation.md). Each destination receives
# the route TWICE and each arrival has its own owner:
#   seq=1 -- the LIVE forward, the control. It proves the session, the negotiated
#            capability and the egress transform are real.
#   seq=2 -- the REPLAY, the subject. Nothing else can produce a second copy: no RIB
#            plugin is loaded, so no destination has a local-table delivery path, and
#            adj-rib-in receives `state` for the SOURCE peer only, so its own peer-up
#            self-replay never fires for either destination. The observer's explicit
#            `request bgp adj-rib-in replay` is the sole producer.
# Killing the relay reddens seq=2 at both destinations while seq=1 stays green.
# After both original copies have been sent, the observer releases the fourth
# peer. Its first UPDATE is the same prefix and received identifier from a
# different source. Both destinations must match this distinct-origin third
# frame before their separate done files let the observer stop the daemon.
# The first source lingers throughout, so its path remains advertised when the
# ADD-PATH destination receives the second source's different local identifier.
#
# WHY BOTH DESTINATIONS. They exercise opposite halves of the fix and fail
# differently. 127.0.0.2 shares the source's framing, so a reconstruction that
# omitted the four identifier octets would be parsed by that peer with the prefix
# length read out of the identifier. 127.0.0.3 negotiated no ADD-PATH, so it takes
# the re-encode rail; it is the destination the blanket refusal took down for no
# reason at all, and its bytes are what prove the refusal is gone rather than
# narrowed to something that still fires here.

# ---------------------------------------------------------------------------
# Source peer -- eBGP, AS 65001, on 127.0.0.1, ADD-PATH send/receive.
# ---------------------------------------------------------------------------
stdin=source:terminator=EOF_SOURCE
option=tcp_connections:value=1
option=timeout:value=40s
# The source must outlive both destinations' assertions: if it closes, ze withdraws
# its routes and each destination receives a withdrawal it has no rule for.
option=linger:value=true

# seq=1 -- ze's initial-sync End-of-RIB. The observer holds wait_peer_eor_sent()
# before it injects the seq=2 marker, so this is an ordering assertion, not a race.
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000

# seq=2 -- BARRIER, not an assertion. The observer injects 192.0.2.0/24 to THIS peer
# only, and only once ALL THREE sessions are established. Without it the source's
# announcement below can arrive while a destination is not yet a forward target, and
# that destination then sees the replay alone, so its seq=1 control is lost.
expect=bgp:conn=1:seq=2:contains=18C00002

# seq=3 -- announce 10.0.0.0/24 under RFC 7911 Path Identifier 1.
#   ORIGIN:     40010100            IGP
#   AS_PATH:    40020602010000FDE9  AS_SEQUENCE[65001], 4-byte ASNs
#   NEXT_HOP:   40030401010101      1.1.1.1
#   NLRI:       00000001180A0000    path-id 1, then 10.0.0.0/24
# attr len = 4+9+7 = 20 = 0x14; total = 19+2+2+20+8 = 51 = 0x33.
# The collision source below deliberately uses this SAME received identifier
# for the SAME prefix. Distinct recipient identifiers, rather than numerical
# difference from either source's value, establish the namespace property.
action=send:conn=1:seq=3:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF003302000000144001010040020602010000FDE94003040101010100000001180A0000
EOF_SOURCE

# ---------------------------------------------------------------------------
# Destination A -- eBGP, AS 65002, on 127.0.0.2, ADD-PATH send/receive.
# ---------------------------------------------------------------------------
# Both arrivals carry the SAME bytes: the replay takes the same egress transform the
# live forward takes, which is the one-egress-transform invariant this rail exists
# for. RFC 4271 Section 5.1.2 prepends ze's own AS 65000 (0xFDE8) towards an external
# peer; ORIGIN and NEXT_HOP are relayed verbatim.
#   AS_PATH:    40020A02020000FDE80000FDE9   AS_SEQUENCE[65000, 65001]
#   NLRI:       00000000180A0000             ze's OWN identifier, then 10.0.0.0/24
# The fixture starts the local allocator at 0. The observer's API barrier
# retains identifier 1, so the later collision source receives local 2. Exact
# 0/2 are deterministic fixture expectations; the RFC property is that the two
# advertised source paths remain distinct for this recipient.
# attr len = 4+13+7 = 24 = 0x18; total = 19+2+2+24+8 = 55 = 0x37.
stdin=dest-addpath:terminator=EOF_DEST_AP
option=tcp_connections:value=1
option=timeout:value=40s
option=bind:value=127.0.0.2

# seq=1 CONTROL -- the LIVE forward.
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF003302000000144001010040020602010000FDE94003040101010100000000180A0000
# seq=2 SUBJECT -- the REPLAY, reconstructed from the stored route.
expect=bgp:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF003302000000144001010040020602010000FDE94003040101010100000000180A0000
# seq=3 COLLISION -- AS65004 announced the same prefix and received ID1.
# Its distinct local ID2 keeps the first source's still-advertised ID0 separate.
expect=bgp:conn=1:seq=3:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF003302000000144001010040020602010000FDEC4003040101010100000002180A0000
action=rewrite:conn=1:seq=3:source=addpath-collision-release:dest=addpath-collision-ap-done
EOF_DEST_AP

# ---------------------------------------------------------------------------
# Destination B -- eBGP, AS 65003, on 127.0.0.3, NO ADD-PATH.
# ---------------------------------------------------------------------------
# Same transform, and fwdReencodeNLRIs drops the four identifier octets because this
# session negotiated none.
#   NLRI:       180A0000
# attr len = 24 = 0x18; total = 19+2+2+24+4 = 51 = 0x33.
stdin=dest-plain:terminator=EOF_DEST_PLAIN
option=tcp_connections:value=1
option=timeout:value=40s
option=bind:value=127.0.0.3

# seq=1 CONTROL -- the LIVE forward.
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002F02000000144001010040020602010000FDE940030401010101180A0000
# seq=2 SUBJECT -- the REPLAY. This is the arrival the blanket refusal removed while
# nothing about this session had changed.
expect=bgp:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002F02000000144001010040020602010000FDE940030401010101180A0000
# seq=3 COLLISION -- the same second source reaches the plain destination
# without an identifier, preserving that destination's negotiated framing.
expect=bgp:conn=1:seq=3:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002F02000000144001010040020602010000FDEC40030401010101180A0000
action=rewrite:conn=1:seq=3:source=addpath-collision-release:dest=addpath-collision-plain-done
EOF_DEST_PLAIN

# ---------------------------------------------------------------------------
# Source D -- eBGP, AS65004, 127.0.0.4, ADD-PATH send/receive.
# ---------------------------------------------------------------------------
# The observer releases this source only after both original live/replay sends.
# await-file holds sends after OPEN; the queued EOR below additionally proves
# the daemon's source-D session and rs peer-up barrier have completed.
stdin=source-collision:terminator=EOF_SOURCE_COLLISION
option=tcp_connections:value=1
option=timeout:value=40s
option=bind:value=127.0.0.4
option=linger:value=true
option=await-file:path=addpath-collision-release
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
# Same ID1/prefix/NEXT_HOP as source A, different AS_PATH origin AS65004.
action=send:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF003302000000144001010040020602010000FDEC4003040101010100000001180A0000
EOF_SOURCE_COLLISION

# ---------------------------------------------------------------------------
# Observer: sequences the run and drives both replays.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# ze -- AS65000, four external peers on separate loopbacks, one leased port.
# ---------------------------------------------------------------------------
# No RIB plugin is loaded on purpose: bgp-rib would give each destination a second
# delivery path for the same prefix out of a local table, and seq=2 would stop naming
# the relay. adj-rib-in is given `update-received state` on the SOURCE peer only, so
# it stores that peer's routes and never sees a destination come up.
stdin=ze-bgp:terminator=EOF_CONF
bus {
	endpoint rs {
		internal bgp-rs;
	}
	endpoint bgp-rib {
		internal bgp-rib;
		receive {
			from none;
		}
		send {
			to none;
		}
	}
	endpoint adj-rib-in {
		internal bgp-adj-rib-in;
		receive {
			message bgp:update {
				from [ /bgp/peer/source-peer ];
			}
			message bgp:state {
				from [ /bgp/peer/source-peer ];
			}
		}
	}
	endpoint replay-addpath {
		external {
			run "le test fixture plugin/adj-rib-in-replay-addpath-collision";
		}
		encoding json;
	}
}

# Source A must receive the existing API barrier but no returned source-D route.
# Prefix-list/match export policy keeps that single marker exception explicit.
# final accept is required for the accepted API marker at the final writer;
# the match itself rejects every other prefix before that final disposition.
policy {
	prefix-list REPLAY-MARKER {
		entry 192.0.2.0/24 { action accept; }
	}
	match REPLAY-MARKER-ONLY {
		prefix-list REPLAY-MARKER
	}
}

bgp {
	# RFC 8212: an EBGP direction with no policy is refused; this test exchanges routes.
	filter {
		import { final accept; }
		export { final accept; }
	}
	peer source-peer {
		filter {
			import { final accept; }
			export { filters [ REPLAY-MARKER-ONLY ]; final accept; }
		}
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			rs-client true;
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
				add-path {
					direction send/receive
					family {
						ipv4/unicast
					}
				}
			}
		}
		behavior {
			group-updates disable
		}

	}

	peer source-collision {
		connection {
			remote { ip 127.0.0.4; }
			local { ip 127.0.0.4; accept false; }
		}
		session {
			rs-client true;
			asn { local 65000; remote 65004; }
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
				add-path {
					direction send/receive
					family { ipv4/unicast; }
				}
			}
		}
		behavior { group-updates disable; }
		filter {
			import { final accept; }
			export { final reject; }
		}
		# rs receives source D's route and participates in initial-sync EOR.
		# Its send grant permits that EOR; export policy rejects returned routes.
		# rs may ask adj-rib-in for peer-up replay to D. Grant send only, so
		# that authorized replay meets D's rejecting export policy without
		# adding D's announcements or state to the original receive store.
	}

	peer dest-addpath {
		connection {
			remote {
				ip 127.0.0.2
			}
			local {
				ip 127.0.0.2
				accept false
			}
		}
		session {
			rs-client true;
			asn {
				local 65000
				remote 65002
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
				add-path {
					direction send/receive
					family {
						ipv4/unicast
					}
				}
			}
		}
		# Preserve the received NEXT_HOP bytes asserted by this test.
		filter {
			export { filters [ next-hop:unchanged ]; final accept; }
		}
		behavior {
			group-updates disable
		}
		# The replay puts an UPDATE on this peer's wire, so this peer must grant
		# adj-rib-in the permission to originate one (maySend,
		# internal/component/bgp/reactor/send_permission.go). Send only, and no
		# receive list: the NON-VACUITY note rests on adj-rib-in never being fed
		# `state` for a destination, so its own peer-up self-replay stays silent.
	}

	peer dest-plain {
		connection {
			remote {
				ip 127.0.0.3
			}
			local {
				ip 127.0.0.3
				accept false
			}
		}
		session {
			rs-client true;
			asn {
				local 65000
				remote 65003
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		# Preserve the received NEXT_HOP bytes asserted by this test.
		filter {
			export { filters [ next-hop:unchanged ]; final accept; }
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=le test peer --port $PORT:stdin=source
cmd=background:seq=2:exec=le test peer --bind 127.0.0.2 --port $PORT:stdin=dest-addpath
cmd=background:seq=3:exec=le test peer --bind 127.0.0.3 --port $PORT:stdin=dest-plain
cmd=background:seq=4:exec=le test peer --bind 127.0.0.4 --port $PORT:stdin=source-collision
cmd=foreground:seq=5:exec=ze -:stdin=ze-bgp:timeout=40s
expect=exit:code=0
reject=stderr:pattern=panic
reject=stderr:pattern=fatal error
reject=stderr:pattern=ZE-OBSERVER-FAIL
