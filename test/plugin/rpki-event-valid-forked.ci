# Test: a forked RPKI plugin validates a real UPDATE through its JSON handler.
# QUESTION: does a known peer AS survive the daemon's JSON delivery and produce
# the expected valid prefix event from a real forked RPKI process?
# A unit test cannot prove the process transport or the daemon's event binding.
# The existing observer and RTR mock assert the same result as the internal twin.
# VALIDATES: the daemon delivers a known-AS UPDATE over JSON to forked RPKI.
# PREVENTS: typed peer-AS admission silently dropping valid forked-plugin events.

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
# Keep the route installed until the observer sees a current validation event.
option=linger:value=true
option=update:value=send-route:prefix=10.0.1.0/24:origin-as=65001:next-hop=10.0.0.1
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	hub {
		server local {
			ip 127.0.0.1;
			port 0;
			secret rpki-test-secret-key-01234567890;
		}
	}
	external rpki-event-test {
		run "le test fixture plugin/rpki-event-valid"
		encoder json
	}
	external rpki {
		run "ze plugin bgp-rpki"
		encoder json
	}
	internal adj-rib-in {
		use bgp-adj-rib-in
	}
}

bgp {
	rpki {
		cache-server 127.0.0.1 {
			trusted-network true
			port $PORT2
		}
	}
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		attach process rpki-event-test {
			receive [ rpki-received ]
		}
		attach process rpki {
			receive [ update-received state ]
		}
		attach process adj-rib-in {
			receive [ update-received state ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=le mock rtr --port $PORT2 --vrp 10.0.0.0/8,24,65001:ready=le mock rtr: listening on
cmd=background:seq=2:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=3:exec=ze -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
expect=stderr:pattern=OK: rpki event has 10.0.1.0/24=valid
reject=stderr:pattern=ZE-OBSERVER-FAIL
reject=stderr:pattern=panic
