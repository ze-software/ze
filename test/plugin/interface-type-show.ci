# Test: `show interface type <t>` filters, and rejects an unknown type
# Exercises: dispatch-command -> ze-show:interface-type -> handleShowInterfaceType
#            -> showInterfaceByType (internal/component/iface/cmd/show_interface.go)
# VALIDATES: the filtered set equals the interfaces of that type in the full list,
#            and an unknown type is REJECTED with the valid types derived from the
#            running set rather than answered with everything.
# PREVENTS:  a filter that stops filtering. The negative case is what catches it on
#            a host that happens to have only one interface type (the positive
#            set-equality alone would still pass there).

option=skip-os:value=darwin

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=20s
option=asn:value=65001
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER


stdin=ze-conf:terminator=EOF_CONF
plugin {
	external interface-type-show-test {
		run "ze-test fixture plugin/interface-type-show"
		encoder json
	}
}

# The interface block makes the iface component run OnConfigure ->
# iface.LoadBackend("netlink"), so ListInterfaces has a backend to read. No
# interface is declared, so the managed set is empty and nothing is created or
# deleted: every read below is of links the host already has.
interface {
	backend netlink
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-conf:timeout=20s
expect=exit:code=0
expect=stderr:contains=OK: show interface type
reject=stderr:pattern=panic
