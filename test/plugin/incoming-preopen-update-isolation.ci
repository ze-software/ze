# Test: can a pre-OPEN TCP connection withdraw an Established sibling's route?
# A unit test cannot decide whether the actual daemon's received RIB and route
# server preserve useful original-socket forwarding after that wire sequence.
# VALIDATES: a source-side competitor sends a valid withdrawal before OPEN and
# receives EOF without notification. The original route remains in the actual
# received RIB; fresh FIFO fence routes reach the original Customer with OTC;
# only the original source's subsequent withdrawal removes that route once.
# PREVENTS: early-handshake UPDATE publication under the incumbent peer address.
# Scenario: internal/test/fixture/incoming_preopen_update.go.

option=timeout:value=90s

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	internal adj-rib-in { use bgp-adj-rib-in; }
	internal rs { use bgp-rs; }
	external incoming-update-watch {
		run "le test fixture plugin/incoming-preopen-update-isolation 127.0.0.1:$PORT"
		encoder json
	}
}
bgp {
	filter {
		import { final accept; }
		export { filters [ next-hop:unchanged ]; final accept; }
	}
	peer source-peer {
		timer { delay-open 60; }
		connection {
			local { ip 127.0.0.1; port $PORT; }
			remote { ip 127.0.0.2; connect false; }
		}
		session {
			asn { local 65000; remote 65001; }
			router-id 1.2.3.4
			family { ipv4/unicast { prefix { maximum 10000; } } }
		}
		role { import provider; export customer; }
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
		attach process adj-rib-in {
			receive [ update-received state ]
			send [ update ]
		}
	}
	peer dest-peer {
		connection {
			local { ip 127.0.0.1; port $PORT; }
			remote { ip 127.0.0.3; connect false; }
		}
		session {
			asn { local 65000; remote 65002; }
			router-id 1.2.3.4
			family { ipv4/unicast { prefix { maximum 10000; } } }
		}
		role { import provider; }
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
		attach process adj-rib-in {
			receive [ update-received state ]
			send [ update ]
		}
	}
}
EOF_CONF

cmd=foreground:seq=1:exec=ze --plugin ze.bgp-role -:stdin=ze-bgp:timeout=90s
expect=stderr:contains=OK: pre-OPEN withdrawal received EOF without notification; original route stayed in the received RIB and on its original socket; original source alone withdrew it once; both original peers stayed established
reject=stderr:contains=ZE-OBSERVER-FAIL
reject=stderr:pattern=panic recovered|fatal error
expect=exit:code=0
