# accept-only: every assertion is made by the compiled fixture
# pluginSHACryptPasswordAtBoot (internal/test/fixture/register_sha_crypt_password_at_boot.go),
# which returns an error, so a non-zero exit, on a refused login, an accepted wrong
# password, a load warning, or a hash or password in the daemon log.
#
# Test: an account migrated with its SHA-crypt hash logs in with its password.
#
# QUESTION: does a daemon started on a config whose user carries a "$6$" or
#           "$5$" hash on the password leaf accept that user's SSH login with
#           the right password, and refuse a wrong one? A unit test proves the
#           comparison (internal/core/shacrypt, internal/component/authz); only a
#           running daemon proves the stored value survives the load and reaches
#           the backend every login surface uses.
# VALIDATES: the config file's password "$6$..." and "$5$..." are stored as
#            given (never re-hashed, no load warning), LocalAuthenticator
#            verifies them, a wrong password is refused, and neither the hash
#            nor a typed password reaches the daemon log.
#
# The two hashes are published test vectors of the SHA-crypt specification
# ("Unix crypt using SHA-256 and SHA-512"), made from "Hello world!".
#
# DISCRIMINATOR: make passhash.Verify (internal/core/passhash/passhash.go) send
# every hash to bcrypt and the first login fails with "SSH auth failure".
#
# The config dir is emptied for the CLI (as in
# config-plaintext-password-at-boot.ci, whose shape this test follows) so no
# credential store can supply a login.

tmpfs=sha-crypt-at-boot.conf:terminator=EOF_CONF
bgp {
	router-id 203.0.113.252;
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65532
				remote 65532
			}
		}
	}
}

system {
	authentication {
		user migrated512 {
			password "$6$saltstring$svn8UoSVapNtMuq1ukKS4tPQd8iKwSMHWjl/O817G3uBnIFNjnQJuesI68u4OTLiBFdcbYEdFCoEOfaS35inz1"
		}
		user migrated256 {
			password "$5$rounds=10000$saltstringsaltst$3xv.VbSHBb41AL9AvLeujZkZRBAwqFMz2.opqey6IcA"
		}
	}
}

environment {
	ssh {
		enabled true
		server main {
			ip 127.0.0.1;
			port 0;
		}
	}
}
EOF_CONF

cmd=foreground:seq=1:exec=le test fixture plugin/config-sha-crypt-password-at-boot:timeout=25s
expect=exit:code=0
