# Test: RPKI validation batches multiple routes with mixed outcomes
# VALIDATES: Batch path dispatches mixed Valid/Invalid/NotFound decisions correctly
# PREVENTS: Batching silently dropping or misclassifying decisions

# ze-peer: send 4 routes with mixed validation outcomes
# VRP 10.0.0.0/8 maxlen=24 AS=65001 -> 10.0.1.0/24 from AS 65001 = Valid
# VRP 10.0.0.0/8 maxlen=24 AS=65001 -> 10.0.2.0/24 from AS 65001 = Valid
# VRP 10.0.0.0/8 maxlen=24 AS=65001 -> 10.0.3.0/24 from AS 65999 = Invalid (wrong ASN)
# No VRP covers 192.168.0.0/16      -> 192.168.1.0/24 from AS 65001 = NotFound
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
option=linger:value=true
option=update:value=send-route:prefix=10.0.1.0/24:origin-as=65001:next-hop=10.0.0.1
option=update:value=send-route:prefix=10.0.2.0/24:origin-as=65001:next-hop=10.0.0.1
option=update:value=send-route:prefix=10.0.3.0/24:origin-as=65999:next-hop=10.0.0.1
option=update:value=send-route:prefix=192.168.1.0/24:origin-as=65001:next-hop=10.0.0.1
# EOR from ze
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# Native observer fixture: plugin/rpki-validate-batch-mixed.

# ze bgp configuration with RPKI plugin + VRP covering 10.0.0.0/8 max /24 for AS 65001
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	hub {
		server local {
			ip 127.0.0.1;
			port 0;
			secret rpki-test-secret-key-01234567890;
		}
	}
	external rpki-batch-test {
		run "ze-test fixture plugin/rpki-validate-batch-mixed"
		encoder json
	}
	internal rpki {
		use bgp-rpki
	}
	internal adj-rib-in {
		use bgp-adj-rib-in
	}
}

bgp {
	rpki {
		cache-server 127.0.0.1 {
			port $PORT2
		}
	}
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}

		attach process rpki {
			receive [ update-received ]
		}
		attach process adj-rib-in {
			receive [ update-received state ]
		}
	}
}
EOF_CONF

# VRP: 10.0.0.0/8 maxlen=24 AS=65001
# Covers 10.0.x.0/24 from AS 65001 (Valid), 10.0.x.0/24 from AS 65999 (Invalid)
# Does NOT cover 192.168.x.0/24 (NotFound)
cmd=background:seq=1:exec=ze-test rtr-mock --port $PORT2 --vrp 10.0.0.0/8,24,65001
cmd=background:seq=2:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=3:exec=ze -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
