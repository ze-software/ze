# Test: RPKI validation batches multiple routes with mixed outcomes
# VALIDATES: Batch path dispatches mixed Valid/Invalid/NotFound decisions correctly
# PREVENTS: Batching silently dropping or misclassifying decisions

# ze-peer: send 4 routes with mixed validation outcomes
# VRP 10.0.0.0/8 maxlen=24 AS=65001 -> 10.0.1.0/24 from AS 65001 = Valid
# VRP 10.0.0.0/8 maxlen=24 AS=65001 -> 10.0.2.0/24 from AS 65001 = Valid
# VRP 10.0.0.0/8 maxlen=24 AS=65001 -> 10.0.3.0/24 from AS 65999 = Invalid (wrong ASN)
# No VRP covers 192.168.0.0/16      -> 192.168.1.0/24 from AS 65001 = NotFound
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
option=update:value=send-route:prefix=10.0.1.0/24:origin-as=65001:next-hop=10.0.0.1
option=update:value=send-route:prefix=10.0.2.0/24:origin-as=65001:next-hop=10.0.0.1
option=update:value=send-route:prefix=10.0.3.0/24:origin-as=65999:next-hop=10.0.0.1
option=update:value=send-route:prefix=192.168.1.0/24:origin-as=65001:next-hop=10.0.0.1
# EOR from ze
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# Python test plugin: verifies batch produces correct accept/reject per route
tmpfs=rpki-batch-test.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
import json
import sys
import time
from ze_api import API, result_text_data

def dispatch(api, command):
    resp = api._call_engine(
        'ze-plugin-engine:dispatch-command', {'command': command})
    if resp is None:
        return {'status': 'error', 'data': 'engine call returned None'}
    return resp.get('result', {})

def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()

    # Poll adj-rib-in until the three accepted routes land (the invalid one is
    # never installed). Deterministic replacement for a blind time.sleep.
    # // test-relax: blind sleep(4.0) -> dispatch_until poll on show bgp rib received
    def _three_accepted(r):
        d = result_text_data(r)
        return '10.0.1.0/24' in d and '10.0.2.0/24' in d and '192.168.1.0/24' in d

    try:
        # Query adj-rib-in for received routes (poll until accepted routes land)
        result = api.dispatch_until('show bgp rib received', _three_accepted, attempts=40)
        if result.get('status') != 'done':
            print(f'FAIL: rib query failed: status={result.get("status")}', file=sys.stderr)
            sys.exit(1)

        data = result_text_data(result)

        # 10.0.1.0/24: Valid (ASN 65001 matches VRP) - must be installed
        if '10.0.1.0/24' not in data:
            print(f'FAIL: 10.0.1.0/24 (Valid) not in adj-rib-in: {data}', file=sys.stderr)
            sys.exit(1)

        # 10.0.2.0/24: Valid (ASN 65001 matches VRP) - must be installed
        if '10.0.2.0/24' not in data:
            print(f'FAIL: 10.0.2.0/24 (Valid) not in adj-rib-in: {data}', file=sys.stderr)
            sys.exit(1)

        # 10.0.3.0/24: Invalid (ASN 65999 != VRP ASN 65001) - must NOT be installed
        if '10.0.3.0/24' in data:
            print(f'FAIL: 10.0.3.0/24 (Invalid) should have been rejected: {data}', file=sys.stderr)
            sys.exit(1)

        # 192.168.1.0/24: NotFound (no covering VRP) - must be installed
        if '192.168.1.0/24' not in data:
            print(f'FAIL: 192.168.1.0/24 (NotFound) not in adj-rib-in: {data}', file=sys.stderr)
            sys.exit(1)

        print('OK: batch validation correct: 2 Valid accepted, 1 Invalid rejected, 1 NotFound accepted', file=sys.stderr)
    finally:
        dispatch(api, 'request shutdown')
        api.wait_for_shutdown()

if __name__ == '__main__':
    main()
EOF_RUN

# ze bgp configuration with RPKI plugin + VRP covering 10.0.0.0/8 max /24 for AS 65001
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	hub {
		server local {
			ip 127.0.0.1;
			port 0;
			secret rpki-test-secret-key-01234567890;
		}
	}
	external rpki-batch-test {
		run ./rpki-batch-test.run
		encoder json
	}
	internal rpki {
		use bgp-rpki
	}
	internal adj-rib-in {
		use bgp-adj-rib-in
	}
}

bgp {
	rpki {
		cache-server 127.0.0.1 {
			port $PORT2
		}
	}
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}

		attach process rpki {
			receive [ update-received ]
		}
		attach process adj-rib-in {
			receive [ update-received state ]
		}
	}
}
EOF_CONF

# VRP: 10.0.0.0/8 maxlen=24 AS=65001
# Covers 10.0.x.0/24 from AS 65001 (Valid), 10.0.x.0/24 from AS 65999 (Invalid)
# Does NOT cover 192.168.x.0/24 (NotFound)
cmd=background:seq=1:exec=ze-test rtr-mock --port $PORT2 --vrp 10.0.0.0/8,24,65001
cmd=background:seq=2:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=3:exec=ze -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
