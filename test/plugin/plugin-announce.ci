EOF_PEER

# Native plugin route driver.

# ze bgp configuration
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external add-remove {
		run "ze-test fixture plugin/plugin-announce"
		encoder json
	}
}
bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart
			}
		}
		behavior {
			group-updates disable
		}
	
		attach process add-remove {
			send [ update ]
			# The peer-up event, which is what lets this process be part of the
			# peer's INITIAL routing update: it declares SignalsSessionReady and
			# reports when its announces are out, so the End-of-RIB waits for
			# them (Peer.initialUpdateReporters).
			receive [ state ]
		}
	}
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=10s
