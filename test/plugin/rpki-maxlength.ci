# QUESTION: Does explicit Invalid rejection make the received /25 ineligible when its covering VRP permits at most /24?
# A unit cannot decide live configuration delivery, RTR synchronization and asynchronous validation across the daemon, cache and BGP peer processes.
# Test: RPKI rejects route exceeding maxLength
# VALIDATES: Route /25 rejected when VRP maxLength=24 (AC-10)
# PREVENTS: RPKI plugin ignoring maxLength constraint

# ze-peer: send route 10.0.1.0/25 from AS 65001 (VRP maxlen=24, /25 exceeds it)
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=linger:value=true
option=timeout:value=15s
option=update:value=send-route:prefix=10.0.1.0/25:origin-as=65001:next-hop=10.0.0.1
# EOR from ze
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# Native compiled fixture: plugin/rpki-maxlength
stdin=ze-bgp:terminator=EOF_CONF
bus {
	endpoint rpki {
		internal bgp-rpki;
	}
	endpoint adj-rib-in {
		internal bgp-adj-rib-in;
	}
	endpoint rpki-maxlen-test {
		external {
			run "le test fixture plugin/rpki-maxlength";
		}
		encoding json;
	}
	hub {
		server local {
			ip 127.0.0.1;
			port 0;
			secret rpki-test-secret-key-01234567890;
		}
	}
}

bgp {
	rpki {
		cache-server 127.0.0.1 {
			trusted-network true
			port $PORT2
		}
		action {
			invalid reject;
		}
	}
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}

	}
}
EOF_CONF

# VRP: 10.0.0.0/8 maxlen=24 AS=65001 (10.0.1.0/25 exceeds maxLength = Invalid)
cmd=background:seq=1:exec=le mock rtr --port $PORT2 --vrp 10.0.0.0/8,24,65001:ready=le mock rtr: listening on
cmd=background:seq=2:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=3:exec=ze -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
