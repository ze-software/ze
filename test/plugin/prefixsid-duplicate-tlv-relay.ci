# prefixsid-duplicate-tlv-relay -- RFC 8669 Section 6 repeated Prefix-SID TLVs, from a peer's
# socket to another peer's socket.
#
# RFC requirement: RFC8669-6-3 positive -- on IPv4 unicast, a received Prefix-SID holding two SRv6 L3 Service TLVs then an unknown TLV, followed by a COMMUNITIES attribute, is relayed to another peer holding the first L3 Service TLV and the unknown TLV only, with the COMMUNITIES attribute unchanged, while a Prefix-SID repeating only an unknown TLV, or repeating the Label-Index TLV off labeled unicast, is relayed byte for byte.
#
# "Similarly, if a recognized TLV appears more than once in a BGP Prefix-SID attribute while the
# specification only allows for a single occurrence, then all the occurrences of the TLV other
# than the first one SHALL be discarded and the Prefix-SID attribute will continue to be
# processed." Ze discards the repeat at ingest (publishBase, discardRepeatedPrefixSIDTLVs in
# internal/component/bgp/reactor/rfc8669_duplicate_tlv.go), so the bytes the RIB keeps and the
# bytes every relay copies are the same bytes. The unit tests drive that step directly; this file
# proves a user reaches it: a real session in, a real session out.
#
# THREE UPDATES. The first control (10.0.0.0/24) repeats an UNKNOWN TLV, which RFC 8669 Section 6
# says is "propagated unmodified", and must arrive byte-identical. The second control
# (10.0.1.0/24) repeats the Label-Index TLV with the unknown TLV between the two copies. RFC 8669
# Section 3.1 says the Label-Index TLV "MUST be ignored when received for other BGP AFI/SAFI
# combinations" than labeled unicast, so on IPv4 unicast ze does not recognize it and both copies
# must arrive. The third (10.0.2.0/24) repeats the SRv6 L3 Service TLV, which RFC 9252 Section 7
# limits to one on every family ("all but the first instance MUST be ignored"), with an unknown TLV
# after the repeat and a COMMUNITIES attribute after attribute 40. It must arrive with the second
# L3 Service TLV gone, the unknown TLV kept behind the first, and the COMMUNITIES attribute
# octet-identical. A step that discarded nothing fails the third; one that discarded every repeat
# or ignored the family fails a control; one that stopped copying at the repeat, or dropped the
# attributes after code 40, fails the third.
#
# WHY THE RECEIVER SETS rs-client. RFC 7947 Section 2.2.2.1 leaves an RS client's AS_PATH
# untouched, and Section 2.2.1 its NEXT_HOP, so the forwarded frames differ from the received
# ones in attribute 40 alone, and the SRv6 Service TLVs a next-hop change would remove (RFC 9252
# Section 2) stay.
#
# WHY THE SOURCE SETS accept-srv6-prefix-sid AND THE RECEIVER propagate-srv6-prefix-sid. Both
# sessions are eBGP. RFC 8669 Section 4 discards the attribute from an eBGP peer unless accepted,
# and Section 8 removes it toward one unless propagation is configured. Without either leaf no
# attribute 40 would arrive, and every assertion would pin a different requirement.

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=2
option=timeout:value=20s
option=bind:value=0.0.0.0
option=conn_map:value=remote-ip
# Send only after ze has sent its EOR, so the receiver is up and each UPDATE is relayed live,
# in the order the source sent it.
option=await_eor:value=true

# Source peer (conn=1, AS 65001), the control: 10.0.0.0/24.
#   ORIGIN:     40010100                     IGP
#   AS_PATH:    40020602010000FDE9           AS_SEQUENCE[65001], 4-byte ASNs
#   NEXT_HOP:   40030401010101               1.1.1.1
#   PREFIX_SID: C02814                       flags 0xC0, code 40, length 20
#               01000700000000000064         Label-Index TLV (type 1, length 7), index 100
#               090002AABB                   TLV type 9, unknown to ze, length 2
#               090002AABB                   the same unknown TLV again
#   NLRI:       180A0000                     10.0.0.0/24
# attr len = 4+9+7+23 = 43 = 0x2B; total = 19+2+2+43+4 = 70 = 0x46.
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0046020000002B4001010040020602010000FDE940030401010101C0281401000700000000000064090002AABB090002AABB180A0000

# Receiver (conn=2, AS 65002): the control byte for byte. An unknown TLV is never a repeat to
# discard, whatever its count.
expect=bgp:conn=2:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0046020000002B4001010040020602010000FDE940030401010101C0281401000700000000000064090002AABB090002AABB180A0000

# Source peer, the second control: 10.0.1.0/24.
#   PREFIX_SID: C02819                       flags 0xC0, code 40, length 25
#               01000700000000000064         Label-Index TLV, index 100
#               090002AABB                   unknown TLV
#               010007000000000000C8         Label-Index TLV, index 200: not recognized off
#                                            labeled unicast, so propagated unmodified
#   NLRI:       180A0001                     10.0.1.0/24
# attr len = 4+9+7+28 = 48 = 0x30; total = 19+2+2+48+4 = 75 = 0x4B.
action=send:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF004B02000000304001010040020602010000FDE940030401010101C0281901000700000000000064090002AABB010007000000000000C8180A0001

# Receiver: the second control byte for byte, both Label-Index TLVs included.
expect=bgp:conn=2:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF004B02000000304001010040020602010000FDE940030401010101C0281901000700000000000064090002AABB010007000000000000C8180A0001

# Source peer, the repeat: 10.0.2.0/24.
#   PREFIX_SID: C0283D                       flags 0xC0, code 40, length 61
#               050019 00 010015 00          SRv6 L3 Service TLV (type 5, length 25), Reserved,
#               20010DB8000000010000000000000000 SID Information Sub-TLV, SID 2001:db8:0:1::,
#               00 0013 00                   flags, End.DT4, Reserved (the first: kept)
#               050019 ... 20010DB8000000020000000000000000 ...
#                                            the same TLV with SID 2001:db8:0:2:: (the repeat:
#                                            discarded)
#               090002AABB                   unknown TLV after the repeat (kept, in place)
#   COMMUNITIES: C00804FDE90001              65001:1, after attribute 40 (kept, octet for octet)
#   NLRI:       180A0002                     10.0.2.0/24
# attr len = 4+9+7+64+7 = 91 = 0x5B; total = 19+2+2+91+4 = 118 = 0x76.
action=send:conn=1:seq=3:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0076020000005B4001010040020602010000FDE940030401010101C0283D050019000100150020010DB800000001000000000000000000001300050019000100150020010DB800000002000000000000000000001300090002AABBC00804FDE90001180A0002

# Receiver: attribute 40 is now length 33, the first L3 Service TLV then the unknown TLV, and
# nothing else in the frame moved.
# attr len = 4+9+7+36+7 = 63 = 0x3F; total = 19+2+2+63+4 = 90 = 0x5A.
expect=bgp:conn=2:seq=3:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF005A020000003F4001010040020602010000FDE940030401010101C02821050019000100150020010DB800000001000000000000000000001300090002AABBC00804FDE90001180A0002
EOF_PEER

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	internal rs {
		use bgp-rs
	}
	internal adj-rib-in {
		use bgp-adj-rib-in
	}
	external shutdown-after-forward {
		run "le test fixture plugin/prefixsid-duplicate-tlv-relay"
		encoder json
	}
}
bgp {
	peer source-peer {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			# RFC 8669 Section 4: accept the attribute from this eBGP peer.
			accept-srv6-prefix-sid true
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		attach process adj-rib-in {
			receive [ update-received state ]
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
		attach process shutdown-after-forward {
			receive [ update ]
		}
	}
	peer receiver {
		connection {
			remote {
				ip 127.0.0.2
			}
			local {
				ip 127.0.0.2
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65002
			}
			router-id 1.2.3.4
			rs-client true
			# RFC 8669 Section 8: this eBGP peer is inside the SR domain.
			propagate-srv6-prefix-sid true
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		attach process adj-rib-in {
			send [ update ]
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
		attach process shutdown-after-forward {
			receive [ update ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
reject=stderr:pattern=panic
reject=stderr:pattern=fatal error
reject=stderr:pattern=forward-cached failed
reject=stderr:pattern=release-cached failed
# A repeated TLV is discarded and the UPDATE processed: never an escalation.
reject=stderr:pattern=RFC 7606 session-reset
