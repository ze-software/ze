# Test: `show bgp ipv4` still passes the family as an argument.
#
# VALIDATES: spec-cli-dispatch-child-guard AC-4 and AC-5 of
#            spec-cli-show-bgp-is-the-command. The dispatch guard refuses a
#            parent match only when the leftover tokens reach a REGISTERED path.
#            A value typed after a command still reaches its handler, in the
#            shorthand form and in the full afi/safi form.
# PREVENTS:  R-1, a guard that refuses any match leaving tokens over. That rule
#            passes its own unit test and breaks every argument-taking command.
#            Also the family filter losing its own diagnosis: a family nobody
#            negotiated must name the family, never report an unknown command.

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
option=linger:value=true
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# Native observer fixture: plugin/show-bgp-family-arg.

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external show-bgp-family-arg {
		run "ze-test fixture plugin/show-bgp-family-arg"
		encoder json
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
