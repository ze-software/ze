# Test: resolve ping dispatches ICMP probe to target
# VALIDATES: cmd-9 AC-4 -- resolve ping 127.0.0.1 returns RTT and status (success)
# PREVENTS: resolve ping handler not wired or crashing

# Native fixture dispatches resolve ping 127.0.0.1 via engine API and verifies
# the response contains success output.

# The raw-ICMP resolve ping path currently has no unprivileged darwin
# equivalent in the test runner environment, so skip there like other
# raw-socket suites.
#
# caps=net-raw, not a bare skip-os: doPingCtx builds ICMP itself through
# net.ListenPacket("ip4:icmp", ...) (internal/component/ping/cmd/ping.go), which
# the kernel refuses without CAP_NET_RAW. skip-os hid the test from macOS and
# therefore ran it, unprivileged, on the Linux CI runner -- where it failed every
# time with `resolve ping status=error`. Declaring the capability relocates it to
# `./le qemu all-tests`, which has it, instead of failing where it
# cannot pass.
option=needs-linux:caps=net-raw

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=20s
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER


stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external ping-test {
		run "ze-test fixture plugin/resolve-ping"
		encoder json
	}
}
bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65000
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
reject=stderr:pattern=panic recovered
reject=stderr:pattern=fatal error
reject=stderr:pattern=ZE-OBSERVER-FAIL
