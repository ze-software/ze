# Question: does REST report a completed external record answer as warning,
# retaining its short or streamed data, while healthy controls remain done?
# A unit cannot prove final status publication through the real HTTP listener.
# This SDK record API supplies warning kind without warning text.

stdin=ze-conf:terminator=EOF_CONF
bus {
    endpoint answer-outcome-provider {
        external {
            run "le test fixture plugin/command-outcome-provider";
        }
        encoding json;
    }
    endpoint answer-outcome-observer {
        external {
            run "le test fixture plugin/command-outcome-rest $PORT warning";
        }
        encoding json;
    }
}
environment {
    api-server {
        token "command-outcome-token";
        rest {
            enabled true;
            server main { ip 127.0.0.1; port $PORT; }
        }
    }
}
EOF_CONF

cmd=foreground:seq=1:exec=ze -:stdin=ze-conf:timeout=40s
expect=exit:code=0
expect=stderr:contains=OK: REST warning outcome and healthy control preserved rows across the record threshold
reject=stderr:contains=ZE-OBSERVER-FAIL
reject=stderr:contains=panic recovered
