# Test: RADIUS admin authentication succeeds over SSH with profile mapping
#
# Flow:
# 1. ze-test radius-mock starts on a random UDP port, accepts admin:testpass and
#    returns Filter-Id=admin in the Access-Accept.
# 2. Daemon starts with ONLY RADIUS configured (no local admin user).
# 3. ze init writes admin/testpass client creds.
# 4. ze cli -c "show bgp summary" authenticates admin via RADIUS.
# 5. Daemon logs "SSH auth success ... source=radius" -- proves the chain
#    dispatched to the RADIUS admin backend and mapped Filter-Id=admin -> profile.
#
# VALIDATES: AC-1 -- RADIUS server configured + valid creds => user authenticated.
# VALIDATES: AC-3 -- Access-Accept => AuthResult{Authenticated, Source:"radius"}.
# VALIDATES: AC-6 -- Filter-Id "admin" maps to the admin authorization profile.
# PREVENTS: the RADIUS admin backend registered but never reached by the chain.

tmpfs=test-aaa-radius-admin.sh:mode=755:terminator=EOF_SH
#!/bin/sh
set -e

# Signal test runner readiness
touch daemon.ready

# Start RADIUS mock on random UDP port, address written to mock.addr.
ze-test radius-mock --port 0 --key ze-mock-key \
	--user admin:testpass:admin --addr-file mock.addr 2>mock.log &
MOCK_PID=$!
trap 'kill $MOCK_PID 2>/dev/null || true; wait $MOCK_PID 2>/dev/null || true' EXIT

# Wait for the mock to report its listening address.
MOCK_ADDR=""
for i in $(seq 1 30); do
	if [ -s mock.addr ]; then
		MOCK_ADDR=$(cat mock.addr)
		break
	fi
	sleep 0.1
done
if [ -z "$MOCK_ADDR" ]; then
	echo "FAIL: RADIUS mock did not report address" >&2
	cat mock.log >&2
	exit 1
fi
MOCK_IP=$(echo "$MOCK_ADDR" | cut -d: -f1)
MOCK_PORT=$(echo "$MOCK_ADDR" | cut -d: -f2)
echo "mock at $MOCK_ADDR" >&2

# Daemon config -- no local admin user. Only RADIUS can authenticate admin.
cat > aaa-radius-admin.conf <<ZECONF
bgp {
	peer peer1 {
		connection {
			remote { ip 127.0.0.1; }
			local  { ip 127.0.0.1; accept false; }
		}
		session { asn { local 65533; remote 65533; } }
	}
}

system {
	authentication {
		radius {
			server ${MOCK_IP} { port ${MOCK_PORT}; key "ze-mock-key"; }
			timeout 2;
		}
	}
	authorization {
		profile admin { run { default-action allow; } edit { default-action allow; } }
	}
}

environment {
	ssh {
		enabled true
		server main { ip 127.0.0.1; port 0; }
	}
}
ZECONF

# BGP port derived from PID so concurrent tests do not collide.
export ze_test_bgp_port=$((10000 + ($$ % 50000)))

ze start aaa-radius-admin.conf 2>daemon.log &
DAEMON_PID=$!
trap 'kill $DAEMON_PID 2>/dev/null || true; wait $DAEMON_PID 2>/dev/null || true; kill $MOCK_PID 2>/dev/null || true; wait $MOCK_PID 2>/dev/null || true' EXIT

# Wait for the SSH listener.
SSH_PORT=""
for i in $(seq 1 50); do
	SSH_PORT=$(grep -o '127\.0\.0\.1:[0-9]*' daemon.log 2>/dev/null | head -1 | cut -d: -f2 || true)
	if [ -n "$SSH_PORT" ]; then
		break
	fi
	sleep 0.2
done
if [ -z "$SSH_PORT" ]; then
	echo "FAIL: SSH server did not start" >&2
	cat daemon.log >&2
	exit 1
fi
echo "ssh on :$SSH_PORT" >&2

sleep 0.5

# Client: admin/testpass -- only RADIUS accepts, no local admin user exists.
ADMIN_DIR=$(mktemp -d)
trap 'rm -rf "$ADMIN_DIR"; kill $DAEMON_PID 2>/dev/null || true; wait $DAEMON_PID 2>/dev/null || true; kill $MOCK_PID 2>/dev/null || true; wait $MOCK_PID 2>/dev/null || true' EXIT
printf 'admin\ntestpass\n127.0.0.1\n%s\n' "$SSH_PORT" | ZE_CONFIG_DIR="$ADMIN_DIR" ze init >/dev/null

OUTPUT=$(ZE_CONFIG_DIR="$ADMIN_DIR" ZE_SSH_PASSWORD="testpass" ze cli -c "show bgp summary" 2>&1) || {
	echo "FAIL: 'show summary' via RADIUS auth" >&2
	echo "OUTPUT: $OUTPUT" >&2
	echo "--- daemon log ---" >&2
	cat daemon.log >&2
	echo "--- mock log ---" >&2
	cat mock.log >&2
	exit 1
}
echo "OK: summary ran via RADIUS auth" >&2

# Give the daemon a beat to emit the auth-success log, then replay it to this
# script's stderr so the .ci runner's expect=stderr matchers can see it.
sleep 0.3
cat daemon.log >&2

exit 0
EOF_SH

cmd=foreground:seq=1:exec=./test-aaa-radius-admin.sh:timeout=20s
expect=exit:code=0
# SSH emits "auth success ... source=radius" after the RADIUS backend satisfies
# the credential check -- proof that RADIUS (not local bcrypt) authenticated.
expect=stderr:pattern=auth success.*source=radius
