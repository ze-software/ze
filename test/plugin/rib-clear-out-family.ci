# Test: rib clear out with family filter resends only that family
# VALIDATES: AC-5 — rib clear out * ipv4/unicast resends only ipv4/unicast
# PREVENTS: Per-family filter ignored, all families resent

# ze-peer expectations
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
# Assert ze's ipv4/unicast End-of-RIB (RFC 4724 S2: the empty UPDATE). The observer
# gates `request shutdown` on eor-sent >= 1 (see wait_eor_sent below), so ze is
# given the chance to emit it rather than being torn down mid initial-sync.
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# Python test plugin: exercises dispatch-command for rib clear out with family
tmpfs=rib-clear-out-family-test.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
import json
import sys
from ze_api import API, runtime_fail, result_json_data
# // test-relax: dropped unused 'import time' (no sleep in this observer)

def dispatch(api, command):
    resp = api._call_engine(
        'ze-plugin-engine:dispatch-command', {'command': command})
    if resp is None:
        return {'status': 'error', 'data': 'engine call returned None'}
    return resp.get('result', {})

def eor_sent(result):
    """True once ze has written its End-of-RIB to at least one peer.

    `show bgp peer <sel> detail` returns {"peers": {"<ip>": {..., "eor-sent": N}}}
    (peer.go:217, :341-345). peer_stats.go IncrEORSent, called only from
    peer_initial_sync.go's sendInitialRoutes, increments the counter once the EOR
    write has succeeded and been flushed to the peer's socket, so eor-sent >= 1
    proves the marker is on the wire rather than merely scheduled.
    """
    if result.get('status') != 'done':
        return False
    try:
        peers = result_json_data(result, {}).get('peers', {})
    except (json.JSONDecodeError, TypeError, ValueError):
        return False
    return any(p.get('eor-sent', 0) >= 1 for p in peers.values())

def wait_eor_sent(api, selector):
    """Block until ze has sent its EOR, so `request shutdown` cannot pre-empt it.

    The peer block asserts ze's End-of-RIB on the wire. ze emits it only after the
    initial-sync barrier: peer_initial_sync.go's sendInitialRoutes runs the
    apiSync wait (500ms sleep, then the plugin-ready signal) before its EOR-send
    loop builds and sends the EOR. The
    dispatch checks below complete long before that, so a shutdown gated on them
    alone closes TCP first and the peer's expectation can never fire. Gate on the
    EOR the test actually asserts.
    """
    if not eor_sent(api.dispatch_until(
            f'show bgp peer {selector} detail', eor_sent, attempts=40)):
        runtime_fail(f'ze never sent its End-of-RIB to {selector}')

def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()
    api.wait_for_post_startup(timeout=5.0)

    try:
        # Test per-family clear out
        result = dispatch(api, 'clear bgp rib out * ipv4/unicast')
        if result.get('status') != 'done':
            print(f'FAIL: status={result.get("status")} data={result.get("data")}', file=sys.stderr)
            sys.exit(1)
        print('OK: rib clear out * ipv4/unicast dispatched', file=sys.stderr)

        # Test no-arg error
        result = dispatch(api, 'clear bgp rib out')
        if result.get('status') != 'error':
            print(f'FAIL: expected error for no-arg, got status={result.get("status")}', file=sys.stderr)
            sys.exit(1)
        print('OK: rib clear out without selector returns error', file=sys.stderr)

        wait_eor_sent(api, 'peer1')
    finally:
        dispatch(api, 'request shutdown')
        api.wait_for_shutdown()

if __name__ == '__main__':
    main()
EOF_RUN

# ze bgp configuration
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external rib-clear-out-family-test {
		run ./rib-clear-out-family-test.run
		encoder json
	}
	internal bgp-rib {
		use bgp-rib
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}

		attach process bgp-rib {
			receive [ update state refresh ]
			send [ update ]
		}
	}
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
# runtime_fail emits this sentinel on the observer's stderr; without the reject the
# observer's assertion failures would be invisible to the runner.
reject=stderr:pattern=ZE-OBSERVER-FAIL
