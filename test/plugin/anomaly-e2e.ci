# Test: anomaly facts->judgment->response, end to end through the daemon.
# Exercises: fakeflow injects synthetic KindFlow observations -> trafficfeature
#            aggregates -> anomaly/detect scores + emits an incident ->
#            anomaly/shape (armed) installs a per-source firewall action.
# VALIDATES: a same-/24 normal cohort plus one high-fan-out / rare-port outlier
#            produces a real anomaly incident (show anomaly detect: incidents>0)
#            AND arms the responder (show anomaly shape: armed-count>0), proving
#            the whole chain fires -- not just wiring with empty data.
# PREVENTS: a silent break anywhere in facts->judgment->response that per-layer
#           unit tests cannot catch (the three existing anomaly .ci tests only
#           prove wiring with an empty ring).
#
# Determinism: confirm-duration is lowered to 2 and min-cohort-size/baseline-window
# tightened; the driver polls rather than sleeping a fixed time. armed-count reflects
# the responder's decision (responder.go armedCount++), so it moves without a real
# kernel firewall backend.
# test-relax: deviation-threshold is left at its default (3.0), not tuned down --
# setting it currently fails config validation ("range validation not supported for
# type string", a decimal-2 range gap in the in-flight anomaly YANG). The outlier's
# cohort-rarity z (fan-out 12 vs cohort ~1) far exceeds 3.0, so incidents>0 holds
# without the override; no assertion is weakened.

# ze-peer: accepts connection (keeps the DUT alive for the run)
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=90s
option=asn:value=65001
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

tmpfs=anomaly-e2e-test.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
import json
import sys
import time
from ze_api import API, runtime_fail, result_text_data

def dispatch(api, command):
    resp = api._call_engine(
        'ze-plugin-engine:dispatch-command', {'command': command})
    if resp is None:
        return {}
    return resp.get('result', {})

def data_of(resp):
    if resp.get('status') != 'done':
        return {}
    d = result_text_data(resp)
    if isinstance(d, str) and d:
        d = json.loads(d)
    return d if isinstance(d, dict) else {}

def inject(api, src, dst, port, nbytes):
    return dispatch(api, f'request fakeflow inject {src} {dst} {port} {nbytes}')

# Same-/24 normal cohort: low fan-out (one dest), one common port, moderate bytes.
NORMALS = [f'10.0.0.{i}' for i in range(1, 6)]
# Outlier in the SAME /24 so cohort rarity (leave-one-out) measures it against
# its peers: high fan-out across many dests, many distinct high (rare) ports.
OUTLIER = '10.0.0.9'
OUT_DESTS = [f'203.0.113.{d}' for d in range(10, 22)]
OUT_PORTS = list(range(10000, 10012))

def inject_batch(api):
    for s in NORMALS:
        inject(api, s, '203.0.113.1', 443, 1000)
    for i, d in enumerate(OUT_DESTS):
        inject(api, OUTLIER, d, OUT_PORTS[i % len(OUT_PORTS)], 5000)

def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()
    api.wait_for_post_startup(timeout=5.0)

    try:
        # Probe: the inject command must be wired to the in-process fakeflow plugin.
        probe = inject(api, '10.0.0.1', '203.0.113.1', 443, 1000)
        if probe.get('status') != 'done':
            runtime_fail(f'fakeflow inject not wired: {probe}')
        # Diagnostic: does fakeflow's own publish reach a subscriber on its
        # observation.Global()? (localises process-isolation vs mechanism).
        sc = data_of(dispatch(api, 'show fakeflow selfcheck'))
        print(f'DIAG: fakeflow selfcheck={sc}', file=sys.stderr)

        # Phase 1: sustain injection until the detector confirms an incident.
        incidents = 0
        for _ in range(25):
            inject_batch(api)
            time.sleep(1.0)
            d = data_of(dispatch(api, 'show anomaly detect'))
            incidents = len(d.get('incidents', []))
            if incidents > 0:
                break
        if incidents <= 0:
            tf = data_of(dispatch(api, 'show traffic-feature'))
            det = data_of(dispatch(api, 'show anomaly detect'))
            runtime_fail(f'no incident. traffic-feature={tf} anomaly-detect={det}')
        print(f'OK: show anomaly detect incidents={incidents}', file=sys.stderr)

        # Phase 2: keep the incident active (Ongoing re-arms the TTL) until the
        # armed responder installs an action.
        armed = 0
        for _ in range(15):
            inject_batch(api)
            time.sleep(1.0)
            s = data_of(dispatch(api, 'show anomaly shape'))
            armed = s.get('armed-count', 0) or 0
            if armed > 0:
                break
        if armed <= 0:
            runtime_fail(f'responder did not arm (armed-count={armed}) despite an incident')
        print(f'OK: show anomaly shape armed-count={armed}', file=sys.stderr)
    finally:
        dispatch(api, 'request shutdown')
        api.wait_for_shutdown()

if __name__ == '__main__':
    main()
EOF_RUN

stdin=ze-bgp:terminator=EOF_CONF
anomaly {
	detect {
		enabled true
		confirm-duration 2
		baseline-window 10
		# // test-relax: deviation-threshold left at its default (3.0) -- setting it
		# fails config validation ("range validation not supported for type string",
		# schema.go:890: a decimal-2 range gap in the in-flight anomaly YANG). The
		# outlier's cohort-rarity z (fan-out 12 vs cohort ~1) far exceeds 3.0, so
		# incidents>0 holds without the override; no assertion is weakened.
		min-cohort-size 2
	}
	shape {
		mode armed
		action limit
	}
}

plugin {
	external anomaly-e2e-test {
		run ./anomaly-e2e-test.run
		encoder json
	}
	internal fakeflow {
		use fakeflow
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast {
					prefix {
						maximum 10000
					}
				}
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}

		process anomaly-e2e-test {
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=90s
expect=exit:code=0
