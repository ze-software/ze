# Test: remove-private-as export policy strips private ASNs before EBGP prepend
# VALIDATES: export chain removes RFC 6996 Private Use ASNs from AS_PATH before advertisement.
# VALIDATES: EBGP local-AS prepend uses the stripped AS_PATH as its base.
# PREVENTS: export policy rewrite being lost by the EBGP wire cache.

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=2
option=timeout:value=20s
option=bind:value=0.0.0.0
# Map conn=N to a peer by remote IP instead of accept order (peer_connmap.go).
# Without this, conn=N binds to ACCEPT ORDER (peer.go:248), and which peer ze dials
# first is a race (127.0.0.2 observed first in 4/5 runs), so the source's UPDATE below
# was delivered to the receiver. It also handshakes the whole batch before running any
# conn's script (peer_connmap.go:129), so both sessions are established simultaneously;
# check-mode accept is otherwise sequential (peer.go:265-281) and closes conn=1 before
# conn=2 is accepted, which tears the source session down and makes ze withdraw the
# route (the observed 27-byte WITHDRAW) instead of forwarding it.
option=conn_map:value=remote-ip

# Source peer (conn=1): ORIGIN=IGP, AS_PATH=[64496 64512 64497], NEXT_HOP=1.1.1.1, LOCAL_PREF=100, NLRI=10.0.0.0/24
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF003E02000000234001010040020E02030000FBF00000FC000000FBF14003040101010140050400000064180A0000

# Receiver peer (conn=2): private 64512 is gone and local AS 65000 is prepended.
# Expected AS_PATH=AS_SEQUENCE[65000 64496 64497].
#
# ORDERING: the receiver's EOR precedes the forwarded UPDATE on its wire, so it is
# declared first (seq=1) and the announce second (seq=2). This is a guarantee, not a
# race: ze sends a peer its EOR from initial sync at ITS OWN establishment
# (peer_initial_sync.go:333-338), and conn_map completes BOTH handshakes before any
# conn's script runs (peer_connmap.go:129), so the source's UPDATE above is not even
# written until after the receiver has been sent its EOR. Any route arriving during
# initial sync is queued FIFO behind the EOR (peer_initial_sync.go:180-188).
# Declaring the announce at seq=1 makes it unmatchable: an EOR that does not match the
# current rule is silently swallowed (checker.go:414-417), never re-offered.
#
# LOCAL_PREF: this expectation carried 40050400000064 (LOCAL_PREF=100) until the peer
# assertion first actually ran (aaefef8ce); it was hand-authored and never executed, and
# it demanded an RFC violation. LOCAL_PREF arrives from source-peer, an EXTERNAL neighbor,
# so RFC 7606 Section 7.5 requires ze to discard it, and RFC 4271 Section 5.1.5 forbids
# sending it to receiver-peer, also external ("MUST NOT include LOCAL_PREF in UPDATE
# messages sent to external peers", rfc/short/rfc4271.md:381,702). ze discards it in place
# and leaves an ATTR_TOMBSTONE marker per draft-mangin-idr-attr-tombstone-00
# (message/attr_discard.go applyInPlace, on the books since 2026-03-09, predating
# this test): flags 0x80|(0x40&0x50)=0xC0, code 0xFC=252 (attribute.AttrTombstone, the
# single unified code point), value [orig-code 5][reason 1 = DiscardReasonEBGPInvalid]
# then zero-filled -> C0FC0405010000. Same 7 bytes as the LOCAL_PREF it overwrites, so
# the 62-byte length is unchanged. This egress path does not run the Section 5.3
# eBGP Transitive-clear (rewriteASPathPrepend), so the flags byte stays 0xC0.
expect=bgp:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
expect=bgp:conn=2:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
expect=bgp:conn=2:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF003E02000000234001010040020E02030000FDE80000FBF00000FBF140030401010101C0FC0405010000180A0000
EOF_PEER

tmpfs=remove-private-as-export.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
import sys
from ze_api import API

def dispatch(api, command):
    resp = api._call_engine(
        'ze-plugin-engine:dispatch-command', {'command': command})
    if resp is None:
        return {'status': 'error', 'data': 'engine call returned None'}
    return resp.get('result', {})

def updates_sent(api, peer):
    r = dispatch(api, f'show bgp peer {peer} detail')
    for info in r.get('data', {}).get('peers', {}).values():
        return info.get('updates-sent', 0)
    return 0

def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()
    # Deterministic replacement for sleep(4.0): wait until ze has forwarded the
    # policy-stripped route to the receiver peer (updates-sent increments when the
    # UPDATE is emitted), then shut down. The runner-side conn=2 expect verifies the
    # stripped/prepended AS_PATH on the wire.
    if not api.wait_until(lambda: updates_sent(api, 'receiver-peer') >= 1,
                          attempts=150, delay=0.1):
        print('FAIL: ze never forwarded the stripped route to receiver-peer',
              file=sys.stderr)
        sys.exit(1)
    dispatch(api, 'request shutdown')
    api.wait_for_shutdown()

if __name__ == '__main__':
    main()
EOF_RUN

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	internal rs {
		use bgp-rs
	}
	external remove-private-as-export {
		run ./remove-private-as-export.run
		encoder json
	}
}
bgp {
	policy {
		remove-private-as STRIP {
		}
	}
	peer source-peer {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
			rs-fast-path enable
		}
	}
	peer receiver-peer {
		connection {
			remote {
				ip 127.0.0.2
			}
			local {
				ip 127.0.0.2
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65002
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		filter {
			export [ remove-private-as:STRIP ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze --plugin ze.bgp-filter-remove-private-as -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
reject=stderr:pattern=panic
reject=stderr:pattern=fatal error
reject=stderr:pattern=forward-cached failed
reject=stderr:pattern=release-cached failed
reject=stderr:pattern=BUG: ForwardUpdatesDirect
