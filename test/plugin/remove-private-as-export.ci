# Test: remove-private-as export policy strips private ASNs before EBGP prepend
# VALIDATES: export chain removes RFC 6996 Private Use ASNs from AS_PATH before advertisement.
# VALIDATES: EBGP local-AS prepend uses the stripped AS_PATH as its base.
# PREVENTS: export policy rewrite being lost by the EBGP wire cache.

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=2
option=timeout:value=20s
option=bind:value=0.0.0.0
# Map conn=N to a peer by remote IP instead of accept order (peer_connmap.go).
# Without this, conn=N binds to ACCEPT ORDER (peer.go:248), and which peer ze dials
# first is a race (127.0.0.2 observed first in 4/5 runs), so the source's UPDATE below
# was delivered to the receiver. It also handshakes the whole batch before running any
# conn's script (peer_connmap.go:129), so both sessions are established simultaneously;
# check-mode accept is otherwise sequential (peer.go:265-281) and closes conn=1 before
# conn=2 is accepted, which tears the source session down and makes ze withdraw the
# route (the observed 27-byte WITHDRAW) instead of forwarding it.
option=conn_map:value=remote-ip

# Source peer (conn=1): ORIGIN=IGP, AS_PATH=[64496 64512 64497], NEXT_HOP=1.1.1.1, NLRI=10.0.0.0/24
#
# No LOCAL_PREF. source-peer is EXTERNAL, and RFC 4271 Section 5.1.5 forbids
# LOCAL_PREF on an EBGP session ("MUST NOT include LOCAL_PREF in UPDATE messages
# sent to external peers", rfc/short/rfc4271.md:381,702). This frame carried one
# until 2026-08-05. ze handled it correctly, discarding it per RFC 7606 Section
# 7.5 and marking it in place, but that made an RFC-7606 concern ride a test
# whose subject is AS_PATH rewriting. Thomas ruled on 2026-07-16 to take the
# input-side precedent for all three tests that fed an invalid LOCAL_PREF, as the
# interim answer until attribute handling is re-engineered. The two siblings were
# already converted; this is the third. The frame is now byte-identical to
# remove-private-as-replace-peer.ci:40.
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0037020000001C4001010040020E02030000FBF00000FC000000FBF140030401010101180A0000

# Receiver peer (conn=2): private 64512 is gone and local AS 65000 is prepended.
# Expected AS_PATH=AS_SEQUENCE[65000 64496 64497].
#
# The receiver's EOR is NOT asserted on conn=2. An earlier comment here claimed the
# EOR is guaranteed to precede the forwarded route ("queued FIFO behind the EOR"),
# but that is false for a route-server FORWARD: the forward path bypasses the
# initial-sync opQueue that orders the EOR, and AnnounceEOR itself documents that a
# route-server EoR "could race ahead of the still-queued route NLRI and reach the
# wire first" (reactor_api_forward.go:48-58). RFC 4724 Section 4.1
# (rfc/full/rfc4724.txt:303) owes the EOR only after the INITIAL routing update and
# constrains no ordering vs routes learned afterward, so the forward reaching conn=2
# before its EOR is conformant -- and pinning the EOR at conn=2:seq=1 made it a flake.
# The receiver's EOR is still SENT (ze sends one to every established peer); this
# test's subject is the export policy on the forwarded route (conn=2:seq=2), and the
# source's own EOR (conn=1) does not race a forward, so it stays. Measured: with the
# conn=2 EOR rule flaky, without it 18/18. Same fix as bgp-rs-asn4-transcode.ci.
#
# LOCAL_PREF: there is none, on either side, and that is the point.
#
# This expectation once carried 40050400000064 (LOCAL_PREF=100), which demanded an RFC
# violation: RFC 4271 Section 5.1.5 forbids sending LOCAL_PREF to receiver-peer, an
# external neighbor. When the peer assertion first actually ran (aaefef8ce) the frame
# became C0FC0405010000 instead, the ATTR_TOMBSTONE marker ze leaves in place after
# discarding the invalid attribute per RFC 7606 Section 7.5
# (message/attr_discard.go applyInPlace). Both forms are correct ze behavior. Neither
# belongs in THIS test, whose subject is the export policy on AS_PATH.
#
# Per Thomas's 2026-07-16 ruling the invalid LOCAL_PREF is gone from the source frame
# above, so nothing is discarded and no marker is produced. The attribute set is
# ORIGIN, AS_PATH and NEXT_HOP: 28 bytes against the previous 35, and a 55-byte
# message against 62. The load-bearing assertion is unchanged, byte for byte:
# AS_SEQUENCE [65000 64496 64497], private 64512 stripped and local AS 65000 prepended.
# Tombstone marker behavior is covered where it is the subject, not here.
# // the conn=2 EOR rule is removed (RFC 4724 4.1 owes no ordering vs a
# post-initial-update forward; see the ORDERING note above). The forwarded-route
# assertion at conn=2:seq=2 -- this test's subject -- is unchanged.
expect=bgp:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
expect=bgp:conn=2:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0037020000001C4001010040020E02030000FDE80000FBF00000FBF140030401010101180A0000
EOF_PEER

tmpfs=remove-private-as-export.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
import sys
from ze_api import API

def dispatch(api, command):
    resp = api._call_engine(
        'ze-plugin-engine:dispatch-command', {'command': command})
    if resp is None:
        return {'status': 'error', 'data': 'engine call returned None'}
    return resp.get('result', {})

def updates_beyond_eor(api, peer):
    """UPDATEs written to `peer` that were NOT its End-of-RIB.

    updates-sent counts EVERY UPDATE frame, the initial-sync End-of-RIB
    included: RFC 4724 Section 2 makes the marker an UPDATE, so it takes the
    ordinary write path and notifyMessageReceiver
    (internal/component/bgp/reactor/reactor_notify.go) counts it on message TYPE
    with nothing separating it from a route. eor-sent names that subset, so the
    difference is the frames that were not the marker, and it is the only
    reading that witnesses a forward. Pinned by
    TestInitialSyncEORAlsoCountsAsAnUpdateSent
    (internal/component/bgp/reactor/peer_initial_sync_test.go).

    `updates-sent >= 1` is satisfied by establishment ALONE, so the shutdown
    below raced the forward this test asserts. Its sibling
    remove-private-as-replace-peer.ci lost that race under load and read ze's own
    Cease/Administrative Shutdown NOTIFICATION where the conn=2 UPDATE was due
    (plan/journal/gate-verdict-depends-on-the-machine.md, 2026-08-19); this file
    carried the identical gate.
    """
    r = dispatch(api, f'show bgp peer {peer} detail')
    for info in r.get('data', {}).get('peers', {}).values():
        return int(info.get('updates-sent', 0) or 0) - int(info.get('eor-sent', 0) or 0)
    return 0

def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()
    # Deterministic replacement for sleep(4.0): wait until ze has forwarded the
    # policy-stripped route to the receiver peer, then shut down. The predicate is an
    # ORDERING FACT -- a frame that was not the End-of-RIB has been written -- so a
    # shutdown dispatched after it cannot preempt the forward. The attempt budget is a
    # liveness bound whose expiry FAILS loudly; it is not the assertion. The
    # runner-side conn=2 expect verifies the stripped/prepended AS_PATH on the wire.
    if not api.wait_until(lambda: updates_beyond_eor(api, 'receiver-peer') >= 1,
                          attempts=150, delay=0.1):
        print('FAIL: ze never forwarded the stripped route to receiver-peer',
              file=sys.stderr)
        sys.exit(1)
    dispatch(api, 'request shutdown')
    api.wait_for_shutdown()

if __name__ == '__main__':
    main()
EOF_RUN

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	internal rs {
		use bgp-rs
	}
	external remove-private-as-export {
		run ./remove-private-as-export.run
		encoder json
	}
}
bgp {
	policy {
		remove-private-as STRIP {
		}
	}
	peer source-peer {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
			rs-fast-path enable
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
	}
	peer receiver-peer {
		connection {
			remote {
				ip 127.0.0.2
			}
			local {
				ip 127.0.0.2
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65002
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		filter {
			export [ remove-private-as:STRIP ]
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze --plugin ze.bgp-filter-remove-private-as -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
reject=stderr:pattern=panic
reject=stderr:pattern=fatal error
reject=stderr:pattern=forward-cached failed
reject=stderr:pattern=release-cached failed
reject=stderr:pattern=BUG: ForwardUpdatesDirect
