# Test: a forked plugin's own metric reaches the daemon's registry
#
# VALIDATES: a plugin ze runs as its own process publishes the counter it made
#            from Plugin.MetricsRegistry over ze-plugin-engine:metrics-publish,
#            and the daemon shows it under the plugin's name: the declaration
#            at 0 at once, 3 after the plugin's 100ms interval carries the
#            first increment, and 5 after FlushMetrics carries the second.
# PREVENTS: the forked plugin whose ConfigureMetrics registry nothing read, so
#           `show metrics name` never carried a metric the plugin created
#           (plan/journal/process-global-read-across-the-plugin-boundary.md,
#           row 2026-11-03). test/plugin/plugin-metrics-registered.ci covers the
#           in-process route only.

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER


stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external plugin-metrics-forked {
		run "le test fixture plugin/metrics-forked"
		encoder json
	}
}

telemetry {
	prometheus {
		enabled true
		server main {
			ip 127.0.0.1;
			port $PORT2;
		}
	}
}

bgp {
	filter {
		import { final accept; }
		export { final accept; }
	}
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
expect=stderr:pattern=OK: ze_fixture_forked_events_total 5 after FlushMetrics
reject=stderr:pattern=panic recovered
reject=stderr:pattern=fatal error
reject=stderr:pattern=ZE-OBSERVER-FAIL
