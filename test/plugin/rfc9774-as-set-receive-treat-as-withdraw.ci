# rfc9774-as-set-receive-treat-as-withdraw -- RFC 9774 Section 3 receive, end to end
# through the route server.
#
# RFC 9774 Section 3: "BGP speakers: ... MUST use the "treat-as-withdraw" error
# handling behavior per [RFC7606] upon reception of BGP UPDATE messages containing
# AS_SETs or AS_CONFED_SETs in the AS_PATH or AS4_PATH [RFC6793]."
#
# VALIDATES: the source peer announces P (10.1.0.0/24) with a clean AS_PATH, then
# re-announces P with an AS_SET, then announces Q (10.2.0.0/24) with an
# AS_CONFED_SET, then a clean fence route F (10.0.0.0/24). The receiving peer, which
# already holds P, sees P announced, then P withdrawn, then F. Q is never announced,
# no set segment reaches it, neither session is reset, and the log names the
# RFC 9774 verdict.
# PREVENTS: a route whose AS_PATH holds an AS_SET or AS_CONFED_SET being installed
# and relayed.

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=2
option=timeout:value=20s
option=bind:value=0.0.0.0
option=linger:value=true
# Bind conn=N by remote IP: which client connects first is a race (peer_connmap.go).
option=conn_map:value=remote-ip

# Source peer (conn=1, AS 65001, 4-octet ASNs). Every UPDATE carries ORIGIN IGP and
# NEXT_HOP 1.1.1.1.
# seq=1: P, AS_PATH AS_SEQUENCE [65001].
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002F02000000144001010040020602010000FDE940030401010101180A0100
# seq=2: P, AS_PATH AS_SEQUENCE [65001] then AS_SET {65010 65011}.
action=send:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0039020000001E4001010040021002010000FDE901020000FDF20000FDF340030401010101180A0100
# seq=3: Q, AS_PATH AS_SEQUENCE [65001] then AS_CONFED_SET {65020}.
action=send:conn=1:seq=3:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0035020000001A4001010040020C02010000FDE904010000FDFC40030401010101180A0200
# seq=4: the fence F, clean.
action=send:conn=1:seq=4:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002F02000000144001010040020602010000FDE940030401010101180A0000

# Receiver (conn=2, AS 65002, rs-client): P, then P withdrawn, then F.
expect=bgp:conn=2:seq=1:announced=180A0100
expect=bgp:conn=2:seq=2:withdrawn=180A0100
expect=bgp:conn=2:seq=3:announced=180A0000

# Q is never announced, and no set segment ever reaches the receiver.
reject=bgp:conn=2:pattern=180A0200
reject=bgp:conn=2:pattern=01020000FDF20000FDF3
reject=bgp:conn=2:pattern=04010000FDFC

EOF_PEER

# Observer: wait until the route server has replayed the fence prefix to every client, then
# shut down.

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	internal rs {
		use bgp-rs
	}
	internal adj-rib-in {
		use bgp-adj-rib-in
	}
	external shutdown-after-up {
		run "le test fixture plugin/rfc9774-as-set-receive-treat-as-withdraw"
		encoder json
	}
}
bgp {
	# RFC 8212: an EBGP direction with no policy is refused; this test exchanges routes.
	filter {
		import { final accept; }
		export { final accept; }
	}
	peer source-peer {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		attach process adj-rib-in {
			receive [ update-received state ]
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
		attach process shutdown-after-up {
			receive [ update ]
		}
	}
	peer receiver-peer {
		connection {
			remote {
				ip 127.0.0.2
			}
			local {
				ip 127.0.0.2
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65002
			}
			router-id 1.2.3.4
			rs-client true
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		attach process adj-rib-in {
			send [ update ]
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
		attach process shutdown-after-up {
			receive [ update ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
# The receive verdict itself. The send guard would also keep a relayed set off
# the receiver, so the frames above cannot tell the two halves apart; these lines
# can, because only the receive scan writes it. The error log is rate-limited per
# peer, so Q's AS_CONFED_SET verdict, which follows within the interval, is counted
# as suppressed rather than printed; its description is pinned by
# TestRFC9774ReceiveASSetTreatAsWithdraw.
expect=stderr:contains=description="RFC 9774 Section 3: AS_SET in AS_PATH"
reject=stderr:pattern=panic
reject=stderr:pattern=fatal error
