# Test: ASPA verification yields Unknown when no ASPA records cover the path
# VALIDATES: AC-4 — route with no ASPA coverage -> aspa-state=unknown
# PREVENTS: Missing ASPA records incorrectly classified as Valid or Invalid

# ze-peer: send route 10.0.1.0/24 with AS_PATH [64500, 64501, 64502]
# No ASPA records for any AS in path -> Unknown
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
option=update:value=send-route:prefix=10.0.1.0/24:origin-as=64502:next-hop=10.0.0.1:as-path=64500,64501,64502
# EOR from ze
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# Python observer: check aspa-state=unknown
tmpfs=rpki-aspa-unknown-test.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
import sys
from ze_api import API
# // test-relax: removed unused 'import json'/'import time'; read loop is now wait_for_event

def dispatch(api, command):
    resp = api._call_engine(
        'ze-plugin-engine:dispatch-command', {'command': command})
    if resp is None:
        return {'status': 'error', 'data': 'engine call returned None'}
    return resp.get('result', {})

def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()

    api.subscribe(['rpki direction received'])
    api.ready()

    def _match(evt):
        if not isinstance(evt, dict):
            return False
        bgp = evt.get('bgp', {})
        if bgp.get('message', {}).get('type') != 'rpki':
            return False
        rpki = bgp.get('rpki', {})
        if not isinstance(rpki, dict) or rpki.get('status') == 'unavailable':
            return False
        return rpki.get('aspa-state') == 'unknown'

    try:
        if api.wait_for_event(timeout=15.0, predicate=_match) is not None:
            print('OK: rpki event has aspa-state=unknown', file=sys.stderr)
        else:
            print('FAIL: no rpki event with aspa-state=unknown', file=sys.stderr)
            sys.exit(1)
    finally:
        dispatch(api, 'request shutdown')
        api.wait_for_shutdown()

if __name__ == '__main__':
    main()
EOF_RUN

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	hub {
		server local {
			ip 127.0.0.1;
			port 0;
			secret rpki-test-secret-key-01234567890;
		}
	}
	external rpki-aspa-unknown-test {
		run ./rpki-aspa-unknown-test.run
		encoder json
	}
	internal rpki {
		use bgp-rpki
	}
	internal adj-rib-in {
		use bgp-adj-rib-in
	}
}

bgp {
	rpki {
		cache-server 127.0.0.1 {
			port $PORT2
		}
		aspa {
			validation true;
		}
	}
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 64500
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}

		attach process rpki-aspa-unknown-test {
			receive [ rpki-received ]
		}
		attach process rpki {
			receive [ update-received ]
		}
		attach process adj-rib-in {
			receive [ update-received state ]
		}
	}
}
EOF_CONF

# RTR mock: VRP only, NO ASPA records -> ASPA state will be Unknown
cmd=background:seq=1:exec=ze-test rtr-mock --port $PORT2 --vrp 10.0.0.0/8,24,64502
cmd=background:seq=2:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=3:exec=ze -:stdin=ze-bgp:timeout=25s
expect=exit:code=0
