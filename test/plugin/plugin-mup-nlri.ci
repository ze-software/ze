# plugin-mup-nlri - verify MUP plugin NLRI decode
# Tests MUP ISD route type 1 decoding via plugin CLI
# NLRI: architecture type 1, route type 1, RD type 0 (65001:100), prefix 10.0.0.0/24

cmd=foreground:seq=1:exec=ze plugin bgp-nlri-mup --nlri 0100010c0000fde900000064180a0000
expect=exit:code=0
expect=stdout:contains=InterworkSegmentDiscoveryRoute
expect=stdout:contains=prefix_ip_len
expect=stdout:contains=rd
