# Test: SIGTERM runs the drain phase for an in-process plugin (DirectBridge)
# Exercises: SIGTERM -> waitLoop -> config fence -> runStopDrain (cmd/ze/hub/drain.go)
#            -> DrainRound.Run (internal/component/plugin/server/drain.go)
#            -> the plugin's drain caller -> ze-plugin-callback:drain -> OnDrain
#            on the SDK drain worker (pkg/plugin/sdk/sdk_drain.go), here over the
#            DirectBridge of the in-process plugin fakedrain
#            (internal/test/plugins/fakedrain); drain-before-stop.ci is the
#            external, socket mode of the same responder.
# VALIDATES: spec-daemon-drain-before-stop AC-1: the plugin receives drain kind
#            stop while its connection is open, the daemon waits for its answer
#            (held 1 s) before teardown closes the connection, and exits 0.
# PREVENTS:  a stop that tears plugins down with no drain, or closes the plugin
#            connection before the drain is answered. The fixture itself fails
#            the run when its connection closes with no drain answered.

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=20s

expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000

action=sigterm:conn=1:seq=2
EOF_PEER

tmpfs=ze-bgp.conf:terminator=EOF_CONF
plugin {
	internal fakedrain {
		use fakedrain
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze start ze-bgp.conf:timeout=20s
expect=exit:code=0
expect=stderr:contains=drain-fixture: drain received kind=stop
expect=stderr:contains=drain-fixture: drain answered
reject=stderr:contains=drain-fixture: FAIL
