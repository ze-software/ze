# Test: REST config commit/discard emits visible audit entries
# VALIDATES: AC-9, AC-10, and AC-13 -- config commit/discard records audit data queryable by show audit.
# PREVENTS: config-session mutations bypassing the unified audit trail.

option=timeout:value=30s
option=env:var=ZE_STORAGE_BLOB:value=false

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

tmpfs=audit-commit-test.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
import json
import sys
import time
import urllib.error
import urllib.request
from ze_api import API, wait_until, result_json_data

REST_PORT = 18087
BASE_URL = f'http://127.0.0.1:{REST_PORT}/api/v1'
HEADERS = {'Authorization': 'Bearer secret', 'Content-Type': 'application/json'}

def wait_for_rest(url, timeout=10):
    def ok():
        try:
            urllib.request.urlopen(urllib.request.Request(url, headers={'Authorization': 'Bearer secret'}), timeout=2).read()
            return True
        except (urllib.error.URLError, ConnectionRefusedError, OSError):
            return False
    return wait_until(ok, attempts=max(1, int(timeout / 0.5)), delay=0.5)

def request(method, path, payload=None):
    data = None
    headers = dict(HEADERS)
    if payload is not None:
        data = json.dumps(payload).encode()
    req = urllib.request.Request(BASE_URL + path, data=data, headers=headers, method=method)
    resp = urllib.request.urlopen(req, timeout=5)
    raw = resp.read()
    if not raw:
        return {}
    return json.loads(raw)

def dispatch(api, command):
    resp = api._call_engine('ze-plugin-engine:dispatch-command', {'command': command})
    if resp is None:
        return {'status': 'error', 'data': 'engine call returned None'}
    return resp.get('result', {})

def as_dict(data):
    if isinstance(data, str):
        return json.loads(data)
    return data or {}

def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()
    api.wait_for_post_startup(timeout=5.0)

    try:
        if not wait_for_rest(f'{BASE_URL}/commands'):
            print('FAIL: REST API did not respond', file=sys.stderr)
            sys.exit(1)

        created = request('POST', '/config/sessions')
        session_id = created.get('session-id')
        if not session_id:
            print(f'FAIL: create session response={created}', file=sys.stderr)
            sys.exit(1)

        request('PUT', f'/config/sessions/{session_id}', {'path': 'bgp.router-id', 'value': '10.0.0.2'})
        committed = request('POST', f'/config/sessions/{session_id}/commit')
        if committed.get('status') != 'committed':
            print(f'FAIL: commit response={committed}', file=sys.stderr)
            sys.exit(1)
        print('OK: REST config commit succeeded', file=sys.stderr)

        result = api.dispatch_until(
            'show audit action config-commit',
            lambda r: len(result_json_data(r, {}).get('entries', [])) > 0,
        )
        if result.get('status') != 'done':
            print(f'FAIL: show audit status={result.get("status")}', file=sys.stderr)
            sys.exit(1)
        data = as_dict(result.get('data'))
        entries = data.get('entries', [])
        if not entries:
            print('FAIL: show audit returned no config-commit entries', file=sys.stderr)
            sys.exit(1)
        entry = entries[-1]
        if entry.get('action') != 'config-commit' or entry.get('surface') != 'rest' or entry.get('outcome') != 'success':
            print(f'FAIL: unexpected audit entry={entry}', file=sys.stderr)
            sys.exit(1)
        if 'bgp.router-id' not in entry.get('detail', ''):
            print(f'FAIL: audit detail missing bgp.router-id: {entry}', file=sys.stderr)
            sys.exit(1)
        print('OK: show audit includes REST config commit', file=sys.stderr)

        ranged = dispatch(api, 'show audit action config-commit since 1970-01-01T00:00:00Z until 2999-01-01T00:00:00Z')
        if ranged.get('status') != 'done':
            print(f'FAIL: ranged show audit status={ranged.get("status")}', file=sys.stderr)
            sys.exit(1)
        ranged_data = as_dict(ranged.get('data'))
        if ranged_data.get('count', 0) < 1:
            print(f'FAIL: ranged show audit returned no entries: {ranged_data}', file=sys.stderr)
            sys.exit(1)
        print('OK: show audit time range filter includes config commit', file=sys.stderr)

        created = request('POST', '/config/sessions')
        discard_session_id = created.get('session-id')
        if not discard_session_id:
            print(f'FAIL: create discard session response={created}', file=sys.stderr)
            sys.exit(1)
        request('PUT', f'/config/sessions/{discard_session_id}', {'path': 'bgp.router-id', 'value': '10.0.0.3'})
        discarded = request('DELETE', f'/config/sessions/{discard_session_id}')
        if discarded.get('status') != 'discarded':
            print(f'FAIL: discard response={discarded}', file=sys.stderr)
            sys.exit(1)

        result = dispatch(api, 'show audit action config-discard')
        if result.get('status') != 'done':
            print(f'FAIL: show audit discard status={result.get("status")}', file=sys.stderr)
            sys.exit(1)
        data = as_dict(result.get('data'))
        entries = data.get('entries', [])
        if not entries:
            print('FAIL: show audit returned no config-discard entries', file=sys.stderr)
            sys.exit(1)
        entry = entries[-1]
        if entry.get('action') != 'config-discard' or entry.get('surface') != 'rest' or entry.get('outcome') != 'success':
            print(f'FAIL: unexpected discard audit entry={entry}', file=sys.stderr)
            sys.exit(1)
        if '10.0.0.3' not in entry.get('detail', ''):
            print(f'FAIL: discard audit detail missing discarded value: {entry}', file=sys.stderr)
            sys.exit(1)
        print('OK: show audit includes REST config discard', file=sys.stderr)
    finally:
        dispatch(api, 'request shutdown')
        api.wait_for_shutdown()

if __name__ == '__main__':
    main()
EOF_RUN

tmpfs=audit-config-commit.conf:terminator=EOF_CONF
plugin {
	external audit-commit-test {
		run ./audit-commit-test.run
		encoder json
	}
}

environment {
	api-server {
		token "secret";
		rest {
			enabled true;
			server main {
				ip 127.0.0.1;
				port 18087;
			}
		}
	}
}

bgp {
	router-id 1.2.3.4
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze start audit-config-commit.conf:timeout=30s
expect=exit:code=0
expect=file:path=meta/config/active:exists=true
expect=file:path=meta/config/candidate:absent=true
expect=file:path=meta/config/rollback:exists=true
expect=file:glob=rollback/audit-config-commit-*.conf:count=2
expect=file:glob=rollback/audit-config-commit-*.conf:contains=router-id 1.2.3.4
expect=file:glob=rollback/audit-config-commit-*.conf:contains=router-id 10.0.0.2
