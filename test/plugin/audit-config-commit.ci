# Test: REST config commit/discard emits visible audit entries
# VALIDATES: AC-9, AC-10, and AC-13 -- config commit/discard records audit data queryable by show audit.
# PREVENTS: config-session mutations bypassing the unified audit trail.

option=timeout:value=30s
# Keep zefs in the per-test working directory. The observer authenticates with
# the shared bearer token this config names, so a developer database beside the
# ze binary must not switch the API to per-user mode: that mode ignores the
# token, answers 401, and the observer reports it as "REST API did not respond".
option=env:var=ze.config.dir:value=.

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER


tmpfs=audit-config-commit.conf:terminator=EOF_CONF
plugin {
	external audit-commit-test {
		run "le test fixture plugin/audit-config-commit"
		encoder json
	}
}

environment {
	api-server {
		token "secret";
		rest {
			enabled true;
			server main {
				ip 127.0.0.1;
				port 18087;
			}
		}
	}
}

bgp {
	router-id 1.2.3.4
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze start audit-config-commit.conf:timeout=30s
expect=exit:code=0
expect=key:path=meta/config/audit-config-commit.conf/active:exists=true
expect=key:path=meta/config/audit-config-commit.conf/candidate:absent=true
expect=key:path=meta/config/audit-config-commit.conf/rollback:exists=true
expect=key:glob=file/[0-9]*/audit-config-commit.conf:count=2
expect=key:glob=file/[0-9]*/audit-config-commit.conf:contains=router-id 1.2.3.4
expect=key:glob=file/[0-9]*/audit-config-commit.conf:contains=router-id 10.0.0.2
