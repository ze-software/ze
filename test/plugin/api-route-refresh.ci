# Test: route-refresh command sends ROUTE-REFRESH message to peer
# VALIDATES: route-refresh dispatch sends correct RFC 2918 wire message
# PREVENTS: route-refresh silently failing or sending malformed message

# ze-peer expectations
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
# EOR
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
# ROUTE-REFRESH: marker(16) + length(0017=23) + type(05) + AFI(0001) + reserved(00) + SAFI(01)
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170500010001
EOF_PEER

# Native test plugin: exercises dispatch-command for route-refresh

# ze bgp configuration
stdin=ze-bgp:terminator=EOF_CONF
bus {
	endpoint route-refresh {
		internal bgp-route-refresh;
	}
	endpoint bgp-rib {
		internal bgp-rib;
	}
	endpoint route-refresh-test {
		external {
			run "le test fixture plugin/api-route-refresh";
		}
		encoding json;
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				route-refresh enable
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}

	}
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
