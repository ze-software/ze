# Test: BFD Stage 2 transport hardening wiring is live
#
# VALIDATES: spec-bfd-2-transport-hardening -- a pinned single-hop session
#            drives loopFor into the real UDP transport, the loop starts
#            (logging "bfd loop started" with a vrf label), the engine
#            FSM is reachable from a real bound socket, and the plugin
#            stays up until SIGTERM.
# PREVENTS:  regression where Stage 2 wiring drops a pinned session on the
#            floor, the loop does not bind, or the Stage 1 "VRF not yet
#            supported" error path re-appears.
#
# Method: a compiled driver launches ze with pinned single-hop and
# multi-hop sessions, captures every Stage 2 lifecycle line, then
# terminates the daemon cleanly.

option=env:var=ze.bfd.test-parallel:value=true
# BFD listens on the RFC 5881 / RFC 5883 FIXED ports, so every concurrently
# running BFD test's daemon binds the same wildcard (0.0.0.0, 3784/3785) tuple.
# SO_REUSEPORT above lets them co-bind, and the kernel then HASHES each inbound
# datagram to one socket in the group (internal/component/bfd/transport/
# udp_linux.go applySocketOptions) -- so a control reply or a reflected echo meant
# for this daemon can be delivered to a sibling test's daemon instead. That is the
# kernel-global surface option=exclusive exists for: unique addresses cannot
# partition a port number the RFC fixes. Tests outside the group still run
# alongside these.
option=exclusive:group=bfd-ports


cmd=foreground:seq=1:exec=ze-test fixture plugin/bfd-transport-stage2:timeout=20s
expect=exit:code=0
expect=stderr:pattern=bfd plugin starting
expect=stderr:pattern=bfd loop started
expect=stderr:pattern=bfd pinned session created
expect=stderr:pattern=mode=single-hop
expect=stderr:pattern=mode=multi-hop
