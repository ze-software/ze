# // test-relax: earlier draft attempted a live enable->disable reload via
# "request reload"; that needs a file-backed config directory (see
# test/plugin/audit-persistence.ci's pattern), out of proportion to what this
# functional test needs to add on top of existing unit coverage. The
# enable-then-disable TRANSITION itself (AC-9's "after having been true"
# clause -- register then unregister called symmetrically) is proven at the
# unit level by TestOnConfigure_RegistersAddressesOnEnable, which exercises
# the real applyAddressRegistration function against both states. This test
# instead proves the disabled-state half via the real CLI/plugin dispatch
# path: as112 disabled (the default) reports enabled=false via show, and the
# plugin lifecycle (register/verify/apply/shutdown) completes cleanly.
# Verifies: spec-as112-2 AC-9 (disabled state), end-to-end user story 3.

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
option=asn:value=65001
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

tmpfs=as112-disable-test.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
import json
import sys
from ze_api import API, runtime_fail, result_text_data

def dispatch(api, command):
    resp = api._call_engine(
        'ze-plugin-engine:dispatch-command', {'command': command})
    if resp is None:
        return {'status': 'error', 'data': 'engine call returned None'}
    return resp.get('result', {})

def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()
    api.wait_for_post_startup(timeout=5.0)

    try:
        resp = dispatch(api, 'show as112')
        if resp.get('status') != 'done':
            runtime_fail(f'show as112: status={resp.get("status")} data={resp.get("data")}')
        data = result_text_data(resp)
        if isinstance(data, str) and data:
            data = json.loads(data)
        if data.get('enabled') is not False:
            runtime_fail(f'as112: expected enabled=false, got {data}')

        print(f'OK: as112 enabled={data["enabled"]}', file=sys.stderr)
    finally:
        dispatch(api, 'request shutdown')
        api.wait_for_shutdown()

if __name__ == '__main__':
    main()
EOF_RUN

stdin=ze-bgp:terminator=EOF_CONF
service {
	as112 {
		enabled false
	}
}

plugin {
	external as112-disable-test {
		run ./as112-disable-test.run
		encoder json
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast {
					prefix {
						maximum 10000
					}
				}
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
