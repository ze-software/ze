# Test: redistribute-l2tp -- no import rule means no UPDATE reaches the peer.
# VALIDATES: AC-7 -- without redistribute import l2tp, event is emitted but
#            consumer filter rejects; peer receives no UPDATE.
# PREVENTS: False positive where events leak through without a matching
#           import rule.

# ze-peer -- session establishes (the initial-sync EOR is the only expected
# wire message; an empty expectation set would make ze-peer exit with "no test
# data available", leaving no listener and no real session).
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=10s
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# Python observer plugin: emit an event, wait, then shut down cleanly.
tmpfs=l2tp-nocfg-test.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
from ze_api import API, runtime_fail, result_json_data


def dispatch(api, command):
    return api._call_engine('ze-plugin-engine:dispatch-command', {'command': command}) or {}


def peer_field(api, field, default):
    result = dispatch(api, 'show bgp peer peer1 detail').get('result', {})
    if result.get('status') != 'done':
        return default
    data = result_json_data(result, {})
    return data.get('peers', {}).get('127.0.0.1', {}).get(field, default)


def wait_peer(api, predicate, what, cycles=100):
    for _ in range(cycles):
        if predicate():
            return
        api.wait_for_event(timeout=0.2)
    runtime_fail(f'timeout waiting for {what}')


def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()

    # The peer completes at the initial EOR and exits; per-session counters
    # are cleared on teardown (ClearStats), so wait on the LIFETIME
    # connections-established counter: a deterministic session-came-up proof
    # replacing the old fixed sleep.
    wait_peer(api,
              lambda: peer_field(api, 'connections-established', 0) >= 1,
              'peer1 session established at least once')

    resp = dispatch(api, 'request fakel2tp emit add ipv4/unicast 10.0.0.1/32')
    result = resp.get('result', {})
    if result.get('status') != 'done':
        runtime_fail(f'request fakel2tp emit failed: {result}')
        return

    # Bounded observation window (event-wait backoff, no fixed sleep): if the
    # un-imported emit were going to reach the reactor, it would within this
    # window. The gate stays the documented clean, healthy exit.
    for _ in range(10):
        api.wait_for_event(timeout=0.2)

    dispatch(api, 'request shutdown')
    api.wait_for_shutdown()


if __name__ == '__main__':
    main()
EOF_RUN

# ze configuration -- NO redistribute import l2tp block.
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external l2tp-nocfg-test {
		run ./l2tp-nocfg-test.run
		encoder json
	}
	internal fakel2tp {
		use fakel2tp
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65533
				remote 65533
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=10s
expect=exit:code=0
