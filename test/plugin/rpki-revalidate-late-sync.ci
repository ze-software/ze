# Test: a route validated against an empty VRP set is re-validated when the cache syncs
# VALIDATES: RFC 6811 Section 4 re-validation reaches the Adj-RIB-In -- a route installed as
#            NotFound before the cache answered is removed once the VRPs make it Invalid
# PREVENTS: bgp-rpki re-dispatching a decision that bgp-adj-rib-in drops, which pins every route to
#           the state it carried on arrival for the life of the session
#
# Flow:
# 1. the RTR cache holds its answer back 3 seconds (--sync-delay)
# 2. ze-peer sends 10.0.1.0/24 from AS 65999; the VRP set is still empty, so the route validates
#    NotFound and `not-found accept` installs it
# 3. the cache answers: 10.0.0.0/8 maxlen 24 AS 65001 covers the prefix, the route is Invalid, and
#    `invalid reject` must take it back out of the Adj-RIB-In

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=25s
# Hold the session open past this peer's own completion. Without it the peer closes as soon as it
# has sent its UPDATE and seen ze's EOR, ze treats that as session-down, and bgp-adj-rib-in drops
# the peer's stored routes (rib.go, "delete(r.ribIn, peerAddr)") -- so every poll below would read
# an empty RIB and prove nothing. Same lever as role-otc-export-unknown.ci.
option=linger:value=true
option=update:value=send-route:prefix=10.0.1.0/24:origin-as=65999:next-hop=10.0.0.1
# EOR from ze
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# Python test plugin: the route must be installed while the cache is silent, and gone after it syncs
tmpfs=rpki-late-sync-test.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
"""Verify RFC 6811 Section 4 re-validation reaches the Adj-RIB-In."""
import sys
from ze_api import API, runtime_fail, result_json_data

def dispatch(api, command):
    resp = api._call_engine(
        'ze-plugin-engine:dispatch-command', {'command': command})
    if resp is None:
        return {'status': 'error', 'data': 'engine call returned None'}
    return resp.get('result', {})

def vrp_count(api):
    d = result_json_data(dispatch(api, 'show bgp rpki status'), {})
    return d.get('vrp-count-ipv4', 0) if isinstance(d, dict) else 0

def updates_received(api):
    r = dispatch(api, 'show bgp peer peer1 detail')
    return r.get('data', {}).get('peers', {}).get('127.0.0.1', {}).get('updates-received', 0)

def adj_rib_total(api):
    result = dispatch(api, 'show bgp adj-rib-in status')
    if result.get('status') != 'done':
        fail(api, f'adj-rib-in query failed, status={result.get("status")}')
    return result_json_data(result, {}).get('total-routes', -1)

def fail(api, message):
    print(f'FAIL: {message}', file=sys.stderr)
    sys.stderr.flush()
    runtime_fail(message)

def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()

    # The cache holds its answer back, so the UPDATE is validated against an empty VRP set:
    # NotFound, which `not-found accept` installs.
    if not api.wait_until(lambda: updates_received(api) >= 1, attempts=24):
        fail(api, 'ze never received the UPDATE')
    if not api.wait_until(lambda: adj_rib_total(api) >= 1, attempts=24):
        fail(api, 'route 10.0.1.0/24 was never installed as NotFound')

    # Without this the run could pass on the ordinary ordering as well: a cache that answered first
    # rejects the route on arrival, and the poll below would prove nothing about re-validation.
    if vrp_count(api) != 0:
        fail(api, 'the cache synced before the UPDATE arrived, so this run does not exercise '
                  're-validation')

    # The cache answers. The VRP covers the prefix with AS 65001, the route's origin is AS 65999,
    # and `invalid reject` must take the route back out of the Adj-RIB-In.
    if not api.wait_until(lambda: vrp_count(api) >= 1, attempts=24):
        fail(api, 'the RTR cache never synced a VRP')
    if not api.wait_until(lambda: adj_rib_total(api) == 0, attempts=24):
        fail(api, 'route 10.0.1.0/24 stayed in the Adj-RIB-In after the VRP made it Invalid')

    print('OK re-validation removed 10.0.1.0/24 once the cache synced', file=sys.stderr)
    sys.stderr.flush()
    dispatch(api, 'request shutdown')
    api.wait_for_shutdown()

if __name__ == '__main__':
    main()
EOF_RUN

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	hub {
		server local {
			ip 127.0.0.1;
			port 0;
			secret rpki-test-secret-key-01234567890;
		}
	}
	external rpki-late-sync-test {
		run ./rpki-late-sync-test.run
		encoder json
	}
	internal rpki {
		use bgp-rpki
	}
	internal adj-rib-in {
		use bgp-adj-rib-in
	}
}

bgp {
	rpki {
		cache-server 127.0.0.1 {
			port $PORT2
		}
		action {
			invalid reject
			not-found accept
		}
	}
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}

		process rpki-late-sync-test {
		}
		process rpki {
			receive [ update ]
		}
		process adj-rib-in {
			receive [ update state ]
		}
	}
}
EOF_CONF

# VRP: 10.0.0.0/8 maxlen=24 AS=65001, answered 3 seconds after ze asks, so the UPDATE is validated
# against an empty cache first (the ordering this test exists for).
cmd=background:seq=1:exec=ze-test rtr-mock --port $PORT2 --sync-delay 3s --vrp 10.0.0.0/8,24,65001
cmd=background:seq=2:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=3:exec=ze -:stdin=ze-bgp:timeout=30s
expect=exit:code=0
# The observer's success line. A plugin that dies before printing it -- a Python error, a missed
# subscription -- fails the test here rather than passing on ze's clean exit.
expect=stderr:pattern=OK re-validation removed 10.0.1.0/24 once the cache synced
