# addpath-departure-rr-gr-retained: a Graceful Restart source announces two
# paths of one prefix through bgp-rr to a receiver that negotiated ADD-PATH,
# then its TCP session drops and it reconnects.
# RFC 4724 Section 4.2: "it MUST retain the routes received from the peer for
# all the address families that were previously received in the Graceful
# Restart Capability".
# VALIDATES: the source sends 10.0.0.0/8 under Path Identifiers 11 and 12, ze
# re-advertises both to the receiver under its own identifiers 0 and 1, and
# the source closes TCP with no NOTIFICATION. bgp-gr retains ipv4/unicast, so
# bgp-rr hands no departure to the engine and the receiver is sent nothing.
# The reconnected source then announces 172.16.0.0/16, and that announcement
# is the receiver's very next UPDATE.
# PREVENTS: bgp-rr sending a retained family's routes to the engine's
# source-DOWN recovery, which withdraws each destination's own identifier, so
# the receiver lost both paths during the restart window. The receiver's
# second UPDATE was then the withdrawal of identifiers 0 and 1.

# The await needle below is bgp-gr's debug line for the source's OPEN.
option=env:var=ze.log.bgp.gr:value=debug

stdin=source:terminator=EOF_SOURCE
option=tcp_connections:value=2
option=timeout:value=60s
option=asn:value=65000
option=open:value=router-id:id=127.0.0.1
option=await-file:path=receiver-up
# The reconnected session stays up: a second close would end the restart
# under test before the receiver reads its next UPDATE.
option=linger:value=true
# ORIGIN IGP, empty AS_PATH, NEXT_HOP 192.0.2.1, LOCAL_PREF 100,
# NLRI [0000000B][8][10] [0000000C][8][10].
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0038020000001540010100400200400304C0000201400504000000640000000B080A0000000C080A
# The receiver's own route reflected here proves the receiver already holds
# both paths: it sends 198.51.100.0/24 only after it was sent them. Closing
# earlier would race the reflection, which ze refuses for a source no longer
# established.
expect=bgp:conn=1:seq=2:contains=18C63364
# A TCP close with no NOTIFICATION: RFC 4724 Section 4.2 retention applies.
action=close:conn=1:seq=3
# The same attributes announce [00000001][16][172.16]. No End-of-RIB follows,
# so the retained paths stay stale for the whole restart time.
action=send:conn=2:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0033020000001540010100400200400304C0000201400504000000640000000110AC10
EOF_SOURCE

stdin=receiver:terminator=EOF_RECEIVER
option=tcp_connections:value=1
option=timeout:value=60s
option=asn:value=65000
option=linger:value=true
option=established-file:path=receiver-up
# ze's own identifiers come from one counter in a fresh daemon: 0 and 1 for
# the two paths of 10.0.0.0/8.
expect=bgp:conn=1:seq=1:announced=00000000080A00000001080A
# ORIGIN IGP, empty AS_PATH, NEXT_HOP 192.0.2.2, LOCAL_PREF 100,
# NLRI 198.51.100.0/24: the signal bgp-rr reflects to the source.
action=send:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0030020000001540010100400200400304C00002024005040000006418C63364
# The very next UPDATE is the reconnected source's announcement of
# 172.16.0.0/16, not a withdrawal of the retained paths.
expect=bgp:conn=1:seq=3:contains=10AC10
EOF_RECEIVER

stdin=ze-bgp:terminator=EOF_CONF
plugin {
    internal relay { use bgp-rr; }
    internal gr { use bgp-gr; }
}
bgp {
    peer source {
        connection {
            remote { ip 127.0.0.1; }
            local { ip 127.0.0.3; accept false; }
        }
        session {
            asn { local 65000; remote 65000; }
            router-id 1.2.3.4
            route-reflector-client true; cluster-id 10.0.0.1
            family {
                ipv4/unicast { prefix { maximum 10000; } }
            }
            capability {
                graceful-restart { restart-time 60; }
                add-path { direction receive; family { ipv4/unicast; } }
            }
        }
        behavior { group-updates disable; }
        timer { connect-retry 5; }
        attach process gr {
            receive [ open-received state eor ]
            send [ update ]
        }
        attach process relay {
            receive [ update-received state open-received refresh ]
            send [ update ]
        }
        attach process bgp-rib {
            receive [ update state refresh ]
            send [ update ]
        }
    }
    peer receiver {
        connection {
            remote { ip 127.0.0.2; }
            local { ip 127.0.0.4; accept false; }
        }
        session {
            asn { local 65000; remote 65000; }
            router-id 1.2.3.4
            route-reflector-client true; cluster-id 10.0.0.1
            family {
                ipv4/unicast { prefix { maximum 10000; } }
            }
            capability {
                graceful-restart disable
                add-path { direction send; family { ipv4/unicast; } }
            }
        }
        behavior { group-updates disable; }
        attach process relay {
            receive [ update-received state open-received refresh ]
            send [ update ]
        }
        attach process bgp-rib {
            receive [ update state refresh ]
            send [ update ]
        }
    }
}
EOF_CONF

cmd=background:seq=1:exec=le test peer --port $PORT:stdin=source
cmd=background:seq=2:exec=le test peer --bind 127.0.0.2 --port $PORT:stdin=receiver
cmd=foreground:seq=3:exec=ze -:stdin=ze-bgp:timeout=60s
# Both peers linger, so ze is stopped once each has met every expectation.
await=stderr:contains=gr: stored peer GR capability:then=stop
expect=exit:code=0
reject=stderr:pattern=panic recovered
reject=stderr:pattern=fatal error
reject=stderr:pattern=ZE-OBSERVER-FAIL
