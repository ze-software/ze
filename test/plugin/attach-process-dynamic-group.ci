# Test: a group's `attach process` block reaches every member it produces --
#       a peer generated by a dynamic group, a member that states no block of
#       its own, and a member that restates the block with its own list.
# Exercises: group config -> ResolveBGPTree's group merge -> ParseDynamicGroupTemplate
#            -> buildDynamicPeerSettings (internal/component/bgp/reactor/reactor_dynamic.go)
#            -> Reactor.publishDeliveryGraphLocked -> Server.PeerScopedProcs.
# VALIDATES: AC-6 (a peer created from a dynamic group is fed by its group's
#            list, and no config names its generated `dyn-<addr>` identity) and
#            AC-6b (a member's own list REPLACES its group's, while every other
#            member keeps the group's).
# PREVENTS: an IXP route server whose members are fed nothing. A delivery index
#           built from the config DOCUMENT rather than from resolved settings
#           misses every inherited binding, and a dynamic member is named by no
#           document at all.
#
# One program, three peers, three relationships, and only the config separates
# them: the program subscribes to update AND state for every peer.
#
#   dyn-<addr>  from `group ix`      -> state only, inherited, never named
#   inherits    in `group transit`   -> state only, inherited
#   restates    in `group transit`   -> received updates only, its own list
#
# Every peer sends an UPDATE and every session changes state, so each of the
# three assertions is about an event that WAS available and was withheld. Under
# a union merge `restates` is fed state as well; under a document-driven index
# `dyn-` and `inherits` are fed nothing at all.
#
# Topology. ze DIALS the two static members, so their source address is the one
# their config states, and ze ACCEPTS the dynamic one, because that is the only
# shape a dynamic group has. The test port override (ze.test.bgp.port) flattens
# every BGP port to $PORT, so no endpoint may share an address with another:
# each listening peer binds its own, and ze listens on 127.0.0.2 alone.

# The member that keeps its group's list. ze dials it at 127.0.0.3.
stdin=inherits:terminator=EOF_INHERITS
option=asn:value=65001
option=tcp_connections:value=1
option=timeout:value=30s
# ORIGIN=IGP, AS_PATH=[65001], NEXT_HOP=1.1.1.1, LOCAL_PREF=100, NLRI 10.0.0.0/24.
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0036020000001B4001010040020602010000FDE94003040101010140050400000064180A0000
EOF_INHERITS

# The member that restates the block. ze dials it at 127.0.0.4.
stdin=restates:terminator=EOF_RESTATES
option=asn:value=65001
option=tcp_connections:value=1
option=timeout:value=30s
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0036020000001B4001010040020602010000FDE94003040101010140050400000064180A0000
EOF_RESTATES

# The dynamic member. It DIALS ze, and the peer it becomes is named by nothing
# in the config: `dyn-<source address>` is generated at the moment ze accepts.
stdin=dynamic:terminator=EOF_DYNAMIC
option=asn:value=65001
option=tcp_connections:value=1
option=timeout:value=30s
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0036020000001B4001010040020602010000FDE94003040101010140050400000064180A0000
EOF_DYNAMIC

tmpfs=dyn-group-observer.run:mode=755:terminator=EOF_OBSERVER
#!/usr/bin/env python3
import json
import sys

from ze_api import API, runtime_fail

WANTED = {"dyn", "inherits", "restates"}


def facts(raw):
    """The peer name, message type and direction of one delivered event."""
    try:
        decoded = json.loads(raw)
    except (json.JSONDecodeError, TypeError, ValueError):
        return "", "", ""
    body = decoded.get("bgp", decoded)
    peer = body.get("peer", {})
    message = body.get("message", {})
    return peer.get("name", ""), message.get("type", ""), message.get("direction", "")


def relationship(name):
    """A dynamic member is known by the identity ze generated for it."""
    return "dyn" if name.startswith("dyn-") else name


def refuse(who, kind, direction):
    """The reason an event must not have been delivered, or None."""
    if who in ("dyn", "inherits"):
        if kind != "state":
            return f"{who} is granted state alone by its group and was fed {kind} ({direction})"
        return None
    if who == "restates":
        if kind != "update":
            return f"restates states its own list, update-received, and was fed {kind}"
        if direction != "received":
            return f"restates is granted update-received and was fed an update ze SENT"
        return None
    return f"an event arrived for a peer no attach block covers: {who!r}"


def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    # Wide on purpose: every peer, both types. The config is the only thing that
    # can tell the three relationships apart.
    api.subscribe(["update", "state"])
    api.ready()
    # The barrier the dynamic member waits on. ze binds the group's listener
    # before its plugins finish starting, so a member that connects at once
    # raises its session-up event into an empty subscriber list and nothing
    # replays it (plan/journal/session-up-before-its-subscriber.md). An IXP
    # member joins a daemon that is already serving, and so does this one.
    with open("observer.ready", "w") as marker:
        marker.write("ready")

    seen = set()
    while seen != WANTED:
        event = api.wait_for_event(timeout=25.0)
        if event is None:
            runtime_fail(f"DYN-GROUP: never fed {sorted(WANTED - seen)}")
            return
        name, kind, direction = facts(event)
        who = relationship(name)
        reason = refuse(who, kind, direction)
        if reason is not None:
            runtime_fail(f"DYN-GROUP: {reason}")
            return
        seen.add(who)

    print("DYN-GROUP: the dynamic member was fed its group's list", file=sys.stderr, flush=True)
    print("DYN-GROUP: the member that states no block kept its group's list", file=sys.stderr, flush=True)
    print("DYN-GROUP: the member that restates it replaced its group's list", file=sys.stderr, flush=True)

    # Everything ze had to hand out has been handed out, so a further event is a
    # grant the config does not make.
    api.quiesce()
    leaked = api.wait_for_event(timeout=2.0)
    while leaked is not None:
        name, kind, direction = facts(leaked)
        reason = refuse(relationship(name), kind, direction)
        if reason is not None:
            runtime_fail(f"DYN-GROUP: {reason}")
            return
        leaked = api.wait_for_event(timeout=2.0)

    print("DYN-GROUP: no peer was fed outside its list", file=sys.stderr, flush=True)
    api.dispatch("request shutdown")
    api.wait_for_shutdown()


if __name__ == '__main__':
    main()
EOF_OBSERVER

expect=stderr:pattern=DYN-GROUP: the dynamic member was fed its group's list
expect=stderr:pattern=DYN-GROUP: the member that states no block kept its group's list
expect=stderr:pattern=DYN-GROUP: the member that restates it replaced its group's list
expect=stderr:pattern=DYN-GROUP: no peer was fed outside its list
# The dynamic peer really was built from the group rather than matched to a
# configured address. Without this the three lines above would hold for any
# peer ze accepted. "dynamic peer created" is Info on the reactor subsystem.
expect=stderr:contains=dynamic peer created

option=env:var=ze.log.bgp.reactor:value=info

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external dyn-group-observer {
		run ./dyn-group-observer.run
		encoder json
	}
}

bgp {
	group ix {
		connection {
			remote {
				ip dynamic
				connect false
				range 127.0.0.0/8
			}
			local {
				ip 127.0.0.2
				accept true
			}
		}
		session {
			asn {
				local 65000
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		attach process dyn-group-observer {
			receive [ state ]
		}
	}

	group transit {
		session {
			asn {
				local 65000
				remote 65001
			}
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		attach process dyn-group-observer {
			receive [ state ]
		}

		peer inherits {
			connection {
				remote {
					ip 127.0.0.3
				}
				local {
					ip 127.0.0.1
					accept false
				}
			}
			session {
				router-id 1.2.3.5
			}
		}

		peer restates {
			connection {
				remote {
					ip 127.0.0.4
				}
				local {
					ip 127.0.0.1
					accept false
				}
			}
			session {
				router-id 1.2.3.6
			}
			attach process dyn-group-observer {
				receive [ update-received ]
			}
		}
	}
}
EOF_CONF

# The barrier that puts the dynamic member's connection after the observer's
# subscription. A foreground non-ze script that precedes other commands is
# waited for, and a foreground ze daemon is not, so the daemon starts at seq=3,
# this blocks at seq=4, and the member dials at seq=5.
tmpfs=wait-observer.sh:terminator=EOF_WAIT
#!/bin/sh
# Poll, do not spin. Each iteration forks nothing, but a tight loop starves the
# daemon it waits for (ai/rules/no-fork-loops.md). 0.1s x 200 bounds the wait at
# 20 seconds and fails loudly rather than hanging.
i=0
while [ "$i" -le 200 ]; do
	if [ -f observer.ready ]; then
		exit 0
	fi
	i=$((i + 1))
	sleep 0.1
done
echo "the observer never reached its ready RPC, so no subscription exists to test" >&2
exit 1
EOF_WAIT

cmd=background:seq=1:exec=ze-peer --bind 127.0.0.3 --port $PORT:stdin=inherits
cmd=background:seq=2:exec=ze-peer --bind 127.0.0.4 --port $PORT:stdin=restates
cmd=foreground:seq=3:exec=ze -:stdin=ze-bgp:timeout=45s
cmd=foreground:seq=4:exec=sh wait-observer.sh:timeout=25s
cmd=background:seq=5:exec=ze-peer --dial 127.0.0.2:$PORT:stdin=dynamic
expect=exit:code=0
