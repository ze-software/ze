# Test: enable records a best route the Loc-RIB learned before it.
# VALIDATES: `request bgp rib fastpath enable` rebuilds the tracker's state from
#            the Loc-RIB, so the enable answer itself counts the peer's route
#            (prefixes=1, replayed=1) although it arrived while the fast path
#            was off.
# PREVENTS: a best route installed before enable staying out of status until it
#           changes (plan/journal/announced-state-never-replayed.md, found by
#           the bgp-rs-fastpath.ci load red).

option=timeout:value=20s

# ze-peer announces the route as soon as the session is up. The observer waits
# until the Loc-RIB holds it (show bgp rib rpf) and only then enables the fast
# path. linger keeps the route installed while the observer checks: without it
# the peer closes on ze's End-of-RIB and ze withdraws the route on session down.
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=linger:value=true
option=update:value=send-route:prefix=10.20.30.0/24:origin-as=65001:next-hop=101.1.101.1
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# Test plugin: wait for the route in the Loc-RIB, enable the fast path, and
# require the enable answer to record it.

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external bgp-rs-fastpath-replay {
		run "le test fixture plugin/bgp-rs-fastpath-replay"
		encoder json
	}
	internal bgp-rib {
		use bgp-rib
	}
}

bgp {
	# RFC 8212: an EBGP direction with no policy is refused; this test exchanges routes.
	filter {
		import { final accept; }
		export { final accept; }
	}
	peer test-peer {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.5
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}

		attach process bgp-rib {
			receive [ update state refresh ]
			send [ update ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=20s
