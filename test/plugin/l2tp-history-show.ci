# Test: show l2tp {session history|session traffic|tunnel history} <id>
# Exercises: dispatch-command -> ze-l2tp-api:{session-history,session-traffic,
#            tunnel-history} -> handleSessionHistory/handleSessionTraffic/
#            handleTunnelHistory.
# Verifies the R9 rename split (`session-history` -> `session history`, etc.)
# dispatches end-to-end with a live tunnel+session: each id-scoped command
# resolves via its container path, passes the trailing id as args[0], and
# returns done with the FSM/traffic JSON. (Existing l2tp-session-detail-show.ci
# / l2tp-tunnel-detail-show.ci cover the `... id <id>` siblings, not these.)
# Native (l2tp control-plane, kernel probe skipped).

option=env:var=ze.l2tp.skip-kernel-probe:value=true
# The kernel data plane is DISABLED for this test. skip-kernel-probe above bypasses
# only the modprobe; on a host where l2tp_netlink is already loaded the genl tunnel
# create still runs and needs CAP_NET_ADMIN, which is why this test used to fail
# unprivileged with "session never established". With no kernel worker the session
# establishes on the control plane alone, which is the whole of what this test
# asserts -- it reads the CLI surface, never the kernel's view. A test that DOES
# need the data plane must not set this (see test/l2tp/session-stopccn-cascade.ci).
option=env:var=ze.l2tp.disable-kernel-dataplane:value=true
option=env:var=TEST_SECRET:value=l2tp-history-secret
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=20s
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER


stdin=ze-conf:terminator=EOF_CONF
plugin {
	external l2tp-history-test {
		run "ze-test fixture plugin/l2tp-history-show"
		encoder json
	}
}

environment {
	log {
		l2tp debug
	}
	l2tp {
		server main {
			ip 127.0.0.1
			port $PORT2
		}
	}
}

l2tp {
	enabled true
	shared-secret l2tp-history-secret
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=background:seq=2:exec=ze-test fixture plugin/l2tp-history-show-peer $PORT2 0x0123 500
cmd=foreground:seq=3:exec=ze -:stdin=ze-conf:timeout=20s
expect=exit:code=0
expect=stderr:contains=tunnel now established
