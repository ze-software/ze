# Test: family-filter tear-down closes the session on a received family
# VALIDATES: AC-5 -- import tear-down ipv4/flow: a received FlowSpec UPDATE makes
#            ze request a BGP NOTIFICATION + session close.
# PREVENTS: a prohibited family being accepted instead of tearing the session down.
#
# Flow:
# 1. ze-peer sends a raw-hex FlowSpec UPDATE (ipv4/flow, dest 10.1.0.0/24 tcp 80).
# 2. The import chain calls bgp-filter-family:Kill (family ipv4/flow, action tear-down).
# 3. The handler returns Teardown -> the reactor sends NOTIFICATION + closeConn.
# 4. Assertions confirm the decision log on stderr.

option=env:var=ze.log.bgp.filter.family:value=info

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
# FlowSpec UPDATE (same wire as flowspec-fw-add.ci): MP_REACH ipv4/flow, dest 10.1.0.0/24 protocol tcp dport 80
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF004802000000314001010040020040050400000064C010080800000000000001800E150001850401020304000B01180A0100038106058150
EOF_PEER


stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external test-family-teardown {
		run "ze-test fixture plugin/filter-family-import-teardown"
		encoder json
	}
}
bgp {
	policy {
		family-filter Kill {
			family ipv4/flow
			action tear-down
		}
	}

	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/flow { prefix { maximum 10000; } }
			}
		}

		filter {
			import [ bgp-filter-family:Kill ]
		}

		attach process test-family-teardown {
			receive [ update state ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze --plugin ze.bgp-filter-family --plugin ze.bgp-nlri-flowspec -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
# The family filter must have requested a session tear-down.
expect=stderr:pattern=filter-family tear-down
expect=stderr:pattern=filter=Kill
