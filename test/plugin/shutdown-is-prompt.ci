# Test: an operator stops ze and it exits on its own, warning about nothing left behind
# Exercises: request shutdown -> Server.Wait -> apiServer.Stop -> eng.Stop
#            (cmd/ze/hub/main.go) with the bgp plugin loaded, which is the engine
#            whose shutdown used to re-enter the plugin server that hosts it.
# VALIDATES: spec-fixit-shutdown-waits-out-a-deadlock AC-2 and AC-7 at the daemon:
#            the stop finishes inside the hub's own 3s budget, and no plugin engine
#            outlasts pluginStopGrace, so nothing reports a possible leak.
# PREVENTS:  the cycle coming back. Reactor.cleanup stopping the hub's plugin server
#            made every clean stop wait 3.0s + 0.5s and log "resources it installed
#            may be left behind", on a daemon that had released everything.

# No skip-os. Nothing here is platform-specific: the cycle this test pins lives in
# Reactor.cleanup and ProcessManager.Stop, which have no build-tagged variant. The
# file carried option=skip-os:value=darwin until 2026-08-23, and that skip made the
# ONE functional proof of a defect no gate could see invisible on the primary
# development machine. Measured with the skip removed: 5 of 5 pass on darwin in 1.1s
# to 2.3s against this 30s budget, and with both ownership guards reverted the same
# darwin run fails on `reject=stderr:pattern=may be left behind` 3.001s after the
# shutdown request. It discriminates here; do not skip it here.

option=timeout:value=30s

# Native observer fixture: plugin/shutdown-is-prompt.

stdin=ze-conf:terminator=EOF_CONF
plugin {
	external shutdown-is-prompt {
		run "ze-test fixture plugin/shutdown-is-prompt"
		encoder json
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

cmd=foreground:seq=1:exec=ze -:stdin=ze-conf:timeout=30s
expect=exit:code=0
expect=stderr:contains=OK: daemon up, requesting shutdown
expect=stdout:contains=Ze stopped.
reject=stderr:pattern=may be left behind
reject=stderr:pattern=shutdown timeout
reject=stderr:pattern=panic
