# Test: bgp-redistribute -- remove event becomes a BGP WITHDRAWN_ROUTES message.
# VALIDATES: AC-8 -- accepted remove batch dispatches `update text nlri ipv4/unicast del 10.0.0.1/32`.
# PREVENTS: Withdraw path missing or building wrong NLRI.

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
# First the announce, then the withdraw. The wire expectations are what make
# ze-peer bind and check; the announce and the withdraw have DIFFERENT shapes:
#  seq=1 announce: attrs ORIGIN incomplete, empty AS_PATH (iBGP), NEXT_HOP
#        127.0.0.1, LOCAL_PREF 100 (well-known mandatory on iBGP, RFC 4271 5.1.5),
#        then NLRI 10.0.0.1/32.
#  seq=2 withdraw: WITHDRAWN_ROUTES carries 10.0.0.1/32 and Total Path Attribute
#        Length is 0 (RFC 4271 4.3) -- a withdrawal carries NO attributes, so no
#        NEXT_HOP and no LOCAL_PREF. The announce recipe does not transfer.
# The two lines previously both used seq=1, which collides on one message index
# (connSeqToIndex) so the withdraw silently overwrote the announce expectation.
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00310200000015400101024002004003047F00000140050400000064200A000001
expect=json:conn=1:seq=1:json={"meta":{"version":"1.0.0","format":"ze-bgp"},"message":{"type":"update"},"peer":{"address":"127.0.0.1","remote":{"as":65533}},"direction":"in","origin":"incomplete","local-preference":100,"ipv4/unicast":[{"action":"add","nlri":["10.0.0.1/32"],"next-hop":"127.0.0.1"}]}
expect=bgp:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF001C020005200A0000010000
expect=json:conn=1:seq=2:json={"meta":{"version":"1.0.0","format":"ze-bgp"},"message":{"type":"update"},"peer":{"address":"127.0.0.1","remote":{"as":65533}},"direction":"in","ipv4/unicast":[{"action":"del","nlri":["10.0.0.1/32"]}]}
EOF_PEER

tmpfs=withdraw-test.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
import time
from ze_api import API, runtime_fail


def dispatch(api, command):
    return api._call_engine('ze-plugin-engine:dispatch-command', {'command': command}) or {}


def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()

    # Wait on the peer's own state, then on its initial-sync EOR reaching the
    # wire, instead of holding a fixed 2s and hoping establishment fitted in it.
    if not api.wait_peer_eor_sent():
        runtime_fail('initial-sync EOR never reached the wire')
        return

    for cmd in (
        'request fakeredist emit add ipv4/unicast 10.0.0.1/32',
        'request fakeredist emit remove ipv4/unicast 10.0.0.1/32',
    ):
        resp = dispatch(api, cmd)
        result = resp.get('result', {})
        if result.get('status') != 'done':
            runtime_fail(f'{cmd}: {result}')
            return
        # deliberate pacing: space the add and remove so each is sent as a separate UPDATE, not batched
        time.sleep(0.5)

    # There IS a queryable signal: `request quiesce` returns once the BGP
    # forward pool and every peer's initial-sync opQueue have settled, which is
    # exactly "the emitted route finished dispatching".
    if not api.quiesce():
        runtime_fail('quiesce barrier did not complete')
        return
    dispatch(api, 'request shutdown')
    api.wait_for_shutdown()


if __name__ == '__main__':
    main()
EOF_RUN

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external withdraw-test {
		run ./withdraw-test.run
		encoder json
	}
	internal redistribute-orchestrator {
		use redistribute-orchestrator
	}
	internal fakeredist {
		use fakeredist
	}
}

redistribute {
	destination bgp {
		import fakeredist {
			family [ ipv4/unicast ];
		}
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65533
				remote 65533
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
# // test-relax: expect=exit:code=0 removed -- this STRENGTHENS the test. Coverage
# is replaced by the ze-peer wire expectations above, which now govern the verdict.
# The exit-code line asserted nothing about BGP and, until 2026-07-16, actively
# disabled the peer check and validateJSON (spec-fixit-redistribute-establishment-stall, D2).
