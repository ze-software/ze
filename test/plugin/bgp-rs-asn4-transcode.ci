# bgp-rs-asn4-transcode -- RS-client ASN4-to-ASN2 transcoding
#
# VALIDATES: RFC 6793 Section 4.2.2 -- AS_PATH and AGGREGATOR transcoded
# from 4-byte to 2-byte encoding when RS forwards to a peer lacking ASN4.
# VALIDATES: RFC 7947 Section 2.2.2 -- RS does NOT prepend its own AS.
#
# PREVENTS: Sending raw 4-byte AS_PATH or 8-byte AGGREGATOR wire bytes
# to a 2-byte-only RS-client peer, causing malformed UPDATE.
#
# Two-peer scenario: source (AS 65001, ASN4-capable) sends an UPDATE carrying a
# non-mappable ASN (4200000000) in AS_PATH and AGGREGATOR. Receiver (AS 65002)
# has ASN4 disabled, forcing the RS to transcode. The receiver must see:
#   - AS_PATH re-encoded to 2-byte with AS_TRANS (23456)
#   - AS4_PATH with original 4-byte values
#   - AGGREGATOR re-encoded to 6 bytes with AS_TRANS
#   - AS4_AGGREGATOR with original 4-byte ASN + IP
#
# RS-CLIENT IS LOAD-BEARING: both peers set session/rs-client true. That leaf
# (plugins/rs/yang/ze-rs-conf.yang:40) defaults to FALSE, and it is the ONLY
# thing that selects the RFC 7947 non-prepending forwarding path: forward_rs.go:350
# takes the `isEBGP && !rsClient` branch into getEBGPWire(), which PREPENDS the
# local AS, while forward_rs.go:358-384 (`isEBGP && rsClient && srcASN4 &&
# !sendASN4`) is the RFC 6793 RS transcode path this test is named for.
# An earlier revision omitted the leaf, so ze correctly prepended 65000 and this
# file never reached the transcode branch at all -- it silently duplicated the
# plain-eBGP prepend coverage already held by bgp-rs-fastpath-ebgp-shared.ci.
#
# NO LOCAL_PREF: the source is an EBGP peer, and RFC 4271 Section 5.1.5 forbids
# LOCAL_PREF in UPDATEs to external peers. An earlier revision put LOCAL_PREF=100
# in the source frame; ze correctly applies RFC 7606 Section 7.5 (message/rfc7606.go:442-449)
# and overwrites it in place with an ATTR_DISCARD marker (message/attr_discard.go:96-115),
# so the receiver saw C0FD0405010000 where a clean frame was expected. That is
# correct product behavior on invalid input -- the fix is a valid frame, not
# blessing the marker. Same resolution as bgp-rs-fastpath-ebgp-shared.ci:15-26.

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=2
option=timeout:value=15s
option=bind:value=0.0.0.0
# Map conn=N to a peer by remote IP instead of accept order. Both sessions
# are handshaked concurrently and then sorted (127.0.0.1 -> conn=1 source,
# 127.0.0.2 -> conn=2 receiver), so the RS has both clients established
# before the source's UPDATE is sent.
option=conn_map:value=remote-ip

# Source peer (conn=1): send UPDATE with non-mappable ASN 4200000000 (0xFA56EA00).
# ORIGIN=IGP, AS_PATH=[4200000000] (4-byte), NEXT_HOP=1.1.1.1,
# AGGREGATOR=4200000000/10.0.0.1 (8-byte), NLRI=10.0.0.0/24.
# No LOCAL_PREF -- EBGP source, see header.
#   0041->003A total, 0026->001F attr len (dropped the 7-byte LOCAL_PREF).
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF003A020000001F400101004002060201FA56EA0040030401010101C00708FA56EA000A000001180A0000

# The SOURCE's own EOR (conn=1). RFC 4724 Section 4.1 (rfc/full/rfc4724.txt:303):
# "The End-of-RIB marker MUST be sent by a BGP speaker to its peer once it completes
# the initial routing update (including the case when there is no update to send)".
# That MUST is the whole requirement -- the RFC says NOTHING about ordering the EOR
# relative to routes learned AFTER the initial update. So the RECEIVER's EOR is not
# asserted on the wire here: under load the forwarded route can reach conn=2 before
# conn=2's own EOR, which is RFC-conformant, and pinning the EOR at conn=2:seq=1
# turned that permitted ordering into a ~1/10 flake (the forward hits the still-pending
# EOR rule). Measured: with the conn=2 EOR rule 9/10, without it 12/12 -- the same
# conclusion bgp-rs-reactor-fastpath.ci reached for the identical rule.
#
# Both EORs are still enforced by the compiled observer's eor-sent counter
# gate. It fails closed if either marker is missing. conn=1's EOR does not
# race a forward because the source receives no relayed route, so it stays
# as a direct wire assertion.
#
# The conn=2 EOR rule is removed, not weakened. RFC 4724 owes no ordering
# against post-initial-update routes, and the observer still gates shutdown
# on both eor-sent counters.
expect=bgp:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000

# Receiver peer (conn=2): the transcoded UPDATE, asserted by FULL byte-equality.
#
# // the three contains= rules at conn=2:seq=1 (NLRI 180A0000, AGGREGATOR
# C007065BA00A000001, AS4_AGGREGATOR C01208FA56EA000A000001) are REPLACED, not dropped,
# by the single hex= below, which contains all three byte strings verbatim plus AS_PATH,
# AS4_PATH, ORIGIN and NEXT_HOP -- coverage strictly increases. They could not remain as
# three rules: each rule in a conn+seq group is a separate expected MESSAGE (checker.go:64
# groups them; checker.go:400-411 removes exactly one rule per received message and then
# returns), so three rules demanded THREE messages while the RS correctly forwards ONE --
# two were unreachable by construction and the peer always died with "connection closed
# before completion". Byte-equality is usable here (unlike bgp-rs-reactor-fastpath.ci,
# which deferred it) because the now-valid EBGP source frame leaves no ATTR_DISCARD
# bytes to pin.
#
# Derived from RFC 6793 Section 4.2.2 for a NEW->OLD speaker with a non-mappable AS,
# NOT from observed output:
#   40010100               ORIGIN=IGP
#   40020402015BA0         AS_PATH 2-byte AS_SEQUENCE[AS_TRANS(23456=0x5BA0)] -- the
#                          non-mappable 4200000000 becomes AS_TRANS, and RFC 7947
#                          Section 2.2.2 forbids prepending 65000 (rs-client true).
#   40030401010101         NEXT_HOP 1.1.1.1 preserved (RS does not rewrite)
#   C007065BA00A000001     AGGREGATOR re-encoded to 6 bytes: AS_TRANS + 10.0.0.1
#   C011060201FA56EA00     AS4_PATH AS_SEQUENCE[4200000000] -- MUST be sent, the path
#                          is not composed of mappable ASes only
#   C01208FA56EA000A000001 AS4_AGGREGATOR: original 4200000000 + 10.0.0.1
#   180A0000               NLRI 10.0.0.0/24
# attr len = 4+7+7+9+9+11 = 47 = 0x2F; total = 19+2+2+47+4 = 74 = 0x4A.
expect=bgp:conn=2:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF004A020000002F4001010040020402015BA040030401010101C007065BA00A000001C011060201FA56EA00C01208FA56EA000A000001180A0000
EOF_PEER

# Compiled observer shuts down only after both EORs and forwarding complete.

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	internal rs {
		use bgp-rs
	}
	internal adj-rib-in {
		use bgp-adj-rib-in
	}
	external shutdown-after-up {
		run "ze-test fixture plugin/bgp-rs-asn4-transcode"
		encoder json
	}
}
bgp {
	peer source-peer {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			rs-client true
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
			rs-fast-path enable
		}
		attach process adj-rib-in {
			receive [ update-received state ]
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
		attach process shutdown-after-up {
			receive [ update ]
		}
	}
	peer receiver-peer {
		connection {
			remote {
				ip 127.0.0.2
			}
			local {
				ip 127.0.0.2
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65002
			}
			router-id 1.2.3.4
			rs-client true
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				asn4 disable
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
			rs-fast-path enable
		}
		attach process adj-rib-in {
			send [ update ]
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
		attach process shutdown-after-up {
			receive [ update ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
reject=stderr:pattern=panic
reject=stderr:pattern=fatal error
