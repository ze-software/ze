# bgp-rs-asn4-transcode -- RS-client ASN4-to-ASN2 transcoding
#
# VALIDATES: RFC 6793 Section 4.2.2 -- AS_PATH and AGGREGATOR transcoded
# from 4-byte to 2-byte encoding when RS forwards to a peer lacking ASN4.
# VALIDATES: RFC 7947 Section 2.2.2 -- RS does NOT prepend its own AS.
#
# PREVENTS: Sending raw 4-byte AS_PATH or 8-byte AGGREGATOR wire bytes
# to a 2-byte-only RS-client peer, causing malformed UPDATE.
#
# Three-peer scenario: source (AS 4200000000, ASN4-capable) sends an UPDATE
# with non-mappable ASN in AS_PATH and AGGREGATOR. Receiver (AS 65002) has
# ASN4 disabled, forcing the RS to transcode. The receiver must see:
#   - AS_PATH re-encoded to 2-byte with AS_TRANS (23456)
#   - AS4_PATH with original 4-byte values
#   - AGGREGATOR re-encoded to 6 bytes with AS_TRANS
#   - AS4_AGGREGATOR with original 4-byte ASN + IP

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=2
option=timeout:value=15s
option=bind:value=0.0.0.0

# Source peer (conn=1): send UPDATE with non-mappable ASN 4200000000 (0xFA56EA00).
# ORIGIN=IGP, AS_PATH=[4200000000] (4-byte), NEXT_HOP=1.1.1.1,
# LOCAL_PREF=100, AGGREGATOR=4200000000/10.0.0.1, NLRI=10.0.0.0/24.
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00410200000026400101004002060201FA56EA004003040101010140050400000064C00708FA56EA000A000001180A0000

# Receiver peer (conn=2): verify transcoded UPDATE.
# NLRI must be forwarded.
expect=bgp:conn=2:seq=1:contains=180A0000
# AGGREGATOR must be 6 bytes with AS_TRANS (5BA0) + IP 10.0.0.1.
expect=bgp:conn=2:seq=1:contains=C007065BA00A000001
# AS4_AGGREGATOR (code 18 = 0x12) must carry original ASN 4200000000 + IP 10.0.0.1.
expect=bgp:conn=2:seq=1:contains=C01208FA56EA000A000001

# Both peers receive EOR.
expect=bgp:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
expect=bgp:conn=2:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# Observer: shut down cleanly after forwarding completes.
tmpfs=shutdown-after-up.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
import time
from ze_api import API

def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()
    time.sleep(2.0)
    api._call_engine('ze-plugin-engine:dispatch-command', {'command': 'request shutdown'})
    api.wait_for_shutdown()

if __name__ == '__main__':
    main()
EOF_RUN

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	internal rs {
		use bgp-rs
	}
	external shutdown-after-up {
		run ./shutdown-after-up.run
		encoder json
	}
}
bgp {
	peer source-peer {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
			rs-fast-path enable
		}
	}
	peer receiver-peer {
		connection {
			remote {
				ip 127.0.0.2
			}
			local {
				ip 127.0.0.2
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65002
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				asn4 disable
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
			rs-fast-path enable
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
reject=stderr:pattern=panic
reject=stderr:pattern=fatal error
