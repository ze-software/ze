# addpath-departure-rr-nonclient-skip: through bgp-rr, the departed source held
# the best path toward a non-client, and the best surviving path came from
# another non-client, which may not be reflected there.
# RFC 4456 Section 6: "A route from a Non-Client IBGP peer: Reflect to all the
# Clients." A non-client's route is not reflected to a non-client, so the
# recovery steps past it to the next candidate in election order.
# VALIDATES: B (127.0.0.5, non-client, LOCAL_PREF 150) and C (127.0.0.6,
# client, LOCAL_PREF 100) announce 10.0.0.0/8 once the fixture releases them,
# and the non-client receiver is reflected C's path only. A (127.0.0.1, client,
# LOCAL_PREF 200) then announces it, so the receiver holds A's path. When A
# closes, bgp-rr hands the departure to the engine's recovery, bgp-rib elects
# B first and C second, B is refused toward the receiver, and the receiver is
# sent C's route as the replacement.
# PREVENTS: a bare withdrawal of 10.0.0.0/8 at the receiver while C's
# reflectable path survives, and B's non-client route reaching a non-client.
# The sources carry no relay `send [ update ]`, so nothing is reflected to
# them and each peer script sees only what it asserts. The registered fixture
# releases each A action only after the receiver was sent the preceding UPDATE,
# and its first only once bgp-rib holds B's route (`held 127.0.0.5`): the
# receiver never sees B's route, so without that wait A could announce and
# leave before B's route arrived, and the skip would go unexercised. B and C
# announce only when the fixture sends them 198.18.0.0/24 (`release`), after
# the receiver is up: C's route reaching ze while the receiver is still
# connecting is reflected to no one, and nothing replays it later, because the
# receiver does not attach bgp-adj-rib-in with `send [ update ]`.

stdin=sourcea:terminator=EOF_SOURCEA
option=tcp_connections:value=1
option=timeout:value=90s
option=asn:value=65000
option=open:value=router-id:id=127.0.0.1
expect=bgp:conn=1:seq=1:contains=18C00002
expect=bgp:conn=1:seq=2:contains=18C63364
# ORIGIN IGP, empty AS_PATH, NEXT_HOP 192.0.2.1, LOCAL_PREF 200, NLRI 10.0.0.0/8.
action=send:conn=1:seq=3:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002E020000001540010100400200400304C0000201400504000000C8080A
expect=bgp:conn=1:seq=4:contains=18CB0071
action=close:conn=1:seq=5
EOF_SOURCEA

stdin=sourceb:terminator=EOF_SOURCEB
option=tcp_connections:value=1
option=timeout:value=90s
option=asn:value=65000
option=linger:value=true
option=open:value=router-id:id=127.0.0.5
# ORIGIN IGP, empty AS_PATH, NEXT_HOP 192.0.2.5, LOCAL_PREF 150, NLRI 10.0.0.0/8.
# The fixture releases this peer (198.18.0.0/24) once the receiver is up.
expect=bgp:conn=1:seq=1:contains=18C61200
action=send:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002E020000001540010100400200400304C000020540050400000096080A
EOF_SOURCEB

stdin=sourcec:terminator=EOF_SOURCEC
option=tcp_connections:value=1
option=timeout:value=90s
option=asn:value=65000
option=linger:value=true
option=open:value=router-id:id=127.0.0.6
# ORIGIN IGP, empty AS_PATH, NEXT_HOP 192.0.2.6, LOCAL_PREF 100, NLRI 10.0.0.0/8.
# The fixture releases this peer (198.18.0.0/24) once the receiver is up.
expect=bgp:conn=1:seq=1:contains=18C61200
action=send:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002E020000001540010100400200400304C000020640050400000064080A
EOF_SOURCEC

stdin=receiver:terminator=EOF_RECEIVER
option=tcp_connections:value=1
option=timeout:value=90s
option=asn:value=65000
option=linger:value=true
# Each reflected route carries ORIGINATOR_ID (the source's BGP Identifier) and
# CLUSTER_LIST 10.0.0.1 after the received attributes (RFC 4456 Section 8).
# C's route, then A's. B's is never reflected here.
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF003C020000002340010100400200400304C0000206400504000000648009047F000006800A040A000001080A
expect=bgp:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF003C020000002340010100400200400304C0000201400504000000C88009047F000001800A040A000001080A
# The departure: C's route replaces A's, with C's own attributes, not B's.
expect=bgp:conn=1:seq=3:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF003C020000002340010100400200400304C0000206400504000000648009047F000006800A040A000001080A
EOF_RECEIVER

stdin=ze-bgp:terminator=EOF_CONF
plugin {
    internal relay { use bgp-rr; }
    external addpath-departure {
        run "le test fixture plugin/vpn-withdrawal-inventory rr 3 release 127.0.0.5 release 127.0.0.6 held 127.0.0.5"
        encoder json
    }
}
bgp {
    peer sourcea {
        connection {
            remote { ip 127.0.0.1; }
            local { ip 127.0.0.3; accept false; }
        }
        session {
            asn { local 65000; remote 65000; }
            router-id 1.2.3.4
            route-reflector-client true; cluster-id 10.0.0.1
            family {
                ipv4/unicast { prefix { maximum 10000; } }
            }
            capability { graceful-restart disable; }
        }
        behavior { group-updates disable; }
        attach process relay {
            receive [ update-received state open-received refresh ]
        }
        attach process bgp-rib {
            receive [ update state refresh ]
            send [ update ]
        }
        attach process addpath-departure { send [ update ]; }
    }
    peer sourceb {
        attach process addpath-departure { send [ update ]; }
        connection {
            remote { ip 127.0.0.5; }
            local { ip 127.0.0.3; accept false; }
        }
        session {
            asn { local 65000; remote 65000; }
            router-id 1.2.3.4
            cluster-id 10.0.0.1
            family {
                ipv4/unicast { prefix { maximum 10000; } }
            }
            capability { graceful-restart disable; }
        }
        behavior { group-updates disable; }
        attach process relay {
            receive [ update-received state open-received refresh ]
        }
        attach process bgp-rib {
            receive [ update state refresh ]
            send [ update ]
        }
    }
    peer sourcec {
        attach process addpath-departure { send [ update ]; }
        connection {
            remote { ip 127.0.0.6; }
            local { ip 127.0.0.4; accept false; }
        }
        session {
            asn { local 65000; remote 65000; }
            router-id 1.2.3.4
            route-reflector-client true; cluster-id 10.0.0.1
            family {
                ipv4/unicast { prefix { maximum 10000; } }
            }
            capability { graceful-restart disable; }
        }
        behavior { group-updates disable; }
        attach process relay {
            receive [ update-received state open-received refresh ]
        }
        attach process bgp-rib {
            receive [ update state refresh ]
            send [ update ]
        }
    }
    peer receiver {
        connection {
            remote { ip 127.0.0.2; }
            local { ip 127.0.0.4; accept false; }
        }
        session {
            asn { local 65000; remote 65000; }
            router-id 1.2.3.4
            cluster-id 10.0.0.1
            family {
                ipv4/unicast { prefix { maximum 10000; } }
            }
            capability { graceful-restart disable; }
        }
        behavior { group-updates disable; }
        attach process relay {
            receive [ update-received state open-received refresh ]
            send [ update ]
        }
        attach process bgp-rib {
            receive [ update state refresh ]
            send [ update ]
        }
    }
}
EOF_CONF

cmd=background:seq=1:exec=le test peer --port $PORT:stdin=sourcea
cmd=background:seq=2:exec=le test peer --bind 127.0.0.2 --port $PORT:stdin=receiver
cmd=background:seq=3:exec=le test peer --bind 127.0.0.5 --port $PORT:stdin=sourceb
cmd=background:seq=4:exec=le test peer --bind 127.0.0.6 --port $PORT:stdin=sourcec
cmd=foreground:seq=5:exec=ze -:stdin=ze-bgp:timeout=90s
expect=exit:code=0
reject=stderr:pattern=panic recovered
reject=stderr:pattern=fatal error
reject=stderr:pattern=ZE-OBSERVER-FAIL
