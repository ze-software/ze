# Test: show warnings returns stale prefix data warning from the report bus
# Exercises the full CLI path: dispatch-command -> ze-show:warnings -> handleShowWarnings -> report.Warnings()
# The stale warning is raised at peer add time by reactor_peers.go calling RaisePrefixStale

# ze-peer: accepts connection, receives EOR
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
option=asn:value=65001
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER


# ze bgp configuration: peer1 has stale prefix data (2024-01-01)
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external warnings-show-test {
		run "ze-test fixture plugin/warnings-show"
		encoder json
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast {
					prefix {
						maximum 10000
						updated 2024-01-01
					}
				}
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}

	}
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
