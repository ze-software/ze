# Test: external plugin declares enricher at registration, engine calls back at show time
# VALIDATES: AC-1 (enricher declared), AC-2 (callback invoked, data merged), AC-10 (Python .ci)
# PREVENTS: external enrichment pipeline broken or callback not dispatched

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# Plugin 1: declares an enricher and serves enrichment data via callback
tmpfs=enricher-provider.run:mode=755:terminator=EOF_PROVIDER
#!/usr/bin/env python3
"""Plugin that declares a show enricher and provides enrichment data."""

from ze_api import API


def enrich_handler(command, key, mode, base):
    if command == "show test enrich" and key == "ext-cos":
        return {"cos-profile": "residential", "ext-source": "enricher-provider"}
    return {}


def main():
    api = API()
    api.declare_enricher(command="show test enrich", key="ext-cos")
    api.on_enrich_show(enrich_handler)
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()
    api.wait_for_shutdown(timeout=30.0)


if __name__ == '__main__':
    main()
EOF_PROVIDER

# Plugin 2: dispatches show test enrich and verifies enrichment data
tmpfs=enricher-checker.run:mode=755:terminator=EOF_CHECKER
#!/usr/bin/env python3
"""Plugin that dispatches show test enrich and checks for enrichment."""

import json
import time

from ze_api import API, runtime_fail, result_json_data, result_text_data


def dispatch(api, command):
    resp = api._call_engine(
        'ze-plugin-engine:dispatch-command', {'command': command})
    if resp is None:
        return {'status': 'error', 'data': 'engine call returned None'}
    return resp.get('result', {})


def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()
    api.wait_for_post_startup(timeout=5.0)

    # // test-relax: poll loop centralized into api.dispatch_until_done (ci-sleep
    # ratchet); behavior and the status assertion below are unchanged.
    result = api.dispatch_until_done('show test enrich')
    if result.get('status') != 'done':
        status = result.get('status') if result else 'nil'
        data = result_text_data(result) if result else ''
        runtime_fail(f'show test enrich: status={status} data={data[:200]}')

    try:
        data = result_json_data(result, {})
    except json.JSONDecodeError as exc:
        runtime_fail(f'show test enrich json: {exc}: {result_text_data(result)[:200]}')
        data = {}

    if data.get('cos-profile') != 'residential':
        runtime_fail(f'expected cos-profile=residential, got {data!r}')

    if data.get('ext-source') != 'enricher-provider':
        runtime_fail(f'expected ext-source=enricher-provider, got {data!r}')

    dispatch(api, 'request shutdown')
    api.wait_for_shutdown()


if __name__ == '__main__':
    main()
EOF_CHECKER

stdin=ze-conf:terminator=EOF_CONF
plugin {
    internal fakeenrich {
        use fakeenrich
    }
    external enricher-provider {
        run ./enricher-provider.run
        encoder json
    }
    external enricher-checker {
        run ./enricher-checker.run
        encoder json
    }
}

bgp {
    peer peer1 {
        connection {
            remote {
                ip 127.0.0.1
            }
            local {
                ip 127.0.0.1
                accept false
            }
        }
        session {
            asn {
                local 1
                remote 1
            }
            router-id 1.2.3.4
            family {
                ipv4/unicast { prefix { maximum 10000; } }
            }
            capability {
                graceful-restart disable
            }
        }
        behavior {
            group-updates disable
        }
    }
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-conf:timeout=15s
expect=exit:code=0
