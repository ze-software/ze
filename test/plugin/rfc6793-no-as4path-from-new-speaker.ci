# rfc6793-no-as4path-from-new-speaker -- an AS4_PATH from a NEW speaker is discarded
#
# VALIDATES: RFC 6793 Section 6 -- "A NEW BGP speaker that receives the AS4_PATH
# attribute or the AS4_AGGREGATOR attribute in an UPDATE message from another
# NEW BGP speaker MUST discard the path attribute and continue processing the
# UPDATE message." Section 4.1 states the sending half: neither attribute is
# carried between NEW speakers.
# VALIDATES: AC-3 of
# plan/immediate/spec-forwarded-as-path-obeys-rfc6793-for-every-destination.md,
# and the ledger rows RFC6793-4.1-6 and RFC6793-4.1-7.
#
# PREVENTS: merging an AS4_PATH a four-octet peer had no business sending, and
# relaying it onward. Both are wrong for the same reason: on a four-octet
# session the AS_PATH already carries the real AS numbers, so an AS4_PATH beside
# it can only disagree with them.
#
# THE TWO AS4_PATH TAILS DIFFER ON PURPOSE. The AS_PATH ends in 4200000123 and
# the AS4_PATH ends in 4200000000, so a merge would be visible in the forwarded
# bytes rather than hidden behind an identical value. That is what separates
# "discarded" from "merged and happened to agree".
#
# WHAT MAKES IT DISCRIMINATE: with the collapse removed the AS4_PATH survives
# ingest and the forward path relays it verbatim between two four-octet
# sessions, so conn=2 receives 37 attribute octets carrying C0110A... rather
# than the 24 below. With the collapse present but its Section 4.1 arm removed,
# the AS4_PATH is merged instead and conn=2 reads FA56EA00 at the tail of
# AS_PATH.
#
# RFC requirement: RFC6793-4.1-6 positive -- the UPDATE ze puts on the wire between
# two NEW BGP speakers carries neither AS4_PATH nor AS4_AGGREGATOR. conn=2 receives
# 24 attribute octets, asserted as exact wire hex on a running daemon, and attribute
# type 17 is not among them although the UPDATE ze read carried one (Section 4.1,
# Section 6).
# RFC requirement: RFC6793-4.1-7 positive -- ze receives an AS4_PATH from another NEW
# BGP speaker, discards the path attribute, and continues processing the UPDATE
# message: the prefix and every other attribute still reach conn=2, and the AS_PATH
# that reaches it is the one ze read rather than one merged with the discarded
# attribute (Section 4.1, Section 6).
#
# BOTH PEERS ARE NEW SPEAKERS: neither session block disables asn4, so both
# negotiate four octets (neg.ASN4 is localASN4 && remoteASN4,
# internal/core/bgp/capability/negotiated.go).
#
# NO LOCAL_PREF: the source is an eBGP peer and RFC 4271 Section 5.1.5 forbids
# it there, so ze would overwrite it with an ATTR_TOMBSTONE marker and the
# byte-equality rule would pin the marker (bgp-rs-fastpath-ebgp-shared.ci).

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=2
option=timeout:value=45s
option=bind:value=0.0.0.0
option=conn_map:value=remote-ip

# Source peer (conn=1), a NEW speaker sending what Section 4.1 forbids:
#   40 01 01 00                        ORIGIN igp
#   40 02 0A 0202 0000FDE9 FA56EA7B    AS_PATH [65001, 4200000123], four-octet
#   40 03 04 01010101                  NEXT_HOP 1.1.1.1
#   C0 11 0A 0202 0000FDE9 FA56EA00    AS4_PATH [65001, 4200000000], the tail
#                                      that must never reach conn=2
#   18 0A0000                          NLRI 10.0.0.0/24
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF004002000000254001010040020A02020000FDE9FA56EA7B40030401010101C0110A02020000FDE9FA56EA00180A0000

# The SOURCE's own EOR (conn=1). See rfc6793-ingest-collapse.ci for why the
# receiver's EOR is not pinned on the wire.
expect=bgp:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000

# Receiver peer (conn=2), asserted by full byte-equality:
#   40 01 01 00                        ORIGIN igp
#   40 02 0A 0202 0000FDE9 FA56EA7B    AS_PATH UNCHANGED. The discarded
#                                      AS4_PATH contributed nothing.
#   40 03 04 01010101                  NEXT_HOP 1.1.1.1
#   18 0A0000                          NLRI 10.0.0.0/24
# attr len = 4 + 13 + 7 = 24 = 0x18; total = 19 + 2 + 2 + 24 + 4 = 51 = 0x33.
expect=bgp:conn=2:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF003302000000184001010040020A02020000FDE9FA56EA7B40030401010101180A0000
EOF_PEER

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	internal rs {
		use bgp-rs
	}
	internal adj-rib-in {
		use bgp-adj-rib-in
	}
	external shutdown-after-up {
		run "ze-test fixture plugin/rfc6793-no-as4path-from-new-speaker"
		encoder json
	}
}
bgp {
	peer source-new {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			rs-client true
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
			rs-fast-path enable
		}
		attach process adj-rib-in {
			receive [ update-received state ]
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
		attach process shutdown-after-up {
			receive [ update ]
		}
	}
	peer receiver-new {
		connection {
			remote {
				ip 127.0.0.2
			}
			local {
				ip 127.0.0.2
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65002
			}
			router-id 1.2.3.4
			rs-client true
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
			rs-fast-path enable
		}
		attach process adj-rib-in {
			send [ update ]
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
		attach process shutdown-after-up {
			receive [ update ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=45s
expect=exit:code=0
reject=stderr:pattern=panic
reject=stderr:pattern=fatal error
