# Test: refused selected rules leave other owners and later valid rules intact.
# VALIDATES: unknown protocol253 and SCTP plus a TCP/UDP-only port component
# are refused independently; a later protocol-only SCTP rule still installs.
# PREVENTS: retaining an unsupported condition in a backend batch, dropping a
# condition to make it enforceable, or passing before either refusal was seen.
option=needs-linux:caps=net-admin
# Both suites use the kernel-global ze_flowspec table.
option=exclusive:group=flowspec-nft
option=env:var=ze.log.firewall:value=info
option=env:var=ze.log.flowspec.firewall:value=info
option=timeout:value=40s

stdin=peer:terminator=EOF_PEER
option=linger:value=true
option=tcp_connections:value=1
option=timeout:value=35s
# Eligible covering unicast precedes every selected FlowSpec rule.
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002E02000000154001010040020040050400000064400304C0000201080A
# Unknown protocol at10.2/24, then unsupported SCTP+port at10.3/24,
# then enforceable protocol-only SCTP at10.1/24.
action=send:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0041020000002A4001010040020040050400000064800E0E00018500000801180A02000381FDC010088006000000000000
action=send:conn=1:seq=3:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0044020000002D4001010040020040050400000064800E1100018500000B01180A0300038184058150C010088006000000000000
action=send:conn=1:seq=4:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0041020000002A4001010040020040050400000064800E0E00018500000801180A0100038184C010088006000000000000
EOF_PEER

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	internal flowspec-firewall { use flowspec-firewall; }
}
telemetry {
	prometheus {
		enabled true;
		server main { ip 127.0.0.1; port $PORT2; }
	}
}
firewall {
	backend nft;
	table fslocal {
		family inet;
		chain input {
			type filter; hook input; priority 0; policy accept;
			term allow-ssh {
				from { protocol tcp; destination-port 22; }
				then { accept; }
			}
		}
	}
}
bgp {
	peer peer1 {
		connection {
			remote { ip 127.0.0.1; }
			local { ip 127.0.0.1; accept false; }
		}
		session {
			asn { local 1; remote 1; }
			router-id 1.2.3.4;
			family {
				ipv4/unicast { prefix { maximum 10000; } }
				ipv4/flow { prefix { maximum 10000; } }
			}
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=background:seq=2:exec=ze -:stdin=ze-bgp
cmd=foreground:seq=3:exec=le-test fixture plugin/flowspec-fw-untranslatable-keeps-others $PORT2:timeout=35s
expect=exit:code=0
expect=stdout:contains=table inet ze_fslocal
expect=stdout:contains=table inet ze_flowspec
expect=stdout:pattern=daddr 10\.1\.0\.0/24 meta l4proto (132|sctp)( counter packets [0-9]+ bytes [0-9]+)? drop
reject=stdout:pattern=daddr 10\.[23]\.0\.0/24
expect=stdout:pattern=ze_flowspec_rules_refused_total\{reason="unknown-protocol"\} [1-9]
expect=stdout:pattern=ze_flowspec_rules_refused_total\{reason="unsupported-component"\} [1-9]
