# Test: `show bgp` typed with no subcommand answers the peer summary.
#
# VALIDATES: spec-cli-dispatch-child-guard AC-1 and AC-6, and AC-1 of
#            spec-cli-show-bgp-is-the-command. `container bgp` carries
#            ze:command "ze-bgp:overview", and since the `summary` child was
#            retired this is the ONLY spelling of that answer. A token that
#            names no address family and no registered subcommand comes back as
#            an unknown command.
# PREVENTS:  the operator who types the object with no verb getting an
#            unknown-command error, and the operator who mistypes a subcommand
#            being told the token is an invalid address family.

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# Native observer fixture: plugin/show-bgp-bare-runs-summary.

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external bare-show-bgp {
		run "ze-test fixture plugin/show-bgp-bare-runs-summary"
		encoder json
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
