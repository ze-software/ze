# Test: export filter modifies attributes during forwarding
# VALIDATES: AC-10 -- Export filter modify: plugin returns modify with delta
# PREVENTS: Export modify config rejected or crashing the forwarding path

# peer1 (127.0.0.1) sends the route ze forwards to peer2.
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
option=update:value=send-route:prefix=10.0.0.0/24:next-hop=10.0.0.1:origin-as=65001
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# peer2 (127.0.0.2) is the forward target and carries the export filter. It is an
# INTERNAL peer, because LOCAL_PREF is the attribute the filter modifies and
# RFC 4271 Section 5.1.5 keeps that attribute off an external session. On an
# external peer2 the delta would be applied and never appear on the wire, so the
# expectation below could not tell a working modify from a dropped one.
#
# 400504000000C8 is LOCAL_PREF (flags 0x40, type 0x05, length 4) carrying 200.
# The unmodified value would be 0x64, so this needle fails if the delta is lost.
stdin=peer2:terminator=EOF_PEER2
option=tcp_connections:value=1
option=timeout:value=15s
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
expect=bgp:conn=1:seq=2:contains=400504000000C8
EOF_PEER2

# Python test plugin: declares an export filter that modifies local-preference
tmpfs=filter-export-modify-test.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
import sys
from ze_api import API, runtime_fail

export_modified = []

def filter_handler(params):
    """Modify local-preference to 200 on export."""
    direction = params.get('direction', '')
    if direction == 'export':
        update = params.get('update', '')
        export_modified.append(update)
        print(f'filter-update EXPORT MODIFY: peer={params.get("peer")} update={update!r}', file=sys.stderr)
        return {'action': 'modify', 'update': 'local-preference 200'}
    # Accept imports unchanged
    return {'action': 'accept'}

def dispatch(api, command):
    resp = api._call_engine(
        'ze-plugin-engine:dispatch-command', {'command': command})
    if resp is None:
        return {'status': 'error', 'data': 'None'}
    return resp.get('result', {})

def serve_until(api, predicate, attempts=100):
    """Answer plugin callbacks until predicate() holds, or attempts run out.

    ze asks for a filter decision over the callback connection, and only
    api.read_line() answers it. An observer parked in a dispatch RPC leaves that
    request unanswered until the reactor's IPC deadline expires, and on-error
    then decides the route instead of the filter. read_line blocks in select for
    its timeout, so this loop costs no CPU and adds no sleep.
    """
    for _ in range(attempts):
        if predicate():
            return True
        api.read_line(timeout=0.1)
    return predicate()

def main():
    api = API()
    api.declare_filter(
        name='set-export-localpref',
        direction='export',
        attributes=['local-preference'],
        on_error='reject',
    )
    api.on_filter_update(filter_handler)
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()

    # Two barriers, in this order.
    # 1. serve_until answers the filter callback for the forward to peer2. A poll
    #    cannot come first: it parks this observer in a dispatch RPC, and ze's
    #    initial-sync drain is waiting for the verdict only read_line delivers.
    # 2. updates-sent on peer2 reaches 2 when the modified UPDATE has been
    #    written to peer2's socket (IncrUpdatesSent, reactor/reactor_notify.go),
    #    so the shutdown below cannot beat the frame peer2 asserts. The threshold
    #    is 2 and not 1 because the initial-sync End-of-RIB is itself an UPDATE
    #    and this counter cannot tell it apart: the sent branch of
    #    onMessageReceived (reactor/reactor_notify.go) increments on
    #    msgtype.TypeUPDATE, and wireUpdate is nil for a sent message, so no
    #    IsEOR test is possible there. A threshold of 1 is therefore satisfied by
    #    establishment alone and waits for nothing. peer2 receives exactly two
    #    frames on this session: its EOR, and the one modified forward.
    serve_until(api, lambda: len(export_modified) > 0)
    # attempts=40 (10s) rather than the 60 (15s) default. The break this error
    # text names is "the verdict was given and the frame was never written": the
    # line above has already returned, so 10s leaves room inside the test's 15s
    # budget for this message to be printed rather than for the runner to report
    # its own timeout. A daemon that forwards NOTHING gives no verdict either, so
    # serve_until spends its own 10s first and that break stays a timeout.
    if not api.wait_peer_counter('updates-sent', 2, peer='127.0.0.2', attempts=40):
        runtime_fail('ze never wrote the modified UPDATE to peer2')

    # peer2 is the only forward target for the route peer1 sends, so the export
    # filter must have been consulted for it.
    if not export_modified:
        runtime_fail('export filter never saw the forward of 10.0.0.0/24 to peer2')
    print(f'OK: export filter modified {len(export_modified)} forward(s)', file=sys.stderr)

    dispatch(api, 'request shutdown')
    api.wait_for_shutdown()

if __name__ == '__main__':
    main()
EOF_RUN

# ze bgp configuration: the export filter sits on peer2, the peer ze forwards TO.
# On peer1 it would never be consulted: the route arrives from peer1 and ze does
# not send it back to its source.
stdin=ze-bgp:terminator=EOF_CONF
plugin {
    # Ze forwards a route between peers only when the route-server plugin is
    # attached to both. Without it nothing reaches the egress path, and the
    # export filter under test is never consulted.
    internal adj-rib-in {
        use bgp-adj-rib-in;
    }
    internal rs {
        use bgp-rs;
    }
    external filter-export-modify-test {
        run ./filter-export-modify-test.run;
        encoder json;
    }
}
bgp {
    router-id 1.2.3.4;
    session {
    	asn {
    		local 65000
    	}
    }
    peer peer1 {
        connection {
            remote {
                ip 127.0.0.1
            }
            # Ze's own address on this session. Deliberately not the peer's
            # 127.0.0.1: RFC 4271 Section 5.1.3 forbids a peer's own address as
            # NEXT_HOP.
            local {
                ip 127.0.0.4
                accept false
            }
        }
        session {
            asn {
                local 65000
                remote 65001
            }
            family {
                ipv4/unicast { prefix { maximum 10000; } }
            }
        }
        behavior {
            group-updates disable
        }
        attach process rs {
            receive [ update-received state open-received refresh ];
            send [ update ];
        }
        attach process adj-rib-in {
            receive [ update-received state ];
            send [ update ];
        }
    }
    peer peer2 {
        connection {
            remote {
                ip 127.0.0.2
            }
            local {
                ip 127.0.0.5
                accept false
            }
        }
        session {
            asn {
                local 65000
                remote 65000
            }
            family {
                ipv4/unicast { prefix { maximum 10000; } }
            }
        }
        behavior {
            group-updates disable
        }
        attach process rs {
            receive [ update-received state open-received refresh ];
            send [ update ];
        }
        attach process adj-rib-in {
            receive [ update-received state ];
            send [ update ];
        }
        filter {
            export [ filter-export-modify-test:set-export-localpref ];
        }
    }
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=background:seq=2:exec=ze-peer --bind 127.0.0.2 --port $PORT:stdin=peer2
cmd=foreground:seq=3:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
