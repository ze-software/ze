# Test: REST config commit rejection preserves active config
# VALIDATES: AC-6 -- API session commit failure clears candidate, leaves active unchanged, and keeps session editable.
# PREVENTS: REST config commit saving a rejected candidate or closing the session on failure.

option=timeout:value=30s

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER


tmpfs=api-config-commit-reject.conf:terminator=EOF_CONF
plugin {
    external api-commit-reject {
        run "le test fixture plugin/api-config-commit-reject"
        encoder json
    }
}

environment {
    api-server {
        token "secret";
        rest {
            enabled true;
            server main {
                ip 127.0.0.1;
                port 18088;
            }
        }
    }
}

bgp {
    router-id 1.2.3.4
    peer peer1 {
        connection {
            remote {
                ip 127.0.0.1
            }
            local {
                ip 127.0.0.1
                accept false
            }
        }
        session {
            asn {
                local 1
                remote 1
            }
            router-id 1.2.3.4
            family {
                ipv4/unicast { prefix { maximum 10000; } }
            }
            capability {
                graceful-restart disable
            }
        }
        behavior {
            group-updates disable
        }
    }
}
EOF_CONF

cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze start api-config-commit-reject.conf:timeout=30s
expect=exit:code=0
expect=key:path=meta/config/api-config-commit-reject.conf/active:exists=true
expect=key:path=meta/config/api-config-commit-reject.conf/candidate:absent=true
expect=key:path=meta/config/api-config-commit-reject.conf/rollback:absent=true
expect=key:glob=file/[0-9]*/api-config-commit-reject.conf:count=1
expect=key:glob=file/[0-9]*/api-config-commit-reject.conf:contains=router-id 1.2.3.4
expect=key:glob=file/[0-9]*/api-config-commit-reject.conf:not-contains=receive-hold-time 2
