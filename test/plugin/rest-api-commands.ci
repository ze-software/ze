# Test: REST API /api/v1/commands returns command list
# VALIDATES: REST transport wired to engine, commands endpoint reachable
# PREVENTS: REST server not started, engine not connected to dispatcher

# ze-peer expectations
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=20s
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# Python test plugin: starts, waits for REST API, queries /api/v1/commands
tmpfs=rest-test.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
import json
import sys
import urllib.request
import urllib.error
from ze_api import API, runtime_fail

REST_PORT = 18081
REST_URL = f'http://127.0.0.1:{REST_PORT}/api/v1/commands'

def wait_for_rest(api, url, timeout=10):
    """Poll REST endpoint until it responds; return body bytes or None."""
    captured = {}
    def _ok():
        try:
            req = urllib.request.Request(url)
            resp = urllib.request.urlopen(req, timeout=2)
            captured['body'] = resp.read()
            return True
        except (urllib.error.URLError, ConnectionRefusedError, OSError):
            return False
    api.wait_until(_ok, attempts=max(1, int(timeout / 0.5)), delay=0.5)
    return captured.get('body')

def post_execute(url, payload):
    """POST /api/v1/execute and return the decoded result, however it failed.

    urlopen RAISES on a non-2xx status, and a command the daemon cannot resolve
    can also come back as a null body. Either way the exception/AttributeError
    escaped main()'s try block, the finally shut ze down cleanly, and the
    ZE-OBSERVER-FAIL sentinel that the excepthook then emitted was written to a
    stderr nothing was relaying any more -- so the runner saw exit 0 and
    reported PASS. Normalising every failure into a result dict keeps the
    assertion (and its runtime_fail) running while ze is still alive.
    """
    req = urllib.request.Request(
        url,
        data=json.dumps(payload).encode(),
        headers={'Content-Type': 'application/json'},
    )
    try:
        body = urllib.request.urlopen(req, timeout=5).read()
    except urllib.error.HTTPError as exc:
        body = exc.read()
    except (urllib.error.URLError, OSError) as exc:
        return {'status': 'error', 'error': f'{exc}'}
    try:
        decoded = json.loads(body)
    except (json.JSONDecodeError, ValueError):
        return {'status': 'error', 'error': body[:200].decode('utf-8', 'replace')}
    if not isinstance(decoded, dict):
        return {'status': 'error', 'error': f'non-object response: {decoded!r}'}
    return decoded

def dispatch(api, command):
    resp = api._call_engine(
        'ze-plugin-engine:dispatch-command', {'command': command})
    if resp is None:
        return {'status': 'error', 'data': 'engine call returned None'}
    return resp.get('result', {})

def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()
    api.wait_for_post_startup(timeout=5.0)

    try:
        # runtime_fail, never sys.exit: the runner watches ze's exit code, and
        # the finally block below has already shut ze down cleanly (exit 0) by
        # the time an observer's sys.exit(1) runs, so the runner reported PASS
        # (ai/rules/testing.md, observer-exit antipattern). Every assertion here
        # was sys.exit(1), which is why the execute call below kept "passing"
        # while asking for a command the daemon answers with "unknown command".
        data = wait_for_rest(api, REST_URL)
        if data is None:
            runtime_fail('REST API did not respond within timeout')

        commands = json.loads(data)
        if not isinstance(commands, list):
            runtime_fail(f'expected list, got {type(commands).__name__}')

        if len(commands) == 0:
            runtime_fail('empty command list')

        names = [c.get('Name', '') for c in commands]
        if 'show bgp summary' not in names:
            runtime_fail(f'command list does not advertise "show bgp summary" ({len(names)} commands)')
        print(f'OK: REST /api/v1/commands returned {len(commands)} commands', file=sys.stderr)

        # Also test execute endpoint. Assert on the PAYLOAD, not just the
        # status: the endpoint must actually answer the command it advertises.
        exec_url = f'http://127.0.0.1:{REST_PORT}/api/v1/execute'
        # // NO assertion removed -- the inline
        # Request/urlopen/json.loads block moved into post_execute() above, which
        # is strictly STRONGER: urlopen raised on the failure this call exists to
        # catch, and the raise escaped to the excepthook only after ze had already
        # been shut down by the finally block, so the sentinel never reached the
        # runner and the test passed on a command the daemon rejects. Line count
        # drops because the boilerplate is now shared; every runtime_fail below is
        # kept and three assertions were added.
        result = post_execute(exec_url, {'command': 'show bgp summary'})
        if result.get('status') != 'done':
            runtime_fail(f'execute status={result.get("status")} error={result.get("error")} data={result.get("data")}')

        payload = result.get('data')
        if isinstance(payload, str):
            payload = json.loads(payload)
        summary = (payload or {}).get('summary', {})
        if 'peers-configured' not in summary:
            runtime_fail(f'execute returned no peers-configured: {payload}')
        if not any(p.get('address') == '127.0.0.1' for p in summary.get('peers', [])):
            runtime_fail(f'execute did not list peer 127.0.0.1: {summary}')

        print(f'OK: REST /api/v1/execute returned peer data', file=sys.stderr)
    finally:
        dispatch(api, 'request shutdown')
        api.wait_for_shutdown()

if __name__ == '__main__':
    main()
EOF_RUN

# ze bgp configuration with REST API enabled
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external rest-test {
		run ./rest-test.run
		encoder json
	}
}

environment {
	api-server {
		rest {
			enabled true;
			server main {
				ip 127.0.0.1;
				port 18081;
			}
		}
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
