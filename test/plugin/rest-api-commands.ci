# Test: REST API /api/v1/commands returns command list
# VALIDATES: REST transport wired to engine, commands endpoint reachable
# PREVENTS: REST server not started, engine not connected to dispatcher

# ze-peer expectations
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=20s
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# Native test fixture: starts, waits for REST API, queries /api/v1/commands

# ze bgp configuration with REST API enabled
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external rest-test {
		run "ze-test fixture plugin/rest-api-commands"
		encoder json
	}
}

environment {
	api-server {
		rest {
			enabled true;
			server main {
				ip 127.0.0.1;
				port 18081;
			}
		}
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
