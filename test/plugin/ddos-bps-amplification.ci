# Test: ddos-detect bandwidth (BPS) trigger catches low-PPS / high-bandwidth
# amplification that the packet-rate trigger misses.
#
# VALIDATES: spec-ddos-detect-enhancements AC-1 -- with the PPS floor set far
#            above the flood's packet rate, the ONLY trigger that can fire is the
#            bandwidth path (baselineBps.Ready() && maxBps > BPS threshold). A
#            high-bandwidth flood whose packet rate stays under the floor therefore
#            still opens an incident (show ddos status active-attacks > 0), proving
#            the BPS trigger.
# PREVENTS:  a regression where an NTP/memcached/CLDAP-style amplification flood
#            (large packets, huge bandwidth) slips under the PPS threshold and is
#            never detected.
#
# CONFIG NOTE: bps-threshold-multiplier is left at its default (3.00) rather than
#   set explicitly. It is a YANG decimal-2 leaf with a range, and text-config range
#   validation does not support decimal types (internal/component/config/schema.go
#   parseNumericRangeValue), so an explicit value is rejected at load -- the same
#   reason every ddos .ci uses the default threshold-multiplier/entropy-threshold.
#   The multiplier is irrelevant here anyway: with a near-zero warmed baseline the
#   bps-floor governs the threshold. Since the multiplier default equals the value
#   the test would set, no coverage is lost by the omission.
#   // bps-threshold-multiplier omitted (decimal-2 unsettable via text
#   config, schema.go); default 3.00 == intended value, floor governs the threshold.
#
# STATUS: option=needs-linux. It exercises the full daemon path (iface/trafficstat
#   rate collector on `lo` -> detector applyTick BPS trigger -> state machine ->
#   AttackDetected -> ddos-observe incident). trafficstat.tick forwards
#   iface.ListRates() (RxBps = RxBytes delta, bytes/sec) for every kernel link,
#   including lo, so a loopback flood drives the BPS baseline. ddos-detect declares
#   Dependencies: ["interface"], which has no darwin backend, so the daemon cannot
#   start on the dev host -- the QEMU Alpine VM runs it. The trigger/unit-conversion
#   logic is covered on any platform (detect/detector_test.go BpsTrigger tests).
#
#   MUTATION-VERIFY (manual, per functional-test-gate.md): set bps-trigger-enable
#   false in the config below (or make detector.go:244 bpsAbove always false) and
#   re-run under QEMU. With the PPS floor unreachable, no incident opens and the
#   observer runtime_fails -- confirming the test gates on the BPS trigger, not on
#   the PPS path.
#
#   TIMING NOTE: the BPS baseline needs baseline-window (10) rate ticks (1s each)
#   before Ready() gates the trigger on. The observer therefore WARMS by pacing a
#   dozen 1s reads (no traffic -> the baseline fills with near-zero samples, so its
#   p99 stays low and the bps-floor governs the threshold) BEFORE the flood. lo is
#   kept the busiest interface by PPS (so applyTick attributes its BPS) while that
#   PPS stays well under the floor. Pacing uses ze_api read_line(timeout=...)
#   (select-based) and time.monotonic deadlines -- never time.sleep (the .ci sleep
#   ratchet is at its baseline).

option=needs-linux
# Serialize against every other ddos test: they all flood the SAME loopback
# interface and the detector picks the victim by top-destination-bytes over that
# interface, so a sibling's concurrent flood is indistinguishable from this
# test's own. Rationale in full: test/plugin/ddos-direction.ci.
option=exclusive:group=ddos-flood
option=env:var=ze.log.ddos.detect:value=info
option=env:var=ze.log.ddos.observe:value=info
option=timeout:value=90s

# ze-peer: accepts the BGP connection so peer1 comes up and launches the observer
# process below (same wiring as ddos-show.ci / anomaly-show.ci).
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=90s
option=asn:value=65001
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

tmpfs=ddos-bps-probe.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
"""Warm the BPS baseline, then blast high-BPS / sub-floor-PPS -> assert an incident.

Runs as an in-daemon observer plugin (5-stage handshake). Pacing is sleep-free:
ze_api.read_line(timeout=...) blocks on select and time.monotonic bounds the loop,
so no time.sleep is added to the .ci sleep ratchet.
"""
import json
import socket
import sys
import time

from ze_api import API, result_text_data, runtime_fail

# Loopback victim allocation for the ddos plugin-suite tests. They share ONE
# network namespace (the QEMU suite runs `bgp plugin -p 4`, no ZE_TEST_NETNS), so a
# victim address and its sink port must be unique per test or the second test to
# bind dies EADDRINUSE:
#   127.0.0.2 ddos-detect-characterize   127.0.0.5 ddos-bps-amplification (this)
#   127.0.0.3 ddos-direction             127.0.0.6 ddos-incident-confidence
#   127.0.0.4 ddos-detect-mitigate       127.0.0.7 ddos-policy
VICTIM = "127.0.0.5"
DPORT = 9999
# 16 KB payloads: on loopback (MTU 65536) each is a single datagram, so bandwidth
# climbs fast while the packet rate stays a few thousand pps -- under the 50000-pps
# floor, but high enough that lo is the busiest interface (applyTick attributes the
# busiest interface's BPS).
PAYLOAD = b"x" * 16000


def dispatch(api, command):
    resp = api._call_engine("ze-plugin-engine:dispatch-command", {"command": command})
    if resp is None:
        return {"status": "error", "data": "engine call returned None"}
    return resp.get("result", {})


# // removed read_dbg()/show() diagnostic scaffolding used while
# root-causing the config-string-coercion bug (session 6503) -- it read a
# /tmp/dbgdetect.log written by temporary detector instrumentation that no longer
# exists. The load-bearing assertion (runtime_fail unless an incident opens) is
# unchanged; only the failure-message detail is trimmed.
def dump_state(api):
    return f"ddos-status={result_text_data(dispatch(api, 'show ddos status'))}"


def status_active(api):
    r = dispatch(api, "show ddos status")
    if r.get("status") != "done":
        return None
    data = result_text_data(r)
    if isinstance(data, str) and data:
        data = json.loads(data)
    if not isinstance(data, dict) or data.get("enabled") is not True:
        return None
    return data.get("active-attacks", 0)


def blast(sock, n):
    sent = 0
    for _ in range(n):
        try:
            sock.sendto(PAYLOAD, (VICTIM, DPORT))
            sent += 1
        except OSError:
            pass
    return sent


def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()
    api.wait_for_post_startup(timeout=5.0)

    # Warm the BPS baseline: ~12 one-second reads with no traffic so the rolling
    # window fills (Ready()) with near-zero samples; the bps-floor then governs the
    # threshold. read_line paces without a time.sleep.
    for _ in range(12):
        api.read_line(timeout=1.0)

    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_SNDBUF, 8 * 1024 * 1024)
    except OSError:
        pass

    # Sink bound on the victim port so the kernel delivers the flood to a socket
    # instead of answering every datagram with an ICMP port-unreachable. On the
    # shared loopback that backscatter is charged to trafficusage's egress-ips for
    # 127.0.0.1 and corrupts the victim attribution of every OTHER ddos test in the
    # namespace (learned/1267). Same pattern as ddos-direction / ddos-policy /
    # ddos-incident-confidence. Unread packets drop silently once the buffer fills.
    sink = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    sink.bind((VICTIM, DPORT))
    sink.setblocking(False)

    detected = False
    sent = 0
    active = 0
    max_active = 0
    deadline = time.monotonic() + 40.0
    try:
        while time.monotonic() < deadline:
            # ~1500 * 16 KB ~= 24 MB per burst; a couple of bursts per second is
            # tens of MB/s at a few thousand pps -- well under the 50000-pps floor,
            # so only the BPS path can fire, yet lo stays the busiest interface.
            sent += blast(sock, 1500)
            active = status_active(api)
            if active is not None:
                max_active = max(max_active, active)
            if active and active > 0:
                detected = True
                break
            # Sleep-free pacing: give the 1s rate tick time to observe the bytes.
            api.read_line(timeout=0.3)
    finally:
        state = dump_state(api)
        sock.close()
        sink.close()

    if not detected:
        runtime_fail(
            f"ddos-detect did not open an incident on a high-BPS / sub-floor-PPS "
            f"flood (sent {sent} 16KB packets, max active-attacks seen={max_active}); "
            f"the BPS trigger did not fire. Final state: {state}"
        )

    print(
        f"OK: BPS trigger opened an incident (active-attacks={active}) with the "
        f"PPS floor unreachable. State: {state}",
        file=sys.stderr,
    )
    dispatch(api, "request shutdown")
    api.wait_for_shutdown()


if __name__ == "__main__":
    main()
EOF_RUN

stdin=ze-bgp:terminator=EOF_CONF
ddos {
	detect {
		enabled true
		absolute-floor 50000
		bps-trigger-enable true
		bps-floor 8000000
		baseline-window 10
		confirm-duration 1
		clear-consecutive-checks 10
		startup-grace 0
		check-interval 1
		characterize-enable false
	}
	observe {
		incident-ring-size 100
	}
}

plugin {
	external ddos-bps-probe {
		run ./ddos-bps-probe.run
		encoder json
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast {
					prefix {
						maximum 10000
					}
				}
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=85s
expect=exit:code=0
