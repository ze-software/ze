# Test: ddos-detect bandwidth (BPS) trigger catches low-PPS / high-bandwidth
# amplification that the packet-rate trigger misses.
#
# VALIDATES: spec-ddos-detect-enhancements AC-1 -- with the PPS floor set far
#            above the flood's packet rate, the ONLY trigger that can fire is the
#            bandwidth path (baselineBps.Ready() && maxBps > BPS threshold). A
#            high-bandwidth flood whose packet rate stays under the floor therefore
#            still opens an incident (show ddos status active-attacks > 0), proving
#            the BPS trigger.
# PREVENTS:  a regression where an NTP/memcached/CLDAP-style amplification flood
#            (large packets, huge bandwidth) slips under the PPS threshold and is
#            never detected.
#
# CONFIG NOTE: bps-threshold-multiplier is left at its default (3.00) rather than
#   set explicitly. It is a YANG decimal-2 leaf with a range, and text-config range
#   validation does not support decimal types (internal/component/config/schema.go
#   parseNumericRangeValue), so an explicit value is rejected at load -- the same
#   reason every ddos .ci uses the default threshold-multiplier/entropy-threshold.
#   The multiplier is irrelevant here anyway: with a near-zero warmed baseline the
#   bps-floor governs the threshold. Since the multiplier default equals the value
#   the test would set, no coverage is lost by the omission.
#   // bps-threshold-multiplier omitted (decimal-2 unsettable via text
#   config, schema.go); default 3.00 == intended value, floor governs the threshold.
#
# STATUS: option=needs-linux. It exercises the full daemon path (iface/trafficstat
#   rate collector on `lo` -> detector applyTick BPS trigger -> state machine ->
#   AttackDetected -> ddos-observe incident). trafficstat.tick forwards
#   iface.ListRates() (RxBps = RxBytes delta, bytes/sec) for every kernel link,
#   including lo, so a loopback flood drives the BPS baseline. ddos-detect declares
#   Dependencies: ["interface"], which has no darwin backend, so the daemon cannot
#   start on the dev host -- the QEMU Alpine VM runs it. The trigger/unit-conversion
#   logic is covered on any platform (detect/detector_test.go BpsTrigger tests).
#
#   MUTATION-VERIFY (manual, per functional-test-gate.md): set bps-trigger-enable
#   false in the config below (or make detector.go:244 bpsAbove always false) and
#   re-run under QEMU. With the PPS floor unreachable, no incident opens and the
#   observer runtime_fails -- confirming the test gates on the BPS trigger, not on
#   the PPS path.
#
#   TIMING NOTE: the BPS baseline needs baseline-window (10) rate ticks (1s each)
#   before Ready() gates the trigger on. The observer therefore WARMS by pacing a
#   dozen 1s reads (no traffic -> the baseline fills with near-zero samples, so its
#   p99 stays low and the bps-floor governs the threshold) BEFORE the flood. lo is
#   kept the busiest interface by PPS (so applyTick attributes its BPS) while that
#   PPS stays well under the floor. Pacing uses ze_api read_line(timeout=...)
#   (select-based) and time.monotonic deadlines -- never time.sleep (the .ci sleep
#   ratchet is at its baseline).

option=needs-linux
# Serialize against every other ddos test: they all flood the SAME loopback
# interface and the detector picks the victim by top-destination-bytes over that
# interface, so a sibling's concurrent flood is indistinguishable from this
# test's own. Rationale in full: test/plugin/ddos-direction.ci.
option=exclusive:group=ddos-flood
option=env:var=ze.log.ddos.detect:value=info
option=env:var=ze.log.ddos.observe:value=info
option=timeout:value=90s

# ze-peer: accepts the BGP connection so peer1 comes up and launches the observer
# process below (same wiring as ddos-show.ci / anomaly-show.ci).
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=90s
option=asn:value=65001
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER


stdin=ze-bgp:terminator=EOF_CONF
ddos {
	detect {
		enabled true
		absolute-floor 50000
		bps-trigger-enable true
		bps-floor 8000000
		baseline-window 10
		confirm-duration 1
		clear-consecutive-checks 10
		startup-grace 0
		check-interval 1
		characterize-enable false
	}
	observe {
		incident-ring-size 100
	}
}

plugin {
	external ddos-bps-probe {
		run "ze-test fixture plugin/ddos-bps-amplification"
		encoder json
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast {
					prefix {
						maximum 10000
					}
				}
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=85s
expect=exit:code=0
