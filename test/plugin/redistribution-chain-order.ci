# Test: multiple filters in chain execute in config order
# VALIDATES: AC-11 -- Piped transform semantics work end-to-end
# VALIDATES: AC-12 -- Chain order matches config hierarchy
# PREVENTS: Wrong filter execution order, second filter not seeing first's output

# ze-peer sends a route to ze
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
option=update:value=send-route:prefix=10.0.0.0/24:next-hop=10.0.0.1:origin-as=65001
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# Python test plugin: declares TWO filters in the same plugin, verifies call order
tmpfs=filter-chain-test.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
import sys
from ze_api import API, runtime_fail
# // test-relax: dropped 'import time'; blind sleep -> wait_for_ack() barrier

call_order = []

def filter_handler(params):
    """Track call order and accept."""
    name = params.get('filter', 'unknown')
    call_order.append(name)
    print(f'filter-update called: filter={name} (call #{len(call_order)})', file=sys.stderr)
    return {'action': 'accept'}

def dispatch(api, command):
    resp = api._call_engine(
        'ze-plugin-engine:dispatch-command', {'command': command})
    if resp is None:
        return {'status': 'error', 'data': 'None'}
    return resp.get('result', {})

def serve_until(api, predicate, attempts=100):
    """Answer plugin callbacks until predicate() holds, or attempts run out.

    ze asks for a filter decision over the callback connection, and only
    api.read_line() answers it. An observer parked in a dispatch RPC leaves that
    request unanswered until the reactor's IPC deadline expires, and on-error
    then decides the route instead of the filter. read_line blocks in select for
    its timeout, so this loop costs no CPU and adds no sleep.
    """
    for _ in range(attempts):
        if predicate():
            return True
        api.read_line(timeout=0.1)
    return predicate()

def main():
    api = API()

    # Declare two named filters
    api.declare_filter(name='first', direction='import', attributes=['as-path'], on_error='reject')
    api.declare_filter(name='second', direction='import', attributes=['community'], on_error='reject')
    api.on_filter_update(filter_handler)
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()

    # Three barriers, in this order.
    # 1. serve_until answers both filter callbacks for the route ze-peer sends.
    # 2. wait_peer_eor_sent blocks until ze has put its initial-sync EOR on the
    #    wire, which is the frame the ze-peer block asserts. quiesce alone
    #    returns instantly while the session is still opening.
    # 3. wait_for_ack drains the forward pool before the daemon stops.
    # // test-relax: blind sleep(2.0) -> callback pump + EOR barrier + quiesce barrier
    serve_until(api, lambda: len(call_order) >= 2)
    if not api.wait_peer_eor_sent():
        runtime_fail('ze sent no end-of-rib to peer1 before shutdown')
    api.wait_for_ack()

    # Both chained filters must have run on the route ze-peer sends, in the
    # order the config lists them.
    if len(call_order) < 2:
        runtime_fail(f'{len(call_order)} filter call(s), expected 2: {call_order}')
    if call_order[0] != 'first' or call_order[1] != 'second':
        runtime_fail(f'wrong filter order: {call_order}')
    print(f'OK: filters called in correct order: {call_order}', file=sys.stderr)

    dispatch(api, 'request shutdown')
    api.wait_for_shutdown()

if __name__ == '__main__':
    main()
EOF_RUN

# ze bgp configuration: two filters from same plugin in order
stdin=ze-bgp:terminator=EOF_CONF
plugin {
    external filter-chain-test {
        run ./filter-chain-test.run;
        encoder json;
    }
}
bgp {
    router-id 1.2.3.4;
    session {
    	asn {
    		local 65000
    	}
    }
    filter {
        import [ filter-chain-test:first filter-chain-test:second ];
    }
    peer peer1 {
        connection {
            remote {
                ip 127.0.0.1
            }
            local {
                ip auto
                accept false
            }
        }
        session {
            asn {
                local 65000
                remote 65001
            }
            family {
                ipv4/unicast { prefix { maximum 10000; } }
            }
        }
    }
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
