# Test: storage-1 AC18 restores the actual BFD meticulous TX sequence.
# VALIDATES: a fresh daemon restores the floor written by the previous session.
# PREVENTS: generic state RPC success hiding a BFD state-lifetime failure.
option=needs-linux
option=exclusive:group=bfd-ports
cmd=foreground:seq=1:exec=ze-test fixture plugin/bfd-auth-meticulous-persist:timeout=40s
expect=exit:code=0
expect=stderr:contains=persisted and restored across restart
