# med-ibgp-post-selection-removal -- a raw export policy cannot drop MED
# before an internal readvertisement.
#
# VALIDATES: the common egress guard keeps MULTI_EXIT_DISC present when the
# route-server egress rail runs a raw=true export filter that returns a full
# UPDATE body with attribute 4 removed.
# VALIDATES: the route source carries MED, and the filter callback proves it
# removed MED from the destination base. A daemon that never runs the raw filter
# or a test that sees only the source route cannot satisfy the assertions.
# This is not full RFC4271-9.1.2.2-2 proof because the runnable path is the
# route-server rail, not normal BGP selected-route readvertisement.

stdin=source:terminator=EOF_SOURCE
option=tcp_connections:value=1
option=timeout:value=20s
# Source UPDATE from an EBGP peer (65001 -> 65000): ORIGIN, AS_PATH [65001],
# NEXT_HOP 1.1.1.1, MED 100, NLRI 10.62.0.0/24.
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0036020000001B4001010040020602010000FDE94003040101010180040400000064180A3E00
expect=bgp:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_SOURCE

stdin=dest:terminator=EOF_DEST
option=tcp_connections:value=1
option=timeout:value=20s
option=bind:value=127.0.0.2
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
# The raw export filter removes this exact attribute from its override. The
# forwarding guard restores it because the destination is internal.
#
# Both needles are `ordered=`, so consumeOrdered (internal/test/peer/checker.go)
# pops them from ONE message, in order, at a byte boundary: MED first, the NLRI
# after it. Two `contains=` needles in one seq group say something else, because
# consumeMatches consumes at most one needle per message, so the pair demanded
# TWO deliveries of the single route. The second delivery is the duplicate relay
# that sendInitialRoutes (internal/component/bgp/reactor/peer_initial_sync.go)
# records as a KNOWN DEFECT, and it is not what this test claims to prove: when
# the export filter's second callback missed the observer's serve loop, ze
# rejected the duplicate, the second needle met the NOTIFICATION instead, and the
# fixture went red over a route it had already asserted correct.
expect=bgp:conn=1:seq=2:ordered=80040400000064
expect=bgp:conn=1:seq=2:ordered=180A3E00
EOF_DEST

tmpfs=raw-med-drop.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
import base64
import sys

from ze_api import API, runtime_fail

removed = []


def drop_med(body):
    if len(body) < 4:
        runtime_fail('RAW-MED-DROP: raw UPDATE body too short')
        raise RuntimeError('short raw body')
    withdrawn_len = int.from_bytes(body[0:2], 'big')
    attrs_len_off = 2 + withdrawn_len
    if attrs_len_off + 2 > len(body):
        runtime_fail('RAW-MED-DROP: withdrawn section overruns body')
        raise RuntimeError('bad withdrawn length')
    attr_len = int.from_bytes(body[attrs_len_off:attrs_len_off + 2], 'big')
    attrs_start = attrs_len_off + 2
    attrs_end = attrs_start + attr_len
    if attrs_end > len(body):
        runtime_fail('RAW-MED-DROP: attribute section overruns body')
        raise RuntimeError('bad attribute length')
    attrs = body[attrs_start:attrs_end]
    out = bytearray()
    pos = 0
    saw_med = False
    while pos < len(attrs):
        if pos + 3 > len(attrs):
            runtime_fail('RAW-MED-DROP: truncated attribute header')
            raise RuntimeError('truncated attribute')
        flags = attrs[pos]
        code = attrs[pos + 1]
        if flags & 0x10:
            if pos + 4 > len(attrs):
                runtime_fail('RAW-MED-DROP: truncated extended attribute header')
                raise RuntimeError('truncated extended attribute')
            length = int.from_bytes(attrs[pos + 2:pos + 4], 'big')
            header_len = 4
        else:
            length = attrs[pos + 2]
            header_len = 3
        end = pos + header_len + length
        if end > len(attrs):
            runtime_fail('RAW-MED-DROP: attribute length overruns section')
            raise RuntimeError('bad attribute span')
        if code == 4:
            saw_med = True
        else:
            out.extend(attrs[pos:end])
        pos = end
    if pos != len(attrs):
        runtime_fail('RAW-MED-DROP: attribute parser stopped early')
        raise RuntimeError('parser stopped early')
    if not saw_med:
        return None
    return body[:attrs_len_off] + len(out).to_bytes(2, 'big') + bytes(out) + body[attrs_end:]


def filter_handler(params):
    if params.get('direction') != 'export':
        return {'action': 'accept'}
    raw_b64 = params.get('raw') or ''
    if not raw_b64:
        runtime_fail('RAW-MED-DROP: export callback had no raw body')
        return {'action': 'reject'}
    body = base64.b64decode(raw_b64)
    stripped = drop_med(body)
    if stripped is None:
        return {'action': 'accept'}
    removed.append(params.get('peer', ''))
    print('RAW-MED-DROP: removed MULTI_EXIT_DISC for %s' % params.get('peer'), file=sys.stderr, flush=True)
    return {'action': 'modify', 'raw': base64.b64encode(stripped).decode('ascii')}


def dispatch(api, command):
    resp = api._call_engine('ze-plugin-engine:dispatch-command', {'command': command})
    if resp is None:
        return {'status': 'error', 'data': 'None'}
    return resp.get('result', {})


def serve_until(api, predicate, attempts=100):
    for _ in range(attempts):
        if predicate():
            return True
        api.read_line(timeout=0.1)
    return predicate()


def main():
    api = API()
    api.declare_filter(name='drop-med-raw', direction='export', on_error='reject')
    api._filters[-1]['raw'] = True
    api.on_filter_update(filter_handler)
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()

    serve_until(api, lambda: len(removed) > 0)
    if not removed:
        runtime_fail('RAW-MED-DROP: export filter never saw the forwarded route')
    if not api.wait_peer_counter('updates-sent', 2, peer='127.0.0.2', attempts=40):
        runtime_fail('RAW-MED-DROP: ze never wrote the restored UPDATE to dest')
    dispatch(api, 'request shutdown')
    api.wait_for_shutdown()


if __name__ == '__main__':
    main()
EOF_RUN

stdin=ze-bgp:terminator=EOF_CONF
plugin {
    internal adj-rib-in {
        use bgp-adj-rib-in;
    }
    internal rs {
        use bgp-rs;
    }
    external raw-med-drop {
        run ./raw-med-drop.run;
        encoder json;
    }
}
bgp {
    router-id 1.2.3.4;
    session {
        asn { local 65000; }
    }
    peer source {
        connection {
            remote { ip 127.0.0.1; }
            local  { ip 127.0.0.4; accept false; }
        }
        session {
            asn { local 65000; remote 65001; }
            family { ipv4/unicast { prefix { maximum 10000; } } }
            capability { graceful-restart disable; }
        }
        behavior { group-updates disable; }
        attach process rs {
            receive [ update-received state open-received refresh ];
            send [ update ];
        }
        attach process adj-rib-in {
            receive [ update-received state ];
            send [ update ];
        }
    }
    peer dest {
        connection {
            remote { ip 127.0.0.2; }
            local  { ip 127.0.0.5; accept false; }
        }
        session {
            asn { local 65000; remote 65000; }
            family { ipv4/unicast { prefix { maximum 10000; } } }
            capability { graceful-restart disable; }
            next-hop self;
        }
        behavior { group-updates disable; }
        filter {
            export [ raw-med-drop:drop-med-raw ];
        }
        attach process rs {
            receive [ update-received state open-received refresh ];
            send [ update ];
        }
        attach process adj-rib-in {
            receive [ update-received state ];
            send [ update ];
        }
    }
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=source
cmd=background:seq=2:exec=ze-peer --bind 127.0.0.2 --port $PORT:stdin=dest
cmd=foreground:seq=3:exec=ze -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
expect=stderr:pattern=RAW-MED-DROP: removed MULTI_EXIT_DISC
reject=stderr:pattern=panic
reject=stderr:pattern=fatal error
reject=stderr:pattern=forward-cached failed
reject=stderr:pattern=release-cached failed
