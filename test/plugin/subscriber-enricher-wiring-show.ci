# Test: show subscriber works with enrichers registered (CoS plugin loaded).
#
# VALIDATES: spec-show-enricher wiring -- enricher registry wired end-to-end.
#            On idle daemon (no sessions): show subscriber returns total=0,
#            show class-of-service returns loaded profiles. Enrichers are
#            registered but have nothing to enrich (no sessions with CoS state).
# PREVENTS:  regression where enricher registration breaks show commands.

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# Native observer fixture: plugin/subscriber-enricher-wiring-show.

stdin=ze-conf:terminator=EOF_CONF
class-of-service {
	ieee-802.1p residential {
		ingress {
			pcp 0 { priority 0; }
			pcp 6 { priority 6; }
		}
		egress {
			priority 0 { pcp 0; }
			priority 6 { pcp 6; }
		}
	}
}

plugin {
	external subscriber-enricher-wiring-show-test {
		run "ze-test fixture plugin/subscriber-enricher-wiring-show"
		encoder json
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-conf:timeout=15s
expect=exit:code=0
