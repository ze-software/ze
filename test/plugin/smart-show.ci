# Test: `show storage smart` RPC dispatches through the plugin engine
# VALIDATES: spec-smart-management AC-8 -- configured daemon returns
#            StatusDone with a `devices` list via ze-show:storage-smart.
# PREVENTS:  regression where the show RPC is unregistered or the manager
#            pointer is never wired, breaking `show storage smart`.

# Native observer fixture: plugin/smart-show.

stdin=ze-conf:terminator=EOF_CONF
plugin {
    external smart-show-done {
        run "ze-test fixture plugin/smart-show"
        encoder json
    }
}

storage {
    smart {
        enabled true
        check-interval 1800
        temperature {
            difference 4
            informational 45
            critical 55
        }
    }
}

bgp {
    peer peer1 {
        connection {
            remote {
                ip 127.0.0.1
            }
            local {
                ip 127.0.0.1
                accept false
            }
        }
        session {
            asn {
                local 1
                remote 1
            }
            router-id 1.2.3.4
            family {
                ipv4/unicast { prefix { maximum 10000; } }
            }
            capability {
                graceful-restart disable
            }
        }
        behavior {
            group-updates disable
        }
    }
}
EOF_CONF

cmd=foreground:seq=1:exec=ze -:stdin=ze-conf:timeout=15s
expect=exit:code=0
