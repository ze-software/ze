# Test: ECMP end-to-end -- multipath add, withdraw, grow through bgp-rib + sysrib
#
# Flow:
# 1. Inject 2 routes for same prefix from different peers via bgp rib inject
# 2. Query bgp rib show best and verify multipath-peers present (AC-1)
# 3. Verify sysrib received the route via rib show
# 4. Withdraw one route, verify multipath-peers empty (AC-2)
# 5. Re-inject second + add third, verify 2 multipath siblings (AC-3)
#
# VALIDATES: spec-fib-depth-2-ecmp AC-1, AC-2, AC-3
# PREVENTS: multipath not wired through bgp-rib or sysrib not receiving best-change

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=20s
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

tmpfs=fib-ecmp-test.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
"""Test: ECMP add / withdraw / grow through bgp-rib multipath + sysrib propagation."""

import json
import sys

from ze_api import API, runtime_fail, result_json_data, result_text_data


def dispatch(api, command):
    resp = api._call_engine(
        'ze-plugin-engine:dispatch-command', {'command': command})
    if resp is None:
        return {'status': 'error', 'data': 'engine call returned None'}
    return resp.get('result', {})


def wait_for_rib(api):
    r = api.dispatch_until_done('show bgp rib status')
    return r.get('status') == 'done'


def get_best_entry(api, prefix):
    """Query bgp rib show best and return the entry for prefix, or None."""
    r = dispatch(api, 'show bgp rib best')
    if r.get('status') != 'done':
        return None
    data_str = result_text_data(r, '{}')
    try:
        parsed = json.loads(data_str) if isinstance(data_str, str) else data_str
    except (json.JSONDecodeError, TypeError):
        return None
    for e in parsed.get('best-path', []):
        if e.get('prefix') == prefix:
            return e
    return None


def best_sibling_count(api, prefix):
    """Multipath sibling count for prefix in bgp rib best, or -1 if the prefix is absent."""
    e = get_best_entry(api, prefix)
    return -1 if e is None else len(e.get('multipath-peers', []))


def sysrib_has_prefix(api, prefix):
    """Check if sysrib has the prefix."""
    r = dispatch(api, 'show rib')
    if r.get('status') != 'done':
        return False
    try:
        entries = result_json_data(r, [])
    except (json.JSONDecodeError, TypeError):
        return False
    if not isinstance(entries, list):
        return False
    return any(e.get('prefix') == prefix for e in entries)


def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()

    api.wait_for_post_startup(timeout=5.0)
    if not wait_for_rib(api):
        runtime_fail('rib plugin did not become ready')

    prefix = '10.50.0.0/24'

    # --- AC-1: Two peers, same prefix -> multipath with both next-hops ---

    r = dispatch(api, f'request bgp rib inject 10.0.0.1 ipv4/unicast {prefix} origin igp localpref 100 aspath 65001')
    if r.get('status') != 'done':
        runtime_fail(f'inject peer1 failed: {r}')

    r = dispatch(api, f'request bgp rib inject 10.0.0.2 ipv4/unicast {prefix} origin igp localpref 100 aspath 65001')
    if r.get('status') != 'done':
        runtime_fail(f'inject peer2 failed: {r}')

    api.wait_until(lambda: best_sibling_count(api, prefix) == 1)

    entry = get_best_entry(api, prefix)
    if entry is None:
        runtime_fail(f'AC-1: {prefix} not in bgp rib show best after injecting 2 routes')

    mp_peers = entry.get('multipath-peers', [])
    if len(mp_peers) != 1:
        runtime_fail(f'AC-1: expected 1 multipath sibling (2 total), got {len(mp_peers)}: {mp_peers}')

    # Verify sysrib also received the route.
    api.wait_until(lambda: sysrib_has_prefix(api, prefix))
    if not sysrib_has_prefix(api, prefix):
        runtime_fail(f'AC-1: {prefix} not in sysrib after bgp-rib best-change')

    print(f'OK AC-1: multipath 2-path: best={entry.get("best-peer")}, siblings={mp_peers}', file=sys.stderr)

    # --- AC-2: Withdraw one peer -> single path ---

    r = dispatch(api, f'request bgp rib withdraw 10.0.0.2 ipv4/unicast {prefix}')
    if r.get('status') != 'done':
        runtime_fail(f'withdraw peer2 failed: {r}')

    api.wait_until(lambda: best_sibling_count(api, prefix) == 0)

    entry = get_best_entry(api, prefix)
    if entry is None:
        runtime_fail(f'AC-2: {prefix} disappeared from best after withdraw')

    mp_peers = entry.get('multipath-peers', [])
    if len(mp_peers) != 0:
        runtime_fail(f'AC-2: expected 0 multipath siblings after withdraw, got {len(mp_peers)}: {mp_peers}')

    # Sysrib should still have the prefix (single path remains).
    if not sysrib_has_prefix(api, prefix):
        runtime_fail(f'AC-2: {prefix} not in sysrib after single withdraw')

    print(f'OK AC-2: single path after withdraw: best={entry.get("best-peer")}', file=sys.stderr)

    # --- AC-3: Add second + third -> 3-path multipath ---

    r = dispatch(api, f'request bgp rib inject 10.0.0.2 ipv4/unicast {prefix} origin igp localpref 100 aspath 65001')
    if r.get('status') != 'done':
        runtime_fail(f're-inject peer2 failed: {r}')

    r = dispatch(api, f'request bgp rib inject 10.0.0.3 ipv4/unicast {prefix} origin igp localpref 100 aspath 65001')
    if r.get('status') != 'done':
        runtime_fail(f'inject peer3 failed: {r}')

    api.wait_until(lambda: best_sibling_count(api, prefix) == 2)

    entry = get_best_entry(api, prefix)
    if entry is None:
        runtime_fail(f'AC-3: {prefix} not in best after adding 3 routes')

    mp_peers = entry.get('multipath-peers', [])
    if len(mp_peers) != 2:
        runtime_fail(f'AC-3: expected 2 multipath siblings (3 total), got {len(mp_peers)}: {mp_peers}')

    print(f'OK AC-3: multipath 3-path: best={entry.get("best-peer")}, siblings={mp_peers}', file=sys.stderr)

    # The peer asserts ze's End-of-RIB frame, so hold the barrier ze_api
    # documents for that shape before shutting the daemon down: this peer
    # attaches a process permitted to send updates, so the initial-sync gate
    # holds the marker and a prompt shutdown closes the session under it.
    if not api.wait_peer_eor_sent():
        runtime_fail('ze did not send the End-of-RIB to the peer before shutdown')
    dispatch(api, 'request shutdown')
    api.wait_for_shutdown()


if __name__ == '__main__':
    main()
EOF_RUN

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external fib-ecmp-test {
		run ./fib-ecmp-test.run
		encoder json
	}
	internal bgp-rib {
		use bgp-rib
	}
	internal rib {
		use rib
	}
}

bgp {
	multipath {
		maximum-paths 4
		relax-as-path true
	}

	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65000
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}

		attach process bgp-rib {
			receive [ update state refresh ]
			send [ update ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
reject=stderr:pattern=panic recovered
reject=stderr:pattern=fatal error
reject=stderr:pattern=ZE-OBSERVER-FAIL
