# Test: ECMP end-to-end -- multipath add, withdraw, grow through bgp-rib + sysrib
#
# Flow:
# 1. Inject 2 routes for same prefix from different peers via bgp rib inject
# 2. Query bgp rib show best and verify multipath-peers present (AC-1)
# 3. Verify sysrib received the route via rib show
# 4. Withdraw one route, verify multipath-peers empty (AC-2)
# 5. Re-inject second + add third, verify 2 multipath siblings (AC-3)
#
# VALIDATES: spec-fib-depth-2-ecmp AC-1, AC-2, AC-3
# PREVENTS: multipath not wired through bgp-rib or sysrib not receiving best-change

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=20s
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER


stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external fib-ecmp-test {
		run "ze-test fixture plugin/fib-ecmp"
		encoder json
	}
	internal bgp-rib {
		use bgp-rib
	}
	internal rib {
		use rib
	}
}

bgp {
	multipath {
		maximum-paths 4
		relax-as-path true
	}

	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65000
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}

		attach process bgp-rib {
			receive [ update state refresh ]
			send [ update ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
reject=stderr:pattern=panic recovered
reject=stderr:pattern=fatal error
reject=stderr:pattern=ZE-OBSERVER-FAIL
