# Test: RFC 7999 Section 3.2 blackhole propagation guard
# VALIDATES: AC-19 -- a route received carrying BLACKHOLE gains NO_EXPORT
# PREVENTS: the guard existing as a function nothing calls. The leaf, the
#           per-peer config lookup and the wire rebuild are all exercised here;
#           the unit test drives only the last of the three.
# RFC requirement: RFC7999-3.2-1 positive -- a receiver adds NO_EXPORT to a
#           route tagged with BLACKHOLE
#
# Flow:
# 1. ze-peer sends UPDATE: ORIGIN=IGP, AS_PATH=[65001], NEXT_HOP=1.1.1.1,
#    COMMUNITY=65535:666 (BLACKHOLE), NLRI=10.0.0.0/24
# 2. The ingress filter reads wireu.CommunityPolicy.RFC7999Blackhole and adds
#    NO_EXPORT (65535:65281)
# 3. The stored route carries BOTH values, asserted through the RIB query and
#    through the production log line

option=env:var=ze.log.bgp.filter.community:value=info
option=env:var=ze.log.bgp.reactor.session:value=debug
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
# Marker(16) + Len=0036(54) + Type=02 + WdLen=0000 + AttrLen=001B(27)
#   ORIGIN:    40010100 (IGP)
#   AS_PATH:   40020602010000FDE9 (AS_SEQ [65001])
#   NEXT_HOP:  40030401010101
#   COMMUNITY: C00804FFFF029A (65535:666, BLACKHOLE per RFC 7999 Section 2)
#   NLRI:      180A0000 (10.0.0.0/24)
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0036020000001B4001010040020602010000FDE940030401010101C00804FFFF029A180A0000
EOF_PEER

# Python test plugin: the stored route must carry BLACKHOLE and NO_EXPORT.
tmpfs=test-blackhole.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
"""Verify the RFC 7999 Section 3.2 guard: NO_EXPORT added beside BLACKHOLE."""
import sys
from ze_api import API, runtime_fail, result_json_data

def dispatch(api, command):
    resp = api._call_engine('ze-plugin-engine:dispatch-command', {'command': command})
    return resp.get('result', {})

def require_route(api, community, why):
    result = dispatch(api, f'show bgp rib received community {community}')
    if result.get('status') != 'done':
        msg = f'{why}: rib show community {community} returned status={result.get("status")}'
        print(f'FAIL: {msg}', file=sys.stderr)
        sys.stderr.flush()
        runtime_fail(msg)

def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()

    # Poll until the route lands, rather than sleeping blind.
    result = api.dispatch_until('show bgp adj-rib-in status',
                                lambda r: result_json_data(r, {}).get('total-routes', 0) >= 1)
    total = result_json_data(result, {}).get('total-routes', -1)
    if total < 0:
        msg = f'adj-rib-in query failed, got total={total}'
        print(f'FAIL: {msg}', file=sys.stderr)
        sys.stderr.flush()
        runtime_fail(msg)

    # BLACKHOLE must survive: the guard adds, it never replaces.
    require_route(api, '65535:666', 'BLACKHOLE must survive ingress')
    # NO_EXPORT must have been added by the guard.
    require_route(api, '65535:65281', 'the RFC 7999 Section 3.2 guard must add NO_EXPORT')

    print('OK: BLACKHOLE survived and NO_EXPORT was added', file=sys.stderr)
    dispatch(api, 'request shutdown')
    api.wait_for_shutdown()

if __name__ == '__main__':
    main()
EOF_RUN

# ze configuration: one eBGP peer with the propagation guard set to no-export.
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external test-blackhole {
		run ./test-blackhole.run
		encoder json
	}
	internal bgp-rib {
		use bgp-rib
	}
}
bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}

		filter {
			ingress {
				community {
					blackhole-propagation no-export
				}
			}
		}
		attach process bgp-rib {
			receive [ update state refresh ]
			send [ update ]
		}
	}
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze --plugin ze.bgp-filter-community --plugin ze.bgp-adj-rib-in -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
# The filter emits one info log when it modifies a received payload. The
# blackhole-propagation field proves the leaf reached the filter, and not just
# that some community rule fired.
expect=stderr:pattern=community ingress applied
expect=stderr:pattern=peer=peer1
expect=stderr:pattern=blackhole-propagation=no-export
# Negative regressions:
reject=stderr:pattern=panic recovered
reject=stderr:pattern=fatal error
reject=stderr:pattern=treat-as-withdraw
reject=stderr:pattern=ZE-OBSERVER-FAIL
