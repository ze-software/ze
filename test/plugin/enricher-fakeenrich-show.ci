# Test: fakeenrich test plugin registers enricher for "show test enrich" command
# VALIDATES: AC-9 (fakeenrich enricher registered in zetest build)
# PREVENTS: in-process enrichment regression from fakeenrich test plugin

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER


stdin=ze-conf:terminator=EOF_CONF
plugin {
    internal fakeenrich {
        use fakeenrich
    }
    external fakeenrich-checker {
        run "ze-test fixture plugin/enricher-fakeenrich-show"
        encoder json
    }
}

bgp {
    peer peer1 {
        connection {
            remote {
                ip 127.0.0.1
            }
            local {
                ip 127.0.0.1
                accept false
            }
        }
        session {
            asn {
                local 1
                remote 1
            }
            router-id 1.2.3.4
            family {
                ipv4/unicast { prefix { maximum 10000; } }
            }
            capability {
                graceful-restart disable
            }
        }
        behavior {
            group-updates disable
        }
    }
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-conf:timeout=15s
expect=exit:code=0
