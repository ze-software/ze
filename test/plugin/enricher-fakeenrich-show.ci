# Test: fakeenrich test plugin registers enricher for "show test enrich" command
# VALIDATES: AC-9 (fakeenrich enricher registered in zetest build)
# PREVENTS: in-process enrichment regression from fakeenrich test plugin

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

tmpfs=fakeenrich-checker.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
"""Verify fakeenrich test plugin enricher is registered and callable."""

import json
import time

from ze_api import API, runtime_fail, result_json_data, result_text_data


def dispatch(api, command):
    resp = api._call_engine(
        'ze-plugin-engine:dispatch-command', {'command': command})
    if resp is None:
        return {'status': 'error', 'data': 'engine call returned None'}
    return resp.get('result', {})


def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()
    api.wait_for_post_startup(timeout=5.0)

    # // poll loop centralized into api.dispatch_until_done (ci-sleep
    # ratchet); behavior and the status assertion below are unchanged.
    result = api.dispatch_until_done('show test enrich')
    if result.get('status') != 'done':
        status = result.get('status') if result else 'nil'
        data = result_text_data(result) if result else ''
        runtime_fail(f'show test enrich: status={status} data={data[:200]}')

    try:
        data = result_json_data(result, {})
    except json.JSONDecodeError as exc:
        runtime_fail(f'show test enrich json: {exc}: {result_text_data(result)[:200]}')
        data = {}

    if data.get('fakeenrich') != 'present':
        runtime_fail(f'expected fakeenrich=present, got {data!r}')

    dispatch(api, 'request shutdown')
    api.wait_for_shutdown()


if __name__ == '__main__':
    main()
EOF_RUN

stdin=ze-conf:terminator=EOF_CONF
plugin {
    internal fakeenrich {
        use fakeenrich
    }
    external fakeenrich-checker {
        run ./fakeenrich-checker.run
        encoder json
    }
}

bgp {
    peer peer1 {
        connection {
            remote {
                ip 127.0.0.1
            }
            local {
                ip 127.0.0.1
                accept false
            }
        }
        session {
            asn {
                local 1
                remote 1
            }
            router-id 1.2.3.4
            family {
                ipv4/unicast { prefix { maximum 10000; } }
            }
            capability {
                graceful-restart disable
            }
        }
        behavior {
            group-updates disable
        }
    }
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-conf:timeout=15s
expect=exit:code=0
