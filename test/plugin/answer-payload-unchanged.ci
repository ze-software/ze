# Test: the reframe moved the frame and none of the payload
#
# Flow:
# 1. A shell script writes a config declaring one external Go SDK plugin
# 2. The daemon starts, spawns `ze-test record-plugin`, and opens SSH
# 3. `ze init` creates operator credentials
# 4. `show test records fault | raw` reads the COLLAPSED wire shape
# 5. `show test records walk | raw` reads the STREAMED wire shape
# 6. Every row of both is compared, byte for byte, with the bytes its producer
#    writes
#
# The producer is recordRow.AppendTo (internal/test/cli/cmd_record_plugin.go).
# It appends `{"index":<n>,"fill":"<fill>"}` with no marshaler, and this spec
# changed no byte of it: `git diff c08252e0a^ HEAD --
# internal/test/cli/cmd_record_plugin.go` touches comments, two renamed item
# type constants and one new command, and no line of AppendTo or recordRows. So
# the literal this test builds IS the byte string an operator received before
# the reframe started, and the comparison is against that rather than against a
# second reading of the same wire.
#
# THE POINT. Every other answer test reads the frame: the kinds, the counted
# fields, the terminator. A frame that parsed can still deliver a payload the
# producer did not write, and no test here would have said so. This one asserts
# the payload and nothing else, so it goes red on a changed payload byte and
# stays green on a changed frame. That is the whole claim of this spec stated as
# a test: only the frame moved.
#
# Both wire shapes are read because the payload takes a different road through
# each. A walk that ends inside rpc.AnswerBufferThreshold collapses into ONE
# counted record carrying the whole document, and a walk that passes it writes
# one counted record for each row. `show test records fault` is the first, at
# twelve rows, and `show test records walk` is the second, at three hundred. A
# byte lost in either road would be lost in only one, and the row count is what
# chooses the road (WriteRecordAnswer, pkg/plugin/rpc/answer_write.go).
#
# `| raw` is the rendering both use, and `| ndjson` cannot serve here. It decodes
# each record and re-encodes it so that the same answer reads the same however
# many records it holds, which alphabetizes the producer's key order
# (writeRecordJSON, internal/component/command/render_records.go). That is a
# rendering the operator asked for, and this test is about the bytes underneath
# it. plugin-owned-command-streams.ci owns the `| ndjson` reading.
#
# The fault walk also carries a row wider than one wire message, which has no
# line at all. What that row's rejection states is frame arithmetic
# (encoded-bytes moves with the prefix width), so this test reads its shape and
# never its numbers. plugin-command-partial-fault.ci owns that assertion.
#
# VALIDATES: AC-8 -- the payload bytes an operator receives are the bytes the
# command produced, unchanged by the reframe.
# VALIDATES: R-6's mitigation -- a payload change is visible rather than hidden
# under the fixture churn the reframe cost.
# PREVENTS: a frame that parses cleanly and hands the operator data the producer
# never wrote: a count clamped to what arrived, a payload byte rewritten on its
# way to the wire, or a row re-marshaled between the plugin and the operator.

# Test script: two wire shapes, one producer, byte for byte
tmpfs=test-answer-payload-unchanged.sh:mode=755:terminator=EOF_SH
#!/bin/sh
set -e

# Signal test runner readiness
touch daemon.ready

cat > answer-payload-unchanged.conf << 'ZECONF'
plugin {
	external record-plugin {
		run "ze-test record-plugin"
		encoder json
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.2
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65533
				remote 65533
			}
		}
	}
}

system {
	authentication {
		user admin {
			password "$2a$04$UlwuiuH82Unfsq.XEMPGJeDkXwbm3KW.nvVaVXOd/JeFK8VjMjrQO"
			profile [ admin ]
		}
	}
	authorization {
		profile admin {
			run {
				default-action allow
			}
			edit {
				default-action allow
			}
		}
	}
}

environment {
	ssh {
		enabled true
		server main {
			ip 127.0.0.1;
			port 0;
		}
	}
}
ZECONF

# Use a PID-derived high port for BGP to avoid needing root for port 179
export ze_test_bgp_port=$((10000 + ($$ % 50000)))

ze start answer-payload-unchanged.conf 2>daemon.log &
DAEMON_PID=$!
trap 'kill $DAEMON_PID 2>/dev/null; wait $DAEMON_PID 2>/dev/null' EXIT

# Wait for the SSH server to report its listening address
SSH_PORT=""
for i in $(seq 1 50); do
	SSH_PORT=$(grep -o '127\.0\.0\.1:[0-9]*' daemon.log 2>/dev/null | head -1 | cut -d: -f2 || true)
	if [ -n "$SSH_PORT" ]; then
		break
	fi
	# poll interval; the loop above breaks as soon as the address is logged
	sleep 0.2
done

if [ -z "$SSH_PORT" ]; then
	echo "FAIL: SSH server did not start (no address in daemon.log)" >&2
	cat daemon.log >&2
	exit 1
fi
echo "SSH port: $SSH_PORT" >&2

# the authorizer is wired by postStartFunc, which logs nothing to wait on
sleep 0.5

ADMIN_DIR=$(mktemp -d)
trap 'rm -rf "$ADMIN_DIR"; kill $DAEMON_PID 2>/dev/null; wait $DAEMON_PID 2>/dev/null' EXIT
printf 'admin\ntestpass\n127.0.0.1\n%s\n' "$SSH_PORT" | ZE_CONFIG_DIR="$ADMIN_DIR" ze init >/dev/null

run_cli() {
	ZE_CONFIG_DIR="$ADMIN_DIR" ZE_SSH_PASSWORD="testpass" ze cli -c "$1"
}

# The plugin registers its commands at Stage 1, and the engine freezes the
# registry after every plugin is ready. Wait for the name to be there rather
# than for a duration.
for i in $(seq 1 50); do
	if run_cli "system command list | raw" 2>/dev/null | grep -q 'show test records walk'; then
		break
	fi
	# poll interval; the loop above breaks as soon as the command is registered
	sleep 0.2
done

# The collapsed shape: a walk inside the buffering threshold reaches the
# operator as ONE counted record carrying the whole document.
if ! run_cli "show test records fault | raw" > collapsed.json 2> collapsed-err.log; then
	echo "FAIL: the collapsed answer did not reach the operator" >&2
	cat collapsed-err.log >&2
	exit 1
fi

# The streamed shape: a walk past the threshold leaves the plugin as one counted
# record for each row, and the engine reads them one at a time.
if ! run_cli "show test records walk | raw" > streamed.json 2> streamed-err.log; then
	echo "FAIL: the streamed answer did not reach the operator" >&2
	cat streamed-err.log >&2
	exit 1
fi

python3 - collapsed.json streamed.json << 'PYEOF'
import json
import sys

# The two walks the plugin produces, and the row the first of them refuses
# (recordFaultRows, recordFaultRowBytes, recordFaultIndex, recordWalkRows,
# recordWalkRowBytes, internal/test/cli/cmd_record_plugin.go).
FAULT_ROWS = 12
FAULT_FILL = 64
FAULT_INDEX = 6
WALK_ROWS = 300
WALK_FILL = 60000


def produced(index, fill):
    """The bytes recordRow.AppendTo writes for one row.

    It appends the two members in this order and quotes nothing else, so the
    string below is the row byte for byte. This spec changed no line of it,
    which is what makes the comparison a comparison against the wire as it was
    before the reframe.
    """
    return '{"index":%d,"fill":"%s"}' % (index, "x" * fill)


def compact(row):
    """Re-encode one decoded row the way its producer wrote it."""
    return json.dumps(row, separators=(",", ":"))


collapsed_path, streamed_path = sys.argv[1], sys.argv[2]

with open(collapsed_path, encoding="utf-8") as handle:
    document = json.load(handle)

if sorted(document) != ["errors", "rows"]:
    print(f"FAIL: the collapsed answer carries {sorted(document)}, want errors and rows", file=sys.stderr)
    sys.exit(1)

rows = document["rows"]
want_indexes = [i for i in range(FAULT_ROWS) if i != FAULT_INDEX]
if len(rows) != len(want_indexes):
    print(f"FAIL: the collapsed answer carries {len(rows)} rows, want {len(want_indexes)}", file=sys.stderr)
    sys.exit(1)

# Every applied row, byte for byte. A row that lost a byte, gained one, or was
# re-marshaled between the plugin and the operator fails here.
for row, index in zip(rows, want_indexes):
    want = produced(index, FAULT_FILL)
    got = compact(row)
    if got != want:
        print(
            f"FAIL: collapsed row {index} reached the operator as {got[:80]!r} ({len(got)} bytes), "
            f"want {want[:80]!r} ({len(want)} bytes)",
            file=sys.stderr,
        )
        sys.exit(1)

# The refused row is a rejection rather than a row, and its numbers are frame
# arithmetic, so its SHAPE is what this test reads.
errors = document["errors"]
if len(errors) != 1 or sorted(errors[0]) != ["encoded-bytes", "limit-bytes", "message", "record"]:
    print(f"FAIL: the collapsed answer rejected {errors}, want one rejection naming its record", file=sys.stderr)
    sys.exit(1)

print(f"OK: {len(rows)} collapsed rows are the bytes the producer wrote", file=sys.stderr)

# Every streamed row, byte for byte, and in walk order.
with open(streamed_path, encoding="utf-8") as handle:
    walk = json.load(handle)

if sorted(walk) != ["rows"]:
    print(f"FAIL: the streamed answer carries {sorted(walk)}, want rows", file=sys.stderr)
    sys.exit(1)

streamed = walk["rows"]

# Fixture precondition: the walk must pass the 256-record threshold, or it
# collapsed and this test read the same wire shape twice.
if len(streamed) <= 256:
    print(f"FAIL: fixture problem -- the walk is {len(streamed)} rows, inside the 256-record threshold", file=sys.stderr)
    sys.exit(1)

if len(streamed) != WALK_ROWS:
    print(f"FAIL: {len(streamed)} streamed rows reached the operator, want {WALK_ROWS}", file=sys.stderr)
    sys.exit(1)

for index, row in enumerate(streamed):
    want = produced(index, WALK_FILL)
    got = compact(row)
    if got != want:
        print(
            f"FAIL: streamed row {index} reached the operator as {got[:80]!r} ({len(got)} bytes), "
            f"want {want[:80]!r} ({len(want)} bytes)",
            file=sys.stderr,
        )
        sys.exit(1)

print(f"OK: {len(streamed)} streamed rows are the bytes the producer wrote", file=sys.stderr)
PYEOF

exit 0
EOF_SH

# Process orchestration
cmd=foreground:seq=1:exec=./test-answer-payload-unchanged.sh:timeout=90s
expect=exit:code=0
expect=stderr:pattern=OK: [0-9]+ collapsed rows are the bytes the producer wrote
expect=stderr:pattern=OK: [0-9]+ streamed rows are the bytes the producer wrote
reject=stderr:pattern=panic recovered
