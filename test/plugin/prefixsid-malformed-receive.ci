expect=bgp:conn=2:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0043020000002C4001010040020602010000FDE9800E1000010404010101010030003E810A0001C0FC09280200000000000000
expect=bgp:conn=2:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF006F02000000584001010040020602010000FDE9800E200001800C0000000000000000010101010070007D010000FDE9000000010A0002C028250500220001001E0020010DB800010000000000000000000000001300010006201010000000
# (b2) relay: MP_UNREACH_NLRI carrying the RFC 8277 Section 2.4 Compatibility 0x800000 in
# place of the received label (007D01). The receiver MUST ignore the field, so the frame is
# still a withdrawal.
expect=bgp:conn=2:seq=3:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002C0200000015800F12000180708000000000FDE9000000010A0002
expect=bgp:conn=2:seq=4:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF007802000000614001010040020602010000FDE9800E200001800C0000000000000000010101010070007D010000FDE9000000010A0003C0282E0100060000000000000500220001001E0020010DB800010000000000000000000000001300010006201010000000
expect=bgp:conn=2:seq=5:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0045020000002E4001010040020602010000FDE9800E1000010404010101010030003E810A0004C0FC0B2803000000000000000000
expect=bgp:conn=2:seq=6:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF003C02000000254001010040020602010000FDE9800E1000010404010101010030003E810A0005C0FC022802
expect=bgp:conn=2:seq=7:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF004C02000000354001010040020602010000FDE9800E200001800C0000000000000000010101010070007D010000FDE9000000010A0006C0FC022802
expect=bgp:conn=2:seq=8:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0054020000003D4001010040020602010000FDE9800E200001800C0000000000000000010101010070007D010000FDE9000000010A0007C0280A010007AABBCC00000064
EOF_PEER

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	internal rs {
		use bgp-rs
	}
	internal adj-rib-in {
		use bgp-adj-rib-in
	}
	external shutdown-after-forward {
		run "le test fixture plugin/prefixsid-malformed-receive"
		encoder json
	}
}
bgp {
	peer source-peer {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			# RFC 8669 Section 4: accept the attribute from this eBGP peer.
			accept-srv6-prefix-sid true
			family {
				ipv4/mpls-label { prefix { maximum 10000; } }
				ipv4/mpls-vpn { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		attach process adj-rib-in {
			receive [ update-received state ]
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
		attach process shutdown-after-forward {
			receive [ update ]
		}
	}
	peer receiver {
		connection {
			remote {
				ip 127.0.0.2
			}
			local {
				ip 127.0.0.2
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65002
			}
			router-id 1.2.3.4
			rs-client true
			# RFC 8669 Section 8: this eBGP peer is inside the SR domain.
			propagate-srv6-prefix-sid true
			family {
				ipv4/mpls-label { prefix { maximum 10000; } }
				ipv4/mpls-vpn { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		attach process adj-rib-in {
			send [ update ]
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
		attach process shutdown-after-forward {
			receive [ update ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
reject=stderr:pattern=panic
reject=stderr:pattern=fatal error
reject=stderr:pattern=forward-cached failed
reject=stderr:pattern=release-cached failed
