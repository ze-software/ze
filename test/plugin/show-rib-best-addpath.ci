# Test: `show bgp rib best` answers ONE best path for a prefix that one ADD-PATH
#       session announces under two path identifiers.
# VALIDATES: spec-bgp-addpath-best-path-per-prefix, through the real daemon. The
#            two paths of 10.0.0.0/24 are candidates of one election, so the
#            answer is one row, and the row is the better path: path id 2, MED 10,
#            over path id 1, MED 50 (RFC 4271 Section 9.1.2.2 step c, MED compared
#            because both paths share neighbor AS 65001).
# PREVENTS: two regressions, each observed red against this file. A candidate
#           gather that asks for one path identifier makes each path its own sole
#           candidate, so the MED 50 path (path id 1) is reported best. An answer
#           that keys its rows by path identifier rather than by prefix answers
#           two "best" rows for one prefix.
#
# The driver waits until the Adj-RIB-In holds both paths before reading the best
# answer, so a read that races the second UPDATE cannot pass or fail by timing.

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=30s
# The paths exist only while this session is up: when the peer goes away ze
# withdraws them. linger holds the session open past the driver's assertions.
option=linger:value=true

# Path id 1, MED 50.
#   ORIGIN:     40010100            IGP
#   AS_PATH:    40020602010000FDE9  AS_SEQUENCE[65001], 4-byte ASNs
#   NEXT_HOP:   4003040A000001      10.0.0.1
#   MED:        80040400000032      50
#   NLRI:       00000001180A0000    path id 1, then 10.0.0.0/24
# attr len = 4+9+7+7 = 27 = 0x1B; total = 19+2+2+27+8 = 58 = 0x3A.
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF003A020000001B4001010040020602010000FDE94003040A0000018004040000003200000001180A0000
# Path id 2, MED 10: the same prefix, the better path.
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF003A020000001B4001010040020602010000FDE94003040A0000018004040000000A00000002180A0000
# ze's ipv4/unicast End-of-RIB (RFC 4724 Section 2: the empty UPDATE). The driver
# waits for it before it reads the RIB, and it keeps this peer from closing first.
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER


stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external best-addpath {
		run "le test fixture plugin/show-rib-best-addpath"
		encoder json
	}
	internal bgp-rib {
		use bgp-rib
	}
}
bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65000
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
				add-path {
					direction send/receive
					family {
						ipv4/unicast
					}
				}
			}
		}

		attach process bgp-rib {
			receive [ update state refresh ]
			send [ update ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=30s
expect=exit:code=0
expect=stderr:contains=OK best: one row for 10.0.0.0/24 path 10.0.0.0/24 [pathID=2] med 10
reject=stderr:pattern=panic recovered
reject=stderr:pattern=fatal error
reject=stderr:pattern=ZE-OBSERVER-FAIL
