# Test: rpki-decorator registers update-rpki event type dynamically
# VALIDATES: AC-1: update-rpki accepted by subscribe-events after decorator registers it
# VALIDATES: AC-8: dynamic event type registration is wired into startup
# PREVENTS: Plugin-registered event types rejected as unknown

# ze-peer: simple peer, sends one route then waits
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=linger:value=true
option=timeout:value=15s
option=update:value=send-route:prefix=10.0.0.0/24:origin-as=65001:next-hop=10.0.0.1
# EOR from ze
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# native test plugin: subscribes to update-rpki, verifies subscription accepted
# Native compiled fixture: plugin/rpki-decorator-register
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	hub {
		server local {
			ip 127.0.0.1;
			port 0;
			secret rpki-reg-test-secret-0123456789abcdef;
		}
	}
	external rpki-reg-test {
		run "ze-test fixture plugin/rpki-decorator-register"
		encoder json
	}
	internal rpki {
		use bgp-rpki
	}
	internal rpki-decorator {
		use bgp-rpki-decorator
	}
	internal adj-rib-in {
		use bgp-adj-rib-in
	}
}

bgp {
	rpki {
		cache-server 127.0.0.1 {
			port $PORT2
		}
	}
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}

		attach process rpki-reg-test {
			receive [ update-rpki ]
		}
		attach process rpki {
			receive [ update-received ]
		}
		attach process rpki-decorator {
			receive [ update-received rpki ]
		}
		attach process adj-rib-in {
			receive [ update-received state ]
		}
	}
}
EOF_CONF

# RTR mock with one VRP so rpki plugin has data
cmd=background:seq=1:exec=ze-test rtr-mock --port $PORT2 --vrp 10.0.0.0/8,32,65001
cmd=background:seq=2:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=3:exec=ze -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
