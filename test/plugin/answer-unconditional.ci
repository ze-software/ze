# Test: every peer receives the record answer, and no peer can ask for another
#
# Flow:
# 1. Daemon starts with two external plugins on one BGP peer
# 2. answer-silent completes Stage 3 and dispatches commands
# 3. answer-second completes Stage 3 and dispatches the same command
# 4. Each plugin asserts the frame it received, on the bytes, not on a decoded
#    payload, and the two frames are compared byte for byte
#
# One answer has one encoding. Stage 3 carries no wire shape to declare, so the
# two plugins share one daemon, one dispatcher and one command and have nothing
# left to differ in. Both must receive a head, one record line and a terminator,
# and the record lines must carry the SAME data bytes.
#
# `system version api` is the compared command because its answer is constant
# (handleSystemVersionAPI, internal/component/plugin/server/system.go), so a
# byte comparison across two dispatches is a comparison of the frames rather
# than of two moments in time.
#
# VALIDATES: AC-1 -- a plugin that completes Stage 3 receives the record answer
# sequence, having declared no protocol name because there is none to declare.
# VALIDATES: AC-10 -- the protocol list has left the Stage 3 message, so a peer
# cannot ask for another encoding.
# PREVENTS: the negotiation returning, which would leave two encodings of one
# answer on the wire and let a peer read either.

# ze-peer expectations: one session so `show bgp peer list` names a real peer.
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=25s
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# The first plugin: it names no protocol, because there is none to name.
tmpfs=answer-silent.run:mode=755:terminator=EOF_SILENT
#!/usr/bin/env python3
"""The first peer: it names no protocol at Stage 3, and reads records."""

import os
import sys

from ze_api import API, runtime_fail

MARKER = "silent-answer.txt"

# The bytes a bounded answer's head and terminator carry, positionally. The head
# is the doc item type, an empty envelope name and empty column names; the
# terminator is one record, no rejected row and no message. Each counted field
# states its own width, so an absent value is `1:0:` rather than a missing field.
WANT_HEAD = "doc 1:0: 1:0:"
WANT_TERMINATOR = "1:1 1:0 1:0:"


def tail_of(line, want_kind):
    """Return the positional tail of one answer line, checking its kind.

    The field after the id is the three-byte kind token, and it is what says
    what the line IS. The tail is never read to find that out, and it carries
    no key name at all.
    """
    parts = line.split(" ", 2)
    if len(parts) != 3 or parts[1] != want_kind:
        runtime_fail(f"unexpected answer line, want kind {want_kind!r}: {line[:120]}")
        return ""
    return parts[2]


def answer_item(api, command):
    """Return the item bytes of a record answer, or fail loudly."""
    lines = api.dispatch_wire_lines(command)
    if len(lines) != 3:
        runtime_fail(f"{command} answered {len(lines)} lines, want head, record, terminator: {lines}")
        return ""
    head = tail_of(lines[0], "top")
    # The doc item type says the one record carries the whole answer as one
    # document, which is what a payload the handler built whole always was. The
    # head states no outcome, and its envelope name and column names are
    # present and empty.
    if head != WANT_HEAD:
        runtime_fail(f"{command} head was {head!r}, want {WANT_HEAD!r}")
    if "=" in head:
        runtime_fail(f"{command} head carries a key=value pair: {head!r}")
    record = tail_of(lines[1], "row")
    terminator = tail_of(lines[2], "end")
    if terminator != WANT_TERMINATOR:
        runtime_fail(f"{command} terminator was {terminator!r}, want {WANT_TERMINATOR!r}")
    return record


def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    # Stage 3 carries capabilities and nothing else. There is no protocol
    # list to put a wire shape in.
    api.capability_done()
    api.wait_for_registry()
    api.ready()
    api.wait_for_post_startup(timeout=5.0)

    version = answer_item(api, "system version api")
    peers = answer_item(api, "show bgp peer list")
    if '"peers"' not in peers:
        runtime_fail(f"show bgp peer list lost its envelope: {peers[:120]}")

    print("OK: the first peer received the record shape", file=sys.stderr)

    # Hand the answer bytes to the other peer. Written to a temporary name and
    # renamed, so the reader never opens a half-written file.
    with open(MARKER + ".tmp", "w", encoding="utf-8") as handle:
        handle.write(version)
    os.rename(MARKER + ".tmp", MARKER)

    api.wait_for_shutdown()


if __name__ == "__main__":
    main()
EOF_SILENT

# The second plugin: a separate peer, on the same daemon, given the same bytes.
tmpfs=answer-second.run:mode=755:terminator=EOF_SECOND
#!/usr/bin/env python3
"""The second peer: it reads the same answer, byte for byte."""

import os
import sys

from ze_api import API, runtime_fail, wait_until

MARKER = "silent-answer.txt"

# The bytes a bounded answer's head and terminator carry, positionally. The head
# is the doc item type, an empty envelope name and empty column names; the
# terminator is one record, no rejected row and no message. Each counted field
# states its own width, so an absent value is `1:0:` rather than a missing field.
WANT_HEAD = "doc 1:0: 1:0:"
WANT_TERMINATOR = "1:1 1:0 1:0:"


def wait_for_silent(timeout=10.0):
    """Return the bytes the first peer received for the same command.

    The other peer writes this file from its own process, so a file appearing has
    no event to wait on and the wait is a bounded poll. The poll INTERVAL lives in
    ze_api.wait_until rather than here: it is a granularity knob on a real
    condition, not a guessed duration, and the ci-sleep ratchet counts sleeps in
    test/**/*.ci so that a knob written here would read as a blind wait.
    """
    interval = 0.25
    if not wait_until(
        lambda: os.path.exists(MARKER),
        attempts=max(1, int(timeout / interval)),
        delay=interval,
    ):
        runtime_fail(f"the first peer wrote no answer within {timeout}s")
        return ""
    with open(MARKER, encoding="utf-8") as handle:
        return handle.read()


def tail_of(line, want_kind):
    """Return the positional tail of one answer line, checking its kind.

    The field after the id is the three-byte kind token, and it is what says
    what the line IS. The tail is never read to find that out, and it carries
    no key name at all.
    """
    parts = line.split(" ", 2)
    if len(parts) != 3 or parts[1] != want_kind:
        runtime_fail(f"unexpected answer line, want kind {want_kind!r}: {line[:120]}")
        return ""
    return parts[2]


def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    # Stage 3, exactly as the first peer sent it. Nothing distinguishes the
    # two declarations, because a declaration carries no wire shape.
    api.capability_done()
    api.wait_for_registry()
    api.ready()
    api.wait_for_post_startup(timeout=5.0)

    silent = wait_for_silent()

    lines = api.dispatch_wire_lines("system version api")
    if len(lines) != 3:
        runtime_fail(f"answer was {len(lines)} lines, want head, record, terminator: {lines}")

    head = tail_of(lines[0], "top")
    if head != WANT_HEAD:
        runtime_fail(f"head was {head!r}, want {WANT_HEAD!r}")
    if "=" in head:
        runtime_fail(f"head carries a key=value pair: {head!r}")

    item = tail_of(lines[1], "row")
    if item != silent:
        runtime_fail(f"record carries {item[:120]!r}, the first peer got {silent[:120]!r}")

    terminator = tail_of(lines[2], "end")
    if terminator != WANT_TERMINATOR:
        runtime_fail(f"terminator was {terminator!r}, want {WANT_TERMINATOR!r}")

    print("OK: the second peer received the same bytes", file=sys.stderr)

    # Every dispatch answer is a sequence, so the shutdown goes out the same
    # way. api.dispatch parses the answer as one JSON payload and would fail on
    # the head's positional tail.
    api.dispatch_wire_lines("request shutdown", timeout=2.0, settle=0.2)
    api.wait_for_shutdown()


if __name__ == "__main__":
    main()
EOF_SECOND

# ze bgp configuration
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external answer-silent {
		run ./answer-silent.run
		encoder json
	}
	external answer-second {
		run ./answer-second.run
		encoder json
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=25s
expect=exit:code=0
expect=stderr:contains=OK: the first peer received the record shape
expect=stderr:contains=OK: the second peer received the same bytes
reject=stderr:pattern=ZE-OBSERVER-FAIL
reject=stderr:pattern=panic recovered
