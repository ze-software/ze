# Test: remove-private-as import policy emits modify decision
# VALIDATES: configured remove-private-as filter is reachable from a peer policy chain.
# PREVENTS: plugin registration or filter reference canonicalization regression.

option=env:var=ze.log.bgp.filter.remove-private-as:value=info

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
option=linger:value=true
# RFC 4271 Section 6.3 lets ze check that the leftmost AS of an eBGP UPDATE is
# the neighbor's own AS, and ze does (firstASMismatch, reactor/session_validation.go).
# The path opens with the neighbor's AS 64497, as a real eBGP speaker's does
# (RFC 4271 Section 5.1.2), and still carries the private 64512 the policy strips.
# UPDATE: ORIGIN=IGP, AS_PATH=[64497 64512], NEXT_HOP=1.1.1.1, NLRI=10.0.0.0/24
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF003302000000184001010040020A02020000FBF10000FC0040030401010101180A0000
EOF_PEER


stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external test-remove-private-as {
		run "ze-test fixture plugin/remove-private-as-import"
		encoder json
	}
}
bgp {
	policy {
		remove-private-as STRIP {
		}
	}

	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 64496
				remote 64497
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast {
					prefix {
						maximum 10000
					}
				}
			}
		}
		filter {
			import [ remove-private-as:STRIP ]
		}
		attach process bgp-adj-rib-in {
			receive [ update-received state ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze --plugin ze.bgp-filter-remove-private-as --plugin ze.bgp-adj-rib-in -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
expect=stderr:pattern=remove-private-as modify
expect=stderr:pattern=filter=STRIP
