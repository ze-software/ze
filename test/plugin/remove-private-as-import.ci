# Test: remove-private-as import policy emits modify decision
# VALIDATES: configured remove-private-as filter is reachable from a peer policy chain.
# PREVENTS: plugin registration or filter reference canonicalization regression.

option=env:var=ze.log.bgp.filter.remove-private-as:value=info

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
# UPDATE: ORIGIN=IGP, AS_PATH=[64512], NEXT_HOP=1.1.1.1, NLRI=10.0.0.0/24
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002F02000000144001010040020602010000FC0040030401010101180A0000
EOF_PEER

tmpfs=test-remove-private-as.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
import time
from ze_api import API, result_json_data

def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()
    api.dispatch_until('show bgp adj-rib-in status', lambda r: result_json_data(r, {}).get('total-routes', 0) >= 1)  # // test-relax: blind sleep -> poll until the accepted route lands in adj-rib-in
    api._call_engine('ze-plugin-engine:dispatch-command', {'command': 'request shutdown'})
    api.wait_for_shutdown()

if __name__ == '__main__':
    main()
EOF_RUN

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external test-remove-private-as {
		run ./test-remove-private-as.run
		encoder json
	}
}
bgp {
	policy {
		remove-private-as STRIP {
		}
	}

	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 64496
				remote 64497
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast {
					prefix {
						maximum 10000
					}
				}
			}
		}
		filter {
			import [ remove-private-as:STRIP ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze --plugin ze.bgp-filter-remove-private-as --plugin ze.bgp-adj-rib-in -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
expect=stderr:pattern=remove-private-as modify
expect=stderr:pattern=filter=STRIP
