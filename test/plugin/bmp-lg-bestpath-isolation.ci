# Test: BMP routes do not affect best-path selection
# VALIDATES: AC-3 -- BMP route exists + real BGP peer has prefix -> best-path selects only real peer
# VALIDATES: AC-4 -- BMP route exists, no real peer -> no best path selected
#
# Flow:
# 1. ze starts with BMP receiver on $PORT2 and a real BGP peer
# 2. Observer sends BMP Route Monitoring for 10.0.0.0/24
# 3. Plugin verifies best-path status shows only real BGP routes, not BMP

option=env:var=ze.log.bgp.bmp:value=info
option=env:var=ze.log.bgp.rib:value=info
option=timeout:value=20s


stdin=ze-bgp:terminator=EOF_CONF
environment {
    bmp {
        enabled true;
        server default {
            ip 127.0.0.1;
            port $PORT2;
        }
    }
}
plugin {
    external bmp-bestpath {
        run "ze-test fixture plugin/bmp-lg-bestpath-isolation $PORT2;"
        encoder json;
    }
}
bgp {
    router-id 1.2.3.5;
    peer test {
        connection {
            remote {
                ip 127.0.0.1
            }
            local {
                ip 127.0.0.1
                accept false
            }
        }
        session {
            asn {
                local 65000;
                remote 65001;
            }
            router-id 1.2.3.5;
            family {
                ipv4/unicast { prefix { maximum 10000; } }
            }
        }
    }
}
EOF_CONF

stdin=peer:terminator=EOF_PEER
EOF_PEER

cmd=background:seq=1:exec=ze-peer --mode sink --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze --plugin ze.bgp-bmp -:stdin=ze-bgp
expect=exit:code=0
expect=stderr:pattern=PASS: BMP routes isolated
