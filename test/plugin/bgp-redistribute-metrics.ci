# Test: bgp-redistribute -- known event sequence drives the consumer through
#       all metric-incrementing branches without runtime errors.
# VALIDATES: AC-14 (functional half) -- the consumer dispatches accepted adds,
#            accepted removes, rule-rejected adds, and BGP-skipped batches in
#            the same daemon process without crashing or hanging, AND each
#            accepted branch produces a route on the wire while the
#            rule-rejected one does not (exactly 4 UPDATEs past the End-of-RIB).
#            Counter cadence itself is asserted in the Go unit test
#            `TestMetricsCadence`; no daemon-side `metrics show` query is
#            available, so the counters themselves are not read here.
# PREVENTS: A regression in any of the four counter-increment branches that
#           does not surface in unit-mocked dispatch.

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=30s
# linger keeps the session up past the EOR. Without it a check-mode ze-peer
# returns as soon as its expectations are met and closes the connection, so the
# five emits below ran against a peer that was already gone: measured on
# 2026-08-03 the peer reported state='connecting', flap-count=1 and
# updates-sent=1 (the EOR alone), i.e. none of the three accepted adds or the
# accepted remove ever reached the wire. The dispatch branches still ran, which
# is what this file's VALIDATES line claims, but nothing downstream of the
# consumer was exercised at all.
option=linger:value=true
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER


stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external metrics-test {
		run "ze-test fixture plugin/bgp-redistribute-metrics"
		encoder json
	}
	internal redistribute-orchestrator {
		use redistribute-orchestrator
	}
	internal fakeredist {
		use fakeredist
	}
}

redistribute {
	destination bgp {
		import fakeredist {
			family [ ipv4/unicast ];
		}
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			# Ze's own address on this session, and what `nhop self` puts on the
			# wire. Deliberately NOT the peer's 127.0.0.1: RFC 4271 Section 5.1.3
			# forbids advertising a peer an address of that peer as NEXT_HOP, so a
			# fixture sharing one address would have every accepted add withheld.
			local {
				ip 127.0.0.4
				accept false
			}
		}
		session {
			asn {
				local 65533
				remote 65533
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		attach process redistribute-orchestrator {
			send [ update ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
