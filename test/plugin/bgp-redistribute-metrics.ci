# Test: bgp-redistribute -- known event sequence drives the consumer through
#       all metric-incrementing branches without runtime errors.
# VALIDATES: AC-14 (functional half) -- the consumer dispatches accepted adds,
#            accepted removes, rule-rejected adds, and BGP-skipped batches in
#            the same daemon process without crashing or hanging, AND each
#            accepted branch produces a route on the wire while the
#            rule-rejected one does not (exactly 4 UPDATEs past the End-of-RIB).
#            Counter cadence itself is asserted in the Go unit test
#            `TestMetricsCadence`; no daemon-side `metrics show` query is
#            available, so the counters themselves are not read here.
# PREVENTS: A regression in any of the four counter-increment branches that
#           does not surface in unit-mocked dispatch.

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=30s
# linger keeps the session up past the EOR. Without it a check-mode ze-peer
# returns as soon as its expectations are met and closes the connection, so the
# five emits below ran against a peer that was already gone: measured on
# 2026-08-03 the peer reported state='connecting', flap-count=1 and
# updates-sent=1 (the EOR alone), i.e. none of the three accepted adds or the
# accepted remove ever reached the wire. The dispatch branches still ran, which
# is what this file's VALIDATES line claims, but nothing downstream of the
# consumer was exercised at all.
option=linger:value=true
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

tmpfs=metrics-test.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
from ze_api import API, runtime_fail


def dispatch(api, command):
    return api._call_engine('ze-plugin-engine:dispatch-command', {'command': command}) or {}


def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()

    # Wait on the peer's own state, then on its initial-sync EOR reaching the
    # wire, instead of holding a fixed 2s and hoping establishment fitted in it.
    if not api.wait_peer_eor_sent():
        runtime_fail('initial-sync EOR never reached the wire')
        return

    # (command, does it produce an UPDATE). The four accepted emits each become
    # one UPDATE, and waiting for the per-peer updates-sent counter to move is
    # what keeps them separate events rather than a batch -- the emit's own
    # effect, not a duration. writeRawUpdateBody
    # (internal/component/bgp/reactor/session_write.go) increments the counter
    # through onMessageReceived once the body reached the session, so baseline
    # before each dispatch: the counter is a per-peer lifetime total that
    # already counts the initial-sync EOR.
    #
    # The ipv6/unicast emit produces NOTHING to wait for, and that is the point
    # of the test. `import fakeredist { family [ ipv4/unicast ]; }` makes
    # ev.Accept(route, consumer) false for the ipv6 family, so the egress
    # redistribute loop (internal/component/bgp/plugins/redistribute_egress/
    # redistribute.go) counts it into filteredRuleTotal and never calls
    # dispatchEntryToConsumer. No UPDATE, no counter move, so waiting for one
    # would simply burn the whole attempt budget and then fail.
    sequence = [
        ('request fakeredist emit add ipv4/unicast 10.0.0.1/32', True),      # accepted add
        ('request fakeredist emit add ipv4/unicast 10.0.0.2/32', True),      # accepted add
        ('request fakeredist emit add ipv4/unicast 10.0.0.3/32', True),      # accepted add
        ('request fakeredist emit remove ipv4/unicast 10.0.0.1/32', True),   # accepted remove
        ('request fakeredist emit add ipv6/unicast 2001:db8::1/128', False), # rule-rejected (family)
    ]
    for cmd, sends in sequence:
        base = api.peer_counter('updates-sent')
        resp = dispatch(api, cmd)
        result = resp.get('result', {})
        if result.get('status') != 'done':
            runtime_fail(f'{cmd}: status={result.get("status")} data={result.get("data")}')
            return
        # 16 attempts x 0.25s = 4s each, so all four waits together stay inside
        # the 20s budget and a break reports THIS message rather than an opaque
        # per-test timeout. The measured wait is about 1s.
        if sends and not api.wait_peer_counter('updates-sent', base + 1, attempts=16):
            runtime_fail(f'{cmd}: its UPDATE was never counted as sent')
            return

    # Assert the four ACCEPTED operations reached the wire and the rejected one
    # did not, instead of holding a blind 2s and asserting nothing. Exactly 4 is
    # the sequence above minus the ipv6 emit: three adds plus one remove, each a
    # separate UPDATE because group-updates is disabled. Above 4 means the
    # rule-rejected ipv6/unicast entry was forwarded; below 4 means an accepted
    # branch incremented a counter without producing a route.
    # assert_peer_received_beyond_eor waits for the EOR and drains the forward
    # pool and each peer's initial-sync opQueue with `request quiesce` first, so
    # the number is a settled total rather than a sample of a race.
    delivered = api.assert_peer_received_beyond_eor('127.0.0.1', minimum=4)
    if delivered != 4:
        runtime_fail(f'{delivered} UPDATEs beyond the End-of-RIB, want exactly 4: '
                     f'the rule-rejected ipv6/unicast entry reached the wire')
        return
    dispatch(api, 'request shutdown')
    api.wait_for_shutdown()


if __name__ == '__main__':
    main()
EOF_RUN

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external metrics-test {
		run ./metrics-test.run
		encoder json
	}
	internal redistribute-orchestrator {
		use redistribute-orchestrator
	}
	internal fakeredist {
		use fakeredist
	}
}

redistribute {
	destination bgp {
		import fakeredist {
			family [ ipv4/unicast ];
		}
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			# Ze's own address on this session, and what `nhop self` puts on the
			# wire. Deliberately NOT the peer's 127.0.0.1: RFC 4271 Section 5.1.3
			# forbids advertising a peer an address of that peer as NEXT_HOP, so a
			# fixture sharing one address would have every accepted add withheld.
			local {
				ip 127.0.0.4
				accept false
			}
		}
		session {
			asn {
				local 65533
				remote 65533
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		attach process redistribute-orchestrator {
			send [ update ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
