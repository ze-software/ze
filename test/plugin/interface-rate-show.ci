# Test: show interface rate is answered by the iface plugin's own rate tracker
# Exercises: dispatch-command -> ze-iface:show-interface-rate -> the daemon's
#            forward (ratesOf) -> the iface plugin's `show interface rate`
#            (executeCommand -> rateAnswer over the tracker the plugin runs)
# Verifies: the `interface` section starts the iface plugin; the named form
#           `show interface rate lo` answers lo's rate once the tracker has
#           sampled, the bare form lists every interface with lo among them,
#           and the named form carries the name through to the lookup and
#           refuses an unknown one with a message naming it

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
option=asn:value=65001
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER


stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external interface-rate-show-test {
		run "le test fixture plugin/interface-rate-show"
		encoder json
	}
}

interface {
	backend netlink;
}

bgp {
	filter {
		import {
			final accept
		}
		export {
			final accept
		}
	}
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast {
					prefix {
						maximum 10000
					}
				}
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
