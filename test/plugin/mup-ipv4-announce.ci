# Migrated from test/data/plugin/mup4.*

# ze-peer expectations
stdin=peer:terminator=EOF_PEER
# The marker below is ZE's own initial-sync End-of-RIB, not a plugin command.
# RFC 4724 Section 2 allows one per family per session and ClaimInitialSyncEOR
# (internal/component/bgp/reactor/reactor_api_forward.go) enforces it, so a
# plugin cannot put a second one on the wire. It is declared FIRST because the
# plugin now holds wait_peer_eor_sent() before it announces: the marker reaches
# the wire before the first route in every timing. It used to sit between the
# two route frames, which held only while the plugin's first send won a race
# against sendInitialRoutes, and CI lost that race on 2026-08-14 (run
# 31782226972: the marker arrived first and the withdraw was diffed against it).
#
# the line deleted here is `cmd=api:seq=2:text=... eor`, the
# ANNOTATION naming the command that produced the marker, and it named one no
# plugin ever ran: this script's message list has carried the announce and the
# withdraw only. It is deleted because it is false, not because the fixture
# stopped asking for the marker. NO assertion is dropped. The marker expectation
# survives at seq=1, and both route frames keep their hex and their json check.
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
# Test IPv4 unicast functionality
cmd=api:conn=1:seq=2:text=peer * update text origin igp local-preference 200 nhop 10.0.1.254 nlri ipv4/unicast add 10.0.1.0/24
expect=bgp:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00300200000015400101004002004003040A0001FE400504000000C8180A0001
expect=json:conn=1:seq=2:json={"meta":{"version":"1.0.0","format":"ze-bgp"},"message":{"type":"update"},"peer":{"address":"127.0.0.1","remote":{"as":65533}},"direction":"in","local-preference":200,"origin":"igp","ipv4/unicast":[{"action":"add","nlri":["10.0.1.0/24"],"next-hop":"10.0.1.254"}]}
cmd=api:conn=1:seq=3:text=peer * update text nlri ipv4/unicast del 10.0.1.0/24
expect=bgp:conn=1:seq=3:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF001B020004180A00010000
expect=json:conn=1:seq=3:json={"meta":{"version":"1.0.0","format":"ze-bgp"},"message":{"type":"update"},"peer":{"address":"127.0.0.1","remote":{"as":65533}},"direction":"in","ipv4/unicast":[{"action":"del","nlri":["10.0.1.0/24"]}]}
# Note: MUP-specific tests commented out pending update text MUP support
# 4:cmd:announce eor ipv4/mup
# 4:cmd:announce ipv4/mup mup-isd 10.0.1.0/24 rd 100:100 next-hop 2001::1 extended-community [target:10:10] bgp-prefix-sid-srv6 ( l3-service 2001:db8:1:1:: 0x48 [64,24,16,0,0,0] )
# 5:cmd:group attributes origin igp local-preference 100 extended-community [target:10:10] bgp-prefix-sid-srv6 ( l3-service 2001:db8:1:1:: 0x48 [64,24,16,0,0,0] ) ; withdraw ipv4/mup mup-isd 10.0.1.0/24 rd 100:100 next-hop 0.0.0.0
EOF_PEER

# Native plugin route driver.

# ze bgp configuration
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external announce-routes {
		run "ze-test fixture plugin/mup-ipv4-announce"
		encoder json
	}
}
bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65000
			}
			router-id 10.0.0.1
			family {
				# ipv4/mup; # MUP not supported by update text yet
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart
			}
		}
		behavior {
			group-updates disable
		}
	
		attach process announce-routes {
			send [ update ]
		}
	}
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=10s
