# Test: a pipe alias a plugin declares reaches the command it was declared for,
# and reaches neither the plugin's own command below it nor a command the plugin
# never declared.
#
# VALIDATES: AC-8. The alias is offered on the parent and on no leaf. The engine
#            derives an empty declaration for every command the plugin declared
#            that sits below a path carrying one of its aliases.
# PREVENTS:  an alias offered over an answer that cannot carry it. lookupAlias
#            reads the LONGEST declared command path and never falls back, so a
#            leaf that declares nothing answers its nearest declared ancestor,
#            and `| totals` over a row list would leave the row whole with
#            nothing reporting why.
#
# Method: a Python plugin declares two commands, one below the other, and one
# alias over the parent. A second process, `ze cli`, types the alias on the
# parent, on the leaf, and on a command of the daemon's own. Only the parent
# answers it.
#
# The timeout is DECLARED because this file starts a daemon, waits for an
# external plugin to reach Stage 5, and launches `ze` several times.
option=timeout:value=60s

# The plugin under test: it declares the parent, the leaf below it, and the
# alias over the parent alone.
tmpfs=pipe-alias-scope-plugin.run:mode=755:terminator=EOF_PLUGIN
#!/usr/bin/env python3
"""Declare a command, a command below it, and a pipe alias over the first."""

from ze_api import API

PARENT = 'show nsalias counters'
LEAF = 'show nsalias counters rows'

# The aggregate keys and the rows are siblings, which is what makes a selection
# able to answer either half.
PARENT_ANSWER = {
    'kind': 'pipe-alias-scope-probe',
    'vrp-count': 7,
    'rows': [
        {'address': '192.0.2.101', 'state': 'established'},
        {'address': '192.0.2.102', 'state': 'connecting'},
    ],
}

# The leaf answers the rows alone. It carries no aggregate, which is the reason
# the alias must not reach it.
LEAF_ANSWER = {
    'rows': [
        {'address': '192.0.2.101', 'state': 'established'},
        {'address': '192.0.2.102', 'state': 'connecting'},
    ],
}


def handle_command(command, args):
    if command == LEAF:
        return {'status': 'done', 'data': LEAF_ANSWER}
    if command == PARENT:
        return {'status': 'done', 'data': PARENT_ANSWER}
    return {'status': 'error', 'data': {'error': 'unknown: ' + command}}


def main():
    api = API()
    api.declare_command(PARENT)
    api.declare_command(LEAF)
    api.declare_pipe(
        command=PARENT,
        name='totals',
        expansion='display kind vrp-count',
        description='The counters alone',
    )
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.on_execute_command(handle_command)
    api.ready()
    api.wait_for_shutdown(timeout=45.0)


if __name__ == '__main__':
    main()
EOF_PLUGIN

tmpfs=run.py:terminator=EOF_PY
"""Start ze with the plugin attached, then type the alias on three commands."""

import os
import subprocess

from ze_api import wait_until


def require(condition, message):
    if not condition:
        raise SystemExit(message)


def run(argv, env):
    result = subprocess.run(
        argv, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, env=env, check=False
    )
    return result.returncode, result.stdout, result.stderr


password_hash = subprocess.check_output(['ze', 'passwd'], input='secret\n', text=True).strip()
with open('pipe-alias-scope.conf', 'w', encoding='utf-8') as fh:
    fh.write('''plugin {
    external pipe-alias-scope-provider {
        run ./pipe-alias-scope-plugin.run
        encoder json
    }
}

system {
    authentication {
        user ci {
            password "''' + password_hash + '''"
            profile [ admin ]
        }
    }
}
''')

daemon_env = os.environ.copy()
daemon_env['ZE_SSH_EPHEMERAL'] = os.path.abspath('ssh.addr')
daemon_env['ZE_READY_FILE'] = os.path.abspath('ready')
daemon_env['ZE_CONFIG_DIR'] = os.getcwd()
# Leave port 179 alone: this suite runs unprivileged and a bind failure there
# takes the daemon down before it writes `ready`.
daemon_env['ze_test_bgp_port'] = str(12000 + os.getpid() % 40000)
daemon = subprocess.Popen(
    ['ze', '-f', 'pipe-alias-scope.conf'],
    stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, env=daemon_env,
)


def daemon_ready():
    if daemon.poll() is not None:
        out, err = daemon.communicate()
        raise SystemExit('daemon exited early\nstdout:\n' + out + '\nstderr:\n' + err)
    return os.path.exists('ssh.addr') and os.path.exists('ready')


try:
    if not wait_until(daemon_ready, attempts=300, delay=0.1):
        raise SystemExit('daemon did not become ready')

    host, port = open('ssh.addr', encoding='utf-8').read().strip().rsplit(':', 1)
    cli_env = os.environ.copy()
    cli_env.update({
        'ZE_SSH_HOST': host,
        'ZE_SSH_PORT': port,
        'ZE_SSH_USERNAME': 'ci',
        'ZE_SSH_PASSWORD': 'secret',
        'ZE_CONFIG_DIR': os.getcwd(),
    })

    def cli(command):
        code, out, err = run(['ze', 'cli', '-c', command], cli_env)
        require(code == 0, '%s exit=%d: %s%s' % (command, code, out, err))
        return out

    # Both commands answer at all. Without this the refusal below could be a
    # command that does not exist rather than an alias that does not reach it.
    if not wait_until(
        lambda: 'vrp-count' in cli('show nsalias counters | json'), attempts=100, delay=0.1
    ):
        raise SystemExit('the plugin parent command never answered')
    leaf = cli('show nsalias counters rows | json')
    require('192.0.2.101' in leaf, 'the leaf command answers no rows: %r' % leaf)

    # The command the alias was declared for answers it.
    only = cli('show nsalias counters | totals | json')
    require('vrp-count' in only, 'the aggregate vrp-count is missing: %r' % only)
    require('192.0.2.101' not in only, 'a row survived `| totals`: %r' % only)

    # The plugin's own command BELOW that path does not. The engine derives the
    # empty declaration that stops the inheritance, because the leaf answers
    # rows and has no aggregate half for a selection to keep.
    code, out, err = run(['ze', 'cli', '-c', 'show nsalias counters rows | totals | json'], cli_env)
    require(
        'unknown pipe operator: totals' in (out + err),
        '`| totals` reached the leaf below the command it was declared for: exit=%d %r %r'
        % (code, out, err),
    )

    # A command the plugin never declared does not either. An alias that reached
    # the global table would answer here.
    code, out, err = run(['ze', 'cli', '-c', 'system command list | totals | json'], cli_env)
    require(
        'unknown pipe operator: totals' in (out + err),
        '`| totals` reached a command the plugin never declared: exit=%d %r %r'
        % (code, out, err),
    )
finally:
    daemon.terminate()
    try:
        daemon.wait(timeout=5)
    except subprocess.TimeoutExpired:
        daemon.kill()
        daemon.wait(timeout=5)

print('OK')
EOF_PY

cmd=foreground:seq=1:exec=python3 run.py
expect=exit:code=0
expect=stdout:contains=OK
