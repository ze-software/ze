# Test: BFD echo mode end-to-end over real UDP sockets.
#
# VALIDATES: spec-bfd-6b+6c -- a ze session with echo enabled
#            reaches Up against a minimal native BFD peer, fires
#            echo TX on UDP 3785, receives reflected echoes, and
#            records RTT histogram samples observable via the
#            telemetry endpoint.
# PREVENTS:  regression where the echo transport never binds 3785,
#            echoTickLocked never fires, or the RTT histogram
#            is never observed.

option=env:var=ze.bfd.test-parallel:value=true
# BFD listens on the RFC 5881 / RFC 5883 FIXED ports, so every concurrently
# running BFD test's daemon binds the same wildcard (0.0.0.0, 3784/3785) tuple.
# SO_REUSEPORT above lets them co-bind, and the kernel then HASHES each inbound
# datagram to one socket in the group (internal/component/bfd/transport/
# udp_linux.go applySocketOptions) -- so a control reply or a reflected echo meant
# for this daemon can be delivered to a sibling test's daemon instead. That is the
# kernel-global surface option=exclusive exists for: unique addresses cannot
# partition a port number the RFC fixes. Tests outside the group still run
# alongside these.
option=exclusive:group=bfd-ports

# RFC 5881 Section 5 requires TTL=255 on received BFD control/echo packets.
# The engine enforces this via the IP_RECVTTL cmsg; the non-Linux transport
# stub (udp_other.go) returns 0 (see parseReceivedTTL) which makes ze fail
# closed and drop every BFD packet. The test cannot pass until a darwin/BSD
# equivalent is implemented, so skip on darwin per rules/os-specific-tests.md.
option=skip-os:value=darwin
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=20s
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# Compiled helper: minimal BFD Control speaker and echo reflector on 127.0.0.2.

# Compiled observer waits for echo metrics before requesting shutdown.

stdin=ze-bfd-echo:terminator=EOF_CONF
plugin {
	external bfd-echo-observe {
		run "ze-test fixture plugin/bfd-echo-handshake $PORT2"
		encoder json
	}
}

environment {
	log {
		bfd debug
	}
}

telemetry {
	prometheus {
		enabled true
		server primary {
			ip 127.0.0.1
			# $PORT2, not a literal. A hardcoded telemetry port sits outside the
			# per-test range the runner hands out, so it is the one listener in
			# this test that another concurrently-running test can collide with --
			# and when it does, ze logs "metrics server failed to start: address
			# already in use" and every scrape below fails on a defect that has
			# nothing to do with BFD.
			port $PORT2
		}
	}
}

bfd {
	enabled true;
	profile echo-fast {
		detect-multiplier 3
		desired-min-tx-us 500000
		required-min-rx-us 500000
		echo {
			desired-min-echo-tx-us 500000
		}
	}
	single-hop-session 127.0.0.2 {
		profile echo-fast
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-test fixture plugin/bfd-echo-handshake-peer
cmd=background:seq=2:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=3:exec=ze -:stdin=ze-bfd-echo:timeout=20s
expect=exit:code=0
