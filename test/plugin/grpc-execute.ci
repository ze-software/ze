# Test: gRPC Execute uses domain request types
# VALIDATES: gRPC transport constructs domain request, engine returns same result
# PREVENTS: gRPC handler broken after domain type refactor

# ze-peer expectations
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=20s
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# compiled Go test plugin: starts, waits for gRPC API, issues Execute RPC

# ze bgp configuration with gRPC API enabled
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external grpc-test {
		run "ze-test fixture plugin/grpc-execute"
		encoder json
	}
}

environment {
	api-server {
		grpc {
			enabled true;
			server main {
				ip 127.0.0.1;
				port 50051;
			}
		}
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
