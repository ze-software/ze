# Test: SDK command dispatch completes version and BGP summary commands
# VALIDATES: both commands return done, and the summary contains its peer fields
#            and configured peer.
# PREVENTS: missing BGP summary data in the SDK dispatch route.
#
# The fixture name is historical. The gRPC listener is enabled, but the fixture
# sends commands through the plugin SDK. This test does not call gRPC Execute.

# ze-peer expectations
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=20s
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# Compiled Go test plugin: waits for the BGP peer's EOR, then uses SDK dispatch.

# ze bgp configuration with gRPC API enabled
stdin=ze-bgp:terminator=EOF_CONF
bus {
	endpoint grpc-test {
		external {
			run "le test fixture plugin/grpc-execute";
		}
		encoding json;
	}
}

environment {
	api-server {
		grpc {
			enabled true;
			server main {
				ip 127.0.0.1;
				port 50051;
			}
		}
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
