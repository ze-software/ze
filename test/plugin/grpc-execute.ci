# Test: gRPC Execute uses domain request types
# VALIDATES: gRPC transport constructs domain request, engine returns same result
# PREVENTS: gRPC handler broken after domain type refactor

# ze-peer expectations
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=20s
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# Python test plugin: starts, waits for gRPC API, issues Execute RPC
tmpfs=grpc-test.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
import sys
from ze_api import API, result_json_data, runtime_fail

def dispatch(api, command):
    try:
        resp = api._call_engine(
            'ze-plugin-engine:dispatch-command', {'command': command})
    except RuntimeError as exc:
        # _call_engine RAISES on an RPC-level error (unknown command, denied).
        # Returning it as a result dict keeps the failure INSIDE main()'s try
        # block so runtime_fail runs while ze is still alive to relay the
        # ZE-OBSERVER-FAIL sentinel. Letting it propagate instead reached the
        # excepthook only AFTER the finally block had shut ze down, and the
        # sentinel was written to a stderr nothing was reading any more: that
        # is why this test passed for months while dispatching a command the
        # daemon answers with "unknown command".
        return {'status': 'error', 'data': str(exc)}
    if resp is None:
        return {'status': 'error', 'data': 'engine call returned None'}
    return resp.get('result', {})

def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()
    api.wait_for_post_startup(timeout=5.0)

    try:
        # Execute via plugin dispatch (exercises the same engine path as gRPC).
        # runtime_fail, never sys.exit: the runner watches ze's exit code, and ze
        # has already exited 0 from the clean shutdown below by the time an
        # observer's sys.exit(1) runs (ai/rules/testing.md, observer-exit
        # antipattern). These three assertions were sys.exit(1) and the test
        # passed for two months while dispatching a command that no longer exists.
        result = dispatch(api, 'show version')
        if result.get('status') != 'done':
            runtime_fail(f'show version status={result.get("status")} data={result.get("data")}')
        print('OK: gRPC-path execute returned status=done', file=sys.stderr)

        # Execute a command that returns structured JSON. Assert on the PAYLOAD,
        # not just the status: an unknown command reports status=error here, and
        # a handler that answered "done" with nothing would still be a defect.
        result = dispatch(api, 'show bgp summary')
        if result.get('status') != 'done':
            runtime_fail(f'show bgp summary status={result.get("status")} data={result.get("data")}')
        summary = result_json_data(result, {})
        if 'peers-configured' not in summary:
            runtime_fail(f'show bgp summary has no peers-configured: {summary}')
        if not any(p.get('address') == '127.0.0.1' for p in summary.get('peers', [])):
            runtime_fail(f'show bgp summary does not list peer 127.0.0.1: {summary}')
        print('OK: gRPC-path summary returned peer data', file=sys.stderr)
    finally:
        dispatch(api, 'request shutdown')
        api.wait_for_shutdown()

if __name__ == '__main__':
    main()
EOF_RUN

# ze bgp configuration with gRPC API enabled
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external grpc-test {
		run ./grpc-test.run
		encoder json
	}
}

environment {
	api-server {
		grpc {
			enabled true;
			server main {
				ip 127.0.0.1;
				port 50051;
			}
		}
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
