# Test: the runtime `request subscribe` command takes effect at once, and the
#       next config apply discards it.
# Exercises: ze-bgp:subscribe -> Subscription.Runtime -> Server.PeerScopedProcs
#            (configured-grant intersection), then SIGHUP -> reconcilePeers ->
#            Server.DiscardRuntimeSubscriptions -> clearRuntimeOverrides.
# VALIDATES: AC-5 and R-10, both directions of the precedence rule: a runtime
# subscription can add to the program's declared capability inside the durable
# configured grant, and a config apply discards the live addition.
# PREVENTS: an operator's permitted live subscribe silently doing nothing once
# the config is authoritative, and a runtime change outliving the document that
# describes the daemon. TestRuntimeSubscribeSurvivesAPublishThatIsNotAnApply
# separately proves an override cannot widen the configured grant.
#
# The traffic under test is the session's own KEEPALIVE stream, at one per
# second. It needs no route injection and no second peer: the daemon produces it
# continuously, so "fed nothing for four seconds" and "fed within eight" are
# both statements about the same steady stream, and each window sees several
# frames.

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=2
option=timeout:value=40s
# One session before the reload and one after it: a changed attach block tears
# the peer down and re-adds it (ProcessBindings sits outside
# hotSwappableSettings), and each session ends its initial sync with an
# End-of-RIB.
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
expect=bgp:conn=2:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER


# Trigger: apply the document again once the override is in force.

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external runtime-subscribe {
		run "ze-test fixture plugin/attach-process-runtime-subscribe"
		encoder json
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		timer {
			receive-hold-time 9
			keepalive 1
		}
		behavior {
			group-updates disable
		}
		attach process runtime-subscribe {
			receive [ keepalive state ]
		}
	}
}
EOF_CONF

# The reloaded document grants the same process one more type, so the apply is a
# real one. It keeps granting keepalive; only discarding the live capability
# addition can stop those events.
tmpfs=config2.conf:terminator=EOF_CONF2
plugin {
	external runtime-subscribe {
		run "ze-test fixture plugin/attach-process-runtime-subscribe"
		encoder json
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		timer {
			receive-hold-time 9
			keepalive 1
		}
		behavior {
			group-updates disable
		}
		attach process runtime-subscribe {
			receive [ keepalive state open-received ]
		}
	}
}
EOF_CONF2

expect=stderr:pattern=RUNTIME-SUB: the program declares state only
expect=stderr:pattern=RUNTIME-SUB: the live subscribe takes effect at once
expect=stderr:pattern=RUNTIME-SUB: the config index is unchanged by the override
expect=stderr:pattern=RUNTIME-SUB: the config apply discards the override

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=background:seq=2:exec=ze-test fixture plugin/attach-process-runtime-subscribe-trigger
cmd=foreground:seq=3:exec=ze -:stdin=ze-bgp:timeout=50s
expect=exit:code=0
