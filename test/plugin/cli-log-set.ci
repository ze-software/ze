# Test: bgp log set changes subsystem level via dispatch-command
#
# Flow:
# 1. BGP session establishes
# 2. native fixture plugin dispatches "show log levels" to see initial levels
# 3. Dispatches "request log level <subsystem> debug" to change a level
# 4. Dispatches "show log levels" again to verify the change
# 5. Shuts down daemon
#
# VALIDATES: AC-2 — bgp log set changes subsystem to specified level.
# PREVENTS: Log set handler not wired or level change not taking effect.

# ze-peer expectations
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s

# EOR
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# native fixture test plugin: exercises dispatch-command for set log

# ze bgp configuration
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external log-set-test {
		run "ze-test fixture plugin/cli-log-set"
		encoder json
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
