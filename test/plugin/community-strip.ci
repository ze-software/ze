# Test: Community filter egress stripping
# VALIDATES: AC-7 -- dest peer receives the re-advertised UPDATE without the stripped community
# PREVENTS: egress community stripping being configured but not applied on the wire

# Source peer (ASN 65001) on 127.0.0.1
option=env:var=ze.log.bgp.filter.community:value=info
# bgp.adj.rib.in, not bgp.adj-rib-in: the plugin registers as "bgp-adj-rib-in"
# (adj_rib_in/register.go) and its engine logger name is CanonicalSubsystemName of
# that (plugin/inprocess.go), which maps every hyphen to a dot. getLogEnv splits
# the subsystem on "." only (core/slogutil/slogutil.go), so a hyphenated key
# matches no lookup and the level silently stays at the WARN default.
option=env:var=ze.log.bgp.adj.rib.in:value=info
option=env:var=ze.log.bgp.reactor.session:value=debug
stdin=source:terminator=EOF_SOURCE
option=tcp_connections:value=1
option=timeout:value=20s
# The source must outlive the DEST peer's assertion, not just its own. Waiting
# for its own End-of-RIB (below) proves nothing about the dest: the two sessions
# establish independently, so under load the source completes and closes while
# the dest is still coming up. ze then correctly reads that close as session-down
# and withdraws the source's routes, and the dest receives the withdraw BEFORE
# the re-advertisement its expect=bgp rule is waiting for -- a mismatch on a
# route that was never wrong. linger holds the session open until teardown, the
# same reason rr-basic.ci and nexthop-self.ci carry it.
option=linger:value=true
# Send UPDATE with COMMUNITY 65000:200: ORIGIN=IGP, AS_PATH=[65001], NEXT_HOP=1.1.1.1,
#   COMMUNITY=65000:200 (0xFDE800C8), NLRI=10.0.0.0/24
# Attrs: ORIGIN(4) + AS_PATH(9) + NEXT_HOP(7) + COMMUNITY(7) = 27 = 0x1B
# Total msg: 16(marker)+2(len)+1(type)+2(wdLen)+2(attrLen)+27(attrs)+4(NLRI) = 54 = 0x36
# COMMUNITY attr (non-extended length): C0 08 04 FDE800C8 (Optional Transitive code=8 len=4 val=65000:200)
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0036020000001B4001010040020602010000FDE940030401010101C00804FDE800C8180A0000
# Hold the source session open long enough for the forwarding plugin to
# re-advertise the route and send EOR.
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_SOURCE

# Dest peer (ASN 65002) on 127.0.0.2 -- expect stripped re-advertisement
stdin=dest:terminator=EOF_DEST
option=tcp_connections:value=1
option=timeout:value=20s
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF003302000000184001010040020A02020000FDE80000FDE940030401010101180A0000
# // the removed End-of-RIB rule was unsatisfiable by construction, so
# it asserted nothing and only produced a red that the runner used to mask. This
# peer's EOR is emitted by its OWN initial sync the moment it establishes
# (peer_initial_sync.go), which is BEFORE the source peer's route is forwarded to
# it. That early EOR does not match the route rule above, and checker.go silently
# swallows an unmatched EOR instead of re-offering it, so the seq=2 slot could
# never be filled -- the shutdown withdraw landed there instead. RFC 4724 orders
# the EOR only against this speaker's own initial dump, never against routes
# learned afterwards, so there is no ordering here for a test to assert. The
# forwarded-route rule above is this test's actual subject and is unchanged.
EOF_DEST

# Python test plugin: keep the daemon alive long enough for the destination wire
# assertion below to complete. The dest-peer `expect=bgp` lines are the proof.
tmpfs=test-strip.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
"""Keep the daemon alive while the dest peer proves egress stripping on the wire."""
import json
import sys
from ze_api import API, runtime_fail, result_json_data, result_text_data

def dispatch(api, command):
    resp = api._call_engine('ze-plugin-engine:dispatch-command', {'command': command})
    return resp.get('result', {})


def dest_got_route(result):
    """True once the dest peer has been sent a real UPDATE, not just its EOR.

    updates-sent counts EVERY UPDATE written to the peer, End-of-RIB included
    (reactor_notify.go IncrUpdatesSent, which sees only the message type).
    eor-sent is the separate marker counter, so the DIFFERENCE is the forwarded
    route this test is about. Comparing updates-sent against 0 would be satisfied
    by the peer's own initial-sync EOR and prove nothing.

    Deliberately NOT gated on state == established. The dest peer is a check-mode
    ze-peer without linger: it closes the moment its expect=bgp rule matches, so
    the very success this predicate is looking for puts the session into
    "connecting" a moment later. Requiring established would make the predicate
    unsatisfiable in exactly the run where the test passed.
    """
    if result.get('status') != 'done':
        return False
    data = result_text_data(result, '{}')
    try:
        parsed = json.loads(data) if isinstance(data, str) else data
    except (json.JSONDecodeError, TypeError, ValueError):
        return False
    if not isinstance(parsed, dict):
        return False
    peers = parsed.get('peers', {})
    if not isinstance(peers, dict):
        return False
    for row in peers.values():
        if not isinstance(row, dict):
            continue
        if row.get('updates-sent', 0) - row.get('eor-sent', 0) >= 1:
            return True
    return False


def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()

    # ONE barrier, on the outbound side, because it implies the inbound one: the
    # dest peer cannot have been sent the re-advertisement unless adj-rib-in
    # learned the route first. Polling adj-rib-in and then the dest peer in
    # sequence cost two full poll budgets, and with the source peer lingering the
    # observer's wall clock IS the test's -- under load the pair overran the
    # test budget while the wire exchange itself had already succeeded.
    #
    # The dest's expect=bgp rule is the authoritative proof of the strip, but it
    # can only run while the daemon is alive and this observer owns `request
    # shutdown`. quiesce() is not the barrier either: it drains the forward pool,
    # which says nothing when the dest was not yet an established forward target
    # at forward time -- the route then arrives on the Adj-RIB-In replay rail,
    # after a quiesce-only observer would already have torn the daemon down.
    #
    # quiesce() FIRST so the poll behind it is a safety net rather than the
    # mechanism: every dispatch_until attempt is a full engine RPC, and 60 of
    # them on a starved daemon outlast the test's own budget -- turning a run
    # whose wire assertions had already passed into an opaque timeout. One
    # barrier RPC plus a short bounded poll costs a couple of round trips in the
    # normal case and still tolerates the replay rail arriving late.
    api.quiesce()
    dest_result = api.dispatch_until(
        'show bgp peer dest-peer detail', dest_got_route, attempts=24,
    )
    dest_data = result_text_data(dest_result)
    if not dest_got_route(dest_result):
        print(f'FAIL: dest-peer detail: {dest_data}', file=sys.stderr)
        sys.stderr.flush()
        runtime_fail('dest peer was never sent the re-advertised route')

    # Diagnostics, not an assertion, and deliberately NOT `< 1`. The forwarded
    # copy and adj-rib-in's own bookkeeping are independent rails: the dest can
    # legitimately have been sent the re-advertisement while this query still
    # reads 0 (observed on role-otc-egress-stamp under load, where both peers
    # reported a clean exchange and this query returned 0 in the same
    # millisecond). Only a FAILED query (result_json_data's -1 default) is a
    # fault here; the strip proof is the dest peer's expect=bgp rule.
    total = result_json_data(dispatch(api, 'show bgp adj-rib-in status'), {}).get('total-routes', -1)
    if total < 0:
        msg = f'adj-rib-in query failed, got total={total}'
        print(f'FAIL: {msg}', file=sys.stderr)
        sys.stderr.flush()
        runtime_fail(msg)

    print(f'INFO: adj-rib-in total={total}', file=sys.stderr)
    print(f'INFO: dest-peer detail after the re-advertisement: {dest_data}', file=sys.stderr)
    print('OK: dest peer was sent the re-advertised route', file=sys.stderr)
    dispatch(api, 'request shutdown')
    api.wait_for_shutdown()

if __name__ == '__main__':
    main()
EOF_RUN

# ze configuration: two peers, egress strip on dest peer
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	internal rs {
		use bgp-rs
	}
	internal adj-rib-in {
		use bgp-adj-rib-in
	}
	external test-strip {
		run ./test-strip.run
		encoder json
	}
}
bgp {
	community {
		standard unwanted {
			value 65000:200
		}
	}

	peer source-peer {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
		}
		attach process adj-rib-in {
			receive [ update-received state ]
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
	}

	peer dest-peer {
		connection {
			remote {
				ip 127.0.0.2
			}
			local {
				ip 127.0.0.2
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65002
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
		}

		filter {
			egress {
				community {
					strip unwanted
				}
			}
		}
		# This peer is the relay DESTINATION: bgp-rs asks adj-rib-in to replay the
		# stored route here when this session establishes, and each replayed route
		# leaves as an UPDATE on this peer's wire. adj-rib-in therefore originates
		# toward this peer and needs the permission to do it (maySend,
		# internal/component/bgp/reactor/send_permission.go). The source peer
		# needs no such grant: nothing replays toward the peer the route came from.
		attach process adj-rib-in {
			receive [ update-received state ]
			send [ update ]
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
	}
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=source
cmd=background:seq=2:exec=ze-peer --bind 127.0.0.2 --port $PORT:stdin=dest
cmd=foreground:seq=3:exec=ze --plugin ze.bgp-filter-community -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
reject=stderr:pattern=panic recovered
reject=stderr:pattern=fatal error
reject=stderr:pattern=treat-as-withdraw
reject=stderr:pattern=ZE-OBSERVER-FAIL
