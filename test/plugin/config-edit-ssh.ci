# Test: ze config edit routes commands through daemon via SSH
#
# Flow:
# 1. BGP daemon starts with SSH configured
# 2. Plugin verifies SSH server is listening
# 3. Plugin dispatches commands through SSH executor
# 4. Daemon shuts down
#
# VALIDATES: AC-4 — config edit connects via SSH for command execution.
# PREVENTS: Editor unable to reach daemon for operational commands.

# ze-peer expectations
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s

# ze-peer runs as a sink: only a dial target, asserts nothing. This test is about
# `ze config edit` dispatching over SSH (see the flow above); the BGP peer exists
# so ze has a session to configure, and the run-script calls `request shutdown` at
# post-startup.
#
# // test-relax: the ipv4/unicast EOR this block declared was unreachable BY
# CONSTRUCTION, not merely flaky: `request shutdown` fires while ze is still in the
# OPEN handshake, so the peer logs "open recv / open sent / connection closed before
# completion" and the EOR is never sent. The assertion could not fail for a real
# reason, only pass vacuously (before F1) or hang the verdict (after F1). Coverage is
# NOT reduced: nothing here ever asserted BGP wire content -- the SSH dispatch
# assertions in the run-script and expect=exit:code=0 are what this test proves.
# Per plan/spec-fixit-redistribute-establishment-stall.md the honest fixes are
# --mode sink (peer is scaffolding, as here) or reaching Established before shutdown;
# reaching Established would test BGP, which is not this test's subject.
EOF_PEER

# Python test plugin: verifies SSH server is reachable
tmpfs=config-edit-test.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
"""Test: SSH command execution via daemon."""

import socket
import sys
from ze_api import API


def _port_open(host, port):
    try:
        socket.create_connection((host, port), timeout=2).close()
        return True
    except OSError:
        return False


def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()

    # Wait for the SSH server to bind its listener (deterministic replacement for a
    # blind settle sleep): poll until port 2222 accepts a connection.
    # // test-relax: blind sleep(1.5) -> wait_until(TCP connect to SSH port 2222)
    api.wait_until(lambda: _port_open('127.0.0.1', 2222))

    # Verify SSH port is reachable (daemon has SSH listener)
    try:
        s = socket.create_connection(('127.0.0.1', 2222), timeout=2)
        s.close()
        print('OK: SSH port reachable', file=sys.stderr)
    except (ConnectionRefusedError, OSError) as e:
        # Port 2222 might not be bound in test — check via dispatch
        print(f'NOTE: SSH port not on 2222 ({e}), checking via dispatch', file=sys.stderr)

    # Dispatch a read-only command to verify executor path
    resp = api._call_engine(
        'ze-plugin-engine:dispatch-command', {'command': 'show bgp peer list'})
    status = resp.get('result', {}).get('status')
    if status != 'done':
        print(f'FAIL: dispatch status={status}', file=sys.stderr)
        sys.exit(1)

    print('OK: command dispatch works', file=sys.stderr)

    # Shutdown.
    # // test-relax: synchronous `request shutdown` dispatch -> shutdown_fire_and_forget.
    # No assertion changed; this is teardown only. A synchronous dispatch races ze's
    # own socket close: when the close wins (routine under load) _call_engine blocks
    # for its 30s TLS read timeout (ze_api.py:341) then raises "no response for
    # ze-plugin-engine:dispatch-command" (ze_api.py:347), failing a test whose
    # assertions have all already passed. wait_for_shutdown observes the close
    # itself, which is the condition this teardown actually wants.
    api.shutdown_fire_and_forget()
    api.wait_for_shutdown()


if __name__ == '__main__':
    main()
EOF_RUN

# ze bgp configuration with SSH
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external config-edit-test {
		run ./config-edit-test.run
		encoder json
	}
}

system {
	authentication {
		user admin {
			password "$2a$10$abcdefghijklmnopqrstuuABCDEFGHIJKLMNOPQRSTUVWXYZ0123"
		}
	}
}

environment {
	ssh {
		enabled true
		server main {
			ip 127.0.0.1;
			port 2222;
		}
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --mode sink --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
