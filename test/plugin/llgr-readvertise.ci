# Test: LLGR readvertisement — stale routes re-sent to LLGR-capable peer
#
# Flow:
# 1. Connection 1: ze sends static route + EOR
# 2. action=close → TCP drops → GR activates → mark-stale
# 3. GR restart-time (1s) expires → LLGR begins:
#    - LLGR_STALE attached, stale level raised
#    - rib clear out triggers readvertisement of stale routes
# 4. Connection 2: ze reconnects → ribOut replay includes stale routes
#    - ze-peer mirrors LLGR capability (code 71) → LLGR-capable
#    - Egress filter allows stale routes through to LLGR-capable peer
#
# Note: this test proves delivery to one LLGR-capable peer. The multi-peer
# egress divergence (EBGP non-LLGR peer withdrawn; non-LLGR IBGP peer gets
# NO_EXPORT + LOCAL_PREF=0) has NO on-the-wire test yet: the egress filter is
# not invoked on the RIB readvertise / AnnounceNLRIBatch rail, so the stamping
# never fires end-to-end (root cause + file:line chain in
# plan/spec-rib-arch-7-llgr-multipeer-ci.md, which owns the wiring work and the
# future multi-peer .ci). The per-peer branch logic itself has 8 unit tests in
# gr_egress_test.go.
#
# VALIDATES: AC-9 — LLGR-capable peer receives stale routes.
# PREVENTS: Egress filter incorrectly suppressing routes to LLGR-capable peers.

# ze-peer expectations
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=2
option=timeout:value=15s

# Connection 1: Static route + EOR from ze
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00300200000015400101004002004003040A0000014005040000006418C0A801
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
# TCP close → GR → LLGR → readvertisement triggered
action=close:conn=1:seq=2

# Connection 2: ribOut replay — stale routes re-sent to LLGR-capable peer
# Routes survived LLGR and are readvertised with LLGR_STALE
# (static route × 2: config + RIB replay, then EOR)
expect=bgp:conn=2:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00300200000015400101004002004003040A0000014005040000006418C0A801
expect=bgp:conn=2:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# ze bgp configuration — IBGP (matching AS) with LLGR capability
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	internal gr {
		use bgp-gr
	}
	internal bgp-rib {
		use bgp-rib
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart {
					restart-time 1
					long-lived-stale-time 60
				}
			}
		}
		behavior {
			group-updates disable
		}
		timer { connect-retry 3; }

		update {
			attribute {
				origin igp
				local-preference 100
				next-hop 10.0.0.1
			}
			nlri {
				ipv4/unicast add 192.168.1.0/24
			}
		}

		attach process gr {
			receive [ open-received state eor ]
			send [ update ]
		}
		attach process bgp-rib {
			receive [ update state refresh ]
			send [ update ]
		}
	}
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=20s
