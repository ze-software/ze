# Test: show firewall irr displays cached IRR data
# VALIDATES: AC-3 -- JSON output listing cached entries with prefix counts
# VALIDATES: AC-11 -- show firewall irr prefix lists cached prefixes
# PREVENTS: show command returning empty or malformed JSON
#
# Flow:
# 1. Mock IRR server provides AS-TEST data
# 2. Observer fetches AS-TEST via update command
# 3. Observer dispatches "show firewall irr" and verifies JSON structure
# 4. Observer dispatches "show firewall irr prefix AS-TEST" and verifies prefix list

# This test programs nftables, so it needs CAP_NET_ADMIN, not merely Linux.
# skip-os:value=darwin only hid it from macOS: on an unprivileged Linux host it
# RAN, the firewall plugin died with "firewallnft: list tables: netlink receive:
# operation not permitted" during its stage-3 handshake, the daemon never
# reached the asserted state, and the test hung or failed. Declaring the
# capability turns that into an honest skip naming the runner where it does
# execute (ai/rules/qemu-testing.md).
option=needs-linux:caps=net-admin
option=env:var=ze.log.firewall.irr:value=debug
option=timeout:value=20s

tmpfs=firewall-irr-show.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
"""Verify show firewall irr returns correct JSON."""
import json
import sys
from ze_api import API, runtime_fail, result_json_data

def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()

    # First fetch some data so show has something to display.
    result = api.dispatch_until_done('update firewall irr as-set AS-TEST')
    if result.get('status') != 'done':
        runtime_fail(f'update failed: {result}')

    # Show all IRR entries.
    result = api.dispatch_until_done('show firewall irr')
    if result.get('status') != 'done':
        runtime_fail(f'show firewall irr: status={result.get("status")}')

    data = result_json_data(result, {})
    if 'server' not in data:
        runtime_fail(f'show response missing server: {data}')

    # Show prefixes for a specific entry.
    result = api.dispatch_until_done('show firewall irr prefix AS-TEST')
    if result.get('status') != 'done':
        runtime_fail(f'show firewall irr prefix: status={result.get("status")}')

    prefix_data = result_json_data(result, {})
    if 'ipv4' not in prefix_data:
        runtime_fail(f'prefix response missing ipv4: {prefix_data}')

    v4_prefixes = prefix_data.get('ipv4', [])
    if len(v4_prefixes) < 1:
        runtime_fail(f'expected at least 1 v4 prefix, got {len(v4_prefixes)}')

    print(f'OK: show firewall irr returned {len(v4_prefixes)} v4 prefixes', file=sys.stderr)

    resp = api._call_engine('ze-plugin-engine:dispatch-command', {'command': 'request shutdown'})
    api.wait_for_shutdown()

if __name__ == '__main__':
    main()
EOF_RUN

stdin=ze-fw:terminator=EOF_CONF
plugin {
	external firewall-irr-show-test {
		run ./firewall-irr-show.run
		encoder json
	}
}
firewall {
	backend nft;
	irr {
		server 127.0.0.1:$PORT2;
	}
}
bgp {
	peer peer1 {
		connection {
			remote { ip 127.0.0.1; }
			local { ip 127.0.0.1; accept false; }
		}
		session {
			asn { local 1; remote 1; }
			router-id 1.2.3.4;
			family { ipv4/unicast { prefix { maximum 10000; } } }
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-test irr --port $PORT2
cmd=foreground:seq=2:exec=ze --plugin ze.firewall-irr -:stdin=ze-fw:timeout=20s
expect=exit:code=0
