# rfc9774-as-set-accept-migrated -- a peer migrated from an ExaBGP neighbor with
# `as-set accept` keeps a received route whose AS_PATH holds an AS_SET.
#
# RFC 9774 Section 3: "Unless explicitly configured by a network operator to do
# otherwise (e.g., during a transition phase), BGP speakers:" ... "MUST use the
# "treat-as-withdraw" error handling behavior per [RFC7606] upon reception of BGP
# UPDATE messages containing AS_SETs or AS_CONFED_SETs in the AS_PATH or AS4_PATH
# [RFC6793]." `session as-set accept`, which only `ze exabgp migrate` writes, is
# that operator configuration.
#
# VALIDATES: the peer announces P (10.1.0.0/24) with AS_PATH AS_SEQUENCE [65001]
# then AS_SET {65010 65011}. The observer plugin receives P as announced, with
# the set in its AS_PATH, the session stays up, and no RFC 9774 verdict is logged.
# PREVENTS: a migrated peer withdrawing the routes its ExaBGP neighbor kept.
# The withdraw default is rfc9774-as-set-receive-treat-as-withdraw.ci.

stdin=peer:terminator=EOF_PEER
option=timeout:value=20s
option=bind:value=0.0.0.0
option=linger:value=true

# seq=1: P, ORIGIN IGP, AS_PATH AS_SEQUENCE [65001] then AS_SET {65010 65011},
# NEXT_HOP 1.1.1.1.
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0039020000001E4001010040021002010000FDE901020000FDF20000FDF340030401010101180A0100

EOF_PEER

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external observer {
		run "le test fixture plugin/rfc9774-as-set-accept-migrated"
		encoder json
	}
}
bgp {
	peer source-peer {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
			# Written by ze exabgp migrate for an ExaBGP neighbor with
			# `as-set accept` (test/exabgp/as-set-accept/expected.conf).
			as-set accept
		}
		behavior {
			group-updates disable
		}
		attach process observer {
			receive [ update ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
expect=stderr:contains=ZE-AS-SET-KEPT prefix=10.1.0.0/24
expect=stderr:contains=65010
reject=stderr:pattern=RFC 9774 Section 3
reject=stderr:pattern=ZE-OBSERVER-FAIL
reject=stderr:pattern=panic
reject=stderr:pattern=fatal error
