# Test: a selected protocol-only SCTP rule reaches both kernel hooks.
# VALIDATES: protocol132 lowers to SCTP without widening or requiring a port.
# PREVENTS: an unlowerable protocol freezing firewall reconciliation, or a
# raw-UPDATE fixture passing without retained unicast authorization.
option=needs-linux:caps=net-admin
# Both suites use the kernel-global ze_flowspec table.
option=exclusive:group=flowspec-nft
option=env:var=ze.log.firewall:value=info
option=env:var=ze.log.flowspec.firewall:value=info
option=timeout:value=40s

stdin=peer:terminator=EOF_PEER
option=linger:value=true
option=tcp_connections:value=1
option=timeout:value=35s
# Eligible covering unicast precedes every selected FlowSpec rule.
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002E02000000154001010040020040050400000064400304C0000201080A
# Destination10.1.0.0/24, protocol132, discard. No port component.
action=send:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0041020000002A4001010040020040050400000064800E0E00018500000801180A0100038184C010088006000000000000
EOF_PEER

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	internal flowspec-firewall { use flowspec-firewall; }
}
bgp {
	peer peer1 {
		connection {
			remote { ip 127.0.0.1; }
			local { ip 127.0.0.1; accept false; }
		}
		session {
			asn { local 1; remote 1; }
			router-id 1.2.3.4;
			family {
				ipv4/unicast { prefix { maximum 10000; } }
				ipv4/flow { prefix { maximum 10000; } }
			}
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=background:seq=2:exec=ze -:stdin=ze-bgp
cmd=foreground:seq=3:exec=le-test fixture plugin/flowspec-fw-protocol-sctp:timeout=35s
expect=exit:code=0
expect=stdout:contains=table inet ze_flowspec
expect=stdout:contains=chain flowspec-in
expect=stdout:contains=chain flowspec-fwd
expect=stdout:pattern=daddr 10\.1\.0\.0/24 meta l4proto (132|sctp)( counter packets [0-9]+ bytes [0-9]+)? drop
