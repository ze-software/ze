# Test: the boot guard leaves insecure web published by env var on 0.0.0.0 down while ze starts
# VALIDATES: spec-fixit-mgmt-listener-auth-guard AC-3 and the 2026-11-26 ruling
# (plan/records/ruling-ze-always-starts.md) -- the --insecure-web FLAG and the
# YANG insecure leaf both clamp the bind to loopback, but the ze.web.insecure
# ENV VAR rewrites no address. With ze.web.listen left at its 0.0.0.0:3443
# default, the unauthenticated InsecureMiddleware served every interface. The
# guard must filter out that listener before anything binds (applying the
# default before filtering so the guard cannot pass an empty address slice)
# while ze starts and reports the breach under doctor-service-not-started.
# PREVENTS: two environment variables, with no config file and no CLI flag,
# publishing a credential-free web UI that injects a username for every request,
# or preventing ze from starting.

option=exclusive:group=mgmt-guard
option=env:var=ze.web.enabled:value=1
option=env:var=ze.web.insecure:value=1

stdin=ze-bgp:terminator=EOF_CONF
environment {
}
EOF_CONF

cmd=background:seq=1:name=daemon:exec=ze -:stdin=ze-bgp:ready=Ze running
expect=stderr:contains=refusing to start web (insecure) on non-loopback listener "0.0.0.0:3443" without authentication
expect=stderr:contains=bind ze.web.listen to 127.0.0.1
expect=stderr:contains=code=doctor-service-not-started
reject=stderr:contains=web server listening
cmd=stop:seq=2:name=daemon:signal=term
