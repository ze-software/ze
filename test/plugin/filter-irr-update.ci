# Test: update bgp irr triggers immediate refresh
# VALIDATES: AC-6a -- update bgp irr all refreshes all peers
# VALIDATES: AC-20 -- manual refresh via update bgp irr all
# PREVENTS: Manual refresh command silently fails or has no effect
#
# Flow:
# 1. Mock IRR server provides AS-TEST -> prefixes
# 2. ze starts with IRR filter configured
# 3. Observer issues "update bgp irr all" and verifies it succeeds
# 4. Observer verifies show bgp irr returns status

option=env:var=ze.log.bgp.filter.irr:value=info

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=20s
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002F02000000144001010040020602010000FDE940030401010101180A0000
EOF_PEER

tmpfs=test-filter-irr-update.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
"""Verify update bgp irr all triggers refresh."""
import json
import sys
import time
from ze_api import API, result_json_data

def dispatch(api, command):
    resp = api._call_engine('ze-plugin-engine:dispatch-command', {'command': command})
    return resp.get('result', {})

def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()

    # // test-relax: removed two fixed sleeps. `update bgp irr all` is now
    # synchronous and authoritative (refreshAllNow), so dispatch_until_done
    # retries past mock-IRR startup with no sleep, and the post-refresh sleep is
    # redundant once the command returns "done". Assertions are unchanged.
    # Trigger manual refresh (retries until the synchronous refresh reports done).
    result = api.dispatch_until_done('update bgp irr all')
    status = result.get('status', '')
    if status != 'done':
        print(f'FAIL: update bgp irr all status={status}', file=sys.stderr)
        dispatch(api, 'request shutdown')
        api.wait_for_shutdown()
        sys.exit(1)

    # Verify show bgp irr works.
    result = dispatch(api, 'show bgp irr')
    status = result.get('status', '')
    if status != 'done':
        print(f'FAIL: show bgp irr status={status}', file=sys.stderr)
        dispatch(api, 'request shutdown')
        api.wait_for_shutdown()
        sys.exit(1)

    print('OK: update bgp irr all succeeded, show bgp irr returned data', file=sys.stderr)
    dispatch(api, 'request shutdown')
    api.wait_for_shutdown()

if __name__ == '__main__':
    main()
EOF_RUN

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external test-filter-irr-update {
		run ./test-filter-irr-update.run
		encoder json
	}
}
bgp {
	policy {
		irr {
			server 127.0.0.1:$PORT2
			refresh-interval 3600
		}
	}

	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			irr {
				as-set AS-TEST
			}
		}

		filter {
			import [ bgp-filter-irr:65001 ]
		}

		process test-filter-irr-update {
			receive [ update state ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-test irr --port $PORT2
cmd=background:seq=2:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=3:exec=ze --plugin ze.bgp-filter-irr --plugin ze.bgp-adj-rib-in -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
expect=stderr:pattern=irr: refreshed
