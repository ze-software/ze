# Test: update irr all triggers an immediate refresh of what BGP enforces
# VALIDATES: AC-6a -- update irr all refreshes every AS-SET a peer is filtered by
# VALIDATES: AC-20 -- manual refresh via update irr all
# VALIDATES: spec-fetched-data-survives-restart AC-15 -- the irr plugin owns the
#            update command; the BGP filter has none
# PREVENTS: Manual refresh command silently fails or has no effect
#
# Flow:
# 1. Mock IRR server provides AS-TEST -> prefixes
# 2. ze starts with IRR filter configured; the irr plugin fetches AS-TEST and
#    stores it ("irr dataset stored")
# 3. Observer issues "update irr all" and verifies it succeeds
# 4. Observer verifies show bgp irr returns status

option=env:var=ze.log.bgp.filter.irr:value=info
option=env:var=ze.log.irr:value=info

stdin=peer:terminator=EOF_PEER
# Keep the scripted connection open until the manual refresh observer finishes.
# Its peer-progress wait prevents successful IRR commands from ending the daemon
# before the peer completes OPEN and sends its UPDATE.
option=linger:value=true
option=tcp_connections:value=1
option=timeout:value=20s
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002F02000000144001010040020602010000FDE940030401010101180A0000
EOF_PEER


stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external test-filter-irr-update {
		run "le test fixture plugin/filter-irr-update"
		encoder json
	}
}
system {
	irr {
		server 127.0.0.1:$PORT2
		refresh-interval 3600
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			irr {
				as-set AS-TEST
			}
		}

		filter {
			export { final accept; }
			import { filters [ bgp-filter-irr:65001 ]; final accept; }
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=le mock irr --port $PORT2
cmd=background:seq=2:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=3:exec=ze --plugin ze.bgp-filter-irr --plugin ze.bgp-adj-rib-in -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
expect=stderr:pattern=irr dataset stored
