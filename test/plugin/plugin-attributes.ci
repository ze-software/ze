# Native plugin route driver.

# ze bgp configuration
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external add-remove {
		run "ze-test fixture plugin/plugin-attributes"
		encoder json
	}
}
bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
		}
		behavior {
			group-updates disable
		}
	
		attach process add-remove {
			send update
			# The peer-up event. The process announces its whole set into this
			# peer's INITIAL routing update and reports when it is out, so the
			# End-of-RIB below waits for it. A process the peer never tells
			# about the session is not waited for, and the marker then arrives
			# in the middle of the announces (Peer.initialUpdateReporters).
			receive [ state ]
		}
	}
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=10s
