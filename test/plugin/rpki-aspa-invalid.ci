# Test: ASPA verification yields Invalid when unauthorized hop detected
# VALIDATES: AC-3 — route with unauthorized provider hop -> aspa-state=invalid
# PREVENTS: Unauthorized paths not detected by ASPA verification

# ze-peer: send route 10.0.1.0/24 with AS_PATH [64500, 64501, 64502]
# 64502 has ASPA record but does NOT authorize 64501 -> Invalid
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
option=update:value=send-route:prefix=10.0.1.0/24:origin-as=64502:next-hop=10.0.0.1:as-path=64500,64501,64502
# EOR from ze
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# Python observer: check aspa-state=invalid
tmpfs=rpki-aspa-invalid-test.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
import json
import sys
import time
from ze_api import API

def dispatch(api, command):
    resp = api._call_engine(
        'ze-plugin-engine:dispatch-command', {'command': command})
    if resp is None:
        return {'status': 'error', 'data': 'engine call returned None'}
    return resp.get('result', {})

def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()

    api.subscribe(['rpki direction received'])
    api.ready()

    time.sleep(5.0)

    try:
        found = False
        for _ in range(30):
            event_str = api.read_line(timeout=0.5)
            if event_str is None:
                continue
            try:
                evt = json.loads(event_str)
            except (json.JSONDecodeError, TypeError):
                continue
            bgp = evt.get('bgp', {})
            msg = bgp.get('message', {})
            if msg.get('type') != 'rpki':
                continue
            rpki = bgp.get('rpki', {})
            if not isinstance(rpki, dict):
                continue
            if rpki.get('status') == 'unavailable':
                continue
            aspa_state = rpki.get('aspa-state')
            if aspa_state == 'invalid':
                found = True
                print('OK: rpki event has aspa-state=invalid', file=sys.stderr)
                break
            elif aspa_state is not None:
                print(f'INFO: aspa-state={aspa_state}, waiting for invalid', file=sys.stderr)

        if not found:
            print('FAIL: no rpki event with aspa-state=invalid', file=sys.stderr)
            sys.exit(1)
    finally:
        dispatch(api, 'daemon shutdown')
        api.wait_for_shutdown()

if __name__ == '__main__':
    main()
EOF_RUN

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	hub {
		server local {
			ip 127.0.0.1;
			port 0;
			secret rpki-test-secret-key-01234567890;
		}
	}
	external rpki-aspa-invalid-test {
		run ./rpki-aspa-invalid-test.run
		encoder json
	}
	external rpki {
		use bgp-rpki
		encoder json
	}
	external adj-rib-in {
		use bgp-adj-rib-in
		encoder json
	}
}

bgp {
	rpki {
		cache-server 127.0.0.1 {
			port $PORT2
		}
		aspa-validation true;
	}
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 64500
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}

		process rpki-aspa-invalid-test {
		}
		process rpki {
			receive [ update ]
		}
		process adj-rib-in {
			receive [ update state ]
		}
	}
}
EOF_CONF

# RTR mock: VRP + ASPA where 64502 authorizes 99999 (NOT 64501) -> Invalid
cmd=background:seq=1:exec=ze-test rtr-mock --port $PORT2 --vrp 10.0.0.0/8,24,64502 --aspa 64501:64500 --aspa 64502:99999
cmd=background:seq=2:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=3:exec=ze -:stdin=ze-bgp:timeout=25s
expect=exit:code=0
