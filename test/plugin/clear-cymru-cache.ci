# Test: clear cymru cache all and address answer through the dispatcher
# Exercises: dispatch-command -> ze-resolve:clear-cymru-cache-{all,address}
# Verifies: the bare clear cymru cache is refused; all answers clear-all; an
#           address is matched in its canonical spelling; a non-address is
#           refused. The re-query proof is in the cymru unit test, because the
#           hub's DNS resolver asks port 53 only and no mock can stand there.

# ze-peer: accepts connection
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
option=asn:value=65001
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER


stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external clear-cymru-cache-test {
		run "le test fixture plugin/clear-cymru-cache"
		encoder json
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast {
					prefix {
						maximum 10000
					}
				}
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
