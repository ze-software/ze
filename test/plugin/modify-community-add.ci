# Test: modify filter adds community via community-add directive
# VALIDATES: AC-4 -- community-add directive in delta text
# PREVENTS: community-add not recognized by engine, AttrModAdd not emitted
#
# Flow:
# 1. ze-peer sends UPDATE with no communities
# 2. Filter chain calls bgp-filter-modify:TAG-CUSTOMER
# 3. Plugin returns delta "community-add 65000:200"
# 4. Engine maps community-add to AttrModAdd, handler appends community

option=env:var=ze.log.bgp.filter.modify:value=info

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
# UPDATE: ORIGIN=IGP, AS_PATH=[65001], NEXT_HOP=1.1.1.1, NLRI=10.0.0.0/24
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002F02000000144001010040020602010000FDE940030401010101180A0000
EOF_PEER

# Native observer waits for the imported route before clean shutdown.

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external test-modify-comm {
		run "ze-test fixture plugin/modify-community-add"
		encoder json
	}
}
bgp {
	policy {
		modify TAG-CUSTOMER {
			set {
				community-add [ 65000:200 ]
			}
		}
	}

	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
		}

		filter {
			import [ modify:TAG-CUSTOMER ]
		}
		attach process bgp-adj-rib-in {
			receive [ update-received state ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze --plugin ze.bgp-filter-modify --plugin ze.bgp-adj-rib-in -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
expect=stderr:pattern=modify apply
expect=stderr:pattern=filter=TAG-CUSTOMER
expect=stderr:pattern=community-add 65000:200
