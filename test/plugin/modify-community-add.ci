# Test: modify filter adds community via community-add directive
# VALIDATES: AC-4 -- community-add directive in delta text
# PREVENTS: community-add not recognized by engine, AttrModAdd not emitted
#
# Flow:
# 1. ze-peer sends UPDATE with no communities
# 2. Filter chain calls bgp-filter-modify:TAG-CUSTOMER
# 3. Plugin returns delta "community-add 65000:200"
# 4. Engine maps community-add to AttrModAdd, handler appends community

option=env:var=ze.log.bgp.filter.modify:value=info

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
# UPDATE: ORIGIN=IGP, AS_PATH=[65001], NEXT_HOP=1.1.1.1, NLRI=10.0.0.0/24
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002F02000000144001010040020602010000FDE940030401010101180A0000
EOF_PEER

tmpfs=test-modify-comm.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
"""Observer for modify community-add test: clean shutdown."""
import time
from ze_api import API, result_json_data

def dispatch(api, command):
    resp = api._call_engine('ze-plugin-engine:dispatch-command', {'command': command})
    return resp.get('result', {})

def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()
    api.dispatch_until('show bgp adj-rib-in status', lambda r: result_json_data(r, {}).get('total-routes', 0) >= 1)
    dispatch(api, 'request shutdown')
    api.wait_for_shutdown()

if __name__ == '__main__':
    main()
EOF_RUN

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external test-modify-comm {
		run ./test-modify-comm.run
		encoder json
	}
}
bgp {
	policy {
		modify TAG-CUSTOMER {
			set {
				community-add [ 65000:200 ]
			}
		}
	}

	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
		}

		filter {
			import [ modify:TAG-CUSTOMER ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze --plugin ze.bgp-filter-modify --plugin ze.bgp-adj-rib-in -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
expect=stderr:pattern=modify apply
expect=stderr:pattern=filter=TAG-CUSTOMER
expect=stderr:pattern=community-add 65000:200
