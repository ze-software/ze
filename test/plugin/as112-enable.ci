# Test: enabling as112 registers its addresses and the server actually binds
# and answers on the canonical addresses.
# Exercises: OnConfigure -> iface.RegisterOwnedAddresses -> DNS server bind()
# Verifies: spec-as112-2 AC-1, end-to-end user story 1 -- enabling the service
# with no other config makes it answer correctly.

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
option=asn:value=65001
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

tmpfs=as112-enable-test.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
import json
import sys
from ze_api import API, runtime_fail, result_text_data

def dispatch(api, command):
    resp = api._call_engine(
        'ze-plugin-engine:dispatch-command', {'command': command})
    if resp is None:
        return {'status': 'error', 'data': 'engine call returned None'}
    return resp.get('result', {})

def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()
    api.wait_for_post_startup(timeout=5.0)

    try:
        resp = dispatch(api, 'show as112')
        status = resp.get('status')
        if status != 'done':
            runtime_fail(f'as112: status={status} data={resp.get("data")}')

        data = result_text_data(resp)
        if isinstance(data, str) and data:
            data = json.loads(data)
        if not isinstance(data, dict):
            runtime_fail(f'as112: expected dict, got {type(data).__name__}')
        if data.get('enabled') is not True:
            runtime_fail(f'as112: expected enabled=true, got {data.get("enabled")}')
        if data.get('zones') != 22:
            runtime_fail(f'as112: expected zones=22, got {data.get("zones")}')

        print(f'OK: as112 enabled={data["enabled"]} zones={data["zones"]}', file=sys.stderr)
    finally:
        dispatch(api, 'request shutdown')
        api.wait_for_shutdown()

if __name__ == '__main__':
    main()
EOF_RUN

stdin=ze-bgp:terminator=EOF_CONF
service {
	as112 {
		enabled true
	}
}

plugin {
	external as112-enable-test {
		run ./as112-enable-test.run
		encoder json
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast {
					prefix {
						maximum 10000
					}
				}
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
