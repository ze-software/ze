# Test: config commit rejects when interface binding AS-SET not cached.
# VALIDATES: AC-2 -- verify rejects with actionable error naming the missing AS-SET.
# PREVENTS: config commit silently accepting uncached interface AS-SET references.
#
# One question: does a commit that adds an interface binding for an AS-SET the
# irr plugin holds nothing for get refused, by name, before any table reaches
# the kernel? A unit test of verifyStored decides the refusal text over a fake
# store; only the daemon decides that a SIGHUP commit runs OnConfigVerify
# against the real store and that the refused config programs nothing.
#
# A daemon START runs no verify (it reads its config through OnConfigure), so
# the refusal is driven by a reload, as firewall-irr-table-term-uncached-reject
# does for the table form. The refusal text "nothing is stored for as-set" is
# produced by notStoredError (internal/component/firewall/plugins/irr/irr.go),
# which only verifyStored calls: a start never prints it.
#
# Flow:
# 1. The daemon starts with no interface binding and fetches nothing.
# 2. The native reload driver swaps in a config binding eth1 to AS-MISSING and SIGHUPs.
# 3. The commit is refused naming AS-MISSING, and no irr_iface table reaches the kernel.

# This test programs nftables, so it needs CAP_NET_ADMIN, not merely Linux.
# skip-os:value=darwin only hid it from macOS: on an unprivileged Linux host it
# RAN, the firewall plugin died with "firewallnft: list tables: netlink receive:
# operation not permitted" during its stage-3 handshake, the daemon never
# reached the asserted state, and the test hung or failed. Declaring the
# capability turns that into an honest skip naming the runner where it does
# execute (ai/rules/qemu-testing.md).
option=needs-linux:caps=net-admin
# Serialize against every other firewall-irr test. The nftables ruleset is
# NODE-WIDE, and the table names these tests program cannot be varied from a
# .ci: ifaceTableName is the Go constant "ze_irr_iface"
# (internal/component/firewall/plugins/irr/sets.go) and the config-derived names
# collide as ze_wan and ze_lan. Apply
# (internal/plugins/firewall/nft/backend_linux.go) lists the node's tables and
# deletes every ze_* table it is about to program, so one daemon removes a
# sibling's live table and the sibling reads back terms it never wrote.
# Per-daemon trees isolate prefix caches; the shared kernel ruleset still
# requires this exclusion group.
option=exclusive:group=firewall-irr-nft
option=env:var=ze.log.firewall.irr:value=debug
option=timeout:value=30s


tmpfs=config2.conf:terminator=EOF_CONF2
plugin {
	external firewall-irr-iface-reject-test {
		run "le test fixture plugin/firewall-irr-iface-reject"
		encoder json
	}
}
system {
	irr { server 127.0.0.1:$PORT2; }
}
firewall {
	backend nft;
	irr {
		interface eth1 {
			source-as-set AS-MISSING;
		}
	}
}
bgp {
	peer peer1 {
		connection {
			remote { ip 127.0.0.1; }
			local { ip 127.0.0.1; accept false; }
		}
		session {
			asn { local 1; remote 1; }
			router-id 1.2.3.4;
			family { ipv4/unicast { prefix { maximum 10000; } } }
		}
	}
}
EOF_CONF2

stdin=ze-fw:terminator=EOF_CONF
plugin {
	external firewall-irr-iface-reject-test {
		run "le test fixture plugin/firewall-irr-iface-reject"
		encoder json
	}
}
system {
	irr { server 127.0.0.1:$PORT2; }
}
firewall {
	backend nft;
}
bgp {
	peer peer1 {
		connection {
			remote { ip 127.0.0.1; }
			local { ip 127.0.0.1; accept false; }
		}
		session {
			asn { local 1; remote 1; }
			router-id 1.2.3.4;
			family { ipv4/unicast { prefix { maximum 10000; } } }
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=le mock irr --port $PORT2
cmd=background:seq=2:exec=le test fixture plugin/firewall-irr-iface-reject/reload
cmd=foreground:seq=3:exec=ze --plugin ze.firewall-irr -:stdin=ze-fw:timeout=30s
expect=exit:code=0
expect=stderr:pattern=nothing is stored for as-set AS-MISSING
