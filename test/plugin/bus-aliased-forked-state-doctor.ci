tmpfs=compare-implied-wiring.py:mode=755:terminator=EOF_COMPARE
#!/usr/bin/env python3
import json
import subprocess
import sys


def run_implied(cfg):
    out = subprocess.check_output(
        ["ze", "cli", "-c", "show config running | implied | json"],
        text=True,
    )
    return json.loads(out)


def extract_wiring(doc, endpoint_path):
    for p in doc.get("implied", {}).get("participants", []):
        if p.get("path") == endpoint_path:
            sends = sorted(
                [r.get("message", ""), r.get("origin", ""), sorted(r.get("targets", []))]
                for r in p.get("send", [])
            )
            recvs = sorted(
                [r.get("message", ""), r.get("origin", ""), sorted(r.get("targets", []))]
                for r in p.get("receive", [])
            )
            return sends, recvs
    raise SystemExit(f"participant {endpoint_path} not found in implied.participants")


mode = sys.argv[1]
if mode == "capture":
    doc = run_implied(None)
    sends, recvs = extract_wiring(doc, sys.argv[2])
    with open(sys.argv[3], "w", encoding="utf-8") as fh:
        json.dump({"send": sends, "receive": recvs}, fh)
    print(f"OK: captured implied wiring for {sys.argv[2]}: sends={len(sends)} recvs={len(recvs)}")
elif mode == "compare":
    with open(sys.argv[3], encoding="utf-8") as fh:
        baseline = json.load(fh)
    doc = run_implied(None)
    sends, recvs = extract_wiring(doc, sys.argv[2])
    if sends != baseline["send"] or recvs != baseline["receive"]:
        raise SystemExit(
            f"aliased separate wiring mismatch:\n  got:      send={sends} recv={recvs}\n"
            f"  baseline: send={baseline['send']} recv={baseline['receive']}"
        )
    if not any(msg == "bgp:update" for msg, _, _ in sends):
        raise SystemExit(f"expected registered bgp:update send wiring, got {sends}")
    print(f"OK: {sys.argv[2]} implied wiring matches in-daemon baseline")
else:
    raise SystemExit(f"unknown mode {mode}")
EOF_COMPARE

# --- Baseline: in-daemon ddos-flowspec ---
cmd=background:seq=1:name=base-daemon:exec=ze start in-daemon.conf:ready=Ze running.
reject=stderr:pattern=panic
cmd=foreground:seq=2:exec=python3 compare-implied-wiring.py capture /bus/endpoint/ddos-flowspec baseline.json:exit=0
expect=stdout:contains=OK: captured implied wiring for /bus/endpoint/ddos-flowspec
cmd=stop:seq=3:name=base-daemon:signal=term

# --- Positive case: aliased separate-process my-ddos (internal ddos-flowspec; process separate) ---
cmd=foreground:seq=4:exec=ze config import --yes --name ze.conf aliased-separate.conf:exit=0
cmd=background:seq=5:name=alias-daemon:exec=ze start aliased-separate.conf:ready=Ze running.
reject=stderr:pattern=panic
reject=stderr:pattern=ZE-OBSERVER-FAIL

# Show doctor reports healthy (no orphan or stopped diagnostic for ddos-flowspec / my-ddos).
cmd=foreground:seq=6:exec=ze cli -c "show doctor | json":exit=0
reject=stdout:contains=doctor-ddos-flowspec-orphan-announcement
reject=stdout:contains=doctor-plugin-stopped

# Runtime event delivery identifies aliased /bus/endpoint/my-ddos alongside compiled registration ddos-flowspec.
cmd=foreground:seq=7:exec=ze cli -c "show event delivery | json":exit=0
expect=stdout:contains=my-ddos

# Implied wiring matches the in-daemon baseline.
cmd=foreground:seq=8:exec=python3 compare-implied-wiring.py compare /bus/endpoint/my-ddos baseline.json:exit=0
expect=stdout:contains=OK: /bus/endpoint/my-ddos implied wiring matches in-daemon baseline

# ze data rm of ddos-flowspec's state key is refused while aliased my-ddos runs,
# naming alias my-ddos and its restart command.
cmd=foreground:seq=9:exec=ze data rm meta/ddos-flowspec/announcement:exit=2
expect=stderr:contains=my-ddos
expect=stderr:contains=meta/ddos-flowspec/announcement
expect=stderr:contains=ze request plugin restart my-ddos

cmd=stop:seq=10:name=alias-daemon:signal=term

# --- Negative case: foreign external endpoint named ddos-flowspec ---
# Plant a recorded announcement between runs; import foreign-spoof.conf as active config.
cmd=foreground:seq=11:exec=ze data write meta/ddos-flowspec/announcement record.json:exit=0
cmd=foreground:seq=12:exec=ze config import --yes --name ze.conf foreign-spoof.conf:exit=0

cmd=background:seq=13:name=spoof-daemon:exec=ze start foreign-spoof.conf:ready=Ze running.
expect=stderr:contains=OK: foreign external state write to meta/ddos-flowspec/announcement was refused
reject=stderr:pattern=ZE-OBSERVER-FAIL
reject=stderr:pattern=panic

cmd=foreground:seq=14:exec=le test fixture plugin/bus-wait-file spoof.done:exit=0
expect=stdout:contains=OK: marker file spoof.done appeared

# Doctor treats foreign external ddos-flowspec as NOT the compiled plugin, so the
# planted record is reported under doctor-ddos-flowspec-orphan-announcement.
cmd=foreground:seq=15:exec=le test fixture daemon/await-answer-all "show doctor | json" doctor-ddos-flowspec-orphan-announcement 203.0.113.9/32:exit=0
expect=stdout:contains=OK:

cmd=foreground:seq=16:exec=ze cli -c "show doctor | json":exit=0
expect=stdout:contains="code": "doctor-ddos-flowspec-orphan-announcement"
expect=stdout:contains=203.0.113.9/32
reject=stdout:contains=no running responder holds that rule

cmd=stop:seq=17:name=spoof-daemon:signal=term
