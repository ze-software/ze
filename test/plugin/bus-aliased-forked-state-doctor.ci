# Test: an aliased separate-process compiled-in plugin keeps its compiled state grants, doctor identity, and implied wiring, while a foreign external endpoint sharing the registration name gets none of them.
# QUESTION: when compiled-in `ddos-flowspec` runs as `bus { endpoint my-ddos { internal ddos-flowspec; process separate; } }`,
# does it start cleanly over TLS connect-back, report healthy in `show doctor | json`
# with no orphan/stopped findings, cause `ze data rm meta/ddos-flowspec/announcement`
# to be refused while running (naming alias `my-ddos` and its restart fix), and display
# identical registered bus wiring in `show config running | implied | json` as an
# in-daemon run — while in a negative run with `bus { endpoint ddos-flowspec { external { run ...; } } }`,
# is a state write to `meta/ddos-flowspec/announcement` refused and does `show doctor | json`
# report the compiled `ddos-flowspec` plugin as not running?
# A unit test cannot decide this because the path spans live separate-process forking
# of `ze plugin ddos-flowspec`, TLS connect-back identity binding, live disk statestore
# RPC grants, `ze data rm` daemon-routed ownership refusal, `show doctor`, and `| implied`.
#
# VALIDATES: spec-explicit-plugin-and-attach-config S15 / AC-13.
# PREVENTS: state grants, `ze data rm` ownership guards, or `show doctor` matching on
# operator endpoint alias instead of compiled registration identity, or letting a foreign
# external endpoint impersonate a compiled plugin by choosing its name.

option=storage:value=disk
option=timeout:value=120s
option=env:var=ZE_CONFIG_DIR:value=.
option=env:var=XDG_DATA_HOME:value=.
option=env:var=ze.ssh.username:value=admin
option=env:var=ze.ssh.password:value=testpass
option=env:var=ze.ssh.port:value=$PORT2

tmpfs=record.json:terminator=EOF_RECORD
{"victim":"203.0.113.9/32"}
EOF_RECORD

# Baseline config: compiled ddos-flowspec running in-daemon under its own name.
tmpfs=in-daemon.conf:terminator=EOF_INDAEMON
system {
	authentication {
		# bcrypt cost-4 hash of "testpass".
		user admin {
			password "$2a$04$UlwuiuH82Unfsq.XEMPGJeDkXwbm3KW.nvVaVXOd/JeFK8VjMjrQO"
		}
	}
}
environment {
	ssh {
		enabled true
		server main {
			ip 127.0.0.1;
			port $PORT2;
		}
	}
}
bus {
	endpoint ddos-flowspec {
		internal ddos-flowspec;
	}
}
ddos {
	flowspec {
		response-level enforce;
		action discard;
		hold-down 3600;
	}
}
bgp {
	router-id 192.0.2.254;
	session {
		asn { local 65000; }
	}
	peer edge1 {
		filter {
			import { final accept; }
			export { final accept; }
		}
		connection {
			remote { ip 127.0.0.2; connect false; }
			local { ip 127.0.0.1; port $PORT; accept true; }
		}
		session {
			asn { remote 65001; }
			family {
				ipv4/unicast { prefix { maximum 10000; } }
				ipv4/flow { prefix { maximum 10000; } }
			}
			capability { graceful-restart disable; }
		}
	}
}
EOF_INDAEMON

