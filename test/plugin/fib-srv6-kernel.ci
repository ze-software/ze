# Test: fib-kernel receives SRv6-steered route via sysrib EventBus
#
# Flow:
# 1. fakefib emits sysrib BestChangeBatch with SRv6SID=2001:db8::1
# 2. fib-kernel subscribes to (system-rib, best-change) and receives it
# 3. hasRichFields detects SRv6SID, dispatches to addRichRoute (Linux)
#    or logs the event (non-Linux unsupported backend)
# 4. Withdraw the route and verify cleanup
#
# VALIDATES: spec-fib-depth-4-srv6 AC-1 -- SRv6 SID dispatched to fib-kernel
# VALIDATES: spec-fib-depth-4-srv6 AC-3 -- SRv6 route withdrawn
# VALIDATES: spec-fib-depth-4-srv6 AC-4 -- zero SID means no encap (plain route)
# PREVENTS: SRv6SID field lost in sysrib -> fib-kernel event delivery
#
# This test programs a real kernel route through fib-kernel over netlink, so it
# needs CAP_NET_ADMIN and not merely Linux. Unprivileged, the daemon logs
# "add route failed ... operation not permitted" and routewatch cannot open its
# netlink socket, and the case burned its whole budget on that before timing
# out. caps=net-admin turns that into an honest skip in the merge gate and
# routes the coverage to the QEMU guest, which runs as root
# (docs/architecture/testing/ci-format.md, "Choosing between needs-linux,
# caps=, and skip-os").
option=needs-linux:caps=net-admin

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER


stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external fib-srv6-kernel-test {
		run "ze-test fixture plugin/fib-srv6-kernel"
		encoder json
	}
	internal bgp-rib {
		use bgp-rib
	}
	internal rib {
		use rib
	}
	internal fib-kernel {
		use fib-kernel
	}
	internal sysctl {
		use sysctl
	}
	internal fakefib {
		use fakefib
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
				ipv6/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}

		attach process bgp-rib {
			receive [ update state refresh ]
			send [ update ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
expect=stderr:pattern=fib-kernel
reject=stderr:pattern=panic recovered
reject=stderr:pattern=fatal error
reject=stderr:pattern=ZE-OBSERVER-FAIL
