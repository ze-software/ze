# Test: one UPDATE refused by an `offered` family leaves an `installed` family's
# count where it found it
#
# checkPrefixLimits (internal/component/bgp/reactor/session_prefix.go) settles
# every `count installed` family FIRST, against the set of prefixes that family
# holds, and only then walks the families that kept the default. So a message can
# be refused AFTER an installed family has already been moved by it. A refused
# message reaches no plugin (processMessage, session_read.go returns before
# delivery), so those prefixes are in no RIB and no reader can see them. The
# installed count must not hold them either.
#
# THE DEFECT THIS PINS: the journal that undoes the installed sets was cleared
# when the installed families were settled, so a refusal decided afterwards had
# nothing left to roll back. The count kept prefixes the session never delivered,
# and the family then refused the peer's next announcement over a RIB that was
# empty.
#
# ONE UPDATE CARRIES BOTH FAMILIES, which is what makes this reachable. RFC 4760
# Section 3 puts the IPv6 NLRI in MP_REACH_NLRI and RFC 4271 Section 4.3 leaves
# the IPv4 NLRI in the message body, so a single message legitimately reaches two
# families with two different modes. The message is sent as raw bytes because the
# ze-peer route builder emits one family per UPDATE.
#
#   ipv4/unicast: maximum 2, teardown false, count installed
#   ipv6/unicast: maximum 1, teardown false, the default count mode
#
#   message 1: 2 IPv6 prefixes (over ipv6's maximum of 1) + 2 IPv4 prefixes
#   message 2: 2 more IPv4 prefixes, which fit ipv4's maximum of 2 exactly
#
# Message 1 is refused whole on ipv6/unicast's overflow. Message 2 therefore
# meets an empty ipv4/unicast and both its prefixes are installed.
#
# THE DISCRIMINATING ASSERTIONS are the reject of an ipv4/unicast enforcement
# line and the RIB count of 2. With the rollback removed, message 1 leaves
# ipv4/unicast holding 2, message 2 takes it to the bound and fires
# `family=ipv4/unicast count=3 maximum=2`, and the RIB reads 0 because message 2
# is dropped as well. Both assertions move, in opposite directions, so neither
# can pass by accident.
#
# THE IPv6 LINE IS THE POSITIVE CONTROL for the refusal itself: without it a
# clean ipv4 log and an empty RIB would also be produced by a peer whose messages
# never arrived.

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=25s
# Hold the session open after the sends: a closed peer is a session-down event,
# which withdraws its routes and empties the RIB the plugin is about to read.
option=linger:value=true
option=asn:value=65001
# Message 1. ORIGIN=IGP, AS_PATH=[65001], NEXT_HOP=10.0.0.1,
# MP_REACH_NLRI(AFI 2, SAFI 1, next-hop 2001:db8::1) carrying 2001:db8::/32 and
# 2001:db9::/32, then 10.0.0.0/24 and 10.0.1.0/24 as body NLRI.
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF005602000000374001010040020602010000FDE94003040A000001900E001F0002011020010DB8000000000000000000000001002020010DB82020010DB9180A0000180A0001
# Message 2. The same attributes without MP_REACH_NLRI, carrying 10.0.2.0/24 and
# 10.0.3.0/24. The attribute bytes differ from message 1, so the read path cannot
# coalesce the two (readAndProcessCoalesced, session_coalesce.go) and each is
# judged as its own message.
action=send:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF003302000000144001010040020602010000FDE94003040A000001180A0002180A0003
EOF_PEER

tmpfs=prefix-count-cross-family.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
"""Prove the message refused on ipv6/unicast left ipv4/unicast able to accept."""

import json
import sys

from ze_api import API, result_text_data, runtime_fail

# Message 2 announces two IPv4 prefixes into a family whose maximum is 2 and
# whose count was rolled back to zero when message 1 was refused. Both must be
# installed. Without the rollback the count is already 2, message 2 crosses the
# maximum, and this number is 0.
EXPECTED = 2

# The one RIB scope this test reads. `count` answers {"count": N}.
RECEIVED_QUERY = 'show bgp rib received count'


def rib_count(result):
    """Return the route count from a dispatch result, or None when unreadable."""
    if result.get('status') != 'done':
        return None
    try:
        payload = json.loads(result_text_data(result))
    except (json.JSONDecodeError, TypeError):
        return None
    if not isinstance(payload, dict) or 'count' not in payload:
        return None
    return int(payload['count'])


def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()
    api.wait_for_post_startup(timeout=5.0)

    # Poll up to the expected number so a route delivered late still counts.
    received = api.dispatch_until(
        RECEIVED_QUERY,
        lambda res: (rib_count(res) or 0) >= EXPECTED,
        attempts=60, delay=0.25)
    installed = rib_count(received)
    if installed is None:
        runtime_fail('bgp-rib did not answer %s: %r' % (RECEIVED_QUERY, received))
    if installed != EXPECTED:
        runtime_fail(
            'a message refused on ipv6/unicast must leave ipv4/unicast where it '
            'was: %d routes received, wanted exactly %d. A lower number means '
            'the refused message spent ipv4/unicast slots on prefixes no plugin '
            'ever saw.' % (installed, EXPECTED))

    print('OK cross-family: %d routes installed after the refused message'
          % installed, file=sys.stderr)

    api._call_engine('ze-plugin-engine:dispatch-command',
                     {'command': 'request shutdown'})
    api.wait_for_shutdown()


if __name__ == '__main__':
    main()
EOF_RUN

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external prefix-count-cross-family {
		run ./prefix-count-cross-family.run
		encoder json
	}
	internal bgp-rib {
		use bgp-rib
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 10.0.0.1
			family {
				ipv4/unicast {
					prefix {
						maximum 2
						teardown false
						count installed
					}
				}
				ipv6/unicast {
					prefix {
						maximum 1
						teardown false
					}
				}
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		attach process bgp-rib {
			receive [ update state refresh ]
			send [ update ]
		}
	}
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=20s

# THE POSITIVE CONTROL. Message 1 arrived and was refused, on ipv6/unicast's own
# overflow, with that family's warn-only setting.
expect=stderr:pattern=family=ipv6/unicast count=2 maximum=1
expect=stderr:contains=teardown=false
# THE DISCRIMINATOR. ipv4/unicast never overflows, because the message that was
# refused on another family left its count untouched. Without the rollback,
# message 2 fires this line reading `count=3 maximum=2`.
reject=stderr:pattern=family=ipv4/unicast count=
# The plugin read the RIB and found both of message 2's prefixes.
expect=stderr:contains=OK cross-family
# Warn-only never sends the Cease.
reject=stderr:pattern=Maximum Number of Prefixes Reached
