# Test: BFD plugin accepts a profile with a Keyed SHA1 `auth` block,
# rejects `simple-password`, and publishes the auth-configured
# session via `show bfd session`.
#
# VALIDATES: spec-bfd-5 AC-1 and AC-10 -- SHA1 Keyed authentication
#            parses, the session is created with AuthType=4, and a
#            `simple-password` config is rejected at parse time.
# PREVENTS:  regression where the parser silently drops the auth
#            block, accepts simple-password, or the engine ignores
#            the signer when a session runs.

option=env:var=ze.bfd.test-parallel:value=true
# BFD listens on the RFC 5881 / RFC 5883 FIXED ports, so every concurrently
# running BFD test's daemon binds the same wildcard (0.0.0.0, 3784/3785) tuple.
# SO_REUSEPORT above lets them co-bind, and the kernel then HASHES each inbound
# datagram to one socket in the group (internal/component/bfd/transport/
# udp_linux.go applySocketOptions) -- so a control reply or a reflected echo meant
# for this daemon can be delivered to a sibling test's daemon instead. That is the
# kernel-global surface option=exclusive exists for: unique addresses cannot
# partition a port number the RFC fixes. Tests outside the group still run
# alongside these.
option=exclusive:group=bfd-ports

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER


stdin=ze-bfd:terminator=EOF_CONF
plugin {
	external bfd-auth-sha1-test {
		run "ze-test fixture plugin/bfd-auth-sha1"
		encoder json
	}
}

environment {
	log {
		bfd debug
	}
}

bfd {
	enabled true;
	profile fast-auth {
		detect-multiplier 3
		desired-min-tx-us 100000
		required-min-rx-us 100000
		auth {
			type keyed-sha1
			key-id 7
			secret "SHARED-SECRET-123"
		}
	}
	single-hop-session 203.0.113.9 {
		profile fast-auth
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bfd:timeout=15s
expect=exit:code=0
