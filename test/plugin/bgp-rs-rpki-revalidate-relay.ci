# Test: bgp-rs forwards a held path whose RPKI verdict flips after it is held,
# with bgp-adj-rib-in attached receive-only, the way the guides attach it.
# VALIDATES: RFC 6811 Section 4 re-validation reaches a route-server client.
#            The route server owns the revalidation relay: bgp-adj-rib-in answers the
#            stored path (ribevents.ReplayPathCommand) and the route server
#            sends it under its own `send [ update ]` grant
#            (rs/server_validation.go, replayValidation;
#            ribevents.RelayReplayPath). The destination
#            grants adj-rib-in only `receive [ update-received state ]`.
# PREVENTS: the revalidated path going out under adj-rib-in's name, refused with
#           a `send refused` WARN only, so a route admitted by a cache update
#           never reaches the clients (plan/journal/silent-fall-through.md,
#           2026-10-21 revalidation row).
#
# Flow (observer fixture plugin/rpki-revalidate-relay):
# 1. the destination's first session comes up and gets its End-of-RIB; the
#    observer tears it down and only then lets the source announce
#    10.0.0.0/24 origin AS 65001
# 2. the VRP set is empty, so the route validates NotFound and
#    `not-found reject` holds it ineligible
# 3. the destination's second session comes up; peer-up replay leaves the
#    ineligible path out, so it carries only its End-of-RIB
# 4. the observer releases 10.0.0.0/8 maxlen 24 AS 65001, the route becomes
#    Valid, and only the revalidation relay can deliver it
# NON-VACUITY: the source announces once and no RIB plugin is loaded, so the
# destination's conn=2 seq=2 UPDATE exists only if the revalidation relay sent
# it. Proven red with the relay call disabled.

stdin=source:terminator=EOF_SOURCE
option=tcp_connections:value=1
option=timeout:value=60s
option=asn:value=65001
# The source must outlive the relay: if it closes, ze withdraws its routes.
option=linger:value=true
option=await-file:path=source.go
# ORIGIN IGP, AS_PATH [65001] (4-byte), NEXT_HOP 1.1.1.1, NLRI 10.0.0.0/24.
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002F02000000144001010040020602010000FDE940030401010101180A0000
EOF_SOURCE

stdin=destination:terminator=EOF_DESTINATION
option=tcp_connections:value=2
option=timeout:value=60s
option=asn:value=65002
option=linger:value=true
# conn=1 comes up before the source announces: only its End-of-RIB. The
# observer then tears it down. conn=2's peer-up replay leaves the ineligible
# path out, so its End-of-RIB comes first, alone.
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
expect=bgp:conn=2:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
# SUBJECT: the revalidated path, ze's AS 65000 prepended (RFC 4271 Section 5.1.2).
expect=bgp:conn=2:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF003302000000184001010040020A02020000FDE80000FDE940030401010101180A0000
EOF_DESTINATION

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	hub {
		server local {
			ip 127.0.0.1;
			port 0;
			secret rpki-test-secret-key-01234567890;
		}
	}
	external rpki-revalidate-relay-test {
		run "le test fixture plugin/rpki-revalidate-relay"
		encoder json
	}
	internal relay {
		use bgp-rs
	}
	internal rpki {
		use bgp-rpki
	}
	internal adj-rib-in {
		use bgp-adj-rib-in
	}
}

bgp {
	rpki {
		cache-server 127.0.0.1 {
			trusted-network true
			port $PORT2
		}
		action {
			invalid reject
			not-found reject
		}
	}
	peer source {
		connection {
			remote { ip 127.0.0.1; }
			local { ip 127.0.0.1; accept false; }
		}
		session {
			asn { local 65000; remote 65001; }
			router-id 1.2.3.4
			family { ipv4/unicast { prefix { maximum 10000; } } }
			capability { graceful-restart disable; }
		}
		behavior { group-updates disable; }

		attach process relay {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
		attach process rpki {
			receive [ update-received state ]
		}
		attach process adj-rib-in {
			receive [ update-received state ]
		}
	}

	peer destination {
		connection {
			remote { ip 127.0.0.2; }
			local { ip 127.0.0.2; accept false; }
		}
		session {
			asn { local 65000; remote 65002; }
			router-id 1.2.3.4
			family { ipv4/unicast { prefix { maximum 10000; } } }
			capability { graceful-restart disable; }
		}
		behavior { group-updates disable; }
		timer { connect-retry 5; }

		attach process relay {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
		attach process rpki {
			receive [ update-received state ]
		}
		attach process adj-rib-in {
			receive [ update-received state ]
		}
	}
}
EOF_CONF

# The observer releases this cache only after checking the held route.
cmd=background:seq=1:exec=le test rtr-mock --port $PORT2 --sync-release rpki-sync.release --vrp 10.0.0.0/8,24,65001:ready=le test rtr-mock: listening on
cmd=background:seq=2:exec=le test peer --port $PORT:stdin=source
cmd=background:seq=3:exec=le test peer --bind 127.0.0.2 --port $PORT:stdin=destination
cmd=foreground:seq=4:exec=ze -:stdin=ze-bgp:timeout=60s
expect=exit:code=0
reject=stderr:pattern=ZE-OBSERVER-FAIL
reject=stderr:pattern=send refused
reject=stderr:pattern=panic
reject=stderr:pattern=fatal error
