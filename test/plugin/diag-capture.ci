# Test: diag capture + capture raw control-plane handler round-trip via dispatch-command
# Exercises: dispatch-command -> ze-show:capture     -> HandleShowCapture (capture.go:13)
#            dispatch-command -> ze-show:capture-raw  -> HandleCaptureRaw start/dump/stop
# Command tree (ze-diag-cmd.yang): `show capture` and nested `show capture raw <action>`.
# In-process control-plane rings (NOT kernel-gated), so this runs unprivileged.
# The plugin-test reactor does not implement the BGP capture providers, so the
# assertions target the reactor-independent, deterministic fields the handlers emit.

# ze-peer: accepts connection
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
option=asn:value=65001
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER


stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external diag-capture-test {
		run "ze-test fixture plugin/diag-capture"
		encoder json
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast {
					prefix {
						maximum 10000
					}
				}
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
