# Test: `show flow recent` recent-flow ring query dispatches through the engine.
#
# VALIDATES: cp-survival-5-detect-5 AC-11 / User Story 2 -- the flowexport
#            recent-flow RPC is reachable via dispatch-command, returns a JSON
#            list bounded to the ring, honours the `dst <prefix>` filter, and
#            rejects malformed grammar.
# PREVENTS:  the new command node existing in YANG with no reachable handler
#            (a 404 at dispatch time), or the handler panicking on an empty ring.
#
# STATUS: needs-linux. flow-export declares a hard dependency on the `interface`
#   plugin, whose backend (netlink) exists only on Linux; on the darwin dev host
#   the daemon aborts at interface configure, so this cannot run there. The RPC
#   wiring (registration, handler, arg grammar) and the bounded/drop-oldest ring
#   mechanics are unit-tested on any platform (cmd_show_test.go, recent_test.go);
#   this exercises the full engine dispatch path in a live daemon. The ring is
#   fed only by the conntrack export path, so without induced traffic the list
#   may be empty -- the assertions cover dispatch reachability and response shape.

option=needs-linux
# Serialize against every other ddos test: they all flood the SAME loopback
# interface and the detector picks the victim by top-destination-bytes over that
# interface, so a sibling's concurrent flood is indistinguishable from this
# test's own. Rationale in full: test/plugin/ddos-direction.ci.
option=exclusive:group=ddos-flood

# ze-peer scaffolding hosts the external test-plugin process below.
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

tmpfs=flow-recent-test.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
"""Dispatch `show flow recent` and assert the recent-flow RPC is wired."""
import json
import sys
from ze_api import API


def dispatch(api, command):
    resp = api._call_engine(
        'ze-plugin-engine:dispatch-command', {'command': command})
    if resp is None:
        return {'status': 'error', 'data': 'engine call returned None'}
    return resp.get('result', {})


def as_list(result):
    data = result.get('data', [])
    if isinstance(data, str):
        data = json.loads(data)
    return data


def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()
    api.wait_for_post_startup(timeout=5.0)

    try:
        # 1. No-arg: returns done + a JSON list (empty is valid off-Linux).
        r = dispatch(api, 'show flow recent')
        if r.get('status') != 'done':
            print(f'FAIL: show flow recent status={r.get("status")}', file=sys.stderr)
            sys.exit(1)
        data = as_list(r)
        if not isinstance(data, list):
            print(f'FAIL: expected list, got {type(data).__name__}', file=sys.stderr)
            sys.exit(1)

        # 2. dst filter grammar dispatches and returns a list.
        r = dispatch(api, 'show flow recent dst 203.0.113.0/24')
        if r.get('status') != 'done':
            print(f'FAIL: dst-filter status={r.get("status")}', file=sys.stderr)
            sys.exit(1)
        if not isinstance(as_list(r), list):
            print('FAIL: dst-filter did not return a list', file=sys.stderr)
            sys.exit(1)

        # 3. Malformed grammar is rejected (not silently treated as no-arg).
        r = dispatch(api, 'show flow recent bogus arg')
        if r.get('status') != 'error':
            print(f'FAIL: bad grammar status={r.get("status")}, want error', file=sys.stderr)
            sys.exit(1)

        print('OK: show flow recent reachable, list shape, dst filter, usage guard',
              file=sys.stderr)
    finally:
        dispatch(api, 'request shutdown')
        api.wait_for_shutdown()


if __name__ == '__main__':
    main()
EOF_RUN

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external flow-recent-test {
		run ./flow-recent-test.run
		encoder json
	}
}

flow-export {
	conntrack {
		enabled true;
		recent-flow-ring 256;
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		process flow-recent-test {
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
expect=stderr:contains=OK: show flow recent reachable
