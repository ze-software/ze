# Test: observed selected rules leave both hooks on MP_UNREACH and peer loss.
# VALIDATES: both routes are present before the driver sends its raw marker;
# only receipt of that marker lets the peer withdraw10.2/24. The driver then
# proves10.1/24 remains in both hooks before stopping the peer and observing
# the complete table disappear. No daemon log wording is used as a verdict.
# PREVENTS: passing on an empty table before either announcement was installed,
# or retaining the last rule after its selected route is gone.
option=needs-linux:caps=net-admin
# Both suites use the kernel-global ze_flowspec table.
option=exclusive:group=flowspec-nft
option=env:var=ze.log.firewall:value=info
option=env:var=ze.log.flowspec.firewall:value=info
option=timeout:value=60s

stdin=peer:terminator=EOF_PEER
option=linger:value=true
option=tcp_connections:value=1
option=timeout:value=55s
# Eligible covering unicast precedes every selected FlowSpec rule.
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002E02000000154001010040020040050400000064400304C0000201080A
action=send:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0044020000002D4001010040020040050400000064800E1100018500000B01180A0100038106058150C010088006000000000000
action=send:conn=1:seq=3:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0044020000002D4001010040020040050400000064800E1100018500000B01180A0200038106058151C010088006000000000000
# Marker is sent only after the driver observes both rules in the kernel.
expect=bgp:conn=1:seq=4:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF003102000000154001010040020040050400000064400304C000020120C612FFFE
action=send:conn=1:seq=5:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00290200000012800F0F0001850B01180A0200038106058151
EOF_PEER

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	internal flowspec-firewall { use flowspec-firewall; }
	external flowspec-observer {
		run "le test fixture plugin/flowspec-fw-withdraw-removes-table";
		encoder json;
	}
}
bgp {
	peer peer1 {
		connection {
			remote { ip 127.0.0.1; }
			local { ip 127.0.0.1; accept false; }
		}
		session {
			asn { local 1; remote 1; }
			router-id 1.2.3.4;
			family {
				ipv4/unicast { prefix { maximum 10000; } }
				ipv4/flow { prefix { maximum 10000; } }
			}
		}
		attach process flowspec-observer { send [ raw ]; }
	}
}
EOF_CONF

cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=55s
expect=exit:code=0
expect=stderr:contains=table inet ze_flowspec
expect=stderr:contains=10.1.0.0/24
expect=stderr:contains=flowspec-tables-after-peer-withdraw=0
