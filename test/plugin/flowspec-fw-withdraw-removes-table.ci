# Test: a withdrawn FlowSpec route stops being enforced, and the last one takes
#       the table with it.
#
# VALIDATES: AC-1 -- when the last FlowSpec route a peer gave ze is gone, the
#            kernel holds no FlowSpec table and drops none of the traffic that
#            route named. RFC 8955 Section 4 carries a flow specification in
#            MP_REACH_NLRI and MP_UNREACH_NLRI, so RFC 4271 Section 9 governs
#            the withdraw: the route leaves the Adj-RIB-In and stops being used.
# VALIDATES: AC-2 -- the kept route is installed once, not once per reconcile.
# PREVENTS:  the withdrawn rule enforcing forever. The bridge named its table
#            "flowspec", with no ownership prefix, and shouldDeleteTable
#            (internal/plugins/firewall/nft/backend_linux.go) returns false for
#            any table without one. So the withdraw left the registry correct
#            and the kernel unchanged: a peer could install a drop and never
#            take it back.
#
# The two phases are separated by an event the DRIVER causes, so neither
# assertion is a race and neither is an absence on its own.
#
#   1. The peer announces two routes, withdraws one by MP_UNREACH, and stays
#      up. The driver waits for the pair of facts together -- the kept route
#      in the kernel, the withdrawn one absent -- because the three UPDATEs go
#      out back to back and a read that asks only for the kept route can land
#      between the second reconcile and the third. Waiting for the pair is
#      race-free and still fails, by timeout, when the withdraw never lands.
#      It then asserts the kept route is installed once rather than twice.
#   2. The driver then stops the peer. That withdraws the route ze still held,
#      which is the "last route" of AC-1, and the kernel must keep no table
#      whose name carries "flowspec". The daemon's `rules removed ... count=1`
#      line is asserted too, so a run where nothing was ever installed cannot
#      reach the empty state and call it a pass.
#
# An earlier revision closed the session from the peer script and asserted only
# the empty state. It passed for the wrong reason and then failed honestly on
# the count: the four peer actions all run within milliseconds, so the driver
# read "no flowspec table" before the BGP session had even opened and killed the
# daemon under it. Do not put the close back in the peer block.
#
# Requires CAP_NET_ADMIN.

option=needs-linux:caps=net-admin
# Every member of this cluster programs the node-wide nftables ruleset and
# they all use the table name ze_flowspec, so two running at once delete each
# other's table mid-assertion. The legacy seeds add `table inet flowspec` to
# the same shared namespace.
option=exclusive:group=flowspec-nft
option=env:var=ze.log.firewall:value=info
option=env:var=ze.log.flowspec.firewall:value=info
option=timeout:value=60s

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=55s
# The peer holds the session open after its last send instead of exiting, so
# phase 1 below reads a settled kernel rather than a state the peer's own exit
# is already tearing down. The driver ends the session when it is ready.
option=linger:value=true
# Route A: destination 10.1.0.0/24, destination port 80, traffic-rate 0 (discard)
#   MP_REACH: 800E12 0001 85 04 01020304 00
#             NLRI len 08: 01 18 0A0100  destination 10.1.0.0/24
#                          05 81 50      dest port = 80
#   EXT_COMM: C01008 8006 0000 00000000  traffic-rate 0 -> discard
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0045020000002E4001010040020040050400000064800E120001850401020304000801180A0100058150C010088006000000000000
# Route B: destination 10.2.0.0/24, destination port 81, same discard action
action=send:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0045020000002E4001010040020040050400000064800E120001850401020304000801180A0200058151C010088006000000000000
# Route B withdrawn: MP_UNREACH_NLRI carrying the same NLRI
#   800F0C 0001 85 08 01180A0200 058151
action=send:conn=1:seq=3:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0026020000000F800F0C0001850801180A0200058151
EOF_PEER

tmpfs=driver.py:mode=755:terminator=EOF_PY
#!/usr/bin/env python3
"""Read the enforced state, then end the session and read the empty one."""
import os
import signal
import subprocess
import sys

from ze_api import wait_until

if not wait_until(
    lambda: os.path.exists("daemon.pid") and os.path.exists("daemon.ready"),
    attempts=400,
    delay=0.05,
):
    sys.exit("daemon readiness files missing")

with open("daemon.pid") as f:
    daemon_pid = int(f.read().strip())

state = {"ruleset": ""}


def ruleset():
    snap = subprocess.run(["nft", "list", "ruleset"], capture_output=True, text=True)
    state["ruleset"] = snap.stdout
    return snap.stdout


def flowspec_tables():
    """Every kernel table whose name carries "flowspec", prefixed or not."""
    return [
        line.strip()
        for line in ruleset().splitlines()
        if line.strip().startswith("table ") and "flowspec" in line
    ]


def settled():
    """The kept route is enforced and the withdrawn one is not.

    Both facts are waited for together. The peer sends three UPDATEs back to
    back, so a read that only asks for the kept route can land between the
    second reconcile and the third and see the withdrawn route still installed.
    Waiting for the pair makes the read race-free and still fails, by timeout,
    when the withdraw never reaches the kernel.
    """
    text = ruleset()
    return (
        "table inet ze_flowspec" in text
        and "10.1.0.0/24" in text
        and "10.2.0.0/24" not in text
    )


def stop(message):
    sys.stdout.write(state["ruleset"])
    os.kill(daemon_pid, signal.SIGTERM)
    sys.exit(message)


# Phase 1: the announce and the withdraw both reach the kernel. The peer stays
# up, so this state does not move under the reads below.
if not wait_until(settled, attempts=300, delay=0.1):
    stop("the kernel never reached one rule for the kept route and none for the withdrawn one")

installed = state["ruleset"]

copies = installed.count("10.1.0.0/24")
if copies != 1:
    stop("the kept route is installed %d times, want 1" % copies)

# Phase 2: end the session. That withdraws the route ze still held, which is
# the last one this peer gave it.
#
# The peer runs as `ze-test peer ...` (runner_exec.go: "ze-peer is now ze-test
# peer"), so it is matched on its first argument rather than on a binary name.
# The runner's own process carries "bgp" there and is never matched.
peer_pids = []
for entry in os.listdir("/proc"):
    if not entry.isdigit():
        continue
    try:
        with open("/proc/%s/cmdline" % entry, "rb") as handle:
            argv = handle.read().decode("utf-8", "replace").split("\0")
    except OSError:
        continue
    if len(argv) > 1 and argv[1] == "peer":
        peer_pids.append(int(entry))

if not peer_pids:
    stop("no peer process to stop, so the last withdraw never happened")

for peer_pid in peer_pids:
    os.kill(peer_pid, signal.SIGTERM)

gone = wait_until(lambda: flowspec_tables() == [], attempts=300, delay=0.1)

sys.stdout.write(installed)
sys.stdout.write(state["ruleset"])
os.kill(daemon_pid, signal.SIGTERM)

if not gone:
    sys.exit("a FlowSpec table survives the last withdraw: " + repr(flowspec_tables()))
EOF_PY

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	internal flowspec-firewall {
		use flowspec-firewall
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/flow { prefix { maximum 10000; } }
			}
		}

		attach process flowspec-firewall {
			receive [ update-received state ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=background:seq=2:exec=ze -:stdin=ze-bgp
cmd=foreground:seq=3:exec=python3 driver.py:timeout=55s
expect=exit:code=0
# The kept route was in the kernel under the prefixed name before the session
# ended. The driver prints that snapshot first.
expect=stdout:contains=table inet ze_flowspec
expect=stdout:contains=10.1.0.0/24
# Two announced, one withdrawn by MP_UNREACH, one left for the end of the
# session to take. A count of 0 or 2 means the wire path is broken, and the
# empty ruleset the driver then reads would prove nothing.
expect=stderr:contains=flowspec peer down, rules removed
# Asserted apart from the message because a handler is free to put an attribute
# on its own line. Anchored on a word boundary: a bare count=1 also matches
# count=10 through count=19, so it would pass on a removal of ten rules.
expect=stderr:pattern=count=1\b
