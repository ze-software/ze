# Test: Recursive next-hop resolution via sysrib NH resolver
#
# Flow:
# 1. Inject a connected route (covering prefix) that provides the direct NH
# 2. Inject a BGP route whose next-hop falls within the covering prefix
# 3. Query "show nexthop-table" to verify NH is tracked and resolved
# 4. Query "show rib" to verify the route appears with a resolved next-hop
#
# VALIDATES: spec-fib-depth AC-2 -- recursive next-hop resolved to direct NH
# VALIDATES: show nexthop-table command returns resolver state
# PREVENTS: NH resolver not wired, show nexthop-table not reachable

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

tmpfs=fib-recursive-test.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
"""Test: Recursive NH resolution and show nexthop-table command."""

import json
import sys

from ze_api import API, runtime_fail, result_json_data, result_text_data


def dispatch(api, command):
    resp = api._call_engine(
        'ze-plugin-engine:dispatch-command', {'command': command})
    if resp is None:
        return {'status': 'error', 'data': 'engine call returned None'}
    return resp.get('result', {})


def rib_has_recursive_route(result):
    """True once show rib lists the recursive route 172.16.0.0/16."""
    try:
        entries = result_json_data(result, [])
    except (json.JSONDecodeError, TypeError):
        return False
    if not isinstance(entries, list):
        return False
    return any(
        isinstance(e, dict) and e.get('prefix') == '172.16.0.0/16'
        for e in entries
    )


def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()

    api.wait_for_post_startup(timeout=5.0)
    # Wait until the rib plugin reports ready (payload-predicate poll; no sleep).
    if api.dispatch_until_done('show bgp rib status').get('status') != 'done':
        runtime_fail('rib plugin did not become ready')

    # Inject a connected route: 10.0.0.0/24 with no next-hop (connected).
    # This provides a direct path for next-hops within 10.0.0.0/24.
    r = dispatch(api, 'request bgp rib inject 10.0.0.1 ipv4/unicast 10.0.0.0/24 origin igp')
    if r.get('status') != 'done':
        runtime_fail(f'inject covering route failed: {r}')

    # Inject a BGP route with a recursive next-hop: 172.16.0.0/16 via 10.0.0.2.
    # The NH 10.0.0.2 falls within the covering prefix 10.0.0.0/24.
    r = dispatch(api, 'request bgp rib inject 10.0.0.1 ipv4/unicast 172.16.0.0/16 origin igp nexthop 10.0.0.2')
    if r.get('status') != 'done':
        runtime_fail(f'inject recursive route failed: {r}')

    # // replaced the fixed 2.0s time.sleep + single-shot assert with
    # a dispatch_until payload-predicate poll (spec-payload-predicate-waits). The
    # AC-2 assertion (172.16.0.0/16 present in show rib) is unchanged and now
    # strictly stronger (it polls instead of hoping 2s was enough); the folded
    # try/except is subsumed by rib_has_recursive_route's own parse guard.
    r = api.dispatch_until('show rib', rib_has_recursive_route)
    if r.get('status') != 'done':
        runtime_fail(f'show rib failed: {r}')
    if not rib_has_recursive_route(r):
        runtime_fail(f'AC-2: 172.16.0.0/16 not in sysrib: {result_text_data(r)[:300]}')
    print('OK AC-2: recursive route 172.16.0.0/16 present in system RIB', file=sys.stderr)

    # Verify show nexthop-table returns resolver state.
    r = dispatch(api, 'show nexthop-table')
    if r.get('status') != 'done':
        runtime_fail(f'show nexthop-table failed: {r}')
    data_str = result_text_data(r, '[]')
    try:
        nh_entries = json.loads(data_str)
        if not isinstance(nh_entries, list):
            runtime_fail(f'show nexthop-table returned non-list: {data_str[:200]}')
        print(f'OK show-nexthop-table: returned {len(nh_entries)} entries', file=sys.stderr)
    except (json.JSONDecodeError, TypeError):
        runtime_fail(f'show nexthop-table parse error: {data_str[:200]}')

    # Verify show ecmp-groups returns valid JSON.
    r = dispatch(api, 'show ecmp-groups')
    if r.get('status') != 'done':
        runtime_fail(f'show ecmp-groups failed: {r}')
    data_str = result_text_data(r, '[]')
    try:
        ecmp_entries = json.loads(data_str)
        if not isinstance(ecmp_entries, list):
            runtime_fail(f'show ecmp-groups returned non-list: {data_str[:200]}')
        print(f'OK show-ecmp-groups: returned {len(ecmp_entries)} entries', file=sys.stderr)
    except (json.JSONDecodeError, TypeError):
        runtime_fail(f'show ecmp-groups parse error: {data_str[:200]}')

    # The peer asserts ze's End-of-RIB frame, so hold the barrier ze_api
    # documents for that shape before shutting the daemon down: this peer
    # attaches a process permitted to send updates, so the initial-sync gate
    # holds the marker and a prompt shutdown closes the session under it.
    if not api.wait_peer_eor_sent():
        runtime_fail('ze did not send the End-of-RIB to the peer before shutdown')
    dispatch(api, 'request shutdown')
    api.wait_for_shutdown()


if __name__ == '__main__':
    main()
EOF_RUN

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external fib-recursive-test {
		run ./fib-recursive-test.run
		encoder json
	}
	internal bgp-rib {
		use bgp-rib
	}
	internal rib {
		use rib
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}

		attach process bgp-rib {
			receive [ update state refresh ]
			send [ update ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
reject=stderr:pattern=panic recovered
reject=stderr:pattern=fatal error
reject=stderr:pattern=ZE-OBSERVER-FAIL
