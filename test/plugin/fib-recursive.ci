# Test: Recursive next-hop resolution via sysrib NH resolver
#
# Flow:
# 1. Inject 198.51.100.0/24 with no next hop: the terminal covering route
# 2. Inject 192.0.2.0/24 via 198.51.100.1, 10.0.0.0/24 via 192.0.2.1, then
#    172.16.0.0/16 via 10.0.0.2
# 3. Poll "show rib" until 172.16.0.0/16 is in the system RIB
# 4. Poll "show nexthop-table" until 10.0.0.2 is resolved to the direct
#    next hop 198.51.100.1, three levels of recursion down: a resolver that
#    stops at the first covering route answers 192.0.2.1 and fails
#
# VALIDATES: spec-fib-depth AC-2 -- recursive next-hop resolved to direct NH
# VALIDATES: show nexthop-table command returns resolver state
# PREVENTS: NH resolver not wired, show nexthop-table not reachable

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER


stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external fib-recursive-test {
		run "le test fixture plugin/fib-recursive"
		encoder json
	}
	internal bgp-rib {
		use bgp-rib
	}
	internal rib {
		use rib
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}

		attach process bgp-rib {
			receive [ update state refresh ]
			send [ update ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
reject=stderr:pattern=panic recovered
reject=stderr:pattern=fatal error
reject=stderr:pattern=ZE-OBSERVER-FAIL
