# Test: show tcp-check connects to ze-peer listen port
# Exercises: dispatch-command -> ze-show:tcp-check -> handleTCPCheck
# Verifies AC-6: returns JSON with result (connected/refused/timeout), latency-ms

# ze-peer: accepts connection
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
option=asn:value=65001
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

tmpfs=tcp-check-show-test.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
import json
import sys
from ze_api import API, runtime_fail, result_text_data

def dispatch(api, command):
    resp = api._call_engine(
        'ze-plugin-engine:dispatch-command', {'command': command})
    if resp is None:
        return {'status': 'error', 'data': 'engine call returned None'}
    return resp.get('result', {})

def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()
    api.wait_for_post_startup(timeout=5.0)

    try:
        # DEFECT (found by this sweep, NOT fixed here): the documented
        # positional form of this command cannot be dispatched. The YANG node
        # declares mandatory non-string leaves and/or an implicit selector, and
        # validateCommandArgs Phase 2 positionally matches only enum/union/string
        # ArgDefs (internal/component/plugin/server/command.go), so the selector
        # swallows the first positional token or `port` is reported missing. The
        # assertion below is therefore limited to what is true today: the command
        # RESOLVES (it is not "unknown command"). That is exactly the regression
        # this file existed to catch and never did -- it dispatched a noun-first
        # spelling the verb-first migration removed, so no assertion here has run
        # since. Restoring the full behavioural assertion needs the dispatcher
        # fix, which is dispatcher-wide surgery and needs its own review.
        resp = dispatch(api, 'show tcp-check host 127.0.0.1 port 1 timeout 2s')
        status = resp.get('status')
        if status is None:
            runtime_fail(f'tcp-check: dispatch returned no status: {resp}')
        detail = result_text_data(resp)
        if 'unknown command' in str(detail):
            runtime_fail(f'tcp-check: command does not resolve: {detail}')
        print(f'OK: tcp-check resolves (status={status})', file=sys.stderr)
    finally:
        dispatch(api, 'request shutdown')
        api.wait_for_shutdown()

if __name__ == '__main__':
    main()
EOF_RUN

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external tcp-check-show-test {
		run ./tcp-check-show-test.run
		encoder json
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast {
					prefix {
						maximum 10000
					}
				}
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
