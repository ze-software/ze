# bgp-rs-withdrawal-replacement-fastpath: a route server client without ADD-PATH is sent
# the surviving source's route, not a withdrawal, when the source whose route
# it holds withdraws, on the reactor fast path (rs-fast-path on every peer, reactorForwardRS).
# RFC 4271 Section 9.2: "All newly installed routes and all newly unfeasible
# routes for which there is no replacement route SHALL be advertised to its
# peers by means of an UPDATE message."
# VALIDATES: AC-1 and AC-2 of spec-bgp-rs-replacement-on-withdrawal. B
# announces 10.9.0.0/24, then A announces it with a shorter AS_PATH, so the
# client holds A's route (the RIB's best). A withdraws: the withdrawal is owed
# to the recovery worker, bgp-rib elects B, and the client is sent B's exact
# received UPDATE and no withdrawal. B then withdraws, and the client is sent
# the withdrawal of 10.9.0.0/24 exactly once (the sentinel follows it).
# PREVENTS: the owner's withdrawal written to the client as a bare withdrawal
# while B's route still exists (owesWithdrawal, reactor/session_ownership.go).

# The routes of 10.9.0.0/24 (NLRI 180A0900), each ORIGIN IGP, a 4-byte
# AS_SEQUENCE, NEXT_HOP 192.0.2.x and MED 50 (80040400000032). Every peer is an
# rs-client, so the client is sent each source's received bytes unchanged
# (RFC 7947 Section 2.2.2.1), and the shortest AS_PATH is the RIB's best.
#   A  [65001]                FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0036020000001B4001010040020602010000FDE9400304C000020180040400000032180A0900
#   A' [65001 65001 65001]    FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF003E02000000234001010040020E02030000FDE90000FDE90000FDE9400304C000020180040400000032180A0900
#   B  [65005 65005]          FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF003A020000001F4001010040020A02020000FDED0000FDED400304C000020580040400000032180A0900
#   D  [65007 x3]             FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF003E02000000234001010040020E02030000FDEF0000FDEF0000FDEF400304C000020780040400000032180A0900
#   E  [65009 x4]             FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF004202000000274001010040021202040000FDF10000FDF10000FDF10000FDF1400304C000020980040400000032180A0900
#   withdrawal of 10.9.0.0/24 FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF001B020004180A09000000
# The fixture (plugin/rs-source-sequence) releases each source action by
# sending that source 192.0.2.0/24 (18C00002), then 198.51.100.0/24 (18C63364),
# and only once the state the action depends on exists. In the cached-rail twin
# the sources carry no relay `send [ update ]`, so nothing is forwarded to them
# there; here they carry it (see below). A sentinel the fixture
# sends the client directly (100.65.0.0/24, 18644100; 100.66.0.0/24, 18644200)
# closes a stretch in which the client must be sent nothing more for the
# prefix: any extra UPDATE lands where the sentinel is expected.
# Every peer here, the sources included, attaches the relay with
# `send [ update ]`, unlike the cached-rail twin. The reactor fast path
# (reactorForwardRS, forward_rs.go) reads that permission as the cached rail
# does, so the grant makes the sources destinations of the other sources'
# routes on this rail; the sources' scripts therefore expect them, and the
# client's assertions are this test's subject.

stdin=sourcea:terminator=EOF_SOURCEA
option=tcp_connections:value=1
option=timeout:value=60s
option=asn:value=65001
option=linger:value=true
option=open:value=router-id:id=127.0.0.1
# A is forwarded B's route (fast path), in either order with its release.
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF003A020000001F4001010040020A02020000FDED0000FDED400304C000020580040400000032180A0900
expect=bgp:conn=1:seq=1:contains=18C00002
action=send:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0036020000001B4001010040020602010000FDE9400304C000020180040400000032180A0900
expect=bgp:conn=1:seq=3:contains=18C63364
# A withdraws 10.9.0.0/24.
action=send:conn=1:seq=4:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF001B020004180A09000000
EOF_SOURCEA

stdin=sourceb:terminator=EOF_SOURCEB
option=tcp_connections:value=1
option=timeout:value=60s
option=asn:value=65005
option=linger:value=true
option=open:value=router-id:id=127.0.0.5
expect=bgp:conn=1:seq=1:contains=18C00002
action=send:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF003A020000001F4001010040020A02020000FDED0000FDED400304C000020580040400000032180A0900
# B is forwarded A's route, then its withdrawal (B's own path is never
# B's candidate), in either order with its release.
expect=bgp:conn=1:seq=3:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0036020000001B4001010040020602010000FDE9400304C000020180040400000032180A0900
expect=bgp:conn=1:seq=3:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF001B020004180A09000000
expect=bgp:conn=1:seq=3:contains=18C63364
# B withdraws 10.9.0.0/24.
action=send:conn=1:seq=4:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF001B020004180A09000000
EOF_SOURCEB

stdin=client:terminator=EOF_CLIENT
option=tcp_connections:value=1
option=timeout:value=60s
option=asn:value=65002
option=linger:value=true
option=open:value=router-id:id=127.0.0.2
# B's route, then A's (the better route, elected).
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF003A020000001F4001010040020A02020000FDED0000FDED400304C000020580040400000032180A0900
expect=bgp:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0036020000001B4001010040020602010000FDE9400304C000020180040400000032180A0900
# A withdrew: B's route replaces it, never a withdrawal.
expect=bgp:conn=1:seq=3:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF003A020000001F4001010040020A02020000FDED0000FDED400304C000020580040400000032180A0900
# B withdrew, no source is left: the withdrawal, once.
expect=bgp:conn=1:seq=4:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF001B020004180A09000000
expect=bgp:conn=1:seq=5:contains=18644100
EOF_CLIENT

stdin=ze-bgp:terminator=EOF_CONF
plugin {
    internal relay { use bgp-rs; }
    external sequence {
        run "le test fixture plugin/rs-source-sequence 127.0.0.2 up 127.0.0.1 up 127.0.0.2 up 127.0.0.5 send 127.0.0.5 192.0.2.0/24 sent 1 send 127.0.0.1 192.0.2.0/24 sent 2 send 127.0.0.1 198.51.100.0/24 sent 3 send 127.0.0.5 198.51.100.0/24 sent 4 send 127.0.0.2 100.65.0.0/24 sent 5"
        encoder json
    }
}
bgp {
    peer sourcea {
        connection {
            remote { ip 127.0.0.1; }
            local { ip 127.0.0.3; accept false; }
        }
        session {
            asn { local 65000; remote 65001; }
            router-id 1.2.3.4
            rs-client true
            family {
                ipv4/unicast { prefix { maximum 10000; } }
            }
            capability { graceful-restart disable }
        }
        behavior { group-updates disable; rs-fast-path enable; }
        attach process relay {
            receive [ update-received state open-received refresh ]
            send [ update ]
        }
        attach process bgp-rib {
            receive [ update state refresh ]
            send [ update ]
        }
        attach process sequence { send [ update ]; }
    }
    peer client {
        connection {
            remote { ip 127.0.0.2; }
            local { ip 127.0.0.4; accept false; }
        }
        session {
            asn { local 65000; remote 65002; }
            router-id 1.2.3.4
            rs-client true
            family {
                ipv4/unicast { prefix { maximum 10000; } }
            }
            capability { graceful-restart disable }
        }
        behavior { group-updates disable; rs-fast-path enable; }
        attach process relay {
            receive [ update-received state open-received refresh ]
            send [ update ]
        }
        attach process bgp-rib {
            receive [ update state refresh ]
            send [ update ]
        }
        attach process sequence { send [ update ]; }
    }
    peer sourceb {
        connection {
            remote { ip 127.0.0.5; }
            local { ip 127.0.0.6; accept false; }
        }
        session {
            asn { local 65000; remote 65005; }
            router-id 1.2.3.4
            rs-client true
            family {
                ipv4/unicast { prefix { maximum 10000; } }
            }
            capability { graceful-restart disable }
        }
        behavior { group-updates disable; rs-fast-path enable; }
        attach process relay {
            receive [ update-received state open-received refresh ]
            send [ update ]
        }
        attach process bgp-rib {
            receive [ update state refresh ]
            send [ update ]
        }
        attach process sequence { send [ update ]; }
    }
}
EOF_CONF

cmd=background:seq=1:exec=le test peer --bind 127.0.0.1 --port $PORT:stdin=sourcea
cmd=background:seq=2:exec=le test peer --bind 127.0.0.2 --port $PORT:stdin=client
cmd=background:seq=3:exec=le test peer --bind 127.0.0.5 --port $PORT:stdin=sourceb
cmd=foreground:seq=4:exec=ze -:stdin=ze-bgp:timeout=60s
expect=exit:code=0
reject=stderr:pattern=panic
reject=stderr:pattern=fatal error
reject=stderr:pattern=ZE-OBSERVER-FAIL
reject=stderr:pattern=forward-cached failed
