# Test: a remote bearer MCP listener without TLS is refused by `ze config
# validate` and by `ze start`, with the same refusal
# VALIDATES: MCP follows the management-listener exposure rule the way gNMI
# does (config.MCPExposure). The daemon used to start with MCP disabled and a
# warning ("warning: MCP server disabled") while `ze config validate` refused
# the same file: the operator's config passed one check and behaved otherwise
# at boot. Now boot refuses before anything binds, exit 1, and prints the same
# problem and fix that validation prints.
# PREVENTS: a daemon that keeps running with a management surface silently
# off, and validate and boot disagreeing about one config.
# Why a .ci: the question is what the `ze` binary does at start (exit code,
# stderr) for a config file, through its real command line, beside what
# `ze config validate` prints for the same file. The unit tests decide the
# rule; only the binaries show both entry points agree.

tmpfs=exposed.conf:refused=config-mcp-invalid:terminator=EOF_CONF
environment {
	mcp {
		enabled true
		bind-remote true
		auth-mode bearer
		token s3cret-token
		server main {
			ip 0.0.0.0
			port $PORT
		}
	}
}
EOF_CONF

cmd=foreground:seq=1:exec=ze config validate exposed.conf
expect=exit:code=1
expect=stdout:pattern=refusing to start MCP on non-loopback listener .0\.0\.0\.0:[0-9]+. without TLS
expect=stdout:contains=set environment mcp tls cert <cert.pem> and set environment mcp tls key <key.pem>
reject=stdout:contains=s3cret-token

cmd=foreground:seq=2:exec=ze doctor --json config exposed.conf
expect=stdout:contains=config-mcp-invalid
expect=stdout:pattern=refusing to start MCP on non-loopback listener .{0,4}0\.0\.0\.0:[0-9]+.{0,4} without TLS
# JSON escapes < and >, so the doctor fix is matched up to its first placeholder.
expect=stdout:contains=set environment mcp tls cert
reject=stdout:contains=s3cret-token

cmd=foreground:seq=3:exec=ze start exposed.conf:timeout=15s
expect=exit:code=1
expect=stderr:pattern=refusing to start MCP on non-loopback listener .0\.0\.0\.0:[0-9]+. without TLS
expect=stderr:contains=set environment mcp tls cert <cert.pem> and set environment mcp tls key <key.pem>
reject=stderr:contains=MCP server disabled
reject=stderr:contains=MCP server listening
reject=stderr:contains=s3cret-token
