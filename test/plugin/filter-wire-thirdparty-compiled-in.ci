# Test: a third-party-style Go filter plugin, written against the SDK only,
# judges routes through the typed slot when it is compiled into the tree and
# runs internal, and through the batched filter-update message when it is
# built as its own binary and forked
#
# VALIDATES: spec-filter-wire-0-umbrella AC-35 (FR-8) end to end: fakefilter
# (internal/test/plugins/fakefilter), an SDK-only filter plugin compiled into
# the tree (R-13 bounds "compiled in"), runs twice in one daemon: internal
# (`use fakefilter`, called through its DirectBridge filter slot) for peer1,
# and forked for peer2 as ze-fakefilter, the same plugin built as its own
# binary from internal/test/plugins/fakefilter/cmd/ze-fakefilter, which links
# the SDK and the plugin and nothing that registers with ze (the runner
# builds it beside ze, internal/test/runner FakeFilterBinary, and so does
# every prebuilt and QEMU guest binary set). Each copy rejects 10.99.0.0/24
# (ze.fakefilter.reject.prefix) and accepts every other route. Every judged
# prefix is logged with the transport that carried it: "slot" when the route
# arrived with the engine's typed view, "batch" when it arrived encoded.
# PREVENTS: a compiled-in SDK filter that silently loses the fast path (its
# routes take the batch while internal), a separately built plugin that cannot
# declare its filter, connect or answer, and a verdict lost on either
# transport (a rejected route installed, or an accepted one dropped).
#
# Flow:
# 1. peer1 (127.0.0.1, AS 65001) sends 10.0.0.0/24 then 10.99.0.0/24, then an
#    End-of-RIB; its import chain is [ fakefilter:judge ] (internal).
# 2. peer2 (127.0.0.2, AS 65002) sends 10.1.0.0/24 then 10.99.0.0/24, then an
#    End-of-RIB; its import chain is [ fakefilter-forked:judge ] (the
#    ze-fakefilter binary, forked).
# 3. The observer (internal/test/fixture/plugin_fixture_filter_thirdparty.go)
#    waits for both End-of-RIBs, each counted only after the import verdicts
#    of the UPDATEs before it, and checks bgp-rib holds exactly the two
#    accepted routes.

# The forked binary is started through `sh -c`, which drops a variable whose
# name is not a shell identifier, so the keys take their underscore spelling:
# the binary reads it (fakefilter.TriggerFrom over the process environment),
# and so does the internal copy (env.Get reads it as the dotted key).
option=env:var=ze_fakefilter_reject_prefix:value=10.99.0.0/24
option=env:var=ze_log_fakefilter:value=info
# The forked copy logs to its own stderr. The relay passes its INFO lines on
# (ze.log.relay), and the daemon's relay logger writes them (ze.log.plugin.relay).
option=env:var=ze.log.relay:value=info
option=env:var=ze.log.plugin.relay:value=info

stdin=peer1:terminator=EOF_PEER1
option=tcp_connections:value=1
option=timeout:value=20s
option=linger:value=true
# UPDATE: ORIGIN=IGP, AS_PATH=AS_SEQ[65001], NEXT_HOP=1.1.1.1, NLRI=10.0.0.0/24
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002F02000000144001010040020602010000FDE940030401010101180A0000
# UPDATE: ORIGIN=IGP, AS_PATH=AS_SEQ[65001], NEXT_HOP=1.1.1.2, NLRI=10.99.0.0/24
# Its NEXT_HOP differs from the first UPDATE's, so the session does not
# coalesce the two (ze.bgp.reactor.coalesce, session_coalesce.go) and each
# route reaches fakefilter as its own UPDATE.
action=send:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002F02000000144001010040020602010000FDE940030401010102180A6300
# End-of-RIB (IPv4 unicast): counted only after the UPDATEs' import verdicts.
action=send:conn=1:seq=3:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER1

stdin=peer2:terminator=EOF_PEER2
option=tcp_connections:value=1
option=timeout:value=20s
option=linger:value=true
# UPDATE: ORIGIN=IGP, AS_PATH=AS_SEQ[65002], NEXT_HOP=1.1.1.1, NLRI=10.1.0.0/24
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002F02000000144001010040020602010000FDEA40030401010101180A0100
# UPDATE: ORIGIN=IGP, AS_PATH=AS_SEQ[65002], NEXT_HOP=1.1.1.2, NLRI=10.99.0.0/24
# A distinct NEXT_HOP, so it is not coalesced with the first (as for peer1).
action=send:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002F02000000144001010040020602010000FDEA40030401010102180A6300
# End-of-RIB (IPv4 unicast): counted only after the UPDATEs' import verdicts.
action=send:conn=1:seq=3:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER2

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	internal fakefilter {
		use fakefilter
	}
	external fakefilter-forked {
		run "ze-fakefilter"
	}
	internal bgp-rib {
		use bgp-rib
	}
	external observer {
		run "le test fixture plugin/filter-wire-thirdparty-compiled-in"
		encoder json
	}
}
bgp {
	peer peer1 {
		connection {
			remote { ip 127.0.0.1; }
			local { ip 127.0.0.1; accept false; }
		}
		session {
			asn { local 65000; remote 65001; }
			router-id 1.2.3.4;
			family { ipv4/unicast { prefix { maximum 10000; } } }
			capability { graceful-restart disable; }
		}
		filter {
			export { final accept; }
			import { filters [ fakefilter:judge ]; final accept; }
		}
		attach process bgp-rib {
			receive [ update state refresh ]
			send [ update ]
		}
	}
	peer peer2 {
		connection {
			remote { ip 127.0.0.2; }
			local { ip 127.0.0.2; accept false; }
		}
		session {
			asn { local 65000; remote 65002; }
			router-id 1.2.3.4;
			family { ipv4/unicast { prefix { maximum 10000; } } }
			capability { graceful-restart disable; }
		}
		filter {
			export { final accept; }
			import { filters [ fakefilter-forked:judge ]; final accept; }
		}
		attach process bgp-rib {
			receive [ update state refresh ]
			send [ update ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer1
cmd=background:seq=2:exec=le test peer --bind 127.0.0.2 --port $PORT:stdin=peer2
cmd=foreground:seq=3:exec=ze -:stdin=ze-bgp:timeout=25s
expect=exit:code=0
# The internal copy judged peer1's routes through its typed slot, with its
# own verdicts.
expect=stderr:pattern=fakefilter judged a route.*peer=127\.0\.0\.1.*prefix=10\.0\.0\.0/24.*transport=slot.*verdict=accept
expect=stderr:pattern=fakefilter judged a route.*peer=127\.0\.0\.1.*prefix=10\.99\.0\.0/24.*transport=slot.*verdict=reject
# The forked copy judged peer2's routes from the batched filter-update.
expect=stderr:pattern=fakefilter judged a route.*peer=127\.0\.0\.2.*prefix=10\.1\.0\.0/24.*transport=batch.*verdict=accept
expect=stderr:pattern=fakefilter judged a route.*peer=127\.0\.0\.2.*prefix=10\.99\.0\.0/24.*transport=batch.*verdict=reject
# Neither copy took the other's transport.
reject=stderr:pattern=fakefilter judged a route.*peer=127\.0\.0\.1.*transport=batch
reject=stderr:pattern=fakefilter judged a route.*peer=127\.0\.0\.2.*transport=slot
# The RIB outcome: both accepted routes installed, neither rejected one.
expect=stderr:contains=OK: the RIB holds the 2 routes fakefilter accepted, none it rejected
reject=stderr:pattern=policy filter failed
# Neither copy ended its run with an error (the forked copy is stopped by the
# daemon closing its connection, a clean shutdown).
reject=stderr:pattern=fakefilter: run
reject=stderr:pattern=ze-fakefilter:
reject=stderr:pattern=ZE-OBSERVER-FAIL
reject=stderr:pattern=panic recovered
