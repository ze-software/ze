# Test: data-rm-live
# VALIDATES: AC-3 (daemon half), AC-4 (delete) -- `delete data key <key>` on a running daemon removes a runtime-state key seeded while ze was stopped, answers the key, and a fresh reader handle no longer finds it; a configuration key and an absent key are refused naming why; the daemon keeps answering.
# PREVENTS: a removal that needs ze stopped, a removal answered as done that left the key, a raw removal of a config key.
# QUESTION: does the command reach the daemon's own store handle through the real dispatcher over SSH, while the owner lock refuses every second writer? A unit test calls the handler directly and cannot see the dispatch, the YANG binding of `key`, or the owner lock.

option=storage:value=disk
option=timeout:value=90s

tmpfs=stale.txt:terminator=EOF_STALE
stale runtime state
EOF_STALE

tmpfs=data-rm-live.conf:terminator=EOF_CONF
system {
    authentication {
        user admin {
            password "$2a$04$UlwuiuH82Unfsq.XEMPGJeDkXwbm3KW.nvVaVXOd/JeFK8VjMjrQO"
        }
    }
}

environment {
    ssh {
        enabled true
        server main {
            ip 127.0.0.1;
            port $PORT2;
        }
    }
}

bgp {
    router-id 1.2.3.4
    session {
        asn {
            local 65000
        }
    }
}
EOF_CONF

# The first start creates the store; the key is seeded while ze is stopped,
# the only time the offline writer may open it.
cmd=background:seq=1:exec=ze start data-rm-live.conf:name=first:ready=Ze running.
cmd=stop:seq=2:name=first:signal=term
cmd=foreground:seq=3:exec=ze data write meta/test/stale-state stale.txt:exit=0
cmd=background:seq=4:exec=ze start data-rm-live.conf:name=daemon:ready=Ze running.
cmd=foreground:seq=5:exec=le test fixture storage/data-rm-live $PORT2:exit=0
expect=stdout:contains=OK: data-rm-live
cmd=stop:seq=6:name=daemon:signal=term
