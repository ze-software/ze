# Test: bgp metrics list includes plugin health metric names
#
# Flow:
# 1. BGP session establishes with telemetry enabled
# 2. native fixture plugin dispatches "show metrics list" via dispatch-command
# 3. Verifies response names array contains plugin health metrics
# 4. Shuts down daemon
#
# VALIDATES: AC-1/AC-2/AC-3 — plugin health metrics are registered and reachable.
# PREVENTS: Plugin metrics not wired into Prometheus registry.

# ze-peer expectations
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s

# EOR
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# native fixture test plugin: verifies plugin health metrics in list output

# ze bgp configuration with telemetry enabled
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external plugin-health-metrics-test {
		run "ze-test fixture plugin/cli-metrics-plugin-health"
		encoder json
	}
}

telemetry {
	prometheus {
		enabled true
		server main {
			ip 127.0.0.1;
			port $PORT2;
		}
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
