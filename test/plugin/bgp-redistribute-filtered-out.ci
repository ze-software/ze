# Test: bgp-redistribute -- batch with no matching import rule produces no UPDATE.
# VALIDATES: AC-4 / AC-5 -- evaluator rejects entries whose family or source is
#            not in any import rule.
# PREVENTS: Routes leaking through when redistribute is misconfigured.

# ze-peer expectations: ONE EOR allowed (session start), nothing else.
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=25s
# linger is what makes the absence below mean anything. Without it a check-mode
# ze-peer returns the instant its expectations are met (Peer.Run, the
# checker.Completed() branch of the accept loop) and closes the session, so the
# emit the observer makes AFTERWARDS has no peer to leak to. Measured on
# 2026-08-03: the peer closed on the EOR and ze reported the peer
# state='connecting', connections-dropped=1 while the run still passed. The
# "no UPDATE" verdict was produced by the peer being gone, not by the import
# rule. With linger the session stays up and the observer's assertion below is
# a statement about a forwarding DECISION.
option=linger:value=true
# Session-end EOR is fine; no UPDATE is the assertion this test enforces.
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# Compiled observer emits a family-rejected route and verifies its absence.

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external filtered-test {
		run "ze-test fixture plugin/bgp-redistribute-filtered-out"
		encoder json
	}
	internal redistribute-orchestrator {
		use redistribute-orchestrator
	}
	internal fakeredist {
		use fakeredist
	}
}

redistribute {
	destination bgp {
		import fakeredist {
			family [ ipv4/unicast ];
		}
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65533
				remote 65533
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
