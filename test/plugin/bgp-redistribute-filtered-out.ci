# Test: bgp-redistribute -- batch with no matching import rule produces no UPDATE.
# VALIDATES: AC-4 / AC-5 -- evaluator rejects entries whose family or source is
#            not in any import rule.
# PREVENTS: Routes leaking through when redistribute is misconfigured.

# ze-peer expectations: ONE EOR allowed (session start), nothing else.
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=25s
# linger is what makes the absence below mean anything. Without it a check-mode
# ze-peer returns the instant its expectations are met (Peer.Run, the
# checker.Completed() branch of the accept loop) and closes the session, so the
# emit the observer makes AFTERWARDS has no peer to leak to. Measured on
# 2026-08-03: the peer closed on the EOR and ze reported the peer
# state='connecting', connections-dropped=1 while the run still passed. The
# "no UPDATE" verdict was produced by the peer being gone, not by the import
# rule. With linger the session stays up and the observer's assertion below is
# a statement about a forwarding DECISION.
option=linger:value=true
# Session-end EOR is fine; no UPDATE is the assertion this test enforces.
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# Python observer: emit fakeredist event for ipv6/unicast (rule covers ipv4/unicast only).
tmpfs=filtered-test.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
# // test-relax: `import time` removed because its only user, the blind
# time.sleep(2.0) drain, is REPLACED by assert_peer_received_only_eor (a real
# barrier plus a real absence assertion). No expectation is dropped.
from ze_api import API, runtime_fail


def dispatch(api, command):
    return api._call_engine('ze-plugin-engine:dispatch-command', {'command': command}) or {}


def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()

    # Wait on the peer's own state, then on its initial-sync EOR reaching the
    # wire, instead of holding a fixed 2s and hoping establishment fitted in it.
    if not api.wait_peer_eor_sent():
        runtime_fail('initial-sync EOR never reached the wire')
        return

    # ipv6/unicast prefix; the import rule restricts fakeredist to ipv4/unicast.
    resp = dispatch(api, 'request fakeredist emit add ipv6/unicast 2001:db8::1/128')
    result = resp.get('result', {})
    if result.get('status') != 'done':
        runtime_fail(f'request fakeredist emit failed: {result}')
        return

    # The absence assertion, and the barrier that gives it meaning. The former
    # blind 2s hold was justified by "quiesce blocks ~10s on the forward-pool
    # quiescer"; that is no longer true, and the hold asserted nothing anyway --
    # a check-mode ze-peer whose expectations are already satisfied reads and
    # DISCARDS whatever arrives, so the peer block's single EOR rule cannot see
    # a leaked UPDATE that follows it. assert_peer_received_only_eor waits for
    # the EOR, drains the forward pool and each peer's initial-sync opQueue with
    # `request quiesce`, and only then reads updates-sent - eor-sent. After the
    # drain, "still zero" is a statement about a forwarding DECISION rather than
    # about timing.
    api.assert_peer_received_only_eor('127.0.0.1')
    dispatch(api, 'request shutdown')
    api.wait_for_shutdown()


if __name__ == '__main__':
    main()
EOF_RUN

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external filtered-test {
		run ./filtered-test.run
		encoder json
	}
	internal redistribute-orchestrator {
		use redistribute-orchestrator
	}
	internal fakeredist {
		use fakeredist
	}
}

redistribute {
	destination bgp {
		import fakeredist {
			family [ ipv4/unicast ];
		}
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65533
				remote 65533
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
