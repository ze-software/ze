# Test: verb-first debug management (set/delete/show/clear)
# VALIDATES: set debug module (enable), delete debug module (disable),
#            show debug profile, set/delete debug profile name, clear debug,
#            set debug timeout bounds, invalid module rejected.
# PREVENTS: debug CLI dispatch broken, set/delete not persisting, show empty

tmpfs=test-debug-verb.sh:mode=755:terminator=EOF_SH
#!/bin/sh
set -e

# Use a temp file so we don't touch the real config
TMPDIR=$(mktemp -d)
trap 'rm -rf "$TMPDIR"' EXIT
export ze_debug_store="$TMPDIR/debug.zefs"

# Enable
OUT=$(ze set debug module bgp.reactor)
echo "$OUT" | grep -q "enabled" || { echo "FAIL: enable: $OUT" >&2; exit 1; }

# Show default profile lists the module
OUT=$(ze show debug profile name default)
echo "$OUT" | grep -q "bgp.reactor" || { echo "FAIL: show after enable: $OUT" >&2; exit 1; }

# Disable
OUT=$(ze delete debug module bgp.reactor)
echo "$OUT" | grep -q "disabled" || { echo "FAIL: disable: $OUT" >&2; exit 1; }

# Profile save
ze set debug module bgp.reactor >/dev/null
OUT=$(ze set debug profile name myprofile)
echo "$OUT" | grep -q "saved" || { echo "FAIL: profile save: $OUT" >&2; exit 1; }

# Profile list
OUT=$(ze show debug profile)
echo "$OUT" | grep -q "myprofile" || { echo "FAIL: profile list: $OUT" >&2; exit 1; }

# Clear
OUT=$(ze clear debug)
echo "$OUT" | grep -q "cleared" || { echo "FAIL: clear: $OUT" >&2; exit 1; }

# Show default after clear no longer has the module
OUT=$(ze show debug profile name default)
if echo "$OUT" | grep -q "bgp.reactor"; then
  echo "FAIL: show after clear still has module" >&2; exit 1
fi

# Timeout with duration unit
OUT=$(ze set debug timeout 30m)
echo "$OUT" | grep -q "timeout" || { echo "FAIL: timeout 30m: $OUT" >&2; exit 1; }

# Bare number rejected
if ze set debug timeout 30 2>/dev/null; then
  echo "FAIL: bare number accepted" >&2; exit 1
fi

# Invalid module name
if ze set debug module "has/slash" 2>/dev/null; then
  echo "FAIL: slash accepted" >&2; exit 1
fi

echo "OK: all verb-first debug tests passed" >&2
exit 0
EOF_SH

cmd=foreground:seq=1:exec=./test-debug-verb.sh:timeout=10s
expect=exit:code=0
