# Test: `show interface rate` returns structured error via Error field when rate tracker is unavailable,
#        and `show system version` returns structured JSON via typed Map.
# VALIDATES: spec-response-typed-data AC-4 -- Error field surfaces correctly.
#            spec-response-typed-data AC-2 -- plugin.Map marshals to valid JSON.
# PREVENTS:  regression where Error field is ignored or typed Map produces
#            double-encoded strings.

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER


stdin=ze-conf:terminator=EOF_CONF
plugin {
	external iface-rate-json-test {
		run "ze-test fixture plugin/iface-rate-json"
		encoder json
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-conf:timeout=15s
expect=exit:code=0
