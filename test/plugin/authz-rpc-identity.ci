# Test: a plugin dispatches a command over the internal RPC path on a box that
#       has authorization configured (RBAC in use). Plugin dispatch must keep
#       working: the engine injects the plugin's reserved identity, and
#       Store.Authorize evaluates it against the endpoint's compiled bus
#       command profile -- independent of operator RBAC profiles (Phase 6 of
#       spec-explicit-plugin-and-attach-config.md closed the old prefix bypass).
#
# Flow:
# 1. Daemon starts with system.authorization (a "locked" profile whose run/edit
#    both default to DENY) and a config user "rbacuser" assigned that profile, so
#    the authorization store exists AND has an assignment (the "hasUsers" shape).
#    On this box the old code denied the internal dispatch identity outright.
# 2. A plugin connects over the plugin socket and, after post-startup, dispatches
#    "show version" via ze-plugin-engine:dispatch-command. The engine authorizes
#    it under the plugin's reserved identity (aaa.ReservedInternalPluginPrefix,
#    injected by dispatchCommand / wrapHandler) against the endpoint's compiled
#    bus command profile, so the declared command is allowed even though the
#    only configured operator profile denies everything.
# 3. The plugin then dispatches "request shutdown" (same plugin-identity path),
#    so the daemon exits cleanly -- proving the RPC path is not broken.
#
# VALIDATES: AC-3 / AC-10 / User Story 3, guards R-4 -- the S-1 fail-closed
#            decision does not break plugin RPC dispatch on an RBAC-configured
#            box (spec-fixit-authz-admin-fallthrough O-4/F-6), and Phase 6 of
#            spec-explicit-plugin-and-attach-config.md authorizes plugins by
#            their compiled bus command profile rather than a prefix bypass.
# LOAD-BEARING:
#   - exit 0 requires the plugin's "request shutdown" dispatch to be authorized;
#     if the plugin identity were absent, the internal identity would fail
#     closed (empty username Deny, or the former bare plugin:<name> Deny on a
#     hasUsers box), the daemon would never shut down, and the run would time out.
#   - "OK: internal RPC dispatch authorized" prints only after "show version"
#     returns a result (not an "unauthorized" RPC error).
#   - With ze.log.authz=debug the daemon logs "authorized: plugin identity by
#     bus profile" from authorizePluginIdentity in Store.Authorize; its presence
#     also proves authorization is actually wired and consulted (a nil authorizer
#     would short-circuit before that branch and never log it).

option=env:var=ze.log.authz:value=debug
option=timeout:value=20s


stdin=ze-conf:terminator=EOF_CONF
system {
	authorization {
		profile locked {
			run {
				default-action deny
			}
			edit {
				default-action deny
			}
		}
	}
	authentication {
		user rbacuser {
			password "$2a$04$MdupNBXL8iUHgRUDfsFl0ue/.FEH3db8U.LPd/XtMhiBmd4MoRM0m"
			profile [ locked ]
		}
	}
}

bus {
	endpoint rpc-dispatcher {
		external {
			run "le test fixture plugin/authz-rpc-identity";
		}
		encoding json;
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-conf:timeout=20s
expect=exit:code=0
# The plugin's internal dispatch of "show version" was authorized.
expect=stderr:pattern=OK: internal RPC dispatch authorized on RBAC box
# The plugin-identity branch of Store.Authorize decided via the endpoint's
# compiled bus command profile (proves authz is wired and consulted).
expect=stderr:pattern=authorized: plugin identity by bus profile.*endpoint=rpc-dispatcher.*command="show version"
