# Test: forked route-install / route-remove RPC wiring (spec-forked-route-install).
#
# VALIDATES: an external (forked) plugin's ze-plugin-engine:route-install and
#            ze-plugin-engine:route-remove RPCs are dispatched by the engine
#            (dispatch.go switch -> handleRouteInstallRPC/handleRouteRemoveRPC ->
#            applyRouteInstall/applyRouteRemove -> locrib.Default()), that the
#            installed route reaches sysrib (`show rib`) via the Loc-RIB OnChange
#            path, that route-remove withdraws it, and that a malformed protocol
#            name is rejected with an RPC error (AC-1/AC-3/AC-6). This is the
#            single-daemon, cross-platform proof that OSPF/IS-IS can install into
#            the engine Loc-RIB (and onward to sysrib) when run forked.
# PREVENTS:  the route-install verbs being unwired ("unknown method"), the handler
#            crashing/misresolving on a real engine RPC, or the forked route never
#            reaching the system RIB.
#
# The KERNEL half (a forked route as an RTPROT_ZE / proto ze kernel entry) reuses
# the UNCHANGED locrib -> sysrib -> fibkernel chain and is proven on Linux by
# forked-route-install-kernel.ci (option=needs-linux); the in-memory install logic
# is proven by the unit tests (internal/component/plugin/server dispatch_route_test,
# routeinstall Sink tests, OSPF/IS-IS install_forked_test). The external plugin is
# anchored under a BGP peer process (the hub/TLS acceptor mechanism), matching
# isis-route-install.ci.


stdin=ze-conf:terminator=EOF_CONF
plugin {
	external forked-route {
		run "ze-test fixture plugin/forked-route-install"
		encoder json
	}
	internal rib {
		use rib
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65000
			}
			router-id 10.0.0.1
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		attach process forked-route {
			receive [ update state ]
		}
	}
}
EOF_CONF

cmd=foreground:seq=1:exec=ze -:stdin=ze-conf:timeout=15s
expect=exit:code=0
expect=stderr:contains=forked route-install reached sysrib
reject=stderr:pattern=engine idle
reject=stderr:pattern=panic
reject=stderr:pattern=fatal error
reject=stderr:pattern=unknown method
