# request peer <selector> notify sends a NOTIFICATION of any code and subcode,
# and the text's UTF-8 octets as Data when the pair is not Cease 2 or 4: the octets
# ExaBGP 6 sends for `teardown 3 1 bad code` (Notify._wire_text). RFC 4271
# Section 4.5: "The contents of the Data field depend upon the Error Code and
# Error Subcode."

# ze-peer expectations
stdin=peer:terminator=EOF_PEER
# Route announcement (1.1.0.0/16 next-hop 1.1.1.1)
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002F0200000015400101004002004003040101010140050400000064100101
# EOR for IPv4 unicast
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
# NOTIFICATION: UPDATE Message Error (03) Malformed Attribute List (01), Data "bad code" as ASCII, no length octet; the word code, a leaf of notify, stays text
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF001D03030162616420636F6465
EOF_PEER


# ze bgp configuration
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external notify-test {
		run "le test fixture plugin/notify-cmd"
		encoder json
	}
}
bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	
		attach process notify-test {
			send [ update ]
		}
	}
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=10s
