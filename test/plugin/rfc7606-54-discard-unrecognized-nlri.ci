# rfc7606-54-discard-unrecognized-nlri -- RFC 7606 Section 5.4 through the relay.
#
#
# RFC requirement: RFC7606-5.4-1 positive -- a peer sends an EVPN UPDATE mixing route types
# ze implements with one it does not; the unrecognized route is NOT relayed to the other
# client, and the implemented ones are.
#
# WHY A RELAY TEST, and why the RIB would not do.
#
# The RIB is not the propagation gate. reactorForwardRS (reactor/forward_rs.go) fans the
# RECEIVED wire straight to every eligible peer off the session read goroutine, and
# buildFwdBody (reactor/forward_body.go) appends peerWire.Payload() verbatim on the
# same-context path. Neither consults the RIB and neither reads a route type. A unit test on
# the discard, or an assertion about RIB contents, would both pass while ze went on relaying
# the route -- which is the behaviour Section 5.4 exists to stop for a speaker that is only
# ever a control-plane relay for EVPN. So the assertion is on the second peer's wire.
#
# The two halves confine each other. The `contains` proves the two implemented NLRIs arrive
# ADJACENT, which they can only be if the one between them was removed. The `reject` proves
# the removed one reached the peer in no form at all.

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=2
option=linger:value=true
option=timeout:value=20s
option=bind:value=0.0.0.0
# Bind conn=N by remote IP: which client connects first is a race (peer_connmap.go).
option=conn_map:value=remote-ip

# Source peer (conn=1, AS 65001) announces three EVPN routes in one MP_REACH_NLRI:
#   ORIGIN:   40010100                 IGP
#   AS_PATH:  40020602010000FDE9       AS_SEQUENCE[65001], 4-byte ASNs
#   MP_REACH: 800E45 0019 46 04 01010101 00   AFI 25 / SAFI 70, next-hop 1.1.1.1
# RFC 7432 Sections 7.2, 7.3 and 9.2 supply complete recognized route bodies:
#     NLRI 1: type 3, length 17: RD 65001:1, tag 0, IPv4 router 192.0.2.1.
#     NLRI 2: 6304 DEADBEEF             route type 99 -- ze implements no such type
#     NLRI 3: type 2, length 33: RD 65001:1, zero ESI/tag, MAC 00:11:22:33:44:55,
#             MAC length 48, absent IP (length 0), MPLS label 100 (000641).
# The unrecognized route sits BETWEEN two implemented ones on purpose: a fix that gave up on
# the first unfamiliar type would take the third with it, and the assertion below would fail.
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF006C02000000554001010040020602010000FDE9800E4500194604010101010003110000FDE9000000010000000020C00002016304DEADBEEF02210000FDE90000000100000000000000000000000000003000112233445500000641

# An ordinary IPv4 route, sent after the EVPN one, is the processing fence. ze reads this
# connection in TCP order on one goroutine, so the observer seeing 10.0.0.0/24 forwarded
# proves the EVPN UPDATE above was already handled. That is what makes the reject below an
# assertion rather than a race with shutdown.
action=send:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002F02000000144001010040020602010000FDE940030401010101180A0000

# Receiver (conn=2, AS 65002, rs-client so RFC 7947 leaves AS_PATH alone): the two
# implemented EVPN NLRIs arrive back to back.
expect=bgp:conn=2:seq=1:contains=03110000FDE9000000010000000020C000020102210000FDE90000000100000000000000000000000000003000112233445500000641

# And the unrecognized one never arrives, in any framing.
reject=bgp:conn=2:pattern=6304DEADBEEF
EOF_PEER

# Observer: wait until the route server has replayed the fence prefix to every client, then
# shut down.

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	internal rs {
		use bgp-rs
	}
	internal adj-rib-in {
		use bgp-adj-rib-in
	}
	external shutdown-after-up {
		run "le test fixture plugin/rfc7606-54-discard-unrecognized-nlri"
		encoder json
	}
}
bgp {
	peer source-peer {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
				l2vpn/evpn { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		attach process adj-rib-in {
			receive [ update-received state ]
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
		attach process shutdown-after-up {
			receive [ update ]
		}
	}
	peer receiver-peer {
		connection {
			remote {
				ip 127.0.0.2
			}
			local {
				ip 127.0.0.2
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65002
			}
			router-id 1.2.3.4
			rs-client true
			family {
				ipv4/unicast { prefix { maximum 10000; } }
				l2vpn/evpn { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		attach process adj-rib-in {
			send [ update ]
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
		attach process shutdown-after-up {
			receive [ update ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
reject=stderr:pattern=panic
reject=stderr:pattern=fatal error
