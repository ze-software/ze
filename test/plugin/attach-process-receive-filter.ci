# Test: two programs attached to ONE peer with different receive lists are each
#       handed only the event types their own list names.
# Exercises: peer config -> DeliveryGraph -> Server.PeerScopedProcs -> the seven
#            peer-scoped delivery sites in internal/component/bgp/server/events.go.
# VALIDATES: AC-1 (two processes, one peer, two independent filters) and AC-3 (a
#            type a list omits is not delivered, direction included: the program
#            granted update-received is not handed the UPDATEs ze SENDS, and its
#            own End-of-RIB is one).
# PREVENTS: the defect this spec exists to fix -- delivery decided by what each
#           program asked for at startup, with the peer's config ignored. Both
#           programs subscribe to update AND state, so the CONFIG is the only
#           thing that can tell them apart.
#
# Why this cannot pass by luck: the session comes up before the UPDATE arrives,
# so a broken filter hands the state event to the update-only program FIRST, and
# that program fails on the state event rather than on a missing update.

# ze-peer: one session, then one UPDATE for 10.0.0.0/24.
#   0036        message length 54
#   02          UPDATE
#   0000        no withdrawn routes
#   001B        27 bytes of path attributes
#   40010100                ORIGIN = IGP
#   40020602010000FDE9      AS_PATH = [65001]
#   40030401010101          NEXT_HOP = 1.1.1.1
#   40050400000064          LOCAL_PREF = 100
#   180A0000                NLRI 10.0.0.0/24
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=20s
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0036020000001B4001010040020602010000FDE94003040101010140050400000064180A0000
EOF_PEER

# The program the peer grants `receive [ state ]`. It subscribes to update as
# well, so anything but a state event is the config being ignored.
tmpfs=receive-filter-state.run:mode=755:terminator=EOF_STATE
#!/usr/bin/env python3
import json
import sys

from ze_api import API, runtime_fail


def kind_and_direction(raw):
    try:
        decoded = json.loads(raw)
    except (json.JSONDecodeError, TypeError, ValueError):
        return "", ""
    body = decoded.get("bgp", decoded)
    message = body.get("message", {})
    return message.get("type", ""), message.get("direction", "")


def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.subscribe(["update", "state"])
    api.ready()

    seen_state = False
    while True:
        event = api.wait_for_event(timeout=20.0)
        if event is None:
            break  # the other program shut ze down, or nothing more is coming
        kind, direction = kind_and_direction(event)
        if kind == "update":
            runtime_fail(
                f"FILTER-STATE: update leaked to a process granted state only ({direction})")
        if kind == "state" and not seen_state:
            seen_state = True
            print("FILTER-STATE: state event delivered", file=sys.stderr, flush=True)

    if not seen_state:
        runtime_fail("FILTER-STATE: the peer grants state and delivered none")
    api.wait_for_shutdown()


if __name__ == '__main__':
    main()
EOF_STATE

# The program the peer grants `receive [ update-received ]`. It subscribes to
# state as well, and it drives the shutdown once its own event has arrived.
tmpfs=receive-filter-update.run:mode=755:terminator=EOF_UPDATE
#!/usr/bin/env python3
import json
import sys

from ze_api import API, runtime_fail


def dispatch(api, command):
    resp = api._call_engine('ze-plugin-engine:dispatch-command', {'command': command})
    return (resp or {}).get('result', {})


def kind_and_direction(raw):
    try:
        decoded = json.loads(raw)
    except (json.JSONDecodeError, TypeError, ValueError):
        return "", ""
    body = decoded.get("bgp", decoded)
    message = body.get("message", {})
    return message.get("type", ""), message.get("direction", "")


def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.subscribe(["update", "state"])
    api.ready()

    seen_update = False
    while not seen_update:
        event = api.wait_for_event(timeout=20.0)
        if event is None:
            runtime_fail("FILTER-UPDATE: no received update arrived")
            return
        kind, direction = kind_and_direction(event)
        if kind == "state":
            runtime_fail("FILTER-UPDATE: state leaked to a process granted update-received")
            return
        if kind == "update" and direction == "sent":
            runtime_fail("FILTER-UPDATE: a SENT update reached an update-received grant")
            return
        if kind == "update":
            seen_update = True

    print("FILTER-UPDATE: received update delivered", file=sys.stderr, flush=True)
    # Drain before stopping, so the other program has been handed everything ze
    # is going to hand it and its own refusal has had its chance to fire.
    api.quiesce()
    dispatch(api, 'request shutdown')
    api.wait_for_shutdown()


if __name__ == '__main__':
    main()
EOF_UPDATE

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external receive-filter-state {
		run ./receive-filter-state.run
		encoder json
	}
	external receive-filter-update {
		run ./receive-filter-update.run
		encoder json
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		attach process receive-filter-state {
			receive [ state ]
		}
		attach process receive-filter-update {
			receive [ update-received ]
		}
	}
}
EOF_CONF

expect=stderr:pattern=FILTER-STATE: state event delivered
expect=stderr:pattern=FILTER-UPDATE: received update delivered

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=25s
expect=exit:code=0
