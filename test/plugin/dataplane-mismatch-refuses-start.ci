# Test: daemon start leaves a kernel firewall off under interface backend vpp and reports doctor-dataplane-mismatch.
# Question: does `ze start` on a file with `interface backend vpp` and a
#           `firewall` block on the default `kernel` backend reach "Ze running",
#           leave `firewall` off and reported under `doctor-dataplane-mismatch`
#           with `set firewall backend vpp`, and keep the config file untouched,
#           while `ze config validate` still refuses the same file?
# VALIDATES: 2026-11-26 owner ruling, Answer 2a
#            (plan/records/ruling-ze-always-starts.md) and
#            spec-dataplane-compatibility-guard AC-3 -- at daemon start a
#            data-plane-mismatched firewall is left off and reported under
#            `doctor-dataplane-mismatch` with `set firewall backend vpp`, while
#            `ze config validate` stays strict.
# PREVENTS: a kernel firewall blocking a VPP daemon from starting and bringing
#           up networking, or silently programming Linux nftables rules where
#           VPP-forwarded packets never pass, or rewriting the config on disk.

option=needs-build-tag:value=ze_vpp:state=present

tmpfs=vpp-kernel-firewall.conf:refused=config-plugin-verify:terminator=EOF_CONF
interface {
	backend vpp;
}
firewall {
	table wan {
		family inet;
		chain input {
			type filter;
			hook input;
			priority 0;
			policy drop;
			term allow-ssh {
				from {
					protocol tcp;
					destination-port 22;
				}
				then {
					accept;
				}
			}
		}
	}
}
EOF_CONF

# `ze config validate` stays strict and refuses the mismatch.
cmd=foreground:seq=1:exec=ze config validate vpp-kernel-firewall.conf:timeout=20s
expect=exit:code=1
expect=stdout:contains=firewall
expect=stdout:contains=set firewall backend vpp

# Daemon start succeeds, leaves firewall off, and reports doctor-dataplane-mismatch.
cmd=background:seq=2:name=daemon:exec=ze start vpp-kernel-firewall.conf:ready=Ze running
expect=stderr:contains=that feature is left off; ze and its other services keep running
expect=stderr:contains=code=doctor-dataplane-mismatch
expect=stderr:contains=firewall
expect=stderr:contains=set firewall backend vpp
reject=stderr:contains=error: load config:
reject=stderr:contains=firewall backend loaded
reject=stderr:pattern=panic

cmd=stop:seq=3:name=daemon:signal=term

# Stored config file on disk stays untouched: validate still sees the mismatch.
cmd=foreground:seq=4:exec=ze config validate vpp-kernel-firewall.conf:timeout=20s
expect=exit:code=1
expect=stdout:contains=set firewall backend vpp
