# Test: bgp-rs internal and opaque attributes between route-server clients
# (spec-filter-wire-6-stage-filters AC-16). Forked twin:
# bgp-rs-opaque-transparency-forked.ci.
#
# VALIDATES: with bgp-rs running in-process, each destination's export chain
#            decides its forwarding treatment: bgp-rs inserts its
#            `bgp-rs:transparency` step on every peer whose session rs-client is
#            true, and that step sets preserve-opaque-attributes. The source is
#            a route-server client too: RFC 7947 Section 2.2 passes attributes
#            "on to other route server clients", and a non-client source gets
#            RFC 4271 Section 5 treatment on receipt (session_validation.go
#            publishBase), before any chain runs.
#            The source sets behavior/rs-fast-path, so a receiver established
#            when the UPDATE arrives is served by the reactor fast path
#            (forward_rs.go); one that comes up later is served by bgp-rs's
#            replay over the plugin rail. Which one runs depends on session
#            order, and both read the same export-chain treatment.
#            Receiver A (rs-client) gets the source's UPDATE byte-identical:
#            unknown optional transitive 0xF1 without Partial, unknown optional
#            non-transitive 0xF2 kept, AS_PATH unprepended (RFC 7947 Section 2.2).
#            Receiver B (ordinary eBGP) gets RFC 4271 treatment from the same
#            source UPDATE: 0xF2 dropped, 0xF1 with Partial set (flags 0xE0), the
#            local AS prepended (RFC 4271 Sections 5 and 5.1.2).
# PREVENTS: the transparency treatment being lost (the step not inserted, or
#           its set not reaching the forward rails), and the treatment leaking
#           to an ordinary peer.
#
# RFC requirement: RFC7947-2.2-1 positive -- with bgp-rs in-process, receiver A
# (conn=2, rs-client true) receives exactly the UPDATE the source sent, asserted
# as exact wire hex: unknown optional transitive 0xF1 with Partial clear and
# unknown optional non-transitive 0xF2 both passed on unchanged (Section 2.2).
# RFC requirement: RFC7947-2.2-1 negative -- receiver B (conn=3, rs-client not
# set) receives from the same source UPDATE, asserted as exact wire hex, 0xF2
# dropped and 0xF1 with Partial set, so the unchanged pass-through is confined
# to route-server clients (Section 2.2).
#
# NO LOCAL_PREF in the source frame: the source is an eBGP peer and RFC 4271
# Section 5.1.5 forbids LOCAL_PREF towards external peers.

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=3
option=timeout:value=20s
option=bind:value=0.0.0.0
# Bind conn=N by remote IP rather than accept order: which client connects first is a race,
# and the two receivers must be told apart by identity, not arrival (peer_connmap.go).
option=conn_map:value=remote-ip

# Source peer (conn=1, AS 65001): announce 10.0.0.0/24.
#   ORIGIN:    40010100            IGP
#   AS_PATH:   40020602010000FDE9  AS_SEQUENCE[65001], 4-byte ASNs
#   NEXT_HOP:  40030401010101      1.1.1.1
#   type 241:  C0F103112233        optional transitive, unknown to ze, Partial clear
#   type 242:  80F203445566        optional non-transitive, unknown to ze
#   NLRI:      180A0000            10.0.0.0/24
# attr len = 4+9+7+6+6 = 32 = 0x20; total = 19+2+2+32+4 = 59 = 0x3B.
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF003B02000000204001010040020602010000FDE940030401010101C0F10311223380F203445566180A0000

# The source's own EOR. Only conn=1's is asserted on the wire: RFC 4724 Section 4.1 constrains
# no ordering between a peer's EOR and routes it learns afterwards. That both receivers DO send
# one is still enforced, fail-closed, by the observer (expected_peers=3).
expect=bgp:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000

# Receiver A (conn=2, AS 65002, rs-client TRUE): byte-identical to what the source sent.
expect=bgp:conn=2:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF003B02000000204001010040020602010000FDE940030401010101C0F10311223380F203445566180A0000

# Receiver B (conn=3, AS 65003, rs-client left at its default FALSE):
#   AS_PATH:   40020A02020000FDE80000FDE9   AS_SEQUENCE[65000, 65001]
#   type 241:  E0F103112233                 Partial set
#   type 242:  absent
# attr len = 4+13+7+6 = 30 = 0x1E; total = 19+2+2+30+4 = 57 = 0x39.
expect=bgp:conn=3:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0039020000001E4001010040020A02020000FDE80000FDE940030401010101E0F103112233180A0000
EOF_PEER

# Observer: wait until the route server has replayed to every client, then shut down.

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	hub { server local { ip 127.0.0.1; port 0; secret rs-opaque-transparency-secret-0001; } }
	internal rs { use bgp-rs; }
	internal adj-rib-in {
		use bgp-adj-rib-in
	}
	external shutdown-after-up {
		run "le test fixture plugin/bgp-rs-relay-aspath-transparency"
		encoder json
	}
}
bgp {
	# RFC 8212: an EBGP direction with no policy is refused; this test exchanges routes.
	filter {
		import { final accept; }
		export { final accept; }
	}
	peer source-peer {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			# RFC 7947 Section 2.2 passes attributes "on to other route server
			# clients": the SOURCE is a client too. Its session retains the
			# optional attributes at receive (session_validation.go publishBase).
			rs-client true
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
			rs-fast-path enable
		}
		attach process adj-rib-in {
			receive [ update-received state ]
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
		attach process shutdown-after-up {
			receive [ update ]
		}
	}
	peer rs-client-receiver {
		connection {
			remote {
				ip 127.0.0.2
			}
			local {
				ip 127.0.0.2
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65002
			}
			router-id 1.2.3.4
			# The leaf that makes bgp-rs insert its transparency step on this peer's
			# export chain (rs/transparency.go rsInsertions).
			rs-client true
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		attach process adj-rib-in {
			send [ update ]
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
		attach process shutdown-after-up {
			receive [ update ]
		}
	}
	peer plain-ebgp-receiver {
		connection {
			remote {
				ip 127.0.0.3
			}
			local {
				ip 127.0.0.3
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65003
			}
			router-id 1.2.3.4
			# rs-client deliberately NOT set: no transparency step, RFC 4271 treatment.
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		attach process adj-rib-in {
			send [ update ]
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
		attach process shutdown-after-up {
			receive [ update ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
reject=stderr:pattern=panic
reject=stderr:pattern=fatal error
reject=stderr:pattern=forward-cached failed
reject=stderr:pattern=release-cached failed
