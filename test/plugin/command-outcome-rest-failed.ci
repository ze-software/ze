# Question: does REST retain completed rows beside an aborted evaluation and
# its original failure text on both sides of the record writer's threshold?
# A unit cannot prove the HTTP transport's result after real external dispatch.
# A healthy answer at each size is the successful control.

stdin=ze-conf:terminator=EOF_CONF
bus {
    endpoint answer-outcome-provider {
        external {
            run "le test fixture plugin/command-outcome-provider";
        }
        encoding json;
    }
    endpoint answer-outcome-observer {
        external {
            run "le test fixture plugin/command-outcome-rest $PORT failed";
        }
        encoding json;
    }
}
environment {
    api-server {
        token "command-outcome-token";
        rest {
            enabled true;
            server main { ip 127.0.0.1; port $PORT; }
        }
    }
}
EOF_CONF

cmd=foreground:seq=1:exec=ze -:stdin=ze-conf:timeout=40s
expect=exit:code=0
expect=stderr:contains=OK: REST failed outcome and healthy control preserved rows across the record threshold
reject=stderr:contains=ZE-OBSERVER-FAIL
reject=stderr:contains=panic recovered
