# Test: remove-private-as export policy replaces private ASNs with peer AS
# VALIDATES: replace-with peer-as uses the export destination peer ASN.
# VALIDATES: the local AS prepended on EBGP export is NOT itself rewritten by the
# policy, even though local AS 65000 is inside the RFC 6996 private range.
# PREVENTS: replacement mode stripping ASNs or using local AS instead of peer AS.
# PREVENTS: the export chain being applied twice to a forwarded route (once in
# forwardUpdateCore on the original wire, once at the session write gate on the
# already-prepended wire), which rewrote ze's own local AS 65000 -> 65002.
#
# NO LOCAL_PREF: this test's UPDATE is sourced from an EBGP peer, and RFC 4271
# Section 5.1.5 forbids LOCAL_PREF in UPDATEs sent to external peers. An earlier
# revision of this file put LOCAL_PREF=100 in the source frame, which is invalid
# input on an EBGP session: ze correctly applies RFC 7606 Section 7.5
# ("LOCAL_PREF from an external neighbor must be discarded",
# message/rfc7606.go) and overwrites it in place with an ATTR_TOMBSTONE
# marker (message/attr_discard.go, applyInPlace), so the receiver saw
# C0FC0405010000 (ATTR_TOMBSTONE, code 252 = 0xFC per attribute.AttrTombstone,
# orig code 5, reason 1 = EBGP-invalid) where the
# expectation demanded 40050400000064. That was correct product behavior on an
# invalid frame -- so the fix is to make the input valid rather than to bless the
# marker in the expectation. LOCAL_PREF was incidental filler here; the AS_PATH
# private-ASN replacement is what this test validates, and it is unaffected.

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=2
option=timeout:value=20s
option=bind:value=0.0.0.0
# Map conn=N to a peer by remote IP instead of accept order (peer_connmap.go).
# Without this, conn=N binds to ACCEPT ORDER, and which peer ze dials first is a
# race (127.0.0.2 observed first in 4/5 runs), so the source's UPDATE below was
# delivered to the receiver. It also handshakes the whole batch before running any
# conn's script (peer_connmap.go:129), so both sessions are established
# simultaneously; check-mode accept is otherwise sequential (peer.go:265-281) and
# closes conn=1 before conn=2 is accepted, which tears the source session down and
# makes ze withdraw the route instead of forwarding it.
option=conn_map:value=remote-ip

# Source peer (conn=1): ORIGIN=IGP, AS_PATH=[64496 64512 64497], NEXT_HOP=1.1.1.1,
# NLRI=10.0.0.0/24 (no LOCAL_PREF -- EBGP source, see above).
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0037020000001C4001010040020E02030000FBF00000FC000000FBF140030401010101180A0000

# Receiver peer (conn=2): private 64512 becomes peer AS 65002 and local AS 65000 is prepended.
# Expected AS_PATH=AS_SEQUENCE[65000 64496 65002 64497].
#
# The receiver's EOR is NOT asserted on conn=2. An earlier comment here claimed the
# EOR is guaranteed to precede the forwarded route ("queued FIFO behind the EOR"),
# but that is false for a route-server FORWARD: the forward path bypasses the
# initial-sync opQueue that orders the EOR, and AnnounceEOR itself documents that a
# route-server EoR "could race ahead of the still-queued route NLRI and reach the
# wire first" (reactor_api_forward.go:48-58). RFC 4724 Section 4.1
# (rfc/full/rfc4724.txt:303) owes the EOR only after the INITIAL routing update and
# constrains no ordering vs routes learned afterward, so the forward reaching conn=2
# before its EOR is conformant. The receiver's EOR is still SENT (ze sends one to
# every established peer); this test's subject is the export policy on the forwarded
# route (conn=2:seq=2), and the source's own EOR (conn=1) does not race a forward, so
# it stays. Measured: with the conn=2 EOR rule flaky, without it 18/18. Same fix as
# bgp-rs-asn4-transcode.ci and bgp-rs-fastpath-ebgp-shared.ci.
# // test-relax: the conn=2 EOR rule is removed, not weakened -- RFC 4724 owes no
# ordering vs post-initial-update routes; the forwarded-route assertion is unchanged.
expect=bgp:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
expect=bgp:conn=2:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF003B02000000204001010040021202040000FDE80000FBF00000FDEA0000FBF140030401010101180A0000
EOF_PEER

tmpfs=remove-private-as-replace-peer.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
import sys
from ze_api import API

def dispatch(api, command):
    resp = api._call_engine(
        'ze-plugin-engine:dispatch-command', {'command': command})
    if resp is None:
        return {'status': 'error', 'data': 'engine call returned None'}
    return resp.get('result', {})

def updates_sent(api, peer):
    r = dispatch(api, f'show bgp peer {peer} detail')
    for info in r.get('data', {}).get('peers', {}).values():
        return info.get('updates-sent', 0)
    return 0

def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()
    # Deterministic replacement for sleep(4.0): wait until ze has forwarded the
    # policy-rewritten route to the receiver peer (updates-sent increments when the
    # UPDATE is emitted), then shut down. The runner-side conn=2 expect verifies the
    # replaced/prepended AS_PATH on the wire.
    if not api.wait_until(lambda: updates_sent(api, 'receiver-peer') >= 1,
                          attempts=150, delay=0.1):
        print('FAIL: ze never forwarded the rewritten route to receiver-peer',
              file=sys.stderr)
        sys.exit(1)
    dispatch(api, 'request shutdown')
    api.wait_for_shutdown()

if __name__ == '__main__':
    main()
EOF_RUN

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	internal rs {
		use bgp-rs
	}
	external remove-private-as-replace-peer {
		run ./remove-private-as-replace-peer.run
		encoder json
	}
}
bgp {
	policy {
		remove-private-as REPLACE {
			replace-with peer-as
		}
	}
	peer source-peer {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
			rs-fast-path enable
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
	}
	peer receiver-peer {
		connection {
			remote {
				ip 127.0.0.2
			}
			local {
				ip 127.0.0.2
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65002
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		filter {
			export [ remove-private-as:REPLACE ]
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze --plugin ze.bgp-filter-remove-private-as -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
reject=stderr:pattern=panic
reject=stderr:pattern=fatal error
reject=stderr:pattern=forward-cached failed
reject=stderr:pattern=release-cached failed
reject=stderr:pattern=BUG: ForwardUpdatesDirect
