# Test: remove-private-as export policy replaces private ASNs with peer AS
# VALIDATES: replace-with peer-as uses the export destination peer ASN.
# PREVENTS: replacement mode stripping ASNs or using local AS instead of peer AS.

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=2
option=timeout:value=20s
option=bind:value=0.0.0.0

# Source peer (conn=1): ORIGIN=IGP, AS_PATH=[64496 64512 64497], NEXT_HOP=1.1.1.1, LOCAL_PREF=100, NLRI=10.0.0.0/24
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF003E02000000234001010040020E02030000FBF00000FC000000FBF14003040101010140050400000064180A0000

# Receiver peer (conn=2): private 64512 becomes peer AS 65002 and local AS 65000 is prepended.
# Expected AS_PATH=AS_SEQUENCE[65000 64496 65002 64497].
expect=bgp:conn=2:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF004202000000274001010040021202040000FDE80000FBF00000FDEA0000FBF14003040101010140050400000064180A0000
expect=bgp:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
expect=bgp:conn=2:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

tmpfs=remove-private-as-replace-peer.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
import sys
from ze_api import API

def dispatch(api, command):
    resp = api._call_engine(
        'ze-plugin-engine:dispatch-command', {'command': command})
    if resp is None:
        return {'status': 'error', 'data': 'engine call returned None'}
    return resp.get('result', {})

def updates_sent(api, peer):
    r = dispatch(api, f'show bgp peer {peer} detail')
    for info in r.get('data', {}).get('peers', {}).values():
        return info.get('updates-sent', 0)
    return 0

def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()
    # Deterministic replacement for sleep(4.0): wait until ze has forwarded the
    # policy-rewritten route to the receiver peer (updates-sent increments when the
    # UPDATE is emitted), then shut down. The runner-side conn=2 expect verifies the
    # replaced/prepended AS_PATH on the wire.
    if not api.wait_until(lambda: updates_sent(api, 'receiver-peer') >= 1,
                          attempts=150, delay=0.1):
        print('FAIL: ze never forwarded the rewritten route to receiver-peer',
              file=sys.stderr)
        sys.exit(1)
    dispatch(api, 'request shutdown')
    api.wait_for_shutdown()

if __name__ == '__main__':
    main()
EOF_RUN

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	internal rs {
		use bgp-rs
	}
	external remove-private-as-replace-peer {
		run ./remove-private-as-replace-peer.run
		encoder json
	}
}
bgp {
	policy {
		remove-private-as REPLACE {
			replace-with peer-as
		}
	}
	peer source-peer {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
			rs-fast-path enable
		}
	}
	peer receiver-peer {
		connection {
			remote {
				ip 127.0.0.2
			}
			local {
				ip 127.0.0.2
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65002
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		filter {
			export [ remove-private-as:REPLACE ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze --plugin ze.bgp-filter-remove-private-as -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
reject=stderr:pattern=panic
reject=stderr:pattern=fatal error
reject=stderr:pattern=forward-cached failed
reject=stderr:pattern=release-cached failed
reject=stderr:pattern=BUG: ForwardUpdatesDirect
