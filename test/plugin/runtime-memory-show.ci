# Test: show runtime memory returns Go allocator stats (all platforms)
# Exercises: dispatch-command -> ze-show:system-memory -> handleShowSystemMemory
# Verifies the R9 rename `show runtime memory` dispatches and returns a JSON
# map of runtime.MemStats (alloc, heap-in-use, num-gc, ...). Unlike `show
# system memory` (OS /proc view, Linux-only), this is the Go runtime view and
# works on every platform, so no needs-linux gating.

# ze-peer: accepts connection
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
option=asn:value=65001
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# Native observer fixture: plugin/runtime-memory-show.

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external runtime-memory-show-test {
		run "ze-test fixture plugin/runtime-memory-show"
		encoder json
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast {
					prefix {
						maximum 10000
					}
				}
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
