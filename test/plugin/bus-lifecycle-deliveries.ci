# Test: OPEN-validator (`WantsValidateOpen`) lifecycle removal deliveries appear with origin `registered` and obey compiled bus receive allow-lists.
# QUESTION: with `collector` (receiving `bgp:state`), an external endpoint `val`
# declaring `WantsValidateOpen` with no peer attachment, and peers `lab` and `lab2`,
# does `show event delivery | json` list `val`'s registered `bgp:state` lifecycle
# delivery with `origin: "registered"`, does reloading to remove `lab` deliver `lab`'s
# removal notice to both `collector` and `val`, and after reloading `val` with
# `receive { allow none; }`, does `val`'s edge leave `show event delivery | json` and
# does a subsequent reload removing `lab2` deliver `lab2`'s removal to `collector`
# while suppressing delivery to `val`? A unit test cannot decide this because the path
# spans live Stage 1 `WantsValidateOpen` registration over TLS, live SIGHUP peer
# removal in the BGP reactor, `show event delivery`, and compiled bus filter enforcement.
#
# VALIDATES: spec-explicit-plugin-and-attach-config S32 / AC-39.
# PREVENTS: OPEN-validator removal observers bypassing the compiled bus receive filter
# or failing to appear in `show event delivery` with origin `registered`.

option=timeout:value=90s
option=env:var=ZE_CONFIG_DIR:value=.
option=env:var=XDG_DATA_HOME:value=.
option=env:var=ze.ssh.password:value=testpass

stdin=init-answers:terminator=EOF_INIT
admin
testpass
127.0.0.1
$PORT2
EOF_INIT

tmpfs=running.conf:terminator=EOF_CONF0
system {
	authentication {
		# bcrypt cost-4 hash of "testpass".
		user admin {
			password "$2a$04$UlwuiuH82Unfsq.XEMPGJeDkXwbm3KW.nvVaVXOd/JeFK8VjMjrQO"
		}
	}
}
environment {
	ssh {
		enabled true
		server main {
			ip 127.0.0.1;
			port $PORT2;
		}
	}
}
bus {
	endpoint collector {
		external {
			run "le test fixture plugin/bus-event-collector bgp:state col.log removed col-lab.done";
		}
		encoding json;
	}
	endpoint val {
		external {
			run "le test fixture plugin/bus-open-validator val.log removed val-lab.done";
		}
		encoding json;
	}
}
bgp {
	filter {
		import { final accept; }
		export { final accept; }
	}
	router-id 192.0.2.254;
	session {
		asn { local 65000; }
	}
	peer lab {
		connection {
			remote { ip 127.0.0.2; connect false; }
			local { ip 127.0.0.1; port $PORT; accept true; }
		}
		session {
			asn { remote 65001; }
			family { ipv4/unicast { prefix { maximum 10000; } } }
			capability { graceful-restart disable; }
		}
	}
	peer lab2 {
		connection {
			remote { ip 127.0.0.3; connect false; }
			local { ip 127.0.0.1; port $PORT; accept true; }
		}
		session {
			asn { remote 65002; }
			family { ipv4/unicast { prefix { maximum 10000; } } }
			capability { graceful-restart disable; }
		}
	}
}
EOF_CONF0

