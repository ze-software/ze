# Test: show uptime returns daemon start-time and uptime via dispatch-command
# Exercises: dispatch-command -> ze-show:uptime -> handleShowUptime -> reactor.Stats()
# Verifies: returns JSON with start-time (RFC3339) and uptime (duration) fields

# ze-peer: accepts connection
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
option=asn:value=65001
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

tmpfs=show-uptime-test.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
import json
import sys
from ze_api import API, runtime_fail, result_text_data

def dispatch(api, command):
    # Convert an RPC-level failure (e.g. an unwired/unknown command, which makes
    # _call_engine raise) into a status=error dict so the assertions below fire a
    # loud runtime_fail instead of crashing the plugin and passing vacuously.
    try:
        resp = api._call_engine(
            'ze-plugin-engine:dispatch-command', {'command': command})
    except Exception as e:
        return {'status': 'error', 'error': f'engine call raised: {e}'}
    if resp is None:
        return {'status': 'error', 'error': 'engine call returned None'}
    return resp.get('result', {})

def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()
    api.wait_for_post_startup(timeout=5.0)

    try:
        resp = dispatch(api, 'show uptime')
        status = resp.get('status')
        if status is None:
            runtime_fail(f'uptime: dispatch returned no status: {resp}')
        if status != 'done':
            runtime_fail(f'uptime: status={status} data={resp.get("data")}')

        data = result_text_data(resp)
        if isinstance(data, str) and data:
            data = json.loads(data)

        if not isinstance(data, dict):
            runtime_fail(f'uptime: expected dict, got {type(data).__name__}')

        start = data.get('start-time')
        if not isinstance(start, str) or 'T' not in start:
            runtime_fail(f'uptime: expected RFC3339 start-time, got {start!r}')

        uptime = data.get('uptime')
        if not isinstance(uptime, str) or uptime == '':
            runtime_fail(f'uptime: expected non-empty uptime string, got {uptime!r}')

        print(f'OK: show uptime start-time={start} uptime={uptime}', file=sys.stderr)
    finally:
        dispatch(api, 'request shutdown')
        api.wait_for_shutdown()

if __name__ == '__main__':
    main()
EOF_RUN

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external show-uptime-test {
		run ./show-uptime-test.run
		encoder json
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast {
					prefix {
						maximum 10000
					}
				}
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
