# Test: OTC egress stamping -- route to Customer is re-advertised with OTC
# VALIDATES: RFC 9234 Section 5 egress stamp -- route from Customer forwarded to another Customer with OTC
# PREVENTS: OTC egress stamping not wired, wrong ASN used for stamping, route not reaching destination peer
# NOTE: Two-peer test using --bind for separate loopback addresses

# Source peer (Customer, ASN 65001) on 127.0.0.1
stdin=source:terminator=EOF_SOURCE
option=tcp_connections:value=1
option=timeout:value=20s
# The source must outlive the DEST peer's assertion, not just its own. The two
# sessions establish independently, so under load the source completes on its own
# End-of-RIB and closes while the dest is still coming up. ze reads that close as
# session-down and withdraws the source's routes, and the dest then receives the
# withdraw instead of (or before) the OTC-stamped re-advertisement its expect=bgp
# rule waits for. linger holds the session open until teardown, as in
# community-strip.ci and rr-basic.ci.
option=linger:value=true
# Role capability: drop ze-peer's default (mirrored Provider) then add Customer (0x03).
option=open:value=drop-capability:code=9
option=open:value=add-capability:code=9:hex=03
# Send UPDATE without OTC: ORIGIN=IGP, AS_PATH=[65001], NEXT_HOP=1.1.1.1, NLRI=10.0.0.0/24
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002F02000000144001010040020602010000FDE940030401010101180A0000
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_SOURCE

# Dest peer (Customer, ASN 65002) on 127.0.0.2 -- expect OTC-stamped UPDATE
stdin=dest:terminator=EOF_DEST
option=tcp_connections:value=1
option=timeout:value=20s
# Role capability: drop default (Provider mirror) then add Customer (0x03).
option=open:value=drop-capability:code=9
option=open:value=add-capability:code=9:hex=03
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF003A020000001F4001010040020A02020000FDE80000FDE940030401010101C023040000FDE8180A0000
# // the removed End-of-RIB rule was unsatisfiable by construction, so
# it asserted nothing and only produced a red the runner used to mask. This peer's
# EOR is emitted by its OWN initial sync the moment it establishes
# (peer_initial_sync.go), which is BEFORE any route is forwarded to it from
# another peer. That early EOR does not match the route rule(s) above, and
# checker.go silently swallows an unmatched EOR instead of re-offering it, so the
# trailing EOR slot could never be filled. RFC 4724 orders the EOR only against
# this speaker's own initial dump, never against routes learned afterwards, so
# there is no ordering here for a test to assert. The forwarded-route rule(s)
# above are this test's actual subject and are unchanged.
EOF_DEST

# Python test plugin: keeps the daemon alive while the destination wire
# assertion proves OTC stamping.
tmpfs=test-stamp.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
"""Keep the daemon alive while the dest peer verifies OTC egress stamping."""
import json
import sys
from ze_api import API, runtime_fail, result_json_data, result_text_data

def dispatch(api, command):
    resp = api._call_engine('ze-plugin-engine:dispatch-command', {'command': command})
    return resp.get('result', {})


def dest_got_route(result):
    """True once the dest peer has been sent a real UPDATE, not just its EOR.

    updates-sent counts EVERY UPDATE written to the peer, End-of-RIB included
    (reactor_notify.go IncrUpdatesSent, which sees only the message type).
    eor-sent is the separate marker counter, so the DIFFERENCE is the stamped
    re-advertisement this test is about.

    Deliberately NOT gated on state == established: the dest is a check-mode
    ze-peer without linger, so it closes the instant its expect=bgp rule matches
    and the success this predicate looks for is immediately followed by
    "connecting".
    """
    if result.get('status') != 'done':
        return False
    data = result_text_data(result, '{}')
    try:
        parsed = json.loads(data) if isinstance(data, str) else data
    except (json.JSONDecodeError, TypeError, ValueError):
        return False
    if not isinstance(parsed, dict):
        return False
    peers = parsed.get('peers', {})
    if not isinstance(peers, dict):
        return False
    for row in peers.values():
        if not isinstance(row, dict):
            continue
        if row.get('updates-sent', 0) - row.get('eor-sent', 0) >= 1:
            return True
    return False


def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()

    # ONE barrier, on the outbound side, because it implies the inbound one: the
    # dest peer cannot have been sent the stamped route unless adj-rib-in learned
    # it first. Polling adj-rib-in and then the dest in sequence cost two full
    # poll budgets, and with the source peer lingering the observer's wall clock
    # IS the test's.
    #
    # The dest's expect=bgp rule is the authoritative proof of the OTC stamp, but
    # it can only run while the daemon is alive and this observer owns `request
    # shutdown`. quiesce() is not the barrier: it drains the forward pool, which
    # says nothing when the dest was not yet an established forward target at
    # forward time -- the route then arrives on the Adj-RIB-In replay rail, after
    # a quiesce-only observer would already have torn the daemon down.
    #
    # quiesce() FIRST so the poll behind it is a safety net rather than the
    # mechanism: every dispatch_until attempt is a full engine RPC, and 60 of
    # them on a starved daemon outlast the test's own 20s budget -- turning a run
    # whose wire assertions had already passed into an opaque timeout. One
    # barrier RPC plus a short bounded poll costs a couple of round trips in the
    # normal case and still tolerates the replay rail arriving late.
    api.quiesce()
    dest_result = api.dispatch_until(
        'show bgp peer dest-peer detail', dest_got_route, attempts=24,
    )
    dest_data = result_text_data(dest_result)
    if not dest_got_route(dest_result):
        print(f'FAIL: dest-peer detail: {dest_data}', file=sys.stderr)
        sys.stderr.flush()
        runtime_fail('dest peer was never sent the OTC-stamped route')

    # Diagnostics, not an assertion, and deliberately NOT `< 1`. The forwarded
    # copy and adj-rib-in's own bookkeeping are independent rails: the dest can
    # legitimately have been sent the stamped route while this query still reads
    # 0. Only a FAILED query (result_json_data's -1 default) is a fault here.
    total = result_json_data(dispatch(api, 'show bgp adj-rib-in status'), {}).get('total-routes', -1)
    if total < 0:
        msg = f'adj-rib-in query failed, got total={total}'
        print(f'FAIL: {msg}', file=sys.stderr)
        sys.stderr.flush()
        runtime_fail(msg)

    print(f'INFO: {total} route(s) in adj-rib-in from source Customer peer', file=sys.stderr)
    print(f'INFO: dest-peer detail after the re-advertisement: {dest_data}', file=sys.stderr)
    print('OK: dest peer was sent the OTC-stamped route', file=sys.stderr)
    dispatch(api, 'request shutdown')
    api.wait_for_shutdown()

if __name__ == '__main__':
    main()
EOF_RUN

# ze configuration: Provider with two Customer peers on different loopback addresses
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	internal adj-rib-in {
		use bgp-adj-rib-in
	}
	internal rs {
		use bgp-rs
	}
	external test-stamp {
		run ./test-stamp.run
		encoder json
	}
}
bgp {
	peer source-peer {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
		}

		role {
			import provider
			export default
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
		attach process adj-rib-in {
			receive [ update-received state ]
			send [ update ]
		}
	}

	peer dest-peer {
		connection {
			remote {
				ip 127.0.0.2
			}
			local {
				ip 127.0.0.2
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65002
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
		}

		role {
			import provider
			export default
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
		attach process adj-rib-in {
			receive [ update-received state ]
			send [ update ]
		}
	}
}
EOF_CONF

# Process orchestration: two ze-peer instances on different loopback addresses
cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=source
cmd=background:seq=2:exec=ze-peer --bind 127.0.0.2 --port $PORT:stdin=dest
cmd=foreground:seq=3:exec=ze --plugin ze.bgp-role -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
reject=stderr:pattern=panic recovered
reject=stderr:pattern=fatal error
reject=stderr:pattern=ZE-OBSERVER-FAIL
