# bgp-rs-community-strip-multi -- a route carrying SEVERAL route-server control
# communities has ALL of them stripped before it reaches a client.
#
# VALIDATES: spec-fixit-rs-community-strip-arity AC-1, AC-2, AC-3, AC-8, on the
# GENERAL forwarding rail (reactor.reactorAPIAdapter.forwardUpdateCore).
#
# Every citation here names a SYMBOL. The line numbers this header used to carry
# drifted twice, once onto unrelated code.
#
# PREVENTS: the leak this test was written for. wireu.StripControlCommunities
# accumulates EVERY matching control community into ONE slice, and the rail
# passes that whole slice as a single AttrModRemove operation. The consuming
# handler, filter_community.genericCommunityHandler, used to reach a helper that
# accepted a buffer of EXACTLY one value and otherwise returned the list
# untouched -- silently, with the comment "caller bug, silently preserve data".
# So a route tagged with two or more control communities had NONE of them
# removed and the route server's internal steering tags reached its clients.
# Exactly one worked, which is why this went unnoticed. There was no test on
# this path at all.
#
# WHY THE RAIL IS THE GENERAL ONE: rs-fast-path is a SOURCE-side gate
# (bgp-rs-reactor-fastpath-fallback.ci documents this), so the source peer here
# deliberately does NOT carry it and forwarding goes through the bgp-rs plugin's
# ForwardCached path into forwardUpdateCore. The sibling file
# bgp-rs-community-strip-multi-fastpath.ci runs the identical scenario with the
# flag on, covering reactor.reactorForwardRS. Both rails must strip identically;
# a fix landing on one only would leak on whichever path a deployment selects.

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=2
option=timeout:value=15s
option=bind:value=0.0.0.0
# Map conn=N by remote IP rather than accept order, and handshake both peers
# before running any conn script -- see bgp-rs-reactor-fastpath.ci for why the
# accept-order default makes this shape flaky (peer_connmap.go).
option=conn_map:value=remote-ip

# Source peer (conn=1, AS 65001) announces 10.0.0.0/24 tagged with FIVE
# communities, control and ordinary INTERLEAVED so the test also proves the
# survivors keep their relative order:
#
#   0000FDE6  0:64998        control -> stripped. Blacklists AS 64998, which is
#                            not a peer here, so the forwarding decision is
#                            untouched (AC-8).
#   FDE90064  65001:100      ORDINARY -> must survive. High half is 65001,
#                            neither 0 nor the route server's 65000.
#   0000FDE7  0:64999        control -> stripped. Blacklists another absent AS.
#   FDE8FDEA  65000:65002    control -> stripped. This is the RS:X form, so it
#                            also exercises the second strip rule. Semantically
#                            it WHITELISTS 65002 (wireu.parseCommunityAttr),
#                            which is the receiver, so the route is still
#                            forwarded -- deliberate: it proves the decision
#                            keeps working while the tag itself is removed.
#   FDE900C8  65001:200      ORDINARY -> must survive, after 65001:100.
#
# Attribute: C0 08 14 (optional transitive, COMMUNITY, 20 bytes) + the five values.
# The rest is the standard shape from bgp-rs-reactor-fastpath.ci: ORIGIN=IGP,
# AS_PATH=[65001], NEXT_HOP=1.1.1.1, LOCAL_PREF=100, NLRI 10.0.0.0/24.
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF004D02000000324001010040020602010000FDE94003040101010140050400000064C008140000FDE6FDE900640000FDE7FDE8FDEAFDE900C8180A0000

# The source peer's own End-of-RIB, sent by its initial sync at establishment.
expect=bgp:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000

# Receiver peer (conn=2, AS 65002): the forwarded UPDATE must carry a COMMUNITY
# attribute holding EXACTLY the two ordinary values, in order.
#
#   D0    flags: optional transitive + extended length. genericCommunityHandler
#         always writes the extended form (filter_community.emitCommunity), so
#         the forwarded attribute header differs from the source's C0 even
#         though the strip is the only change -- do not "correct" this to C0.
#   08    COMMUNITY
#   0008  eight bytes: TWO values remain of the five sent.
#   FDE90064 FDE900C8   65001:100 then 65001:200.
#
# This single positive assertion is the whole test, and it is exact enough to be
# a negative one too. Before the fix the attribute was forwarded untouched as
# D0 08 0014 followed by all five values, so this byte string was absent. It also
# cannot be satisfied by a withdraw (a withdraw carries no path attributes) nor
# by the source's own echo (these bytes only exist after the rewrite).
#
# NO End-of-RIB rule for conn=2, deliberately: bgp-rs-reactor-fastpath.ci MEASURED
# the forward beating the receiver's EOR onto the wire (4 failures in 6 with such
# a rule present, 0 in 6 without), and an unmatched EOR is silently swallowed by
# checker.go rather than re-offered, so a second rule here would be unmatchable.
expect=bgp:conn=2:seq=1:contains=D0080008FDE90064FDE900C8
EOF_PEER

# Observer: wait until the route server has replayed to every peer, then stop.

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	internal rs {
		use bgp-rs
	}
	internal adj-rib-in {
		use bgp-adj-rib-in
	}
	external shutdown-after-up {
		run "ze-test fixture plugin/bgp-rs-community-strip-multi"
		encoder json
	}
}
bgp {
	peer source-peer {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			# LOAD-BEARING, and its absence is why an earlier draft of this test
			# saw all five communities arrive intact even against the FIXED
			# binary: session/rs-client defaults to false, and both the strip
			# emission (`facts.rsClient` in
			# reactor.reactorAPIAdapter.forwardUpdateCore) and the RFC 7947 policy
			# branch above it are gated on it. Without the leaf no AttrModRemove is
			# ever accumulated, so there is nothing for the community handler to do
			# and the attribute is copied through.
			rs-client true
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		# NO rs-fast-path here: the flag is source-side, so leaving it off is what
		# selects the general rail this file covers.
		behavior {
			group-updates disable
		}
		attach process adj-rib-in {
			receive [ update-received state ]
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
		attach process shutdown-after-up {
			receive [ update ]
		}
	}
	peer receiver-peer {
		connection {
			remote {
				ip 127.0.0.2
			}
			local {
				ip 127.0.0.2
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65002
			}
			router-id 1.2.3.4
			# LOAD-BEARING, and its absence is why an earlier draft of this test
			# saw all five communities arrive intact even against the FIXED
			# binary: session/rs-client defaults to false, and both the strip
			# emission (`facts.rsClient` in
			# reactor.reactorAPIAdapter.forwardUpdateCore) and the RFC 7947 policy
			# branch above it are gated on it. Without the leaf no AttrModRemove is
			# ever accumulated, so there is nothing for the community handler to do
			# and the attribute is copied through.
			rs-client true
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		attach process adj-rib-in {
			send [ update ]
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
		attach process shutdown-after-up {
			receive [ update ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
reject=stderr:pattern=panic
reject=stderr:pattern=fatal error
# The arity refusal added by spec-fixit-rs-community-strip-arity. It must NOT
# fire here: this scenario sends a whole number of four-byte values, so seeing it
# would mean the strip buffer had become malformed.
reject=stderr:pattern=remove buffer is not a whole number of wire values
