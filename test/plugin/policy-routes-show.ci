# Test: show policy routes returns JSON with configured PBR rules
# VALIDATES: spec-cli-1-command-grammar AC-2 -- show policy routes returns JSON with PBR policy routes
# PREVENTS: show command returns empty or malformed JSON after CLI grammar migration
#
# Requires CAP_NET_ADMIN (nftables).

# This test programs nftables, so it needs CAP_NET_ADMIN, not merely Linux.
# skip-os:value=darwin only hid it from macOS: on an unprivileged Linux host it
# RAN, the firewall plugin died with "firewallnft: list tables: netlink receive:
# operation not permitted" during its stage-3 handshake, the daemon never
# reached the asserted state, and the test hung or failed. Declaring the
# capability turns that into an honest skip naming the runner where it does
# execute (ai/rules/qemu-testing.md).
option=needs-linux:caps=net-admin
# The ZE_QEMU exclusion that used to sit here is GONE, and removing it is
# the point. It was added in d419a059e for tests that "need a real Linux
# host (… nftables genl)" when QEMU could not do nft; QEMU can now --
# `./le qemu all-tests` passes ZE_QEMU_SKIP_SUITES="web" so the firewall
# suite runs there, and test/firewall/firewall-boot-apply.ci is nft-based and
# carries the same caps marker. Kept together, the two options meant this
# test ran in NO environment at all: the caps gate skips it everywhere
# without CAP_NET_ADMIN, and ZE_QEMU=1 (internal/le/qemu/alltests.go)
# skipped it in the one place that has it. It was the only one of 68
# capability-gated tests carrying that combination.
option=timeout:value=15s


stdin=ze-bgp:terminator=EOF_CONF
firewall {
    backend nft;
}
policy {
    route test-pbr {
        interface "lo";
        rule allow-http {
            from {
                destination-port 80;
                protocol tcp;
            }
            then {
                accept;
            }
        }
    }
}
system {
    authentication {
        user operator {
            # bcrypt hash of testpass.
            password "$2a$04$UlwuiuH82Unfsq.XEMPGJeDkXwbm3KW.nvVaVXOd/JeFK8VjMjrQO";
        }
    }
}
environment {
    # The driver parses the answer as JSON and passes no `| json` pipe, so the
    # daemon has to render JSON by default. With the table default it read
    # "interfaces  name  rules" and failed on the first character.
    cli {
        format {
            default json;
        }
    }
    ssh {
        enabled true;
        server main {
            ip 127.0.0.1;
            port $PORT2;
        }
    }
}
EOF_CONF

option=env:var=ze.log.policy.routes:value=info
option=env:var=ze.log.firewall:value=info

# The driver runs `ze cli -c "show policy routes"`, and `ze cli` speaks SSH and
# nothing else (runBGP, internal/component/cli/client/main.go). Until 2026-09-08
# this test declared no SSH server and no user, so the client stopped at
# "no credentials for 127.0.0.1:2222: no stored username and none supplied"
# before any command was dispatched, and the test timed out having asserted
# nothing. It is recorded as the 2026-08-24 row in
# plan/journal/test-against-broken-path.md.
#
# ze.ssh.username stands in for the --user flag the driver does not pass
# (resolveUsername, internal/core/ssh/client/client.go), and ze.ssh.insecure
# skips the host-key check the zefs store would otherwise answer.
option=env:var=ze.ssh.username:value=operator
option=env:var=ze.ssh.password:value=testpass
option=env:var=ze.ssh.insecure:value=true
option=env:var=ze.ssh.port:value=$PORT2

cmd=background:seq=1:exec=ze -:stdin=ze-bgp
cmd=foreground:seq=2:exec=ze-test fixture plugin/policy-routes-show:timeout=15s
expect=exit:code=0
expect=stdout:contains=test-pbr
expect=stdout:contains=allow-http
