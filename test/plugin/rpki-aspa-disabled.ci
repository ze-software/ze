# Test: ASPA verification disabled via config -> no aspa-state in event
# VALIDATES: AC-7 — aspa-validation false -> no ASPA verification, no aspa-state field
# PREVENTS: ASPA state leaking into events when feature disabled

# ze-peer: send route 10.0.1.0/24 with AS_PATH [64500, 64501, 64502]
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
option=update:value=send-route:prefix=10.0.1.0/24:origin-as=64502:next-hop=10.0.0.1:as-path=64500,64501,64502
# EOR from ze
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# Python observer: verify NO aspa-state field appears in rpki events
tmpfs=rpki-aspa-disabled-test.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
import json
import sys
from ze_api import API

def dispatch(api, command):
    resp = api._call_engine(
        'ze-plugin-engine:dispatch-command', {'command': command})
    if resp is None:
        return {'status': 'error', 'data': 'engine call returned None'}
    return resp.get('result', {})

def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()

    api.subscribe(['rpki direction received'])
    api.ready()

    # // removed the redundant blocking lead-in and its now-unused
    # import; the rpki-event read loop below already waits deterministically for
    # the validation event (up to 30 * 0.5s), which is the real synchronization.
    try:
        got_rpki_event = False
        for _ in range(30):
            event_str = api.read_line(timeout=0.5)
            if event_str is None:
                continue
            try:
                evt = json.loads(event_str)
            except (json.JSONDecodeError, TypeError):
                continue
            bgp = evt.get('bgp', {})
            msg = bgp.get('message', {})
            if msg.get('type') != 'rpki':
                continue
            rpki = bgp.get('rpki', {})
            if not isinstance(rpki, dict):
                continue
            if rpki.get('status') == 'unavailable':
                continue
            got_rpki_event = True
            if 'aspa-state' in rpki:
                print(f'FAIL: aspa-state present when disabled: {rpki}', file=sys.stderr)
                sys.exit(1)
            print('OK: rpki event has no aspa-state (disabled)', file=sys.stderr)
            break

        if not got_rpki_event:
            print('FAIL: no rpki event received at all', file=sys.stderr)
            sys.exit(1)
    finally:
        dispatch(api, 'request shutdown')
        api.wait_for_shutdown()

if __name__ == '__main__':
    main()
EOF_RUN

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	hub {
		server local {
			ip 127.0.0.1;
			port 0;
			secret rpki-test-secret-key-01234567890;
		}
	}
	external rpki-aspa-disabled-test {
		run ./rpki-aspa-disabled-test.run
		encoder json
	}
	internal rpki {
		use bgp-rpki
	}
	internal adj-rib-in {
		use bgp-adj-rib-in
	}
}

bgp {
	rpki {
		aspa {
			validation false;
		}
		cache-server 127.0.0.1 {
			port $PORT2
		}
	}
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 64500
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}

		attach process rpki-aspa-disabled-test {
			receive [ rpki-received ]
		}
		attach process rpki {
			receive [ update-received ]
		}
		attach process adj-rib-in {
			receive [ update-received state ]
		}
	}
}
EOF_CONF

# RTR mock: has ASPA records but config disables verification
cmd=background:seq=1:exec=ze-test rtr-mock --port $PORT2 --vrp 10.0.0.0/8,24,64502 --aspa 64501:64500 --aspa 64502:64501
cmd=background:seq=2:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=3:exec=ze -:stdin=ze-bgp:timeout=25s
expect=exit:code=0
