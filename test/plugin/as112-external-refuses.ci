# Test: as112 refuses to start as an external plugin process
# VALIDATES: ai/rules/plugins.md "Plugin Process Boundary" -- as112's
# IsInternal() guard (internal/plugins/as112/register.go) refuses to start
# when as112 runs as a genuine external subprocess (not the synthetic
# net.Pipe() unit test), since iface.RegisterOwnedAddresses is a
# same-process call that would silently no-op across the process boundary.
# PREVENTS: an operator configuring `plugin { external as112 { ... } }`
# getting a plugin that "succeeds" at every config commit while silently
# never landing its anycast addresses on any real kernel interface.
#
# // replaced the blind 4.0s sleep + wait.py hold with the
# await=stderr fence below. Coverage is REPLACED and STRENGTHENED, not weakened:
# the WHEN-to-tear-down changes from a fixed sleep to a deterministic wait, and
# the refuse-message assertion is tightened to an as112-SPECIFIC substring (the
# old bare phrase is shared by traffic-usage/flow-export). An observer plugin
# cannot poll `system subsystem list` here because as112's refusal aborts the
# daemon's plugin-startup coordinator (StartupCoordinator.PluginFailed), so the
# relayed stderr line is the only non-plugin signal.

stdin=ze-bgp:terminator=EOF_CONF
service {
	as112 {
		enabled true
	}
}

plugin {
	hub {
		server local {
			ip 127.0.0.1;
			port 0;
			secret as112-external-refuse-test-secret-01;
		}
	}
	external as112 {
		# "ze plugin" is an unrelated CLI verb, not a plugin launcher --
		# ze-test plugin-external
		# (internal/test/cli/cmd_plugin_external.go) launches a registered
		# plugin's own RunEngine via a real TLS connect-back.
		run "ze-test plugin-external as112"
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast {
					prefix {
						maximum 10000
					}
				}
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

# The needle includes "-- the address-ownership registry" so it is SPECIFIC to
# as112: the bare "refusing to start as an external plugin process" phrase is
# emitted verbatim by traffic-usage and flow-export too (same IsInternal guard).
# No ':' in the needle (a ':' would be truncated by the kv splitter).
cmd=foreground:seq=1:exec=ze -:stdin=ze-bgp:timeout=15s
await=stderr:contains=refusing to start as an external plugin process -- the address-ownership registry
expect=stderr:contains=refusing to start as an external plugin process -- the address-ownership registry
