# Test: Looking glass route pagination + Alice-LG birdwatcher consumer
# VALIDATES: AC-11 limit/offset slicing on route-list endpoints; AC-13 the
#            birdwatcher API surface Alice-LG consumes (status, protocols,
#            routes, empty filtered/noexport) end to end.
# PREVENTS: pagination params ignored; filtered/noexport returning non-empty;
#           birdwatcher response shape drift.

# ze-peer expectations (minimal handshake)
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=25s
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# Native observer injects 15 distinct prefixes and stays attached until shutdown.

# ze bgp configuration with LG enabled
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external lg-paginate {
		run "ze-test fixture plugin/lg-paginate"
		encoder json
	}
	internal bgp-rib {
		use bgp-rib
	}
}

environment {
	looking-glass {
		enabled true
		# TLS defaults ON since spec-fixit-mgmt-listener-auth-guard AC-5.
		# This test asserts looking-glass CONTENT over plain HTTP, so it takes
		# the documented opt-out rather than terminating a self-signed TLS
		# handshake; the opt-out working is part of AC-5.
		tls false
		server main {
			ip 127.0.0.1
			port $PORT2
		}
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65000
			}
			router-id 10.0.0.1
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}

		attach process bgp-rib {
			receive [ update state refresh ]
			send [ update ]
		}
	}
}
EOF_CONF

# Process orchestration -- both in background, HTTP checks are the assertions
cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=background:seq=2:exec=ze -:stdin=ze-bgp

# Readiness: wait until the 15 routes are injected and queryable
http=wait:seq=1:url=http://127.0.0.1:$PORT2/api/looking-glass/routes/protocol/10.0.1.1:status=200:contains="routes_count": 15:timeout=15s

# --- AC-11: default (no params) returns the full list, no pagination object ---
http=get:seq=1:url=http://127.0.0.1:$PORT2/api/looking-glass/routes/protocol/10.0.1.1:status=200:contains="routes_count": 15

# --- AC-11: limit caps the page and reports the pre-slice total ---
http=get:seq=2:url=http://127.0.0.1:$PORT2/api/looking-glass/routes/protocol/10.0.1.1?limit=5:status=200:contains="routes_count": 5
http=get:seq=3:url=http://127.0.0.1:$PORT2/api/looking-glass/routes/protocol/10.0.1.1?limit=5:status=200:contains="total_results": 15

# --- AC-11: offset windows into the list ---
http=get:seq=4:url=http://127.0.0.1:$PORT2/api/looking-glass/routes/protocol/10.0.1.1?limit=5&offset=10:status=200:contains="offset": 10

# --- AC-11: offset beyond the end yields an empty page, still 200 ---
http=get:seq=5:url=http://127.0.0.1:$PORT2/api/looking-glass/routes/protocol/10.0.1.1?offset=1000:status=200:contains="routes_count": 0

# --- AC-11: invalid params rejected with 400 ---
http=get:seq=6:url=http://127.0.0.1:$PORT2/api/looking-glass/routes/protocol/10.0.1.1?limit=abc:status=400
http=get:seq=7:url=http://127.0.0.1:$PORT2/api/looking-glass/routes/protocol/10.0.1.1?limit=-1:status=400

# --- AC-13: the birdwatcher surface Alice-LG consumes ---
http=get:seq=8:url=http://127.0.0.1:$PORT2/api/looking-glass/status:status=200:contains=router_id
http=get:seq=9:url=http://127.0.0.1:$PORT2/api/looking-glass/protocols/bgp:status=200:contains=protocols

# --- AC-13: filtered/noexport are empty by design (documented limitation) ---
http=get:seq=10:url=http://127.0.0.1:$PORT2/api/looking-glass/routes/filtered/10.0.1.1:status=200:contains="routes_count": 0
http=get:seq=11:url=http://127.0.0.1:$PORT2/api/looking-glass/routes/noexport/10.0.1.1:status=200:contains="routes_count": 0
