# Test: bgp-rs replays the routes it already holds to a destination that comes
# up AFTER them, in the route-reflection guide's own config shape.
# VALIDATES: the destination's second session receives the source's route. The
#            route server owns peer-up replay: it reads bgp-adj-rib-in's
#            stored routes page by page and relays them itself
#            (server_handlers.go, replayForPeer; ribevents.ReplayRoutesCommand).
#            The destination grants `send [ update ]` to rs alone and gives
#            adj-rib-in only `receive [ update-received state ]`, exactly as
#            docs/guide/route-reflection.md configures it, so the relay is
#            judged on rs's grant and served.
# PREVENTS: the replay going out under adj-rib-in's name, being refused with a
#           `send refused` WARN only, and the late destination silently never
#           receiving the routes already held
#           (plan/journal/silent-fall-through.md, 2026-10-21 replay row).
#
# NON-VACUITY. The destination meets the route twice, once per session:
#   conn=1 seq=1 -- the LIVE forward, the control. It proves the session, the
#                   forward and the bytes are real, and it is the event that
#                   tells the destination to drop its first session.
#   conn=2 seq=1 -- the REPLAY, the subject. The source announces once and
#                   never again, and no RIB plugin is loaded, so only the
#                   peer-up replay can put the route on the second session.
# With the replay judged on adj-rib-in's own grant (the defect), conn=2 seq=1
# never arrives and the destination times out.

stdin=source:terminator=EOF_SOURCE
option=tcp_connections:value=1
option=timeout:value=60s
option=asn:value=65001
# The source must outlive the replay: if it closes, ze withdraws its routes.
option=linger:value=true
# Announce only once ze holds the destination Established, so conn=1 seq=1 is
# the live forward rather than a peer-up replay.
option=await-file:path=destination.up
# ORIGIN IGP, AS_PATH [65001] (4-byte), NEXT_HOP 1.1.1.1, NLRI 10.0.0.0/24.
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002F02000000144001010040020602010000FDE940030401010101180A0000
EOF_SOURCE

stdin=destination:terminator=EOF_DESTINATION
option=tcp_connections:value=2
option=timeout:value=60s
option=asn:value=65002
option=bind:value=127.0.0.2
# Lingers so the runner's then=stop waits for its `successful`.
option=linger:value=true
option=established-file:path=destination.up
# conn=1 CONTROL: the live forward, ze's AS 65000 prepended (RFC 4271 Section 5.1.2).
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF003302000000184001010040020A02020000FDE80000FDE940030401010101180A0000
# Drop the first session once the route is held: the route is stored, and the
# second session comes up after it.
action=close:conn=1:seq=2
# conn=2 SUBJECT: the peer-up replay of the same route, the same bytes.
expect=bgp:conn=2:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF003302000000184001010040020A02020000FDE80000FDE940030401010101180A0000
EOF_DESTINATION

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	internal rs {
		use bgp-rs
	}
	internal adj-rib-in {
		use bgp-adj-rib-in
	}
}

bgp {
	# RFC 8212: an EBGP direction with no policy is refused; this test exchanges routes.
	filter {
		import { final accept; }
		export { final accept; }
	}
	peer source {
		connection {
			remote { ip 127.0.0.1; }
			local { ip 127.0.0.1; accept false; }
		}
		session {
			asn { local 65000; remote 65001; }
			router-id 1.2.3.4
			family { ipv4/unicast { prefix { maximum 10000; } } }
			capability { graceful-restart disable; }
		}
		behavior { group-updates disable; }

		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
		attach process adj-rib-in {
			receive [ update-received state ]
		}
	}

	peer destination {
		connection {
			remote { ip 127.0.0.2; }
			local { ip 127.0.0.2; accept false; }
		}
		session {
			asn { local 65000; remote 65002; }
			router-id 1.2.3.4
			family { ipv4/unicast { prefix { maximum 10000; } } }
			capability { graceful-restart disable; }
		}
		behavior { group-updates disable; }
		timer { connect-retry 5; }

		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
		attach process adj-rib-in {
			receive [ update-received state ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=le test peer --port $PORT:stdin=source
cmd=background:seq=2:exec=le test peer --bind 127.0.0.2 --port $PORT:stdin=destination
cmd=foreground:seq=3:exec=ze -:stdin=ze-bgp:timeout=60s
# The source lingers so its route stays held, so the runner stops ze itself.
# The fence is any line ze always prints at startup; then=stop still waits for
# every check peer to print `successful`, so the destination's conn=2 replay is
# what ends the run (docs/architecture/testing/ci-format.md, "Await").
await=stderr:contains=declare no RFC 9234 role:then=stop
expect=exit:code=0
reject=stderr:pattern=panic
reject=stderr:pattern=fatal error
reject=stderr:pattern=send refused
