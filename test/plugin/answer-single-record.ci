# Test: a one-record answer takes the same path as a large one
#
# Flow:
# 1. Daemon starts with SSH and one configured BGP peer
# 2. Shell script creates SSH credentials via ze init
# 3. `show bgp peer list` names that one peer, so the answer carries one record
# 4. `show bgp peer list | ndjson` renders that record on one line
#
# An answer of one record is a head, one record line, and a terminator carrying
# `count=1`. The envelope the records belong under is the head's `key=`, so a
# record line carries the row and not the `peers` wrapper around it. That is the
# same shape answer-many-records.ci reads, which is the point: the reader never
# branches on how many records arrive. Today the answer is one built object with
# the envelope inside it, which is the special case this test exists to detect.
#
# VALIDATES: AC-2 -- a command producing exactly one record answers with one
# record line and no special case in the reader.
# PREVENTS: a one-record answer taking a second path, and the envelope staying
# in the payload where a consumer must parse JSON to find it.

# Test script: a one-record answer over the SSH exec channel
tmpfs=test-answer-single-record.sh:mode=755:terminator=EOF_SH
#!/bin/sh
set -e

# Signal test runner readiness
touch daemon.ready

# Generate config with SSH on port 0 (OS-assigned)
cat > answer-single-record.conf << 'ZECONF'
bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.2
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65533
				remote 65533
			}
		}
	}
}

system {
	authentication {
		user admin {
			password "$2a$04$UlwuiuH82Unfsq.XEMPGJeDkXwbm3KW.nvVaVXOd/JeFK8VjMjrQO"
			profile [ admin ]
		}
	}
	authorization {
		profile admin {
			run {
				default-action allow
			}
			edit {
				default-action allow
			}
		}
	}
}

environment {
	ssh {
		enabled true
		server main {
			ip 127.0.0.1;
			port 0;
		}
	}
}
ZECONF

# Use a PID-derived high port for BGP to avoid needing root for port 179
export ze_test_bgp_port=$((10000 + ($$ % 50000)))

# Start daemon, capture stderr to parse SSH port
ze start answer-single-record.conf 2>daemon.log &
DAEMON_PID=$!
trap 'kill $DAEMON_PID 2>/dev/null; wait $DAEMON_PID 2>/dev/null' EXIT

# Wait for SSH server to report its listening address
SSH_PORT=""
for i in $(seq 1 50); do
	SSH_PORT=$(grep -o '127\.0\.0\.1:[0-9]*' daemon.log 2>/dev/null | head -1 | cut -d: -f2 || true)
	if [ -n "$SSH_PORT" ]; then
		break
	fi
	sleep 0.2
done

if [ -z "$SSH_PORT" ]; then
	echo "FAIL: SSH server did not start (no address in daemon.log)" >&2
	cat daemon.log >&2
	exit 1
fi
echo "SSH port: $SSH_PORT" >&2

# Brief delay for postStartFunc to wire the authorizer
sleep 0.5

ADMIN_DIR=$(mktemp -d)
trap 'rm -rf "$ADMIN_DIR"; kill $DAEMON_PID 2>/dev/null; wait $DAEMON_PID 2>/dev/null' EXIT
printf 'admin\ntestpass\n127.0.0.1\n%s\n' "$SSH_PORT" | ZE_CONFIG_DIR="$ADMIN_DIR" ze init >/dev/null

# Precondition: the answer covers the one peer. A failure here is a fixture
# problem, not a framing one.
PEERS=$(ZE_CONFIG_DIR="$ADMIN_DIR" ZE_SSH_PASSWORD="testpass" ze cli -c "show bgp peer list | json" 2>&1) || {
	echo "FAIL: show bgp peer list | json did not answer" >&2
	echo "OUTPUT: $PEERS" >&2
	exit 1
}
echo "$PEERS" | grep -q 127.0.0.2 || {
	echo "FAIL: fixture problem -- 127.0.0.2 is missing from the peer list" >&2
	echo "OUTPUT: $PEERS" >&2
	exit 1
}
echo "OK: the peer is in the answer" >&2

# One record, rendered by the path a large answer takes.
NDJSON=$(ZE_CONFIG_DIR="$ADMIN_DIR" ZE_SSH_PASSWORD="testpass" ze cli -c "show bgp peer list | ndjson" 2>&1) || {
	echo "FAIL: show bgp peer list | ndjson did not answer" >&2
	echo "OUTPUT: $NDJSON" >&2
	exit 1
}

RECORDS=$(printf '%s\n' "$NDJSON" | grep -c '^{' || true)
if [ "$RECORDS" -ne 1 ]; then
	echo "FAIL: answer rendered $RECORDS record lines, want 1 (one peer)" >&2
	echo "OUTPUT: $NDJSON" >&2
	exit 1
fi

printf '%s\n' "$NDJSON" | grep -q 127.0.0.2 || {
	echo "FAIL: the record line does not carry the peer it reports" >&2
	echo "OUTPUT: $NDJSON" >&2
	exit 1
}

if printf '%s\n' "$NDJSON" | grep -q '"peers"'; then
	echo "FAIL: the record line carries the peers envelope; the head carries it as key=" >&2
	echo "OUTPUT: $NDJSON" >&2
	exit 1
fi

echo "OK: the one-record answer reached the operator as one record" >&2
exit 0
EOF_SH

# Process orchestration
cmd=foreground:seq=1:exec=./test-answer-single-record.sh:timeout=20s
expect=exit:code=0
