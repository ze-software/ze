# Test: bgp-redistribute -- one fakeredist event with empty NextHop fans out to two
# peers; each UPDATE carries ze's OWN LocalAddress on that session as NEXT_HOP.
# VALIDATES: AC-7 -- `nhop self` triggers per-peer LocalAddress substitution at the reactor.
# PREVENTS: All peers receiving the same NEXT_HOP regardless of session.

# // NOTHING RELAXED -- this STRENGTHENS the test to finally assert
# AC-7. The single stdin=peer block (tcp_connections=2) is replaced by two peer
# blocks and two ze-peer processes, mirroring the working twin
# redistribute-l2tp-multi-peer-nexthop.ci. Reason: ze-peer binds 127.0.0.1 by
# default (internal/test/peer/peer.go:107,201-217) while the ze config below gives
# peer2 `remote ip 127.0.0.2`, so ze dialled 127.0.0.2:$PORT
# where nothing ever listened. conn=2 could never happen and the old comment
# ("both sessions terminate on 127.0.0.1") contradicted the config it described.
# With the second listener in place, peer2's session really does terminate on
# 127.0.0.2 and the per-session NEXT_HOP substitution AC-7 exists to prove becomes
# observable -- which is why the two expectations below now differ.
#
# ze-peer 1 (127.0.0.1): ORIGIN incomplete, empty AS_PATH (iBGP), NEXT_HOP
# 127.0.0.4 -- ze's OWN address on this session, never the peer's own 127.0.0.1
# (RFC 4271 Section 5.1.3). LOCAL_PREF 100, NLRI 10.0.0.1/32. LOCAL_PREF is
# well-known mandatory on an iBGP session (RFC 4271 5.1.5), emitted by
# reactor_api_batch.go buildWireModeUpdate.
stdin=peer1:terminator=EOF_PEER1
option=tcp_connections:value=1
option=timeout:value=15s
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00310200000015400101024002004003047F00000440050400000064200A000001
EOF_PEER1

# ze-peer 2 (127.0.0.2): byte-identical except NEXT_HOP 127.0.0.5, ze's own
# address on THAT session -- the per-peer LocalAddress substitution this test
# exists to prove. Two distinct values, neither one its own peer's address.
stdin=peer2:terminator=EOF_PEER2
option=tcp_connections:value=1
option=timeout:value=15s
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00310200000015400101024002004003047F00000540050400000064200A000001
EOF_PEER2


stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external nhself-test {
		run "ze-test fixture plugin/bgp-redistribute-nexthop-self"
		encoder json
	}
	internal redistribute-orchestrator {
		use redistribute-orchestrator
	}
	internal fakeredist {
		use fakeredist
	}
}

redistribute {
	destination bgp {
		import fakeredist {
			family [ ipv4/unicast ];
		}
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			# Ze's own address on this session, and what `nhop self` puts on the
			# wire. Deliberately NOT the peer's 127.0.0.1: RFC 4271 Section 5.1.3
			# forbids advertising a peer an address of that peer as NEXT_HOP.
			local {
				ip 127.0.0.4
				accept false
			}
		}
		session {
			asn {
				local 65533
				remote 65533
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		attach process redistribute-orchestrator {
			send [ update ]
		}
	}
	peer peer2 {
		connection {
			remote {
				ip 127.0.0.2
			}
			# Ze's own address on this session, and what `nhop self` puts on the
			# wire. Deliberately NOT the peer's 127.0.0.2: RFC 4271 Section 5.1.3
			# forbids advertising a peer an address of that peer as NEXT_HOP.
			local {
				ip 127.0.0.5
				accept false
			}
		}
		session {
			asn {
				local 65533
				remote 65533
			}
			router-id 1.2.3.5
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		attach process redistribute-orchestrator {
			send [ update ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer1
cmd=background:seq=2:exec=ze-peer --bind 127.0.0.2 --port $PORT:stdin=peer2
cmd=foreground:seq=3:exec=ze -:stdin=ze-bgp:timeout=20s
# // expect=exit:code=0 removed -- this STRENGTHENS the test. Coverage
# is replaced by the per-peer ze-peer wire expectations above, which now govern the
# verdict. The exit-code line asserted nothing about BGP and, until 2026-07-16,
# actively disabled the peer check (spec-fixit-redistribute-establishment-stall, D2).
