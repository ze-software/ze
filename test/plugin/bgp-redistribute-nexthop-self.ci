# Test: bgp-redistribute -- one fakeredist event with empty NextHop fans out to two
# peers; each UPDATE carries the destination peer's own LocalAddress as NEXT_HOP.
# VALIDATES: AC-7 -- `nhop self` triggers per-peer LocalAddress substitution at the reactor.
# PREVENTS: All peers receiving the same NEXT_HOP regardless of session.

# // test-relax: NOTHING RELAXED -- this STRENGTHENS the test to finally assert
# AC-7. The single stdin=peer block (tcp_connections=2) is replaced by two peer
# blocks and two ze-peer processes, mirroring the working twin
# redistribute-l2tp-multi-peer-nexthop.ci. Reason: ze-peer binds 127.0.0.1 by
# default (internal/test/peer/peer.go:107,201-217) while the ze config below gives
# peer2 `local ip 127.0.0.2` / `remote ip 127.0.0.2`, so ze dialled 127.0.0.2:$PORT
# where nothing ever listened. conn=2 could never happen and the old comment
# ("both sessions terminate on 127.0.0.1") contradicted the config it described.
# With the second listener in place, peer2's session really does terminate on
# 127.0.0.2 and the per-session NEXT_HOP substitution AC-7 exists to prove becomes
# observable -- which is why the two expectations below now differ.
#
# ze-peer 1 (127.0.0.1): ORIGIN incomplete, empty AS_PATH (iBGP), NEXT_HOP
# 127.0.0.1, LOCAL_PREF 100, NLRI 10.0.0.1/32. LOCAL_PREF is well-known mandatory
# on an iBGP session (RFC 4271 5.1.5), emitted by reactor_api_batch.go
# buildWireModeUpdate.
stdin=peer1:terminator=EOF_PEER1
option=tcp_connections:value=1
option=timeout:value=15s
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00310200000015400101024002004003047F00000140050400000064200A000001
EOF_PEER1

# ze-peer 2 (127.0.0.2): byte-identical except NEXT_HOP 127.0.0.2 -- the per-peer
# LocalAddress substitution this test exists to prove.
stdin=peer2:terminator=EOF_PEER2
option=tcp_connections:value=1
option=timeout:value=15s
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00310200000015400101024002004003047F00000240050400000064200A000001
EOF_PEER2

tmpfs=nhself-test.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
import time
from ze_api import API, runtime_fail


def dispatch(api, command):
    return api._call_engine('ze-plugin-engine:dispatch-command', {'command': command}) or {}


def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()

    # Wait for both peers to come up.
    # Wait on the peer's own state, then on its initial-sync EOR reaching the
    # wire, instead of holding a fixed 2s and hoping establishment fitted in it.
    if not api.wait_peer_eor_sent():
        runtime_fail('initial-sync EOR never reached the wire')
        return

    resp = dispatch(api, 'request fakeredist emit add ipv4/unicast 10.0.0.1/32')
    result = resp.get('result', {})
    if result.get('status') != 'done':
        runtime_fail(f'request fakeredist emit failed: {result}')
        return

    # There IS a queryable signal: `request quiesce` returns once the BGP
    # forward pool and every peer's initial-sync opQueue have settled, which is
    # exactly "the emitted route finished dispatching".
    if not api.quiesce():
        runtime_fail('quiesce barrier did not complete')
        return
    dispatch(api, 'request shutdown')
    api.wait_for_shutdown()


if __name__ == '__main__':
    main()
EOF_RUN

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external nhself-test {
		run ./nhself-test.run
		encoder json
	}
	internal redistribute-orchestrator {
		use redistribute-orchestrator
	}
	internal fakeredist {
		use fakeredist
	}
}

redistribute {
	destination bgp {
		import fakeredist {
			family [ ipv4/unicast ];
		}
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65533
				remote 65533
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
	peer peer2 {
		connection {
			remote {
				ip 127.0.0.2
			}
			local {
				ip 127.0.0.2
				accept false
			}
		}
		session {
			asn {
				local 65533
				remote 65533
			}
			router-id 1.2.3.5
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer1
cmd=background:seq=2:exec=ze-peer --bind 127.0.0.2 --port $PORT:stdin=peer2
cmd=foreground:seq=3:exec=ze -:stdin=ze-bgp:timeout=20s
# // test-relax: expect=exit:code=0 removed -- this STRENGTHENS the test. Coverage
# is replaced by the per-peer ze-peer wire expectations above, which now govern the
# verdict. The exit-code line asserted nothing about BGP and, until 2026-07-16,
# actively disabled the peer check (spec-fixit-redistribute-establishment-stall, D2).
