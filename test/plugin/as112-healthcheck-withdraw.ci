# AS112 BGP integration (spec-as112-3): a route that WAS announced (probe UP)
# gets withdrawn once the probe transitions to DOWN. Models the ExaBGP #1383
# announce->withdraw cycle scenario (test/plugin/healthcheck-cycle.ci) with
# AS112's config shape: four covering prefixes (H3), community no-export, and
# the mandatory watchdog withdraw marker (H2).
#
# FAKE probe: a tmpfs sentinel file "healthy" exists at test start, so the
# first check succeeds (INIT -> UP, announce). A background helper removes the
# sentinel after a delay, so the next check fails (UP -> DOWN, withdraw). This
# is the established pattern for driving a fast, deterministic UP->DOWN cycle
# in a functional test without a real DNS dependency.
#
# AC-3: probe reaches DOWN after having been UP -> routes withdrawn from the peer.

# ze-peer expectations
stdin=peer:terminator=EOF_PEER
option=timeout:value=15s
# Startup: only EOR expected (both AS112 update blocks have watchdog withdraw=true).
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
# First probe check succeeds (sentinel present) -> INIT -> UP -> announce.
# 4 entries (2 ipv4 covering /24s + 2 ipv6 covering /48s), unordered group
# (pool iteration order is not deterministic).
cmd=api:conn=1:seq=2:text=healthcheck probe UP triggers watchdog announce as112 med 100
expect=bgp:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF003E020000002340010100400200400304010203048004040000006440050400000064C00804FFFFFF0118C0AF30
expect=bgp:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF003E020000002340010100400200400304010203048004040000006440050400000064C00804FFFFFF0118C01FC4
expect=bgp:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0052020000003B400101004002008004040000006440050400000064C00804FFFFFF01800E1C000201102001000000000000000000000000000100302620004F8000
expect=bgp:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0052020000003B400101004002008004040000006440050400000064C00804FFFFFF01800E1C00020110200100000000000000000000000000010030200100040112
# Sentinel removed -> next probe check fails -> UP -> DOWN -> withdraw.
# 4 withdrawals, unordered group.
cmd=api:conn=1:seq=3:text=healthcheck probe DOWN triggers watchdog withdraw as112
expect=bgp:conn=1:seq=3:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF001B02000418C0AF300000
expect=bgp:conn=1:seq=3:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF001B02000418C01FC40000
expect=bgp:conn=1:seq=3:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0024020000000D800F0A000201302620004F8000
expect=bgp:conn=1:seq=3:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0024020000000D800F0A00020130200100040112
EOF_PEER

# ze bgp configuration
stdin=ze-bgp:terminator=EOF_CONF
bgp {
	healthcheck {
		probe as112 {
			command "test -f healthy"
			group as112
			interval 1
			rise 1
			fall 1
			withdraw-on-down true
			debounce true
			up-metric 100
		}
	}
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65533
				remote 65533
			}
			router-id 10.0.0.10
			family {
				ipv4/unicast { prefix { maximum 10000; } }
				ipv6/unicast { prefix { maximum 10000; } }
			}
		}

		# AS112 covering prefixes -- IPv4 (H3). Split by address family
		# because next-hop is family-specific.
		update {
			attribute {
				origin igp
				local-preference 100
				next-hop 1.2.3.4
				community [ no-export ]
			}
			nlri {
				ipv4/unicast add 192.175.48.0/24
				ipv4/unicast add 192.31.196.0/24
			}
			watchdog {
				name as112
				withdraw true
			}
		}
		# AS112 covering prefixes -- IPv6 (H3).
		update {
			attribute {
				origin igp
				local-preference 100
				next-hop 2001::1
				community [ no-export ]
			}
			nlri {
				ipv6/unicast add 2620:4f:8000::/48
				ipv6/unicast add 2001:4:112::/48
			}
			watchdog {
				name as112
				withdraw true
			}
		}
	}
}
EOF_CONF

# Sentinel file: probe succeeds while this exists.
tmpfs=healthy:terminator=EOF_HEALTHY
1
EOF_HEALTHY

# Helper: removes sentinel after delay to trigger probe failure, then exits.
tmpfs=remove-healthy.run:mode=755:terminator=EOF_REMOVE
#!/bin/sh
sleep 3
rm -f ./healthy
exit 0
EOF_REMOVE

# Process orchestration
cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=background:seq=2:exec=./remove-healthy.run
cmd=foreground:seq=3:exec=ze --plugin ze.bgp-healthcheck --plugin ze.bgp-watchdog -:stdin=ze-bgp:timeout=15s
