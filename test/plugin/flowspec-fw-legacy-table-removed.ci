# Test: legacy cleanup and an action replacement leave one rule in each hook.
# VALIDATES: the old unprefixed table disappears, then a sampled replacement
# of the same authorized TCP rule reaches input and forward without duplicates.
# PREVENTS: stale legacy drops or append-only reconciliation. The driver first
# observes the unsampled original in both hooks, then releases its replacement.
option=needs-linux:caps=net-admin
# Both suites use the kernel-global ze_flowspec table.
option=exclusive:group=flowspec-nft
option=env:var=ze.log.firewall:value=info
option=env:var=ze.log.flowspec.firewall:value=info
option=timeout:value=40s

stdin=peer:terminator=EOF_PEER
option=linger:value=true
option=tcp_connections:value=1
option=timeout:value=35s
# Eligible covering unicast precedes every selected FlowSpec rule.
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002E02000000154001010040020040050400000064400304C0000201080A
action=send:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0044020000002D4001010040020040050400000064800E1100018500000B01180A0100038106058150C010088006000000000000
# The driver sends this marker only after observing the unsampled original.
expect=bgp:conn=1:seq=3:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF003102000000154001010040020040050400000064400304C000020120C612FFFE
# Same NLRI, now sample+discard, after the observed original has been installed.
action=send:conn=1:seq=4:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF004C02000000354001010040020040050400000064800E1100018500000B01180A0100038106058150C0101080060000000000008007000000000002
EOF_PEER

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	internal flowspec-firewall { use flowspec-firewall; }
	external flowspec-observer {
		run "le test fixture plugin/flowspec-fw-legacy-table-removed";
		encoder json;
	}
}
bgp {
	peer peer1 {
		connection {
			remote { ip 127.0.0.1; }
			local { ip 127.0.0.1; accept false; }
		}
		session {
			asn { local 1; remote 1; }
			router-id 1.2.3.4;
			family {
				ipv4/unicast { prefix { maximum 10000; } }
				ipv4/flow { prefix { maximum 10000; } }
			}
		}
		attach process flowspec-observer { send [ raw ]; }
	}
}
EOF_CONF

cmd=foreground:seq=1:exec=le test fixture plugin/flowspec-fw-legacy-table-removed/seed
cmd=background:seq=2:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=3:exec=ze -:stdin=ze-bgp:timeout=35s
expect=exit:code=0
expect=stderr:contains=table inet ze_flowspec
expect=stderr:contains=chain flowspec-in
expect=stderr:contains=chain flowspec-fwd
expect=stderr:contains=10.1.0.0/24
expect=stderr:contains=log prefix
