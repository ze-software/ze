# Test: show subscriber works with enrichers registered (CoS plugin loaded).
#
# VALIDATES: spec-show-enricher wiring -- enricher registry wired end-to-end.
#            On idle daemon (no sessions): show subscriber returns total=0,
#            show class-of-service returns loaded profiles. Enrichers are
#            registered but have nothing to enrich (no sessions with CoS state).
# PREVENTS:  regression where enricher registration breaks show commands.

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

tmpfs=show-subscriber-enricher-wiring.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
"""Verify show subscriber + show class-of-service with enrichers registered."""

import json
import time

from ze_api import API, runtime_fail, result_json_data, result_text_data


def dispatch(api, command):
    resp = api._call_engine(
        'ze-plugin-engine:dispatch-command', {'command': command})
    if resp is None:
        return {'status': 'error', 'data': 'engine call returned None'}
    return resp.get('result', {})


def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()
    api.wait_for_post_startup(timeout=5.0)

    # show subscriber on idle daemon: total=0, no crash with enrichers registered
    # // poll loop centralized into api.dispatch_until_done (ci-sleep
    # ratchet); behavior and the status assertion below are unchanged.
    r = api.dispatch_until_done('show subscriber')
    if r.get('status') != 'done':
        status = r.get('status') if r else 'nil'
        data = result_text_data(r) if r else ''
        runtime_fail(f'show subscriber: status={status} data={data[:200]}')

    try:
        summary = result_json_data(r, {})
    except json.JSONDecodeError as exc:
        runtime_fail(f'show subscriber json: {exc}: {result_text_data(r)[:200]}')
        summary = {}

    if summary.get('total') != 0:
        runtime_fail(f'show subscriber total={summary.get("total")!r} want 0')

    # show class-of-service: profiles loaded
    # // poll loop centralized into api.dispatch_until_done (ci-sleep
    # ratchet); behavior and the status assertion below are unchanged.
    r2 = api.dispatch_until_done('show class-of-service')
    if r2.get('status') != 'done':
        status = r2.get('status') if r2 else 'nil'
        runtime_fail(f'show class-of-service: status={status}')

    try:
        profiles = result_json_data(r2, [])
    except json.JSONDecodeError as exc:
        runtime_fail(f'show class-of-service json: {exc}')
        profiles = []

    if not isinstance(profiles, list) or len(profiles) == 0:
        runtime_fail(f'show class-of-service: expected profiles, got {profiles!r}')

    names = [p.get('name') for p in profiles if isinstance(p, dict)]
    if 'residential' not in names:
        runtime_fail(f'show class-of-service: expected residential in {names}')

    dispatch(api, 'request shutdown')
    api.wait_for_shutdown()


if __name__ == '__main__':
    main()
EOF_RUN

stdin=ze-conf:terminator=EOF_CONF
class-of-service {
	ieee-802.1p residential {
		ingress {
			pcp 0 { priority 0; }
			pcp 6 { priority 6; }
		}
		egress {
			priority 0 { pcp 0; }
			priority 6 { pcp 6; }
		}
	}
}

plugin {
	external show-subscriber-enricher-wiring-test {
		run ./show-subscriber-enricher-wiring.run
		encoder json
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-conf:timeout=15s
expect=exit:code=0
