# Test: multipath selects multiple equal-cost paths
# VALIDATES: cmd-3 AC-2 -- maximum-paths=4, equal-cost paths selected in multipath set
# PREVENTS: multipath config not wired to RIB or multipath-peers missing from output

# One real peer sends a route. Python observer injects a second route from a
# synthetic peer via bgp rib inject with identical attributes. Then queries
# rib best and verifies multipath-peers in output.

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=20s
# The multipath assertion needs BOTH paths for 10.1.0.0/24: the one injected
# synthetically (10.0.0.99) and the one learned from THIS peer over the wire. The
# wire path exists only while this session is up: when the peer goes away ze
# correctly withdraws it, leaving a single-path entry and an empty
# multipath-peers. Without linger the peer exits the instant it receives ze's
# End-of-RIB, so the test only passed by winning a ~500ms race (ze holds the EOR
# behind the initial-sync barrier, peer_initial_sync.go). linger holds the session
# open past the expectation, making the multipath assertion load-independent.
option=linger:value=true

# Send IPv4 UPDATE with LOCAL_PREF=100, AS_PATH=[65001], NEXT_HOP=10.0.0.1
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0036020000001B4001010040020602010000FDE94003040A00000140050400000064180A0100
# Assert ze's ipv4/unicast End-of-RIB (RFC 4724 S2: the empty UPDATE). This is a
# real wire assertion, not just a TCP-hold: the observer gates `request shutdown`
# on eor-sent >= 1 (see wait_eor_sent below), so ze is given the chance to emit it.
# It also keeps the peer from closing TCP while the observer polls for peer state.
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

tmpfs=multipath-test.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
import json
import sys
from ze_api import API, runtime_fail, result_text_data, result_json_data
# // test-relax: removed unused 'import time'; blind sleeps replaced by dispatch_until polls

def dispatch(api, command):
    resp = api._call_engine(
        'ze-plugin-engine:dispatch-command', {'command': command})
    if resp is None:
        return {'status': 'error', 'data': 'engine call returned None'}
    return resp.get('result', {})

def eor_sent(result):
    """True once ze has written its End-of-RIB to at least one peer.

    `show bgp peer <sel> detail` returns {"peers": {"<ip>": {..., "eor-sent": N}}}
    (peer.go:217, :341-345). peer_stats.go IncrEORSent, called only from
    peer_initial_sync.go's sendInitialRoutes, increments the counter once the EOR
    write has succeeded and been flushed to the peer's socket, so eor-sent >= 1
    proves the marker is on the wire rather than merely scheduled.
    """
    if result.get('status') != 'done':
        return False
    try:
        peers = result_json_data(result, {}).get('peers', {})
    except (json.JSONDecodeError, TypeError, ValueError):
        return False
    return any(p.get('eor-sent', 0) >= 1 for p in peers.values())

def wait_eor_sent(api, selector):
    """Block until ze has sent its EOR, so `request shutdown` cannot pre-empt it.

    The peer block asserts ze's End-of-RIB on the wire. ze emits it only after the
    initial-sync barrier: peer_initial_sync.go's sendInitialRoutes runs the
    apiSync wait (500ms sleep, then the plugin-ready signal) before its EOR-send
    loop builds and sends the EOR. The
    session reaches `established` long before that, so a shutdown gated on
    establishment (or on the RIB check) closes TCP first and the peer's expectation
    can never fire. Gate on the EOR the test actually asserts.
    """
    if not eor_sent(api.dispatch_until(
            f'show bgp peer {selector} detail', eor_sent, attempts=40)):
        runtime_fail(f'ze never sent its End-of-RIB to {selector}')

def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()

    # Wait for peer1's initial sync to reach the wire before injecting anything.
    #
    # // test-relax: the `'established' in <detail json>` check removed here was
    # VACUOUS, not coverage: every peer row carries the KEY
    # `connections-established` (cmd/peer/peer.go:238), so the substring matched
    # on the FIRST poll -- before any session existed -- and the barrier returned
    # instantly, gating none of the assertions below it. Replaced by this file's
    # own wait_eor_sent, which polls the per-peer `eor-sent` counter (peer.go:217;
    # peer_stats.go IncrEORSent increments it only once peer_initial_sync.go's
    # sendInitialRoutes has written AND flushed the EOR to the peer's socket).
    # eor-sent >= 1 strictly implies established, so this is stronger than the
    # check it replaces and it fails loudly.
    wait_eor_sent(api, 'peer1')

    # Inject a second equal-cost route from synthetic peer.
    # // test-relax: dropped 'allow UPDATE processing' sleep (folded into the rib-best poll below)
    result = dispatch(api, 'request bgp rib inject 10.0.0.99 ipv4/unicast 10.1.0.0/24 origin igp aspath 65001 localpref 100')
    if result.get('status') != 'done':
        runtime_fail(f'rib inject failed: {result}')

    # Query rib best, polling until the wire route + injected route form a 2-path multipath.
    # // test-relax: blind sleep(0.5) + single show -> dispatch_until poll for 10.1.0.0/24 with 1 sibling
    def has_multipath(res):
        if res.get('status') != 'done':
            return False
        try:
            rows = json.loads(result_text_data(res, '{}')).get('best-path', [])
        except (json.JSONDecodeError, TypeError):
            return False
        for e in rows:
            if e.get('prefix') == '10.1.0.0/24':
                return len(e.get('multipath-peers', [])) == 1
        return False

    result = api.dispatch_until('show bgp rib best', has_multipath)
    if result.get('status') != 'done':
        runtime_fail(f'rib show best failed: {result}')

    data = result_text_data(result, '{}')
    parsed = json.loads(data) if isinstance(data, str) else data
    entries = parsed.get('best-path', [])

    if not entries:
        runtime_fail(f'best-path array is empty, raw: {data[:200]}')

    # Find the entry for 10.1.0.0/24
    found = None
    for entry in entries:
        if entry.get('prefix') == '10.1.0.0/24':
            found = entry
            break

    if found is None:
        runtime_fail(f'no entry for 10.1.0.0/24, got: {[e.get("prefix") for e in entries]}')

    # Verify multipath-peers is present and non-empty
    mp_peers = found.get('multipath-peers', [])
    if not mp_peers:
        runtime_fail(f'multipath-peers empty, entry: {found}')

    if len(mp_peers) != 1:
        runtime_fail(f'expected 1 sibling, got {len(mp_peers)}: {mp_peers}')

    print(f'OK: multipath: best={found.get("best-peer")}, siblings={mp_peers}', file=sys.stderr)

    wait_eor_sent(api, 'peer1')

    dispatch(api, 'request shutdown')
    api.wait_for_shutdown()

if __name__ == '__main__':
    main()
EOF_RUN

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external multipath-test {
		run ./multipath-test.run
		encoder json
	}
	internal bgp-rib {
		use bgp-rib
	}
}
bgp {
	multipath {
		maximum-paths 4
		relax-as-path true
	}

	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65000
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}

		attach process bgp-rib {
			receive [ update state refresh ]
			send [ update ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
reject=stderr:pattern=panic recovered
reject=stderr:pattern=fatal error
reject=stderr:pattern=ZE-OBSERVER-FAIL
