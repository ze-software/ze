# Test: rib forward-handle observer fires on a real BGP UPDATE
# VALIDATES: design-rib-rs-fastpath end-to-end wiring --
#   handleReceivedStructured creates a ribForwardHandle,
#   checkBestPathChange passes it to locrib.InsertForward,
#   locrib dispatches a Change with non-nil Forward to subscribers,
#   observeForwardHandles logs it at debug level.
# PREVENTS: silent regression of the producer wiring on the full
#   wire-to-locrib path through the daemon.

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
# The observer asserts that 192.168.1.0/24 -- learned from THIS peer over the
# wire -- reaches the best-path table. That route exists only while this session
# is up: when the peer goes away ze correctly withdraws it. Without linger the
# peer exits the instant it receives ze's End-of-RIB, so the route is withdrawn
# out from under the observer and the test only passed by winning a ~500ms race
# (ze holds the EOR behind the initial-sync barrier, peer_initial_sync.go).
# linger holds the session open past the expectation, making the best-path
# assertion independent of host load.
option=linger:value=true

# Peer sends one IPv4 UPDATE for 192.168.1.0/24
# (ORIGIN=IGP, AS_PATH empty, NEXT_HOP=10.0.0.1, LOCAL_PREF=100).
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00300200000015400101004002004003040A0000014005040000006418C0A801

# Assert ze's ipv4/unicast End-of-RIB (RFC 4724 S2: the empty UPDATE), which also
# confirms the session survived past UPDATE processing. The observer gates
# `request shutdown` on eor-sent >= 1 (see wait_eor_sent below) so ze is given the
# chance to emit it, rather than being torn down mid initial-sync.
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# Observer: poll for peer established, poll for the route to appear in
# the RIB (proves the UPDATE was parsed + processed), then dispatch
# daemon shutdown. No hardcoded sleeps: the test finishes as soon as
# ze has observably processed the UPDATE.
tmpfs=shutdown.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
import json
from ze_api import API, runtime_fail, result_text_data, result_json_data
# // test-relax: removed unused 'import time'; blind sleeps are now dispatch_until polls

def dispatch(api, command):
    resp = api._call_engine(
        'ze-plugin-engine:dispatch-command', {'command': command})
    if resp is None:
        return {'status': 'error', 'data': 'engine call returned None'}
    return resp.get('result', {})

def eor_sent(result):
    """True once ze has written its End-of-RIB to at least one peer.

    `show bgp peer <sel> detail` returns {"peers": {"<ip>": {..., "eor-sent": N}}}
    (peer.go:217, :341-345). peer_stats.go IncrEORSent, called only from
    peer_initial_sync.go's sendInitialRoutes, increments the counter once the EOR
    write has succeeded and been flushed to the peer's socket, so eor-sent >= 1
    proves the marker is on the wire rather than merely scheduled.
    """
    if result.get('status') != 'done':
        return False
    try:
        peers = result_json_data(result, {}).get('peers', {})
    except (json.JSONDecodeError, TypeError, ValueError):
        return False
    return any(p.get('eor-sent', 0) >= 1 for p in peers.values())

def wait_eor_sent(api, selector):
    """Block until ze has sent its EOR, so `request shutdown` cannot pre-empt it.

    The peer block asserts ze's End-of-RIB on the wire. ze emits it only after the
    initial-sync barrier: peer_initial_sync.go's sendInitialRoutes runs the
    apiSync wait (500ms sleep, then the plugin-ready signal) before its EOR-send
    loop builds and sends the EOR. The
    session reaches `established` long before that, so a shutdown gated on
    establishment (or on the RIB check) closes TCP first and the peer's expectation
    can never fire. Gate on the EOR the test actually asserts.
    """
    if not eor_sent(api.dispatch_until(
            f'show bgp peer {selector} detail', eor_sent, attempts=40)):
        runtime_fail(f'ze never sent its End-of-RIB to {selector}')

def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()

    # Wait for peer1's initial sync to reach the wire before asserting anything.
    #
    # // test-relax: the `'established' in <detail json>` check removed here was
    # VACUOUS, not coverage: every peer row carries the KEY
    # `connections-established` (cmd/peer/peer.go:238), so the substring matched
    # on the FIRST poll -- before any session existed -- and the barrier returned
    # instantly, gating none of the assertions below it. Replaced by this file's
    # own wait_eor_sent, which polls the per-peer `eor-sent` counter (peer.go:217;
    # peer_stats.go IncrEORSent increments it only once peer_initial_sync.go's
    # sendInitialRoutes has written AND flushed the EOR to the peer's socket).
    # eor-sent >= 1 strictly implies established, so this is stronger than the
    # check it replaces and it fails loudly.
    wait_eor_sent(api, 'peer1')

    # Poll until the UPDATE's prefix has landed in the BGP best-path
    # table. checkBestPathChange drives the best-path update AND the
    # locrib.InsertForward call that fires the observer; seeing the
    # prefix here guarantees the observer's log has already been
    # emitted (same goroutine, same code path).
    # // test-relax: hand-rolled poll+sleep loop -> dispatch_until (deterministic best-path wait)
    best = api.dispatch_until(
        'show bgp rib best',
        lambda r: '192.168.1.0/24' in result_text_data(r),
        attempts=40, delay=0.1,
    )
    if '192.168.1.0/24' not in result_text_data(best):
        runtime_fail('192.168.1.0/24 never appeared in bgp rib show best')

    wait_eor_sent(api, 'peer1')

    dispatch(api, 'request shutdown')
    api.wait_for_shutdown()

if __name__ == '__main__':
    main()
EOF_RUN

stdin=ze-bgp:terminator=EOF_CONF
environment {
	log {
		bgp.rib debug
	}
}

plugin {
	external shutdown-after-update {
		run ./shutdown.run
		encoder json
	}
	internal bgp-rib {
		use bgp-rib
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}

		attach process bgp-rib {
			receive [ update state refresh ]
			send [ update ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s

expect=exit:code=0
# Single-line regex: "forward-handle observed" and prefix=192.168.1.0/24
# MUST appear on the same log line, proving this one Change carried
# the handle (not just that both strings exist somewhere in stderr).
expect=stderr:pattern=forward-handle observed.*prefix=192\.168\.1\.0/24.*kind=add

reject=stderr:pattern=panic recovered
reject=stderr:pattern=fatal error
# runtime_fail emits this sentinel on the observer's stderr; without the reject the
# observer's assertion failures would be invisible to the runner.
reject=stderr:pattern=ZE-OBSERVER-FAIL
