# Test: rib forward-handle observer fires on a real BGP UPDATE
# VALIDATES: design-rib-rs-fastpath end-to-end wiring --
#   handleReceivedStructured creates a ribForwardHandle,
#   checkBestPathChange passes it to locrib.InsertForward,
#   locrib dispatches a Change with non-nil Forward to subscribers,
#   observeForwardHandles logs it at debug level.
# PREVENTS: silent regression of the producer wiring on the full
#   wire-to-locrib path through the daemon.

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s
# The observer asserts that 192.168.1.0/24 -- learned from THIS peer over the
# wire -- reaches the best-path table. That route exists only while this session
# is up: when the peer goes away ze correctly withdraws it. Without linger the
# peer exits the instant it receives ze's End-of-RIB, so the route is withdrawn
# out from under the observer and the test only passed by winning a ~500ms race
# (ze holds the EOR behind the initial-sync barrier, peer_initial_sync.go).
# linger holds the session open past the expectation, making the best-path
# assertion independent of host load.
option=linger:value=true

# Peer sends one IPv4 UPDATE for 192.168.1.0/24
# (ORIGIN=IGP, AS_PATH empty, NEXT_HOP=10.0.0.1, LOCAL_PREF=100).
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00300200000015400101004002004003040A0000014005040000006418C0A801

# Assert ze's ipv4/unicast End-of-RIB (RFC 4724 S2: the empty UPDATE), which also
# confirms the session survived past UPDATE processing. The observer gates
# `request shutdown` on eor-sent >= 1 (see wait_eor_sent below) so ze is given the
# chance to emit it, rather than being torn down mid initial-sync.
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# Observer: poll for peer established, poll for the route to appear in
# the RIB (proves the UPDATE was parsed + processed), then dispatch
# daemon shutdown. No hardcoded sleeps: the test finishes as soon as
# ze has observably processed the UPDATE.

stdin=ze-bgp:terminator=EOF_CONF
environment {
	log {
		bgp.rib debug
	}
}

plugin {
	external shutdown-after-update {
		run "ze-test fixture plugin/rib-forward-handle-observed"
		encoder json
	}
	internal bgp-rib {
		use bgp-rib
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}

		attach process bgp-rib {
			receive [ update state refresh ]
			send [ update ]
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s

expect=exit:code=0
# Single-line regex: "forward-handle observed" and prefix=192.168.1.0/24
# MUST appear on the same log line, proving this one Change carried
# the handle (not just that both strings exist somewhere in stderr).
expect=stderr:pattern=forward-handle observed.*prefix=192\.168\.1\.0/24.*kind=add

reject=stderr:pattern=panic recovered
reject=stderr:pattern=fatal error
# runtime_fail emits this sentinel on the observer's stderr; without the reject the
# observer's assertion failures would be invisible to the runner.
reject=stderr:pattern=ZE-OBSERVER-FAIL
