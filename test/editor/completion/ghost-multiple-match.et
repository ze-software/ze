# Test: Ghost text with multiple matching completions
# VALIDATES: Common prefix shown when multiple matches
# VALIDATES: Ghost text shows common prefix extension beyond typed text
# PREVENTS: Wrong completion shown with multiple options

tmpfs=test.conf:terminator=EOF_CONF
bgp {
  router-id 1.2.3.4;
}
EOF_CONF

option=file:path=test.conf
option=timeout:value=10s
# An active editing session is required for "disconnect" (and "who") to appear
# in completions; without it they are filtered and only "discard" matches "di".
option=session:user=thomas:origin=local

# Type "di" which matches "discard" and "disconnect" (common prefix "disc").
# Ghost text shows "sc" (the common extension beyond "di").
input=type:text=di
expect=completion:contains=discard,disconnect

# Ghost text extends to common prefix "disc" -> shows "sc" after "di".
expect=ghost:text=sc
