# Test: IPsec group reference completion offers the configured groups
# VALIDATES: Tab on a site-to-site peer's ike-group leaf, a YANG leafref to
#            "../../../ike-group/name", offers the groups the ike-group list
#            declares, and Tab on its esp-group leaf offers the esp-group names.
# PREVENTS: a group leaf completing only a type hint, so the operator types a
#           group name from memory and learns of a typo at commit.

tmpfs=test.conf:terminator=EOF_CONF
vpn {
	ipsec {
		ike-group IKE-A {
			proposal 1 {
				encryption aes256gcm
				hash sha256
				dh-group 14
			}
		}
		ike-group IKE-B {
			proposal 1 {
				encryption aes256gcm
				hash sha256
				dh-group 14
			}
		}
		esp-group ESP-A {
			proposal 1 {
				encryption aes256gcm
			}
		}
		esp-group ESP-B {
			proposal 1 {
				encryption aes256gcm
			}
		}
		site-to-site {
			peer branch-1 {
				ike-group IKE-A
				esp-group ESP-A
				local-address 127.0.0.1
				remote-address 127.0.0.2
				authentication {
					mode pre-shared-secret
					pre-shared-secret 00ff410a1b2c3d4e5f60718293a4b5c6
					pre-shared-secret-encoding hex
				}
			}
		}
	}
}
EOF_CONF

option=file:path=test.conf
option=timeout:value=10s

input=type:text=edit vpn ipsec site-to-site peer branch-1
input=enter
expect=context:path=vpn/ipsec/site-to-site/peer/branch-1
input=type:text=set ike-group
input=space
expect=completion:contains=IKE-A,IKE-B
input=ctrl:key=u
input=type:text=set esp-group
input=space
expect=completion:contains=ESP-A,ESP-B
