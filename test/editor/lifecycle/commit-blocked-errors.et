# Test: Commit blocked when validation errors exist
# VALIDATES: Commit fails with validation errors
# VALIDATES: Error message mentions validation

tmpfs=test.conf:terminator=EOF_CONF
bgp {
  router-id 1.2.3.4;
  peer peer1 {
  	connection {
  		remote {
  			ip 1.1.1.1
  		}
  	}
  	session {
  		asn {
  			remote 65001
  		}
  	}
    timer { receive-hold-time 1; }
  }
}
EOF_CONF

option=file:path=test.conf
option=timeout:value=10s

# Config has validation error (receive-hold-time 1 is invalid per RFC 4271)
expect=errors:count=1

# Commit is blocked by validation errors
input=type:text=commit
input=enter
expect=status:contains=blocked

# Pipe filter shows validation details in viewport
input=type:text=show | errors
input=enter
expect=viewport:contains=receive-hold-time
