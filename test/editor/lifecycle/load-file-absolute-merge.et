# Test: Load file absolute merge - merges at root
# VALIDATES: Load merge keeps existing values the loaded file does not name
# VALIDATES: Load merge adds new content
# VALIDATES: A leaf both name takes the loaded value (owner decision 2026-10-10)
# PREVENTS: Merge overwriting all content, or dropping the loaded value

tmpfs=original.conf:terminator=EOF_ORIG
bgp {
  router-id 1.2.3.4;
  session {
  	asn {
  		local 65000
  	}
  }
}
EOF_ORIG

tmpfs=merge.conf:terminator=EOF_MERGE
bgp {
  router-id 5.6.7.8;
  peer peer1 {
  	connection {
  		remote {
  			ip 1.1.1.1
  		}
  	}
  	session {
  		asn {
  			remote 65001
  		}
  	}
  }
}
EOF_MERGE

option=file:path=original.conf
option=timeout:value=10s

# Initial content - verify exact values
expect=content:contains=1.2.3.4
expect=content:contains=65000

# Load and merge with new syntax
input=type:text=load file absolute merge merge.conf
input=enter

# A value the loaded file does not name is kept
expect=content:contains=65000

# Merged content should be added
expect=content:contains=peer peer1
expect=content:contains=remote 65001

# The loaded router-id wins over the existing one
expect=content:contains=5.6.7.8
expect=content:not-contains=1.2.3.4

expect=dirty:true
expect=error:none
