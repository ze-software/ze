# Test: Commit fails cleanly when daemon reload fails
# VALIDATES: Transactional commit leaves dirty state and reports reload failure
# PREVENTS: Accepting an un-applied candidate after daemon reload failure

tmpfs=test.conf:terminator=EOF_CONF
bgp {
  router-id 1.2.3.4;
  session {
  	asn {
  		local 65000
  	}
  }
  peer peer1 {
  	connection {
  		remote {
  			ip 1.1.1.1
  		}
  		local {
  			ip auto
  		}
  	}
  	session {
  		asn {
  			remote 65001
  		}
  	}
    timer { receive-hold-time 90; }
  }
}
EOF_CONF

option=file:path=test.conf
option=timeout:value=10s
option=reload:mode=fail

# Verify initial state
expect=errors:count=0
expect=dirty:false

# Make a change
input=type:text=set bgp router-id 5.6.7.8
input=enter
expect=dirty:true

# Commit should fail because the daemon did not accept the candidate
input=type:text=commit
input=enter
expect=status:contains=commit failed
expect=status:contains=daemon not reachable
expect=dirty:true
expect=error:none
