# Test: Show with compare filter (show | compare)
# VALIDATES: Pipe to compare shows diff of current section
# VALIDATES: Works like compare command but for specific section
# PREVENTS: Pipe compare broken
#
# Every leaf below must exist in ze-bgp-conf.yang. This test previously added
# "listen 0.0.0.0:179", which is not a BGP leaf: the parse failed, the editor fell
# back to raw-text mode (treeValid=false, editor_commands.go:66-78), and the schema
# tree diff never ran -- so the test passed without exercising compare at all.

tmpfs=test.conf:terminator=EOF_CONF
bgp {
  router-id 1.2.3.4;
  session {
  	asn {
  		local 65000
  	}
  }
  peer peer1 {
  	connection {
  		remote {
  			ip 1.1.1.1
  		}
  	}
  	session {
  		asn {
  			remote 65001
  		}
  	}
  }
}
EOF_CONF

tmpfs=modified.conf:terminator=EOF_MODIFIED
bgp {
  router-id 1.2.3.4;
  session {
  	asn {
  		local 65000
  	}
  }
  multipath {
  	maximum-paths 4
  }
  peer peer1 {
  	connection {
  		remote {
  			ip 1.1.1.1
  		}
  	}
  	session {
  		asn {
  			remote 65001
  		}
  	}
  }
}
EOF_MODIFIED

option=file:path=test.conf
option=timeout:value=10s

# Load modified config to create actual content change
input=type:text=load file absolute replace modified.conf
input=enter
expect=dirty:true

# Show with compare - should show the diff
input=type:text=show | compare
input=enter
expect=error:none

# Should show diff with added content
expect=viewport:contains=+
expect=viewport:contains=maximum-paths

# ...and only the added content: the untouched peer and asn are pruned away.
expect=viewport:not-contains=peer1
expect=viewport:not-contains=65001
