# Test: Session leaf-list insert/deactivate/activate work through the TUI
# VALIDATES: spec-session-commit-apply AC-5: insert/deactivate/activate on a
#            leaf-list work in session mode (previously refused with
#            "not supported in session mode") and persist through commit
#            with exact position and member state
# PREVENTS: session editors silently lacking ordered leaf-list operations

tmpfs=test.conf:terminator=EOF_CONF
bgp {
  session {
  	asn {
  		local 65000
  	}
  }
  router-id 1.2.3.4;
}
system {
  name-server [ 9.9.9.9 8.8.8.8 ];
}
EOF_CONF

option=file:path=test.conf
option=timeout:value=10s
option=session:user=thomas:origin=ssh

# Positional insert must be accepted in session mode
input=type:text=insert system name-server 1.1.1.1 first
input=enter
expect=error:none
expect=status:contains=Inserted 1.1.1.1

# Deactivate one member in place
input=type:text=deactivate system name-server 8.8.8.8
input=enter
expect=error:none
expect=status:contains=Deactivated 8.8.8.8

# Commit applies both ordered operations
input=type:text=commit
input=enter
expect=error:none
expect=dirty:false

# Inserted member first; the deactivated member serializes as a `nop` line.
# With any deactivated member the leaf-list serializes as individual
# `set`/`nop` lines (bracket form is used only when every member is active --
# learned 893 D-3). The inserted member is present as a `set` line and the
# deactivated member as a `nop` line.
expect=file:path=test.conf:contains=set system name-server 1.1.1.1
expect=file:path=test.conf:contains=set system name-server 9.9.9.9
expect=file:path=test.conf:contains=nop system name-server 8.8.8.8

# Activate restores the member in place. With all members active again the
# leaf-list collapses back to bracket form (learned 893 D-3), so no `nop`
# (or legacy `inactive`) line remains.
input=type:text=activate system name-server 8.8.8.8
input=enter
expect=error:none
input=type:text=commit
input=enter
expect=error:none
expect=file:path=test.conf:contains=name-server [ 1.1.1.1 9.9.9.9 8.8.8.8 ]
expect=file:path=test.conf:not-contains=nop system name-server
expect=file:path=test.conf:not-contains=inactive system name-server
