# Test: Session commit applies container deletion to config file
# VALIDATES: DeleteContainer write-through in session mode
# PREVENTS: delete container followed by commit silently dropping changes

tmpfs=test.conf:terminator=EOF_CONF
bgp {
  session {
  	asn {
  		local 65000
  	}
  }
  router-id 1.2.3.4;
  peer peer1 {
  	connection {
  		local {
  			ip 127.0.0.1
  		}
  		remote {
  			ip 1.1.1.1
  		}
  	}
  	session {
  		asn {
  			remote 65001
  		}
  	}
    timer { receive-hold-time 90; }
  }
}
EOF_CONF

option=file:path=test.conf
option=timeout:value=10s
option=session:user=thomas:origin=local

# Verify timer is present initially
input=type:text=show
input=enter
expect=viewport:contains=receive-hold-time

# Navigate into peer and delete timer container
input=type:text=delete bgp peer peer1 timer
input=enter
expect=dirty:true
expect=error:none

# Commit the deletion
input=type:text=commit
input=enter
expect=dirty:false
expect=error:none

# Verify timer removed from config file
expect=file:path=test.conf:not-contains=receive-hold-time

# Verify draft file cleaned up
expect=file:path=test.conf.draft:absent
