# Test: Mode switching between config and operational modes
# VALIDATES: AC-1 — run switches to operational mode
# VALIDATES: AC-2 — configure switches to config mode
# PREVENTS: Mode state corruption on switch

tmpfs=test.conf:terminator=EOF_CONF
bgp {
  router-id 1.2.3.4;
}
EOF_CONF

option=file:path=test.conf
option=timeout:value=10s

# Initially in config mode
expect=mode:is=config

# Switch to operational mode
input=type:text=run
input=enter
expect=mode:is=operational
expect=status:contains=no daemon connection

# Switch back to config mode
input=type:text=configure
input=enter
expect=mode:is=config
