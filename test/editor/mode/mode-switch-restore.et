# Test: Viewport content preserved across mode switches
# VALIDATES: AC-6 — config viewport restored after operational mode
# VALIDATES: AC-8 — config mode commands still work after mode switch
# PREVENTS: Lost config content on mode toggle
# NOTE: AC-7 (operational viewport restore) tested by TestModeScreenRestore unit test

tmpfs=test.conf:terminator=EOF_CONF
bgp {
  router-id 1.2.3.4;
}
EOF_CONF

option=file:path=test.conf
option=timeout:value=10s

# Set some config in config mode
input=type:text=set bgp session asn local 65000
input=enter
expect=dirty:true

# Show current config to populate viewport
input=type:text=show
input=enter
expect=content:contains=local 65000

# Switch to operational mode — config content should be saved
input=type:text=run
input=enter
expect=mode:is=operational

# Switch back to config — config should still be there
input=type:text=configure
input=enter
expect=mode:is=config
expect=dirty:true

# Verify config mode commands still work (AC-8)
input=type:text=show
input=enter
expect=content:contains=local 65000
