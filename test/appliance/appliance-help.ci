# Test: ze appliance -- help output
# spec-appliance-command-plugin AC-4/AC-9: ze appliance --help shows the action surface.

cmd=foreground:seq=1:exec=ze appliance --help
expect=exit:code=0
expect=stderr:contains=init
expect=stderr:contains=build
expect=stderr:contains=iso
expect=stderr:contains=push
expect=stderr:contains=list
expect=stderr:contains=show
expect=stderr:contains=export
expect=stderr:contains=import
