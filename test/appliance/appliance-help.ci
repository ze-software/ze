# Test: ze appliance -- help output
# spec-appliance-command-plugin AC-4/AC-9: ze appliance --help shows the action surface.

cmd=foreground:seq=1:exec=ze appliance --help
expect=exit:code=0
expect=stdout:contains=init
expect=stdout:contains=build
expect=stdout:contains=iso
expect=stdout:contains=push
expect=stdout:contains=list
expect=stdout:contains=show
expect=stdout:contains=export
expect=stdout:contains=import
