# Test: old ze install appliance path is gone
# spec-appliance-command-plugin AC-5: ze install no longer has an appliance subcommand.
#
# Help text goes to stderr (helpfmt Page.WriteErr), so the assertions name
# stderr. Each one reads the output of the cmd= line above it alone. The
# `ze appliance --help` check, which prints the word this file forbids, lives
# in appliance-help-not-deprecated.ci.

# ze install help lists only local and remote, not appliance
cmd=foreground:seq=1:exec=ze install --help:exit=0
expect=exit:code=0
expect=stderr:contains=local
expect=stderr:contains=remote
reject=stderr:contains=appliance
