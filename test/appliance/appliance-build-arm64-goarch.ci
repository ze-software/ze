# Test: an arm64 appliance build preserves the requested architecture: gok's go
# subprocess sees GOARCH=arm64. The cache-identity half lives in
# appliance-kernel-cache-arch-identity.ci, which runs on every host.
option=env:var=ze_appliance_ssh_password:value=secret
# The build reaches go only once the arm64 runtime kernel exists, and Ze builds
# every kernel on a host of its own arch, so this runs only on an arm64 CPU.
option=needs-arch:value=arm64
option=timeout:value=20s


tmpfs=build-config.json:terminator=EOF_JSON
{
  "identity": {"name": "ignored", "hostname": "lab"},
  "credentials": {"username": "admin", "admin-enabled": true},
  "ssh": {"host": "0.0.0.0", "port": "22"},
  "web": {"enabled": true, "host": "0.0.0.0", "port": "8080"},
  "tls": {"cert-name": "lab", "validity-years": 10},
  "managed": false,
  "device": {"address": "192.0.2.10", "update-port": 443},
  "image": {"arch": "arm64", "size-bytes": 2147483648},
  "qemu": {"ssh-port": 2222, "web-port": 28080, "gokrazy-port": 18080}
}
EOF_JSON

cmd=foreground:seq=1:exec=le test fixture appliance/appliance-build-arm64-goarch "$ZE_REPO_ROOT"
expect=exit:code=0
expect=stdout:contains=OK
