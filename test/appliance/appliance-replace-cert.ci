# Test: ze appliance replace-cert validates before it writes.
# spec-fixit-appliance-cert-replace-unvalidated AC-1/AC-4: a valid pair is
# stored, a mismatched pair is refused, and the refusal leaves the appliance's
# certificate and key byte-identical to what it was already serving.
#
# The material comes from two appliances that `ze appliance init` created, so
# the test needs no certificate tooling on the host: lab's certificate with
# other's key is a genuine mismatch of two real pairs.

# Underscore form: /bin/sh (dash) drops dotted names from the environment, so
# the dotted spelling never survives into sh-script children. ze's env lookup
# treats dots and underscores as equivalent (internal/core/env/env.go:40).
option=env:var=ze_appliance_ssh_password:value=secret

tmpfs=run.sh:terminator=EOF_SH
#!/bin/sh
set -eu
mkdir appliances
ze appliance --dir appliances init --config lab-config.json lab >/dev/null
ze appliance --dir appliances init --config other-config.json other >/dev/null

cp appliances/lab/secrets/tls/cert.pem good.pem
cp appliances/lab/secrets/tls/key.pem good.key
cp appliances/other/secrets/tls/key.pem other.key

# A valid pair replaces both files.
ze appliance --dir appliances replace-cert --cert good.pem --key good.key lab
cmp appliances/lab/secrets/tls/cert.pem good.pem
cmp appliances/lab/secrets/tls/key.pem good.key

# A mismatched pair is refused and nothing on disk moves.
cp appliances/lab/secrets/tls/cert.pem before.pem
cp appliances/lab/secrets/tls/key.pem before.key
if ze appliance --dir appliances replace-cert --cert good.pem --key other.key lab >/dev/null 2>refuse.err; then
    echo "replace-cert accepted a mismatched certificate and key" >&2
    exit 1
fi
cat refuse.err >&2
cmp appliances/lab/secrets/tls/cert.pem before.pem
cmp appliances/lab/secrets/tls/key.pem before.key

if ls appliances/lab/secrets/tls/ | grep -q '\.tmp$'; then
    echo "temp file left behind in the secrets directory" >&2
    exit 1
fi
echo "stored material unchanged after the refusal" >&2
EOF_SH

tmpfs=lab-config.json:terminator=EOF_LAB
{
  "identity": {"name": "lab", "hostname": "lab"},
  "credentials": {"username": "admin", "admin-enabled": true},
  "ssh": {"host": "0.0.0.0", "port": "22"},
  "web": {"enabled": true, "host": "0.0.0.0", "port": "8080"},
  "tls": {"cert-name": "lab", "validity-years": 10},
  "managed": false,
  "device": {"address": "192.0.2.10", "update-port": 443},
  "image": {"arch": "amd64", "size-bytes": 2147483648},
  "qemu": {"ssh-port": 2222, "web-port": 28080, "gokrazy-port": 18080}
}
EOF_LAB

tmpfs=other-config.json:terminator=EOF_OTHER
{
  "identity": {"name": "other", "hostname": "other"},
  "credentials": {"username": "admin", "admin-enabled": true},
  "ssh": {"host": "0.0.0.0", "port": "22"},
  "web": {"enabled": true, "host": "0.0.0.0", "port": "8080"},
  "tls": {"cert-name": "other", "validity-years": 10},
  "managed": false,
  "device": {"address": "192.0.2.11", "update-port": 443},
  "image": {"arch": "amd64", "size-bytes": 2147483648},
  "qemu": {"ssh-port": 2223, "web-port": 28081, "gokrazy-port": 18081}
}
EOF_OTHER

cmd=foreground:seq=1:exec=sh run.sh
expect=exit:code=0
expect=stdout:contains=certificate replaced for appliance "lab" (CA-signed)
expect=stderr:contains=are not a pair
expect=stderr:contains=stored material unchanged after the refusal
