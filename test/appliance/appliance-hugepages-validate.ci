# Test: ze appliance init --config rejects invalid image.hugepages/image.memory
# VALIDATES: applianceConfig.Validate -- image.hugepages { size, page-size }
#            byte-size strings and the 50%-of-memory cap, enforced at init (and
#            at build via the same Validate). AC-4, AC-7.
# PREVENTS: an out-of-range or oversized hugepage reservation being persisted
#           into an appliance config and later baked into a boot cmdline.
option=env:var=ze_appliance_ssh_password:value=secret

# A valid reservation: 1gb of 2mb pages, with declared memory.
tmpfs=good.json:terminator=EOF_GOOD
{
  "identity": {"name": "ignored", "hostname": "hp"},
  "credentials": {"username": "admin", "admin-enabled": true},
  "ssh": {"host": "0.0.0.0", "port": "22"},
  "web": {"enabled": true, "host": "0.0.0.0", "port": "8080"},
  "tls": {"cert-name": "hp", "validity-years": 10},
  "managed": false,
  "device": {"address": "192.0.2.10", "update-port": 443},
  "image": {"arch": "amd64", "size-bytes": 2147483648, "memory": "8gb", "hugepages": {"size": "1gb", "page-size": "2mb"}},
  "qemu": {"ssh-port": 2222, "web-port": 28080, "gokrazy-port": 18080}
}
EOF_GOOD

# An unsupported page-size is rejected.
tmpfs=badpage.json:terminator=EOF_PAGE
{
  "identity": {"name": "ignored", "hostname": "hp"},
  "credentials": {"username": "admin", "admin-enabled": true},
  "ssh": {"host": "0.0.0.0", "port": "22"},
  "web": {"enabled": true, "host": "0.0.0.0", "port": "8080"},
  "tls": {"cert-name": "hp", "validity-years": 10},
  "managed": false,
  "device": {"address": "192.0.2.10", "update-port": 443},
  "image": {"arch": "amd64", "size-bytes": 2147483648, "hugepages": {"size": "1gb", "page-size": "4mb"}},
  "qemu": {"ssh-port": 2222, "web-port": 28080, "gokrazy-port": 18080}
}
EOF_PAGE

# A size that is not a whole multiple of the page size is rejected.
tmpfs=badmultiple.json:terminator=EOF_MULT
{
  "identity": {"name": "ignored", "hostname": "hp"},
  "credentials": {"username": "admin", "admin-enabled": true},
  "ssh": {"host": "0.0.0.0", "port": "22"},
  "web": {"enabled": true, "host": "0.0.0.0", "port": "8080"},
  "tls": {"cert-name": "hp", "validity-years": 10},
  "managed": false,
  "device": {"address": "192.0.2.10", "update-port": 443},
  "image": {"arch": "amd64", "size-bytes": 2147483648, "hugepages": {"size": "3mb", "page-size": "2mb"}},
  "qemu": {"ssh-port": 2222, "web-port": 28080, "gokrazy-port": 18080}
}
EOF_MULT

# A reservation over 50% of image.memory is rejected.
tmpfs=overmem.json:terminator=EOF_OVER
{
  "identity": {"name": "ignored", "hostname": "hp"},
  "credentials": {"username": "admin", "admin-enabled": true},
  "ssh": {"host": "0.0.0.0", "port": "22"},
  "web": {"enabled": true, "host": "0.0.0.0", "port": "8080"},
  "tls": {"cert-name": "hp", "validity-years": 10},
  "managed": false,
  "device": {"address": "192.0.2.10", "update-port": 443},
  "image": {"arch": "amd64", "size-bytes": 2147483648, "memory": "8gb", "hugepages": {"size": "6gb", "page-size": "2mb"}},
  "qemu": {"ssh-port": 2222, "web-port": 28080, "gokrazy-port": 18080}
}
EOF_OVER

cmd=foreground:seq=1:exec=ze appliance --dir appliances init --config good.json goodapp:exit=0
expect=exit:code=0

cmd=foreground:seq=2:exec=ze appliance --dir appliances init --config badpage.json badpage:exit=1
expect=exit:code=1
expect=stderr:contains=2mb or 1gb

cmd=foreground:seq=3:exec=ze appliance --dir appliances init --config badmultiple.json badmult:exit=1
expect=exit:code=1
expect=stderr:contains=whole multiple

cmd=foreground:seq=4:exec=ze appliance --dir appliances init --config overmem.json overmem:exit=1
expect=exit:code=1
expect=stderr:contains=50%
