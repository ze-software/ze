# Test: ze appliance iso builds arm64 UEFI media.
# Covers the arm64 user path with default kernel/initrd lookup and verifies the
# generated staging tree carries arm64-specific EFI and kernel-console settings.

# The underscore spelling is equivalent to the dotted appliance environment key.
option=env:var=ze_appliance_ssh_password:value=secret


tmpfs=iso-config.json:terminator=EOF_JSON
{
  "identity": {"name": "ignored", "hostname": "lab"},
  "credentials": {"username": "admin", "admin-enabled": true},
  "ssh": {"host": "0.0.0.0", "port": "22"},
  "web": {"enabled": true, "host": "0.0.0.0", "port": "8080"},
  "tls": {"cert-name": "lab", "validity-years": 10},
  "managed": false,
  "device": {"address": "192.0.2.10", "update-port": 443},
  "image": {"arch": "arm64", "size-bytes": 2147483648},
  "qemu": {"ssh-port": 2222, "web-port": 28080, "gokrazy-port": 18080}
}
EOF_JSON

cmd=foreground:seq=1:exec=ze-test fixture appliance/appliance-iso-arm64
expect=exit:code=0
expect=stdout:contains=OK
