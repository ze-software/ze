# Test: ze appliance iso builds arm64 UEFI media.
# Covers the arm64 user path with default kernel/initrd lookup and verifies the
# generated staging tree carries arm64-specific EFI and kernel-console settings.

option=env:var=ze.appliance.ssh.password:value=secret

tmpfs=run.sh:terminator=EOF_SH
#!/bin/sh
set -eu
mkdir -p appliances tools/installer-kernel/build tools/installer-initrd/build
printf 'kernel-arm64\n' > tools/installer-kernel/build/Image
printf 'initrd-arm64\n' > tools/installer-initrd/build/initrd.img.gz
cat > grub-mkstandalone <<'EOF_GRUB'
#!/bin/sh
set -eu
target=""
out=""
while [ $# -gt 0 ]; do
  case "$1" in
    -O) target="$2"; shift 2 ;;
    -o) out="$2"; shift 2 ;;
    *) shift ;;
  esac
done
[ "$target" = "arm64-efi" ]
printf '%s\n' "$target" > grub.target
printf 'efi-arm64\n' > "$out"
EOF_GRUB
chmod +x grub-mkstandalone
cat > xorriso <<'EOF_XORRISO'
#!/bin/sh
set -eu
out=""
image=""
stage=""
while [ $# -gt 0 ]; do
  case "$1" in
    -as) shift 2 ;;
    -R|-J|-eltorito-alt-boot|-no-emul-boot) shift ;;
    -o) out="$2"; shift 2 ;;
    -e) image="$2"; shift 2 ;;
    *) stage="$1"; shift ;;
  esac
done
[ -f "$stage/$image" ]
printf 'iso-arm64\n' > "$out"
EOF_XORRISO
chmod +x xorriso
export PATH="$PWD:$PATH"
ze appliance --dir appliances init --config iso-config.json lab >/dev/null 2>&1
printf 'image-bytes\n' > appliances/lab/ze-20260101-000000.img
python3 - <<'PY'
from pathlib import Path
import hashlib
p = Path('appliances/lab/ze-20260101-000000.img')
p.with_suffix(p.suffix + '.sha256').write_text(hashlib.sha256(p.read_bytes()).hexdigest() + '  ' + p.name + '\n')
PY
ze appliance --dir appliances iso --keep-staging lab >/dev/null
set -- appliances/lab/.iso-staging-*
stage="$1"
[ -d "$stage" ]
[ -f "$stage/EFI/BOOT/BOOTAA64.EFI" ]
[ -f "$stage/EFI/BOOT/efiboot.img" ]
grep -q 'console=tty0 console=ttyAMA0' "$stage/boot/grub/grub.cfg"
grep -q 'search --no-floppy --file /ze-install/media-id --set=root' "$stage/boot/grub/grub.cfg"
[ -f "$stage/ze-install/images/ze-20260101-000000.img.gz" ]
grep -q 'ze.image=ze-20260101-000000.img.gz' "$stage/boot/grub/grub.cfg"
[ "$(cat grub.target)" = "arm64-efi" ]
echo OK
EOF_SH

tmpfs=iso-config.json:terminator=EOF_JSON
{
  "identity": {"name": "ignored", "hostname": "lab"},
  "credentials": {"username": "admin", "admin-enabled": true},
  "ssh": {"host": "0.0.0.0", "port": "22"},
  "web": {"enabled": true, "host": "0.0.0.0", "port": "8080"},
  "tls": {"cert-name": "lab", "validity-years": 10},
  "managed": false,
  "device": {"address": "192.0.2.10", "update-port": 443},
  "image": {"arch": "arm64", "size-bytes": 2147483648},
  "qemu": {"ssh-port": 2222, "web-port": 28080, "gokrazy-port": 18080}
}
EOF_JSON

cmd=foreground:seq=1:exec=sh run.sh
expect=exit:code=0
expect=stdout:contains=OK
