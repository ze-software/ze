# Test: ze appliance push rejects image symlink escape.
# spec-appliance-command-plugin: shared appliance image resolution protects push entrypoints too.
#
# Creates a real appliance directory with generated secrets, then places the only
# candidate image as a symlink to a host file outside the appliance directory.
# The push command must fail before network/TLS work and report the escape.

# The native fixture creates the appliance and escaping symlink directly.
option=env:var=ze_appliance_ssh_password:value=secret


tmpfs=push-config.json:terminator=EOF_JSON
{
  "identity": {"name": "ignored", "hostname": "lab"},
  "credentials": {"username": "admin", "admin-enabled": true},
  "ssh": {"host": "0.0.0.0", "port": "22"},
  "web": {"enabled": true, "host": "0.0.0.0", "port": "8080"},
  "tls": {"cert-name": "lab", "validity-years": 10},
  "managed": false,
  "device": {"address": "192.0.2.10", "update-port": 443},
  "image": {"arch": "amd64", "size-bytes": 2147483648},
  "qemu": {"ssh-port": 2222, "web-port": 28080, "gokrazy-port": 18080}
}
EOF_JSON

cmd=foreground:seq=1:exec=ze-test fixture appliance/appliance-push-image-escape
expect=exit:code=0
expect=stderr:contains=error: image path ze-20260101-000000.img escapes appliance directory
