# Smoke test: 4 peers with moderate chaos, verify no validation failures
# Longer run to exercise reconnect and withdrawal paths
# Uses --port 0 because 4 peers bind 4 consecutive ports, exceeding TestPortSpan (3).

cmd=foreground:seq=1:exec=le chaos run --seed 7777 --peers 4 --duration 20s --chaos-rate 0.3 --quiet --port 0:timeout=35s
expect=exit:code=0
