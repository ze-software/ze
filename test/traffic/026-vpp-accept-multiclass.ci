# Test: VPP backend ACCEPTS a multi-class HTB config at verify time when every
#        class carries a steering filter (per-class shaping via classify).
# VALIDATES: spec-followup-vpp-traffic AC-5 -- HTB with 2+ classes is accepted
#            under backend vpp iff EVERY class carries a protocol/dscp filter, so
#            classify steers each class's traffic to its own policer. The config
#            passes verify and reaches backend.Apply, which -- with no VPP in the
#            .ci environment -- logs "vpp not connected". That is the acceptance
#            signal (a rejected config logs "not supported"/"requires every class
#            to carry a steering filter" and never reaches Apply).
# PREVENTS: regression to the old blanket multi-class REJECTION. Real-VPP
#           per-class steering (one table per family, N sessions to N policers)
#           is proven by fakeOps unit tests (TestApplyMultiClassSteering) +
#           run_traffic_multiclass_evidence; apply-tier .ci is blocked on A-6.
#
# Scope note: waits ~6s for the 5s WaitConnected timeout + margin.

tmpfs=wait.py:mode=755:terminator=EOF_PY
#!/usr/bin/env python3
"""Hold open for Apply's 5s WaitConnected -> "vpp not connected", which only
fires if the multi-class config PASSED verify."""
import time

# blind hold: the internal 5s vpp WaitConnected timeout IS the behavior under test; hold past it for the asserted log, no earlier signal to poll
time.sleep(6.0)
EOF_PY

stdin=ze-bgp:terminator=EOF_CONF
bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}

traffic {
	control {
		backend vpp
		interface eth0 {
			qdisc {
				type htb
				class web {
					rate 10mbit
					ceil 100mbit
					match protocol {
						value 6
					}
				}
				class dns {
					rate 1mbit
					ceil 100mbit
					match protocol {
						value 17
					}
				}
			}
		}
	}
}
EOF_CONF

option=env:var=ze.log.traffic:value=info

cmd=background:seq=1:exec=ze -:stdin=ze-bgp
cmd=foreground:seq=2:exec=python3 wait.py:timeout=15s
expect=exit:code=0
expect=stderr:contains=vpp not connected
