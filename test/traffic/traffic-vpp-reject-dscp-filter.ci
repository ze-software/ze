# Test: VPP backend REJECTS an out-of-range dscp filter value at verify time.
# VALIDATES: spec-followup-vpp-traffic AC-2/AC-6 boundary -- with dscp now
#            ACCEPTED as police-by-dscp (see traffic-vpp-accept-dscp-filter.ci), a
#            dscp VALUE above the 6-bit range (0-63) is still rejected at verify
#            with "out of range". The classify TOS/TC mask covers exactly the
#            6-bit DSCP field, so 64 has no representation.
# PREVENTS: regression where accepting dscp filters also accepts nonsensical
#           out-of-range values that would silently truncate on the wire.
#
# Replaced coverage note: this file previously asserted a blanket dscp
# REJECTION. Per the 2026-07-10 USER decision (police-by-dscp), dscp is now
# accepted; the acceptance is pinned by traffic-vpp-accept-dscp-filter.ci and the
# fakeOps unit tests, and this file now pins the value bound instead.
#
# Scope note: the Verifier runs at daemon config-verify time; this boots ze with
# the bad config and asserts the rejection log line in stderr.

tmpfs=wait.py:mode=755:terminator=EOF_PY
#!/usr/bin/env python3
"""Sleep long enough for ze to read config, attempt verify, and log the
rejection, then exit."""
import time

# blind hold: a backgrounded ze gets no ZE_READY_FILE marker to poll; hold until OnConfigure emits the asserted log line, left un-converted (no readiness signal for a background daemon)
time.sleep(2.5)
EOF_PY

stdin=ze-bgp:terminator=EOF_CONF
bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}

traffic {
	control {
		backend vpp
		interface eth0 {
			qdisc {
				type htb
				default-class default
				class control {
					rate 10mbit
					ceil 100mbit
					priority 0
					match dscp {
						value 64
					}
				}
				class default {
					rate 90mbit
					ceil 100mbit
					priority 1
					match protocol {
						value 6
					}
				}
			}
		}
	}
}
EOF_CONF

option=env:var=ze.log.traffic:value=info

cmd=background:seq=1:exec=ze -:stdin=ze-bgp
cmd=foreground:seq=2:exec=python3 wait.py:timeout=10s
expect=exit:code=0
expect=stderr:contains=out of range
