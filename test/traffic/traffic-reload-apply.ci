# Test: Traffic plugin reactor re-applies on SIGHUP reload.
# VALIDATES: spec-fw-9 AC-2 -- OnConfigVerify accepts a changed config and
#            OnConfigApply calls backend.Apply with the new desired state.
#            The reactor emits "traffic-control config reloaded" when the
#            journal records the apply successfully.
# PREVENTS: regression where a SIGHUP that mutates the traffic-control block
#           leaves the reactor silent (verify/apply/journal never wired).
#
# Scope note: this test asserts the reactor's log line and runs unprivileged in
# every environment. The real tc kernel-state check on reload (`tc qdisc show`
# before/after) is now covered by the needs-linux companion
# traffic-reload-qdisc-tc.ci, which runs as root in the QEMU VM via
# `make ze-qemu-needs-linux-test` (spec followup-test-infra AC-2). The reload
# semantic under test here is "remove the traffic-control section": a deletion
# the reactor handles by applying an empty desired state.

tmpfs=reload.py:mode=755:terminator=EOF_PY
#!/usr/bin/env python3
"""Wait for ze to be ready, rewrite the config to remove traffic-control,
send SIGHUP, then SIGTERM for a clean exit."""
import os
import shutil
import signal
import sys
import time

for _ in range(200):
    if os.path.exists("daemon.pid") and os.path.exists("daemon.ready"):
        break
    # poll interval; the loop above breaks once daemon.pid and daemon.ready exist, bounded wait not a blind sleep
    time.sleep(0.05)
else:
    print("ERROR: daemon.pid or daemon.ready never appeared", file=sys.stderr)
    sys.exit(1)

with open("daemon.pid") as f:
    pid = int(f.read().strip())

# blind settle: let the initial apply finish before the reload; this standalone driver has no post-apply signal to poll
time.sleep(0.3)
shutil.copy("config2.conf", "ze-bgp.conf")
os.kill(pid, signal.SIGHUP)

# blind hold: SIGHUP reload exposes no completion signal to this standalone driver; hold for the reactor to re-apply and emit the asserted log, then SIGTERM
time.sleep(2.0)
os.kill(pid, signal.SIGTERM)
EOF_PY

stdin=ze-bgp:terminator=EOF_CONF
bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}

traffic {
	control {
		backend tc
	}
}
EOF_CONF

tmpfs=config2.conf:terminator=EOF_CONF2
bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}

traffic {
	control {
	}
}
EOF_CONF2

option=env:var=ze.log.traffic:value=debug

cmd=background:seq=1:exec=python3 reload.py
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=15s
expect=exit:code=0
expect=stderr:contains=traffic-control config reloaded
