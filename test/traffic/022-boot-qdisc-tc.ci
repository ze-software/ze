# Test: the tc backend programs the configured HTB qdisc into the Linux kernel.
# VALIDATES: spec followup-test-infra AC-2 -- the CAP_NET_ADMIN kernel-state
#            check that 001/002 deferred: after boot, `tc qdisc show dev eth0`
#            reflects the HTB qdisc the traffic-control config asked for, proving
#            the trafficnetlink backend's netlink Apply reached the kernel (not
#            just that the "applied" log line was emitted).
# PREVENTS: a regression where the config parses and logs "applied" but the
#           qdisc is never actually installed in the kernel.
#
# Gated option=needs-linux: SKIPs on non-Linux (macOS dev box; GOOS check) and
# runs as root inside the QEMU VM via `make ze-qemu-needs-linux-test`, where
# eth0 exists and CAP_NET_ADMIN is available.
option=needs-linux

tmpfs=wait.py:mode=755:terminator=EOF_PY
#!/usr/bin/env python3
"""Hold the test open long enough for ze (background) to reach OnConfigure and
program the qdisc before we shell out to `tc`."""
import time

time.sleep(2.5)
EOF_PY

stdin=ze-bgp:terminator=EOF_CONF
bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}

traffic {
	control {
		backend tc
		interface eth0 {
			qdisc {
				type htb
				default-class default
				class control {
					rate 10mbit
					ceil 100mbit
					priority 0
					match dscp {
						value cs6
					}
				}
				class default {
					rate 90mbit
					ceil 100mbit
					priority 1
				}
			}
		}
	}
}
EOF_CONF

option=env:var=ze.log.traffic:value=info

cmd=background:seq=1:exec=ze -:stdin=ze-bgp
cmd=foreground:seq=2:exec=python3 wait.py:timeout=10s
cmd=foreground:seq=3:exec=tc qdisc show dev eth0
expect=exit:code=0
expect=stderr:contains=traffic-control config applied
expect=stdout:contains=htb
