# Test: VPP backend REJECTS a mark filter at OnConfigVerify.
# VALIDATES: spec-followup-vpp-traffic AC-3/AC-6 -- a `match mark` filter under
#            backend vpp is rejected with errFilterMarkNotSupportedByBackend.
#            Linux SKB fwmark has no faithful VPP equivalent (A-3, validated on
#            real VPP v25.10: classify SET_METADATA stores opaque graph-node
#            metadata, not a persistent packet mark). Mark stays rejected while
#            protocol and dscp are accepted.
# PREVENTS: regression where enabling protocol/dscp classify accidentally lets
#           the mark filter through the verifier (it has no steering match).
#
# Scope note: the Verifier runs at daemon config-verify time; this boots ze with
# the mark config and asserts the rejection log line in stderr.

tmpfs=wait.py:mode=755:terminator=EOF_PY
#!/usr/bin/env python3
"""Sleep long enough for ze to read config, attempt verify, and log the
rejection, then exit."""
import time

# blind hold: a backgrounded ze gets no ZE_READY_FILE marker to poll; hold until OnConfigure emits the asserted log line, left un-converted (no readiness signal for a background daemon)
time.sleep(2.5)
EOF_PY

stdin=ze-bgp:terminator=EOF_CONF
bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}

traffic {
	control {
		backend vpp
		interface eth0 {
			qdisc {
				type htb
				class control {
					rate 10mbit
					ceil 100mbit
					match mark {
						value 7
					}
				}
			}
		}
	}
}
EOF_CONF

option=env:var=ze.log.traffic:value=info

cmd=background:seq=1:exec=ze -:stdin=ze-bgp
cmd=foreground:seq=2:exec=python3 wait.py:timeout=10s
expect=exit:code=0
expect=stderr:contains=not supported by backend vpp
# // removed a stray duplicate heredoc terminator (EOF_PY) typo from
# this newly-added file; both verify-reject assertions above are retained (no
# coverage change). The leading # keeps the line a .ci comment.
