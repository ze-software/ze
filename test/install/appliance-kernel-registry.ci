# Test: ze appliance kernel resolves open profiles and enforces required Kconfig symbols in Go.
#
# The fixture profiles live in a scratch repository root under the harness work
# directory, never in the tracked tree. registeredKernelProfiles in
# internal/appliance/kernelreg.go scans a real directory. A fixture pair written
# into tools/installer-kernel/ is therefore a resolvable kernel profile for as
# long as it sits on disk.
#
# Both resolvers follow a root this test controls. kernelTargetFor in
# internal/appliance/cmd_kernel.go gives the installer target the relative
# "tools/installer-kernel", so the Go side follows the process working
# directory. repo_root in tools/kernel-builder/run.py walks up from run.py to
# the first directory that holds go.mod.
#
# This test writes nothing into the tracked tree, so it carries no cleanup trap.
# Everything it creates goes under the harness work directory, which sits below
# the gitignored tmp/ (DefaultScratchRoot in
# internal/test/sessionpath/sessionpath.go). A killed run therefore leaves no
# profile behind for registeredKernelProfiles to find.

option=timeout:value=20s

tmpfs=run.sh:terminator=EOF_SH
#!/bin/sh
set -eu
work=$PWD
repo=${ZE_REPO_ROOT:-$(CDPATH= cd -- "$(dirname -- "$(command -v ze)")/.." && pwd)}

# The scratch root holds go.mod for repo_root, the profile directory both
# resolvers read, and the builder directory run.py imports build.py from.
# Copy the builder directory, never link it: run.py takes
# Path(__file__).resolve(), and a symlink resolves back into the real
# repository. kernel.version keeps the root a faithful minimal repository,
# although defaultKernelBuild always passes --version.
root=$work/root
mkdir -p "$root/tools" "$root/internal/appliance"
: > "$root/go.mod"
cp -R "$repo/tools/installer-kernel" "$root/tools/installer-kernel"
cp -R "$repo/tools/kernel-builder" "$root/tools/kernel-builder"
cp "$repo/internal/appliance/kernel.version" "$root/internal/appliance/kernel.version"
cd "$root"

mkdir -p "$work/fakebin" "$work/cache" "$work/out"

cat > tools/installer-kernel/fixture.config <<'EOF_CONFIG'
# ze-base: qemu
CONFIG_FIXTURE=y
EOF_CONFIG
printf 'CONFIG_FIXTURE\n' > tools/installer-kernel/fixture.require
printf 'CONFIG_MISSING=y\n' > tools/installer-kernel/missing.config

cat > "$work/fakebin/docker" <<'EOF_DOCKER'
#!/bin/sh
set -eu
printf '%s\n' "$*" >> "$ZE_DOCKER_LOG"
if [ "$1" != run ]; then exit 0; fi
# Only a run carrying build.py is a BUILD. run.py issues a second
# `docker run ... chown -R <uid>:<gid> /out` to hand the build's output back
# to the invoking user, and that run mounts :/out as well. Synthesizing build
# output for it rewrites what the build produced.
case " $* " in *" /builder/build.py "*) ;; *) exit 0 ;; esac
prev=
for arg in "$@"; do
	if [ "$prev" = -v ]; then
		case "$arg" in
			*:/out) out=${arg%:/out} ;;
		esac
	fi
	prev=$arg
done
mkdir -p "$out"
printf 'registry-kernel\n' > "$out/Image"
case "${ZE_FAKE_MODE:-ok}" in
	missing-qemu)
		cat > "$out/config" <<'EOF_CONFIG'
CONFIG_IP_PNP_DHCP=y
CONFIG_EXT4_FS=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_VIRTIO_NET=y
EOF_CONFIG
		;;
	missing-floor)
		cat > "$out/config" <<'EOF_CONFIG'
CONFIG_EXT4_FS=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_BLK=y
EOF_CONFIG
		;;
	*)
		cat > "$out/config" <<'EOF_CONFIG'
CONFIG_IP_PNP_DHCP=y
CONFIG_EXT4_FS=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_BLK=y
CONFIG_FIXTURE=y
EOF_CONFIG
		;;
esac
EOF_DOCKER
chmod +x "$work/fakebin/docker"

PATH="$work/fakebin:$PATH" XDG_CACHE_HOME="$work/cache" ZE_KERNEL_TEST_OUTPUT_DIR="$work/out" ZE_DOCKER_LOG="$work/docker.log" \
	ze appliance kernel --arch amd64 --profile fixture --builder docker >"$work/ok.out" 2>"$work/ok.err"
grep -q 'kernel ready:' "$work/ok.out"
case "$(cat "$work/docker.log")" in
	*'--fragment /src/kernel.config --fragment /src/qemu.config --fragment /src/fixture.config'*) : ;;
	*) cat "$work/docker.log" >&2; exit 1 ;;
esac

if PATH="$work/fakebin:$PATH" XDG_CACHE_HOME="$work/cache" ZE_KERNEL_TEST_OUTPUT_DIR="$work/out" ZE_DOCKER_LOG="$work/docker.log" \
	ze appliance kernel --arch amd64 --profile missing --builder docker >"$work/missing.out" 2>&1; then
	echo 'expected missing manifest failure' >&2; exit 1
fi
grep -q 'no require manifest' "$work/missing.out"

if PATH="$work/fakebin:$PATH" XDG_CACHE_HOME="$work/cache" ZE_KERNEL_TEST_OUTPUT_DIR="$work/out" ZE_DOCKER_LOG="$work/docker.log" ZE_FAKE_MODE=missing-qemu \
	ze appliance kernel --arch amd64 --profile qemu --builder docker >"$work/qemu.out" 2>&1; then
	echo 'expected qemu requirement failure' >&2; exit 1
fi
grep -q 'CONFIG_VIRTIO_BLK' "$work/qemu.out"

if PATH="$work/fakebin:$PATH" XDG_CACHE_HOME="$work/cache" ZE_KERNEL_TEST_OUTPUT_DIR="$work/out" ZE_DOCKER_LOG="$work/docker.log" ZE_FAKE_MODE=missing-floor \
	ze appliance kernel --arch amd64 --profile qemu --builder docker >"$work/floor.out" 2>&1; then
	echo 'expected universal requirement failure' >&2; exit 1
fi
grep -q 'CONFIG_IP_PNP_DHCP' "$work/floor.out"

echo OK
EOF_SH

cmd=foreground:seq=1:exec=sh run.sh
expect=exit:code=0
expect=stdout:contains=OK
