# Test (AC-6/AC-8): ze appliance kernel --target runtime resolves the runtime
# registry (gokrazy/kernel), drives run.py, enforces the runtime floor, and caches
# the runtime TREE (vmlinuz + lib/modules) under a target=runtime cache dir,
# distinct from the installer single-file Image cache. Real python3 + run.py; only
# docker is faked.

option=timeout:value=30s

tmpfs=run.sh:terminator=EOF_SH
#!/bin/sh
set -eu

work=$PWD
ze_bin=$(command -v ze)
repo=${ZE_REPO_ROOT:-$(CDPATH= cd -- "$(dirname -- "$ze_bin")/.." && pwd)}
cd "$repo"

# // test-relax: the previous tmp/kernel/build save/restore is replaced by
# ZE_KERNEL_TEST_OUTPUT_DIR, which redirects the runtime build to a per-test dir
# ($work/out). The old save/restore not only became unnecessary but was harmful:
# it moved/removed the shared tmp/kernel/build that a parallel make-ze-kernel
# (ze-kernel-overlay) test relies on. This test now touches no shared global path.
mkdir -p "$work/fakebin" "$work/cache"

cat > "$work/fakebin/docker" <<'EOF_DOCKER'
#!/bin/sh
set -eu
if [ "$1" = run ]; then
	prev=
	for arg in "$@"; do
		if [ "$prev" = -v ]; then
			case "$arg" in
				*:/out)
					out=${arg%:/out}
					mkdir -p "$out/lib/modules/7.1.1-ze"
					printf 'runtime-vmlinuz\n' > "$out/vmlinuz"
					printf '' > "$out/lib/modules/7.1.1-ze/modules.dep"
					# This fake kernel config must satisfy enforceKernelRequirements:
					# every symbol in gokrazy/kernel/runtime.require and the runtime
					# floor (internal/appliance/kernelreq.go runtimeKernelRequirements)
					# must appear here as =y. Adding a symbol to runtime.require (e.g.
					# CONFIG_HUGETLBFS for VPP) requires adding it here too, or this
					# test fails with "<SYMBOL> did not resolve to =y".
					cat > "$out/config" <<'EOF_CONFIG'
CONFIG_IP_PNP_DHCP=y
CONFIG_EXT4_FS=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_MODULES=y
CONFIG_PPP=y
CONFIG_PPPOE=y
CONFIG_L2TP=y
CONFIG_PPPOL2TP=y
CONFIG_L2TP_V3=y
CONFIG_VETH=y
CONFIG_MACVLAN=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_VIRTIO_NET=y
CONFIG_HUGETLBFS=y
EOF_CONFIG
					;;
			esac
		fi
		prev=$arg
	done
fi
EOF_DOCKER
chmod +x "$work/fakebin/docker"

PATH="$work/fakebin:$PATH" \
XDG_CACHE_HOME="$work/cache" \
ZE_KERNEL_TEST_OUTPUT_DIR="$work/out" \
"$ze_bin" appliance kernel --target runtime --arch amd64 --builder docker >"$work/stdout" 2>"$work/stderr"

grep -q 'via run.py' "$work/stdout"
grep -q 'kernel ready:' "$work/stdout"
grep -q 'target=runtime' "$work/stdout"
grep -q 'profile=runtime' "$work/stdout"

# The cached runtime artifact is a DIRECTORY tree under the runtime cache dir.
cache_dir=$(find "$work/cache" -path '*/runtime-kernel/*/vmlinuz' -print | head -n 1)
[ -n "$cache_dir" ] || { echo "no runtime-kernel cache tree produced" >&2; ls -R "$work/cache" >&2; exit 1; }
cdir=$(dirname "$cache_dir")
[ "$(cat "$cdir/vmlinuz")" = 'runtime-vmlinuz' ]
[ -d "$cdir/lib/modules" ] || { echo "runtime cache tree missing lib/modules" >&2; exit 1; }

echo OK
EOF_SH

cmd=foreground:seq=1:exec=sh run.sh
expect=exit:code=0
expect=stdout:contains=OK
