# Test (AC-6/AC-8): ze appliance kernel --target runtime resolves the runtime
# registry (gokrazy/kernel), drives run.py, enforces the runtime floor, and caches
# the runtime TREE (vmlinuz + lib/modules) under a target=runtime cache dir,
# distinct from the installer single-file Image cache. Real python3 + run.py; only
# docker is faked.

option=timeout:value=30s

tmpfs=run.sh:terminator=EOF_SH
#!/bin/sh
set -eu

work=$PWD
ze_bin=$(command -v ze)
repo=${ZE_REPO_ROOT:-$(CDPATH= cd -- "$(dirname -- "$ze_bin")/.." && pwd)}
cd "$repo"

# // test-relax: the previous tmp/kernel/build save/restore is replaced by
# ZE_KERNEL_TEST_OUTPUT_DIR, which redirects the runtime build to a per-test dir
# ($work/out). The old save/restore not only became unnecessary but was harmful:
# it moved/removed the shared tmp/kernel/build that a parallel make-ze-kernel
# (ze-kernel-overlay) test relies on. This test now touches no shared global path.
mkdir -p "$work/fakebin" "$work/cache"

# ze writes its own diagnostics to files so the greps below can read stdout.
# Print both when the script fails, or the runner reports only "Client produced
# no output" and the reader has to reproduce the run to learn the reason.
dump_ze_output() {
	rc=$?
	if [ "$rc" -ne 0 ]; then
		echo "--- ze stdout ---" >&2
		[ -f "$work/stdout" ] && cat "$work/stdout" >&2
		echo "--- ze stderr ---" >&2
		[ -f "$work/stderr" ] && cat "$work/stderr" >&2
	fi
	exit "$rc"
}
trap dump_ze_output EXIT

# The fake resolved .config is DERIVED from the authoritative sources, never
# hand-listed. enforceKernelRequirements (internal/appliance/kernelreq.go) reads
# the require manifests of the runtime profile plus the Go floor
# runtimeKernelRequirements, so a copy of that set in this file is a duplicate
# that goes stale the day a symbol is added. It did: commit b38706464 pinned the
# netfilter surface in gokrazy/kernel/kernel.require and this test went red with
# "CONFIG_NF_TABLES did not resolve to =y" and no output.
#
# The union below covers both readers. Every *.require symbol is what the check
# enforces; every *.config "=y" request covers the Go floor, which must be
# requested in a fragment for any real build to satisfy it either.
#
# The shared includes are collected with find, not a glob: a glob that matches
# nothing expands to itself, and cat would then fail on a literal path under
# set -e for no reason a reader could see.
kernel_config=$work/fake-kernel-config
cat gokrazy/kernel/kernel.require gokrazy/kernel/runtime.require \
	gokrazy/kernel/kernel.config gokrazy/kernel/runtime.config \
	$(find tools/kernel-builder/common -name '*.require') |
	sed 's/#.*//' |
	tr -d ' \t' |
	sed 's/=.*//' |
	grep '^CONFIG_' |
	sort -u |
	sed 's/$/=y/' > "$kernel_config"

cat > "$work/fakebin/docker" <<'EOF_DOCKER'
#!/bin/sh
set -eu
if [ "$1" = run ]; then
	prev=
	for arg in "$@"; do
		if [ "$prev" = -v ]; then
			case "$arg" in
				*:/out)
					out=${arg%:/out}
					mkdir -p "$out/lib/modules/7.1.1-ze"
					printf 'runtime-vmlinuz\n' > "$out/vmlinuz"
					printf '' > "$out/lib/modules/7.1.1-ze/modules.dep"
					# test-relax: the 16 hand-listed CONFIG_ lines here are
					# REPLACED, not dropped. They were a copy of the require
					# manifests, and a copy goes stale: commit b38706464 pinned
					# the netfilter surface in gokrazy/kernel/kernel.require and
					# this test went red on CONFIG_NF_TABLES. run.sh now derives
					# the same file from those manifests plus the config
					# fragments, which is a SUPERSET of the old list (all 16
					# appear in it) and cannot drift again.
					cp "$ZE_FAKE_KERNEL_CONFIG" "$out/config"
					;;
			esac
		fi
		prev=$arg
	done
fi
EOF_DOCKER
chmod +x "$work/fakebin/docker"

PATH="$work/fakebin:$PATH" \
XDG_CACHE_HOME="$work/cache" \
ZE_KERNEL_TEST_OUTPUT_DIR="$work/out" \
ZE_FAKE_KERNEL_CONFIG="$kernel_config" \
"$ze_bin" appliance kernel --target runtime --arch amd64 --builder docker >"$work/stdout" 2>"$work/stderr"

grep -q 'via run.py' "$work/stdout"
grep -q 'kernel ready:' "$work/stdout"
grep -q 'target=runtime' "$work/stdout"
grep -q 'profile=runtime' "$work/stdout"

# The cached runtime artifact is a DIRECTORY tree under the runtime cache dir.
cache_dir=$(find "$work/cache" -path '*/runtime-kernel/*/vmlinuz' -print | head -n 1)
[ -n "$cache_dir" ] || { echo "no runtime-kernel cache tree produced" >&2; ls -R "$work/cache" >&2; exit 1; }
cdir=$(dirname "$cache_dir")
[ "$(cat "$cdir/vmlinuz")" = 'runtime-vmlinuz' ]
[ -d "$cdir/lib/modules" ] || { echo "runtime cache tree missing lib/modules" >&2; exit 1; }

echo OK
EOF_SH

cmd=foreground:seq=1:exec=sh run.sh
expect=exit:code=0
expect=stdout:contains=OK
