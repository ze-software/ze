# Test: ze appliance kernel (default installer target) reaches the native shared
# driver, which invokes docker; the built Image lands in the installer output
# and the XDG cache. Only docker is faked.

option=timeout:value=30s


cmd=foreground:seq=1:exec=ze-test fixture install/appliance-kernel-docker "$ZE_REPO_ROOT"
expect=exit:code=0
expect=stdout:contains=OK
