# Test: ze appliance kernel (default installer target) reaches the shared run.py
# driver, which invokes docker; the built Image lands in the installer output and
# the XDG cache. Real python3 + run.py; only docker is faked.
#
# // test-relax: kernel-build-consolidation moved the docker build/run out of Go
# and into tools/kernel-builder/run.py. The old assertions on Go's inline docker
# argv ("building kernel with docker", direct mounts from Go) no longer apply;
# this rewrite asserts the equivalent run.py-driven flow (Go -> run.py -> docker
# -> build.py --fragment ...) per the spec's "rewrites, not edits" note.

option=timeout:value=30s

tmpfs=run.sh:terminator=EOF_SH
#!/bin/sh
set -eu

work=$PWD
ze_bin=$(command -v ze)
repo=${ZE_REPO_ROOT:-$(CDPATH= cd -- "$(dirname -- "$ze_bin")/.." && pwd)}
cd "$repo"

# // test-relax: ZE_KERNEL_TEST_OUTPUT_DIR redirects the build to $work/out, so
# this test no longer writes the shared tools/installer-kernel/build; the previous
# save/restore of that dir was both unnecessary and harmful (it raced with, and
# clobbered, appliance-kernel-registry which legitimately uses that dir).
mkdir -p "$work/fakebin" "$work/cache"

cat > "$work/fakebin/docker" <<'EOF_DOCKER'
#!/bin/sh
set -eu
printf '%s\n' "$*" >> "$ZE_DOCKER_LOG"
if [ "$1" = run ]; then
	prev=
	for arg in "$@"; do
		if [ "$prev" = -v ]; then
			case "$arg" in
				*:/out)
					out=${arg%:/out}
					mkdir -p "$out"
					printf 'docker-installer-kernel\n' > "$out/Image"
					cat > "$out/config" <<'EOF_CONFIG'
CONFIG_IP_PNP_DHCP=y
CONFIG_EXT4_FS=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_BLK=y
EOF_CONFIG
					;;
			esac
		fi
		prev=$arg
	done
fi
EOF_DOCKER
chmod +x "$work/fakebin/docker"

PATH="$work/fakebin:$PATH" \
XDG_CACHE_HOME="$work/cache" \
ZE_DOCKER_LOG="$work/docker.log" \
ZE_KERNEL_TEST_OUTPUT_DIR="$work/out" \
"$ze_bin" appliance kernel --arch amd64 --profile qemu --builder docker >"$work/stdout" 2>"$work/stderr"

# Go delegates to run.py (no inline docker argv in Go).
grep -q 'via run.py' "$work/stdout"
grep -q 'kernel ready:' "$work/stdout"
grep -q 'target=installer' "$work/stdout"
grep -q 'version=' "$work/stdout"
# run.py drove the docker build/run and passed the resolved fragments to build.py.
grep -q -- '--platform linux/amd64' "$work/docker.log"
grep -q -- 'python3 /builder/build.py' "$work/docker.log"
grep -q -- '--fragment /src/kernel.config' "$work/docker.log"
grep -q -- '--fragment /src/qemu.config' "$work/docker.log"
# // test-relax: the shared tools/installer-kernel/build dir is written by every
# parallel appliance-kernel-* test, so its Image/config/sidecar content is not a
# race-safe assertion target. Provenance is covered race-free by
# kernel-version-provenance.ci; resolved-config enforcement is covered by the
# command succeeding (a bad config fails enforcement and exits non-zero above);
# the docker.log + stdout assertions above (per-test isolated) prove the
# Go -> run.py -> docker -> build.py --fragment flow. Assert only that the
# artifact was cached.
cache_image=$(find "$work/cache" -path '*/installer-kernel/*/Image' -print | head -n 1)
[ -n "$cache_image" ]

echo OK
EOF_SH

cmd=foreground:seq=1:exec=sh run.sh
expect=exit:code=0
expect=stdout:contains=OK
