# Test: qemu-build.py accepts aarch64 as an alias for arm64 and continues to
# later validation instead of rejecting the arch itself.

option=timeout:value=20s

tmpfs=run.sh:terminator=EOF_SH
#!/bin/sh
set -eu

repo=${ZE_REPO_ROOT:-$(CDPATH= cd -- "$(dirname -- "$(command -v ze)")/.." && pwd)}
cd "$repo"

if python3 tools/kernel-builder/qemu-build.py \
	--arch aarch64 \
	--profile runtime \
	--version 7.1.1 \
	--src-dir ../bad \
	--out-dir tmp/kernel/build \
	--builder-dir tools/kernel-builder \
	--modules yes \
	--patches-dir gokrazy/kernel/patches >stdout 2>stderr; then
	echo 'expected qemu-build.py to fail validation' >&2
	exit 1
fi

grep -q -- '--src-dir must be a repo-relative path' stderr
if grep -q -- '--arch must be arm64 or amd64' stderr; then
	echo 'aarch64 alias was rejected' >&2
	cat stderr >&2
	exit 1
fi

echo OK
EOF_SH

cmd=foreground:seq=1:exec=sh run.sh
expect=exit:code=0
expect=stdout:contains=OK
