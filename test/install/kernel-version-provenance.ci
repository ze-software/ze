# Test (AC-16/AC-17): every native build emits a kernel.version provenance
# sidecar recording what was built, and malformed or pre-7 versions are rejected
# before any container work.

option=timeout:value=30s


cmd=foreground:seq=1:exec=ze-test fixture install/kernel-version-provenance
expect=exit:code=0
expect=stdout:contains=OK
