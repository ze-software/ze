# Valid config: DHCP server with PXE boot options enabled.
# spec-install-1 AC-5: PXE config block parses and validates successfully.
stdin=config:terminator=EOF_CONF
service {
    dhcp-server {
        enabled true
        listen-interface eth0
        pxe {
            enabled true
            tftp-server 192.168.1.1
            bootfile-bios ipxe.pxe
            bootfile-uefi ipxe.efi
        }
        shared-network install {
            subnet 192.168.1.0/24 {
                range pool1 {
                    start 192.168.1.100
                    stop 192.168.1.200
                }
                default-router 192.168.1.1
            }
        }
    }
}
EOF_CONF

cmd=foreground:seq=1:exec=ze config validate -:stdin=config
expect=exit:code=0
