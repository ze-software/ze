# Test: ze appliance kernel without --builder prefers Docker when both Docker
# and QEMU prerequisites are available.

option=timeout:value=20s

tmpfs=run.sh:terminator=EOF_SH
#!/bin/sh
set -eu

work=$PWD
ze_bin=$(command -v ze)
repo=$(CDPATH= cd -- "$(dirname -- "$ze_bin")/.." && pwd)
cd "$repo"

orig_image=
orig_config=
cleanup() {
	set +e
	if [ -n "$orig_image" ]; then
		cp "$orig_image" tools/installer-kernel/build/Image
	else
		rm -f tools/installer-kernel/build/Image
	fi
	if [ -n "$orig_config" ]; then
		cp "$orig_config" tools/installer-kernel/build/config
	else
		rm -f tools/installer-kernel/build/config
	fi
}
trap cleanup EXIT

mkdir -p "$work/fakebin" "$work/cache" tools/installer-kernel/build
if [ -f tools/installer-kernel/build/Image ]; then
	orig_image="$work/original-image"
	cp tools/installer-kernel/build/Image "$orig_image"
fi
if [ -f tools/installer-kernel/build/config ]; then
	orig_config="$work/original-config"
	cp tools/installer-kernel/build/config "$orig_config"
fi
rm -f tools/installer-kernel/build/Image tools/installer-kernel/build/config "$work/python.log"

cat > "$work/fakebin/docker" <<'EOF_DOCKER'
#!/bin/sh
set -eu
printf '%s\n' "$*" >> "$ZE_DOCKER_LOG"
if [ "$1" = run ]; then
	prev=
	for arg in "$@"; do
		if [ "$prev" = -v ]; then
			case "$arg" in
				*:/out)
					out=${arg%:/out}
					mkdir -p "$out"
					printf 'docker-installer-kernel\n' > "$out/Image"
					cat > "$out/config" <<'EOF_CONFIG'
CONFIG_IP_PNP_DHCP=y
CONFIG_EXT4_FS=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_BLK=y
EOF_CONFIG
					;;
			esac
		fi
		prev=$arg
	done
fi
EOF_DOCKER
chmod +x "$work/fakebin/docker"

cat > "$work/fakebin/python3" <<'EOF_PY'
#!/bin/sh
set -eu
printf '%s\n' "$*" >> "$ZE_PYTHON_LOG"
exit 99
EOF_PY
chmod +x "$work/fakebin/python3"

cat > "$work/fakebin/qemu-system-aarch64" <<'EOF_QEMU'
#!/bin/sh
exit 99
EOF_QEMU
chmod +x "$work/fakebin/qemu-system-aarch64"

PATH="$work/fakebin:$PATH" \
XDG_CACHE_HOME="$work/cache" \
ZE_DOCKER_LOG="$work/docker.log" \
ZE_PYTHON_LOG="$work/python.log" \
"$ze_bin" appliance kernel --arch amd64 --profile qemu >"$work/stdout" 2>"$work/stderr"

grep -q 'building kernel with docker' "$work/stdout"
grep -q 'kernel ready:' "$work/stdout"
[ "$(cat tools/installer-kernel/build/Image)" = 'docker-installer-kernel' ]
grep -q '^CONFIG_VIRTIO_NET=y$' tools/installer-kernel/build/config
cache_image=$(find "$work/cache" -path '*/installer-kernel/*/Image' -print | head -n 1)
[ -n "$cache_image" ]
[ "$(cat "$cache_image")" = 'docker-installer-kernel' ]
grep -q -- '--platform linux/amd64' "$work/docker.log"
[ ! -f "$work/python.log" ] || [ ! -s "$work/python.log" ]

echo OK
EOF_SH

cmd=foreground:seq=1:exec=sh run.sh
expect=exit:code=0
expect=stdout:contains=OK
