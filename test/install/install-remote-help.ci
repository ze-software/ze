# Test: ze install remote -h — remote subcommand help
# spec-install-4 AC-9: remote help shows required and optional flags.

cmd=foreground:seq=1:exec=ze install remote -h
expect=exit:code=0
expect=stderr:contains=--interface
expect=stderr:contains=--network
expect=stderr:contains=--image
expect=stderr:contains=--ssh-username
expect=stderr:contains=--ssh-password
expect=stderr:contains=--address
