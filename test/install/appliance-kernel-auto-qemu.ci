# Test: the native kernel driver owns docker-first / qemu-fallback builder
# selection. Docker wins when both are available, QEMU is the fallback, and
# absence of both backends is an error.

option=timeout:value=20s


cmd=foreground:seq=1:exec=ze-test fixture install/appliance-kernel-auto-qemu
expect=exit:code=0
expect=stdout:contains=OK
