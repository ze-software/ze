# Test: the containerized kernel build hands its output back to the invoking user.
#
# The compiled worker runs as uid 0 inside the container, so everything it
# writes through the output bind mount lands on the host owned root:root. The
# native driver repairs that ownership after both successful and failed builds.
# Running the build container as the invoking uid is not sufficient because the
# build also writes named volumes owned by root; only the output mount reaches
# the host.
option=timeout:value=60s


cmd=foreground:seq=1:exec=ze-test fixture install/kernel-build-output-ownership
expect=exit:code=0
expect=stdout:contains=OK
