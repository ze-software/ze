# Installer initrd unit tests: cmdline parsing, disk detection, ISO media
# discovery, the image download/write paths (HTTP stream + local checksum),
# the network fallback (ensure_network + foreign-DHCP recovery), console
# fan-out / rescue-shell selection, and server connectivity.
# Runs the shell-based test scripts from tools/installer-initrd/test/.
# spec-install-8 / installer-initrd build system.
#
# Each cmd= owns the expect= lines that follow it (the runner attaches
# expectations to the most recent command and captures its stdout separately).

cmd=foreground:seq=1:exec=sh tools/installer-initrd/test/test-cmdline-parse.sh
expect=exit:code=0
expect=stdout:regex=cmdline-parse: [0-9]+ passed, 0 failed

cmd=foreground:seq=2:exec=sh tools/installer-initrd/test/test-disk-detect.sh
expect=exit:code=0
expect=stdout:regex=disk-detect: [0-9]+ passed, 0 failed

cmd=foreground:seq=3:exec=sh tools/installer-initrd/test/test-iso-media.sh
expect=exit:code=0
expect=stdout:regex=iso-media: [0-9]+ passed, 0 failed

cmd=foreground:seq=4:exec=sh tools/installer-initrd/test/test-download.sh
expect=exit:code=0
expect=stdout:regex=download: [0-9]+ passed, 0 failed

cmd=foreground:seq=5:exec=sh tools/installer-initrd/test/test-ventoy-detect.sh
expect=exit:code=0
expect=stdout:regex=ventoy-detect: [0-9]+ passed, 0 failed

cmd=foreground:seq=6:exec=sh tools/installer-initrd/test/test-ensure-network.sh
expect=exit:code=0
expect=stdout:regex=ensure_network: [0-9]+ passed, 0 failed

cmd=foreground:seq=7:exec=sh tools/installer-initrd/test/test-console.sh
expect=exit:code=0
expect=stdout:regex=console: [0-9]+ passed, 0 failed

cmd=foreground:seq=8:exec=sh tools/installer-initrd/test/test-connectivity.sh
expect=exit:code=0
expect=stdout:regex=connectivity: [0-9]+ passed, 0 failed

cmd=foreground:seq=9:exec=sh tools/installer-initrd/test/test-applets.sh
expect=exit:code=0
expect=stdout:regex=applets: [0-9]+ passed, 0 failed

