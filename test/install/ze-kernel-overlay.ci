# Test (item 5): make ze-kernel-build builds the runtime kernel via run.py and assembles
# it into an OUT-OF-TREE package (tmp/kernel/pkg). The pinned rtr7/kernel modcache
# is read, never mutated in place, and no tracked file is written.
#
# // kernel-build-consolidation replaced the in-place modcache overlay
# + .ze-pinned-kernel backup/restore with out-of-tree consumption. The old
# assertions (modcache vmlinuz overwritten, backup created/restored,
# MODULES=yes/PATCHES_DIR in the docker env) no longer apply.
#
# // spec-gokrazy-builddir-tmp (AC-7/AC-8) then removed the tracked
# go.mod replace that this test REQUIRED to be present after `make ze-kernel-build`.
# The replace is now written into ze-gok's prepared copy of the instance, per
# build, selected by KERNEL_PKG. The assertion is inverted and STRENGTHENED: the
# tracked go.mod must be byte-identical after the build, not merely carry a
# relative path. That KERNEL_PKG still reaches the build is proven by
# ze-kernel-no-modcache-mutation.ci and by TestZeGokPassesKernelPackage.

option=timeout:value=40s

# The pinned rtr7/kernel module is an OPTIONAL heavyweight artifact, not part of
# a checkout: gokrazy/modcache/.gitignore ignores everything except the vendored
# gokrazy init source, so the module (and its 15 MB vmlinuz) exists only after
# `make ze-gokrazy-deps-download`. This test drives a REAL `make ze-kernel-build`, which reads
# that module (mk/build-gokrazy.mk:280 refuses to assemble the package without it) and
# checksums its vmlinuz before and after to prove it is not mutated. Without the
# declaration the shasum on line 1 of the script failed
# "No such file or directory" on every CI run.
#
# The glob names the FILE the script reads, not the parent directory: the parent
# also holds unrelated rtr7/dhcp4@... entries, so a directory check passed on a
# checkout that had no kernel module and the test then died on the very shasum
# the gate exists to prevent.
#
# Declaring it skips VISIBLY here. Coverage is PARTLY, not fully, preserved
# elsewhere -- state that precisely rather than wave at the sibling: the sibling
# ze-kernel-no-modcache-mutation.ci greps `make -n` RECIPE TEXT for a literal
# `cp ... modcache/.../vmlinuz`, so it runs everywhere including CI, but it
# cannot cover this test's real-execution assertions (the before/after shasum of
# the pinned vmlinuz, go.mod byte-identity after a real build, the assembled
# package contents). A mutation performed inside run.py or ze-gok rather than by
# a literal cp in the recipe passes the sibling and is caught by nothing in CI.
# That gap is accepted because CI cannot materialize the module; it is not
# closed by the sibling.
option=needs-path:value=gokrazy/modcache/github.com/rtr7/kernel@*/vmlinuz:hint=make ze-gokrazy-deps-download

tmpfs=run.sh:terminator=EOF_SH
#!/bin/sh
set -eu

work=$PWD
repo=${ZE_REPO_ROOT:-$(CDPATH= cd -- "$(dirname -- "$(command -v ze)")/.." && pwd)}
cd "$repo"

gomod="gokrazy/ze/builddir/github.com/rtr7/kernel/go.mod"
version=$(cd gokrazy/ze/builddir/github.com/rtr7/kernel && GOMODCACHE="$repo/gokrazy/modcache" go list -m -f '{{.Version}}' github.com/rtr7/kernel)
modcache="$repo/gokrazy/modcache/github.com/rtr7/kernel@$version"

saved_build=
saved_vmlinuz=
cleanup() {
	set +e
	go mod edit -dropreplace=github.com/rtr7/kernel "$gomod" 2>/dev/null
	rm -rf tmp/kernel/pkg tmp/kernel/build tmp/kernel/vmlinuz
	[ -n "$saved_build" ] && { mkdir -p tmp/kernel; mv "$saved_build" tmp/kernel/build; }
	[ -n "$saved_vmlinuz" ] && mv "$saved_vmlinuz" tmp/kernel/vmlinuz
	true
}
trap cleanup EXIT
[ -d tmp/kernel/build ] && { saved_build="$work/sb"; mv tmp/kernel/build "$saved_build"; }
[ -f tmp/kernel/vmlinuz ] && { saved_vmlinuz="$work/sv"; mv tmp/kernel/vmlinuz "$saved_vmlinuz"; }

before=$(shasum -a256 "$modcache/vmlinuz" | cut -d' ' -f1)
gomod_before=$(shasum -a256 "$gomod" | cut -d' ' -f1)

mkdir -p "$work/fakebin"
cat > "$work/fakebin/docker" <<'EOF_DOCKER'
#!/bin/sh
set -eu
if [ "$1" = run ]; then
	# Only a run carrying build.py is a BUILD. run.py issues a second
	# `docker run ... chown -R <uid>:<gid> /out` to hand the build's output back
	# to the invoking user, and that run mounts :/out as well. Synthesizing build
	# output for it rewrites what the build produced.
	case " $* " in *" /builder/build.py "*) ;; *) exit 0 ;; esac
	prev=
	for arg in "$@"; do
		if [ "$prev" = -v ]; then
			case "$arg" in
				*:/out)
					out=${arg%:/out}
					mkdir -p "$out/lib/modules/7.1.1-ze"
# amd64 boot magic 'HdrS' at offset 0x202 so make ze-kernel-build's arch check accepts this fake build
					{ printf 'runtime-kernel'; head -c 500 /dev/zero; printf 'HdrS'; } > "$out/vmlinuz"
					printf 'module\n' > "$out/lib/modules/7.1.1-ze/ze.ko"
					printf 'CONFIG_RUNTIME=y\n' > "$out/config"
					;;
			esac
		fi
		prev=$arg
	done
fi
EOF_DOCKER
chmod +x "$work/fakebin/docker"

# XDG_CACHE_HOME is REQUIRED, not tidiness. ze-kernel-vmlinuz-stage
# (mk/build-gokrazy.mk) routes the runtime kernel through the durable cache that
# ze-host resolves from XDG_CACHE_HOME (cacheHome, internal/appliance/cache.go),
# and its MISS branch POPULATES that cache with whatever the build produced.
# Unset, this test writes its 518-byte fake vmlinuz into the developer's real
# ~/.cache/ze/runtime-kernel/<key>, and from then on ze-qemu-kernel-guard
# compares the staged kernel against a fake and refuses every QEMU target --
# or, on the next stage, materializes the fake into tmp/kernel/vmlinuz and
# reports "Runtime kernel: ... matches" over a 518-byte file QEMU cannot boot.
# Measured 2026-08-24: one `make ze-functional-install-test` left exactly that
# entry behind. Saving and restoring tmp/kernel/ covers the working tree and
# does not reach the durable cache, which is the shared state the guard reads.
PATH="$work/fakebin:$PATH" XDG_CACHE_HOME="$work/cache" \
	make ze-kernel-build KERNEL_ARCH=amd64 >"$work/stdout" 2>"$work/stderr"

# The real durable cache holds no kernel this test could have written. Asserted
# rather than trusted: this test drives make, which drives ze-host, and a
# variable that stops being read anywhere along that chain fails silently and
# poisons the host.
#
# Keyed on SIZE, not on mtime. A real runtime kernel is about 16 MB and the fake
# above is 518 bytes, so this names the fake exactly. An mtime comparison would
# instead accuse this test whenever another session in the same checkout staged
# a real kernel while it ran.
#
# The unit is BYTES and it is load-bearing. `-size -1M` rounds every file UP to a
# whole megabyte before comparing, so a 518-byte file measures as 1M and `-1M`
# matches nothing but a 0-byte file. The assertion could not see the fake it
# exists to catch. Only `c` compares the byte count itself. Measured against a
# 518-byte fixture built exactly as the fake docker above builds it, on GNU
# findutils 4.9.0 and on bfs 4.1.1: `-1M` returned nothing and `-1048576c`
# returned the file.
real_cache="${XDG_CACHE_HOME:-$HOME/.cache}/ze/runtime-kernel"
poisoned=$(find "$real_cache" -name vmlinuz -size -1048576c 2>/dev/null | head -n 1)
if [ -n "$poisoned" ]; then
	echo "a fake kernel is in the real runtime-kernel cache: $poisoned" >&2
	echo "ze-qemu-kernel-guard reads that cache, so every QEMU target now refuses" >&2
	exit 1
fi

# make ze-kernel-build routes the runtime kernel through the durable cache: it prints
# "Runtime kernel cache HIT: materializing" (warm cache) or "cache MISS: building"
# (cold cache -> run.py via the faked docker above). Either proves the routing ran;
# asserting the literal build message would break on any warm-cache host.
grep -qE 'Runtime kernel cache (HIT|MISS)' "$work/stdout"
grep -q 'out-of-tree' "$work/stdout"

# Out-of-tree package assembled from the pinned module + our artifacts.
[ -f tmp/kernel/pkg/vmlinuz ]
[ "$(head -c 14 tmp/kernel/pkg/vmlinuz)" = 'runtime-kernel' ]   # identity marker; the image also carries the amd64 HdrS boot magic
[ -d tmp/kernel/pkg/lib/modules ]
[ -f tmp/kernel/pkg/go.mod ]            # carried over from the pinned module -> valid replace target
[ -f tmp/kernel/pkg/empty.go ]

# The tracked builddir go.mod is NOT touched. gok is pointed at the package per
# build (KERNEL_PKG -> ze.gok.kernel-package), and ze-gok writes the replace into
# its prepared COPY of the instance, so a custom-kernel build leaves the working
# tree clean and cannot leak into a later build.
if grep -q 'replace github.com/rtr7/kernel' "$gomod"; then
	echo "make ze-kernel-build wrote a replace into the tracked $gomod" >&2
	exit 1
fi
gomod_after=$(shasum -a256 "$gomod" | cut -d' ' -f1)
[ "$gomod_before" = "$gomod_after" ]

# The pinned modcache vmlinuz is byte-for-byte unchanged (read, not mutated).
after=$(shasum -a256 "$modcache/vmlinuz" | cut -d' ' -f1)
[ "$before" = "$after" ]

echo OK
EOF_SH

cmd=foreground:seq=1:exec=sh run.sh
expect=exit:code=0
expect=stdout:contains=OK
