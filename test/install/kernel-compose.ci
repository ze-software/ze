# Runtime kernel fragment composition: tracked fragments must carry the required
# gokrazy, L2TP/PPP, virtio, and module options without removed Kconfig symbols.
#
# The fragment assertions read the tracked files in place. The build half runs
# against a SCRATCH repository root under the harness work directory, so this
# test writes no profile fragment into tools/installer-kernel/ and no build
# output into repo-root build/kernel/. Both are shared state: the profile
# registry (registeredKernelProfiles in internal/appliance/kernelreg.go) lists
# every <name>.config / <name>.require pair it finds in the tracked directory,
# and a concurrent kernel build owns build/kernel/.

option=timeout:value=20s

tmpfs=run.sh:terminator=EOF_SH
#!/bin/sh
set -eu

work=$PWD
repo=${ZE_REPO_ROOT:-$(CDPATH= cd -- "$(dirname -- "$(command -v ze)")/.." && pwd)}
cd "$repo"

base=gokrazy/kernel/kernel.config
runtime=gokrazy/kernel/runtime.config
[ -f "$base" ] || { echo "missing $base" >&2; exit 1; }
[ -f "$runtime" ] || { echo "missing $runtime" >&2; exit 1; }

combined=$(mktemp)
# The trap removes only the temporary concatenation. It used to restore
# repo-root build/kernel/Image and build/kernel/config and delete the
# compose-fixture pair from tools/installer-kernel/, and the build half writes
# neither of those now (the audit record is on the make invocation below). A
# trap that restores shared state is load-bearing: SIGKILL or a harness timeout
# skips it and leaves a working profile behind for registeredKernelProfiles
# (internal/appliance/kernelreg.go) to list as a shipped one.
cleanup() {
	set +e
	rm -f "$combined"
}
trap cleanup EXIT
# The runtime profile pulls in the shared efi-console fragment via # ze-include,
# so the composed view must include it (DRM_SIMPLEDRM / X86_SYSFB live there now).
cat "$base" "$runtime" tools/kernel-builder/common/efi-console.config > "$combined"

require_enabled() {
	opt=$1
	if ! grep -q "^${opt}=y" "$combined"; then
		echo "missing required ${opt}=y" >&2
		exit 1
	fi
}

require_absent() {
	opt=$1
	if grep -q "^${opt}[= ]" "$combined" tools/installer-kernel/*.config; then
		echo "dead option still present: ${opt}" >&2
		exit 1
	fi
}

for opt in \
	CONFIG_MODULES \
	CONFIG_PPP \
	CONFIG_PPPOL2TP \
	CONFIG_L2TP \
	CONFIG_L2TP_V3 \
	CONFIG_DEVTMPFS_MOUNT \
	CONFIG_BLK_DEV_INITRD \
	CONFIG_VIRTIO_NET \
	CONFIG_DRM_SIMPLEDRM \
	CONFIG_X86_SYSFB \
	CONFIG_I40E \
	CONFIG_ICE \
	CONFIG_BNXT \
	CONFIG_MLX5_CORE \
	CONFIG_IGB \
	CONFIG_IGC \
	CONFIG_NF_TABLES \
	CONFIG_WIREGUARD \
	CONFIG_BRIDGE \
	CONFIG_TUN \
	CONFIG_MACVLAN \
	CONFIG_IPV6 \
	CONFIG_SQUASHFS \
	CONFIG_FUSE_FS \
	CONFIG_BPF_SYSCALL \
	CONFIG_BPF_JIT \
	CONFIG_VETH; do
	require_enabled "$opt"
done

# test-relax: CONFIG_L2TP_NETLINK moved from require_enabled to require_absent.
# It was removed as a standalone Kconfig symbol in kernel 7.0 (netlink is always
# built with L2TP; see gokrazy/kernel/runtime.config line 98), so requiring it
# enabled is wrong for any post-7.0 target (the pinned version lives in
# internal/appliance/kernel.version). Asserting it absent matches the other
# removed-in-newer-kernel options below. Coverage is preserved, not dropped.
for opt in \
	CONFIG_NF_NAT_IPV4 \
	CONFIG_NF_NAT_MASQUERADE_IPV4 \
	CONFIG_NFT_MASQ_IPV4 \
	CONFIG_NFT_CHAIN_NAT_IPV4 \
	CONFIG_NFT_CHAIN_ROUTE_IPV4 \
	CONFIG_NFT_CHAIN_ROUTE_IPV6 \
	CONFIG_USB_DEVICEFS \
	CONFIG_FB_SIMPLE \
	CONFIG_L2TP_NETLINK; do
	require_absent "$opt"
done

# The build half runs against a SCRATCH repository root under the harness work
# directory. repo_root() in tools/kernel-builder/run.py walks up from that
# file's OWN resolved path to the first directory that holds go.mod, and main()
# joins --src-dir, --out-dir, --builder-dir, --common-dir and
# internal/appliance/kernel.version against that root. A copy of the two tool
# trees under a scratch root therefore keeps fragment resolution, the version
# read and the build output inside the scratch tree. COPY, never symlink:
# Path(__file__).resolve() follows a symlink back to the real repository and
# defeats the isolation.
scratch=$work/scratch-root
mkdir -p "$scratch/tools"
mkdir -p "$scratch/internal/appliance"
mkdir -p "$scratch/build/kernel"
mkdir -p "$work/fakebin"
: > "$scratch/go.mod"
cp -R tools/installer-kernel "$scratch/tools/installer-kernel"
cp -R tools/kernel-builder "$scratch/tools/kernel-builder"
cp internal/appliance/kernel.version "$scratch/internal/appliance/kernel.version"
cat > "$scratch/tools/installer-kernel/compose-fixture.config" <<'EOF_CONFIG'
# ze-base: qemu
CONFIG_COMPOSE_FIXTURE=y
EOF_CONFIG
printf 'CONFIG_COMPOSE_FIXTURE\n' > "$scratch/tools/installer-kernel/compose-fixture.require"
# // test-relax: run.py passes the profile to build.py as `--profile <name>` rather
# than the old `-e PROFILE=<name>` docker env, so the fake docker detects it from
# the --profile argument now.
cat > "$work/fakebin/docker" <<'EOF_DOCKER'
#!/bin/sh
set -eu
if [ "$1" = run ]; then
	prev=
	profile=qemu
	for arg in "$@"; do
		if [ "$prev" = --profile ]; then
			profile=$arg
		fi
		if [ "$prev" = -v ]; then
			case "$arg" in
				*:/out) out=${arg%:/out} ;;
			esac
		fi
		prev=$arg
	done
	mkdir -p "$out"
	printf kernel > "$out/Image"
	cat > "$out/config" <<'EOF_CONFIG'
CONFIG_IP_PNP_DHCP=y
CONFIG_EXT4_FS=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_BLK=y
EOF_CONFIG
	if [ "$profile" = compose-fixture ]; then
		printf 'CONFIG_COMPOSE_FIXTURE=y\n' >> "$out/config"
	fi
fi
EOF_DOCKER
chmod +x "$work/fakebin/docker"
# test-relax: no assertion is changed, removed, or lowered in this file. The 12
# deleted lines are shared-state scaffolding, not coverage: `orig_image` and
# `orig_config` saved and restored repo-root build/kernel/Image and
# build/kernel/config around a build that now runs in the scratch root, and the
# trap deleted a compose-fixture pair that is now written into the scratch copy
# of tools/installer-kernel/. Every assertion below is the one it was, against
# the scratch paths, and one assertion is ADDED (the provenance sidecar).
PATH="$work/fakebin:$PATH" make -C "$scratch/tools/installer-kernel" PROFILE=qemu BUILDER=docker ARCH=amd64 > "$work/make-qemu.out"
if grep -q '^CONFIG_COMPOSE_FIXTURE=y$' "$scratch/build/kernel/config"; then
	echo "qemu profile unexpectedly used compose fixture" >&2
	exit 1
fi
PATH="$work/fakebin:$PATH" make -C "$scratch/tools/installer-kernel" PROFILE=compose-fixture BUILDER=docker ARCH=amd64 > "$work/make-fixture.out"
grep -q 'profile=compose-fixture' "$work/make-fixture.out"
grep -q '^CONFIG_COMPOSE_FIXTURE=y$' "$scratch/build/kernel/config"
# write_provenance() in run.py writes this sidecar into --out-dir, so the line
# pins the build output to the scratch out-dir rather than to any other path.
grep -q '^profile=compose-fixture$' "$scratch/build/kernel/kernel.version"
rm -f "$scratch/build/kernel/Image"
if PATH="$work/fakebin:$PATH" make -q -C "$scratch/tools/installer-kernel" PROFILE=compose-fixture BUILDER=docker ARCH=amd64; then
	echo "missing build/Image unexpectedly considered up to date" >&2
	exit 1
fi

printf 'OK\n'
EOF_SH

cmd=foreground:seq=1:exec=sh run.sh
expect=exit:code=0
expect=stdout:contains=OK
