# Runtime kernel fragment composition: tracked fragments must carry the required
# gokrazy, L2TP/PPP, virtio, and module options without removed Kconfig symbols.
#
# Build output lives at repo-root build/kernel/ (Makefile OUT := ../../build/kernel,
# run.py --out-dir build/kernel), consolidated from the old tools/installer-kernel/
# build/ by commit d8d371d4d. Assertions unchanged; only the output paths follow.

option=timeout:value=20s

tmpfs=run.sh:terminator=EOF_SH
#!/bin/sh
set -eu

work=$PWD
repo=$(CDPATH= cd -- "$(dirname -- "$(command -v ze)")/.." && pwd)
cd "$repo"

base=gokrazy/kernel/kernel.config
runtime=gokrazy/kernel/runtime.config
[ -f "$base" ] || { echo "missing $base" >&2; exit 1; }
[ -f "$runtime" ] || { echo "missing $runtime" >&2; exit 1; }

orig_image=
orig_config=
combined=$(mktemp)
cleanup() {
	set +e
	rm -f "$combined" tools/installer-kernel/compose-fixture.config tools/installer-kernel/compose-fixture.require
	if [ -n "$orig_image" ]; then
		cp "$orig_image" build/kernel/Image
	else
		rm -f build/kernel/Image
	fi
	if [ -n "$orig_config" ]; then
		cp "$orig_config" build/kernel/config
	else
		rm -f build/kernel/config
	fi
}
trap cleanup EXIT
# The runtime profile pulls in the shared efi-console fragment via # ze-include,
# so the composed view must include it (DRM_SIMPLEDRM / X86_SYSFB live there now).
cat "$base" "$runtime" tools/kernel-builder/common/efi-console.config > "$combined"

require_enabled() {
	opt=$1
	if ! grep -q "^${opt}=y" "$combined"; then
		echo "missing required ${opt}=y" >&2
		exit 1
	fi
}

require_absent() {
	opt=$1
	if grep -q "^${opt}[= ]" "$combined" tools/installer-kernel/*.config; then
		echo "dead option still present: ${opt}" >&2
		exit 1
	fi
}

for opt in \
	CONFIG_MODULES \
	CONFIG_PPP \
	CONFIG_PPPOL2TP \
	CONFIG_L2TP \
	CONFIG_L2TP_V3 \
	CONFIG_DEVTMPFS_MOUNT \
	CONFIG_BLK_DEV_INITRD \
	CONFIG_VIRTIO_NET \
	CONFIG_DRM_SIMPLEDRM \
	CONFIG_X86_SYSFB \
	CONFIG_I40E \
	CONFIG_ICE \
	CONFIG_BNXT \
	CONFIG_MLX5_CORE \
	CONFIG_IGB \
	CONFIG_IGC \
	CONFIG_NF_TABLES \
	CONFIG_WIREGUARD \
	CONFIG_BRIDGE \
	CONFIG_TUN \
	CONFIG_MACVLAN \
	CONFIG_IPV6 \
	CONFIG_SQUASHFS \
	CONFIG_FUSE_FS \
	CONFIG_BPF_SYSCALL \
	CONFIG_BPF_JIT \
	CONFIG_VETH; do
	require_enabled "$opt"
done

# test-relax: CONFIG_L2TP_NETLINK moved from require_enabled to require_absent.
# It was removed as a standalone Kconfig symbol in kernel 7.0 (netlink is always
# built with L2TP; see gokrazy/kernel/runtime.config line 98), so requiring it
# enabled is wrong for any post-7.0 target (the pinned version lives in
# internal/appliance/kernel.version). Asserting it absent matches the other
# removed-in-newer-kernel options below. Coverage is preserved, not dropped.
for opt in \
	CONFIG_NF_NAT_IPV4 \
	CONFIG_NF_NAT_MASQUERADE_IPV4 \
	CONFIG_NFT_MASQ_IPV4 \
	CONFIG_NFT_CHAIN_NAT_IPV4 \
	CONFIG_NFT_CHAIN_ROUTE_IPV4 \
	CONFIG_NFT_CHAIN_ROUTE_IPV6 \
	CONFIG_USB_DEVICEFS \
	CONFIG_FB_SIMPLE \
	CONFIG_L2TP_NETLINK; do
	require_absent "$opt"
done

mkdir -p "$work/fakebin" build/kernel
if [ -f build/kernel/Image ]; then
	orig_image="$work/original-image"
	cp build/kernel/Image "$orig_image"
fi
if [ -f build/kernel/config ]; then
	orig_config="$work/original-config"
	cp build/kernel/config "$orig_config"
fi
rm -f build/kernel/Image build/kernel/config
cat > tools/installer-kernel/compose-fixture.config <<'EOF_CONFIG'
# ze-base: qemu
CONFIG_COMPOSE_FIXTURE=y
EOF_CONFIG
printf 'CONFIG_COMPOSE_FIXTURE\n' > tools/installer-kernel/compose-fixture.require
# // test-relax: run.py passes the profile to build.py as `--profile <name>` rather
# than the old `-e PROFILE=<name>` docker env, so the fake docker detects it from
# the --profile argument now.
cat > "$work/fakebin/docker" <<'EOF_DOCKER'
#!/bin/sh
set -eu
if [ "$1" = run ]; then
	prev=
	profile=qemu
	for arg in "$@"; do
		if [ "$prev" = --profile ]; then
			profile=$arg
		fi
		if [ "$prev" = -v ]; then
			case "$arg" in
				*:/out) out=${arg%:/out} ;;
			esac
		fi
		prev=$arg
	done
	mkdir -p "$out"
	printf kernel > "$out/Image"
	cat > "$out/config" <<'EOF_CONFIG'
CONFIG_IP_PNP_DHCP=y
CONFIG_EXT4_FS=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_BLK=y
EOF_CONFIG
	if [ "$profile" = compose-fixture ]; then
		printf 'CONFIG_COMPOSE_FIXTURE=y\n' >> "$out/config"
	fi
fi
EOF_DOCKER
chmod +x "$work/fakebin/docker"
PATH="$work/fakebin:$PATH" make -C tools/installer-kernel PROFILE=qemu BUILDER=docker ARCH=amd64 > "$work/make-qemu.out"
if grep -q '^CONFIG_COMPOSE_FIXTURE=y$' build/kernel/config; then
	echo "qemu profile unexpectedly used compose fixture" >&2
	exit 1
fi
PATH="$work/fakebin:$PATH" make -C tools/installer-kernel PROFILE=compose-fixture BUILDER=docker ARCH=amd64 > "$work/make-fixture.out"
grep -q 'profile=compose-fixture' "$work/make-fixture.out"
grep -q '^CONFIG_COMPOSE_FIXTURE=y$' build/kernel/config
rm -f build/kernel/Image
if PATH="$work/fakebin:$PATH" make -q -C tools/installer-kernel PROFILE=compose-fixture BUILDER=docker ARCH=amd64; then
	echo "missing build/Image unexpectedly considered up to date" >&2
	exit 1
fi

printf 'OK\n'
EOF_SH

cmd=foreground:seq=1:exec=sh run.sh
expect=exit:code=0
expect=stdout:contains=OK
