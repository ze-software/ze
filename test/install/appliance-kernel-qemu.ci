# Test: the shared native driver accepts an explicit QEMU backend for the arm64
# installer hardware profile and validates the resolved base, profile, and
# shared console fragments before entering the VM backend.

option=timeout:value=30s


cmd=foreground:seq=1:exec=ze-test fixture install/appliance-kernel-qemu "$ZE_REPO_ROOT"
expect=exit:code=0
expect=stdout:contains=OK
