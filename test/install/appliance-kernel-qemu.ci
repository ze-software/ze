# Test: ze appliance kernel --builder qemu reaches the shared run.py driver, which
# selects the QEMU backend and invokes qemu-build.py with the resolved fragments
# (including the shared efi-console fragment for the hardware profile). A smart
# fake python3 passes run.py through to the real interpreter but stubs the
# qemu-build.py VM step.
#
# // test-relax: kernel-build-consolidation moved QEMU selection out of Go into
# run.py. The old "building kernel with qemu" message and direct Go->qemu-build.py
# argv no longer apply; this asserts the equivalent Go -> run.py -> qemu-build.py
# chain (spec "rewrites, not edits" note).

option=timeout:value=30s

tmpfs=run.sh:terminator=EOF_SH
#!/bin/sh
set -eu

work=$PWD
ze_bin=$(command -v ze)
realpy=$(command -v python3)
repo=${ZE_REPO_ROOT:-$(CDPATH= cd -- "$(dirname -- "$ze_bin")/.." && pwd)}
cd "$repo"

# // test-relax: ZE_KERNEL_TEST_OUTPUT_DIR redirects the build to $work/out, so
# this test no longer writes the shared tools/installer-kernel/build; the previous
# save/restore of that dir was unnecessary and raced with appliance-kernel-registry.
mkdir -p "$work/fakebin" "$work/cache"

# Smart fake: run.py runs for real; only qemu-build.py is stubbed.
cat > "$work/fakebin/python3" <<EOF_PY
#!/bin/sh
set -eu
case "\$*" in
	*qemu-build.py*)
		printf '%s\n' "\$*" >> "\$ZE_PYTHON_LOG"
		out=
		prev=
		for arg in "\$@"; do
			if [ "\$prev" = '--out-dir' ]; then out=\$arg; fi
			prev=\$arg
		done
		[ -n "\$out" ]
		mkdir -p "\$out"
		printf 'qemu-installer-kernel\n' > "\$out/Image"
		cat > "\$out/config" <<'EOF_CONFIG'
CONFIG_IP_PNP_DHCP=y
CONFIG_EXT4_FS=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_FB_EFI=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_E1000E=y
CONFIG_IGB=y
CONFIG_IGC=y
CONFIG_R8169=y
CONFIG_SATA_AHCI=y
CONFIG_BLK_DEV_NVME=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_VFAT_FS=y
CONFIG_EXFAT_FS=y
EOF_CONFIG
		;;
	*)
		exec "$realpy" "\$@"
		;;
esac
EOF_PY
chmod +x "$work/fakebin/python3"

# No docker so run.py would auto-pick qemu, but we pass --builder qemu explicitly.
cat > "$work/fakebin/qemu-system-aarch64" <<'EOF_Q'
#!/bin/sh
exit 0
EOF_Q
chmod +x "$work/fakebin/qemu-system-aarch64"

PATH="$work/fakebin:$PATH" \
XDG_CACHE_HOME="$work/cache" \
ZE_PYTHON_LOG="$work/python.log" \
ZE_KERNEL_TEST_OUTPUT_DIR="$work/out" \
"$ze_bin" appliance kernel --arch arm64 --profile hardware --builder qemu >"$work/stdout" 2>"$work/stderr"

grep -q 'via run.py' "$work/stdout"
grep -q 'kernel ready:' "$work/stdout"
grep -q 'target=installer' "$work/stdout"
grep -q 'profile=hardware' "$work/stdout"
# // test-relax: with ZE_KERNEL_TEST_OUTPUT_DIR the build writes a per-test dir,
# not the shared tools/installer-kernel/build, so assert the isolated XDG cache
# (CONFIG_EFI correctness is implied by the command surviving enforcement above).
cache_image=$(find "$work/cache" -path '*/installer-kernel/*/Image' -print | head -n 1)
[ -n "$cache_image" ]
[ "$(cat "$cache_image")" = 'qemu-installer-kernel' ]
# run.py invoked qemu-build.py with the resolved fragments, including the shared one.
grep -q -- 'qemu-build.py' "$work/python.log"
grep -q -- '--builder-dir tools/kernel-builder' "$work/python.log"
grep -q -- '--fragment tools/installer-kernel/kernel.config' "$work/python.log"
grep -q -- '--fragment tools/installer-kernel/hardware.config' "$work/python.log"
grep -q -- '--fragment tools/kernel-builder/common/efi-console.config' "$work/python.log"

echo OK
EOF_SH

cmd=foreground:seq=1:exec=sh run.sh
expect=exit:code=0
expect=stdout:contains=OK
