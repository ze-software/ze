# Test: gokrazy/kernel/Makefile notices shared builder and patch changes.
#
# // test-relax: the build output artifact is redirected to a per-test dir via
# `make OUT=$work/out` instead of the shared tmp/kernel/build. The old shared
# path raced with ze-kernel-overlay (which moves/removes tmp/kernel/build): a
# TOCTOU on out.exists()/out.stat() below intermittently FAILed the full
# parallel install suite. Only the output location changes; the mtime-based
# dependency graph this test exercises (source files vs the built vmlinuz) is
# identical because the prerequisites are repo-relative source paths.

option=timeout:value=20s

tmpfs=run.sh:terminator=EOF_SH
#!/bin/sh
set -eu

work=$PWD
repo=${ZE_REPO_ROOT:-$(CDPATH= cd -- "$(dirname -- "$(command -v ze)")/.." && pwd)}
cd "$repo"
state="$work/mtimes.json"
outdir="$work/out"

cleanup() {
	set +e
	python3 - <<'PY' "$state"
from pathlib import Path
import json, os, sys
state = json.loads(Path(sys.argv[1]).read_text())
for path, ns in state["mtimes"].items():
    p = Path(path)
    if p.exists():
        os.utime(p, ns=(ns, ns))
out = Path(state["output"])
if state["output_existed"]:
    os.utime(out, ns=(state["output_mtime_ns"], state["output_mtime_ns"]))
else:
    out.unlink(missing_ok=True)
    try:
        out.parent.rmdir()
    except OSError:
        pass
PY
}
trap cleanup EXIT

python3 - <<'PY' "$state" "$outdir"
from pathlib import Path
import json, os, sys
paths = [
    Path('tools/kernel-builder/Dockerfile'),
    Path('tools/kernel-builder/build.py'),
    Path('tools/kernel-builder/qemu-build.py'),
    Path('tools/kernel-builder/run.py'),
    Path('tools/kernel-builder/ksource.py'),
    Path('tools/kernel-builder/common/efi-console.config'),
    Path('tools/kernel-builder/common/efi-console.require'),
    Path('gokrazy/kernel/kernel.config'),
    Path('gokrazy/kernel/kernel.require'),
    Path('gokrazy/kernel/runtime.config'),
    Path('gokrazy/kernel/runtime.require'),
    Path('gokrazy/kernel/patches/series'),
    Path('gokrazy/kernel/patches/0001-nct6683.patch'),
]
out = Path(sys.argv[2]) / 'vmlinuz'
out.parent.mkdir(parents=True, exist_ok=True)
try:
    mtime = out.stat().st_mtime_ns
    existed = True
except FileNotFoundError:
    mtime = 0
    existed = False
if not existed:
    out.write_text('mtime-test\n')
state = {
    'output': str(out),
    'output_existed': existed,
    'output_mtime_ns': mtime,
    'mtimes': {str(p): p.stat().st_mtime_ns for p in paths},
}
Path(sys.argv[1]).write_text(json.dumps(state))
PY

expect_status() {
	want=$1
	shift
	if "$@"; then
		rc=0
	else
		rc=$?
	fi
	if [ "$rc" -ne "$want" ]; then
		echo "wanted exit $want, got $rc: $*" >&2
		exit 1
	fi
}

touch -t 202601010000 tools/kernel-builder/Dockerfile tools/kernel-builder/build.py tools/kernel-builder/qemu-build.py \
	tools/kernel-builder/run.py tools/kernel-builder/ksource.py \
	tools/kernel-builder/common/efi-console.config tools/kernel-builder/common/efi-console.require \
	gokrazy/kernel/kernel.config gokrazy/kernel/kernel.require gokrazy/kernel/runtime.config gokrazy/kernel/runtime.require gokrazy/kernel/patches/series gokrazy/kernel/patches/0001-nct6683.patch
touch -t 202601010100 "$outdir/vmlinuz"
expect_status 0 make -q -C gokrazy/kernel OUT="$outdir" BUILDER=docker
expect_status 0 make -q -C gokrazy/kernel OUT="$outdir" BUILDER=qemu

touch -t 202601010200 tools/kernel-builder/Dockerfile
expect_status 1 make -q -C gokrazy/kernel OUT="$outdir" BUILDER=docker

touch -t 202601010000 tools/kernel-builder/Dockerfile
touch -t 202601010200 tools/kernel-builder/run.py
expect_status 1 make -q -C gokrazy/kernel OUT="$outdir" BUILDER=docker

touch -t 202601010000 tools/kernel-builder/run.py
touch -t 202601010200 tools/kernel-builder/common/efi-console.config
expect_status 1 make -q -C gokrazy/kernel OUT="$outdir" BUILDER=docker

touch -t 202601010000 tools/kernel-builder/common/efi-console.config
touch -t 202601010200 tools/kernel-builder/qemu-build.py
expect_status 1 make -q -C gokrazy/kernel OUT="$outdir" BUILDER=qemu

touch -t 202601010000 tools/kernel-builder/qemu-build.py
touch -t 202601010200 gokrazy/kernel/patches/0001-nct6683.patch
expect_status 1 make -q -C gokrazy/kernel OUT="$outdir" BUILDER=docker

echo OK
EOF_SH

cmd=foreground:seq=1:exec=sh run.sh
expect=exit:code=0
expect=stdout:contains=OK
