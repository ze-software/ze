# Test: the runtime kernel cache identity changes with target, architecture,
# profile inputs, shared fragments, and every native builder source. Restoring
# each input restores the steady-state identity.

option=timeout:value=20s


cmd=foreground:seq=1:exec=ze-test fixture install/kernel-runtime-deps "$ZE_REPO_ROOT"
expect=exit:code=0
expect=stdout:contains=OK
