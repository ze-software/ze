# Test: a configured VPN-IPv6 route carries the speaker's link-local in the
# 48-octet Next Hop field when the recipient shares a subnet with the speaker,
# even though the global next hop is on no subnet the recipient shares.
#
# RFC requirement: RFC4659-3.2.1.1-3 positive -- the `link-local fe80::1` leaf is configured, the recipient ::1 is on the connected ::1/128, and the global next hop fd00::2 (the speaker's own `local ip`) is on no prefix shared with it, so the MP_REACH_NLRI Next Hop field is 48 octets: zero RD, fd00::2, zero RD, fe80::1.
#
# RFC 4659 Section 3.2.1.1: "The link-local address shall be included in the
# Next Hop field if and only if the advertising BGP speaker shares a common
# subnet with the peer the route is being advertised to [BGP-IPv6]." The
# sentence names the peer alone, unlike RFC 2545 Section 3, which names the
# global next hop's entity too. Ze follows RFC 4659 literally for VPN-IPv6
# (owner decision 2026-10-19; linkLocalConditionFor,
# internal/component/bgp/reactor/link_scope.go), so a loopback global no longer
# withholds the link-local. This file fails if the RFC 2545 joint condition is
# applied to VPN-IPv6 again.
#
# The negative (24-octet) form needs a recipient on no connected subnet, which
# the loopback fixture cannot give: reactor/rfc4659_vpn_link_local_test.go
# carries it.
#
# MP_REACH_NLRI value: AFI 0002, SAFI 80, length 30 (48), RD 0, fd00::2, RD 0,
# fe80::1, reserved 00. The 24-octet form (length 18, RD 0, fd00::2) is rejected.

stdin=peer:terminator=EOF_PEER
option=bind:value=ipv6
expect=bgp:conn=1:seq=1:contains=000280300000000000000000FD0000000000000000000000000000020000000000000000FE80000000000000000000000000000100
reject=bgp:conn=1:pattern=000280180000000000000000FD000000000000000000000000000002
EOF_PEER

stdin=ze-bgp:terminator=EOF_CONF
bgp {
	peer peer-v6-1 {
		connection {
			remote {
				ip ::1
			}
			# Ze's next hop is not the peer's address: RFC 4271 Section 5.1.3
			# withholds a route advertised with the peer's own address.
			local {
				ip fd00::2
				accept false
			}
		}
		session {
			asn {
				local 12345
				remote 12345
			}
			router-id 127.0.0.2
			link-local fe80::1
			family {
				ipv6/mpls-vpn { prefix { maximum 10000; } }
			}
		}
		update {
			attribute {
				origin igp
				next-hop self
			}
			nlri {
				ipv6/mpls-vpn add rd 65000:1 label 1000 2001:db8:5602::/48
			}
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=10s
