# Test: a configured VPN-IPv6 route keeps the 24-octet Next Hop field when the
# speaker shares no subnet with both the recipient and the global next hop.
#
# RFC requirement: RFC4659-3.2.1.1-3 negative -- the `link-local fe80::1` leaf is configured and the recipient ::1 is on the connected ::1/128, but the global next hop fd00::2 is on no prefix shared with it, so the MP_REACH_NLRI Next Hop field is 24 octets (zero RD plus fd00::2) and fe80::1 never appears.
#
# RFC 4659 Section 3.2.1.1: "The link-local address shall be included in the
# Next Hop field if and only if the advertising BGP speaker shares a common
# subnet with the peer the route is being advertised to [BGP-IPv6]." The cited
# RFC 2545 Section 3 condition is joint: the common subnet must hold the global
# next hop and the recipient together (linkScope.linkLocalNextHop,
# internal/component/bgp/reactor/link_scope.go). The leaf supplies the address;
# it never decides inclusion, and this file fails if it does.
#
# The positive (48-octet) form needs a recipient on a real shared /64, which the
# loopback fixture cannot give: reactor/rfc4659_vpn_link_local_test.go and the
# bgp-vpn-frr interop scenario carry it.
#
# MP_REACH_NLRI value: AFI 0002, SAFI 80, length 18 (24), RD 0, fd00::2, reserved 00.

stdin=peer:terminator=EOF_PEER
option=bind:value=ipv6
expect=bgp:conn=1:seq=1:contains=000280180000000000000000FD00000000000000000000000000000200
reject=bgp:conn=1:pattern=FE800000000000000000000000000001
EOF_PEER

stdin=ze-bgp:terminator=EOF_CONF
bgp {
	peer peer-v6-1 {
		connection {
			remote {
				ip ::1
			}
			# Ze's next hop is not the peer's address: RFC 4271 Section 5.1.3
			# withholds a route advertised with the peer's own address.
			local {
				ip fd00::2
				accept false
			}
		}
		session {
			asn {
				local 12345
				remote 12345
			}
			router-id 127.0.0.2
			link-local fe80::1
			family {
				ipv6/mpls-vpn { prefix { maximum 10000; } }
			}
		}
		update {
			attribute {
				origin igp
				next-hop self
			}
			nlri {
				ipv6/mpls-vpn add rd 65000:1 label 1000 2001:db8:5602::/48
			}
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=10s
