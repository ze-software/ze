# Test: the config path reaches the RFC 8955 Section 7.4 type 0x81 rt-redirect,
#       and an IPv6 redirect-to-nexthop reaches the RFC 5701 attribute 25.
# VALIDATES: `extended-community [redirect:<IPv4>:<value>]` encodes type 0x81, and
#            `extended-community [redirect-to-nexthop <IPv6>]` encodes a 20-octet
#            IPv6-address-specific community in IPV6_EXTENDED_COMMUNITIES.
#            `copy-to-nexthop <IPv4>` and `copy-to-nexthop <IPv6>` encode the same
#            redirect-to-IP communities with the copy bit set
#            (draft-ietf-idr-flowspec-redirect-ip-16 Section 2): 010C 01020304 0001,
#            the bytes ExaBGP 6.0 sends for `copy 1.2.3.4`, and 000C <IPv6> 0001.
# PREVENTS: the type 0x81 form staying unimplemented, the 20-octet encoder
#           staying unreachable because the 8-octet parser refused the string first,
#           and the copy flag being unreachable from config.
stdin=peer:terminator=EOF_PEER
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0045020000002E800E1200018500000C0120C0A8000102200A0000014001010040020040050400000064C010088108C00002010064
expect=bgp:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0051020000003A800E1200018500000C0120C0A8000202200A0000014001010040020040050400000064C01914000C2A020B800000000100000000000000010000
expect=bgp:conn=1:seq=3:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0045020000002E800E1200018500000C0120C0A8000302200A0000014001010040020040050400000064C01008010C010203040001
expect=bgp:conn=1:seq=4:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0051020000003A800E1200018500000C0120C0A8000402200A0000014001010040020040050400000064C01914000C2A020B800000000100000000000000010001
EOF_PEER

stdin=ze-bgp:terminator=EOF_CONF
bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65500
				remote 65500
			}
			router-id 10.0.0.1
			family {
				ipv4/flow { prefix { maximum 10000; } }
			}
		}
		behavior {
			group-updates disable
		}

		# Route 1: rt-redirect whose administrator is an IPv4 address.
		# RFC 8955 Section 7.4 type 0x81: 4-octet IPv4 address, 2-octet value.
		update {
			attribute {
				extended-community [redirect:192.0.2.1:100]
			}
			nlri {
				ipv4/flow add destination-ipv4 192.168.0.1/32 source-ipv4 10.0.0.1/32
			}
		}

		# Route 2: redirect-to-nexthop with an IPv6 address.
		# RFC 5701 Section 2: a 20-octet IPv6-address-specific community, which
		# rides IPV6_EXTENDED_COMMUNITIES (attribute 25, 0xC019) because a
		# 16-octet global administrator does not fit the 8-octet form.
		update {
			attribute {
				extended-community [redirect-to-nexthop 2a02:b80:0:1::1]
			}
			nlri {
				ipv4/flow add destination-ipv4 192.168.0.2/32 source-ipv4 10.0.0.1/32
			}
		}

		# Route 3: copy-to-nexthop with an IPv4 address: the redirect-to-IPv4
		# community with the copy bit, the low bit of the local administrator.
		update {
			attribute {
				extended-community [copy-to-nexthop 1.2.3.4]
			}
			nlri {
				ipv4/flow add destination-ipv4 192.168.0.3/32 source-ipv4 10.0.0.1/32
			}
		}

		# Route 4: copy-to-nexthop with an IPv6 address: attribute 25, copy bit set.
		update {
			attribute {
				extended-community [copy-to-nexthop 2a02:b80:0:1::1]
			}
			nlri {
				ipv4/flow add destination-ipv4 192.168.0.4/32 source-ipv4 10.0.0.1/32
			}
		}
	}
}
EOF_CONF

# Process orchestration
# flowspec plugin auto-loaded because ipv4/flow family is configured
cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=10s
