# Test: SR Policy origination with 20-bit labels at the top of the range, config-driven
# VALIDATES: a configured binding-sid mpls 1048575 and type-a mpls 1048575 reach the wire
#            as label 0xFFFFF in both sub-TLVs (0D060000FFFFF000 and 01060000FFFFF000),
#            with TC, S and TTL zero.
# PREVENTS: a label at the top of the 20-bit range being refused or encoded with lost bits
#           (spec-bgp-sr-policy-rfc-defects D2).
# RFC 3032 Section 2.1: "This 20-bit field carries the actual value of the Label."
# ze-peer expectations
stdin=peer:terminator=EOF_PEER
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00690200000052800E1600014904C0000201006000000000000000640A0000014001010040020040050400000064C01728000F00240C060000000000640D060000FFFFF00080001100090600000000000101060000FFFFF000
EOF_PEER

# ze bgp configuration
stdin=ze-bgp:terminator=EOF_CONF
bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65000
			}
			router-id 192.0.2.1
			family {
				ipv4/sr-policy { prefix { maximum 10000; } }
			}
		}

		update {
			attribute {
				next-hop 192.0.2.1
			}
			nlri {
				ipv4/sr-policy add distinguisher 0 color 100 endpoint 10.0.0.1 preference 100 binding-sid mpls 1048575 segment-list weight 1 segment type-a mpls 1048575
			}
		}
	}
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=10s
