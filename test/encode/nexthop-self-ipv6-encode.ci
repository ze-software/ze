# Test: `next-hop self` stamps Ze's local session address in MP_REACH_NLRI
#
# The peer is ::1 and Ze's local address on the session is fd00::2, so the
# MP_REACH next hop this file asserts (FD00...0002) is Ze's own address and not
# the peer's. RFC 4271 Section 5.1.3 forbids advertising a route to a peer using
# that peer's address as NEXT_HOP, and originatedNextHopIsPeerOwn
# (internal/component/bgp/reactor/forward_next_hop.go) withholds such a route,
# so a fixture giving both session ends one address would assert a frame Ze must
# never send. test/plugin/relay-withdraw-nexthop-self.ci carries the long form of
# that reasoning.

# ze-peer expectations
stdin=peer:terminator=EOF_PEER
option=bind:value=ipv6
cmd=api:conn=1:seq=1:text=peer * update text origin igp local-preference 100 nhop fd00::2 nlri ipv6/unicast add 2a04:6d80::1/128
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF004E02000000374001010040020040050400000064800E2600020110FD00000000000000000000000000000200802A046D80000000000000000000000001
cmd=api:conn=1:seq=1:text=peer * update text nlri ipv6/unicast eor
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF001E0200000007900F0003000201
EOF_PEER

# ze bgp configuration
stdin=ze-bgp:terminator=EOF_CONF
bgp {
	group default {
		peer peer-v6-1 {
			connection {
				remote {
					ip ::1
				}
				# Ze's local address is deliberately not the peer's: `next-hop
				# self` resolves to it, and a shared address would be withheld.
				local {
					ip fd00::2
					accept false
				}
			}
			session {
				asn {
					local 12345
					remote 12345
				}
				router-id 127.0.0.2
				family {
					ipv6/unicast { prefix { maximum 10000; } }
				}
			}

			update {
				attribute {
					origin igp
					next-hop self
				}
				nlri {
					ipv6/unicast add 2a04:6d80::1/128
				}
			}
		}
	}
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=10s
