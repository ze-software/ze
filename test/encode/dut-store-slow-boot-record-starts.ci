# Test: a disk-store DUT whose boot record holds the store for longer than the
#       plugin stall window still starts, opens its session and sends.
# VALIDATES: the boot record runs after ze serves, so no store read inside the
#            plugin startup handshake (bgp reads its Graceful Restart marker at
#            Stage 2) waits behind the record's syncs.
# PREVENTS: on a disk another writer saturates, every startup failing with
#           "stage stalled ... no plugin progress ... waiting for stage 3"
#           (plan/journal/plugin-startup-barrier-deadlock.md, 2026-10-20).
option=storage:value=disk
# The boot record holds the store for longer than the plugin stall window
# (12s at this budget): a store read inside the startup handshake would wait
# for it, and the barrier would fail the start.
option=timeout:value=15s
option=env:var=ze.test.boot.record.hold:value=14s
tmpfs=slow-boot-record.conf:terminator=EOF_CONF
bgp {
	# RFC 8212: an EBGP direction with no policy is refused; this test exchanges routes.
	filter {
		import { final accept; }
		export { final accept; }
	}
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65533
				remote 65000
			}
			router-id 10.0.0.2
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
		}
		timer {
			receive-hold-time 180
		}

		update {
			attribute {
				origin igp
				next-hop 10.0.1.254
				local-preference 200
			}
			nlri {
				ipv4/unicast add 10.0.0.0/24
			}
		}
	}
}
EOF_CONF

option=file:path=slow-boot-record.conf
option=asn:value=65000
cmd=api:conn=1:seq=1:text=send bgp * update text origin igp as-path [65533] nhop 10.0.1.254 nlri add 10.0.0.0/24
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002F02000000144001010040020602010000FFFD4003040A0001FE180A0000
expect=json:conn=1:seq=1:json={"meta":{"version":"1.0.0","format":"ze-bgp"},"message":{"type":"update"},"as-path":[65533],"origin":"igp","ipv4/unicast":[{"action":"add","nlri":["10.0.0.0/24"],"next-hop":"10.0.1.254"}]}
cmd=api:conn=1:seq=1:text=send bgp * update text nlri eor
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
expect=file:glob=database:exists=true
