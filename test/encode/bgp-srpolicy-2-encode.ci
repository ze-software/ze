# ze-peer expectations
stdin=peer:terminator=EOF_PEER
cmd=api:conn=1:seq=1:text=peer * update text nhop 2001:db8::2 nlri ipv6/sr-policy distinguisher 0 color 100 endpoint 2001:db8::1 preference 100 segment-list weight 1 segment type-b srv6 2001:db8:1::1
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0085020000006E4001010040020040050400000064800E2E0002491020010DB800000000000000000000000200C0000000000000006420010DB8000000000000000000000001C0172C000F00280C0600000000006480001D0009060000000000010D12000020010DB8000100000000000000000001
EOF_PEER

# ze bgp configuration
stdin=ze-bgp:terminator=EOF_CONF
bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65000
			}
			router-id 192.0.2.1
			family {
				ipv6/sr-policy { prefix { maximum 10000; } }
			}
		}

		update {
			attribute {
				next-hop 2001:db8::2
			}
			nlri {
				ipv6/sr-policy add distinguisher 0 color 100 endpoint 2001:db8::1 preference 100 segment-list weight 1 segment type-b srv6 2001:db8:1::1
			}
		}
	}
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=10s
