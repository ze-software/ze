# A static ipv4/mpls-vpn route with no path-information, sent over an
# ADD-PATH session. The route reaches UpdateBuilder.BuildVPN with PathID 0
# (reactor/peer_static_routes.go toStaticRouteVPNParams). RFC 7911 Section 3:
# with ADD-PATH negotiated the 4-octet Path Identifier precedes the Length
# octet, so the NLRI must read 00000000 then 70, never 70 alone.

# ze-peer expectations
stdin=peer:terminator=EOF_PEER
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0066020000004F800E240001800C0000000000000000C0A8000100000000007004E2C100000064000000640A000040010100400200400304C0A8000140050400000064C0101000020000000000000002000100000001
EOF_PEER

# ze bgp configuration
stdin=ze-bgp:terminator=EOF_CONF
bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/mpls-vpn { prefix { maximum 10000; } }
			}
			capability {
				add-path {
					direction send/receive
					family {
						ipv4/mpls-vpn
					}
				}
			}
		}
		behavior {
			group-updates disable
		}

		update {
			attribute {
				origin igp
				next-hop 192.168.0.1
				local-preference 100
				extended-community [ target:0:0 target:1:1 ]
			}
			nlri {
				ipv4/mpls-vpn add rd 100:100 label 20012 10.0.0.0/24
			}
		}
	}
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=10s
