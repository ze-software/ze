# ze-peer expectations
stdin=peer:terminator=EOF_PEER
# single flow test
# copy-to-nexthop (0x0800) redirects to the MP_REACH_NLRI next hop
# (draft-simpson-idr-flowspec-redirect-02 Section 3), so 1.2.3.4 is carried
# with length 4 rather than RFC 8955's zero length.
cmd=api:conn=1:seq=1:text=send bgp * update text extended-community [copy-to-nexthop] nhop 1.2.3.4 mp ipv4/flow add source-ipv4 10.0.0.2/32
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0043020000002C800E100001850401020304000602200A0000024001010040020040050400000064C010080800000000000001
expect=json:conn=1:seq=1:json={"meta":{"version":"1.0.0","format":"ze-bgp"},"message":{"type":"update"},"origin":"igp","local-preference":100,"extended-community":[{"string":"0x0800:000000000001","value":576460752303423489}],"ipv4/flow":[{"action":"add","nlri":{"source-ipv4":[["10.0.0.2/32/0"]],"next-hop":"1.2.3.4"}}]}
cmd=api:conn=1:seq=2:text=send bgp * update text mp ipv4/flow eor
expect=bgp:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF001E0200000007900F0003000185
EOF_PEER

# ze bgp configuration
stdin=ze-bgp:terminator=EOF_CONF
bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/flow { prefix { maximum 10000; } }
			}
		}
		behavior {
			group-updates disable
		}


		update {
			attribute {
				next-hop 1.2.3.4
				extended-community [copy-to-nexthop]
			}
			nlri {
				ipv4/flow add source-ipv4 10.0.0.2/32
			}
		}
	}
}
EOF_CONF

# Process orchestration
# flowspec plugin auto-loaded because ipv4/flow family is configured
cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=10s
