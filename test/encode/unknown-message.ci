# ze-peer expectations
stdin=peer:terminator=EOF_PEER
option=open:value=send-unknown-message
# RFC 4271 Section 6.1: "the Error Subcode MUST be set to Bad Message Type. The
# Data field MUST contain the erroneous Type field." So the NOTIFICATION is
# Message Header Error (1), Bad Message Type (3), and one octet carrying 255.
#
# It used to be subcode 0 with the ASCII sentence "can not decode update message
# of type 255", which told a peer nothing a machine can act on and named a
# subcode RFC 4271 does not define for this case. This expectation was the
# violation with a green bar on top.
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0016030103FF
EOF_PEER

# ze bgp configuration
stdin=ze-bgp:terminator=EOF_CONF
bgp {
	group default {
		peer peer1 {
			connection {
				remote {
					ip 127.0.0.1
				}
				local {
					ip 127.0.0.1
					accept false
				}
			}
			session {
				asn {
					local 1
					remote 1
				}
				router-id 1.2.3.4
				family {
					ipv4/unicast { prefix { maximum 10000; } }
				}
			}

		}
	}
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=10s
