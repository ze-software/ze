# RFC requirement: RFC2545-3-1 negative -- the Next Hop field carries the global address
# alone when the speaker has no link-local to append. The peer declares no link-local, and
# the MP_REACH_NLRI asserted byte for byte below is 800E26 0002 01 10 followed by ONE
# 16-octet address (2a02:b80:0:2::1). Nothing is appended, so "potentially followed by the
# link-local IPv6 address of the next hop" stays conditional. An encoder that always wrote
# a second address fails this assertion.
#
# RFC requirement: RFC2545-3-2 negative -- the Length of Next Hop Network Address octet is
# 0x10 (16), not 0x20, when only a global address is present.
#
# RFC requirement: RFC2545-3-4 positive -- the "in all other cases" branch. No link-local
# is configured for this peer, so the speaker advertises only the global IPv6 address of
# the next hop and sets the length octet to 16.
#
# Both expect=json lines carry the COMMUNITIES attribute. The hex assertion above
# each one pins it as C0 08 08 78140000 78147814, and the JSON comparison is
# symmetric, so a missing key asserts the attribute is ABSENT. That passed only
# while parsePathAttributesZe (internal/component/bgp/cli/decode_update.go) had no
# arm for code 8 and dropped it silently.
#
# ze-peer expectations
stdin=peer:terminator=EOF_PEER
cmd=api:conn=1:seq=1:text=peer * update text origin igp local-preference 200 community [30740:0 30740:30740] nhop 2a02:b80:0:2::1 nlri ipv6/unicast add 2a02:b80:0:1::1/128
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0059020000004240010100400200400504000000C8C008087814000078147814800E26000201102A020B8000000002000000000000000100802A020B80000000010000000000000001
expect=json:conn=1:seq=1:json={"meta":{"version":"1.0.0","format":"ze-bgp"},"message":{"type":"update"},"peer":{"address":"127.0.0.1","remote":{"as":65533}},"direction":"in","community":["30740:0","30740:30740"],"local-preference":200,"origin":"igp","ipv6/unicast":[{"action":"add","nlri":["2a02:b80:0:1::1/128"],"next-hop":"2a02:b80:0:2::1"}]}
cmd=api:conn=1:seq=1:text=peer * update text origin igp local-preference 200 community [30740:0 30740:30740] nhop 2a02:b80:0:2::1 nlri ipv6/unicast add 2a02:b80:0:1::2/128
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0059020000004240010100400200400504000000C8C008087814000078147814800E26000201102A020B8000000002000000000000000100802A020B80000000010000000000000002
expect=json:conn=1:seq=1:json={"meta":{"version":"1.0.0","format":"ze-bgp"},"message":{"type":"update"},"peer":{"address":"127.0.0.1","remote":{"as":65533}},"direction":"in","community":["30740:0","30740:30740"],"local-preference":200,"origin":"igp","ipv6/unicast":[{"action":"add","nlri":["2a02:b80:0:1::2/128"],"next-hop":"2a02:b80:0:2::1"}]}
cmd=api:conn=1:seq=1:text=peer * update text nlri ipv6/unicast eor
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF001E0200000007900F0003000201
EOF_PEER

# ze bgp configuration
stdin=ze-bgp:terminator=EOF_CONF
bgp {
	group a-few-routes {
		update {
			attribute {
				origin igp
				next-hop 2A02:B80:0:2::1
				local-preference 200
				community [ 30740:0 30740:30740 ]
			}
			nlri {
				ipv6/unicast add 2A02:B80:0:1::1/128
			}
		}

		peer peer1 {
			connection {
				remote {
					ip 127.0.0.1
				}
				local {
					ip 127.0.0.1
					accept false
				}
			}
			session {
				asn {
					local 65533
					remote 65533
				}
				router-id 10.0.0.2
				family {
					ipv6/unicast { prefix { maximum 10000; } }
				}
			}
			description "a simple test for the new configuration format name"
			timer {
				receive-hold-time 180
			}

			update {
				attribute {
					origin igp
					next-hop 2A02:B80:0:2::1
					local-preference 200
					community [ 30740:0 30740:30740 ]
				}
				nlri {
					ipv6/unicast add 2A02:B80:0:1::2/128
				}
			}
		}
	}
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=10s
