# ze bgp configuration
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external service-watchdog {
		run "ze-test fixture encode/watchdog-encode"
		encoder json
	}
}
bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65533
				remote 65533
			}
			router-id 10.0.0.10
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
		}

		update {
			attribute {
				origin igp
				next-hop 1.2.3.4
			}
			nlri {
				ipv4/unicast add 66.66.66.66/32 88.88.88.88/32
			}
		}
		update {
			attribute {
				origin igp
				next-hop 192.168.1.100
			}
			nlri {
				ipv4/unicast add 100.100.100.100/32
			}
		}
		update {
			attribute {
				origin igp
				next-hop 1.2.3.4
			}
			nlri {
				ipv4/unicast add 77.77.77.77/32
			}
			watchdog {
				name dnsr
				withdraw true
			}
		}
		attach process bgp-watchdog {
			receive [ state ]
			send [ update ]
		}
	}
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze --plugin ze.bgp-watchdog -:stdin=ze-bgp:timeout=10s
