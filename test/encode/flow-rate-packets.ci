# ze-peer expectations
stdin=peer:terminator=EOF_PEER
# FlowSpec traffic-rate-packets (RFC 8955 Section 7.2)
cmd=api:conn=1:seq=1:text=peer * update text extended-community [rate-limit:1000:packets] nlri ipv4/flow add source-ipv4 10.0.1.0/24 protocol tcp destination-port =3128
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0045020000002E4001010040020040050400000064800E1200018500000C02180A000103810605910C38C01008800C0000447A0000
cmd=api:conn=1:seq=2:text=peer * update text nlri ipv4/flow eor
expect=bgp:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF001E0200000007900F0003000185
EOF_PEER

# ze bgp configuration
stdin=ze-bgp:terminator=EOF_CONF
bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/flow { prefix { maximum 10000; } }
			}
		}
		behavior {
			group-updates disable
		}

		update {
			attribute {
				extended-community [rate-limit:1000:packets]
			}
			nlri {
				ipv4/flow add source-ipv4 10.0.1.0/24 protocol =tcp destination-port =3128
			}
		}
	}
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=10s
