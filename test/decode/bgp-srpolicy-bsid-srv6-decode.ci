# Test: ze bgp decode shows the SRv6 Binding SID sub-TLV of a received SR Policy
# VALIDATES: a type-13 Binding SID sub-TLV of Length 18 is shown as the SRv6 SID it
#            carries (2001:db8::b5).
# PREVENTS: a received SRv6 BSID shown only as raw attribute hex.
# Companion: bgp-srpolicy-bsid-srv6-long-decode.ci holds the Length 20 case.
# RFC 9830 Section 2.4.2: "If the length is 18, then the BSID contains a 16-octet
# SRv6 SID."
stdin=payload:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0075020000005E4001010040020040050400000064800E1600014904C0000201006000000000000000640A000001C01734000F00300C060000000000640D12000020010DB80000000000000000000000B58000110009060000000000010106000003E81000
cmd=foreground:seq=1:exec=ze bgp decode --json --family ipv4/sr-policy -:stdin=payload
expect=json:json={"bgp":{"message":{"direction":"received","id":0,"type":"update"},"peer":{"address":"127.0.0.1","remote":{"as":65533}},"update":{"attr":{"local-preference":{"optional":false,"partial":false,"transitive":true,"value":100},"origin":{"optional":false,"partial":false,"transitive":true,"value":"igp"},"tunnel-encapsulation":{"optional":true,"partial":false,"transitive":true,"value":{"tunnels":[{"sub-tlvs":[{"type":12,"value":"000000000064"},{"flags":0,"name":"binding-sid","srv6-sid":"2001:db8::b5","type":13},{"type":128,"value":"0009060000000000010106000003e81000"}],"tunnel-type":15}]}}},"ipv4/sr-policy":[{"action":"add","next-hop":"192.0.2.1","nlri":[{"color":100,"distinguisher":0,"endpoint":"10.0.0.1"}]}]}},"type":"bgp"}
