# Test: managed config push is transactionally committed or rejected
# VALIDATES: AC-9 and AC-10 -- managed push ACKs only after runtime commit succeeds or fails.
# PREVENTS: managed client ACKing hub config before candidate promotion or after failed verify.

option=timeout:value=90s

tmpfs=managed-reject-plugin.run:mode=755:terminator=EOF_PLUGIN
#!/usr/bin/env python3
import sys
from ze_api import API


def has_rejected_router_id(params):
    for section in params.get('sections', []):
        if section.get('root') == 'bgp' and '2.2.2.2' in section.get('data', ''):
            return True
    return False


def main():
    api = API()
    api.declare_config('bgp')
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()

    def verify(params):
        if has_rejected_router_id(params):
            print('OK: rejecting managed candidate router-id 2.2.2.2', file=sys.stderr)
            return {'status': 'error', 'error': 'reject router-id 2.2.2.2'}
        return {'status': 'ok'}

    api.on_config_verify(verify)
    api.ready()
    api.wait_for_post_startup(timeout=5.0)
    api.wait_for_shutdown(timeout=30.0)


if __name__ == '__main__':
    main()
EOF_PLUGIN

tmpfs=managed_config_push_e2e.go:terminator=EOF_GO
package main

import (
    "bufio"
    "bytes"
    "crypto/ed25519"
    "crypto/rand"
    "crypto/sha256"
    "crypto/tls"
    "crypto/x509"
    "crypto/x509/pkix"
    "encoding/base64"
    "encoding/hex"
    "encoding/json"
    "encoding/pem"
    "flag"
    "fmt"
    "io"
    "math/big"
    "net"
    "os"
    "os/exec"
    "path/filepath"
    "strconv"
    "strings"
    "syscall"
    "time"
)

const (
    clientName = "edge-01"
    token = "edge-secret-that-is-at-least-32chars"
    serverSecret = "local-server-secret-that-is-at-least-32chars"
)

type configAck struct {
    Version string `json:"version"`
    OK      bool   `json:"ok"`
    Error   string `json:"error,omitempty"`
}

type configFetchResponse struct {
    Version string `json:"version,omitempty"`
    Config  string `json:"config,omitempty"`
    Status  string `json:"status,omitempty"`
}

func main() {
    scenario := flag.String("scenario", "both", "scenario: success, reject, or both")
    hubPort := flag.Int("hub-port", 0, "fake hub listen port")
    pluginPort := flag.Int("plugin-port", 0, "ze plugin hub listen port")
    flag.Parse()

    if *hubPort == 0 || *pluginPort == 0 {
        failf("hub-port and plugin-port are required")
    }

    scenarios := []string{*scenario}
    if *scenario == "both" {
        scenarios = []string{"success", "reject"}
    }
    for _, name := range scenarios {
        if err := runScenario(name, *hubPort, *pluginPort); err != nil {
            failf("%s: %v", name, err)
        }
    }
    fmt.Fprintln(os.Stderr, "OK: managed config push committed and rejected transactionally")
}

func failf(format string, args ...any) {
    fmt.Fprintf(os.Stderr, "FAIL: "+format+"\n", args...)
    os.Exit(1)
}

func runScenario(name string, hubPort, pluginPort int) error {
    reject := name == "reject"
    if name != "success" && name != "reject" {
        return fmt.Errorf("unknown scenario %q", name)
    }

    cwd, err := os.Getwd()
    if err != nil {
        return err
    }
    cfgDir, err := os.MkdirTemp(cwd, "managed-"+name+"-")
    if err != nil {
        return err
    }
    dbPath := filepath.Join(cfgDir, "database.zefs")
    env := append(os.Environ(),
        "ZE_CONFIG_DIR="+cfgDir,
        "ZE_MANAGED_TLS_INSECURE=true",
        "NO_COLOR=1",
        "ze_test_bgp_port="+strconv.Itoa(pluginPort+1000),
    )

    if _, err := runCommand(env, "admin\nsecret123\n127.0.0.1\n2222\n"+clientName+"\n", "ze", "init", "--managed"); err != nil {
        return err
    }

    active := managedConfig("1.1.1.1", hubPort, pluginPort, reject)
    pushed := managedConfig("2.2.2.2", hubPort, pluginPort, reject)
    activePath := filepath.Join(cfgDir, clientName+".conf")
    if err := os.WriteFile(activePath, []byte(active), 0o600); err != nil {
        return err
    }
    if _, err := runCommand(env, "", "ze", "data", "--path", dbPath, "import", activePath); err != nil {
        return err
    }

    ackCh, hubErrCh, closeHub, err := startFakeHub(hubPort, token, []byte(pushed))
    if err != nil {
        return err
    }
    defer closeHub()

    var zeOutput bytes.Buffer
    zeCmd := exec.Command("ze", "start")
    zeCmd.Env = env
    zeCmd.Stdout = &zeOutput
    zeCmd.Stderr = &zeOutput
    if err := zeCmd.Start(); err != nil {
        return fmt.Errorf("start ze: %w", err)
    }
    zeDone := make(chan error, 1)
    go func() { zeDone <- zeCmd.Wait() }()

    var ack configAck
    select {
    case ack = <-ackCh:
    case err := <-hubErrCh:
        stopProcess(zeCmd, zeDone)
        return fmt.Errorf("fake hub: %w\nze output:\n%s", err, zeOutput.String())
    case err := <-zeDone:
        return fmt.Errorf("ze exited before config ack: %v\n%s", err, zeOutput.String())
    case <-time.After(35 * time.Second):
        stopProcess(zeCmd, zeDone)
        return fmt.Errorf("timed out waiting for config ack\nze output:\n%s", zeOutput.String())
    }
    stopProcess(zeCmd, zeDone)

    expectedVersion := versionHash([]byte(pushed))
    if ack.Version != expectedVersion {
        return fmt.Errorf("ack version %q, want %q", ack.Version, expectedVersion)
    }
    if reject {
        if ack.OK {
            return fmt.Errorf("reject scenario ACK was OK")
        }
        if !strings.Contains(ack.Error, "reject router-id 2.2.2.2") {
            return fmt.Errorf("reject scenario ACK error %q", ack.Error)
        }
    } else if !ack.OK {
        return fmt.Errorf("success scenario ACK failed: %s", ack.Error)
    }

    activeData, err := runCommand(env, "", "ze", "data", "--path", dbPath, "cat", "file/active/"+clientName+".conf")
    if err != nil {
        return err
    }
    activeText := string(activeData)
    if reject {
        if !strings.Contains(activeText, "router-id 1.1.1.1") || strings.Contains(activeText, "router-id 2.2.2.2") {
            return fmt.Errorf("rejected push changed active config:\n%s", activeText)
        }
    } else if !strings.Contains(activeText, "router-id 2.2.2.2") {
        return fmt.Errorf("accepted push did not update active config:\n%s", activeText)
    }

    if data, err := runCommand(env, "", "ze", "data", "--path", dbPath, "cat", "meta/config/candidate"); err == nil {
        return fmt.Errorf("candidate pointer remains after %s scenario: %s", name, data)
    }
    return nil
}

func managedConfig(routerID string, hubPort, pluginPort int, reject bool) string {
    var b strings.Builder
    b.WriteString("plugin {\n")
    b.WriteString("  hub {\n")
    fmt.Fprintf(&b, "    client %s { host 127.0.0.1; port %d; secret \"%s\"; }\n", clientName, hubPort, token)
    if reject {
        fmt.Fprintf(&b, "    server local { ip 127.0.0.1; port %d; secret \"%s\"; }\n", pluginPort, serverSecret)
    }
    b.WriteString("  }\n")
    if reject {
        b.WriteString("  external managed-reject-plugin { run ./managed-reject-plugin.run; encoder json; }\n")
    }
    b.WriteString("}\n")
    fmt.Fprintf(&b, "bgp {\n  router-id %s\n", routerID)
    if reject {
        b.WriteString("  session { asn { local 1; } }\n")
        b.WriteString("  peer peer1 {\n")
        b.WriteString("    connection { remote { ip 127.0.0.1; } local { ip 127.0.0.1; accept false; } }\n")
        b.WriteString("    session { asn { remote 1; } router-id 1.2.3.4; family { ipv4/unicast { prefix { maximum 10000; } } } }\n")
        b.WriteString("    behavior { group-updates disable; }\n")
        b.WriteString("    attach process managed-reject-plugin { }\n")
        b.WriteString("  }\n")
    }
    b.WriteString("}\n")
    return b.String()
}

func startFakeHub(port int, expectedToken string, configData []byte) (<-chan configAck, <-chan error, func(), error) {
    cert, err := selfSignedCert()
    if err != nil {
        return nil, nil, nil, err
    }
    ln, err := tls.Listen("tcp", fmt.Sprintf("127.0.0.1:%d", port), &tls.Config{
        Certificates: []tls.Certificate{cert},
        MinVersion:   tls.VersionTLS13,
    })
    if err != nil {
        return nil, nil, nil, err
    }

    ackCh := make(chan configAck, 1)
    errCh := make(chan error, 1)
    go func() {
        conn, err := ln.Accept()
        if err != nil {
            errCh <- err
            return
        }
        defer conn.Close()
        if err := handleHubConnection(conn, expectedToken, configData, ackCh); err != nil {
            errCh <- err
        }
    }()

    return ackCh, errCh, func() { _ = ln.Close() }, nil
}

func handleHubConnection(conn net.Conn, expectedToken string, configData []byte, ackCh chan<- configAck) error {
    reader := bufio.NewReader(conn)

    id, verb, payload, err := readRPCLine(reader)
    if err != nil {
        return err
    }
    if verb != "auth" {
        return fmt.Errorf("expected auth, got %s", verb)
    }
    var auth struct {
        Token string `json:"token"`
        Name  string `json:"name"`
    }
    if err := json.Unmarshal(payload, &auth); err != nil {
        return err
    }
    if auth.Token != expectedToken || auth.Name != clientName {
        return fmt.Errorf("bad auth name=%q token-ok=%t", auth.Name, auth.Token == expectedToken)
    }
    if err := writeOK(conn, id, nil); err != nil {
        return err
    }

    id, verb, _, err = readRPCLine(reader)
    if err != nil {
        return err
    }
    if verb != "config-fetch" {
        return fmt.Errorf("expected config-fetch, got %s", verb)
    }
    resp := configFetchResponse{
        Version: versionHash(configData),
        Config:  base64.StdEncoding.EncodeToString(configData),
    }
    if err := writeOK(conn, id, resp); err != nil {
        return err
    }

    id, verb, payload, err = readRPCLine(reader)
    if err != nil {
        return err
    }
    if verb != "config-ack" {
        return fmt.Errorf("expected config-ack, got %s", verb)
    }
    var ack configAck
    if err := json.Unmarshal(payload, &ack); err != nil {
        return err
    }
    ackCh <- ack
    return writeOK(conn, id, nil)
}

func readRPCLine(reader *bufio.Reader) (uint64, string, []byte, error) {
    line, err := reader.ReadString('\n')
    if err != nil {
        return 0, "", nil, err
    }
    line = strings.TrimRight(line, "\r\n")
    if !strings.HasPrefix(line, "#") {
        return 0, "", nil, fmt.Errorf("missing RPC prefix: %q", line)
    }
    idPart, rest, ok := strings.Cut(line[1:], " ")
    if !ok {
        return 0, "", nil, fmt.Errorf("missing RPC verb: %q", line)
    }
    id, err := strconv.ParseUint(idPart, 10, 64)
    if err != nil {
        return 0, "", nil, err
    }
    verb, payload, _ := strings.Cut(rest, " ")
    return id, verb, []byte(payload), nil
}

func writeOK(w io.Writer, id uint64, payload any) error {
    if payload == nil {
        _, err := fmt.Fprintf(w, "#%d ok\n", id)
        return err
    }
    data, err := json.Marshal(payload)
    if err != nil {
        return err
    }
    _, err = fmt.Fprintf(w, "#%d ok %s\n", id, data)
    return err
}

func versionHash(data []byte) string {
    sum := sha256.Sum256(data)
    return hex.EncodeToString(sum[:8])
}

func selfSignedCert() (tls.Certificate, error) {
    pub, priv, err := ed25519.GenerateKey(rand.Reader)
    if err != nil {
        return tls.Certificate{}, err
    }
    tmpl := &x509.Certificate{
        SerialNumber: big.NewInt(time.Now().UnixNano()),
        Subject:      pkix.Name{CommonName: "managed-test-hub"},
        NotBefore:    time.Now().Add(-time.Minute),
        NotAfter:     time.Now().Add(time.Hour),
        KeyUsage:     x509.KeyUsageDigitalSignature,
        ExtKeyUsage:  []x509.ExtKeyUsage{x509.ExtKeyUsageServerAuth},
        IPAddresses:  []net.IP{net.ParseIP("127.0.0.1")},
    }
    der, err := x509.CreateCertificate(rand.Reader, tmpl, tmpl, pub, priv)
    if err != nil {
        return tls.Certificate{}, err
    }
    keyDER, err := x509.MarshalPKCS8PrivateKey(priv)
    if err != nil {
        return tls.Certificate{}, err
    }
    certPEM := pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: der})
    keyPEM := pem.EncodeToMemory(&pem.Block{Type: "PRIVATE KEY", Bytes: keyDER})
    return tls.X509KeyPair(certPEM, keyPEM)
}

func runCommand(env []string, stdin string, name string, args ...string) ([]byte, error) {
    cmd := exec.Command(name, args...)
    cmd.Env = env
    if stdin != "" {
        cmd.Stdin = strings.NewReader(stdin)
    }
    out, err := cmd.CombinedOutput()
    if err != nil {
        return out, fmt.Errorf("%s %s: %w\n%s", name, strings.Join(args, " "), err, string(out))
    }
    return out, nil
}

func stopProcess(cmd *exec.Cmd, done <-chan error) {
    if cmd.Process == nil {
        return
    }
    _ = cmd.Process.Signal(syscall.SIGTERM)
    select {
    case <-done:
    case <-time.After(5 * time.Second):
        _ = cmd.Process.Kill()
        <-done
    }
}
EOF_GO

cmd=foreground:seq=1:exec=go run ./managed_config_push_e2e.go -hub-port $PORT -plugin-port $PORT2 -scenario both:timeout=90s
expect=exit:code=0
expect=stderr:contains=OK: managed config push committed and rejected transactionally
