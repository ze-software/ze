# Ze PPPoE-client image for the accel-ppp interop lab.
# Privileged container shares the host kernel for PPPoE (pppox) and /dev/ppp.

FROM golang:1.26-alpine AS builder

RUN apk add --no-cache git

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .

# The `start` root command (which the lab launches ze with) and every
# compile-out-able feature are tag-gated, so an UNTAGGED build has neither: it
# answers `start` with "unknown command" and would not carry PPPoE even if it
# booted. Derive the default-on tags from feature-gates.txt -- the same single
# source of truth Makefile ZE_FEATURES, test/interop/Dockerfile.ze and
# test/interop-l2tp/Dockerfile.ze read -- so this image cannot drift from the
# shipped binary's feature set.
#
# This was the third of the three interop images to carry the untagged build.
# test/interop was fixed first, test/interop-l2tp on 2026-08-03, and the audit
# that found the second missed this one.
RUN ZE_FEATURES="$(awk '$1 ~ /^ze_/ {print $1}' feature-gates.txt | sort -u | tr '\n' ' ')" && \
    CGO_ENABLED=0 go build -tags "ze_core $ZE_FEATURES" -o /ze ./cmd/ze

FROM alpine:3.21

# iproute2: ip link/addr; ppp: /dev/ppp device support; kmod: modprobe;
# iputils: ping for the dataplane check; curl: the ze-ac scenarios read Ze's own
# session table over its REST API, which refuses any non-loopback listener (no
# TLS transport), so the request has to originate inside this container.
RUN apk add --no-cache tini iproute2 kmod ppp iputils curl

COPY --from=builder /ze /usr/local/bin/ze

ENTRYPOINT ["tini", "--", "ze"]
