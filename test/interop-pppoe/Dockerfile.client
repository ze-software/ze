# pppd + rp-pppoe PPPoE client image for the Ze access-concentrator lab.
#
# pppd with the rp-pppoe plugin is the reference CPE stack: it is what nearly
# every consumer router and every Linux PPPoE dialer runs, and it is a second
# implementation family from accel-ppp (which the Ze-as-client scenario already
# faces). pppd is built from the upstream ppp 2.5.5 release, because owner
# decision (ai/META-DECISIONS.md) has every lab peer run its latest stable
# release and Alpine 3.24 packages 2.5.3. The rp-pppoe plugin is part of that
# build (/usr/lib/pppd/2.5.5/pppoe.so).
#
# The container stays alive while the native checker drives pppd with
# `docker exec`, once per credential. The good and rejected credential are two
# runs of the same client rather than two containers.

FROM alpine:3.24.3 AS build

# sha256 of the official ppp tag archive, taken 2026-11-04.
ARG PPP_VERSION=2.5.5
ARG PPP_SHA256=5d27c1c048480139de3ba7cdca89cf455da312930473b25205a994e5fa20ef4f

RUN apk add --no-cache autoconf automake build-base curl libpcap-dev libtool linux-headers openssl-dev pkgconf scanelf

WORKDIR /src/ppp
RUN curl -fsSL -o /src/ppp.tar.gz "https://api.github.com/repos/ppp-project/ppp/tarball/v${PPP_VERSION}" \
    && echo "${PPP_SHA256}  /src/ppp.tar.gz" | sha256sum -c - \
    && tar -xzf /src/ppp.tar.gz --strip-components=1 \
    && ./autogen.sh --prefix=/usr --sysconfdir=/etc --localstatedir=/var \
    && make -j"$(nproc)" \
    && make install DESTDIR=/out \
    && rm -rf /out/usr/include /out/usr/share \
    && scanelf --needed --nobanner --format '%n#p' --recursive /out \
        | tr ',' '\n' | sort -u | sed -n 's/^./so:&/p' > /out/.ppp-rundeps

FROM alpine:3.24.3

COPY --from=build /out/ /

# iproute2: ip link/addr on the negotiated pppN; iputils: ping for the dataplane
# assertion; tcpdump: the pppoe-empty-service-name checker captures the
# discovery exchange to read the Service-Name tags Ze actually put on the wire,
# rather than trust pppd's log; tcpreplay: the pppoe-pap-ze-ac checker resends
# the client's own captured PAP Authenticate-Request from inside this container,
# so the send needs no host privilege to enter the container's network
# namespace. The rest are the shared objects pppd and its plugins need, read
# from the binaries by scanelf rather than listed by hand.
# iproute2-tc: isolate the peer LCP termination path by dropping client PADT.
RUN apk add --no-cache iproute2 iproute2-tc iputils tcpdump tcpreplay $(cat /.ppp-rundeps) \
    && rm /.ppp-rundeps

ENTRYPOINT ["sh", "-c", "mkdir -p /etc/ppp /var/log/ppp; exec tail -f /dev/null"]
