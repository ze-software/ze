# accel-ppp PPPoE access concentrator image.
#
# accel-ppp is packaged in Alpine community, and Alpine 3.24 carries 1.14.0,
# upstream's latest stable release (owner decision M14, ai/META-DECISIONS.md).
# The QEMU evidence test installs the same package via `apk add accel-ppp`. PPPoE uses the
# in-tree kernel `pppoe` (pppox) support of the shared host kernel, which the
# host provides: a lab container never loads a module. No kernel driver is
# built here.

FROM alpine:3.24.3

# accel-ppp: accel-pppd + accel-cmd; ppp: /dev/ppp support; iproute2/iputils:
# diagnostics.
RUN apk add --no-cache accel-ppp ppp iproute2 iputils

ENTRYPOINT ["sh", "-c", "mkdir -p /var/run /var/log /etc/accel-ppp; exec accel-pppd -c /etc/accel-ppp.conf -p /var/run/accel-ppp.pid"]
