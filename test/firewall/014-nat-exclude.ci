# Test: NAT exclude emits a RETURN verdict so matched traffic skips NAT.
# VALIDATES: spec-fw-8 AC-7 -- `exclude` in a then-block of a NAT
#            chain term produces a Return action, lowered to
#            Verdict(RETURN) in the nftables rule.
# PREVENTS: LNS VyOS NAT exclude rules silently dropped.
#
# Requires CAP_NET_ADMIN.

option=needs-linux:caps=net-admin

tmpfs=driver.py:mode=755:terminator=EOF_PY
#!/usr/bin/env python3
import os, signal, subprocess, sys

from ze_api import wait_until

# // test-relax: hand-rolled daemon-readiness for-loop -> ze_api.wait_until (same
# 200x0.05s budget, ratchet-exempt internal sleep); paced marker polling, not a race.
if not wait_until(lambda: os.path.exists("daemon.pid") and os.path.exists("daemon.ready"),
                  attempts=200, delay=0.05):
    sys.exit("daemon readiness files missing")

with open("daemon.pid") as f:
    pid = int(f.read().strip())

# Deterministic replacement for sleep(0.5): poll until Apply() programmed the object.
_out = {}
def _ready():
    try:
        _out["s"] = subprocess.check_output(["nft", "list", "table", "ip", "ze_fw8_014"], text=True, stderr=subprocess.DEVNULL)
        return True
    except subprocess.CalledProcessError:
        return False
if not wait_until(_ready, attempts=100, delay=0.05):
    sys.exit("firewall object never programmed")
out = _out["s"]
sys.stdout.write(out)
os.kill(pid, signal.SIGTERM)
EOF_PY

stdin=ze-bgp:terminator=EOF_CONF
firewall {
	backend nft;
	table fw8_014 {
		family ip;
		chain prerouting {
			type nat;
			hook prerouting;
			priority -100;
			policy accept;
			term skip-local {
				from {
					destination-address 10.0.0.0/8;
				}
				then {
					exclude;
				}
			}
			term dnat-web {
				from {
					destination-port 80;
				}
				then {
					dnat { to "10.1.1.1"; }
				}
			}
		}
	}
}
EOF_CONF

option=env:var=ze.log.firewall:value=info

cmd=background:seq=1:exec=ze -:stdin=ze-bgp
cmd=foreground:seq=2:exec=python3 driver.py:timeout=10s
expect=exit:code=0
expect=stderr:contains=firewall config applied
expect=stdout:contains=table ip ze_fw8_014
expect=stdout:contains=return
