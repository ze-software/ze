# Test: SIGHUP reload converges kernel state to the new firewall config.
# VALIDATES: spec-fw-10 AC-22 -- mutating the firewall section and
#            sending SIGHUP re-runs OnConfigVerify/OnConfigApply, and
#            the kernel-side ze_fw10_002 table reflects the new rule.
#            Previously-configured rules gone from the new config must
#            no longer be present.
# PREVENTS: a regression where reload quietly keeps the old rule set.
#
# Requires CAP_NET_ADMIN.

option=needs-linux:caps=net-admin

tmpfs=driver.py:mode=755:terminator=EOF_PY
#!/usr/bin/env python3
import os, shutil, signal, subprocess, sys

from ze_api import wait_until

# // test-relax: daemon-readiness for-loop -> ze_api.wait_until (ratchet-exempt sleep).
if not wait_until(lambda: os.path.exists("daemon.pid") and os.path.exists("daemon.ready"),
                  attempts=200, delay=0.05):
    sys.exit("daemon readiness files missing")

with open("daemon.pid") as f:
    pid = int(f.read().strip())

# Poll until the initial rule is programmed instead of sleep(0.5).
_b = {}
def _initial():
    try:
        _b["s"] = subprocess.check_output(["nft", "list", "table", "inet", "ze_fw10_002"], text=True, stderr=subprocess.DEVNULL)
    except subprocess.CalledProcessError:
        return False
    return "dport 22 accept" in _b["s"]
if not wait_until(_initial, attempts=100, delay=0.05):
    sys.exit("initial state missing dport 22 rule")
before = _b["s"]

shutil.copy("config2.conf", "ze-bgp.conf")
os.kill(pid, signal.SIGHUP)
# Poll until the reload converged (old rule gone, new rule present) instead of sleep(1.5).
_a = {}
def _converged():
    try:
        _a["s"] = subprocess.check_output(["nft", "list", "table", "inet", "ze_fw10_002"], text=True, stderr=subprocess.DEVNULL)
    except subprocess.CalledProcessError:
        return False
    return "dport 22 accept" not in _a["s"] and "dport 443 accept" in _a["s"]
if not wait_until(_converged, attempts=200, delay=0.05):
    sys.exit("reload did not converge; got:\n" + _a.get("s", ""))
after = _a["s"]

sys.stdout.write("reload converged: before=%d bytes, after=%d bytes\n" % (len(before), len(after)))

os.kill(pid, signal.SIGTERM)
EOF_PY

stdin=ze-bgp:terminator=EOF_CONF
firewall {
	backend nft;
	table fw10_002 {
		family inet;
		chain input {
			type filter;
			hook input;
			priority 0;
			policy drop;
			term allow-ssh {
				from { destination-port 22; }
				then { accept; }
			}
		}
	}
}
EOF_CONF

tmpfs=config2.conf:terminator=EOF_CONF2
firewall {
	backend nft;
	table fw10_002 {
		family inet;
		chain input {
			type filter;
			hook input;
			priority 0;
			policy drop;
			term allow-https {
				from { destination-port 443; }
				then { accept; }
			}
		}
	}
}
EOF_CONF2

option=env:var=ze.log.firewall:value=info

cmd=background:seq=1:exec=ze -:stdin=ze-bgp
cmd=foreground:seq=2:exec=python3 driver.py:timeout=15s
expect=exit:code=0
expect=stderr:contains=firewall config reloaded
expect=stdout:contains=reload converged
