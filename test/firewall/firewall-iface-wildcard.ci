# Test: Interface wildcard matching lowers to a prefix-length comparison.
# VALIDATES: spec-fw-8 AC-5 / AC-6 -- a trailing `*` on an interface
#            name produces a wildcard prefix match; without `*` the
#            match stays exact (16-byte padded).
# PREVENTS: LNS VyOS replacement blocked by missing wildcard interface match.
#
# Requires CAP_NET_ADMIN.

option=needs-linux:caps=net-admin

stdin=ze-bgp:terminator=EOF_CONF
firewall {
	backend nft;
	table fw8_013 {
		family inet;
		chain input {
			type filter;
			hook input;
			priority 0;
			policy drop;
			term allow-l2tp {
				from {
					input-interface "l2tp*";
				}
				then {
					accept;
				}
			}
		}
	}
}
EOF_CONF

option=env:var=ze.log.firewall:value=info

cmd=background:seq=1:exec=ze -:stdin=ze-bgp
cmd=foreground:seq=2:exec=ze-test fixture firewall/firewall-iface-wildcard:timeout=10s
expect=exit:code=0
expect=stderr:contains=firewall config applied
expect=stdout:contains=table inet ze_fw8_013
expect=stdout:contains=iifname "l2tp*" accept
