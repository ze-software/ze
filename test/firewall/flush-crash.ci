# Test: a crash (SIGKILL) keeps ze tables even with flush-on-shutdown at its
#       default (true) -- the teardown only runs on an orderly stop, so a crash
#       never removes protection.
# VALIDATES: spec firewall flush-on-shutdown AC (keep-on-crash) -- SIGKILL leaves
#            the ze_* table in the kernel because no shutdown path executes.
# PREVENTS: a regression that moves table teardown somewhere a crash would still
#           reach, dropping firewall/CoPP protection exactly when the box died.
#
# Requires CAP_NET_ADMIN.

option=needs-linux:caps=net-admin

stdin=ze-bgp:terminator=EOF_CONF
firewall {
	backend nft;
	table fwcrash {
		family inet;
		chain input {
			type filter;
			hook input;
			priority 0;
			policy drop;
			term allow-ssh {
				from { destination-port 22; }
				then { accept; }
			}
		}
	}
}
EOF_CONF

option=env:var=ze.log.firewall:value=info

cmd=background:seq=1:exec=ze -:stdin=ze-bgp
cmd=foreground:seq=2:exec=ze-test fixture firewall/flush-crash:timeout=15s
expect=exit:code=0
expect=stderr:contains=BEFORE_CRASH: table present
expect=stderr:contains=AFTER_CRASH: table persisted
