# Test: `ze cli firewall show <table>` returns structured JSON derived from the
#       applied kernel state, over the real SSH CLI path.
# VALIDATES: spec-fw-10 AC-24 -- the CLI show handler reads the read-back path
#            (firewallnft.ListTables) and renders chains + term names through the
#            structured Data map, so `ze cli` consumers see the applied shape.
# PREVENTS: show returning a stale in-memory copy or empty when the table is
#           programmed.
#
# Auth setup mirrors test/plugin/ssh-user-login-yang.ci: the daemon config
# declares a super-admin user + an SSH server; the driver provisions matching
# client credentials with `ze init` into a sandbox config dir, then runs `ze cli`
# against that dir with ze.ssh.password. The SSH port is fixed (per-test netns
# isolates it) so no log-scrape is needed. Requires CAP_NET_ADMIN (nft) + SSH,
# in ze_core.
#
# // this rewrite replaces the previous no-SSH-setup version (which
# never authenticated and used a non-existent `show firewall <table>` command)
# with the full ze cli->SSH path and the real `show firewall ruleset <name>`
# command. Behavioural assertions (fw10_004, allow-https, exit 0) are unchanged
# in intent; this is not test weakening.

option=needs-linux:caps=net-admin

stdin=ze-bgp:terminator=EOF_CONF
firewall {
	backend nft;
	table fw10_004 {
		family inet;
		chain input {
			type filter;
			hook input;
			priority 0;
			policy drop;
			# A drop-policy chain must not lock out its own management plane: the
			# `ze cli` -> SSH server connection is loopback, so accept the lo
			# interface. Both the SYN to 2222 AND the SYN-ACK back to the client's
			# ephemeral port travel over lo; a dport-2222-only rule accepts the
			# SYN but the chain then drops the return SYN-ACK (ephemeral dport),
			# so the connection silently times out. Accepting lo covers both.
			term allow-loopback {
				from { input-interface lo; }
				then { accept; }
			}
			term allow-https {
				from { destination-port 443; }
				then { accept; }
			}
		}
	}
}

system {
	authentication {
		user operator {
			password "$2a$04$UlwuiuH82Unfsq.XEMPGJeDkXwbm3KW.nvVaVXOd/JeFK8VjMjrQO";
		}
	}
}

environment {
	ssh {
		enabled true;
		server main {
			ip 127.0.0.1;
			port 2222;
		}
	}
}
EOF_CONF

option=env:var=ze.log.firewall:value=info

cmd=background:seq=1:exec=ze -:stdin=ze-bgp
cmd=foreground:seq=2:exec=ze-test fixture firewall/firewall-cli-show:timeout=20s
expect=exit:code=0
expect=stdout:contains=fw10_004
expect=stdout:contains=allow-https
