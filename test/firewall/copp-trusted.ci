# Test: CoPP trusted-source is accepted before the rate-limit term.
# VALIDATES: spec-cp-survival-2-copp-port179 AC-3 -- trusted-source
#            192.0.2.0/24 produces an accept term ordered before the
#            limit term in the nft input chain.
# PREVENTS: trusted peers rate-limited because term ordering is wrong.

option=needs-linux:caps=net-admin

stdin=ze-bgp:terminator=EOF_CONF
control-plane-protection {
    bgp {
        rate 50/second;
        trusted-source 192.0.2.0/24;
    }
}
EOF_CONF

option=env:var=ze.log.copp:value=info

cmd=background:seq=1:exec=ze -:stdin=ze-bgp
cmd=foreground:seq=2:exec=ze-test fixture firewall/copp-trusted:timeout=10s
expect=exit:code=0
expect=stderr:contains=ORDER_OK
# The nfproto guard is what lets nft render the trusted source cooked.
expect=stdout:contains=ip saddr 192.0.2.0/24
expect=stdout:contains=limit rate
