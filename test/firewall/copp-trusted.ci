# Test: CoPP trusted-source is accepted before the rate-limit term.
# VALIDATES: spec-cp-survival-2-copp-port179 AC-3 -- trusted-source
#            192.0.2.0/24 produces an accept term ordered before the
#            limit term in the nft input chain.
# PREVENTS: trusted peers rate-limited because term ordering is wrong.

option=needs-linux:caps=net-admin

tmpfs=driver.py:mode=755:terminator=EOF_PY
#!/usr/bin/env python3
"""Wait for ze to apply CoPP with trusted-source, snapshot nft state."""
import os
import signal
import subprocess
import sys

from ze_api import wait_until

# // test-relax: hand-rolled daemon-readiness for-loop -> ze_api.wait_until (same
# 200x0.05s budget, ratchet-exempt internal sleep); paced marker polling, not a race.
if not wait_until(lambda: os.path.exists("daemon.pid") and os.path.exists("daemon.ready"),
                  attempts=200, delay=0.05):
    print("ERROR: daemon.pid/ready never appeared", file=sys.stderr)
    sys.exit(1)

with open("daemon.pid") as f:
    pid = int(f.read().strip())

# Deterministic replacement for sleep(0.5): poll until Apply() programmed the object.
_out = {}
def _ready():
    try:
        _out["s"] = subprocess.check_output(["nft", "list", "table", "inet", "ze_copp"], text=True, stderr=subprocess.DEVNULL)
        return True
    except subprocess.CalledProcessError:
        return False
if not wait_until(_ready, attempts=100, delay=0.05):
    sys.exit("firewall object never programmed")
out = _out["s"]
sys.stdout.write(out)

# Verify ordering: trusted accept appears before limit.
# nft 1.1.1 renders the masked source-address match raw as
# `@nh,96,32 & 0xffffff00 == 0xc0000200` (0xc0000200 = 192.0.2.0) rather than
# the cooked `ip saddr 192.0.2.0/24`, so match either rendering.
lines = out.splitlines()
trusted_line = None
limit_line = None
for i, line in enumerate(lines):
    if ("192.0.2.0/24" in line or "0xc0000200" in line) and "accept" in line:
        trusted_line = i
    if "limit rate" in line:
        limit_line = i
if trusted_line is not None and limit_line is not None:
    if trusted_line < limit_line:
        print("ORDER_OK: trusted before limit", file=sys.stderr)
    else:
        print("ORDER_FAIL: trusted after limit", file=sys.stderr)
        sys.exit(1)

os.kill(pid, signal.SIGTERM)
EOF_PY

stdin=ze-bgp:terminator=EOF_CONF
control-plane-protection {
    bgp {
        rate 50/second;
        trusted-source 192.0.2.0/24;
    }
}
EOF_CONF

option=env:var=ze.log.copp:value=info

cmd=background:seq=1:exec=ze -:stdin=ze-bgp
cmd=foreground:seq=2:exec=python3 driver.py:timeout=10s
expect=exit:code=0
expect=stderr:contains=ORDER_OK
# nft may render the trusted source cooked (192.0.2.0/24) or raw (0xc0000200).
expect=stdout:pattern=(192\.0\.2\.0/24|0xc0000200)
expect=stdout:contains=limit rate
