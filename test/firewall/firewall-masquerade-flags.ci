# Test: masquerade with random flag sets NF_NAT_RANGE_PROTO_RANDOM.
# VALIDATES: spec-cpe-5 AC-3, AC-8 -- parseMasquerade populates Flags;
#            lowerMasquerade emits expr.Masq{Random: true}.
# PREVENTS: masquerade flags silently ignored at config parse time.
#
# Requires CAP_NET_ADMIN.

option=needs-linux:caps=net-admin

stdin=ze-bgp:terminator=EOF_CONF
firewall {
	backend nft;
	table masqf {
		family inet;
		chain postrouting {
			type nat;
			hook postrouting;
			priority 100;
			policy accept;
			term masq-random {
				from { output-interface "eth0"; }
				then {
					masquerade { random; }
				}
			}
		}
	}
}
EOF_CONF

option=env:var=ze.log.firewall:value=info

cmd=background:seq=1:exec=ze -:stdin=ze-bgp
cmd=foreground:seq=2:exec=ze-test fixture firewall/firewall-masquerade-flags:timeout=10s
expect=exit:code=0
expect=stderr:contains=firewall config applied
expect=stdout:contains=masquerade random
