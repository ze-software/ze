# Test: Removing CoPP config withdraws the copp nft table.
# VALIDATES: spec-cp-survival-2-copp-port179 AC-5 -- copp config
#            removal cleanly withdraws the copp-managed table.
# PREVENTS: orphaned nft table left after config removal.

option=needs-linux:caps=net-admin

stdin=ze-bgp:terminator=EOF_CONF
control-plane-protection {
    bgp {
        rate 10/second;
    }
}
EOF_CONF

option=env:var=ze.log.copp:value=info

cmd=background:seq=1:exec=ze -:stdin=ze-bgp
cmd=foreground:seq=2:exec=ze-test fixture firewall/copp-withdraw:timeout=15s
expect=exit:code=0
expect=stderr:contains=BEFORE_SHUTDOWN: table present
expect=stderr:contains=AFTER_SHUTDOWN: table removed
