# Test: Removing CoPP config withdraws the copp nft table.
# VALIDATES: spec-cp-survival-2-copp-port179 AC-5 -- copp config
#            removal cleanly withdraws the copp-managed table.
# PREVENTS: orphaned nft table left after config removal.

option=skip-os:value=darwin

tmpfs=driver.py:mode=755:terminator=EOF_PY
#!/usr/bin/env python3
"""Start ze with CoPP config, verify table exists, then verify
shutdown removes it."""
import os
import signal
import subprocess
import sys
import time

for _ in range(200):
    if os.path.exists("daemon.pid") and os.path.exists("daemon.ready"):
        break
    time.sleep(0.05)
else:
    print("ERROR: daemon.pid/ready never appeared", file=sys.stderr)
    sys.exit(1)

with open("daemon.pid") as f:
    pid = int(f.read().strip())

time.sleep(0.5)

# Verify table exists before shutdown.
try:
    out = subprocess.check_output(
        ["nft", "list", "table", "inet", "ze_copp"], text=True)
    print("BEFORE_SHUTDOWN: table present", file=sys.stderr)
except subprocess.CalledProcessError:
    print("BEFORE_SHUTDOWN: table missing", file=sys.stderr)
    sys.exit(1)

os.kill(pid, signal.SIGTERM)
time.sleep(1)

# Verify table is removed after shutdown.
try:
    subprocess.check_output(
        ["nft", "list", "table", "inet", "ze_copp"],
        text=True, stderr=subprocess.STDOUT)
    print("AFTER_SHUTDOWN: table still present (FAIL)", file=sys.stderr)
    sys.exit(1)
except subprocess.CalledProcessError:
    print("AFTER_SHUTDOWN: table removed (OK)", file=sys.stderr)
EOF_PY

stdin=ze-bgp:terminator=EOF_CONF
control-plane-protection {
    bgp {
        rate 10/second;
    }
}
EOF_CONF

option=env:var=ze.log.copp:value=info

cmd=background:seq=1:exec=ze -:stdin=ze-bgp
cmd=foreground:seq=2:exec=python3 driver.py:timeout=15s
expect=exit:code=0
expect=stderr:contains=BEFORE_SHUTDOWN: table present
expect=stderr:contains=AFTER_SHUTDOWN: table removed
