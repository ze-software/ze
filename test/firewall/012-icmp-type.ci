# Test: ICMP type matching lowers to the correct nftables rule.
# VALIDATES: spec-fw-8 AC-1 / AC-3 -- icmp-type and icmpv6-type
#            config keys produce MatchICMPType / MatchICMPv6Type,
#            lowered to Payload(Transport,0,1)+Cmp(type number).
# PREVENTS: LNS VyOS replacement blocked by missing ICMP type match.
#
# Requires CAP_NET_ADMIN.

option=needs-linux:caps=net-admin

tmpfs=driver.py:mode=755:terminator=EOF_PY
#!/usr/bin/env python3
import os, signal, subprocess, sys

from ze_api import wait_until

# // hand-rolled daemon-readiness for-loop -> ze_api.wait_until (same
# 200x0.05s budget, ratchet-exempt internal sleep); paced marker polling, not a race.
if not wait_until(lambda: os.path.exists("daemon.pid") and os.path.exists("daemon.ready"),
                  attempts=200, delay=0.05):
    sys.exit("daemon readiness files missing")

with open("daemon.pid") as f:
    pid = int(f.read().strip())

# Deterministic replacement for sleep(0.5): poll until Apply() programmed the object.
_out = {}
def _ready():
    try:
        _out["s"] = subprocess.check_output(["nft", "list", "table", "inet", "ze_fw8_012"], text=True, stderr=subprocess.DEVNULL)
        return True
    except subprocess.CalledProcessError:
        return False
if not wait_until(_ready, attempts=100, delay=0.05):
    sys.exit("firewall object never programmed")
out = _out["s"]
sys.stdout.write(out)
os.kill(pid, signal.SIGTERM)
EOF_PY

stdin=ze-bgp:terminator=EOF_CONF
firewall {
	backend nft;
	table fw8_012 {
		family inet;
		chain input {
			type filter;
			hook input;
			priority 0;
			policy drop;
			term allow-ping {
				from {
					protocol icmp;
					icmp-type echo-request;
				}
				then {
					accept;
				}
			}
			term allow-ping6 {
				from {
					protocol icmpv6;
					icmpv6-type echo-request;
				}
				then {
					accept;
				}
			}
		}
	}
}
EOF_CONF

option=env:var=ze.log.firewall:value=info

cmd=background:seq=1:exec=ze -:stdin=ze-bgp
cmd=foreground:seq=2:exec=python3 driver.py:timeout=10s
expect=exit:code=0
expect=stderr:contains=firewall config applied
expect=stdout:contains=table inet ze_fw8_012
# nft renders numeric ICMP types as symbolic names (8 -> echo-request); accept either.
expect=stdout:pattern=icmp type (8|echo-request) accept
expect=stdout:pattern=icmpv6 type (128|echo-request) accept
