# Test: an upgraded box with NO firewall configuration still loses the table an
#       older ze build left behind, and keeps one another tool owns.
#
# VALIDATES: AC-3 on the box that needs it most. The removal runs inside
#            Backend.Apply, and ApplyAll returns before it reaches a backend
#            when the merged desired set is empty and none is loaded
#            (internal/component/firewall/registry.go). So a box with no
#            firewall {} section, whose FlowSpec source has stopped announcing,
#            had no reconcile that could ever reach the stale table: it kept
#            enforcing an older build's rules for the life of the box. The
#            owner of the stale table now runs one empty reconcile at
#            startup while the removal is pending, which is what reaches it
#            (internal/plugins/flowspec-firewall/engine.go, runEngine).
# VALIDATES: the removal is decided on the chain shape, not on the name. A table
#            another tool wrote under a name ze used to use survives.
# PREVENTS:  two failures with one root. The first is the stranded rule above,
#            which the other two proofs of this removal cannot see: the
#            integration test calls Apply with a non-empty set and the plugin
#            test announces a route first, so both arrive with a backend already
#            loaded. The second is ze deleting somebody else's kernel state --
#            "flowspec" and "anomaly-shape" are ordinary words, and a table
#            under one of them holding a chain ze never wrote is not ours.
#
# The config is the upgraded box: the FlowSpec bridge is still configured, so
# the table an older build wrote is one it owns, but there is no firewall {}
# section and no peer. Nothing registers a table and no UPDATE ever arrives, so
# the only reconcile that will ever run carries nothing. That is precisely the
# state in which the removal used to be unreachable.
#
#
# A concurrent daemon from ANOTHER exclusive group can delete this seed. The
# `firewall-irr-*.ci` cluster runs in the same suite under its own group, and
# two groups do not serialize against each other, so an irr daemon's reconcile
# can sweep `table inet flowspec` before the daemon under test ever sees it.
# That is a FALSE RED and never a false green: the stderr assertion below
# requires the daemon THIS test launched to log the removal, and a table a
# foreign daemon took leaves that line unwritten, so the test fails rather than
# passing on somebody else's work. Recorded rather than fixed by widening the
# group, because serializing 12 irr tests against these would cost the suite
# more than the rare re-run does.
# Requires CAP_NET_ADMIN.

option=needs-linux:caps=net-admin
option=exclusive:group=flowspec-nft
option=env:var=ze.log.firewall:value=info
option=env:var=ze.log.flowspec.firewall:value=info
option=timeout:value=40s

tmpfs=seed.sh:mode=755:terminator=EOF_SEED
#!/bin/sh
# Two tables, and ze must tell them apart on chain shape alone.
#
#   inet flowspec       what a ze build before the ownership prefix wrote:
#                       its name, its family, and a chain it wrote.
#   ip anomaly-shape    another tool's table. The name and family are ones ze
#                       used too, and the chain is one ze never wrote.
set -e
nft add table inet flowspec
nft add chain inet flowspec flowspec-fwd '{ type filter hook forward priority -1 ; policy accept ; }'
nft add rule inet flowspec flowspec-fwd ip daddr 198.51.100.0/24 drop

nft add table ip anomaly-shape
nft add chain ip anomaly-shape forward '{ type filter hook forward priority -1 ; policy accept ; }'
nft add rule ip anomaly-shape forward ip daddr 203.0.113.0/24 drop

nft list ruleset
EOF_SEED

tmpfs=driver.py:mode=755:terminator=EOF_PY
#!/usr/bin/env python3
"""The stale table goes, the other tool's table stays."""
import os
import signal
import subprocess
import sys

from ze_api import wait_until

if not wait_until(
    lambda: os.path.exists("daemon.pid") and os.path.exists("daemon.ready"),
    attempts=400,
    delay=0.05,
):
    sys.exit("daemon readiness files missing")

with open("daemon.pid") as f:
    daemon_pid = int(f.read().strip())

state = {"ruleset": ""}


def ruleset():
    snap = subprocess.run(["nft", "list", "ruleset"], capture_output=True, text=True)
    state["ruleset"] = snap.stdout
    return snap.stdout


def swept():
    return "table inet flowspec {" not in ruleset()


ok = wait_until(swept, attempts=300, delay=0.1)

final = state["ruleset"]
sys.stdout.write(final)
os.kill(daemon_pid, signal.SIGTERM)

if not ok:
    sys.exit("the table an older ze build wrote survived a daemon with no firewall config")
if "198.51.100.0/24" in final:
    sys.exit("the rule an older ze build installed is still enforcing")

# The other tool's table is the positive half: a run that deleted nothing
# reaches neither of these lines, and a run that deleted everything fails here.
if "table ip anomaly-shape {" not in final:
    sys.exit("ze deleted a table another tool owns, matching on the name alone")
if "203.0.113.0/24" not in final:
    sys.exit("ze deleted another tool's rule")
EOF_PY

stdin=ze-bgp:terminator=EOF_CONF
# No firewall section and no peer. The bridge is loaded and silent.
plugin {
	internal flowspec-firewall {
		use flowspec-firewall
	}
}
EOF_CONF

cmd=foreground:seq=1:exec=sh seed.sh
cmd=background:seq=2:exec=ze -:stdin=ze-bgp
cmd=foreground:seq=3:exec=python3 driver.py:timeout=35s
expect=exit:code=0
# The survivor, printed from the settled ruleset.
expect=stdout:contains=table ip anomaly-shape
expect=stdout:contains=203.0.113.0/24
# The removal says so, naming the table it took out.
expect=stderr:contains=deleting a table an earlier ze build left without the ownership prefix
expect=stderr:contains=flowspec
