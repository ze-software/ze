# Test: masquerade with port-range restricts source port range.
# VALIDATES: spec-cpe-5 AC-1, AC-7 -- parseMasquerade populates Port/PortEnd;
#            lowerMasquerade emits expr.Masq{ToPorts: true} with port registers.
# PREVENTS: masquerade port-range silently ignored at config parse time.
#
# Requires CAP_NET_ADMIN.

option=needs-linux:caps=net-admin

stdin=ze-bgp:terminator=EOF_CONF
firewall {
	backend nft;
	table masqp {
		family inet;
		chain postrouting {
			type nat;
			hook postrouting;
			priority 100;
			policy accept;
			term masq-ports {
				from { output-interface "eth0"; }
				then {
					masquerade { port-range "1024-65535"; }
				}
			}
		}
	}
}
EOF_CONF

option=env:var=ze.log.firewall:value=info

cmd=background:seq=1:exec=ze -:stdin=ze-bgp
cmd=foreground:seq=2:exec=ze-test fixture firewall/firewall-masquerade-ports:timeout=10s
expect=exit:code=0
expect=stderr:contains=firewall config applied
expect=stdout:contains=masquerade to :1024-65535
