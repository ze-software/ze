# Test: A cleared ddos-local mitigation is withdrawn from the kernel.
# VALIDATES: docs/architecture/firewall/table-ownership-and-shutdown-flush.md
#            -- the "ze_" ownership prefix on ddos-local's
#            table (ze_ddos-local, not the old bare "ddos-local") lets the firewall
#            backend's reconcile sweep it when removeMitigation registers nil +
#            ApplyAll. Without the prefix, shouldDeleteTable ignores the table and a
#            cleared attack leaks its drop rule.
# PREVENTS: an orphaned ze_ddos-local nft table left behind after an attack clears.
#
# Requires CAP_NET_ADMIN. Runs on Linux under the netns/QEMU firewall harness
# (real nft); skipped on darwin. The synthetic attack is injected in-process by the
# fakeddos test plugin (zetest build): it emits AttackDetected on configure
# (installing the table), then AttackCleared once the driver drops a trigger file
# (withdrawing it), exercising the real detect->responder->nft path the responder's
# unit tests can only mock.

option=needs-linux:caps=net-admin

tmpfs=driver.py:mode=755:terminator=EOF_PY
#!/usr/bin/env python3
"""Confirm the ddos-local drop table is installed on attack detection, then
withdrawn when the attack clears (the clear is driven by dropping a trigger file
that the in-process fakeddos injector polls for)."""
import os
import signal
import subprocess
import sys

from ze_api import wait_for_daemon_ready, wait_until


def table_present():
    return subprocess.run(
        ["nft", "list", "table", "ip", "ze_ddos-local"],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0


# // test-relax: three hand-rolled poll loops -> ze_api helpers (same 200x0.05s
# budget each, ratchet-exempt internal sleep). Every condition, every failure
# message and every expect= is unchanged; only the sleep call moved into the
# shared helper. The readiness loop additionally folds in the pid read, closing a
# real race: daemon.pid is created before it is written, so exists() could be
# followed by int("") and a traceback that reads nothing like a readiness
# problem.
try:
    pid = wait_for_daemon_ready()
except TimeoutError:
    print("ERROR: daemon.pid/ready never appeared", file=sys.stderr)
    sys.exit(1)

# fakeddos emits AttackDetected on configure; wait for the responder's drop table.
if not wait_until(table_present, attempts=200, delay=0.05):
    print("MITIGATION: ze_ddos-local never installed (FAIL)", file=sys.stderr)
    sys.exit(1)
print("MITIGATION: ze_ddos-local installed", file=sys.stderr)


def daemon_alive():
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False


# Ask the injector to clear the attack by dropping a trigger file in the shared
# working directory; the responder must withdraw the table WHILE the daemon keeps
# running. The table stays installed until now, so there is no window the poll
# above could miss.
with open("ddos-fake.clear", "w"):
    pass

# // test-relax: removed dev-only dump_diag/marker scaffolding (used during
# authoring to diagnose the Emit in-process-subscriber-count bug) after the test
# went green; the assertions below are unchanged and coverage is unaffected.
daemon_died = []


def withdrawn_or_dead():
    """True once the table is gone, or once the daemon died trying.

    Both outcomes are terminal, so both must stop the poll; the caller tells
    them apart via daemon_died. Keeping the liveness check INSIDE the predicate
    preserves the original loop's fail-fast behaviour -- a daemon that exits
    mid-withdraw is reported as exactly that, rather than as a withdraw timeout
    10 seconds later. Table-first ordering is also the original's: a daemon that
    removed the table and then exited is a PASS, not a death.
    """
    if not table_present():
        return True
    if not daemon_alive():
        daemon_died.append(1)
        return True
    return False


if not wait_until(withdrawn_or_dead, attempts=200, delay=0.05):
    print("WITHDRAW: ze_ddos-local still present after clear (FAIL)", file=sys.stderr)
    sys.exit(1)
if daemon_died:
    print("WITHDRAW: daemon exited before clearing the table (FAIL)", file=sys.stderr)
    sys.exit(1)
print("WITHDRAW: ze_ddos-local removed", file=sys.stderr)

os.kill(pid, signal.SIGTERM)
EOF_PY

stdin=ze-bgp:terminator=EOF_CONF
ddos {
	local {
		response-level enforce;
	}
	fake {
		enabled true;
	}
}
EOF_CONF

option=env:var=ze.log.ddos.local:value=info
option=env:var=ze.log.ddos.fake:value=info

cmd=background:seq=1:exec=ze -:stdin=ze-bgp
cmd=foreground:seq=2:exec=python3 driver.py:timeout=20s
expect=exit:code=0
expect=stderr:contains=MITIGATION: ze_ddos-local installed
expect=stderr:contains=WITHDRAW: ze_ddos-local removed
