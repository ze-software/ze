# Test: Per-element `timeout` leaf reaches the kernel and is visible
# when `nft list table` reads the set back.
# VALIDATES: spec-fw-10 AC-13 -- the YANG shape changed from leaf-list
#            of strings to `list element { key value; leaf timeout; }`.
#            parseSetElements populates SetElement.Timeout, applySet
#            passes the uint32 to nftables.SetElement.Timeout as a
#            time.Duration, and readback_linux.go truncates it back to
#            whole seconds for the model.
# PREVENTS: a regression where the timeout disappears somewhere along
#           the parse -> apply -> readback chain.
#
# Requires CAP_NET_ADMIN.
#
# ENVIRONMENT (not a code bug): nft set-element-timeout ops CRASH the Alpine
# QEMU minimal kernel, so this test is deliberately EXCLUDED from the
# scripts/evidence/netns_qemu.py host-safe subset and runs only on a
# full-kernel host via `make ze-netns-test`. The parse -> apply -> readback
# chain also has direct Go coverage in
# internal/plugins/firewall/nft/*_linux_test.go. See plan/learned/1112.

option=needs-linux:caps=net-admin

tmpfs=driver.py:mode=755:terminator=EOF_PY
#!/usr/bin/env python3
import os, signal, sys
from ze_api import wait_for_daemon_ready, wait_for_output

# // test-relax: two WAITS replaced, no assertion touched. The hand-rolled
# daemon-readiness for-loop became ze_api.wait_for_daemon_ready (same 200x0.05s
# budget, ratchet-exempt internal sleep), and the blind post-apply settle became
# ze_api.wait_for_output. Both expect=stdout lines below are unchanged and still
# evaluated against a real `nft list set` readback.
pid = wait_for_daemon_ready()

# Was a blind 0.5s "settle" before the readback. The set's elements are what the
# expectations below assert on, so the wait gates on an ELEMENT being present
# rather than on the set existing: nft prints an empty `elements = { }` body for
# a declared-but-unpopulated set, which would satisfy a mere existence check
# while both assertions still failed.
#
# attempts=100 (5s), not the 200 default: the readiness wait above may already
# have spent up to 10s and this test is capped at 10s, so a full-budget second
# wait would be cut short by the harness and report an opaque test-level timeout
# instead of the assertion message.
out = wait_for_output(
    ["nft", "list", "set", "inet", "ze_fw10_009", "transient"],
    lambda dump: "10.0.0.1" in dump and "10.0.0.2" in dump,
    attempts=100,
)
sys.stdout.write(out)
os.kill(pid, signal.SIGTERM)
EOF_PY

stdin=ze-bgp:terminator=EOF_CONF
firewall {
	backend nft;
	table fw10_009 {
		family inet;
		set transient {
			type ipv4;
			flags-timeout;
			element 10.0.0.1 { timeout 3600; }
			element 10.0.0.2 {}
		}
		chain input {
			type filter;
			hook input;
			priority 0;
			policy accept;
			term block {
				from { source-address "@transient"; }
				then { drop; }
			}
		}
	}
}
EOF_CONF

option=env:var=ze.log.firewall:value=info

cmd=background:seq=1:exec=ze -:stdin=ze-bgp
cmd=foreground:seq=2:exec=python3 driver.py:timeout=10s
expect=exit:code=0
expect=stderr:contains=firewall config applied
expect=stdout:contains=10.0.0.1 timeout 1h
expect=stdout:contains=10.0.0.2
