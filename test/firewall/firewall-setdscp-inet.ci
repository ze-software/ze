# Test: `dscp-set ef` action in an inet table verifies and programs a
# TOS rewrite on the IPv4 header.
# VALIDATES: spec-fw-10 AC-5 -- validateAction accepts FamilyInet for
#            SetDSCP (previously only FamilyIP was allowed, blocking
#            the common inet table shape); lowerSetDSCP emits the
#            payload write + Bitwise clear-and-OR into the kernel
#            rule.
# PREVENTS: a regression re-tightening the family check or dropping
#           the payload write.
#
# Requires CAP_NET_ADMIN.

option=needs-linux:caps=net-admin

stdin=ze-bgp:terminator=EOF_CONF
firewall {
	backend nft;
	table fw10_007 {
		family inet;
		chain forward {
			type filter;
			hook forward;
			priority 0;
			policy accept;
			term voip {
				from { destination-port 5060; }
				then { dscp-set ef; }
			}
		}
	}
}
EOF_CONF

option=env:var=ze.log.firewall:value=info

cmd=background:seq=1:exec=ze -:stdin=ze-bgp
cmd=foreground:seq=2:exec=ze-test fixture firewall/firewall-setdscp-inet:timeout=10s
expect=exit:code=0
expect=stderr:contains=firewall config applied
# nft renders the unqualified dport as `tcp dport` or generic `th dport` by version.
expect=stdout:pattern=(tcp|th) dport 5060
# nft renders a DSCP set as `ip dscp set` or the raw payload `@nh,8,8 set` by version.
expect=stdout:pattern=(ip dscp set|@nh,8,8 set)
