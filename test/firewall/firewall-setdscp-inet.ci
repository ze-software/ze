# Test: `dscp-set ef` action in an inet table verifies and programs a
# TOS rewrite on the IPv4 header.
# VALIDATES: spec-fw-10 AC-5 -- validateAction accepts FamilyInet for
#            SetDSCP (previously only FamilyIP was allowed, blocking
#            the common inet table shape); lowerSetDSCP emits the
#            payload write + Bitwise clear-and-OR into the kernel
#            rule.
# PREVENTS: a regression re-tightening the family check or dropping
#           the payload write.
#
# Requires CAP_NET_ADMIN.

option=needs-linux:caps=net-admin

tmpfs=driver.py:mode=755:terminator=EOF_PY
#!/usr/bin/env python3
import os, signal, subprocess, sys

from ze_api import wait_until

# // hand-rolled daemon-readiness for-loop -> ze_api.wait_until (same
# 200x0.05s budget, ratchet-exempt internal sleep); paced marker polling, not a race.
if not wait_until(lambda: os.path.exists("daemon.pid") and os.path.exists("daemon.ready"),
                  attempts=200, delay=0.05):
    sys.exit("daemon readiness files missing")

with open("daemon.pid") as f:
    pid = int(f.read().strip())

# Deterministic replacement for sleep(0.5): poll until Apply() programmed the object.
_out = {}
def _ready():
    try:
        _out["s"] = subprocess.check_output(["nft", "list", "table", "inet", "ze_fw10_007"], text=True, stderr=subprocess.DEVNULL)
        return True
    except subprocess.CalledProcessError:
        return False
if not wait_until(_ready, attempts=100, delay=0.05):
    sys.exit("firewall object never programmed")
out = _out["s"]
sys.stdout.write(out)
os.kill(pid, signal.SIGTERM)
EOF_PY

stdin=ze-bgp:terminator=EOF_CONF
firewall {
	backend nft;
	table fw10_007 {
		family inet;
		chain forward {
			type filter;
			hook forward;
			priority 0;
			policy accept;
			term voip {
				from { destination-port 5060; }
				then { dscp-set ef; }
			}
		}
	}
}
EOF_CONF

option=env:var=ze.log.firewall:value=info

cmd=background:seq=1:exec=ze -:stdin=ze-bgp
cmd=foreground:seq=2:exec=python3 driver.py:timeout=10s
expect=exit:code=0
expect=stderr:contains=firewall config applied
# nft renders the unqualified dport as `tcp dport` or generic `th dport` by version.
expect=stdout:pattern=(tcp|th) dport 5060
# nft renders a DSCP set as `ip dscp set` or the raw payload `@nh,8,8 set` by version.
expect=stdout:pattern=(ip dscp set|@nh,8,8 set)
