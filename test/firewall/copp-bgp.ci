# Test: CoPP installs an nft input chain with rate limit on tcp dport 179.
# VALIDATES: spec-cp-survival-2-copp-port179 AC-1 -- CoPP config produces
#            an nft input-hook chain with tcp dport 179 limit rate.
# PREVENTS: CoPP config accepted but no nft chain programmed.

option=needs-linux:caps=net-admin

stdin=ze-bgp:terminator=EOF_CONF
control-plane-protection {
    bgp {
        rate 100/second;
        burst 20;
    }
}
EOF_CONF

option=env:var=ze.log.copp:value=info

cmd=background:seq=1:exec=ze -:stdin=ze-bgp
cmd=foreground:seq=2:exec=ze-test fixture firewall/copp-bgp:timeout=10s
expect=exit:code=0
expect=stderr:contains=copp table applied
expect=stdout:contains=table inet ze_copp
# nft renders the unqualified dport as `tcp dport` or generic `th dport` by version.
expect=stdout:pattern=(tcp|th) dport 179
expect=stdout:contains=limit rate
