# Test: Static routes with named tables and interface-only next-hops.
# VALIDATES: spec-gap-2 AC-1 (table route), AC-2 (interface-only),
#            AC-4 (table + interface), AC-5 (gateway unchanged),
#            AC-8 (same prefix different tables);
#            spec-fixit-static-interface-nexthops AC-1/AC-7 (interface-only
#            next-hop resolves to an ifindex and programs on the linux backend).
# PREVENTS: table name not resolved, interface-only route rejected,
#           same prefix in different tables collides.
#
# Requires a Linux kernel (netlink route programming) AND a loaded iface
# backend to resolve the interface-only next-hop: gated needs-linux:caps=net-admin and
# validated under QEMU (make ze-qemu-needs-linux-test). setup.py creates a
# dummy interface carrying the gateway subnets (so the address next-hops
# resolve) and the tun100 device the interface-only next-hop names. The config
# carries an `interface { backend netlink }` stanza so iface.Resolve has a
# backend to resolve tun100 against (spec-fixit-static-interface-nexthops C-6).

# caps=net-admin because setup.py below runs `ip link add`. Without the
# declaration an unprivileged Linux host does not skip: it runs, the `ip`
# calls are refused, and the test FAILS for a capability the host never had
# (internal/test/runner/record_parse.go, option=needs-linux).
option=needs-linux:caps=net-admin

tmpfs=setup.py:mode=755:terminator=EOF_SETUP
#!/usr/bin/env python3
# Create the devices the routes need. Idempotent: "exists" errors are ignored
# so repeat/parallel runs are safe.
#   zens0  carries 192.168.1.0/24 and 10.0.0.0/8 so the gateway next-hops
#          (192.168.1.1, 10.0.0.1) resolve on-link (else RouteReplace ENETUNREACH).
#   tun100 is the interface-only next-hop's outgoing device (a dummy suffices).
import subprocess
def ip(*args):
    subprocess.run(["ip", *args], stderr=subprocess.DEVNULL)
ip("link", "add", "zens0", "type", "dummy")
ip("addr", "add", "192.168.1.2/24", "dev", "zens0")
ip("addr", "add", "10.0.0.100/8", "dev", "zens0")
ip("link", "set", "zens0", "up")
ip("link", "add", "tun100", "type", "dummy")
ip("link", "set", "tun100", "up")
EOF_SETUP

tmpfs=static-show.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
"""Assert `show static` reports all three routes, across both tables."""

import sys

from ze_api import API, runtime_fail, result_json_data


def dispatch(api, command):
    resp = api._call_engine(
        'ze-plugin-engine:dispatch-command', {'command': command})
    if resp is None:
        return {'status': 'error', 'data': 'engine call returned None'}
    return resp.get('result', {})


def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()
    api.wait_for_post_startup(timeout=5.0)

    result = dispatch(api, 'show static')
    if result.get('status') != 'done':
        runtime_fail(f"show static: status={result.get('status')} "
                     f"data={result.get('data')!r} error={result.get('error')!r}")

    rows = result_json_data(result, None)
    if not isinstance(rows, list):
        runtime_fail(f"show static: expected a list, got {rows!r}")

    # Three routes: default/0.0.0.0/0, default/10.0.0.0/8, lns/0.0.0.0/0. The
    # same prefix in two tables must NOT collide (AC-8), so key on both.
    seen = {(r.get('prefix'), r.get('table')) for r in rows if isinstance(r, dict)}
    if len(rows) < 3:
        runtime_fail(f"expected at least 3 routes, got {len(rows)}: {rows!r}")

    prefixes = {p for p, _ in seen}
    for want in ('0.0.0.0/0', '10.0.0.0/8'):
        if want not in prefixes:
            runtime_fail(f"show static: {want} missing, got {sorted(prefixes)!r}")

    # AC-8: 0.0.0.0/0 exists in BOTH the default table (id 0) and lns (id 100).
    default_tables = sorted(t for p, t in seen if p == '0.0.0.0/0')
    if len(default_tables) < 2:
        runtime_fail(f"0.0.0.0/0 should appear in two tables (default and lns), "
                     f"got tables {default_tables!r}")
    if 100 not in default_tables:
        runtime_fail(f"named table lns (id 100) not resolved for 0.0.0.0/0, "
                     f"got tables {default_tables!r}")

    # AC-2/AC-4: the lns route's next-hop is interface-only (tun100), so it
    # carries an interface and no gateway address.
    lns = next((r for r in rows
                if r.get('prefix') == '0.0.0.0/0' and r.get('table') == 100), None)
    hops = lns.get('next-hops') or [] if lns else []
    if not any(h.get('interface') == 'tun100' for h in hops):
        runtime_fail(f"lns 0.0.0.0/0 should have an interface-only next-hop on "
                     f"tun100, got {hops!r}")

    print('OK: show static reports 3 routes across default and lns, '
          'interface-only next-hop resolved', file=sys.stderr)

    dispatch(api, 'request shutdown')
    api.wait_for_shutdown()


if __name__ == '__main__':
    main()
EOF_RUN

# The command is dispatched through an external plugin rather than `ze cli -c`:
# `ze cli` speaks SSH (internal/component/cli/client/main.go:380,
# sshclient.ExecCommand) and this config declares no SSH server, so the CLI path
# could never reach the daemon -- it failed with "no credentials for
# 127.0.0.1:2222".
stdin=ze-bgp:terminator=EOF_CONF
plugin {
    external static-show {
        run ./static-show.run
        encoder json
    }
}

interface {
    backend netlink
}

routing-table {
    table lns {
        id 100
    }
}

static {
    table default {
        route 10.0.0.0/8 {
            next { hop 192.168.1.1 { } }
        }
        route 0.0.0.0/0 {
            next { hop 10.0.0.1 { } }
        }
    }
    table lns {
        route 0.0.0.0/0 {
            next { interface tun100 { } }
        }
    }
}
EOF_CONF

option=env:var=ze.log.static:value=info
option=env:var=ze.log.routing.table:value=info

# // the three `expect=stdout:contains=` substring checks are
# REPLACED, not dropped. They matched text the old driver echoed from
# `ze cli -c "show static"` -- a path that could never run here (this config
# declares no SSH server, and ze cli speaks SSH), so they never asserted
# anything about the daemon. The equivalent checks now live inside
# static-show.run and are strictly stronger: route count, both (prefix, table)
# pairs, the named table resolving to id 100, and the interface-only next-hop
# landing on tun100. A substring "0.0.0.0/0" could be satisfied by either
# table; the structured check cannot.
cmd=foreground:seq=1:exec=python3 setup.py
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
expect=stderr:contains=static routes loaded
expect=stderr:contains=routing-table registry loaded
expect=stderr:contains=OK: show static reports 3 routes across default and lns, interface-only next-hop resolved
reject=stderr:pattern=panic
reject=stderr:pattern=fatal error
