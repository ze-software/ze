# Test: Static routes with named tables and interface-only next-hops.
# VALIDATES: spec-gap-2 AC-1 (table route), AC-2 (interface-only),
#            AC-4 (table + interface), AC-5 (gateway unchanged),
#            AC-8 (same prefix different tables);
#            spec-fixit-static-interface-nexthops AC-1/AC-7 (interface-only
#            next-hop resolves to an ifindex and programs on the linux backend).
# PREVENTS: table name not resolved, interface-only route rejected,
#           same prefix in different tables collides.
#
# Requires Linux and CAP_NET_ADMIN for netlink route programming and interface
# resolution. The native setup fixture creates the gateway subnet and tun100
# devices. The config loads the netlink interface backend so iface.Resolve can
# resolve tun100 (spec-fixit-static-interface-nexthops C-6). The capability
# declaration makes an unprivileged host skip instead of failing `ip`.
option=needs-linux:caps=net-admin

# The command is dispatched through an external plugin rather than `ze cli -c`:
# `ze cli` speaks SSH (internal/component/cli/client/main.go:380,
# sshclient.ExecCommand) and this config declares no SSH server, so the CLI path
# could never reach the daemon -- it failed with "no credentials for
# 127.0.0.1:2222".
stdin=ze-bgp:terminator=EOF_CONF
plugin {
    external static-show {
        run "ze-test fixture static/static-table-interface"
        encoder json
    }
}

interface {
    backend netlink
}

routing-table {
    table lns {
        id 100
    }
}

static {
    table default {
        route 10.0.0.0/8 {
            next { hop 192.168.1.1 { } }
        }
        route 0.0.0.0/0 {
            next { hop 10.0.0.1 { } }
        }
    }
    table lns {
        route 0.0.0.0/0 {
            next { interface tun100 { } }
        }
    }
}
EOF_CONF

option=env:var=ze.log.static:value=info
option=env:var=ze.log.routing.table:value=info

# // the three `expect=stdout:contains=` substring checks are
# REPLACED, not dropped. They matched text the old driver echoed from
# `ze cli -c "show static"` -- a path that could never run here (this config
# declares no SSH server, and ze cli speaks SSH), so they never asserted
# anything about the daemon. The equivalent checks now live inside
# static-show.run and are strictly stronger: route count, both (prefix, table)
# pairs, the named table resolving to id 100, and the interface-only next-hop
# landing on tun100. A substring "0.0.0.0/0" could be satisfied by either
# table; the structured check cannot.
cmd=foreground:seq=1:exec=ze-test fixture static/static-table-interface-setup
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
expect=stderr:contains=static routes loaded
expect=stderr:contains=routing-table registry loaded
expect=stderr:contains=OK: show static reports 3 routes across default and lns, interface-only next-hop resolved
reject=stderr:pattern=panic
reject=stderr:pattern=fatal error
