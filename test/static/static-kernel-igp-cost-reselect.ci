# Test: interior cost chooses between two BGP paths, and a change of that cost
#       alone moves the best path.
# VALIDATES: spec-fib-depth AC-1 -- two BGP paths for 203.0.113.0/24 differ only
#            in the interior cost of their next hops, which two interface-only
#            static routes supply (metric 10 to 10.91.0.1, 20 to 10.92.0.1); the
#            best path is the one via 10.91.0.1, although the later tie-breakers
#            would pick the other peer.
# VALIDATES: spec-fib-depth AC-13 -- the fixture rewrites only the static metric
#            of 10.91.0.0/24 to 30 and sends SIGHUP; no BGP route changes, and
#            the best path moves to the peer via 10.92.0.1.
# PREVENTS: an interior cost read once when the UPDATE arrives, and a
#           reselection that only AIGP routes trigger.
#
# Requires Linux and CAP_NET_ADMIN: the static plugin cannot boot on darwin, the
# setup creates the dummy link the static routes name, and the netlink
# interface backend resolves its index.
option=needs-linux:caps=net-admin

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=45s
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external static-kernel-test {
		run "le test fixture static/static-kernel-igp-cost-reselect"
		encoder json
	}
	internal bgp-rib {
		use bgp-rib
	}
	internal rib {
		use rib
	}
	internal fib-kernel {
		use fib-kernel
	}
}

static {
	table default {
		route 10.91.0.0/24 {
			metric 10
			next { interface zentk { } }
		}
		route 10.92.0.0/24 {
			metric 20
			next { interface zentk { } }
		}
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 2
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}

		attach process bgp-rib {
			receive [ update state refresh ]
			send [ update ]
		}
	}
}
EOF_CONF

option=env:var=ze.log.static:value=info
option=env:var=ze.log.rib:value=info

cmd=foreground:seq=1:exec=le test fixture static/static-kernel-setup
cmd=background:seq=2:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=3:exec=ze -:stdin=ze-bgp:timeout=45s
expect=exit:code=0
expect=stderr:contains=OK AC-1: interior cost chose 10.0.0.2 via 10.91.0.1
expect=stderr:contains=OK AC-13: interior cost change moved the best path to 10.0.0.1 via 10.92.0.1
reject=stderr:pattern=panic
reject=stderr:pattern=fatal error
