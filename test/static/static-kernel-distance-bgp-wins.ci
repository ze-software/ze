# Test: with `rib { distance { static 250 } }` the eBGP route beats the static
#       route for the same prefix IN THE KERNEL, not only in the system RIB.
# VALIDATES: spec-connected-static-reach-the-locrib AC-8 -- the kernel holds
#            exactly one entry for 10.0.0.0/8, stamped proto 250 by the FIB
#            plugin, forwarding via the BGP next-hop 198.51.100.1, and no second
#            entry for the prefix exists in any table.
# PREVENTS: a static route reaching the kernel beside the BGP winner because a
#           raised static distance decided nothing.
#
# The sibling static-kernel-distance-static-wins.ci is the same configuration with the
# other distance and expects the other winner, so together they prove the number
# the operator writes decides what the kernel forwards on.
#
# Requires Linux and CAP_NET_ADMIN: the setup creates a dummy link carrying both
# gateway subnets, and fib-kernel programs the winner through netlink.
option=needs-linux:caps=net-admin

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=30s
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external static-kernel-test {
		run "le test fixture static/static-kernel-distance-bgp-wins"
		encoder json
	}
	internal bgp-rib {
		use bgp-rib
	}
	internal rib {
		use rib
	}
	internal fib-kernel {
		use fib-kernel
	}
}

rib {
	distance {
		static 250
	}
}

static {
	table default {
		route 10.0.0.0/8 {
			next { hop 192.0.2.1 { } }
		}
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 2
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}

		attach process bgp-rib {
			receive [ update state refresh ]
			send [ update ]
		}
	}
}
EOF_CONF

option=env:var=ze.log.static:value=info
option=env:var=ze.log.rib:value=info

cmd=foreground:seq=1:exec=le test fixture static/static-kernel-setup
cmd=background:seq=2:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=3:exec=ze -:stdin=ze-bgp:timeout=30s
expect=exit:code=0
expect=stderr:contains=OK: kernel holds one entry for 10.0.0.0/8, proto 250 via 198.51.100.1
reject=stderr:pattern=panic
reject=stderr:pattern=fatal error
