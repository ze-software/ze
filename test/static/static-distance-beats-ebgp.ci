# Test: an operator lowers the static administrative distance below BGP's and the
#       static route keeps the prefix both of them offer.
# VALIDATES: spec-connected-static-reach-the-locrib AC-9 -- `rib { distance {
#            static 5 } }` decides a route-install outcome. The static route and
#            the BGP route name the same prefix, and the system RIB hands the FIB
#            the static one.
# PREVENTS: the defect this spec exists to remove -- the leaf being settable,
#           validated, completed by the editor and read by nothing, so the static
#           route reached the kernel through the static plugin's own netlink
#           handle whatever number the operator wrote.
#
# The sibling test static-distance-loses-to-ebgp.ci is the same configuration with
# `static 250`, and it expects the other winner. The two differ in one number, so
# what they prove is that the number decides.
#
# Requires Linux and CAP_NET_ADMIN: fib-kernel programs the winner through
# netlink, and the static plugin resolves next-hops against the kernel.
option=needs-linux:caps=net-admin

# ze-peer holds the session open so the BGP RIB reaches its initial-sync EOR; the
# route itself is injected by the fixture rather than announced, so no UPDATE is
# expected on the wire.
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=20s
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external static-distance-test {
		run "ze-test fixture static/static-distance-beats-ebgp"
		encoder json
	}
	internal bgp-rib {
		use bgp-rib
	}
	internal rib {
		use rib
	}
	internal fib-kernel {
		use fib-kernel
	}
}

rib {
	distance {
		static 5
	}
}

static {
	table default {
		route 10.0.0.0/8 {
			next { hop 192.168.1.1 { } }
		}
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 2
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}

		attach process bgp-rib {
			receive [ update state refresh ]
			send [ update ]
		}
	}
}
EOF_CONF

option=env:var=ze.log.static:value=info
option=env:var=ze.log.rib:value=info

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=20s
expect=exit:code=0
expect=stderr:contains=OK: 10.0.0.0/8 is won by static
reject=stderr:pattern=panic
reject=stderr:pattern=fatal error
