# Test: Config reload removes a static route.
# VALIDATES: spec-static-routes AC-9 -- SIGHUP with route removed,
#            route no longer appears in static show output.
# PREVENTS: reload accepted but removed routes left in kernel
#           (diff engine reports no removal).
#
# Requires a Linux kernel and CAP_NET_ADMIN for netlink route programming.
# The native setup fixture creates a dummy interface carrying both next-hop
# subnets so the gateways resolve in the bare VM. Declaring the capability
# makes an unprivileged Linux host skip instead of failing the `ip` operations.
option=needs-linux:caps=net-admin

stdin=ze-bgp:terminator=EOF_CONF
static {
    table default {
        route 10.0.0.0/8 {
            next {
                hop 192.168.1.1 { }
            }
        }
        route 172.16.0.0/12 {
            next {
                hop 10.0.0.1 { }
            }
        }
    }
}
EOF_CONF

option=env:var=ze.log.static:value=info

cmd=foreground:seq=1:exec=ze-test fixture static/static-reload-remove-setup
cmd=background:seq=2:exec=ze -:stdin=ze-bgp
cmd=foreground:seq=3:exec=ze-test fixture static/static-reload-remove:timeout=15s
expect=exit:code=0
expect=stderr:contains=static routes reloaded
expect=stdout:!contains=172.16.0.0/12
