# Test: a main-table static route whose only next-hop is an interface name is
#       programmed out of that interface.
# VALIDATES: spec-connected-static-reach-the-locrib AC-13 -- the route travels as
#            a Loc-RIB path, the FIB plugin programs it (proto 250), and the
#            kernel entry's output device is the configured interface, with no
#            gateway.
# PREVENTS: the relocation into the Loc-RIB dropping the outgoing device, so an
#           interface-only static route is refused by the kernel or programmed
#           without the device the operator named.
#
# Requires Linux and CAP_NET_ADMIN: the setup creates the dummy link the route
# names, the netlink interface backend resolves its index, and fib-kernel
# programs the route through netlink.
option=needs-linux:caps=net-admin

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external static-kernel-test {
		run "le test fixture static/static-kernel-interface-nexthop"
		encoder json
	}
	internal rib {
		use rib
	}
	internal fib-kernel {
		use fib-kernel
	}
}

interface {
	backend netlink
}

static {
	table default {
		route 198.18.74.0/24 {
			next { interface zentk { } }
		}
	}
}
EOF_CONF

option=env:var=ze.log.static:value=info

cmd=foreground:seq=1:exec=le test fixture static/static-kernel-setup
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=30s
expect=exit:code=0
expect=stderr:contains=static routes loaded
expect=stderr:contains=OK: 198.18.74.0/24 is programmed out of dev zentk, proto 250
reject=stderr:pattern=panic
reject=stderr:pattern=fatal error
