# Test: Config reload adds a new static route.
# VALIDATES: spec-static-routes AC-10 -- SIGHUP with new route,
#            route appears in static show output.
# PREVENTS: reload accepted but new routes not programmed (diff
#           engine or apply path broken).
#
# Requires a Linux kernel and CAP_NET_ADMIN for netlink route programming.
# The native setup fixture creates a dummy interface carrying both next-hop
# subnets so the gateways resolve in the bare VM. Declaring the capability
# makes an unprivileged Linux host skip instead of failing the `ip` operations.
option=needs-linux:caps=net-admin

stdin=ze-bgp:terminator=EOF_CONF
static {
    table default {
        route 10.0.0.0/8 {
            next {
                hop 192.168.1.1 { }
            }
        }
    }
}
EOF_CONF

option=env:var=ze.log.static:value=info

cmd=foreground:seq=1:exec=ze-test fixture static/static-reload-add-setup
cmd=background:seq=2:exec=ze -:stdin=ze-bgp
cmd=foreground:seq=3:exec=ze-test fixture static/static-reload-add:timeout=15s
expect=exit:code=0
expect=stderr:contains=static routes reloaded
expect=stdout:contains=172.16.0.0/12
