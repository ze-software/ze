# Test: a reload whose static section declares NO route withdraws every route.
# VALIDATES: the config-apply callback acts on a delivered-but-empty section
#            instead of reading it as "nothing changed". parseStaticConfig
#            returns a nil slice both for a reload carrying no static section
#            and for one that declares no route, and the plugin separates the
#            two by tracking delivery beside the routes (pendingSection).
# PREVENTS: the defect this test was written for -- an operator empties the
#           static configuration, the commit succeeds, and every route stays
#           programmed in the kernel FIB with nothing to remove it.
#
# Non-vacuity: the `static` container STAYS in the config, holding no table.
# Deleting the whole section instead would withdraw the routes even against the
# defective code, because the server stops a plugin whose config root vanished
# (collectProcessesForRemovedConfigPaths) and routeManager.shutdown removes
# every route on the way out. That path proves nothing about the apply
# callback, which is where the defect lived.
#
# Requires a Linux kernel (netlink route programming): gated needs-linux and
# validated under QEMU (make ze-qemu-needs-linux-test). setup.py creates a
# dummy interface carrying the next-hop subnet so the gateway resolves in the
# bare VM (otherwise RouteReplace fails ENETUNREACH).

option=needs-linux

tmpfs=setup.py:mode=755:terminator=EOF_SETUP
#!/usr/bin/env python3
# Create a dummy interface carrying the next-hop subnets (192.168.1.0/24,
# 10.0.0.0/24) so the static routes' gateways resolve. Idempotent: "exists"
# errors are ignored so repeat/parallel runs are safe.
import subprocess
def ip(*args):
    subprocess.run(["ip", *args], stderr=subprocess.DEVNULL)
ip("link", "add", "zens1", "type", "dummy")
ip("addr", "add", "192.168.1.3/24", "dev", "zens1")
ip("addr", "add", "10.0.0.101/24", "dev", "zens1")
ip("link", "set", "zens1", "up")
EOF_SETUP

tmpfs=driver.py:mode=755:terminator=EOF_PY
#!/usr/bin/env python3
import os, signal, subprocess, sys

from ze_api import wait_until

if not wait_until(lambda: os.path.exists("daemon.pid") and os.path.exists("daemon.ready"),
                  attempts=200, delay=0.05):
    sys.exit("daemon readiness files missing")

with open("daemon.pid") as f:
    pid = int(f.read().strip())

# The static config declares no SSH, so read the kernel FIB directly rather
# than `ze cli show static`. Both routes must be programmed before the reload,
# otherwise their later absence proves nothing.
def _initial():
    out = subprocess.run(["ip", "route", "show", "table", "all"], capture_output=True, text=True).stdout
    return "10.10.0.0/16" in out and "172.20.0.0/14" in out
if not wait_until(_initial, attempts=100, delay=0.1):
    sys.exit("initial static routes not programmed before reload")

# Empty the static configuration, keeping the container itself. This is the
# shape the defect survived: the section is delivered and declares no route.
with open("ze-bgp.conf", "w") as f:
    f.write("static {\n}\n")

os.kill(pid, signal.SIGHUP)

_out = {}
def _withdrawn():
    _out["s"] = subprocess.run(["ip", "route", "show", "table", "all"], capture_output=True, text=True).stdout
    return "10.10.0.0/16" not in _out["s"] and "172.20.0.0/14" not in _out["s"]
if not wait_until(_withdrawn, attempts=100, delay=0.1):
    sys.exit("emptying the static section left routes in the kernel:\n%s" % _out.get("s", ""))
sys.stdout.write("withdrawn\n")

os.kill(pid, signal.SIGTERM)
# Wait for the daemon to exit before the next test: kernel tables are shared.
def _dead():
    try:
        os.kill(pid, 0)
        return False
    except OSError:
        return True
wait_until(_dead, attempts=100, delay=0.05)
EOF_PY

stdin=ze-bgp:terminator=EOF_CONF
static {
    table default {
        route 10.10.0.0/16 {
            next {
                hop 192.168.1.1 { }
            }
        }
        route 172.20.0.0/14 {
            next {
                hop 10.0.0.1 { }
            }
        }
    }
}
EOF_CONF

option=env:var=ze.log.static:value=info

cmd=foreground:seq=1:exec=python3 setup.py
cmd=background:seq=2:exec=ze -:stdin=ze-bgp
cmd=foreground:seq=3:exec=python3 driver.py:timeout=15s
expect=exit:code=0
expect=stderr:contains=static routes reloaded
expect=stdout:contains=withdrawn
