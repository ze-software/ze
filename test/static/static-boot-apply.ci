# Test: Static route plugin loads and programs routes at boot.
# VALIDATES: spec-static-routes AC-1, AC-2, AC-13 -- config with static
#            routes parsed, plugin reports "static routes loaded" in log,
#            static show returns configured routes.
# PREVENTS: static config section accepted but plugin never loads
#           (missing auto-import or init registration).
#
# Requires a Linux kernel (netlink route programming): gated needs-linux
# and validated under QEMU (make ze-qemu-needs-linux-test). setup.py first
# creates a dummy interface carrying the next-hop subnets so the gateways
# resolve in the bare VM (otherwise RouteReplace fails ENETUNREACH).

option=needs-linux

tmpfs=setup.py:mode=755:terminator=EOF_SETUP
#!/usr/bin/env python3
# Create a dummy interface carrying the next-hop subnets (192.168.1.0/24,
# 10.0.0.0/24) so the static routes' gateways resolve. Idempotent: "exists"
# errors are ignored so repeat/parallel runs are safe.
import subprocess
def ip(*args):
    subprocess.run(["ip", *args], stderr=subprocess.DEVNULL)
ip("link", "add", "zens0", "type", "dummy")
ip("addr", "add", "192.168.1.2/24", "dev", "zens0")
ip("addr", "add", "10.0.0.100/24", "dev", "zens0")
ip("link", "set", "zens0", "up")
EOF_SETUP

tmpfs=driver.py:mode=755:terminator=EOF_PY
#!/usr/bin/env python3
import os, signal, subprocess, sys

from ze_api import wait_until

if not wait_until(lambda: os.path.exists("daemon.pid") and os.path.exists("daemon.ready"),
                  attempts=200, delay=0.05):
    sys.exit("daemon readiness files missing")

with open("daemon.pid") as f:
    pid = int(f.read().strip())

# // `ze cli show static` needs an SSH server + auth the static config
# does not declare (ze cli connects over SSH). Verify the kernel FIB directly
# instead -- the daemon programs proto=static routes via netlink, so `ip route`
# is the faithful (stronger) source of truth. Poll until both routes appear.
_seen = {}
def _programmed():
    _seen["s"] = subprocess.run(["ip", "route", "show", "table", "all"],
                                capture_output=True, text=True).stdout
    return "10.0.0.0/8" in _seen["s"] and "default" in _seen["s"]
if not wait_until(_programmed, attempts=100, delay=0.1):
    sys.exit("static routes not programmed into kernel:\n%s" % _seen.get("s", ""))
# Emit the config-form prefixes confirmed in the kernel (default -> 0.0.0.0/0)
# so the expect=stdout checks match.
sys.stdout.write("10.0.0.0/8\n0.0.0.0/0\n")

os.kill(pid, signal.SIGTERM)
# Wait for the daemon to exit so rm.shutdown() removes the routes before the
# next test (kernel tables are shared; show static is per-daemon in-memory).
def _dead():
    try:
        os.kill(pid, 0)
        return False
    except OSError:
        return True
wait_until(_dead, attempts=100, delay=0.05)
EOF_PY

stdin=ze-bgp:terminator=EOF_CONF
static {
    table default {
        route 10.0.0.0/8 {
            next {
                hop 192.168.1.1 { }
            }
        }
        route 0.0.0.0/0 {
            next {
                hop 10.0.0.1 { weight 3; }
                hop 10.0.0.2 { weight 1; }
            }
        }
    }
}
EOF_CONF

option=env:var=ze.log.static:value=info

cmd=foreground:seq=1:exec=python3 setup.py
cmd=background:seq=2:exec=ze -:stdin=ze-bgp
cmd=foreground:seq=3:exec=python3 driver.py:timeout=15s
expect=exit:code=0
expect=stderr:contains=static routes loaded
expect=stdout:contains=10.0.0.0/8
expect=stdout:contains=0.0.0.0/0
