# Test: Static route plugin loads and programs routes at boot.
# VALIDATES: spec-static-routes AC-1, AC-2, AC-13 -- config with static
#            routes parsed, plugin reports "static routes loaded" in log,
#            static show returns configured routes.
# PREVENTS: static config section accepted but plugin never loads
#           (missing auto-import or init registration).
#
# Requires a Linux kernel and CAP_NET_ADMIN for netlink route programming.
# The native setup fixture creates a dummy interface carrying both next-hop
# subnets so the gateways resolve in the bare VM. Declaring the capability
# makes an unprivileged Linux host skip instead of failing the `ip` operations.
option=needs-linux:caps=net-admin

stdin=ze-bgp:terminator=EOF_CONF
static {
    table default {
        route 10.0.0.0/8 {
            next {
                hop 192.168.1.1 { }
            }
        }
        route 0.0.0.0/0 {
            next {
                hop 10.0.0.1 { weight 3; }
                hop 10.0.0.2 { weight 1; }
            }
        }
    }
}
EOF_CONF

option=env:var=ze.log.static:value=info

cmd=foreground:seq=1:exec=ze-test fixture static/static-boot-apply-setup
cmd=background:seq=2:exec=ze -:stdin=ze-bgp
cmd=foreground:seq=3:exec=ze-test fixture static/static-boot-apply:timeout=15s
expect=exit:code=0
expect=stderr:contains=static routes loaded
expect=stdout:contains=10.0.0.0/8
expect=stdout:contains=0.0.0.0/0
