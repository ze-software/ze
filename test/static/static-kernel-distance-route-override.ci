# Test: a static route's own `distance` leaf overrides the declared static
#       distance end to end, and keeps doing so across a reload of that
#       declaration.
# VALIDATES: spec-connected-static-reach-the-locrib AC-21 -- under `static 5`,
#            10.0.0.0/8 carries its own `distance 3` and 10.1.0.0/16 carries
#            none; eBGP offers both at 20. The fixture rewrites the config to
#            `static 250` and sends SIGHUP. The witness 10.1.0.0/16 then moves to
#            the BGP next-hop 198.51.100.1, proving the reload re-ranked, while
#            the kernel keeps exactly one entry for 10.0.0.0/8, proto 250, via
#            the static next-hop 192.0.2.1, and the system RIB winner stays
#            static.
# PREVENTS: a per-route distance the Loc-RIB ignores, or one the static plugin
#           never sends, so the route ranks at the declared static distance
#           and a raise to 250 hands it to BGP along with the witness.
#
# The sibling static-kernel-distance-reload.ci moves a route with no distance of
# its own; this one shows the route that has one does not move.
#
# The budget is 45s: the fixture waits for four kernel states in sequence, each
# bounded at ten seconds, and on a red the first three arrive at once, so the
# run ends on the fixture's own "after the reload" message rather than on the
# harness timeout.
#
# Requires Linux and CAP_NET_ADMIN: the setup creates a dummy link carrying both
# gateway subnets, and fib-kernel programs the winner through netlink.
option=needs-linux:caps=net-admin

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=45s
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external static-kernel-test {
		run "le test fixture static/static-kernel-distance-route-override"
		encoder json
	}
	internal bgp-rib {
		use bgp-rib
	}
	internal rib {
		use rib
	}
	internal fib-kernel {
		use fib-kernel
	}
}

rib {
	distance {
		static 5
	}
}

static {
	table default {
		route 10.0.0.0/8 {
			distance 3
			next { hop 192.0.2.1 { } }
		}
		route 10.1.0.0/16 {
			next { hop 192.0.2.1 { } }
		}
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 2
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}

		attach process bgp-rib {
			receive [ update state refresh ]
			send [ update ]
		}
	}
}
EOF_CONF

option=env:var=ze.log.static:value=info
option=env:var=ze.log.rib:value=info

cmd=foreground:seq=1:exec=le test fixture static/static-kernel-setup
cmd=background:seq=2:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=3:exec=ze -:stdin=ze-bgp:timeout=45s
expect=exit:code=0
expect=stderr:contains=OK: 10.0.0.0/8 kept its own distance 3 across the reload, kernel via 192.0.2.1
reject=stderr:pattern=panic
reject=stderr:pattern=fatal error
