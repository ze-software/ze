# Test: a main-table static route with two weighted next-hops reaches the kernel
#       as one multipath entry carrying the configured weights.
# VALIDATES: spec-connected-static-reach-the-locrib AC-12 -- the route travels as
#            a Loc-RIB path, the FIB plugin programs it (proto 250), and each hop
#            keeps its weight through ECMPPath.Weight: `nexthop via 192.0.2.1
#            weight 3` and `nexthop via 192.0.2.3 weight 1`.
# PREVENTS: the relocation into the Loc-RIB dropping the operator's weights, so
#           the kernel splits traffic evenly over hops configured 3:1.
#
# Requires Linux and CAP_NET_ADMIN: the setup creates a dummy link for the
# gateway subnet, and fib-kernel programs the route through netlink.
option=needs-linux:caps=net-admin

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external static-kernel-test {
		run "le test fixture static/static-kernel-weighted-multipath"
		encoder json
	}
	internal rib {
		use rib
	}
	internal fib-kernel {
		use fib-kernel
	}
}

static {
	table default {
		route 198.18.73.0/24 {
			next {
				hop 192.0.2.1 { weight 3; }
				hop 192.0.2.3 { weight 1; }
			}
		}
	}
}
EOF_CONF

option=env:var=ze.log.static:value=info

cmd=foreground:seq=1:exec=le test fixture static/static-kernel-setup
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=30s
expect=exit:code=0
expect=stderr:contains=static routes loaded
expect=stderr:contains=OK: 198.18.73.0/24 is multipath with weights 3 and 1, proto 250
reject=stderr:pattern=panic
reject=stderr:pattern=fatal error
