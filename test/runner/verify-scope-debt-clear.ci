# Clearing a verification-debt row by RUNNING the native gate the row names.
#
# The fixture drives a green owed gate, a red owed gate, and an unrunnable
# independent-review row in isolated scratch repositories. The compiled driver
# records a clear only after the green process exits zero, preserves the red row,
# and prints the gate's own evidence in both cases.

option=timeout:value=60s

cmd=foreground:seq=1:exec=ze-test fixture runner/verify-scope-debt-clear
expect=exit:code=0
expect=stdout:contains=debt-fixtures-ready
expect=stdout:contains=native-debt-clear-runs-registered-gates
expect=stdout:contains=green-gate-cleared-its-row
expect=stdout:contains=red-gate-left-its-row-open
