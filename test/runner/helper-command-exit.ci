# Each helper owns its exit status, including an expected refusal before another step.
option=timeout:value=10s
cmd=foreground:seq=1:exec=le test fixture runner/helper-command-exit first-helper 3:exit=3
expect=stdout:contains=first-helper
cmd=foreground:seq=2:exec=le test fixture runner/helper-command-exit zero-helper 0:exit=0
expect=stdout:contains=zero-helper
cmd=foreground:seq=3:exec=le test fixture runner/helper-command-exit final-helper 7:exit=7
expect=stdout:contains=final-helper
expect=exit:code=7
