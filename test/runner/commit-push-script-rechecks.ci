# Does the runner-built CLI keep a named debt target valid after local HEAD
# moves, then refuse that target after the actual upstream diverges? This
# checks native argument dispatch and git ancestry through the real binary.
#
# The debt query is nonauthorizing; piped push issuance separately refuses
# without writes. Actual generated-script publication of P after local HEAD
# moves and refusal against a diverged private origin are covered by
# TestRunnerPreparedPushPublishesOnlyPreparedCommit and
# TestRunnerPreparedPushRefusesMovedUpstream.

option=timeout:value=60s

cmd=foreground:seq=1:exec=le test fixture runner/commit-push-script-rechecks
expect=exit:code=0
expect=stdout:contains=named-debt-target-survived-local-head-move
expect=stdout:contains=push-issuer-refused-without-artifacts
expect=stdout:contains=named-debt-target-refused-after-upstream-diverged
