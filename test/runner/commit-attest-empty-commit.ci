# Does the native CLI report review debt and reject piped owner issuance
# without writing any file? This drives the runner-built binary and its real
# process streams; a callable unit cannot decide that transport boundary.
#
# The real debt-status query names Review-owed and attest. Piped push and
# create-attest both exit 2 with every scratch file, directory, mode and
# symlink unchanged. Authorized empty attestation, exact patch-id/words and
# cleared debt remain covered by TestAttestPreparesEmptyCommit.

option=timeout:value=60s

cmd=foreground:seq=1:exec=le test fixture runner/commit-attest-empty-commit
expect=exit:code=0
expect=stdout:contains=review-debt-reported-without-authorization
expect=stdout:contains=push-issuer-refused-without-artifacts
expect=stdout:contains=attest-issuer-refused-without-artifacts
