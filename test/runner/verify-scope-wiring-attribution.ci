# Wiring-gate attribution, end to end through the native `le commit create` command.
#
# The compiled fixture creates an isolated checkout, records a red wiring group
# belonging to another file, then records an own-file group and an unattributable
# group. The foreign red is disclosed but not charged; both relevant reds refuse.

option=timeout:value=90s

cmd=foreground:seq=1:exec=ze-test fixture runner/verify-scope-wiring-attribution
expect=exit:code=0
expect=stdout:contains=scratch-repo-ready
expect=stdout:contains=wiring-red-of-another-session-not-charged
expect=stdout:contains=wiring-red-of-my-own-file-still-refuses
expect=stdout:contains=unattributable-wiring-red-is-charged
