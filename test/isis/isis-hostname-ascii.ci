# Test: IS-IS dynamic hostname is refused unless it is printable 7-bit ASCII.
#
# VALIDATES: spec-fixit-isis-hostname-ascii AC-1..AC-5 -- the config boundary
#            refuses an IS-IS hostname carrying any octet outside 0x20..0x7e, and
#            refuses one whose label structure breaks RFC 2181 section 11. The
#            error names the offending value, the offending octet or label with
#            its position, and the accepted shape in words. A printable 7-bit
#            ASCII name still validates, so the leaf is narrowed, not closed.
# PREVENTS:  regression where a UTF-8 hostname validates and then reaches a peer
#            as 8-bit octets inside TLV 137 (RFC 5301 section 3 encodes the value
#            in 7-bit ASCII), and regression where the refusal reports a regex
#            instead of an actionable error.
#
# The enforcing producer is ISISHostnameValidator
# (internal/component/config/validators.go), reached through the ze:validate
# extension on the hostname leaf in internal/plugins/isis/yang/ze-isis-conf.yang.

# --- A printable 7-bit ASCII hostname validates. -----------------------------
# Every accepted shape in one config: a short name, an FQDN, the absolute form
# with one trailing dot, a 63-octet label, and a 255-octet total.
stdin=isis-ascii-ok:terminator=EOF_OK
isis {
	net 49.0001.0000.0000.0001.00
	hostname router-1.example.net.
}
EOF_OK

cmd=foreground:seq=1:exec=ze config validate -:stdin=isis-ascii-ok:exit=0
expect=exit:code=0
expect=stdout:contains=configuration valid

stdin=isis-ascii-63:terminator=EOF_63
isis {
	net 49.0001.0000.0000.0001.00
	hostname aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
}
EOF_63

cmd=foreground:seq=2:exec=ze config validate -:stdin=isis-ascii-63:exit=0
expect=exit:code=0
expect=stdout:contains=configuration valid

stdin=isis-ascii-255:terminator=EOF_255
isis {
	net 49.0001.0000.0000.0001.00
	hostname c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.c.d
}
EOF_255

cmd=foreground:seq=3:exec=ze config validate -:stdin=isis-ascii-255:exit=0
expect=exit:code=0
expect=stdout:contains=configuration valid

# --- A UTF-8 hostname is refused, and the error is actionable. ---------------
# RFC requirement: RFC5301-3-7 positive -- "The Value field is encoded in 7-bit ASCII" (RFC 5301 Section 3). A UTF-8 name is refused at the config boundary, so it can never be framed into TLV 137.
# RFC requirement: RFC5301-3-10 positive -- Ze's configuring user-interface does not permit Unicode characters, so the antecedent of RFC 5301 Section 3's IDNA sentence is false and no ToASCII conversion is owed. The refusal is the proof.
stdin=isis-utf8:terminator=EOF_UTF8
isis {
	net 49.0001.0000.0000.0001.00
	hostname café.example
}
EOF_UTF8

cmd=foreground:seq=4:exec=ze config validate -:stdin=isis-utf8:exit=1
expect=exit:code=1
expect=stdout:contains=is not a valid IS-IS hostname
expect=stdout:contains=octet 4
expect=stdout:contains=0xc3
expect=stdout:contains=7-bit ASCII
expect=stdout:contains=0x7e

# --- An over-long label is refused, and the error names the label. -----------
# RFC requirement: RFC5301-3-9 positive -- "The content of this value is a domain name, see [RFC2181]" (RFC 5301 Section 3). RFC 2181 Section 11 limits one label to 63 octets, so a 64-octet label is refused.
stdin=isis-long-label:terminator=EOF_LABEL
isis {
	net 49.0001.0000.0000.0001.00
	hostname aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
}
EOF_LABEL

cmd=foreground:seq=5:exec=ze config validate -:stdin=isis-long-label:exit=1
expect=exit:code=1
expect=stdout:contains=label 1 is 64 octets
expect=stdout:contains=1 to 63 octets

# --- An empty interior label is refused. -------------------------------------
stdin=isis-empty-label:terminator=EOF_EMPTY
isis {
	net 49.0001.0000.0000.0001.00
	hostname a..b
}
EOF_EMPTY

cmd=foreground:seq=6:exec=ze config validate -:stdin=isis-empty-label:exit=1
expect=exit:code=1
expect=stdout:contains=label 2 is empty
expect=stdout:contains=1 to 63 octets

# --- A name longer than 255 octets is refused. -------------------------------
# RFC requirement: RFC5301-3-6 positive -- "Value - a string of 1 to 255 bytes" (RFC 5301 Section 3). A 256-octet name is refused before it can be framed or shortened.
stdin=isis-too-long:terminator=EOF_LONG
isis {
	net 49.0001.0000.0000.0001.00
	hostname bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
}
EOF_LONG

cmd=foreground:seq=7:exec=ze config validate -:stdin=isis-too-long:exit=1
expect=exit:code=1
expect=stdout:contains=255
