# Test: IS-IS show/clear command surface (spec-isis-13 CLI completeness).
#
# VALIDATES: spec-isis-13 -- the operator-facing `show isis <noun>` and
#            `clear isis <action>` commands answer through the plugin dispatcher
#            and the cmd_show.go proxy (ze-show:isis-* / ze-clear:isis-*). With a
#            NET configured and only a passive interface (no raw circuit to open,
#            so the engine starts cleanly without CAP_NET_RAW), the engine
#            originates its own LSP, so:
#              - show isis neighbor      -> JSON array (empty: no adjacency)   (AC-1)
#              - show isis database      -> JSON array carrying the own LSP    (AC-2)
#                                           with every row marked `own` true
#              - show isis database detail -> rows carrying decoded TLVs       (AC-2)
#                                           and the same `own` marker
#              - show isis route         -> JSON array (empty: no remote prefix)(AC-3)
#              - show isis interface     -> the passive interface row          (AC-4)
#              - show isis hostname      -> the local System ID -> hostname    (AC-5)
#              - show isis spf-log       -> JSON array (the SPF run history)   (AC-6)
#              - clear isis adjacency    -> done, status payload               (AC-8)
#              - clear isis counters     -> done, status payload               (AC-8)
# PREVENTS:  regression where a show/clear wire method 404s at dispatch, the
#            proxy recurses, or the engine never originates so the database is
#            empty.
#
# Live adjacency / SPF-over-the-wire behaviour needs raw L2 (AF_PACKET) on a
# Linux veth and is covered by the QEMU integration tests and the FRR interop
# scenarios (test/interop/scenarios/isis-*-frr); this functional test exercises
# the command surface against a started, idle-but-present engine.


stdin=ze-conf:terminator=EOF_CONF
plugin {
	external isis-show {
		run "ze-test fixture isis/isis-show"
		encoder json
	}
}

isis {
	net 49.0001.0000.0000.0001.00
	level l1-l2
	hostname r1-isis
	# A passive interface is advertised but opens no raw circuit, so the engine
	# starts cleanly without CAP_NET_RAW (the show/clear surface is what we test).
	interfaces {
		interface lo {
			passive true
		}
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65000
			}
			router-id 10.0.0.1
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

option=env:var=ze.log.isis:value=info

cmd=foreground:seq=1:exec=ze -:stdin=ze-conf:timeout=15s
expect=exit:code=0
expect=stderr:contains=isis: engine started
expect=stderr:contains=show isis neighbor/database
reject=stderr:pattern=no net configured
reject=stderr:pattern=engine idle
reject=stderr:pattern=panic
reject=stderr:pattern=fatal error
reject=stderr:pattern=unknown command
