# Test: IS-IS show/clear command surface (spec-isis-13 CLI completeness).
#
# VALIDATES: spec-isis-13 -- the operator-facing `show isis <noun>` and
#            `clear isis <action>` commands answer through the plugin dispatcher
#            and the cmd_show.go proxy (ze-show:isis-* / ze-clear:isis-*). With a
#            NET configured and only a passive interface (no raw circuit to open,
#            so the engine starts cleanly without CAP_NET_RAW), the engine
#            originates its own LSP, so:
#              - show isis neighbor      -> JSON array (empty: no adjacency)   (AC-1)
#              - show isis database      -> JSON array carrying the own LSP    (AC-2)
#                                           with every row marked `own` true
#              - show isis database detail -> rows carrying decoded TLVs       (AC-2)
#                                           and the same `own` marker
#              - show isis route         -> JSON array (empty: no remote prefix)(AC-3)
#              - show isis interface     -> the passive interface row          (AC-4)
#              - show isis hostname      -> the local System ID -> hostname    (AC-5)
#              - show isis spf-log       -> JSON array (the SPF run history)   (AC-6)
#              - clear isis adjacency    -> done, status payload               (AC-8)
#              - clear isis counters     -> done, status payload               (AC-8)
# PREVENTS:  regression where a show/clear wire method 404s at dispatch, the
#            proxy recurses, or the engine never originates so the database is
#            empty.
#
# Live adjacency / SPF-over-the-wire behaviour needs raw L2 (AF_PACKET) on a
# Linux veth and is covered by the QEMU integration tests and the FRR interop
# scenarios (test/interop/scenarios/isis-*-frr); this functional test exercises
# the command surface against a started, idle-but-present engine.

tmpfs=isis-show.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
"""Dispatch the IS-IS show/clear surface against a configured daemon."""

import re
import sys

from ze_api import API, runtime_fail, result_json_data, result_text_data


def dispatch(api, command):
    resp = api._call_engine(
        'ze-plugin-engine:dispatch-command', {'command': command})
    if resp is None:
        return {'status': 'error', 'data': 'engine call returned None'}
    return resp.get('result', {})


def expect_done_list(api, command):
    r = dispatch(api, command)
    if r.get('status') != 'done':
        runtime_fail(
            f"{command}: expected done, got status={r.get('status')} "
            f"data={result_text_data(r)[:200]}")
    data = result_json_data(r, None)
    if not isinstance(data, list):
        runtime_fail(f"{command}: expected JSON list, got {data!r}")
    return data


def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()
    api.wait_for_post_startup(timeout=5.0)

    # AC-1: neighbor list is present and empty (no adjacency without a peer).
    neighbors = expect_done_list(api, 'show isis neighbor')
    if neighbors:
        runtime_fail(f"show isis neighbor: expected empty, got {neighbors!r}")

    # AC-2: the database carries the node's own originated LSP.
    db = expect_done_list(api, 'show isis database')
    if not db:
        runtime_fail("show isis database: expected the own LSP, got empty")
    if not any('lsp-id' in row for row in db):
        runtime_fail(f"show isis database: rows missing lsp-id: {db!r}")

    # AC-2 detail: each detail row expands into TLVs.
    detail = expect_done_list(api, 'show isis database detail')
    if not detail:
        runtime_fail("show isis database detail: expected rows, got empty")
    if not any('tlvs' in row for row in detail):
        runtime_fail(f"show isis database detail: rows missing tlvs: {detail!r}")

    # Ownership marker: every LSP in this database was originated by this node
    # (it is the only router in the scenario), so `own` must be present on every
    # row of BOTH views and true on every one.
    #
    # The key must be PRESENT, not merely truthy: `own` deliberately carries no
    # omitempty, so a future `json:"own,omitempty"` would drop it from every
    # not-own row and this assertion is what refuses that.
    #
    # lsp-id must carry the LSP ID and NOTHING else. Ownership travels in its own
    # key, never as a character decorating the identifier: `*` is an input token
    # in ze (the selector wildcard), and a sigil glued to an ID does not survive
    # `| json` or a downstream match on the ID. The check is a strict pattern over
    # the whole value, so it rejects any decoration rather than one character.
    lspid_re = re.compile(r'^[0-9a-f]{4}\.[0-9a-f]{4}\.[0-9a-f]{4}\.[0-9a-f]{2}-[0-9a-f]{2}$')
    for view, rows in (('show isis database', db),
                       ('show isis database detail', detail)):
        missing = [row.get('lsp-id') for row in rows if 'own' not in row]
        if missing:
            runtime_fail(f"{view}: rows missing the own key: {missing!r}")
        foreign = [row.get('lsp-id') for row in rows if row['own'] is not True]
        if foreign:
            runtime_fail(
                f"{view}: this node's own LSPs reported own != true: {foreign!r}")
        decorated = [row['lsp-id'] for row in rows
                     if not lspid_re.match(row.get('lsp-id', ''))]
        if decorated:
            runtime_fail(
                f"{view}: lsp-id carries more than the LSP ID: {decorated!r}")

    # AC-3: route list present (empty without a remote prefix).
    expect_done_list(api, 'show isis route')

    # AC-4: the passive interface appears in the interface view.
    ifaces = expect_done_list(api, 'show isis interface')
    if not any(row.get('name') == 'lo' and row.get('passive') for row in ifaces):
        runtime_fail(f"show isis interface: passive lo not reported: {ifaces!r}")

    # AC-5: the dynamic hostname maps the local System ID -> the configured name.
    hosts = expect_done_list(api, 'show isis hostname')
    if not any(row.get('hostname') == 'r1-isis' for row in hosts):
        runtime_fail(f"show isis hostname: r1-isis mapping missing: {hosts!r}")

    # AC-6: spf-log is present (the startup origination triggers at least one run).
    expect_done_list(api, 'show isis spf-log')

    # AC-8: clear actions return a status payload.
    for action in ('clear isis adjacency', 'clear isis counters'):
        r = dispatch(api, action)
        if r.get('status') != 'done':
            runtime_fail(
                f"{action}: expected done, got status={r.get('status')} "
                f"data={result_text_data(r)[:200]}")

    print('OK: show isis neighbor/database[ detail]/route/interface/hostname/'
          'spf-log + clear isis adjacency/counters dispatched through the engine',
          file=sys.stderr)

    dispatch(api, 'request shutdown')
    api.wait_for_shutdown()


if __name__ == '__main__':
    main()
EOF_RUN

stdin=ze-conf:terminator=EOF_CONF
plugin {
	external isis-show {
		run ./isis-show.run
		encoder json
	}
}

isis {
	net 49.0001.0000.0000.0001.00
	level l1-l2
	hostname r1-isis
	# A passive interface is advertised but opens no raw circuit, so the engine
	# starts cleanly without CAP_NET_RAW (the show/clear surface is what we test).
	interfaces {
		interface lo {
			passive true
		}
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65000
			}
			router-id 10.0.0.1
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		process isis-show {
		}
	}
}
EOF_CONF

option=env:var=ze.log.isis:value=info

cmd=foreground:seq=1:exec=ze -:stdin=ze-conf:timeout=15s
expect=exit:code=0
expect=stderr:contains=isis: engine started
expect=stderr:contains=show isis neighbor/database
reject=stderr:pattern=no net configured
reject=stderr:pattern=engine idle
reject=stderr:pattern=panic
reject=stderr:pattern=fatal error
reject=stderr:pattern=unknown command
