# Test: IS-IS SPF route install wiring (spec-isis-9 SPF + FIB install).
#
# VALIDATES: spec-isis-9-spf-rib -- the IS-IS component boots with the real
#            top-level `isis { ... }` schema, the SPF subsystem is wired
#            (debounce trigger + Loc-RIB Installer), and `show isis route` returns
#            an EMPTY list when the node has no adjacency and so no remote prefix
#            is reachable (no phantom routes). This proves the SPF -> Loc-RIB
#            insertion path is plumbed end to end through the show RPC without
#            fabricating convergence (User Story 1, the wiring half of AC-2).
# PREVENTS:  a regression where `show isis route` is unwired (returns a stub /
#            error) or where SPF installs routes with no adjacency (phantom FIB
#            entries), and a panic in the SPF trigger on a freshly started engine.
#
# The LIVE multi-node install (a remote prefix appearing in the kernel FIB tagged
# RTPROT_ZE, ECMP installing multiple next-hops, and withdrawal on neighbour loss)
# needs raw L2 (AF_PACKET) on a Linux veth and is proven by:
#   - the in-memory SPF unit tests (run on any host, including darwin):
#     TestISISSPFRoute (LSDB change -> SPF -> Loc-RIB insertion),
#     TestISISInstallPath (one locrib.Path per ECMP next-hop, distinct Instance,
#     Source=IS-IS, AdminDistance 115; forward-remove on loss),
#     TestISISInstallShrinkECMP, TestISISSPFShortestPath / ECMP / OverloadTransit,
#     TestISISMetricWidth, and the committed sysrib path-group expansion
#     TestSysribECMPPathGroup / TestSysribSinglePathNoECMP (internal/component/sysrib);
#   - the QEMU integration tests + the FRR interop scenarios isis-p2p-frr /
#     isis-lan-dis-frr (owned by spec-isis-13), which drive a real adjacency so a
#     remote prefix reaches the kernel.
# This functional test exercises the single-daemon half: config -> engine -> SPF
# wiring -> `show isis route`, with no peer. The external dispatcher is anchored
# under a BGP peer process (the hub/TLS acceptor mechanism), matching the LDP
# convergence test.


stdin=ze-conf:terminator=EOF_CONF
plugin {
	external isis-route {
		run "ze-test fixture isis/isis-route-install"
		encoder json
	}
}

isis {
	net 49.0001.0000.0000.0001.00
	level l1-l2
	interfaces {
		interface lo {
			passive true
		}
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65000
			}
			router-id 10.0.0.1
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

option=env:var=ze.log.isis:value=info

cmd=foreground:seq=1:exec=ze -:stdin=ze-conf:timeout=15s
expect=exit:code=0
expect=stderr:contains=IS-IS route table empty with no adjacency
reject=stderr:pattern=engine idle
reject=stderr:pattern=panic
reject=stderr:pattern=fatal error
