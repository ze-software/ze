# Test: OSPFv3 (IPv6 family) NBMA interface boots at runtime (spec-ospf-ext-8).
#
# VALIDATES: the daemon starts the OSPFv3 engine with an NBMA IPv6 interface and a
# static neighbor list (keyed by router-id, with a link-local) and reaches post-startup
# without a panic, exercising the v6 NBMA config -> engine -> iface Start (Waiting +
# poll) path.
# PREVENTS: the v6 NBMA config crashing the engine at startup.
#
# NOTE: `show ospf ipv6 interface` is not yet wired (the OSPFv3 engine is not attached
# to the CLI dispatch), so this test asserts a clean boot rather than an interface
# snapshot; the NBMA election/Network-LSA/Link-LSA behavior is covered by the Go unit
# tests.
#
# PLATFORM: needs-linux -- the OSPFv3 raw IPv6 socket and interface backend are
# Linux-only, so this is validated in the QEMU Alpine VM.
option=needs-linux:caps=net-admin
# The v6 engine opens a raw proto-89 socket on nbma0 (IPv6 link-local, auto on
# link-up); provision the dummy link inside the per-test netns. No address: the
# link-local address the socket joins is assigned automatically when the link
# comes up.
option=netns-link:name=nbma0


stdin=ze-conf:terminator=EOF_CONF
plugin {
	external ospfv3-nbma {
		run "ze-test fixture ospfv3/ospfv3-nbma"
		encoder json
	}
}

ospf {
	router-id 10.0.0.1
	address-family {
		ipv6 {
			areas {
				area 0.0.0.0 { }
			}
			interfaces {
				interface nbma0 {
					area 0.0.0.0
					network-type nbma
					poll-interval 90
					nbma-neighbor 2.2.2.2 {
						link-local fe80::2
						priority 1
					}
				}
			}
		}
	}
}

bgp {
	peer peer1 {
		connection {
			remote { ip 127.0.0.1; }
			local { ip 127.0.0.1; accept false; }
		}
		session {
			asn { local 65000; remote 65000; }
			router-id 10.0.0.1
			family { ipv4/unicast { prefix { maximum 10000; } } }
			capability { graceful-restart disable; }
		}
		behavior { group-updates disable; }
	}
}
EOF_CONF

cmd=foreground:seq=1:exec=ze -:stdin=ze-conf:timeout=15s
expect=exit:code=0
expect=stderr:contains=OSPFv3 NBMA engine started
reject=stderr:pattern=panic
reject=stderr:pattern=fatal error
