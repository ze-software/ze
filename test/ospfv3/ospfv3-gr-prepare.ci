# OSPFv3 planned restart originates one 0x000B Grace-LSA per interface + persists the NVS fact
#
# VALIDATES: OSPF Graceful Restart (spec-ospf-ext-9, RFC 3623 / RFC 5187) via the runner.
# PREVENTS: a GR behavior compiling but never exercised end-to-end through the test gate.

cmd=foreground:seq=1:exec=go test -v ./internal/plugins/ospf -run TestGraceLSAv6Originated|TestRestartFactPersistsAcrossRestart -count=1:timeout=90s
expect=exit:code=0
expect=stdout:contains=PASS
