# Test: OSPFv3 Segment Routing config validation + doctor code (spec-ospf-ext-5, RFC 8666).
#
# VALIDATES: an `ospf { address-family { ipv6 { segment-routing { ... } } } }` block reaches
# the OSPF YANG schema and validates (SRGB/SRLB ranges, node prefix-SID index), and the SR
# label-overlap doctor diagnostic (doctor-ospf-segment-routing-overlap) is registered and
# explainable.
# PREVENTS: the IPv6 segment-routing config surface not being wired, or the SR overlap doctor
# code regressing to unexplainable.

stdin=ospfv3-sr-valid:terminator=EOF_V6SR
ospf {
	router-id 1.1.1.1
	address-family {
		ipv6 {
			segment-routing {
				enable true
				srgb {
					lower-bound 16000
					upper-bound 23999
				}
				srlb {
					lower-bound 15000
					upper-bound 15999
				}
				prefix-sid 2001:db8::1/128 {
					index 1
				}
			}
			areas {
				area 0.0.0.0 {
					area-type normal
				}
			}
			interfaces {
				interface eth0 {
					area 0.0.0.0
					network-type point-to-point
				}
			}
		}
	}
}
EOF_V6SR

cmd=foreground:seq=1:exec=ze config validate -:stdin=ospfv3-sr-valid:exit=0
expect=exit:code=0
expect=stdout:contains=configuration valid

cmd=foreground:seq=2:exec=ze explain doctor-ospf-segment-routing-overlap:exit=0
expect=exit:code=0
expect=stdout:contains=doctor-ospf-segment-routing-overlap
expect=stdout:contains=SRGB
