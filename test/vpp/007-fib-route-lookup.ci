# Design: plan/spec-vpp-fib-query.md -- VPP FIB route lookup via IPRouteLookupV2
#
# Test: VPP backend RouteLookup dispatches IPRouteLookupV2 to the stub.
#
# Flow: driver.py starts three processes:
#   1. vpp_stub on a per-test Unix socket with ip_route_lookup_v2 handler.
#   2. ze-peer on a dynamic port (sends a BGP UPDATE so ze has a session).
#   3. ze with vpp.external=true. Once the session is up, the driver
#      issues `show route lookup 10.20.0.1` via dispatch-command
#      through a test plugin, and verifies the response contains
#      prefix=10.20.0.0/24 from the stub's canned reply.
#
# VALIDATES: spec-vpp-fib-query AC-1 -- VPP FIB lookup returns VPP data
#            spec-vpp-fib-query AC-5 -- response JSON keys match schema
# PREVENTS:  RouteLookup bypassing Backend (old netlink hardcode)

tmpfs=peer-script:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=20s
option=update:value=send-route:prefix=10.20.0.0/24:next-hop=10.0.0.1:origin-as=65001
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

tmpfs=lookup-test.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
"""Test plugin: waits for post-startup, then dispatches show route lookup."""
import json
import sys
import time
from ze_api import API


def dispatch(api, command):
    resp = api._call_engine(
        'ze-plugin-engine:dispatch-command', {'command': command})
    if resp is None:
        return {'status': 'error', 'data': 'engine call returned None'}
    return resp.get('result', {})


def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()
    api.wait_for_post_startup(timeout=10.0)

    try:
        # Wait for the VPP backend to answer, rather than holding a blind 2s and
        # hoping its channel is up. The backend reports a non-"done" status
        # until it has acquired the channel, so re-dispatching until "done" IS
        # the readiness signal -- and on a slow host it waits longer, where the
        # fixed sleep simply failed.
        result = api.dispatch_until_done('show route lookup 10.20.0.1', attempts=40)
        status = result.get('status')
        data = result.get('data')

        if status != 'done':
            print(f'FAIL: status={status} data={data}', file=sys.stderr)
            sys.exit(1)

        if isinstance(data, str):
            data = json.loads(data)

        prefix = data.get('prefix', '')
        dest = data.get('destination', '')
        proto = data.get('protocol', '')

        if prefix != '10.20.0.0/24':
            print(f'FAIL: prefix={prefix!r}, want 10.20.0.0/24', file=sys.stderr)
            sys.exit(1)
        if dest != '10.20.0.1':
            print(f'FAIL: destination={dest!r}, want 10.20.0.1', file=sys.stderr)
            sys.exit(1)

        print(f'OK: route lookup returned prefix={prefix} dest={dest} proto={proto}',
              file=sys.stderr)
    finally:
        dispatch(api, 'request shutdown')
        api.wait_for_shutdown()


if __name__ == '__main__':
    main()
EOF_RUN

tmpfs=driver.py:mode=755:terminator=EOF_PY
#!/usr/bin/env python3
"""Orchestrate vpp_stub + ze-peer + ze; verify route lookup via plugin."""
import os
import signal
import subprocess
import sys
import time


CONFIG_TEMPLATE = """environment {
\ttcp {
\t\tattempts 3
\t}
}

bgp {
\tpeer peer1 {
\t\tconnection {
\t\t\tremote { ip 127.0.0.1; }
\t\t\tlocal  { ip 127.0.0.1; accept false; }
\t\t}
\t\tsession {
\t\t\tasn { local 1; remote 1; }
\t\t\trouter-id 1.2.3.4;
\t\t\tfamily { ipv4/unicast { prefix { maximum 10000; } } }
\t\t\tcapability { graceful-restart disable; }
\t\t}
\t\tbehavior { group-updates disable; }

\t\tprocess lookup-test {
\t\t}
\t}
}

plugin {
\texternal lookup-test {
\t\trun ./lookup-test.run
\t\tencoder json
\t}
}

vpp {
\tenabled  true;
\texternal true;
\tapi-socket %SOCK%;
}
"""


def _find_repo_root():
    for p in os.environ.get("PYTHONPATH", "").split(os.pathsep):
        if p and os.path.basename(p) == "scripts":
            return os.path.dirname(os.path.dirname(p))
    d = os.getcwd()
    while d and d != "/":
        if os.path.isfile(os.path.join(d, "go.mod")):
            return d
        d = os.path.dirname(d)
    raise SystemExit("driver: cannot locate repo root")


def _wait_for_socket(path, deadline):
    while time.time() < deadline:
        if os.path.exists(path):
            return True
        # poll interval; the loop above returns once the socket path appears, bounded wait not a blind sleep
        time.sleep(0.05)
    return False


def _terminate(proc, grace=3.0):
    if proc is None or proc.poll() is not None:
        return
    proc.send_signal(signal.SIGTERM)
    try:
        proc.wait(timeout=grace)
    except subprocess.TimeoutExpired:
        proc.kill()
        proc.wait(timeout=2.0)


def main() -> int:
    repo = _find_repo_root()
    stub_py = os.path.join(repo, "test", "scripts", "vpp_stub.py")

    cwd = os.getcwd()
    sock = os.path.join(cwd, "api.sock")
    if len(sock) >= 108:
        sys.stderr.write(f"driver: socket path too long: {sock}\n")
        return 1
    log = os.path.join(cwd, "vpp-requests.jsonl")

    if len(sys.argv) < 2:
        sys.stderr.write("driver: expected port as argv[1]\n")
        return 1
    try:
        port = int(sys.argv[1])
    except ValueError:
        sys.stderr.write(f"driver: bad port arg {sys.argv[1]!r}\n")
        return 1

    stub = subprocess.Popen(
        ["python3", stub_py, "--socket", sock, "--log", log, "--deadline", "30", "-v"],
        stderr=subprocess.PIPE,
        text=True,
    )
    ze = None
    peer = None
    try:
        if not _wait_for_socket(sock, time.time() + 5.0):
            sys.stderr.write("driver: stub socket did not appear\n")
            return 1

        peer_stdout_r, peer_stdout_w = os.pipe()
        peer = subprocess.Popen(
            ["ze-test", "peer", "--port", str(port), os.path.join(cwd, "peer-script")],
            stdout=peer_stdout_w,
            stderr=sys.stderr,
            text=True,
        )
        os.close(peer_stdout_w)
        peer_listening = False
        listen_deadline = time.time() + 5.0
        peer_stdout_file = os.fdopen(peer_stdout_r, "r", buffering=1)
        while time.time() < listen_deadline:
            if peer.poll() is not None:
                break
            line = peer_stdout_file.readline()
            if not line:
                # poll interval; the loop above breaks when ze-peer reports listening, bounded wait not a blind sleep
                time.sleep(0.05)
                continue
            sys.stderr.write(f"peer> {line}")
            if "listening on" in line:
                peer_listening = True
                break
        import threading
        def _drain():
            try:
                for line in peer_stdout_file:
                    sys.stderr.write(f"peer> {line}")
            except (ValueError, OSError):
                pass
        threading.Thread(target=_drain, daemon=True).start()
        if not peer_listening:
            sys.stderr.write(f"driver: ze-peer did not report listening rc={peer.returncode}\n")
            return 1

        config = CONFIG_TEMPLATE.replace("%SOCK%", sock)
        env = os.environ.copy()
        env["ze.log.vpp"] = "info"
        env["ze.log.iface"] = "debug"
        env["ze_test_bgp_port"] = str(port)
        ze = subprocess.Popen(
            ["ze", "-"],
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            env=env,
        )
        assert ze.stdin is not None
        ze.stdin.write(config)
        ze.stdin.close()

        # Wait for ze to finish (the test plugin shuts it down after the lookup).
        try:
            ze.wait(timeout=25.0)
        except subprocess.TimeoutExpired:
            sys.stderr.write("driver: ze did not exit within 25s\n")
            _terminate(ze, grace=3.0)

        ze_stderr = ""
        if ze.stderr is not None:
            try:
                ze_stderr = ze.stderr.read()
            except (ValueError, OSError):
                pass
            sys.stderr.write(ze_stderr)

        ok = "OK: route lookup returned" in ze_stderr
        if not ok:
            sys.stderr.write("FAIL: route lookup did not succeed\n")
        return 0 if ok else 1
    finally:
        _terminate(peer, grace=2.0)
        _terminate(stub, grace=2.0)


sys.exit(main())
EOF_PY

cmd=foreground:seq=1:exec=python3 ./driver.py $PORT:timeout=30s
expect=exit:code=0
expect=stderr:pattern=OK: route lookup returned prefix=10.20.0.0/24
