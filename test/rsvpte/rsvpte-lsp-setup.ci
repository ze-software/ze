# Test: RSVP-TE single-daemon boot, config delivery, and show commands.
#
# VALIDATES: spec-mpls-3-rsvp-te -- a top-level `rsvp-te { ... }` config block
#            reaches the in-process RSVP-TE engine (router-id, per-interface
#            bandwidth list, and tunnel/explicit-route lists all parsed from the
#            keyed-map YANG config tree), the engine comes up configured (not
#            idle), populates the admission controller from the interface config,
#            and answers `show rsvp-te session` / `show rsvp-te interface`.
# PREVENTS:  regression where the config section is delivered root-wrapped, with
#            string-typed leaves and keyed-map lists (the Tree.ToMap shape), but
#            the parser reads the wrong nesting/type, leaving the engine idle
#            ("no router-id configured") and the interface/tunnel lists empty;
#            and where the show RPCs recurse into themselves at dispatch.
#
# Live LSP signaling (AC-1 PATH sent, AC-2 RESV from egress, AC-4 head-end label
# push) needs the raw-IP transport (protocol 46) plus a peer LSR. RSVP-TE has no
# FRR counterpart (FRR ships no rsvpd), so there is NO live interop fixture by
# design. The signaling state machine -- PATH/RESV exchange, label push, ingress
# and egress roles -- is unit-tested end to end in
# internal/plugins/rsvpte/engine_test.go (TestEngineEgressPathToResv,
# TestEngineIngressResvToUp, TestEngineTransitForwarding). On hosts without
# CAP_NET_RAW (or on darwin) the transport stays closed so no PATH is sent, but
# setupTunnel still installs the configured tunnel's ingress LSP; this test
# asserts the always-available half: config parse -> engine configured ->
# interface admission state AND the tunnel's ingress LSP visible via show.


stdin=ze-conf:terminator=EOF_CONF
plugin {
	external rsvpte-setup {
		run "ze-test fixture rsvpte/rsvpte-lsp-setup"
		encoder json
	}
}

rsvp-te {
	router-id 10.0.0.1
	refresh-period 30
	interface lo {
		max-bandwidth 10e9
		max-reservable-bandwidth 8e9
		address 127.0.0.1/8
	}
	tunnel to-egress {
		destination 10.0.0.9
		tunnel-id 1
		bandwidth 1e9
		explicit-route 1 {
			address 10.0.0.9/32
		}
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65000
			}
			router-id 10.0.0.1
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

option=env:var=ze.log.rsvp.te:value=info

cmd=foreground:seq=1:exec=ze -:stdin=ze-conf:timeout=15s
expect=exit:code=0
expect=stderr:contains=interface admission + session show dispatched
reject=stderr:pattern=no router-id configured
reject=stderr:pattern=engine idle
reject=stderr:pattern=panic
reject=stderr:pattern=fatal error
