# Test: RSVP-TE per-interface bandwidth is parsed and reported by admission.
#
# VALIDATES: spec-mpls-3-rsvp-te AC-10 -- the per-interface max-bandwidth /
#            max-reservable-bandwidth leaves (string-typed in the YANG config
#            tree, e.g. "8e9") are parsed and seeded into the admission
#            controller, and `show rsvp-te interface` reports the max,
#            reservable, reserved, and available figures.
# PREVENTS:  regression where the interface bandwidth never reaches admission
#            (interface list dropped or numbers read as the wrong JSON type),
#            silently disabling oversubscription protection.
#
# AC-8 (PathErr on oversubscription) is the admission-denial path: when a tunnel
# requests more than the remaining reservable bandwidth, RSVP-TE must reject it
# with a PathErr rather than oversubscribe the link. That decision needs a
# signaled LSP (raw-IP transport + peer), and RSVP-TE has no FRR counterpart
# (no rsvpd), so there is no live interop fixture. The admission arithmetic --
# reserve up to the limit, deny beyond it, release on teardown -- is unit-tested
# directly in internal/plugins/rsvpte/admission_test.go
# (TestRSVPAdmissionDenied, TestRSVPAdmissionExactLimit,
#  TestRSVPAdmissionReserveAndRelease) and the engine-level PathErr in
# internal/plugins/rsvpte/engine_test.go (TestEngineAdmissionDeniedPathErr).
# This functional test covers the always-available half: config -> admission
# state visible via show.

tmpfs=rsvpte-bw.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
"""Assert per-interface bandwidth from config is reflected in admission state."""

import sys

from ze_api import API, runtime_fail, result_json_data, result_text_data


def dispatch(api, command):
    resp = api._call_engine(
        'ze-plugin-engine:dispatch-command', {'command': command})
    if resp is None:
        return {'status': 'error', 'data': 'engine call returned None'}
    return resp.get('result', {})


def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()
    api.wait_for_post_startup(timeout=5.0)

    r = dispatch(api, 'show rsvp-te interface')
    if r.get('status') != 'done':
        runtime_fail(
            f"show rsvp-te interface: expected done, got status={r.get('status')} "
            f"data={result_text_data(r)[:200]}")
    ifaces = result_json_data(r, None)
    if not isinstance(ifaces, list):
        runtime_fail(f"show rsvp-te interface: expected list, got {ifaces!r}")

    lo = next((i for i in ifaces if i.get('name') == 'lo'), None)
    if lo is None:
        runtime_fail(f"show rsvp-te interface: missing 'lo': {ifaces!r}")
    # The configured limits must round-trip into admission, and with no LSP
    # signaled nothing is reserved yet, so available == reservable. This is the
    # per-interface bandwidth accounting we assert.
    if lo.get('max-bandwidth') != 10e9:
        runtime_fail(f"lo max-bandwidth={lo.get('max-bandwidth')!r}, want 10e9")
    if lo.get('max-reservable') != 8e9:
        runtime_fail(f"lo max-reservable={lo.get('max-reservable')!r}, want 8e9")
    if lo.get('reserved-bandwidth') != 0:
        runtime_fail(f"lo reserved-bandwidth={lo.get('reserved-bandwidth')!r}, want 0")
    if lo.get('available-bandwidth') != 8e9:
        runtime_fail(f"lo available-bandwidth={lo.get('available-bandwidth')!r}, want 8e9")

    print('OK: rsvp-te per-interface bandwidth parsed into admission state',
          file=sys.stderr)

    dispatch(api, 'request shutdown')
    api.wait_for_shutdown()


if __name__ == '__main__':
    main()
EOF_RUN

stdin=ze-conf:terminator=EOF_CONF
plugin {
	external rsvpte-bw {
		run ./rsvpte-bw.run
		encoder json
	}
}

rsvp-te {
	router-id 10.0.0.1
	refresh-period 30
	interface lo {
		max-bandwidth 10e9
		max-reservable-bandwidth 8e9
		address 127.0.0.1/8
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65000
			}
			router-id 10.0.0.1
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		process rsvpte-bw {
		}
	}
}
EOF_CONF

option=env:var=ze.log.rsvp.te:value=info

cmd=foreground:seq=1:exec=ze -:stdin=ze-conf:timeout=15s
expect=exit:code=0
expect=stderr:contains=per-interface bandwidth parsed into admission state
reject=stderr:pattern=no router-id configured
reject=stderr:pattern=engine idle
reject=stderr:pattern=panic
reject=stderr:pattern=fatal error
