# Test: RSVP-TE boots a tunnel with an explicit route and the tunnel/session
# show commands dispatch cleanly.
#
# VALIDATES: spec-mpls-3-rsvp-te -- a tunnel with an ordered explicit-route list
#            parses from the keyed-map config tree (hops sorted by their numeric
#            index key), the engine comes up configured, and `show rsvp-te
#            tunnel` / `show rsvp-te session` answer as well-formed JSON arrays.
# PREVENTS:  regression where the explicit-route list is dropped or its hop order
#            scrambled, or where the tunnel show handler recurses / 404s.
#
# AC-7 (make-before-break reroute: signal the new LSP over the new ERO before
# tearing the old one, so traffic never blackholes) is a signaling behavior. It
# needs the raw-IP transport and a peer LSR, and RSVP-TE has no FRR counterpart
# (no rsvpd), so there is no live interop fixture. The make-before-break overlap
# -- shared-explicit reservation style, new path up before old path torn -- is
# unit-tested directly against the engine in
# internal/plugins/rsvpte/reroute_test.go (TestEngineMakeBeforeBreak,
# TestSetupTunnelEROChangeReroutes). This functional test covers the
# always-available half: a tunnel + ERO config reaches the engine and the
# tunnel/session show commands dispatch.

tmpfs=rsvpte-reroute.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
"""Assert `show rsvp-te tunnel` / `show rsvp-te session` dispatch as arrays."""

import sys

from ze_api import API, runtime_fail, result_json_data, result_text_data


def dispatch(api, command):
    resp = api._call_engine(
        'ze-plugin-engine:dispatch-command', {'command': command})
    if resp is None:
        return {'status': 'error', 'data': 'engine call returned None'}
    return resp.get('result', {})


def done_array(api, command):
    r = dispatch(api, command)
    if r.get('status') != 'done':
        runtime_fail(
            f"{command}: expected done, got status={r.get('status')} "
            f"data={result_text_data(r)[:200]}")
    arr = result_json_data(r, None)
    if not isinstance(arr, list):
        runtime_fail(f"{command}: expected list, got {arr!r}")
    return arr


def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()
    api.wait_for_post_startup(timeout=5.0)

    # Both ingress-tunnel and full-session views must dispatch through the engine
    # and return arrays. Any ingress tunnel reported must carry a positive
    # ero-hops count, since the config supplies a two-hop explicit route -- which
    # is what we assert when an LSP is present.
    tunnels = done_array(api, 'show rsvp-te tunnel')
    for t in tunnels:
        if t.get('ero-hops', 0) < 1:
            runtime_fail(f"show rsvp-te tunnel: expected ERO hops, got {t!r}")

    done_array(api, 'show rsvp-te session')

    print('OK: rsvp-te tunnel + session show dispatched for an ERO tunnel',
          file=sys.stderr)

    dispatch(api, 'request shutdown')
    api.wait_for_shutdown()


if __name__ == '__main__':
    main()
EOF_RUN

stdin=ze-conf:terminator=EOF_CONF
plugin {
	external rsvpte-reroute {
		run ./rsvpte-reroute.run
		encoder json
	}
}

rsvp-te {
	router-id 10.0.0.1
	refresh-period 30
	interface lo {
		max-bandwidth 10e9
		max-reservable-bandwidth 8e9
		address 127.0.0.1/8
	}
	tunnel to-egress {
		destination 10.0.0.9
		tunnel-id 1
		bandwidth 1e9
		explicit-route 1 {
			address 10.0.0.5/32
		}
		explicit-route 2 {
			address 10.0.0.9/32
		}
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65000
			}
			router-id 10.0.0.1
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		process rsvpte-reroute {
		}
	}
}
EOF_CONF

option=env:var=ze.log.rsvp.te:value=info

cmd=foreground:seq=1:exec=ze -:stdin=ze-conf:timeout=15s
expect=exit:code=0
expect=stderr:contains=tunnel + session show dispatched for an ERO tunnel
reject=stderr:pattern=no router-id configured
reject=stderr:pattern=engine idle
reject=stderr:pattern=panic
reject=stderr:pattern=fatal error
