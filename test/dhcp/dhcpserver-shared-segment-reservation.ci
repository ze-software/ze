# Test: two subnets on one LAN segment, a static reservation in each, served
#       through a real listener: a reservation in the second subnet wins over
#       the first subnet's pool, and an unreserved client gets the pool of the
#       subnet the listen interface's primary address is in, then the other
#       subnet's pool when that one is full.
# VALIDATES: spec-home-cpe-2 AC-1, AC-2, AC-3, AC-4 -- config -> dhcpserver
#            bindListeners -> serveRequests -> resolveSegment (the receiving
#            device's addresses, read from netlink) -> segment.discover
#            (internal/plugins/dhcpserver/segment.go): reservation first, then
#            the home subnet's pool, then the segment's other pools; option 54
#            from segment.serverID, the device's address in the subnet the
#            offer is built from (RFC 2131 Section 4.1).
# PREVENTS: the defect the spec was opened for -- the first subnet's handler
#           claiming every DISCOVER and offering its pool to a client
#           reserved in the second subnet -- and a server identifier taken
#           from config rather than from an address the server holds.
#
# The wire: the compiled fixture dhcp/link (internal/test/fixture,
# dhcp_fixture_probe_linux.go) creates the veth pair zedhseg/zedhsegp before
# the daemon starts and gives zedhseg 192.168.50.1/24 (primary, so the home
# subnet) then 10.99.0.1/24. dhcp/probe (internal/test/dhcpprobe) writes each
# DHCPDISCOVER on zedhsegp with AF_PACKET, BROADCAST bit set, and reads the
# reply the server broadcasts on zedhseg. It checks every field the step
# names and fails on a difference, and prints the line the expect=stdout
# lines below match.
#
# The lease table has no show command, so the server's own record of each
# offer is its "dhcpserver: lease" line (register.go logExchange), asserted on
# stderr beside the wire.
#
# The 192.168.50.0/24 pool holds one address, so AC-3's offer of
# 192.168.50.100 (held for that MAC by pool.allocate) fills it, and AC-4's
# unreserved client must be offered from 10.99.0.0/24.
#
# Breaks that turn it red: resolveSegment serving one subnet per listener (AC-1
# gets 192.168.50.100); segment.discover reading the pools before
# segment.reservation (AC-1 and AC-2 get pool addresses); serverID answering
# the default-router or the primary address for every subnet (AC-1's sid is
# 192.168.50.1).
#
# Requires CAP_NET_ADMIN (veth, addresses) and CAP_NET_RAW (AF_PACKET).

option=needs-linux:caps=net-admin,net-raw
option=timeout:value=40s
option=env:var=ze.log.dhcpserver:value=info

stdin=ze-bgp:terminator=EOF_CONF
service {
    dhcp-server {
        enabled true
        listen-interface zedhseg
        shared-network home {
            subnet 192.168.50.0/24 {
                range household {
                    start 192.168.50.100
                    stop 192.168.50.100
                }
                lease-time 3600
                default-router 192.168.50.1
                dns-server 192.168.50.53
                static-mapping laptop {
                    mac-address 02:00:00:00:00:01
                    ip-address 192.168.50.20
                }
            }
            subnet 10.99.0.0/24 {
                range isolated {
                    start 10.99.0.100
                    stop 10.99.0.110
                }
                lease-time 3600
                default-router 10.99.0.1
                dns-server 10.99.0.53
                static-mapping camera {
                    mac-address 02:00:00:00:00:02
                    ip-address 10.99.0.20
                }
            }
        }
    }
}
EOF_CONF

cmd=foreground:seq=1:exec=le test fixture dhcp/link zedhseg 192.168.50.1/24 10.99.0.1/24:exit=0
cmd=background:seq=2:exec=ze -:stdin=ze-bgp
cmd=foreground:seq=3:exec=le test fixture dhcp/probe zedhseg x,ac1,type=discover,mac=02-00-00-00-00-02,expect=offer,yiaddr=10.99.0.20,sid=10.99.0.1,router=10.99.0.1,mask=255.255.255.0,dns=10.99.0.53 x,ac2,type=discover,mac=02-00-00-00-00-01,expect=offer,yiaddr=192.168.50.20,sid=192.168.50.1,router=192.168.50.1,dns=192.168.50.53 x,ac3,type=discover,mac=02-00-00-00-00-03,expect=offer,yiaddr=192.168.50.100,sid=192.168.50.1 x,ac4,type=discover,mac=02-00-00-00-00-04,expect=offer,yiaddr=10.99.0.100,sid=10.99.0.1,router=10.99.0.1:timeout=30s
expect=exit:code=0
expect=stdout:contains=dhcp ac1 sent=discover reply=offer yiaddr=10.99.0.20 sid=10.99.0.1 router=10.99.0.1 mask=255.255.255.0 dns=10.99.0.53
expect=stdout:contains=dhcp ac2 sent=discover reply=offer yiaddr=192.168.50.20 sid=192.168.50.1 router=192.168.50.1
expect=stdout:contains=dhcp ac3 sent=discover reply=offer yiaddr=192.168.50.100 sid=192.168.50.1
expect=stdout:contains=dhcp ac4 sent=discover reply=offer yiaddr=10.99.0.100 sid=10.99.0.1
expect=stderr:pattern=dhcpserver: lease.*reply=OFFER mac=02:00:00:00:00:02 ip=10.99.0.20
expect=stderr:pattern=dhcpserver: lease.*reply=OFFER mac=02:00:00:00:00:01 ip=192.168.50.20
expect=stderr:pattern=dhcpserver: lease.*reply=OFFER mac=02:00:00:00:00:03 ip=192.168.50.100
expect=stderr:pattern=dhcpserver: lease.*reply=OFFER mac=02:00:00:00:00:04 ip=10.99.0.100
reject=stderr:pattern=panic
