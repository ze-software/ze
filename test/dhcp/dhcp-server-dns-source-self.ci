# Test: a subnet whose option 6 list is `dns-source source self` hands out
#       Ze's own address inside that subnet on the interface that received
#       the request, and nothing else: not the interface's primary address,
#       not the subnet's dns-server.
# Spec: spec-home-cpe-23b-dns-source-consumers -- AC-7 (option 6), D-6
# VALIDATES: the self class of the subnet's list (dhcpHandler.selectDNS ->
#            dnssource.Select, internal/plugins/dhcpserver/handler.go) through
#            the daemon and a real listener: the self address is read from
#            the receiving interface for each request (segment.go) and
#            written as option 6 by buildOfferedReply.
# PREVENTS: a self class that offers nothing, one that hands out the
#           interface's primary address for every subnet, and a list that
#           lets the configured dns-server in beside self.
#
# zedhself holds 198.18.20.7/24 (primary: deliberately not .1, so an address
# derived from the prefix's first host is visible) and 10.99.20.1/24. Both
# subnets list self alone; 198.18.20.0/24 also sets dns-server 198.51.100.1,
# which a list naming only self must not send. The client 02-..-52 has a
# static mapping in 10.99.20.0/24, so its DISCOVER selects that subnet and
# its option 6 must be 10.99.20.1, not the primary 198.18.20.7. The AC's
# documentation addresses (192.0.2.0/24) are replaced by ones no other .ci
# holds, because the DHCP tests share the host's namespace.
#
# Wire and fixtures as in dhcpserver-server-identifier.ci.
#
# DISCRIMINATION (break overlay, not yet run):
# tmp/session/2026-11-07-104251/scratch/rwinv/c23b-dhcp-self/ replaces
# internal/plugins/dhcpserver/handler.go with a copy whose selectDNS never
# fills the self class. The probe must then fail at self-primary with
# "dns (option 6) absent, want 198.18.20.7".
#
# Requires CAP_NET_ADMIN (veth, addresses) and CAP_NET_RAW (AF_PACKET).

option=needs-linux:caps=net-admin,net-raw
option=timeout:value=40s

stdin=ze-bgp:terminator=EOF_CONF
service {
    dhcp-server {
        enabled true
        listen-interface zedhself
        shared-network home {
            subnet 198.18.20.0/24 {
                range household {
                    start 198.18.20.100
                    stop 198.18.20.110
                }
                lease-time 3600
                dns-server 198.51.100.1
                dns-source {
                    source self
                }
            }
            subnet 10.99.20.0/24 {
                range isolated {
                    start 10.99.20.100
                    stop 10.99.20.110
                }
                lease-time 3600
                dns-source {
                    source self
                }
                static-mapping camera {
                    mac-address 02:00:00:00:00:52
                    ip-address 10.99.20.20
                }
            }
        }
    }
}
EOF_CONF

cmd=foreground:seq=1:exec=le test fixture dhcp/link zedhself 198.18.20.7/24 10.99.20.1/24:exit=0
cmd=background:seq=2:exec=ze -:stdin=ze-bgp
cmd=foreground:seq=3:exec=le test fixture dhcp/probe zedhself x,self-primary,type=discover,mac=02-00-00-00-00-51,expect=offer,yiaddr=198.18.20.100,sid=198.18.20.7,dns=198.18.20.7,dns-count=1 x,self-other,type=discover,mac=02-00-00-00-00-52,expect=offer,yiaddr=10.99.20.20,sid=10.99.20.1,dns=10.99.20.1,dns-count=1:timeout=30s
expect=exit:code=0
expect=stdout:pattern=dhcp self-primary sent=discover reply=offer yiaddr=198.18.20.100 sid=198.18.20.7 .* dns=198.18.20.7 .* dns-count=1
expect=stdout:pattern=dhcp self-other sent=discover reply=offer yiaddr=10.99.20.20 sid=10.99.20.1 .* dns=10.99.20.1 .* dns-count=1
reject=stderr:pattern=panic
