# Test: an SCCRQ carrying Assigned Tunnel ID 0 is answered with StopCCN.
#
# VALIDATES: the daemon answers a protocol error RFC 2661 names, on the SCCRQ
#            half of the exchange, and keeps accepting a well-formed SCCRQ on
#            the same path. Every byte is read off a real UDP datagram by a
#            native Go fixture decoder that shares no code with ze.
# PREVENTS:  the silent drop this test was written for. Until 2026-08-10
#            parseSCCRQ rejected a zero Assigned Tunnel ID and the reactor
#            logged at Debug and returned, so the peer waited for a reply that
#            never came while the published claim said ze sent StopCCN.
#
# Why unit evidence cannot reach this obligation: the unit tests in
# internal/component/l2tp/reactor_sccrq_zero_tid_test.go read the reply with
# ze's own parseStopCCN, so an encoder and a decoder that share a misreading
# agree with each other. Here the Result Code, the Error Code and the message
# type are unpacked with struct.unpack against values written out of the RFC.
#
# Both polarities run against one daemon, so neither can pass because the
# listener was down.
#
# RFC requirement: RFC2661-24.10-1 negative -- an SCCRQ whose Assigned Tunnel ID
# AVP carries 0 is answered with StopCCN, Result Code 2 and Error Code 3, read
# off the wire by a decoder that is not ze.
# RFC requirement: RFC2661-24.10-1 positive -- an SCCRQ carrying a non-zero
# Assigned Tunnel ID gets SCCRP on the same path and the tunnel comes up.


stdin=config:terminator=EOF_CONF
l2tp {
	enabled true
}
environment {
	l2tp {
		server main {
			ip 127.0.0.1
			port $PORT
		}
	}
}
EOF_CONF

option=env:var=ze.log.l2tp:value=debug
option=env:var=ze.l2tp.skip-kernel-probe:value=true

cmd=background:seq=1:exec=ze -:stdin=config
cmd=foreground:seq=2:exec=ze-test fixture l2tp/rfc2661-sccrq-tunnel-id-zero $PORT:timeout=20s
expect=exit:code=0
expect=stdout:contains=OK: all RFC 2661 zero Assigned Tunnel ID checks passed
# The daemon's own record that it chose to answer rather than drop. A positive
# signal, so the reply cannot have come from some other path.
expect=stderr:contains=zero Assigned Tunnel ID SCCRQ answered with StopCCN
# And the positive polarity reached the tunnel machinery rather than stopping
# at the parser.
expect=stderr:contains=new tunnel created from SCCRQ
