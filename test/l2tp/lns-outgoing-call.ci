# Test: operator places an LNS-side outgoing call. The `request l2tp
# outgoing-call remote lns1 called <n>` RPC (issued over the token-auth REST
# API) makes ze dial a fixed-port Python LAC peer, establish the tunnel, and
# send an OCRQ; the peer answers OCRP then OCCN, establishing the call. The
# RPC returns the local/remote session identifiers.
# VALIDATES: AC-4 -- OCRQ sent on an established tunnel (initiating it first),
# OCRP handled (wait-connect), OCCN completes the call, and the RPC returns
# session identifiers. The peer runs unprivileged; kernel/PPP setup is skipped
# (ze.l2tp.skip-kernel-probe) so the control-plane call flow is exercised
# end-to-end over UDP. Data-plane bridging is proven separately (A-4, QEMU).

tmpfs=outgoing-lac-peer.py:mode=755:terminator=EOF_PY
#!/usr/bin/env python3
"""Fixed-port L2TP LAC peer that answers ze's LNS-side outgoing call.

ze is the initiator/LNS: it dials (SCCRQ), establishes the tunnel, then
sends OCRQ. We answer OCRP (assigning our session ID) followed by OCCN,
which establishes the call. The dial is triggered by POSTing `request l2tp
outgoing-call` to ze's REST API from a background thread while the main
thread answers on the wire; the POST blocks until the RPC returns the call
outcome, which we then assert carries the session identifiers.
"""
import hashlib
import json
import socket
import struct
import sys
import threading
import time
import urllib.error
import urllib.request
from ze_api import wait_until

PEER_PORT = int(sys.argv[1])          # $PORT2: our fixed L2TP UDP port
REST_PORT = int(sys.argv[2])          # ze REST API TCP port
SECRET = b"s3cr3t"
TOKEN = "secret"
PEER_TID = 0x0C0C
PEER_SID = 0x0D0D
CALLED = "5551234"
REST = "http://127.0.0.1:%d/api/v1" % REST_PORT

rest_result = {}


def avp(mandatory, atype, value):
    flags = 0x8000 if mandatory else 0
    return struct.pack("!HHH", flags | (6 + len(value)), 0, atype) + value


def parse_avps(body):
    out = {}
    off = 0
    while off + 6 <= len(body):
        word, vendor, atype = struct.unpack("!HHH", body[off:off + 6])
        length = word & 0x03FF
        if length < 6 or off + length > len(body):
            break
        if vendor == 0:
            out[atype] = body[off + 6:off + length]
        off += length
    return out


def ctrl(length, tid, sid, ns, nr):
    return struct.pack("!HHHHHH", 0xC802, length, tid, sid, ns, nr)


def trigger_outgoing_call():
    hdrs = {"Authorization": "Bearer " + TOKEN}
    def _rest_up():
        try:
            urllib.request.urlopen(
                urllib.request.Request(REST + "/commands", headers=hdrs), timeout=2).read()
            return True
        except (urllib.error.URLError, ConnectionRefusedError, OSError):
            return False
    # // hand-rolled REST-readiness deadline loop -> ze_api.wait_until
    # (same 40x0.3s budget, ratchet-exempt internal sleep); paced REST polling, not a race.
    wait_until(_rest_up, attempts=40, delay=0.3)
    payload = json.dumps(
        {"command": "request l2tp outgoing-call remote lns1 called %s" % CALLED}
    ).encode()
    post_hdrs = dict(hdrs)
    post_hdrs["Content-Type"] = "application/json"
    req = urllib.request.Request(REST + "/execute", data=payload, headers=post_hdrs)
    try:
        resp = urllib.request.urlopen(req, timeout=25)
        rest_result["body"] = json.loads(resp.read())
        rest_result["code"] = resp.getcode()
    except urllib.error.HTTPError as err:
        rest_result["error"] = "HTTP %d: %s" % (err.code, err.read().decode("utf-8", "replace"))
    except Exception as err:  # noqa: BLE001
        rest_result["error"] = str(err)


def main():
    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    sock.bind(("127.0.0.1", PEER_PORT))
    sock.settimeout(0.5)

    caller = threading.Thread(target=trigger_outgoing_call, daemon=True)
    caller.start()

    ze_tid = None
    ze_sid = None
    our_ns = 0
    our_nr = 0
    saw_ocrq = False

    deadline = time.time() + 20
    while time.time() < deadline:
        try:
            data, addr = sock.recvfrom(2048)
        except socket.timeout:
            if saw_ocrq:
                break
            continue
        if len(data) < 12:
            continue
        _flags, length, _tid, _sid, ns, _nr = struct.unpack("!HHHHHH", data[:12])
        body = data[12:length]
        avps = parse_avps(body)
        if 0 not in avps:
            continue
        mt = struct.unpack("!H", avps[0])[0]
        new = ns == our_nr
        if new:
            our_nr = (our_nr + 1) & 0xFFFF

        if mt == 1 and new:  # SCCRQ -> answer SCCRP
            ze_tid = struct.unpack("!H", avps[9])[0]
            challenge = avps.get(11)
            resp = b""
            resp += avp(True, 0, struct.pack("!H", 2))
            resp += avp(True, 2, b"\x01\x00")
            resp += avp(True, 3, struct.pack("!I", 0x3))
            resp += avp(True, 7, b"py-lac")
            resp += avp(True, 9, struct.pack("!H", PEER_TID))
            resp += avp(True, 10, struct.pack("!H", 8))
            if challenge is not None:
                resp += avp(True, 13, hashlib.md5(bytes([2]) + SECRET + challenge).digest())
            sock.sendto(ctrl(12 + len(resp), ze_tid, 0, our_ns, our_nr) + resp, addr)
            our_ns += 1
        elif mt == 7 and new:  # OCRQ -> answer OCRP then OCCN
            ze_sid = struct.unpack("!H", avps[14])[0]
            called = avps.get(21, b"").decode("utf-8", "replace")
            saw_ocrq = True
            mandatory_ok = all(a in avps for a in (0, 14, 15, 16, 17, 18, 19, 21))
            print("OK: OCRQ received msgtype=7 called=%r mandatory_ok=%s ze_sid=%d"
                  % (called, mandatory_ok, ze_sid), flush=True)
            ocrp = avp(True, 0, struct.pack("!H", 8)) + avp(True, 14, struct.pack("!H", PEER_SID))
            sock.sendto(ctrl(12 + len(ocrp), ze_tid, ze_sid, our_ns, our_nr) + ocrp, addr)
            our_ns += 1
            occn = (avp(True, 0, struct.pack("!H", 9))
                    + avp(True, 24, struct.pack("!I", 64000))
                    + avp(True, 19, struct.pack("!I", 1)))
            sock.sendto(ctrl(12 + len(occn), ze_tid, ze_sid, our_ns, our_nr) + occn, addr)
            our_ns += 1

    caller.join(timeout=25)
    if rest_result.get("error"):
        print("FAIL: outgoing-call RPC errored: %s" % rest_result["error"], file=sys.stderr)
        return 1
    body = rest_result.get("body")
    if not body or body.get("status") != "done":
        print("FAIL: outgoing-call RPC did not complete: %r" % body, file=sys.stderr)
        return 1
    dump = json.dumps(body)
    print("RPC-BODY: %s" % dump, file=sys.stderr, flush=True)
    if "local-sid" not in dump or "remote-sid" not in dump:
        print("FAIL: RPC result missing session identifiers: %s" % dump, file=sys.stderr)
        return 1
    print("OK: outgoing-call established; RPC returned session identifiers", flush=True)
    return 0


if __name__ == "__main__":
    sys.exit(main())
EOF_PY

stdin=config:terminator=EOF_CONF
l2tp {
	enabled true
	remote lns1 {
		address 127.0.0.1
		port $PORT2
		shared-secret s3cr3t
		outgoing-calls true
	}
}
environment {
	l2tp {
		server main {
			ip 127.0.0.1
			port $PORT
		}
	}
	api-server {
		token "secret";
		rest {
			enabled true;
			server main {
				ip 127.0.0.1;
				port 18093;
			}
		}
	}
}
EOF_CONF

option=env:var=ze.log.l2tp:value=debug
option=env:var=ze.l2tp.skip-kernel-probe:value=true

cmd=background:seq=1:exec=ze -:stdin=config
cmd=foreground:seq=2:exec=python3 outgoing-lac-peer.py $PORT2 18093:timeout=30s
expect=exit:code=0
expect=stdout:contains=OK: OCRQ received msgtype=7 called='5551234'
expect=stdout:contains=OK: outgoing-call established; RPC returned session identifiers
expect=stderr:contains=OCRQ sent; session wait-reply (LNS outgoing)
expect=stderr:contains=OCRP received; session wait-connect (LNS outgoing)
expect=stderr:contains=session established (outgoing)
