# Test: RADIUS rejects credentials; L2TP tunnel still establishes (auth is per-session).
# VALIDATES: spec-l2tp-8b AC-4 -- RADIUS Access-Reject handled correctly.
# The mock RADIUS server returns Access-Reject for all requests.
# The tunnel itself establishes (tunnel auth uses shared secret, not RADIUS).



stdin=config:terminator=EOF_CONF
l2tp {
    enabled true
    shared-secret s3cr3t
    auth {
        radius {
            server radius1 {
                address 127.0.0.1
                port 11813
                shared-key testing123
            }
            timeout 3
            retries 1
        }
    }
}
environment {
    l2tp {
        server main {
            ip 127.0.0.1
            port $PORT
        }
    }
}
EOF_CONF

option=env:var=ze.log.l2tp:value=debug
option=env:var=ze.l2tp.skip-kernel-probe:value=true
option=env:var=TEST_SECRET:value=s3cr3t
option=env:var=RADIUS_PORT:value=11813
option=env:var=RADIUS_KEY:value=testing123

cmd=background:seq=1:exec=ze-test fixture l2tp/auth-radius-reject/radius
cmd=background:seq=2:exec=ze -:stdin=config
cmd=foreground:seq=3:exec=ze-test fixture l2tp/auth-radius-reject $PORT:timeout=10s
expect=exit:code=0
expect=stdout:contains=OK: tunnel established with RADIUS reject config
