# Test: RADIUS Access-Accept with Session-Timeout attribute accepted.
# VALIDATES: spec-bng-1 AC-5, AC-9 -- session timeout wiring, no rejection.
# The mock RADIUS server returns Session-Timeout=60 and Idle-Timeout=120
# in Access-Accept. Ze boots, verifies RADIUS config, and establishes tunnel.
# Timer enforcement is covered by unit tests (PPP requires kernel modules).



stdin=config:terminator=EOF_CONF
l2tp {
    enabled true
    shared-secret s3cr3t
    auth {
        radius {
            server radius1 {
                address 127.0.0.1
                port 11812
                shared-key testing123
            }
            timeout 5
            retries 2
        }
    }
    pool {
        ipv4 {
            gateway 10.255.5.1
            start 10.255.5.10
            end 10.255.5.50
            dns-primary 8.8.8.8
            dns-secondary 8.8.4.4
        }
    }
}
environment {
    l2tp {
        server main {
            ip 127.0.0.1
            port $PORT
        }
    }
}
EOF_CONF

option=env:var=ze.log.l2tp:value=debug
option=env:var=ze.log.l2tp.auth.radius:value=debug
option=env:var=ze.l2tp.skip-kernel-probe:value=true
option=env:var=TEST_SECRET:value=s3cr3t
option=env:var=RADIUS_PORT:value=11812
option=env:var=RADIUS_KEY:value=testing123

cmd=background:seq=1:exec=ze-test fixture l2tp/radius-session-timeout/radius
cmd=background:seq=2:exec=ze -:stdin=config
cmd=foreground:seq=3:exec=ze-test fixture l2tp/radius-session-timeout $PORT:timeout=10s
expect=exit:code=0
expect=stdout:contains=OK: tunnel established with RADIUS session-timeout config
expect=stderr:contains=l2tp-pool: configured
