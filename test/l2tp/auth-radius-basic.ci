# Test: L2TP session with PAP auth via RADIUS (mock server).
# VALIDATES: spec-l2tp-8b AC-1 -- PAP auth with RADIUS Access-Accept.
# The mock RADIUS server accepts all credentials and returns Access-Accept.
# The L2TP peer establishes a tunnel and verifies the auth handler is wired.



stdin=config:terminator=EOF_CONF
l2tp {
    enabled true
    shared-secret s3cr3t
    auth {
        radius {
            server radius1 {
                address 127.0.0.1
                port $PORT2
                shared-key testing123
            }
            timeout 5
            retries 2
        }
    }
}
environment {
    l2tp {
        server main {
            ip 127.0.0.1
            port $PORT
        }
    }
}
EOF_CONF

option=env:var=ze.log.l2tp:value=debug
option=env:var=ze.log.l2tp.auth.radius:value=debug
option=env:var=ze.l2tp.skip-kernel-probe:value=true
option=env:var=TEST_SECRET:value=s3cr3t
option=env:var=RADIUS_PORT:value=$PORT2
option=env:var=RADIUS_KEY:value=testing123

cmd=background:seq=1:exec=ze-test fixture l2tp/auth-radius-basic/radius
cmd=background:seq=2:exec=ze -:stdin=config
cmd=foreground:seq=3:exec=ze-test fixture l2tp/auth-radius-basic $PORT:timeout=10s
expect=exit:code=0
expect=stdout:contains=OK: tunnel established with RADIUS auth config
