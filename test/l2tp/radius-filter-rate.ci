# Test: RADIUS Access-Accept with Filter-Id rate attribute accepted.
# VALIDATES: spec-bng-1 AC-7, AC-8, AC-9 -- initial rate + acct-interim wiring.
# The mock RADIUS server returns Filter-Id="rate:20mbit/5mbit" and
# Acct-Interim-Interval=120 in Access-Accept. Ze boots, verifies RADIUS config,
# and establishes tunnel. Rate application is covered by unit tests
# (PPP requires kernel modules for session-up event).



stdin=config:terminator=EOF_CONF
l2tp {
    enabled true
    shared-secret s3cr3t
    auth {
        radius {
            server radius1 {
                address 127.0.0.1
                port $PORT2
                shared-key testing123
            }
            timeout 5
            retries 2
        }
    }
    pool {
        ipv4 {
            gateway 10.255.6.1
            start 10.255.6.10
            end 10.255.6.50
            dns-primary 8.8.8.8
            dns-secondary 8.8.4.4
        }
    }
}
environment {
    l2tp {
        server main {
            ip 127.0.0.1
            port $PORT
        }
    }
}
EOF_CONF

option=env:var=ze.log.l2tp:value=debug
option=env:var=ze.log.l2tp.auth.radius:value=debug
option=env:var=ze.l2tp.skip-kernel-probe:value=true
option=env:var=TEST_SECRET:value=s3cr3t
option=env:var=RADIUS_PORT:value=$PORT2
option=env:var=RADIUS_KEY:value=testing123

cmd=background:seq=1:exec=ze-test fixture l2tp/radius-filter-rate/radius
cmd=background:seq=2:exec=ze -:stdin=config
cmd=foreground:seq=3:exec=ze-test fixture l2tp/radius-filter-rate $PORT:timeout=10s
expect=exit:code=0
expect=stdout:contains=OK: tunnel established with RADIUS filter-rate config
expect=stderr:contains=l2tp-pool: configured
