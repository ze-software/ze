# Test: RADIUS Access-Accept with Framed-IP-Address bypasses pool allocation.
# VALIDATES: spec-bng-1 AC-1, AC-3, AC-9 -- RADIUS-assigned IP, named pool config.
# The mock RADIUS server returns Framed-IP-Address and Framed-Pool in Access-Accept.
# Ze boots with named pool "gold" configured; verify config parsing + tunnel establishment.
# Actual IP assignment is covered by unit tests (PPP requires kernel modules).



stdin=config:terminator=EOF_CONF
l2tp {
    enabled true
    shared-secret s3cr3t
    auth {
        radius {
            server radius1 {
                address 127.0.0.1
                port $PORT2
                shared-key testing123
            }
            timeout 5
            retries 2
        }
    }
    pool {
        ipv4 {
            gateway 10.255.3.1
            start 10.255.3.10
            end 10.255.3.50
            dns-primary 8.8.8.8
            dns-secondary 8.8.4.4
        }
        named-pool gold {
            gateway 10.255.4.1
            start 10.255.4.10
            end 10.255.4.50
            dns-primary 1.1.1.1
            dns-secondary 1.0.0.1
        }
    }
}
environment {
    l2tp {
        server main {
            ip 127.0.0.1
            port $PORT
        }
    }
}
EOF_CONF

option=env:var=ze.log.l2tp:value=debug
option=env:var=ze.log.l2tp.auth.radius:value=debug
option=env:var=ze.l2tp.skip-kernel-probe:value=true
option=env:var=TEST_SECRET:value=s3cr3t
option=env:var=RADIUS_PORT:value=$PORT2
option=env:var=RADIUS_KEY:value=testing123

cmd=background:seq=1:exec=ze-test fixture l2tp/radius-framed-ip/radius
cmd=background:seq=2:exec=ze -:stdin=config
cmd=foreground:seq=3:exec=ze-test fixture l2tp/radius-framed-ip $PORT:timeout=10s
expect=exit:code=0
expect=stdout:contains=OK: tunnel established with RADIUS framed-ip + named pool config
expect=stderr:contains=l2tp-pool: configured
# The count, not just the line. `named-pool gold` above is a YANG list, which
# Tree.ToMap renders as a map of pool name to entry, so a parser that asserted
# []any on it built an EMPTY named table while still logging "configured". This
# assertion is what tells the two apart.
expect=stderr:contains=named-pools=1
