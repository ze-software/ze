# Test: l2tp-pool plugin loads and registers handler; control plane works.
# VALIDATES: spec-l2tp-8a AC-10 -- pool config accepted; plugin registers.
# Note: actual IP allocation is unit-tested (TestPoolAllocateIPv4).
# Config apply requires full engine lifecycle (BGP peer); plugin startup
# proves YANG schema valid, handler registered, L2TP control plane unaffected.


stdin=config:terminator=EOF_CONF
l2tp {
    enabled true
    shared-secret s3cr3t
    pool {
        ipv4 {
            gateway 10.255.0.1
            start 10.255.0.10
            end 10.255.0.100
            dns-primary 8.8.8.8
            dns-secondary 8.8.4.4
        }
    }
}
environment {
    l2tp {
        server main {
            ip 127.0.0.1
            port $PORT
        }
    }
}
EOF_CONF

option=env:var=ze.log.l2tp:value=debug
option=env:var=ze.l2tp.skip-kernel-probe:value=true
option=env:var=TEST_SECRET:value=s3cr3t

cmd=background:seq=1:exec=ze -:stdin=config
cmd=foreground:seq=2:exec=ze-test fixture l2tp/pool-basic $PORT:timeout=10s
expect=exit:code=0
expect=stdout:contains=OK: tunnel established with pool config
expect=stderr:contains=tunnel now established
