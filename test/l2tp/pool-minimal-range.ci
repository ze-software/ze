# Test: l2tp-pool plugin accepts a minimal single-address pool range.
# VALIDATES: spec-l2tp-8a AC-12 (smoke) -- pool configured with total=1.
# Note: actual pool exhaustion (allocate then reject) is unit-tested
# (TestPoolExhausted) because it requires PPP sessions to drive allocation.
# This functional test verifies the boundary case of a single-address range.


stdin=config:terminator=EOF_CONF
l2tp {
    enabled true
    shared-secret s3cr3t
    pool {
        ipv4 {
            gateway 10.255.1.1
            start 10.255.1.2
            end 10.255.1.2
            dns-primary 8.8.8.8
        }
    }
}
environment {
    l2tp {
        server main {
            ip 127.0.0.1
            port $PORT
        }
    }
}
EOF_CONF

option=env:var=ze.log.l2tp:value=debug
option=env:var=ze.l2tp.skip-kernel-probe:value=true
option=env:var=TEST_SECRET:value=s3cr3t

cmd=background:seq=1:exec=ze -:stdin=config
cmd=foreground:seq=2:exec=ze-test fixture l2tp/pool-minimal-range $PORT:timeout=10s
expect=exit:code=0
expect=stdout:contains=OK: tunnel established with single-address pool
expect=stderr:contains=tunnel now established
