# Test: NAS-Port-Id and Framed-IP-Address on the RADIUS wire, for a real PPP session.
# VALIDATES: spec-radius-subscriber-attributes AC-1, AC-2, AC-5 -- ze puts the
#            operator's nas-port-id-format text in the Access-Request and in the
#            Accounting-Request, the same text in both (RFC 2869 Section 5.17), and
#            the IPCP-negotiated subscriber address in the Accounting-Request with
#            Acct-Status-Type=Start (RFC 2865 Section 5.8, RFC 2866 Section 4.1).
# PREVENTS:  either attribute regressing with only unit tests and the Docker interop
#            lab to catch it. test/l2tp/radius-nas-port-id.ci owns the config surface
#            and never reaches the wire; this test owns the wire, in the gated .ci path.
#
# A session that reaches an assigned IPv4 needs kernel PPPoL2TP, which needs
# CAP_NET_ADMIN, so this test is needs-linux and runs in QEMU as root
# (the needs-linux functional gate). It SKIPS on an unprivileged dev host.
#
# ze.l2tp.skip-kernel-probe is DELIBERATELY NOT SET here, unlike every other
# test/l2tp test. That knob bypasses the modprobe at Start, and its producer
# scopes it to tests that only exercise the CLI surface
# (internal/component/l2tp/config.go:41-51). This test needs the real data plane:
# the probe loads l2tp_ppp, the genl family resolve autoloads l2tp_netlink, and
# without both there is no kernel session, no PPP, no assigned address, and no
# accounting record to assert on. internal/le/qemu/guestlabs.go refuses
# to run with the knob set for the same reason.
#
# RFC requirement: RFC2866-4.1-1 positive -- the Accounting-Start reaching the RADIUS
# server reports the address IPCP actually negotiated for the subscriber, cross-checked
# by the peer against the address it settled on, for a real kernel PPP session.
#
# The proof is what the RADIUS server DECODED, never what ze logged: the mock
# writes one decoded line per received packet to radius-rx.log and the LAC peer
# reads those lines back, comparing the reported Framed-IP-Address against the
# address it itself negotiated over IPCP.
#
# The session authenticates with CHAP-MD5, and the `auth-method` leaf below is
# NOT what selects it. The peer sends the RFC 2661 Section 4.4.5 proxy LCP AVPs,
# so ze takes the proxy short-circuit and EvaluateProxyLCP
# (internal/component/l2tp/ppp/proxy.go) reads the method from the LCP
# Authentication-Protocol option in the LAC's Last-Sent CONFREQ, which the peer
# fixture writes. The leaf drives the path that negotiates LCP directly, which
# this test never takes. The exchange must reach a credential: RFC 2865
# Section 4.1 says "An Access-Request MUST contain either a User-Password or a
# CHAP-Password or a State", so a session that authenticated with nothing sends
# no Access-Request at all and this test has no attributes to read.



stdin=config:terminator=EOF_CONF
l2tp {
    enabled true
    shared-secret s3cr3t
    auth-method chap-md5
    auth {
        radius {
            nas-identifier lns1
            nas-port-id-format "{nas-id}:{tunnel-id}.{session-id}"
            timeout 5
            retries 2
            server mock {
                address 127.0.0.1
                port $PORT2
                shared-key testing123
            }
        }
    }
    pool {
        ipv4 {
            gateway 10.99.7.1
            start 10.99.7.10
            end 10.99.7.10
        }
    }
}
environment {
    l2tp {
        server main {
            ip 127.0.0.1
            port $PORT
        }
    }
}
EOF_CONF

option=needs-linux:caps=net-admin
option=env:var=ze.log.l2tp:value=debug
option=env:var=ze.log.l2tp.auth.radius:value=debug
option=env:var=TEST_SECRET:value=s3cr3t
option=env:var=TEST_NAS_ID:value=lns1

cmd=background:seq=1:exec=ze-test fixture l2tp/radius-acct-wire/radius $PORT2 testing123
cmd=background:seq=2:exec=ze -:stdin=config
# 90s, well past the peer's own 30s deadlines: a stall must end with the peer's
# diagnostic (which state it reached), never with an opaque runner timeout. The
# happy path takes about 5s.
cmd=foreground:seq=3:exec=ze-test fixture l2tp/radius-acct-wire $PORT:timeout=90s:exit=0
expect=exit:code=0
expect=stdout:pattern=OK: CHAP Response sent for challenge identifier [0-9]+ as subscriber@ze
expect=stdout:contains=OK: CHAP Success received
expect=stdout:contains=OK: IPCP opened, ze assigned 10.99.7.10
expect=stdout:contains=OK: Access-Request NAS-Port-Id resolved from the template as
expect=stdout:pattern=NAS-Port-Id resolved from the template as lns1:[0-9]+\.[0-9]+
expect=stdout:contains=OK: Accounting-Start Framed-IP-Address matches the IPCP-negotiated address 10.99.7.10
