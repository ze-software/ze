# Test: NAS-Port-Id and Framed-IP-Address on the RADIUS wire, for a real PPP session.
# VALIDATES: spec-radius-subscriber-attributes AC-1, AC-2, AC-5 -- ze puts the
#            operator's nas-port-id-format text in the Access-Request and in the
#            Accounting-Request, the same text in both (RFC 2869 Section 5.17), and
#            the IPCP-negotiated subscriber address in the Accounting-Request with
#            Acct-Status-Type=Start (RFC 2865 Section 5.8, RFC 2866 Section 4.1).
# PREVENTS:  either attribute regressing with only unit tests and the Docker interop
#            lab to catch it. test/l2tp/radius-nas-port-id.ci owns the config surface
#            and never reaches the wire; this test owns the wire, in the gated .ci path.
#
# A session that reaches an assigned IPv4 needs kernel PPPoL2TP, which needs
# CAP_NET_ADMIN, so this test is needs-linux and runs in QEMU as root
# (make ze-qemu-needs-linux-test). It SKIPS on an unprivileged dev host.
#
# ze.l2tp.skip-kernel-probe is DELIBERATELY NOT SET here, unlike every other
# test/l2tp test. That knob bypasses the modprobe at Start, and its producer
# scopes it to tests that only exercise the CLI surface
# (internal/component/l2tp/config.go:41-51). This test needs the real data plane:
# the probe loads l2tp_ppp, the genl family resolve autoloads l2tp_netlink, and
# without both there is no kernel session, no PPP, no assigned address, and no
# accounting record to assert on. scripts/evidence/effective-l2tp-ppp.py refuses
# to run with the knob set for the same reason.
#
# RFC requirement: RFC2866-4.1-1 positive -- the Accounting-Start reaching the RADIUS
# server reports the address IPCP actually negotiated for the subscriber, cross-checked
# by the peer against the address it settled on, for a real kernel PPP session.
#
# The proof is what the RADIUS server DECODED, never what ze logged: the mock
# writes one decoded line per received packet to radius-rx.log and the LAC peer
# reads those lines back, comparing the reported Framed-IP-Address against the
# address it itself negotiated over IPCP.

tmpfs=radius-mock.py:mode=755:terminator=EOF_RADIUS
#!/usr/bin/env python3
"""Mock RADIUS server: Access-Accept and Accounting-Response, decoding attributes.

Shape copied from test/interop-l2tp/scenarios/04-radius-acct-attrs/radius-mock.py.
No attributes are returned in the Access-Accept: the address the accounting record
must report comes from ze's own pool, so a Framed-IP-Address in the reply would let
the test pass on a value the server handed over rather than on the negotiated one.
"""

import hashlib
import socket
import struct
import sys

CODE_ACCESS_REQUEST = 1
CODE_ACCESS_ACCEPT = 2
CODE_ACCOUNTING_REQUEST = 4
CODE_ACCOUNTING_RESPONSE = 5

ATTR_USER_NAME = 1
ATTR_NAS_IP_ADDRESS = 4
ATTR_FRAMED_IP_ADDRESS = 8
ATTR_ACCT_STATUS_TYPE = 40
ATTR_ACCT_SESSION_ID = 44
ATTR_NAS_PORT_ID = 87

ACCT_STATUS = {1: "Start", 2: "Stop", 3: "Interim-Update"}

LOG_PATH = "radius-rx.log"


def parse_attrs(data):
    """RFC 2865 Section 5: Type(1) Length(1) Value(Length-2), repeated."""
    attrs = []
    i = 0
    while i + 2 <= len(data):
        atype = data[i]
        alen = data[i + 1]
        if alen < 2 or i + alen > len(data):
            break
        attrs.append((atype, data[i + 2 : i + alen]))
        i += alen
    return attrs


def response_auth(code, ident, length, req_auth, attrs, secret):
    h = hashlib.md5()
    h.update(bytes([code, ident]))
    h.update(struct.pack("!H", length))
    h.update(req_auth)
    h.update(attrs)
    h.update(secret)
    return h.digest()


def describe(code, attrs):
    """One line per packet, in the shape the LAC peer greps."""
    fields = []
    for atype, value in attrs:
        if atype == ATTR_NAS_PORT_ID:
            fields.append("NAS-Port-Id=%s" % value.decode("utf-8", "replace"))
        elif atype == ATTR_FRAMED_IP_ADDRESS and len(value) == 4:
            fields.append("Framed-IP-Address=%s" % socket.inet_ntoa(value))
        elif atype == ATTR_NAS_IP_ADDRESS and len(value) == 4:
            fields.append("NAS-IP-Address=%s" % socket.inet_ntoa(value))
        elif atype == ATTR_ACCT_STATUS_TYPE and len(value) == 4:
            n = struct.unpack("!I", value)[0]
            fields.append("Acct-Status-Type=%s" % ACCT_STATUS.get(n, str(n)))
        elif atype == ATTR_ACCT_SESSION_ID:
            fields.append("Acct-Session-Id=%s" % value.decode("utf-8", "replace"))
        elif atype == ATTR_USER_NAME:
            fields.append("User-Name=%s" % value.decode("utf-8", "replace"))
    name = {
        CODE_ACCESS_REQUEST: "Access-Request",
        CODE_ACCOUNTING_REQUEST: "Accounting-Request",
    }.get(code, "code-%d" % code)
    return "RADIUS-RX %s %s" % (name, " ".join(fields))


def main():
    if len(sys.argv) < 2:
        print("usage: radius-mock.py <port> [secret]", file=sys.stderr)
        return 2
    port = int(sys.argv[1])
    secret = (sys.argv[2] if len(sys.argv) > 2 else "testing123").encode()

    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    sock.bind(("127.0.0.1", port))
    sock.settimeout(120.0)
    print("radius-mock listening on 127.0.0.1:%d" % port, flush=True)

    while True:
        try:
            data, addr = sock.recvfrom(4096)
        except socket.timeout:
            return 0
        if len(data) < 20:
            continue
        code = data[0]
        ident = data[1]
        req_auth = data[4:20]
        attrs = parse_attrs(data[20:])

        line = describe(code, attrs)
        print(line, flush=True)
        # The LAC peer asserts on this file: it is the only record of what ze
        # actually put on the RADIUS wire.
        with open(LOG_PATH, "a", encoding="utf-8") as fh:
            fh.write(line + "\n")
            fh.flush()

        if code == CODE_ACCESS_REQUEST:
            reply_code = CODE_ACCESS_ACCEPT
        elif code == CODE_ACCOUNTING_REQUEST:
            reply_code = CODE_ACCOUNTING_RESPONSE
        else:
            continue

        resp = bytearray(20)
        resp[0] = reply_code
        resp[1] = ident
        struct.pack_into("!H", resp, 2, 20)
        resp[4:20] = response_auth(reply_code, ident, 20, req_auth, b"", secret)
        sock.sendto(bytes(resp), addr)


if __name__ == "__main__":
    sys.exit(main())
EOF_RADIUS

tmpfs=l2tp-lac.py:mode=755:terminator=EOF_PEER
#!/usr/bin/env python3
"""L2TP LAC peer that drives ze to a real PPP session with an assigned IPv4.

Tunnel: SCCRQ -> SCCRP -> SCCCN (RFC 2661 Section 5.1).
Session: ICRQ -> ICRP -> ICCN (RFC 2661 Section 10.2), the ICCN carrying the
three proxy LCP AVPs (26/27/28, RFC 2661 Section 4.4.5) so ze takes the
short-circuit in internal/component/l2tp/ppp/session_run.go and never runs LCP.
The AVP value is a bare LCP option list, which is what EvaluateProxyLCP parses
(internal/component/l2tp/ppp/proxy.go).

Then IPCP (PPP 0x8021) over the L2TP data channel: ze's kernel pppol2tp session
demuxes those packets, so they carry the plain L2TPv2 data header for the ids ze
assigned. ze sends its own CONFREQ first (it is the LNS and assigns addresses),
and Naks ours until we ask for the pool address it picked.

Finally, the RADIUS packets ze sent are read back out of radius-rx.log and
checked against the address negotiated above.
"""

import hashlib
import os
import re
import socket
import struct
import sys
import time

if len(sys.argv) < 2:
    print("usage: l2tp-lac.py <l2tp-port>", file=sys.stderr)
    sys.exit(2)

TARGET = ("127.0.0.1", int(sys.argv[1]))
SECRET = os.environ.get("TEST_SECRET", "s3cr3t").encode("utf-8")
NAS_ID = os.environ.get("TEST_NAS_ID", "lns1")
RADIUS_LOG = "radius-rx.log"

PEER_TID = 0x0321
PEER_SID = 700
PEER_CHALLENGE = bytes.fromhex("0f1e2d3c4b5a69788796a5b4c3d2e1f0")

# L2TP header flag bits (RFC 2661 Section 3.1).
FLAG_TYPE = 0x8000
FLAG_LENGTH = 0x4000
FLAG_SEQUENCE = 0x0800
FLAG_OFFSET = 0x0200

# PPP protocol numbers (RFC 1661 Section 2, RFC 1332 Section 2).
PROTO_LCP = 0xC021
PROTO_IPCP = 0x8021

# PPP control codes (RFC 1661 Section 5).
CONF_REQ = 1
CONF_ACK = 2
CONF_NAK = 3
CONF_REJ = 4
TERM_REQ = 5
TERM_ACK = 6
ECHO_REQ = 9
ECHO_REP = 10

IPCP_OPT_IP_ADDRESS = 3

DEADLINE_SECONDS = 30.0


def fail(message):
    print("ERROR: %s" % message, file=sys.stderr)
    sys.exit(1)


def avp(mandatory, attr_type, value, vendor=0):
    flags = 0x8000 if mandatory else 0
    return struct.pack("!HHH", flags | (6 + len(value)), vendor, attr_type) + value


def lcp_option(opt_type, value):
    return struct.pack("!BB", opt_type, 2 + len(value)) + value


def ctrl(dest_tid, dest_sid, ns, nr, body):
    total = 12 + len(body)
    return struct.pack("!HHHHHH", 0xC802, total, dest_tid, dest_sid, ns, nr) + body


def data_packet(dest_tid, dest_sid, proto, payload):
    """L2TPv2 data header (T=0, L=0, S=0, version 2) then the PPP frame.

    No 0xff03 address/control pair: the kernel's pppol2tp receive path strips one
    when present and needs none when absent, so leaving it off cannot depend on
    that behaviour.
    """
    return struct.pack("!HHH", 0x0002, dest_tid, dest_sid) + struct.pack("!H", proto) + payload


def ppp_control(code, ident, data):
    return struct.pack("!BBH", code, ident, 4 + len(data)) + data


def parse_avps(body):
    out = {}
    off = 0
    while off + 6 <= len(body):
        word, vendor, atype = struct.unpack("!HHH", body[off : off + 6])
        length = word & 0x03FF
        if length < 6 or off + length > len(body):
            break
        if vendor == 0:
            out[atype] = body[off + 6 : off + length]
        off += length
    return out


def parse_ipcp_options(data):
    """Return {option-type: value}; stops at the first malformed option."""
    out = {}
    off = 0
    while off + 2 <= len(data):
        otype = data[off]
        olen = data[off + 1]
        if olen < 2 or off + olen > len(data):
            break
        out[otype] = data[off + 2 : off + olen]
        off += olen
    return out


class Peer:
    def __init__(self, sock):
        self.sock = sock
        self.local_tid = 0
        self.ze_sid = 0
        self.ns = 0
        self.nr = 0
        # IPCP state.
        self.ze_confreq_acked = False
        self.our_ipcp_id = 0
        self.our_request_addr = "0.0.0.0"
        self.our_ipcp_acked = False
        self.negotiated_addr = None

    def send_ctrl(self, body, dest_sid=0):
        """Send one control message. A session-scoped message (ICCN) MUST carry
        ze's session id in the header, or ze drops it as "unknown SID"."""
        self.sock.sendto(ctrl(self.local_tid, dest_sid, self.ns, self.nr, body), TARGET)
        self.ns += 1

    def send_zlb(self):
        self.sock.sendto(ctrl(self.local_tid, 0, self.ns, self.nr, b""), TARGET)

    def send_ppp(self, proto, payload):
        self.sock.sendto(data_packet(self.local_tid, self.ze_sid, proto, payload), TARGET)

    # --- tunnel and session establishment -------------------------------

    def handshake(self):
        body = b""
        body += avp(True, 0, struct.pack("!H", 1))  # Message Type = SCCRQ
        body += avp(True, 2, b"\x01\x00")  # Protocol Version 1.0
        body += avp(True, 3, struct.pack("!I", 0x3))  # Framing Capabilities
        body += avp(True, 4, struct.pack("!I", 0x0))  # Bearer Capabilities
        body += avp(True, 7, b"py-lac")  # Host Name
        body += avp(True, 9, struct.pack("!H", PEER_TID))  # Assigned Tunnel ID
        body += avp(True, 10, struct.pack("!H", 8))  # Receive Window Size
        body += avp(True, 11, PEER_CHALLENGE)  # Challenge
        sccrq = ctrl(0, 0, 0, 0, body)

        self.sock.settimeout(0.25)
        sccrp = None
        for _ in range(40):
            try:
                self.sock.sendto(sccrq, TARGET)
                packet, _ = self.sock.recvfrom(2048)
            except (socket.timeout, ConnectionRefusedError, OSError):
                continue
            avps = self.control_avps(packet)
            if avps and 0 in avps and struct.unpack("!H", avps[0])[0] == 2:
                sccrp = avps
                break
        if sccrp is None:
            fail("no SCCRP received")
        if 9 not in sccrp or 11 not in sccrp:
            fail("SCCRP missing Assigned Tunnel ID or Challenge")
        self.local_tid = struct.unpack("!H", sccrp[9])[0]
        self.ns = 1
        self.nr = 1

        digest = hashlib.md5(bytes([3]) + SECRET + sccrp[11]).digest()
        scccn = avp(True, 0, struct.pack("!H", 3)) + avp(True, 13, digest)
        self.sock.settimeout(1.0)
        self.send_ctrl(scccn)

        icrq = b""
        icrq += avp(True, 0, struct.pack("!H", 10))  # Message Type = ICRQ
        icrq += avp(True, 14, struct.pack("!H", PEER_SID))  # Assigned Session ID
        icrq += avp(True, 15, struct.pack("!I", 42))  # Call Serial Number
        self.send_ctrl(icrq)

        deadline = time.time() + 10.0
        while time.time() < deadline and self.ze_sid == 0:
            try:
                packet, _ = self.sock.recvfrom(2048)
            except (socket.timeout, OSError):
                continue
            avps = self.control_avps(packet)
            if not avps or 0 not in avps:
                continue
            if struct.unpack("!H", avps[0])[0] != 11:  # ICRP
                continue
            if 14 not in avps:
                fail("ICRP missing Assigned Session ID")
            self.ze_sid = struct.unpack("!H", avps[14])[0]
        if self.ze_sid == 0:
            fail("no ICRP received")
        print("OK: ICRP received, ze session id %d on tunnel %d" % (self.ze_sid, self.local_tid))

        # RFC 2661 Section 4.4.5: the three proxy LCP AVPs let the LNS skip LCP.
        # M bit clear, as the RFC specifies for these AVPs. Each value is the
        # option list of the CONFREQ it reports. No Authentication-Protocol
        # option in Last-Sent, so ze negotiates no PPP authentication and the
        # session is admitted by RADIUS policy alone (allow-no-auth).
        peer_options = lcp_option(1, struct.pack("!H", 1500)) + lcp_option(
            5, struct.pack("!I", 0x11223344)
        )
        lac_options = lcp_option(1, struct.pack("!H", 1500)) + lcp_option(
            5, struct.pack("!I", 0x55667788)
        )
        iccn = b""
        iccn += avp(True, 0, struct.pack("!H", 12))  # Message Type = ICCN
        iccn += avp(True, 24, struct.pack("!I", 10000000))  # Tx Connect Speed
        iccn += avp(True, 19, struct.pack("!I", 2))  # Framing Type = sync
        iccn += avp(False, 26, peer_options)  # Initial Received LCP CONFREQ
        iccn += avp(False, 27, lac_options)  # Last Sent LCP CONFREQ
        iccn += avp(False, 28, peer_options)  # Last Received LCP CONFREQ
        self.send_ctrl(iccn, dest_sid=self.ze_sid)
        print("OK: ICCN sent with proxy LCP AVPs 26, 27 and 28")

    # --- receive path ---------------------------------------------------

    def control_avps(self, packet):
        """Parse one control message, ACK it, and return its AVPs (None if not one)."""
        if len(packet) < 12:
            return None
        flags = struct.unpack("!H", packet[:2])[0]
        if not flags & FLAG_TYPE:
            return None
        length, _, _, ns, _ = struct.unpack("!HHHHH", packet[2:12])
        if length <= 12 or length > len(packet):
            return None  # ZLB acknowledgement, nothing to answer
        if ns == self.nr:
            self.nr = ns + 1
        return parse_avps(packet[12:length])

    def pump(self):
        """Read one packet and dispatch it. Returns False on socket timeout."""
        try:
            packet, _ = self.sock.recvfrom(2048)
        except (socket.timeout, OSError):
            return False
        if len(packet) < 6:
            return True
        flags = struct.unpack("!H", packet[:2])[0]
        if flags & FLAG_TYPE:
            avps = self.control_avps(packet)
            if avps is not None:
                self.handle_control(avps)
            return True
        self.handle_data(packet, flags)
        return True

    def handle_control(self, avps):
        if 0 not in avps:
            return
        msg_type = struct.unpack("!H", avps[0])[0]
        if msg_type == 6:  # HELLO: acknowledge so the tunnel stays up
            self.send_zlb()
        elif msg_type == 14:  # CDN
            fail("ze disconnected the call (CDN)")
        elif msg_type == 4:  # StopCCN
            fail("ze tore the tunnel down (StopCCN)")
        else:
            self.send_zlb()

    def handle_data(self, packet, flags):
        off = 2
        if flags & FLAG_LENGTH:
            off += 2
        off += 4  # tunnel id, session id
        if flags & FLAG_SEQUENCE:
            off += 4
        if flags & FLAG_OFFSET:
            if len(packet) < off + 2:
                return
            off += 2 + struct.unpack("!H", packet[off : off + 2])[0]
        payload = packet[off:]
        if payload[:2] == b"\xff\x03":
            payload = payload[2:]
        if len(payload) < 6:
            return
        proto = struct.unpack("!H", payload[:2])[0]
        code, ident, plen = struct.unpack("!BBH", payload[2:6])
        if plen < 4 or plen > len(payload) - 2:
            return
        body = payload[6 : 2 + plen]
        if proto == PROTO_LCP:
            self.handle_lcp(code, ident, body)
        elif proto == PROTO_IPCP:
            self.handle_ipcp(code, ident, body)

    def handle_lcp(self, code, ident, body):
        if code == ECHO_REQ:
            # RFC 1661 Section 5.8: reply with our own Magic-Number so ze's
            # echo failure counter never reaches its limit mid-test.
            self.send_ppp(PROTO_LCP, ppp_control(ECHO_REP, ident, struct.pack("!I", 0x11223344)))
        elif code == TERM_REQ:
            self.send_ppp(PROTO_LCP, ppp_control(TERM_ACK, ident, b""))
            fail("ze terminated LCP")

    def handle_ipcp(self, code, ident, body):
        if code == CONF_REQ:
            # ze asks for its own address (the pool gateway). Accept it verbatim.
            self.send_ppp(PROTO_IPCP, ppp_control(CONF_ACK, ident, body))
            if not self.ze_confreq_acked:
                self.ze_confreq_acked = True
                self.send_our_confreq()
        elif code == CONF_NAK:
            opts = parse_ipcp_options(body)
            value = opts.get(IPCP_OPT_IP_ADDRESS)
            if value is None or len(value) != 4:
                fail("IPCP Configure-Nak without an IP-Address option")
            suggested = socket.inet_ntoa(value)
            if suggested == self.our_request_addr:
                fail("ze re-Naked the address it suggested: %s" % suggested)
            self.our_request_addr = suggested
            self.send_our_confreq()
        elif code == CONF_ACK:
            if ident == self.our_ipcp_id and not self.our_ipcp_acked:
                self.our_ipcp_acked = True
                self.negotiated_addr = self.our_request_addr
        elif code == CONF_REJ:
            fail("ze rejected the IPCP IP-Address option")

    def send_our_confreq(self):
        self.our_ipcp_id += 1
        opts = struct.pack("!BB", IPCP_OPT_IP_ADDRESS, 6) + socket.inet_aton(
            self.our_request_addr
        )
        self.send_ppp(PROTO_IPCP, ppp_control(CONF_REQ, self.our_ipcp_id, opts))

    def negotiate_ipcp(self):
        deadline = time.time() + DEADLINE_SECONDS
        while time.time() < deadline:
            if self.our_ipcp_acked and self.ze_confreq_acked:
                print("OK: IPCP opened, ze assigned %s" % self.negotiated_addr)
                return
            self.pump()
        fail(
            "IPCP did not open within %.0fs (ze CONFREQ acked: %s, ours acked: %s)"
            % (DEADLINE_SECONDS, self.ze_confreq_acked, self.our_ipcp_acked)
        )

    # --- RADIUS readback ------------------------------------------------

    def radius_lines(self):
        try:
            with open(RADIUS_LOG, "r", encoding="utf-8") as fh:
                return [line for line in fh.read().splitlines() if line.startswith("RADIUS-RX ")]
        except FileNotFoundError:
            return []

    def wait_radius(self, predicate, what):
        """Poll the decoded-packet log while still serving the L2TP socket.

        pump() blocks on the socket timeout, which paces this loop: no sleep.
        """
        deadline = time.time() + DEADLINE_SECONDS
        while time.time() < deadline:
            for line in self.radius_lines():
                if predicate(line):
                    return line
            self.pump()
        fail("no %s reached the RADIUS server; received: %s" % (what, self.radius_lines()))
        return ""

    def check_radius(self):
        access = self.wait_radius(
            lambda line: line.startswith("RADIUS-RX Access-Request "), "Access-Request"
        )
        match = re.search(r"NAS-Port-Id=(\S+)", access)
        if not match:
            fail("Access-Request carried no NAS-Port-Id: %s" % access)
        auth_port_id = match.group(1)
        # RFC 2869 Section 5.17, resolved from "{nas-id}:{tunnel-id}.{session-id}".
        if not re.fullmatch(r"%s:\d+\.\d+" % re.escape(NAS_ID), auth_port_id):
            fail("Access-Request NAS-Port-Id %r does not match the template" % auth_port_id)
        print("OK: Access-Request NAS-Port-Id resolved from the template as %s" % auth_port_id)

        acct = self.wait_radius(
            lambda line: line.startswith("RADIUS-RX Accounting-Request ")
            and "Acct-Status-Type=Start" in line,
            "Accounting-Request with Acct-Status-Type=Start",
        )
        # RFC 2866 Section 4.1: the Framed-IP-Address MUST be the address the
        # subscriber actually negotiated, which is the one IPCP settled above.
        match = re.search(r"Framed-IP-Address=(\S+)", acct)
        if not match:
            fail("Accounting-Start carried no Framed-IP-Address: %s" % acct)
        reported = match.group(1)
        if reported != self.negotiated_addr:
            fail(
                "Accounting-Start reports %s, IPCP negotiated %s"
                % (reported, self.negotiated_addr)
            )
        print(
            "OK: Accounting-Start Framed-IP-Address matches the IPCP-negotiated address %s"
            % reported
        )

        acct_port_id_match = re.search(r"NAS-Port-Id=(\S+)", acct)
        if not acct_port_id_match or acct_port_id_match.group(1) != auth_port_id:
            fail("NAS-Port-Id is not stable across auth and accounting: %s" % acct)
        print("OK: Accounting-Start carries the same NAS-Port-Id %s" % auth_port_id)


def main():
    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    sock.bind(("127.0.0.1", 0))
    peer = Peer(sock)
    peer.handshake()
    sock.settimeout(0.25)
    peer.negotiate_ipcp()
    peer.check_radius()
    return 0


if __name__ == "__main__":
    sys.exit(main())
EOF_PEER

stdin=config:terminator=EOF_CONF
l2tp {
    enabled true
    shared-secret s3cr3t
    auth-method none
    allow-no-auth true
    auth {
        radius {
            nas-identifier lns1
            nas-port-id-format "{nas-id}:{tunnel-id}.{session-id}"
            timeout 5
            retries 2
            server mock {
                address 127.0.0.1
                port $PORT2
                shared-key testing123
            }
        }
    }
    pool {
        ipv4 {
            gateway 10.99.7.1
            start 10.99.7.10
            end 10.99.7.10
        }
    }
}
environment {
    l2tp {
        server main {
            ip 127.0.0.1
            port $PORT
        }
    }
}
EOF_CONF

option=needs-linux:caps=net-admin
option=env:var=ze.log.l2tp:value=debug
option=env:var=ze.log.l2tp.auth.radius:value=debug
option=env:var=TEST_SECRET:value=s3cr3t
option=env:var=TEST_NAS_ID:value=lns1

cmd=background:seq=1:exec=python3 radius-mock.py $PORT2 testing123
cmd=background:seq=2:exec=ze -:stdin=config
# 90s, well past the peer's own 30s deadlines: a stall must end with the peer's
# diagnostic (which state it reached), never with an opaque runner timeout. The
# happy path takes about 5s.
cmd=foreground:seq=3:exec=python3 l2tp-lac.py $PORT:timeout=90s:exit=0
expect=exit:code=0
expect=stdout:contains=OK: IPCP opened, ze assigned 10.99.7.10
expect=stdout:contains=OK: Access-Request NAS-Port-Id resolved from the template as
expect=stdout:pattern=NAS-Port-Id resolved from the template as lns1:[0-9]+\.[0-9]+
expect=stdout:contains=OK: Accounting-Start Framed-IP-Address matches the IPCP-negotiated address 10.99.7.10
