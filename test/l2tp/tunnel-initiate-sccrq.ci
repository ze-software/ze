# Test: ze DIALS a tunnel (sends SCCRQ) toward a fixed-port native Go fixture LNS peer,
# triggered by the `request l2tp outgoing-call` RPC over the no-auth+token
# REST API. The peer answers SCCRP; ze verifies the challenge, sends SCCCN,
# and the tunnel reaches established (initiator side).
# VALIDATES: AC-1 (well-formed SCCRQ with HostName/framing/bearer/window +
# Challenge when a per-remote secret is set), AC-2 (valid SCCRP -> SCCCN ->
# established), AC-8 (the SCCRQ carries a Tie Breaker AVP for simultaneous
# open). The peer completes the outgoing call (OCRP/OCCN) only so the RPC
# returns cleanly; the assertions here are on the tunnel handshake.


stdin=config:terminator=EOF_CONF
l2tp {
	enabled true
	remote lns1 {
		address 127.0.0.1
		port $PORT2
		shared-secret s3cr3t
		outgoing-calls true
	}
}
environment {
	l2tp {
		server main {
			ip 127.0.0.1
			port $PORT
		}
	}
	api-server {
		token "secret";
		rest {
			enabled true;
			server main {
				ip 127.0.0.1;
				port 18092;
			}
		}
	}
}
EOF_CONF

option=env:var=ze.log.l2tp:value=debug
option=env:var=ze.l2tp.skip-kernel-probe:value=true

cmd=background:seq=1:exec=ze -:stdin=config
cmd=foreground:seq=2:exec=ze-test fixture l2tp/tunnel-initiate-sccrq $PORT2 18092:timeout=30s
expect=exit:code=0
expect=stdout:contains=OK: SCCRQ received msgtype=1
expect=stdout:contains=challenge=True tiebreaker=True
expect=stdout:contains=OK: outgoing-call RPC returned status=done
expect=stderr:contains=tunnel now established (initiator)
