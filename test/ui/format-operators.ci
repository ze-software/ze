# Test: ze format — pipe operators on stdin
# VALIDATES: json, yaml, table, text, match, count, first, last, resolve operators

stdin=json:terminator=EOF_JSON
{"peers":[{"name":"peer1","state":"established","asn":65001},{"name":"peer2","state":"idle","asn":65002},{"name":"peer3","state":"active","asn":65003}]}
EOF_JSON

stdin=text:terminator=EOF_TEXT
MODULE       LEVEL  FLAGS   SCOPES
------       -----  -----   ------
bgp.reactor  debug  update  neighbor=192.0.2.1
bgp.fsm      info
bgp.wire     debug
EOF_TEXT

stdin=ips:terminator=EOF_IPS
{"remote":{"ip":"192.0.2.1"},"local":{"ip":"127.0.0.1"}}
EOF_IPS

# json pretty (default)
cmd=foreground:seq=1:exec=ze format json:stdin=json
expect=exit:code=0
expect=stdout:contains=peer1
expect=stdout:contains=established
expect=stdout:contains=65001

# json compact
cmd=foreground:seq=2:exec=ze format json compact:stdin=json
expect=exit:code=0
expect=stdout:contains="name":"peer1"
expect=stdout:contains="state":"established"

# yaml
cmd=foreground:seq=3:exec=ze format yaml:stdin=json
expect=exit:code=0
expect=stdout:contains=name: peer1
expect=stdout:contains=state: established
expect=stdout:contains=asn: 65001

# table
cmd=foreground:seq=4:exec=ze format table:stdin=json
expect=exit:code=0
expect=stdout:contains=peer1
expect=stdout:contains=established

# text
cmd=foreground:seq=5:exec=ze format text:stdin=json
expect=exit:code=0
expect=stdout:contains=peer1
expect=stdout:contains=established

# ndjson
cmd=foreground:seq=6:exec=ze format ndjson:stdin=json
expect=exit:code=0
expect=stdout:contains="name":"peer1"
expect=stdout:contains="name":"peer2"

# count on json
cmd=foreground:seq=7:exec=ze format count:stdin=json
expect=exit:code=0
expect=stdout:contains="count":3

# first 2
cmd=foreground:seq=8:exec=ze format first 2:stdin=json
expect=exit:code=0
expect=stdout:contains=peer1
expect=stdout:contains=peer2

# last 1
cmd=foreground:seq=9:exec=ze format last 1:stdin=json
expect=exit:code=0
expect=stdout:contains=peer3

# match on plain text
cmd=foreground:seq=10:exec=ze format match reactor:stdin=text
expect=exit:code=0
expect=stdout:contains=bgp.reactor

# count on plain text
cmd=foreground:seq=11:exec=ze format count:stdin=text
expect=exit:code=0
expect=stdout:contains="count":5

# resolve adds -name sibling for IP values
cmd=foreground:seq=12:exec=ze format resolve:stdin=ips
expect=exit:code=0
expect=stdout:contains=ip-name

# help
cmd=foreground:seq=13:exec=ze format --help
expect=exit:code=0
expect=stdout:contains=Format Operators
expect=stdout:contains=Filter Operators

# no args
cmd=foreground:seq=14:exec=ze format
expect=exit:code=1

# invalid operator
cmd=foreground:seq=15:exec=ze format nosuchop
expect=exit:code=1
expect=stderr:contains=unknown pipe operator
