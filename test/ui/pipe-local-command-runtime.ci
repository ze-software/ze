# Test: compiled runtime evidence for every locally registered data command
#
# VALIDATES: every production MustRegisterLocalData command runs through
# `ze cli -c` with a real pipe and no daemon.
# PREVENTS: source-only calls, spoofed markers, or a shorter registration prefix
# satisfying runtime local-data coverage.

option=timeout:value=45s

cmd=foreground:seq=1:exec=ze-test fixture ui/pipe-local-command-runtime:timeout=45s
expect=exit:code=0
expect=stdout:contains=COVERED: show config dump
expect=stdout:contains=COVERED: show schema events
expect=stdout:contains=COVERED: show yang completion
expect=stdout:contains=COVERED: show env registered
expect=stdout:contains=OK: 15/15 local-data commands and local one-shot save
