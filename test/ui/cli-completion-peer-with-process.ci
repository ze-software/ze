# Test: ze config completion — bus with multiple endpoints configured
# VALIDATES: Endpoint list keys shown when multiple endpoints exist

tmpfs=test.conf:terminator=EOF_CONF
bus {
	endpoint my-watcher {
		internal bgp-adj-rib-in
		receive {
			allow [ bgp:update ]
		}
	}
	endpoint my-filter {
		internal bgp-gr
		receive {
			allow [ bgp:state ]
		}
	}
}
bgp {
	filter {
		import {
			final accept
		}
		export {
			final accept
		}
	}
	router-id 1.2.3.4
	session {
		asn {
			local 65000
		}
	}
	peer peer1 {
		connection {
			remote {
				ip 1.1.1.1
			}
			local {
				ip 127.0.0.1
			}
		}
		session {
			asn {
				remote 65001
			}
		}
	}
}
EOF_CONF

cmd=foreground:seq=1:exec=ze config completion --context bus --input edit+endpoint+ test.conf
expect=exit:code=0
expect=stdout:contains=my-watcher
expect=stdout:contains=my-filter
expect=stdout:contains=*
