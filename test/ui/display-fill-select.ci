# Test: `| display` cuts a peer table down to the columns the question is about.
#
# VALIDATES: spec-cli-order-pipe AC-2. `| display state name` answers with those
#            two columns and nothing else, through the daemon, the dispatcher
#            and ApplyPipes rather than through a unit test that calls the
#            renderer directly.
# VALIDATES: AC-10. `show bgp peer list` indexes its rows by peer address, and
#            that address column survives the cut. A table of states with
#            nothing saying which peer each one is answers no question.
# VALIDATES: AC-5. Selection reaches `| json`, because which fields to answer
#            with is a question the operator asked out loud.
#
# The daemon runs with an ephemeral SSH listener; ZE_SSH_* carry the credentials
# `ze cli` has no flags for. The peers never establish, and nothing here needs
# them to: the row is built for every configured peer whatever its state.
#
# The timeout is DECLARED because this file starts a daemon and launches `ze`
# several times, which a first (cold) run or a loaded host can take past the
# runner's derived bound while every assertion still holds.
option=timeout:value=60s

tmpfs=run.py:terminator=EOF_PY
import os
import subprocess

from ze_api import wait_until


def require(condition, message):
    if not condition:
        raise SystemExit(message)


def run(argv, env):
    r = subprocess.run(argv, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, env=env, check=False)
    return r.returncode, r.stdout, r.stderr


def cli(env, command):
    code, out, err = run(['ze', 'cli', '-c', command], env)
    require(code == 0, '%s exit=%d: %s%s' % (command, code, out, err))
    return out


def table_header(text, marker):
    # The peer table is the value of a key, so its header row can share a line
    # with that key. marker names the header unambiguously.
    for line in text.split('\n'):
        if marker in line:
            fields = line.split()
            if fields and fields[0] in ('peers', 'peer'):
                return fields[1:]
            return fields
    raise SystemExit('no header row carrying %r in: %r' % (marker, text))


password_hash = subprocess.check_output(['ze', 'passwd'], input='secret\n', text=True).strip()
with open('peers.conf', 'w', encoding='utf-8') as fh:
    fh.write('''bgp {
    router-id 192.0.2.254
    session {
        asn {
            local 65000
        }
    }
    group transit {
        peer peer1 {
            connection {
                remote {
                    ip 192.0.2.1
                }
                local {
                    ip 127.0.0.1
                }
            }
            session {
                asn {
                    remote 65001
                }
            }
        }
        peer peer2 {
            connection {
                remote {
                    ip 192.0.2.2
                }
                local {
                    ip 127.0.0.1
                }
            }
            session {
                asn {
                    remote 65002
                }
            }
        }
    }
}

system {
    authentication {
        user ci {
            password "''' + password_hash + '''"
            profile [ admin ]
        }
    }
}
''')

daemon_env = os.environ.copy()
daemon_env['ZE_SSH_EPHEMERAL'] = os.path.abspath('ssh.addr')
daemon_env['ZE_READY_FILE'] = os.path.abspath('ready')
daemon_env['ZE_CONFIG_DIR'] = os.getcwd()
# Leave port 179 alone: this suite runs unprivileged and a bind failure there
# takes the daemon down before it writes `ready`.
daemon_env['ze_test_bgp_port'] = str(12000 + os.getpid() % 40000)
daemon = subprocess.Popen(['ze', '-f', 'peers.conf'], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, env=daemon_env)


def daemon_ready():
    if daemon.poll() is not None:
        out, err = daemon.communicate()
        raise SystemExit('daemon exited early\nstdout:\n' + out + '\nstderr:\n' + err)
    return os.path.exists('ssh.addr') and os.path.exists('ready')


try:
    if not wait_until(daemon_ready, attempts=200, delay=0.1):
        raise SystemExit('daemon did not become ready')

    host, port = open('ssh.addr', encoding='utf-8').read().strip().rsplit(':', 1)
    cli_env = os.environ.copy()
    cli_env.update({
        'ZE_SSH_HOST': host,
        'ZE_SSH_PORT': port,
        'ZE_SSH_USERNAME': 'ci',
        'ZE_SSH_PASSWORD': 'secret',
        'ZE_CONFIG_DIR': os.getcwd(),
    })

    out = cli(cli_env, 'show bgp peer list | display state name | text')
    header = table_header(out, 'state')
    require(header == ['state', 'name'], 'peer columns %r, want the two displayed ones' % header)
    for absent in ('remote-as', 'group', 'uptime'):
        require(absent not in out, 'a column nobody displayed survived: %r in %r' % (absent, out))
    for peer in ('192.0.2.1', '192.0.2.2'):
        require(peer in out, 'the address that identifies a row was cut: %r not in %r' % (peer, out))

    # The same command with no `| display` still answers with every column, so
    # the assertions above are a cut rather than a command that answers little.
    whole = cli(cli_env, 'show bgp peer list | text')
    for present in ('remote-as', 'group', 'uptime', 'name', 'state'):
        require(present in whole, 'the unfiltered answer is missing %r: %r' % (present, whole))

    # A program reads `| json`. Selection is data, so it travels; sequence is
    # presentation, so it does not.
    as_json = cli(cli_env, 'show bgp peer list | display state name | json')
    require('┌' not in as_json, '| json answered a table: %r' % as_json)
    require('"state"' in as_json and '"name"' in as_json, '| json dropped a displayed field: %r' % as_json)
    for absent in ('"remote-as"', '"group"', '"uptime"'):
        require(absent not in as_json, '| json kept %s, which nobody displayed: %r' % (absent, as_json))

finally:
    daemon.terminate()
    try:
        daemon.wait(timeout=5)
    except subprocess.TimeoutExpired:
        daemon.kill()
        daemon.wait(timeout=5)

print('OK')
EOF_PY

cmd=foreground:seq=1:exec=python3 run.py
expect=exit:code=0
expect=stdout:contains=OK
