# Test: ze doctor --json reports missing machine-id on Linux appliances
# VALIDATES: ze doctor --json exposes doctor-machine-id-missing through the user entry point.

option=skip-os:value=aix,android,darwin,dragonfly,freebsd,illumos,ios,js,netbsd,openbsd,plan9,solaris,wasip1,windows
option=env:var=ze.test.doctor.platform:value=gokrazy
option=env:var=ze.test.doctor.machine-id-path:value=missing-machine-id

tmpfs=empty.conf:terminator=EOF_CONF
# empty config
EOF_CONF

cmd=foreground:seq=1:exec=ze doctor --json empty.conf
expect=exit:code=1
expect=stdout:contains=doctor-machine-id-missing
expect=stdout:contains="diagnostics"
