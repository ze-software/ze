# Test: a web user deleted from the config cannot log in after a reload, and
#       cannot keep using a session cookie issued before it
# VALIDATES: web authentication answers from the RUNNING config on BOTH credential
#            paths. A user the operator removes and reloads stops authenticating
#            at once with a password (AC-1) and with an already issued session
#            cookie (AC-10), and the user the same reload keeps still
#            authenticates on both (AC-2, AC-12).
# PREVENTS: a deleted web account living on until the daemon restarts. Two copies
#           of the user list produced that. The fallback authenticator held the
#           list built when the web server started, and it was consulted exactly
#           when the live AAA chain REJECTED a login -- so the current config said
#           no and the startup copy said yes. The cookie branch of
#           AuthMiddlewareWithAudit held the second: it validated only the 24h
#           TTL and never consulted any user list, so an open tab kept full
#           config-edit rights for the rest of the day. The reload reported
#           success either way, leaving the operator no signal.
#
# The ordering is why this is a shell driver rather than http= steps: http=
# steps run in their own phase, before the runner waits on anything, so nothing
# in the .ci grammar can place a request strictly after a SIGHUP. The driver
# owns the whole sequence instead.

option=timeout:value=90s

tmpfs=web-user-reload-check.py:mode=755:terminator=EOF_PY
#!/usr/bin/env python3
"""Assert that a reload which deletes a web user takes effect immediately.

Runs against the daemon the shell driver starts. Requests carry either HTTP
Basic auth or a ze-session cookie, the two credentials AuthMiddlewareWithAudit
accepts (internal/component/web/auth.go), so this exercises the real web
authentication paths rather than a test-only entry point. The cookie is issued
by the real login handler, so it is the same credential a browser holds.
"""
import base64
import http.client
import os
import ssl
import sys
import urllib.error
import urllib.parse
import urllib.request

from ze_api import wait_until

BASE_URL = os.environ['ZE_WEB_URL']
CTX = ssl._create_unverified_context()
PROBE_PATH = '/show/environment/daemon/'


def probe(headers):
    """Return the HTTP status a protected page gives this credential header.

    Returns None when the daemon cannot be reached at all. A refused connection
    must never read as a rejected login: the point of this test is that the
    daemon keeps serving and changes its mind about one user.
    """
    req = urllib.request.Request(BASE_URL + PROBE_PATH, headers=headers)
    try:
        return urllib.request.urlopen(req, timeout=5, context=CTX).status
    except urllib.error.HTTPError as err:
        return err.code
    except (urllib.error.URLError, ConnectionRefusedError, OSError):
        return None


def status_for(user, password):
    """Return the status a protected page gives this username and password."""
    header = 'Basic ' + base64.b64encode(f'{user}:{password}'.encode()).decode()
    return probe({'Authorization': header})


def status_for_cookie(token):
    """Return the status a protected page gives this session cookie alone."""
    return probe({'Cookie': f'ze-session={token}'})


def login_cookie(user, password):
    """Log in through POST /login and return the ze-session token it issues.

    Uses a raw connection rather than urlopen because the handler answers 303
    and Set-Cookie is on that response, not on the page the redirect leads to.
    Returns None when no session cookie was issued.
    """
    parsed = urllib.parse.urlparse(BASE_URL)
    conn = http.client.HTTPSConnection(parsed.hostname, parsed.port, context=CTX, timeout=5)
    try:
        body = urllib.parse.urlencode({'username': user, 'password': password})
        conn.request('POST', '/login', body, {'Content-Type': 'application/x-www-form-urlencoded'})
        response = conn.getresponse()
        response.read()
        for name, value in response.getheaders():
            if name.lower() == 'set-cookie' and value.startswith('ze-session='):
                return value.split(';', 1)[0].split('=', 1)[1]
        return None
    except (ConnectionRefusedError, OSError):
        return None
    finally:
        conn.close()


def cookie_path(user):
    return f'cookie-{user}.txt'


def save_cookie(user, token):
    """Hand the token to the 'after' stage, which is a separate process."""
    with open(cookie_path(user), 'w', encoding='ascii') as handle:
        handle.write(token)


def load_cookie(user):
    with open(cookie_path(user), encoding='ascii') as handle:
        return handle.read().strip()


def require(condition, message):
    if not condition:
        print('FAIL: ' + message, file=sys.stderr)
        sys.exit(1)
    print('OK: ' + message, file=sys.stderr)


def main():
    stage = sys.argv[1]

    if stage == 'before':
        require(wait_until(lambda: status_for('webuser', 'webuserpass') == 200, attempts=40, delay=0.5),
                'webuser authenticates against the config that declares them')
        require(status_for('keepuser', 'keepuserpass') == 200,
                'keepuser authenticates against the config that declares them')
        require(status_for('webuser', 'wrongpass') == 401,
                'a wrong password is refused, so a 200 above means credentials were checked')

        # Both users take a session cookie from the real login form and keep it
        # across the reload, the way a browser tab does. The cookie is checked
        # here so that a 401 in the 'after' stage can only mean the daemon
        # changed its mind, never that the cookie was never valid.
        for user, password in (('webuser', 'webuserpass'), ('keepuser', 'keepuserpass')):
            token = login_cookie(user, password)
            require(token is not None, f'{user} logs in through the login form and is issued a session cookie')
            save_cookie(user, token)
            require(status_for_cookie(token) == 200,
                    f"{user}'s session cookie authenticates on its own, with no password")
        return

    # stage == 'after': the reload deleting webuser has been signalled. Reloading
    # is asynchronous, so poll for the new answer rather than assuming it has
    # landed; a reload that never applies leaves webuser at 200 and times out
    # here, which is the failure this test exists to catch.
    # The reload is asynchronous, so wait for its effect rather than assuming it
    # has landed. newuser exists only in the reloaded config, so this also
    # establishes that the daemon read the rewritten file at all.
    require(wait_until(lambda: status_for('newuser', 'newuserpass') == 200, attempts=40, delay=0.5),
            'newuser authenticates, so the reload read the rewritten config')

    require(status_for('webuser', 'webuserpass') == 401,
            'webuser is refused once the reload removes them from the config')

    # The control. keepuser proves the daemon is still up and still serving
    # authenticated pages, so the 401 above is a decision about one user rather
    # than a daemon that died or a listener that stopped accepting anyone.
    require(status_for('keepuser', 'keepuserpass') == 200,
            'keepuser still authenticates, so the reload removed one user and not the listener')

    # The cookie a browser tab is still holding. Nothing was polled: the check
    # runs per request against the running config, so the answer changed the
    # moment the reload landed, with no restart and no wait for the 24h TTL.
    require(status_for_cookie(load_cookie('webuser')) == 401,
            "webuser's session cookie is refused once the reload removes them from the config")

    require(status_for_cookie(load_cookie('keepuser')) == 200,
            "keepuser's session cookie still works, so the reload ended one session and not every session")


if __name__ == '__main__':
    main()
EOF_PY

tmpfs=test-web-user-reload.sh:mode=755:terminator=EOF_SH
#!/bin/sh
set -e

ZE_DIR=$(mktemp -d)
DAEMON_PID=""
cleanup() {
	if [ -n "$DAEMON_PID" ]; then
		kill "$DAEMON_PID" 2>/dev/null || true
		wait "$DAEMON_PID" 2>/dev/null || true
	fi
	rm -rf "$ZE_DIR"
}
trap cleanup EXIT

WEB_PORT=$((18500 + ($$ % 900)))
BGP_PORT=$((12000 + ($$ % 40000)))
export ze_test_bgp_port=$BGP_PORT
ZE_WEB_URL="https://127.0.0.1:$WEB_PORT"
export ZE_WEB_URL

# Hash both passwords with ze's own tool rather than pasting a fixture, so the
# test cannot drift from the cost factor and algorithm ze actually writes.
WEBHASH=$(printf 'webuserpass\n' | ze passwd)
KEEPHASH=$(printf 'keepuserpass\n' | ze passwd)
NEWHASH=$(printf 'newuserpass\n' | ze passwd)

# write_config <users-block-file>
# The environment{} and bgp{} halves are byte-identical between the two configs,
# so the only thing the reload changes is which users exist.
write_config() {
	cat "$1" > web-user-reload.conf
	cat >> web-user-reload.conf << ZECONF

environment {
	ssh {
		enabled true;
		server main { ip 127.0.0.1; port $((22000 + ($$ % 900))); }
	}
	web {
		enabled true;
		server main { ip 127.0.0.1; port $WEB_PORT; }
	}
}

bgp {
	router-id 1.2.3.4
	peer peer1 {
		connection {
			remote { ip 127.0.0.1; }
			local { ip 127.0.0.1; accept false; }
		}
		session {
			asn { local 1; remote 1; }
			router-id 1.2.3.4
			family { ipv4/unicast { prefix { maximum 10000; } } }
			capability { graceful-restart disable; }
		}
		behavior { group-updates disable; }
	}
}
ZECONF
}

# Both users are declared by the config file. Neither is the zefs power user, so
# the config is the only thing that can grant or withdraw either account.
cat > users-both.conf << ZEUSERS
system {
	authentication {
		user webuser {
			password "$WEBHASH"
		}
		user keepuser {
			password "$KEEPHASH"
		}
	}
}
ZEUSERS

# newuser exists only in the reloaded config. It proves the reload really read
# the rewritten file: if newuser cannot log in, the daemon is still answering
# from the config it booted with and the deletion assertion below would be
# testing nothing.
cat > users-kept.conf << ZEUSERS
system {
	authentication {
		user keepuser {
			password "$KEEPHASH"
		}
		user newuser {
			password "$NEWHASH"
		}
	}
}
ZEUSERS

write_config users-both.conf
# ze writes this file once plugin startup is complete, which is after the SIGHUP
# handler is installed. The runner arms ZE_READY_FILE only for a ze binary it
# launches itself, and it launches this script, so the daemon needs it here.
rm -f daemon.ready
ZE_READY_FILE="$PWD/daemon.ready" ZE_CONFIG_DIR="$ZE_DIR" ze start web-user-reload.conf 2>daemon.log &
DAEMON_PID=$!

./web-user-reload-check.py before

# The web listener comes up during service construction, while the SIGHUP
# handler is installed later in daemon startup. Serving a login is therefore not
# proof that a signal would be caught, so wait for the daemon's own readiness
# marker before signalling.
i=0
while [ ! -f daemon.ready ] && [ $i -lt 200 ]; do
	sleep 0.1
	i=$((i + 1))
done
if [ ! -f daemon.ready ]; then
	echo "FAIL: daemon never became ready, so the reload could not be signalled" >&2
	cat daemon.log >&2
	exit 1
fi

# The reload that deletes webuser. Nothing else in the config changes.
write_config users-kept.conf
kill -HUP "$DAEMON_PID"

if ! ./web-user-reload-check.py after; then
	echo "--- daemon.log ---" >&2
	cat daemon.log >&2
	exit 1
fi
exit 0
EOF_SH

cmd=foreground:seq=1:exec=./test-web-user-reload.sh:timeout=90s
expect=exit:code=0
