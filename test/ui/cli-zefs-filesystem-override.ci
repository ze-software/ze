# Test: ze config set --dry-run without an initialized store
# VALIDATES: dry-run reports the edit without creating persistent storage.

tmpfs=test.conf:terminator=EOF_CONF
bgp {
	router-id 1.2.3.4
	session {
		asn {
			local 65000
		}
	}
	peer peer1 {
		connection {
			remote {
				ip 1.1.1.1
			}
			local {
				ip 127.0.0.1
			}
		}
		session {
			asn {
				remote 65001
			}
		}
	}
}
EOF_CONF

cmd=foreground:seq=1:exec=ze config set --dry-run test.conf bgp session asn local 65001
expect=exit:code=0
expect=stderr:contains=dry-run: would set
