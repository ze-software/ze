# Test: ze doctor --json on internal { use } does not require an external binary
# VALIDATES: internal plugins are excluded from plugin-binary runtime checks.
# PREVENTS: in-process plugins being reported as missing subprocess binaries.

tmpfs=internal-clean.conf:terminator=EOF_CONF
plugin {
    internal rib {
        use bgp-rib
    }
}
# NTP is enabled so the exit code is not set by doctor-clock-no-sync, an ERROR
# on Ze's own system (clockNoSyncSeverity, internal/plugins/ntp/doctor.go).
environment {
    ntp {
        enabled true
    }
}
EOF_CONF

cmd=foreground:seq=1:exec=ze doctor --json config internal-clean.conf
expect=exit:code=0
expect=stdout:contains=diagnostics
reject=stdout:contains=doctor-plugin-missing
reject=stdout:contains=doctor-plugin-shell-missing
