# Test: the BUILT le binary plans a weekly publication and answers it as data.
#
# VALIDATES: spec-le-is-a-ze-binary AC-7 for the weekly tool, against the
#            artifact a developer runs -- one payload rendered by `| json`,
#            `| count` and `| match`, with no rendering code in the tool.
# PREVENTS: a tool that prints a report and calls it an answer, and a grammar
#           that accepts a bare path where a keyword belongs.
#
# NOTHING here reaches Discord. The command publishes only when the operator
# types `confirm`, and this test never does. ZE_REPO_ROOT points at the test's
# own directory, so the posts read and the archive consulted are both fixtures:
# a run against the real checkout would consult the real archive and its answer
# would change with what the owner has already published.
#
# le is compiled here rather than by the runner, which builds only ze and
# ze-test (internal/test/runner/runner.go, setupBinShims). The binary is written
# into the test's own directory, so nothing is written back into the checkout.
#
# The timeout is DECLARED because a cold cmd/ze le personality build precedes the run.

option=timeout:value=300s

tmpfs=run.py:terminator=EOF_PY
"""Drive `le weekly` over a fixture checkout and check its answer."""
import json
import os
import subprocess
import sys


def require(condition, message):
    if not condition:
        raise SystemExit(f'FAIL: {message}')


checkout = os.environ['ZE_REPO_ROOT']
here = os.getcwd()
binary = os.path.join(here, 'le')

built = subprocess.run(['make', '--no-print-directory', 'le-build',
                        f'ZE_BIN_DIR={os.path.dirname(binary)}'],
                       cwd=checkout, capture_output=True, text=True, check=False)
require(built.returncode == 0, f'building the cmd/ze le personality failed: {built.stderr}')

# A fixture checkout: the posts the command reads and the archive it consults
# are both here, so the answer does not change with what has really been
# published.
fixture = os.path.join(here, 'fixture')
posts = os.path.join(fixture, 'website', 'changes', 'posts')
os.makedirs(posts, exist_ok=True)
os.makedirs(os.path.join(fixture, 'scripts', 'zeledon', 'weekly'), exist_ok=True)

# 1999 so no real archive can name these weeks, and so the dates are far enough
# in the past that the automatic date stamp is on for both.
WEEKS = (('1999-01-04', '1999-01-10'), ('1999-01-11', '1999-01-17'))
for start, end in WEEKS:
    with open(os.path.join(posts, f'{start}.md'), 'w', encoding='utf-8') as fh:
        fh.write(f'---\ncovers: {start} .. {end}\n---\n\n'
                 f'**\U0001F4C5 Ze Weekly Update**\n\nWeek of {start}.\n')

env = dict(os.environ, ZE_REPO_ROOT=fixture)


def run(*args):
    return subprocess.run([binary, 'weekly', *args], cwd=here, env=env,
                          capture_output=True, text=True, check=False)


# The bare command is the plan. It sends nothing, so it exits 0 and shows the
# operator the words that would be published.
plan = run()
require(plan.returncode == 0, f'`le weekly` exited {plan.returncode}: {plan.stderr}')
for start, _ in WEEKS:
    require(f'Week of {start}' in plan.stdout,
            f'the plan does not show the message for {start}:\n{plan.stdout}')
require('nothing sent' in plan.stdout,
        f'the plan does not say that it published nothing:\n{plan.stdout}')

# One payload, every rendering. Nothing in the tool writes a line of JSON.
answer = run('|', 'json')
try:
    report = json.loads(answer.stdout)
except json.JSONDecodeError as exc:
    raise SystemExit(f'FAIL: `le weekly | json` did not answer JSON: {exc}\n'
                     f'{answer.stdout[:400]}') from exc

require(report['action'] == 'planned', f"action = {report['action']!r}, want 'planned'")
require(report['channel'] == 'ze-news', f"channel = {report['channel']!r}")
require(len(report['posts']) == len(WEEKS),
        f"the answer names {len(report['posts'])} post(s), want {len(WEEKS)}")

first = report['posts'][0]
for key in ('source', 'date', 'covers', 'status', 'date-stamped', 'messages'):
    require(key in first, f'a post row carries no {key!r}: {sorted(first)}')
require(first['date'] == WEEKS[0][0], f"the sweep ran out of order: {first['date']}")
require(first['status'] == 'planned', f"status = {first['status']!r}")
require('archive' not in first, 'a post nothing published carries an archive key')
require(first['messages'][0]['chars'] == len(first['messages'][0]['text']),
        'chars disagrees with the message it counts')

# A row operator acts on the posts, which is what declaring the answer's shape
# buys. `| count` answers a number, never the report.
counted = run('|', 'count')
require(str(len(report['posts'])) in counted.stdout,
        f"`le weekly | count` answered {counted.stdout!r}, want {len(report['posts'])}")

# `| match` selects rows rather than grepping a rendered report.
matched = run('|', 'match', WEEKS[1][0])
require(WEEKS[1][0] in matched.stdout,
        f'`le weekly | match {WEEKS[1][0]}` dropped the row it selected:\n{matched.stdout}')

# yaml is the third rendering of the same payload, and it costs the tool nothing.
as_yaml = run('|', 'yaml')
require(as_yaml.returncode == 0, f'`le weekly | yaml` exited {as_yaml.returncode}')
require('planned' in as_yaml.stdout, f'`le weekly | yaml` answered nothing usable:\n{as_yaml.stdout}')

# The grammar keeps a keyword in front of every value. A bare path is refused by
# name rather than being read as a keyword missing its value.
refused = run(os.path.join(posts, '1999-01-04.md'))
require(refused.returncode == 1, f'a bare path exited {refused.returncode}, want 1')
require('unknown keyword' in refused.stderr,
        f'the refusal does not name the problem:\n{refused.stderr}')

# force is a decision about one post, so a sweep refuses it.
swept = run('confirm', 'force')
require(swept.returncode == 1, f'force on a sweep exited {swept.returncode}, want 1')
require('source' in swept.stderr, f'the refusal does not say what to add:\n{swept.stderr}')

print('OK')
EOF_PY

cmd=foreground:seq=1:exec=python3 run.py
expect=exit:code=0
expect=stdout:contains=OK
