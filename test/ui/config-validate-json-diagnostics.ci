# Test: `validate config | json` — stable diagnostic JSON
# VALIDATES: AC-1 agent receives stable diagnostic JSON with diagnostics array

tmpfs=bad.conf:terminator=EOF_CONF
invalid syntax here
EOF_CONF

cmd=foreground:seq=1:exec=ze cli -c "validate config bad.conf | json"
expect=exit:code=1
expect=stdout:contains="diagnostics"
expect=stdout:contains="code"
expect=stdout:contains="severity"
expect=stdout:contains="message"
expect=stdout:contains="valid"
expect=stdout:contains=config-parse
