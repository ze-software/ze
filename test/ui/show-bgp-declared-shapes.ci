# Test: every in-tree `show bgp` command declares what its answer holds, so an
# operator it cannot support is refused BY NAME before the command runs.
#
# VALIDATES: spec-cli-show-bgp-answer-shapes AC-11, AC-12, AC-16, AC-18, AC-19,
#   and the operator half of AC-5 and AC-7.
# PREVENTS: a command accepting an operator and answering something plausible.
#   Twenty-three of the twenty-six `show bgp` paths declared nothing, so
#   validateDeclaredShape returned at `if !declared` and every operator was
#   accepted until the answer was in hand. `show bgp rib status | count` then
#   answered the peer count on a router with no restarting peer and was refused
#   on the same router a graceful restart later, because the shape was derived
#   from a payload whose row sets change with the peer state.
#
# Every refusal below is asserted BY NAME: the operator's own name and the
# reason. A non-zero exit alone would pass for a command that failed to run.
#
# Two peers are configured and neither establishes, and nothing here needs them
# to: `show bgp health` builds a row for every configured peer whatever its
# state. The rib and irr commands are served by plugin PROCESSES that this
# config does not start, and that is what makes them the right subjects: the
# refusal happens in the pipe layer BEFORE dispatch, so it is reached without
# the plugin ever answering.
#
# The daemon runs with an ephemeral SSH listener; ZE_SSH_* carry the credentials
# `ze cli` has no flags for.
#
# The timeout is DECLARED because this file starts a daemon, launches `ze` a
# dozen times, and lets one chain make a PTR lookup that has no answer.
option=timeout:value=90s

tmpfs=run.py:terminator=EOF_PY
import json
import os
import subprocess

from ze_api import wait_until


def require(condition, message):
    if not condition:
        raise SystemExit(message)


def run(argv, env):
    r = subprocess.run(argv, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, env=env, check=False)
    return r.returncode, r.stdout, r.stderr


password_hash = subprocess.check_output(['ze', 'passwd'], input='secret\n', text=True).strip()
with open('shapes.conf', 'w', encoding='utf-8') as fh:
    fh.write('''bgp {
    router-id 192.0.2.254
    session {
        asn {
            local 65000
        }
    }
    peer peer1 {
        connection {
            remote {
                ip 192.0.2.1
            }
            local {
                ip 127.0.0.1
            }
        }
        session {
            asn {
                remote 65001
            }
        }
    }
    peer peer2 {
        connection {
            remote {
                ip 192.0.2.2
            }
            local {
                ip 127.0.0.1
            }
        }
        session {
            asn {
                remote 65002
            }
        }
    }
}

system {
    authentication {
        user ci {
            password "''' + password_hash + '''"
            profile [ admin ]
        }
    }
}
''')

daemon_env = os.environ.copy()
daemon_env['ZE_SSH_EPHEMERAL'] = os.path.abspath('ssh.addr')
daemon_env['ZE_READY_FILE'] = os.path.abspath('ready')
daemon_env['ZE_CONFIG_DIR'] = os.getcwd()
# Leave port 179 alone: this suite runs unprivileged and a bind failure there
# takes the daemon down before it writes `ready`.
daemon_env['ze_test_bgp_port'] = str(12000 + os.getpid() % 40000)
daemon = subprocess.Popen(['ze', '-f', 'shapes.conf'], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, env=daemon_env)


def daemon_ready():
    if daemon.poll() is not None:
        out, err = daemon.communicate()
        raise SystemExit('daemon exited early\nstdout:\n' + out + '\nstderr:\n' + err)
    return os.path.exists('ssh.addr') and os.path.exists('ready')


try:
    if not wait_until(daemon_ready, attempts=200, delay=0.1):
        raise SystemExit('daemon did not become ready')

    host, port = open('ssh.addr', encoding='utf-8').read().strip().rsplit(':', 1)
    cli_env = os.environ.copy()
    cli_env.update({
        'ZE_SSH_HOST': host,
        'ZE_SSH_PORT': port,
        'ZE_SSH_USERNAME': 'ci',
        'ZE_SSH_PASSWORD': 'secret',
        'ZE_CONFIG_DIR': os.getcwd(),
    })

    def cli(command):
        code, out, err = run(['ze', 'cli', '-c', command], cli_env)
        require(code == 0, '%s exit=%d: %s%s' % (command, code, out, err))
        return out

    def refusal(command):
        # A refusal is written to the answer, so the text is what carries the
        # operator's name and the reason. The exit code alone would not tell a
        # refusal from a command that failed to run.
        code, out, err = run(['ze', 'cli', '-c', command], cli_env)
        return out + err

    def names_the(text, command, operator, reason):
        # "cannot apply here" is written by validateDeclaredShape
        # (internal/component/command/pipe.go) and by nothing else, so it is
        # what tells a refusal made from the DECLARATION from one made from the
        # answer in hand.
        #
        # Asserting the operator and the reason alone would be VACUOUS here, and
        # was: rowOperatorRefusal, the post-dispatch half, answers "<operator>
        # needs rows, and this answer has none: it holds one document" for the
        # same chain. Three of the refusals below passed with every declaration
        # in this spec removed, because the command ran, answered a document,
        # and was refused after the fact with wording that shares both
        # substrings. The whole point of a declaration is that the command does
        # NOT run, so the pre-dispatch wording is the thing to pin.
        require('cannot apply here' in text,
                '%s: refused AFTER dispatch, or not refused: the declaration is not what answered: %r' % (command, text))
        require(operator in text, '%s: the refusal does not name `%s`: %r' % (command, operator, text))
        require(reason in text, '%s: the refusal does not say %r: %r' % (command, reason, text))

    # --- AC-11: `show bgp health` answers rows, so `| count` answers the peer
    # count rather than being refused. It declared nothing before, so the
    # operator reached no pre-dispatch check at all.
    counted = json.loads(cli('show bgp health | count'))
    count = int(counted['count']) if isinstance(counted, dict) else int(counted)
    require(count == 2, '`show bgp health | count` = %r, want 2' % (counted,))

    # A second row operator, so the declaration is not read as a property of
    # `count` alone.
    matched = cli('show bgp health | match 192.0.2.1 | count')
    matched_count = json.loads(matched)
    matched_count = int(matched_count['count']) if isinstance(matched_count, dict) else int(matched_count)
    require(matched_count == 1, '`show bgp health | match 192.0.2.1 | count` = %r, want 1' % (matched,))

    # --- AC-12: `| resolve` decorates the "peer" field. The lookup has no
    # answer for a TEST-NET-1 address and is not expected to: what is asserted
    # is that the operator ACTED, which is the sibling key it writes beside
    # every address it decorated. A command that accepted the operator and
    # decorated nothing would answer the payload unchanged.
    resolved = json.loads(cli('show bgp health | resolve | json compact'))
    rows = resolved['peers'] if isinstance(resolved, dict) else resolved
    require(isinstance(rows, list) and rows, '`show bgp health | resolve` answered no rows: %r' % (resolved,))
    for row in rows:
        require('peer-name' in row, '`| resolve` did not decorate "peer": %r' % (row,))

    # --- The refusals. Each names the operator and the reason.
    #
    # AC-16: `show bgp rib status` answers ONE document. Its two per-peer maps
    # are keyed by peer address and read as row sets, so the shape derived from
    # the payload was rows while no peer was in graceful restart and no rows
    # once one was. The declaration makes the refusal the answer in both.
    text = refusal('show bgp rib status | count')
    names_the(text, 'show bgp rib status | count', 'count', 'one document')

    # The same command, a different row operator: the refusal is a property of
    # the shape, not of one operator.
    text = refusal('show bgp rib status | first 2')
    names_the(text, 'show bgp rib status | first 2', 'first', 'one document')

    text = refusal('show bgp rib best status | count')
    names_the(text, 'show bgp rib best status | count', 'count', 'one document')

    text = refusal('show bgp rib rpf | count')
    names_the(text, 'show bgp rib rpf | count', 'count', 'one document')

    # AC-18: `show bgp irr check` answers one verdict for one peer and one
    # prefix. `| first 1` used to answer the prefix alone, dropping the verdict.
    text = refusal('show bgp irr check | first 1')
    names_the(text, 'show bgp irr check | first 1', 'first', 'one document')

    # AC-5: `show bgp peer list` keys its rows BY the peer address and no field
    # of a row holds one, so `| resolve` would decorate nothing.
    text = refusal('show bgp peer list | resolve')
    names_the(text, 'show bgp peer list | resolve', 'resolve', 'IP address')

    # AC-7: a transition row carries a timestamp and two state names and no
    # address. Without the empty address-field list on `show bgp peer`, the
    # shape declared for this command would have published `| resolve` over the
    # "address" field inherited from `show bgp` and accepted it here.
    text = refusal('show bgp peer history | resolve')
    names_the(text, 'show bgp peer history | resolve', 'resolve', 'IP address')

    text = refusal('show bgp irr | resolve')
    names_the(text, 'show bgp irr | resolve', 'resolve', 'IP address')

    # --- AC-19: the published catalog states what each path supports, derived
    # from the shape it declared. `ze help command` reads the registry in its
    # own process and needs no daemon.
    def published(command):
        code, out, err = run(['ze', 'help', 'command', command, '--json'], cli_env)
        require(code == 0, 'ze help command %r exit=%d: %s%s' % (command, code, out, err))
        parsed = json.loads(out)
        entry = parsed[0] if isinstance(parsed, list) else parsed
        always = set(op['name'] for op in entry.get('operators', []) if op.get('available') == 'always')
        return entry.get('answer-shape'), always

    shape, always = published('show bgp rib best')
    require(shape == 'tab', '`show bgp rib best` publishes shape %r, want tab' % (shape,))
    for operator in ('count', 'first', 'display', 'origin', 'resolve'):
        require(operator in always, '`show bgp rib best` does not publish `%s`: %r' % (operator, sorted(always)))

    shape, always = published('show bgp rib status')
    require(shape == 'doc', '`show bgp rib status` publishes shape %r, want doc' % (shape,))
    for operator in ('count', 'first', 'display', 'origin', 'resolve'):
        require(operator not in always,
                '`show bgp rib status` publishes `%s` over an answer with no rows: %r' % (operator, sorted(always)))

    # `show bgp irr prefix` answers rows that are bare prefix STRINGS, so the
    # row operators apply and `| fill`, which re-sequences columns, does not.
    shape, always = published('show bgp irr prefix')
    require(shape == 'map', '`show bgp irr prefix` publishes shape %r, want map' % (shape,))
    require('count' in always, '`show bgp irr prefix` does not publish `count`: %r' % (sorted(always),))
    require('fill' not in always, '`show bgp irr prefix` publishes `fill` over rows with no columns')
finally:
    daemon.terminate()
    try:
        daemon.wait(timeout=5)
    except subprocess.TimeoutExpired:
        daemon.kill()
        daemon.wait(timeout=5)

print('OK')
EOF_PY

cmd=foreground:seq=1:exec=python3 run.py
expect=exit:code=0
expect=stdout:contains=OK
