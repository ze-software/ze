# Test: the BUILT le binary runs the three real VPP evidence gates, end to end,
# accept-only: the registered native fixture enforces this scenario's behavioral contract
# and renders their answers through the shared pipe operators.
#
# The timeout is declared because a cold build cache makes the first cmd/ze
# le-personality compile much slower than the steady state.

option=timeout:value=300s

cmd=foreground:seq=1:exec=ze-test fixture ui/le-evidence-vpp-answers
expect=exit:code=0
expect=stdout:contains=OK
