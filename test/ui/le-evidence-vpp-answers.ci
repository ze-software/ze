# Test: the BUILT le binary runs the three real VPP evidence gates, end to end,
#       and renders their answers through the shared pipe operators.
#
# VALIDATES: spec-le-is-a-ze-binary AC-1, AC-7 and AC-8 for
#            `le deployment vpp-test`, `le deployment vpp-iface-test`, and
#            `le qemu vpp-hugepages-test`, against the artifact a developer runs.
# PREVENTS: a green package suite over a binary that does not compose, and a
#           command whose answer only renders because a test called the function
#           rather than the binary.
#
# The three commands need no Docker, QEMU, or appliance here. They reach the
# outside world through PATH, so this file puts recording stand-ins in front of
# them. The parity tests beside the Python scripts use the same seam. This test
# drives it one layer further out. It covers argv, the registry, the action
# table, the payload, and the renderer over a fixture checkout that no container
# or virtual machine sees.
#
# The timeout is DECLARED because a cold build cache makes the first cmd/ze
# le-personality compile far slower than the steady state.

option=timeout:value=300s

tmpfs=run.py:terminator=EOF_PY
"""Compile le, then drive the three VPP evidence commands the way a developer does."""
import json
import os
import stat
import subprocess


def require(condition, message):
    if not condition:
        raise SystemExit(f'FAIL: {message}')


root = os.environ['ZE_REPO_ROOT']
work = os.getcwd()
binary = os.path.join(work, 'le')

# Registry-backed le tools must see the same full feature set as the product.
tags = {'ze_le'}
with open(os.path.join(root, 'feature-gates.txt'), encoding='utf-8') as handle:
    for line in handle:
        words = line.split()
        if words and words[0].startswith('ze_'):
            tags.add(words[0])
tagset = ' '.join(sorted(tags))
build_env = dict(os.environ)
build_env['CGO_ENABLED'] = '0'
compiled = subprocess.run(
    ['go', 'build', '-tags', tagset, '-o', binary, './cmd/ze'],
    cwd=root, capture_output=True, text=True, check=False, env=build_env,
)
require(compiled.returncode == 0, f'compiling the cmd/ze le personality failed: {compiled.stderr}')

# A fixture checkout: the two markers lepath.Root looks for, and the manifest the
# daemon build tags derive from.
fixture = os.path.join(work, 'fixture')
os.makedirs(fixture, exist_ok=True)
with open(os.path.join(fixture, 'go.mod'), 'w', encoding='utf-8') as fh:
    fh.write('module example.test/m\n\ngo 1.26\n')
with open(os.path.join(fixture, 'feature-gates.txt'), 'w', encoding='utf-8') as fh:
    fh.write('ze_bgp internal/component/bgp\nze_vpp internal/component/vpp\n')

# The recording programs. docker plays the VPP daemon: it creates the two sockets
# the run waits for and answers each feature query. Each feature probe waits for
# the ze process of its own scenario, so the run cannot reach a verdict before
# the call proving ze was started has been recorded.
stubs = os.path.join(work, 'stubs')
os.makedirs(stubs, exist_ok=True)

DOCKER = r'''#!/bin/sh
record() {
  sep=$(printf '\037')
  line=""
  for a in "$@"; do
    if [ -z "$line" ]; then line="$a"; else line="$line$sep$a"; fi
  done
  printf '%s\036' "$line" >> "$ZE_RECORD_DOCKER"
}
await_daemon() {
  for _ in $(seq 60); do
    if [ -f "$ZE_VPP_WORK.$1" ]; then return 0; fi
    sleep 0.05
  done
  return 0
}
mkdir -p "$ZE_VPP_STATE"
state() { printf '%s/%s' "$ZE_VPP_STATE" "$1"; }
has() { [ -f "$(state "$1")" ]; }
set_state() { : > "$(state "$1")"; }
await_state() {
  for _ in $(seq 60); do
    if has "$1"; then return 0; fi
    sleep 0.05
  done
  return 1
}
clear_state() { rm -f "$(state "$1")"; }
case "$1" in
  image) record "$@" ; exit 0 ;;
  pull)  record "$@" ; exit 0 ;;
  rm)    record "$@" ; exit 0 ;;
  logs)  record "$@" ; echo "vpp: container log" ; exit 0 ;;
  run)
    record "$@"
    for a in "$@"; do
      case "$a" in
        *:/run/vpp) printf '%s' "${a%:/run/vpp}" > "$ZE_VPP_WORK" ;;
      esac
    done
    echo deadbeef ; exit 0 ;;
  exec)
    case "$*" in
      *"vpp -c /run/vpp/startup.conf"*)
        record "$@"
        w=$(cat "$ZE_VPP_WORK") ; : > "$w/api.sock" ; : > "$w/cli.sock" ; exit 0 ;;
      *"TestVPPRealDataplaneInstalls"*)
        record "$@"
        printf '%s\n' 'ze-vpp-ipsec:spd-id=41' 'ze-vpp-ipsec:sad-id=42' \
          'ze-vpp-ipsec:close-removed-spi=43' 'ze-vpp-ipsec:close-removed-spd-id=44'
        exit 0 ;;
      *"show ipsec sa 0"*)
        record "$@"
        printf '%s' 'salt 0xdeadbeef aes-gcm-256 000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f integrity alg none encap-copy-ecn decap-copy-ecn'
        exit 0 ;;
      *"show ipsec sa"*)
        record "$@"
        printf '%s' '[0] spi 287454020 protocol:esp tunnel
[1] spi 1432778632 protocol:esp tunnel inbound'
        exit 0 ;;
      *"show ipsec all"*)
        record "$@"
        printf '%s' 'spd 41
41 -> loop0
priority -100 action bypass type ip4-outbound protocol any
priority -2000 action protect type ip4-outbound protocol any'
        exit 0 ;;
      *"show plugins"*)
        record "$@"
        if [ "${ZE_PLUGINS_EXIT:-0}" != "0" ]; then
          echo "show plugins: unknown input" >&2 ; exit "$ZE_PLUGINS_EXIT"
        fi
        echo "wireguard_plugin.so" ; echo "linux_cp_plugin.so" ; echo "linux_nl_plugin.so" ; exit 0 ;;
      *"show version"*) record "$@" ; echo "vpp v24.02-release" ; exit 0 ;;
      *"create loopback interface"*) record "$@" ; echo loop0 ; exit 0 ;;
      *"set interface state loop0 up"*) record "$@" ; exit 0 ;;
      *"show gre tunnel"*)
        await_daemon tunnel.conf ; record "$@"
        echo "[0] instance 0 src 10.10.10.1 dst 10.10.10.2" ; exit 0 ;;
      *"show interface span"*)
        await_daemon mirror.conf ; record "$@"
        echo "msrc0    rx    mdst0" ; exit 0 ;;
      *"show interface features loop0"*)
        record "$@"
        has pol-default && echo "policer-output"
        if has pol-tcp || has pol-cs6 || has pol-web || has pol-dns; then echo "policer-classify"; fi
        exit 0 ;;
      *"show interface"*) record "$@" ; printf 'loop0 7 up\nlocal0 0 down\n' ; exit 0 ;;
      *"show wireguard interface"*)
        await_daemon wg.conf ; record "$@"
        echo "[0] wg0 port 51820" ; exit 0 ;;
      *"show lcp"*)
        await_daemon lcp.conf ; record "$@"
        echo "itf-pair: [0] loop0 tap0 host" ; exit 0 ;;
      *"show ip fib 10.20.0.0/24"*) record "$@" ; has fib && echo "10.20.0.0/24 via 10.0.0.1" ; exit 0 ;;
      *"show ip fib 10.30.0.0/24"*) record "$@" ; has mpls && echo "10.30.0.0/24 via 10.0.0.1 label 100" ; exit 0 ;;
      *"show policer"*)
        w=$(cat "$ZE_VPP_WORK")
        if has pol-default && ! grep -q 'interface loop0' "$w/traffic.conf"; then await_state clear-pol-default; fi
        if has pol-tcp && ! grep -q 'interface loop0' "$w/traffic-proto.conf"; then await_state clear-pol-tcp; fi
        if has pol-cs6 && ! grep -q 'interface loop0' "$w/traffic-dscp.conf"; then await_state clear-pol-cs6; fi
        if has pol-web && ! grep -q 'interface loop0' "$w/traffic-mc.conf"; then await_state clear-pol-multi; fi
        record "$@"
        has pol-default && echo "ze/loop0/default"
        has pol-tcp && echo "ze/loop0/tcp"
        has pol-cs6 && echo "ze/loop0/cs6"
        has pol-web && echo "ze/loop0/web"
        has pol-dns && echo "ze/loop0/dns"
        if has clear-pol-default; then clear_state pol-default; clear_state clear-pol-default; fi
        if has clear-pol-tcp; then clear_state pol-tcp; clear_state clear-pol-tcp; fi
        if has clear-pol-cs6; then clear_state pol-cs6; clear_state clear-pol-cs6; fi
        if has clear-pol-multi; then clear_state pol-web; clear_state pol-dns; clear_state clear-pol-multi; fi
        exit 0 ;;
      *"show classify tables"*) record "$@" ; echo "table 0 sessions" ; exit 0 ;;
      *"show acl-plugin interface loop0"*) record "$@" ; has acl && echo "input acl 0" ; exit 0 ;;
      *"show acl-plugin acl"*)
        if has acl && ! grep -q 'table wan' "$(cat "$ZE_VPP_WORK")/firewall.conf"; then await_state clear-acl; fi
        record "$@"
        has acl && echo "ze/wan/input"
        if has clear-acl; then clear_state acl; clear_state clear-acl; fi
        exit 0 ;;
      *"pkill -TERM -f ze-test-linux-amd64"*) record "$@" ; clear_state fib ; clear_state mpls ; exit 0 ;;
      *"/ze-test-linux-amd64 peer "*)
        record "$@"
        case "$*" in *mpls-peer-script*) marker=mpls ;; *) marker=fib ;; esac
        set_state "$marker"
        echo "listening on 127.0.0.1"
        while has "$marker"; do sleep 0.05; done
        exit 0 ;;
      *"ip link show"*) record "$@" ; echo "1: lo: <LOOPBACK,UP>" ; exit 0 ;;
      *"start /run/vpp/"*)
        record "$@"
        conf=""
        for a in "$@"; do
          case "$a" in /run/vpp/*.conf) conf=${a#/run/vpp/} ;; esac
        done
        : > "$ZE_VPP_WORK.$conf"
        w=$(cat "$ZE_VPP_WORK")
        case "$conf" in
          traffic.conf) grep -q 'interface loop0' "$w/$conf" && set_state pol-default || set_state clear-pol-default ; echo "traffic-control config applied" >&2 ;;
          traffic-proto.conf) grep -q 'interface loop0' "$w/$conf" && set_state pol-tcp || set_state clear-pol-tcp ; echo "traffic-control config applied" >&2 ;;
          traffic-dscp.conf) grep -q 'interface loop0' "$w/$conf" && set_state pol-cs6 || set_state clear-pol-cs6 ; echo "traffic-control config applied" >&2 ;;
          traffic-mc.conf)
            if grep -q 'interface loop0' "$w/$conf"; then set_state pol-web; set_state pol-dns; else set_state clear-pol-multi; fi
            echo "traffic-control config applied" >&2 ;;
          firewall.conf) grep -q 'table wan' "$w/$conf" && set_state acl || set_state clear-acl ; echo "firewall config applied" >&2 ;;
          *) echo "ze: interface backend vpp ready" >&2 ;;
        esac
        exec sleep 300 ;;
      *) record "$@" ; exit 0 ;;
    esac ;;
esac
exit 0
'''

GO = r'''#!/bin/sh
prev=""
out=""
for a in "$@"; do
  if [ "$prev" = "-o" ]; then out="$a"; fi
  prev="$a"
done
[ -z "$out" ] && exit 0
mkdir -p "$(dirname "$out")"
cat > "$out" <<'ZEHOST'
#!/bin/sh
case "$1 $2" in
  "appliance init")
    mkdir -p "$ZE_APPLIANCE_DIR/$3"
    printf '%s' '{"name":"'"$3"'","image":{"arch":"amd64"}}' > "$ZE_APPLIANCE_DIR/$3/appliance.json"
    ;;
  "appliance build")
    : > "$ZE_APPLIANCE_DIR/$3/ze-hugepages.img"
    ;;
esac
exit 0
ZEHOST
chmod +x "$out"
exit 0
'''

QEMU = r'''#!/bin/sh
echo "appliance booting"
sleep 30
exit 0
'''

SSHPASS = r'''#!/bin/sh
for a in "$@"; do
  case "$a" in
    "show host kernel | json")
      printf '{"cmdline":"console=ttyS0 %s"}\n' "${ZE_HP_CMDLINE}" ; exit 0 ;;
    "show host memory | json")
      printf '{"hugepages-total":%s}\n' "${ZE_HP_TOTAL:-64}" ; exit 0 ;;
  esac
done
exit 0
'''

TOOL = '#!/bin/sh\nexit 0\n'

programs = {
    'docker': DOCKER,
    'go': GO,
    'qemu-system-x86_64': QEMU,
    'qemu-system-aarch64': QEMU,
    'sshpass': SSHPASS,
    'mkfs.ext4': TOOL,
    'debugfs': TOOL,
}
for name, body in programs.items():
    path = os.path.join(stubs, name)
    with open(path, 'w', encoding='utf-8') as fh:
        fh.write(body)
    os.chmod(path, os.stat(path).st_mode | stat.S_IEXEC | stat.S_IXGRP | stat.S_IXOTH)


def le(*args, record=None, plugins_exit='0', cmdline=None, total='64'):
    env = dict(os.environ)
    env['PATH'] = stubs + os.pathsep + env['PATH']
    env['ZE_REPO_ROOT'] = fixture
    env['ZE_RECORD_DOCKER'] = record or os.path.join(work, 'docker-argv')
    env['ZE_VPP_WORK'] = os.path.join(work, 'vpp-work')
    state_key = os.path.basename(env['ZE_RECORD_DOCKER'])
    env['ZE_VPP_STATE'] = os.path.join(work, f'vpp-state-{state_key}')
    env['ZE_VPP_DOCKER_IMAGE'] = 'ligato/vpp-base:latest'
    env['ZE_VPP_DOCKER_PLATFORM'] = 'linux/amd64'
    env['ZE_VPP_DOCKER_GOARCH'] = 'amd64'
    env['ZE_PLUGINS_EXIT'] = plugins_exit
    env['ZE_VPP_HP_KEEP'] = '1'
    env['ZE_VPP_HP_SSH_PORT'] = '34122'
    env['ZE_HP_CMDLINE'] = cmdline or 'default_hugepagesz=2M hugepagesz=2M hugepages=64'
    env['ZE_HP_TOTAL'] = total
    return subprocess.run([binary, *args], capture_output=True, text=True,
                          check=False, env=env)


def recorded(path):
    """Every docker call, its words rejoined with a space."""
    if not os.path.exists(path):
        return []
    with open(path, encoding='utf-8') as fh:
        return [call.replace('\x1f', ' ') for call in fh.read().split('\x1e') if call]


# Both commands appear in the composition root, which is what the usage page
# reads back.
usage = le('--help')
page = usage.stdout + usage.stderr
for name in ('deployment', 'qemu'):
    require(name in page, f'le --help does not list the {name} command')

# A bare area lists its actions, and the listing says which of them write.
for name, verb in (('deployment', 'vpp-iface-test'), ('qemu', 'vpp-hugepages-test')):
    listing = le(name)
    require(listing.returncode == 0, f'le {name} exited {listing.returncode}')
    require(verb in listing.stdout, f'le {name} does not list {verb}: {listing.stdout!r}')
    require('checks' in listing.stdout, f'le {name} does not mark {verb} read-only')

# The VPP interface proof, end to end: it builds a daemon, starts VPP, and asks
# VPP's own command line about each of the four features.
record = os.path.join(work, 'iface-argv')
proof = le('deployment', 'vpp-iface-test', '|', 'json', record=record)
require(proof.returncode == 0,
        f'the VPP interface proof exited {proof.returncode}: {proof.stderr[-800:]}')
report = json.loads(proof.stdout)
for key in ('image', 'container', 'vpp-version', 'plugins', 'scenarios', 'passed'):
    require(key in report, f'the proof answered no {key!r} key: {sorted(report)}')
require(report['passed'] is True, 'the proof did not reach a pass')
require(len(report['scenarios']) == 4,
        f'the proof ran {len(report["scenarios"])} scenarios, want 4')
for one in report['scenarios']:
    require(one['outcome'] == 'pass',
            f'scenario {one["feature"]} answered {one["outcome"]}: {one["detail"]}')
require(len(report['plugins']) == 3,
        f'the proof reported {len(report["plugins"])} plugins, want 3')

calls = recorded(record)
require(any('--privileged' in call for call in calls),
        'the container is not privileged:\n' + '\n'.join(calls))
for owed in ('start /run/vpp/tunnel.conf', 'show gre tunnel',
             'start /run/vpp/wg.conf', 'show wireguard interface'):
    require(any(owed in call for call in calls),
            f'the proof never made a call carrying {owed!r}:\n' + '\n'.join(calls))

# A plugin query that FAILED stops the run: it is not an absent plugin, and
# reading it as one skipped half the proof and reported a pass.
broken = le('deployment', 'vpp-iface-test', record=os.path.join(work, 'iface-broken'),
            plugins_exit='1')
require(broken.returncode == 1,
        f'a failed plugin query exited {broken.returncode}, want 1')
require(not any('start /run/vpp/' in call
                for call in recorded(os.path.join(work, 'iface-broken'))),
        'ze was started on a plugin answer nobody obtained')

# The eight-scenario VPP deployment proof, through the built command and the
# shared structured-data renderer.
record = os.path.join(work, 'vpp-evidence-argv')
evidence = le('deployment', 'vpp-test', '|', 'json', record=record)
require(evidence.returncode == 0,
        f'the VPP deployment proof exited {evidence.returncode}: {evidence.stderr[-800:]}')
vpp_report = json.loads(evidence.stdout)
for key in ('image', 'container', 'vpp-version', 'interface', 'scenarios', 'passed'):
    require(key in vpp_report,
            f'the VPP deployment proof answered no {key!r}: {sorted(vpp_report)}')
require(vpp_report['passed'] is True, 'the VPP deployment proof did not pass')
require(len(vpp_report['scenarios']) == 8,
        f'the VPP deployment proof ran {len(vpp_report["scenarios"])} scenarios, want 8')
check_count = sum(len(one['checks']) for one in vpp_report['scenarios'])
require(check_count == 21,
        f'the VPP deployment proof returned {check_count} checks, want 21')
for one in vpp_report['scenarios']:
    require(one['verdict'] == 'pass',
            f'VPP scenario {one["scenario"]} answered {one["verdict"]}')

vpp_calls = recorded(record)
require(len(vpp_calls) == 62,
        f'the VPP deployment proof made {len(vpp_calls)} Docker calls, want 62 '
        '(57 distinct steps plus five cleanup polls)')
for owed in ('TestVPPRealDataplaneInstalls', 'show ip fib 10.20.0.0/24',
             'show classify tables', 'show acl-plugin acl'):
    require(any(owed in call for call in vpp_calls),
            f'the VPP deployment proof made no call carrying {owed!r}')

evidence_yaml = le('deployment', 'vpp-test', '|', 'yaml',
                   record=os.path.join(work, 'vpp-evidence-yaml-argv'))
require(evidence_yaml.returncode == 0,
        f'the YAML VPP deployment proof exited {evidence_yaml.returncode}')
require('scenarios:' in evidence_yaml.stdout and 'passed: true' in evidence_yaml.stdout,
        f'the YAML renderer omitted the structured report: {evidence_yaml.stdout[:300]!r}')

evidence_table = le('deployment', 'vpp-test', '|', 'table',
                    record=os.path.join(work, 'vpp-evidence-table-argv'))
require(evidence_table.returncode == 0,
        f'the table VPP deployment proof exited {evidence_table.returncode}')
for heading in ('scenario', 'verdict', 'checks'):
    require(heading in evidence_table.stdout,
            f'the VPP table has no {heading!r} scenario column: {evidence_table.stdout[:500]!r}')
for scenario in ('ipsec', 'ipv4-fib', 'mpls-fib', 'traffic-interface-class',
                 'traffic-protocol-class', 'traffic-dscp-class',
                 'traffic-multi-class', 'firewall-acl'):
    require(scenario in evidence_table.stdout,
            f'the VPP table omitted scenario {scenario!r}: {evidence_table.stdout[:500]!r}')

# The hugepage proof, end to end: it builds a host ze, builds an appliance, boots
# it, and asks the booted appliance two questions over its own CLI.
boot = le('qemu', 'vpp-hugepages-test', '|', 'json')
require(boot.returncode == 0,
        f'the hugepage proof exited {boot.returncode}: {boot.stderr[-800:]}')
verdict = json.loads(boot.stdout)
for key in ('verdict', 'arch', 'accelerator', 'page-token', 'pages',
            'memory-mib', 'cmdline', 'hugepages-total'):
    require(key in verdict, f'the proof answered no {key!r} key: {sorted(verdict)}')
require(verdict['verdict'] == 'pass', f'the proof answered {verdict["verdict"]}')
require(verdict['pages'] == 64, f'the proof asked for {verdict["pages"]} pages, want 64')
require(verdict['hugepages-total'] == 64,
        f'the kernel reserved {verdict["hugepages-total"]}, want 64')

# A kernel command line carrying only the DEFAULT page-size argument fails: each
# wanted argument is a whole argument of the command line, never a substring of
# a longer one.
partial = le('qemu', 'vpp-hugepages-test',
             cmdline='default_hugepagesz=2M hugepages=64')
require(partial.returncode == 1,
        f'a cmdline with no standalone hugepagesz exited {partial.returncode}, want 1')

# A kernel that reserved nothing fails, whatever the command line said. That is
# the assertion the command line alone cannot make.
none = le('qemu', 'vpp-hugepages-test', total='0')
require(none.returncode == 1,
        f'a kernel that reserved no pages exited {none.returncode}, want 1')
require('hugepages-total=0' in none.stdout,
        f'the failure does not name the kernel answer: {none.stdout!r}')

# One payload, three renderings, none of them written by either tool.
for args, needle in (
    (('deployment', 'vpp-iface-test', '|', 'yaml'), 'passed:'),
    (('qemu', 'vpp-hugepages-test', '|', 'yaml'), 'verdict:'),
):
    out = le(*args, record=os.path.join(work, 'render-argv'))
    require(needle in out.stdout,
            f'`le {" ".join(args)}` did not render the payload: {out.stdout[:200]!r}')

# An action nobody declared is refused with its own code, told apart from a gate
# that ran and failed.
missing = le('qemu', 'no-such-action')
require(missing.returncode == 2, f'an unknown action exited {missing.returncode}, want 2')
extra = le('deployment', 'vpp-iface-test', 'somewhere')
require(extra.returncode == 1, f'a value after an action exited {extra.returncode}, want 1')

print('OK')
EOF_PY

cmd=foreground:seq=1:exec=python3 run.py
expect=exit:code=0
expect=stdout:contains=OK
