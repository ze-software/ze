# Test: ze pipe — pipe operators on stdin
# VALIDATES: json, yaml, table, text, match, count, first, last, resolve operators;
#            the removed `ze format` carrier name; root completion offers `pipe`.
# // STRENGTHENING, not weakening. The standalone `expect=exit:code=N`
# form is FILE-level (last-wins) so all but the last per-command exit assertion was
# DEAD (verified: seq=1 set to code=99 still passed). Moved every exit check into the
# working inline `cmd=...:exit=N` form, which fires per-command (verified it catches a
# wrong code). Line count drops because each `expect=exit:code` line folds into its
# `cmd=` line; coverage increases. The removed-name needle (seq=16 "unknown command:
# format") is unique; the no-args usage needle (seq=14) is shared with the --help step
# (both print pipeUsage), so seq=14's real per-command proof is its inline exit=1, not
# the needle -- the `contains` there is only a supplementary smoke check.

stdin=json:terminator=EOF_JSON
{"peers":[{"name":"peer1","state":"established","asn":65001},{"name":"peer2","state":"idle","asn":65002},{"name":"peer3","state":"active","asn":65003}]}
EOF_JSON

stdin=text:terminator=EOF_TEXT
MODULE       LEVEL  FLAGS   SCOPES
------       -----  -----   ------
bgp.reactor  debug  update  neighbor=192.0.2.1
bgp.fsm      info
bgp.wire     debug
EOF_TEXT

stdin=ips:terminator=EOF_IPS
{"remote":{"ip":"192.0.2.1"},"local":{"ip":"127.0.0.1"}}
EOF_IPS

# json pretty (default)
cmd=foreground:seq=1:exec=ze pipe json:stdin=json:exit=0
expect=stdout:contains=peer1
expect=stdout:contains=established
expect=stdout:contains=65001

# json compact
cmd=foreground:seq=2:exec=ze pipe json compact:stdin=json:exit=0
expect=stdout:contains="name":"peer1"
expect=stdout:contains="state":"established"

# yaml
cmd=foreground:seq=3:exec=ze pipe yaml:stdin=json:exit=0
expect=stdout:contains=name: peer1
expect=stdout:contains=state: established
expect=stdout:contains=asn: 65001

# table
cmd=foreground:seq=4:exec=ze pipe table:stdin=json:exit=0
expect=stdout:contains=peer1
expect=stdout:contains=established

# text
cmd=foreground:seq=5:exec=ze pipe text:stdin=json:exit=0
expect=stdout:contains=peer1
expect=stdout:contains=established

# ndjson
cmd=foreground:seq=6:exec=ze pipe ndjson:stdin=json:exit=0
expect=stdout:contains="name":"peer1"
expect=stdout:contains="name":"peer2"

# count on json
cmd=foreground:seq=7:exec=ze pipe count:stdin=json:exit=0
expect=stdout:contains="count":3

# first 2
cmd=foreground:seq=8:exec=ze pipe first 2:stdin=json:exit=0
expect=stdout:contains=peer1
expect=stdout:contains=peer2

# last 1
cmd=foreground:seq=9:exec=ze pipe last 1:stdin=json:exit=0
expect=stdout:contains=peer3

# match on plain text
cmd=foreground:seq=10:exec=ze pipe match reactor:stdin=text:exit=0
expect=stdout:contains=bgp.reactor

# count on plain text
cmd=foreground:seq=11:exec=ze pipe count:stdin=text:exit=0
expect=stdout:contains="count":5

# resolve adds -name sibling for IP values
cmd=foreground:seq=12:exec=ze pipe resolve:stdin=ips:exit=0
expect=stdout:contains=ip-name

# help
#
# The two headings changed with spec-cli-pipe-operator-coverage phase 1: the
# page used to split "Format Operators" from "Filter Operators", and it named
# ten of sixteen. The split now follows the class that decides what a command
# owes, and the page is derived from the operator catalog rather than
# hand-typed.
#
# The operators asserted below are the ones the hand-typed page OMITTED, so this
# fails if the page ever stops being derived. They are matched with a leading
# space so `json` cannot satisfy the check for a name inside `ndjson`.
cmd=foreground:seq=13:exec=ze pipe --help:exit=0
expect=stdout:contains=Global Operators
expect=stdout:contains=Row Operators
expect=stdout:contains= raw
expect=stdout:contains= log
expect=stdout:contains= save
expect=stdout:contains= origin
expect=stdout:contains= display
expect=stdout:contains= fill

# no args -> usage, exit 1 (inline exit is the real per-command proof)
cmd=foreground:seq=14:exec=ze pipe:exit=1
expect=stderr:contains=ze pipe <operator>

# invalid operator -> exit 1 + unique error needle
cmd=foreground:seq=15:exec=ze pipe nosuchop:exit=1
expect=stderr:contains=unknown pipe operator

# removed carrier name: `ze format` is gone, not aliased (AC-2). The needle names
# the exact command so cumulative output cannot satisfy it vacuously.
cmd=foreground:seq=16:exec=ze format json:stdin=json:exit=1
expect=stderr:contains=unknown command: format

# root completion offers `pipe` (AC-12); the isolated negatives live in
# root-completion.ci (this file's combined output would mask them).
cmd=foreground:seq=17:exec=ze completion bash:exit=0
expect=stdout:contains=pipe
