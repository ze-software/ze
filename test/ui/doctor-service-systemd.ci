# Test: ze doctor reports invalid installed systemd service readiness
# VALIDATES: doctor-service-user, doctor-service-group, and doctor-service-executable expose service install failures.

option=env:var=ze.test.doctor.service-unit:value=ze.service

tmpfs=ze.service:terminator=EOF_UNIT
[Unit]
Description=Ze Network OS

[Service]
User=ze-doctor-missing-user
Group=ze-doctor-missing-group
ExecStart=/definitely/missing/ze start
EOF_UNIT

tmpfs=empty.conf:terminator=EOF_CONF
# empty config
EOF_CONF

cmd=foreground:seq=1:exec=ze doctor --json empty.conf
expect=exit:code=1
expect=stdout:contains=doctor-service-user
expect=stdout:contains=doctor-service-group
expect=stdout:contains=doctor-service-executable
