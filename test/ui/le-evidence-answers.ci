# Test: the built le binary runs the evidence and deployment commands end to
# accept-only: the registered native fixture enforces this scenario's behavioral contract
# end and renders their answers through the shared pipe operators.
#
# The timeout is declared because a cold build cache makes the first cmd/ze
# compilation substantially slower than steady-state runs.

option=timeout:value=240s

cmd=foreground:seq=1:exec=ze-test fixture ui/le-evidence-answers
expect=exit:code=0
expect=stdout:contains=OK
