# Test: `show bgp peer <selector> statistics` and `... capabilities` answer ONE
# shape whatever the number of peers the selector matched.
#
# VALIDATES: spec-cli-show-bgp-answer-shapes AC-8, AC-9, AC-10. One matched peer
#   answers rows in the spelling several matched peers use, and `| count`
#   answers 1 over that answer.
# PREVENTS: an answer whose shape follows its input. Both handlers answered a
#   flat object for one matched peer and an array for several, so
#   `show bgp peer * statistics | count` answered on a router with several peers
#   and was refused on a router with one. No declaration can describe an answer
#   of two shapes, which is why neither command declared one.
#
# The daemon runs with an ephemeral SSH listener; ZE_SSH_* carry the credentials
# `ze cli` has no flags for. The peers never establish, and nothing here needs
# them to: a row is built for every matched peer whatever its state.
#
# The timeout is DECLARED because this file starts a daemon and launches `ze`
# several times, which a first (cold) run or a loaded host can take past the
# runner's derived bound while every assertion still holds.
option=timeout:value=60s

tmpfs=run.py:terminator=EOF_PY
import json
import os
import subprocess

from ze_api import wait_until


def require(condition, message):
    if not condition:
        raise SystemExit(message)


def run(argv, env):
    r = subprocess.run(argv, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, env=env, check=False)
    return r.returncode, r.stdout, r.stderr


password_hash = subprocess.check_output(['ze', 'passwd'], input='secret\n', text=True).strip()
with open('rows.conf', 'w', encoding='utf-8') as fh:
    fh.write('''bgp {
    router-id 192.0.2.254
    session {
        asn {
            local 65000
        }
    }
    peer peer1 {
        connection {
            remote {
                ip 192.0.2.1
            }
            local {
                ip 127.0.0.1
            }
        }
        session {
            asn {
                remote 65001
            }
        }
    }
    peer peer2 {
        connection {
            remote {
                ip 192.0.2.2
            }
            local {
                ip 127.0.0.1
            }
        }
        session {
            asn {
                remote 65002
            }
        }
    }
}

system {
    authentication {
        user ci {
            password "''' + password_hash + '''"
            profile [ admin ]
        }
    }
}
''')

daemon_env = os.environ.copy()
daemon_env['ZE_SSH_EPHEMERAL'] = os.path.abspath('ssh.addr')
daemon_env['ZE_READY_FILE'] = os.path.abspath('ready')
daemon_env['ZE_CONFIG_DIR'] = os.getcwd()
# Leave port 179 alone: this suite runs unprivileged and a bind failure there
# takes the daemon down before it writes `ready`.
daemon_env['ze_test_bgp_port'] = str(12000 + os.getpid() % 40000)
daemon = subprocess.Popen(['ze', '-f', 'rows.conf'], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, env=daemon_env)


def daemon_ready():
    if daemon.poll() is not None:
        out, err = daemon.communicate()
        raise SystemExit('daemon exited early\nstdout:\n' + out + '\nstderr:\n' + err)
    return os.path.exists('ssh.addr') and os.path.exists('ready')


try:
    if not wait_until(daemon_ready, attempts=200, delay=0.1):
        raise SystemExit('daemon did not become ready')

    host, port = open('ssh.addr', encoding='utf-8').read().strip().rsplit(':', 1)
    cli_env = os.environ.copy()
    cli_env.update({
        'ZE_SSH_HOST': host,
        'ZE_SSH_PORT': port,
        'ZE_SSH_USERNAME': 'ci',
        'ZE_SSH_PASSWORD': 'secret',
        'ZE_CONFIG_DIR': os.getcwd(),
    })

    def cli(command):
        code, out, err = run(['ze', 'cli', '-c', command], cli_env)
        require(code == 0, '%s exit=%d: %s%s' % (command, code, out, err))
        return out

    def rows_of(command):
        # `| json` unwraps a single-key envelope holding an array, so the rows
        # arrive as a bare array on both surfaces and for both cardinalities.
        text = cli(command + ' | json compact')
        parsed = json.loads(text)
        require(isinstance(parsed, list), '%s did not answer rows: %r' % (command, text))
        return parsed

    def count_of(command):
        # `| count` answers {"count": N}. With no format operator the default
        # rendering unwraps a single-key answer to its value, so the text is the
        # bare number. Both spellings are the same answer.
        text = cli(command + ' | count')
        parsed = json.loads(text)
        if isinstance(parsed, dict):
            return int(parsed['count'])
        return int(parsed)

    for command, address_key in (('show bgp peer %s statistics', 'address'),
                                 ('show bgp peer %s capabilities', 'peer')):
        several = rows_of(command % '*')
        one = rows_of(command % '192.0.2.1')

        # The several-peer answer is asserted too, so a later change that moved
        # BOTH branches to one new shape cannot pass on the equalities alone.
        require(len(several) == 2, '%s matched %d peers, want 2' % (command % '*', len(several)))
        require(sorted(row[address_key] for row in several) == ['192.0.2.1', '192.0.2.2'],
                '%s lost a peer row: %r' % (command % '*', several))

        # AC-8, AC-10: one matched peer answers rows, in the same spelling.
        require(len(one) == 1, '%s answered %d rows, want 1' % (command % '192.0.2.1', len(one)))
        require(one[0][address_key] == '192.0.2.1', '%s named the wrong peer: %r' % (command, one))
        require(sorted(one[0]) == sorted(several[0]),
                'one matched peer answers different fields: %r vs %r' % (sorted(one[0]), sorted(several[0])))

        # AC-9: the row operator answers rather than refusing. It was refused on
        # a one-peer answer, because a flat object holds no rows.
        require(count_of(command % '*') == 2, '`| count` over two peers: %r' % (command % '*'))
        require(count_of(command % '192.0.2.1') == 1, '`| count` over one peer: %r' % (command % '192.0.2.1'))

        # A second row operator, so the fix is not read as a property of
        # `count` alone. A chain that filters carries its provenance back under
        # "pipe", so the answer holds two keys and `| json` leaves the envelope
        # in place. The rows are still under "peers", which is the point.
        #
        # WHICH peer survives is not asserted, and deliberately: the rows arrive
        # in the order reactorAPIAdapter.Peers ranges its peer map
        # (internal/component/bgp/reactor/reactor_api.go), and Go randomises map
        # iteration, so an array-shaped peer answer comes back in a different
        # order on every call. That defect is recorded in the journal class
        # output-not-byte-stable, and this file must not pin an order the
        # product does not promise.
        answered = json.loads(cli((command % '*') + ' | first 1 | json compact'))
        first = answered['peers'] if isinstance(answered, dict) else answered
        require(len(first) == 1, '`| first 1` did not answer one row: %r' % (answered,))
        require(first[0][address_key] in ('192.0.2.1', '192.0.2.2'),
                '`| first 1` answered a peer that is not configured: %r' % (answered,))
finally:
    daemon.terminate()
    try:
        daemon.wait(timeout=5)
    except subprocess.TimeoutExpired:
        daemon.kill()
        daemon.wait(timeout=5)

print('OK')
EOF_PY

cmd=foreground:seq=1:exec=python3 run.py
expect=exit:code=0
expect=stdout:contains=OK
