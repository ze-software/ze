# Test: ze config completion — empty config file
# VALIDATES: Completion works even with minimal/empty config

tmpfs=test.conf:terminator=EOF_CONF
bgp {
  router-id 203.0.113.253
  session {
    asn {
      local 65000
    }
  }
}
EOF_CONF

cmd=foreground:seq=1:exec=ze config completion test.conf
expect=exit:code=0
expect=stdout:contains=set
expect=stdout:contains=edit
