# Test: web commit rejection preserves running config
# accept-only: the registered native fixture enforces this scenario's behavioral contract
# VALIDATES: AC-4 -- Web commit failure clears the candidate, leaves active unchanged, and returns an HTTP error.
# PREVENTS: web commit saving a rejected candidate before runtime reload accepts it.

option=env:var=ze.config.dir:value=.
option=timeout:value=20s

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# The reject plugin participates in the bgp-root reload purely through the
# top-level `external` declaration plus its bgp config declaration; that makes
# it a WantsConfig:["bgp"] reload participant. It is deliberately NOT bound as
# a per-peer `process { }`: a per-peer binding is dropped when the web editor
# re-serializes the candidate, which adds a bgp/peer/.../process removal to the
# diff. A peer-touching diff routes the reload through the operation path
# (decomposeBGPOperations), which only dispatches apply to operation owners and
# never calls a non-operation participant's OnConfigApply -- so the rejection
# would never fire. A router-id-only change keeps the reload on the full-diff
# apply path, where every participant's OnConfigApply runs and the reject fires.
tmpfs=web-commit-reject.conf:terminator=EOF_CONF
plugin {
    external web-commit-reject {
        run "ze-test fixture ui/web-commit-reject"
        encoder json
    }
}

bgp {
    router-id 1.2.3.4
    peer peer1 {
        connection {
            remote {
                ip 127.0.0.1
            }
            local {
                ip 127.0.0.1
                accept false
            }
        }
        session {
            asn {
                local 1
                remote 1
            }
            router-id 1.2.3.4
            family {
                ipv4/unicast { prefix { maximum 10000; } }
            }
        }
        behavior {
            group-updates disable
        }
    }
}
EOF_CONF

tmpfs=set-router-id.form:encoding=base64:terminator=EOF_SET
bGVhZj1yb3V0ZXItaWQmdmFsdWU9Mi4yLjIuMg==
EOF_SET

tmpfs=show-bgp.form:encoding=base64:terminator=EOF_SHOW
Y29tbWFuZD1zaG93K2JncA==
EOF_SHOW

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze start --web $PORT2 --insecure-web web-commit-reject.conf:timeout=20s

http=wait:seq=1:url=https://127.0.0.1:$PORT2/config/edit/:status=200:contains=bgp:insecure-tls=true:timeout=15s
http=post:seq=2:url=https://127.0.0.1:$PORT2/config/set/bgp/:status=200:sendfile=set-router-id.form:content-type=application/x-www-form-urlencoded:insecure-tls=true
http=post:seq=3:url=https://127.0.0.1:$PORT2/config/commit/:status=500:contains=web test apply rejected:insecure-tls=true
http=post:seq=4:url=https://127.0.0.1:$PORT2/cli:status=200:contains=1.2.3.4:sendfile=show-bgp.form:content-type=application/x-www-form-urlencoded:insecure-tls=true
