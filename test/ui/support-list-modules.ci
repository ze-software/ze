# Test: ze support --list-modules lists all registered modules
# VALIDATES: AC-4 of spec-support.md -- module discovery from registry
cmd=foreground:seq=1:exec=ze support --list-modules
expect=exit:code=0
expect=stdout:contains="version"
expect=stdout:contains="doctor"
expect=stdout:contains="host"
expect=stdout:contains="config"
expect=stdout:contains="crashes"
expect=stdout:contains="disk"
expect=stdout:contains="interfaces"
expect=stdout:contains="routes"
expect=stdout:contains="neighbors"
expect=stdout:contains="env"
expect=stdout:contains="sysctl"
expect=stdout:contains="runtime"
expect=stdout:contains="dmesg"
expect=stdout:contains="sockets"
expect=stdout:contains="modules"
expect=stdout:contains="conntrack"
expect=stdout:contains="fds"
expect=stdout:contains="dns"
expect=stdout:contains="firewall"
