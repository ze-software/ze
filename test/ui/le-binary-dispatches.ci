# Test: the BUILT le binary dispatches registered commands, renders shared pipe
#       operators, and permanently holds the completed 158-gate native cutover.
#
# VALIDATES: spec-le-is-a-ze-binary AC-1 and AC-7, against the artifact a
#            developer runs rather than against a package.
# PREVENTS: a green package suite over a binary that does not compose. Every Go
#           test in internal/le exercises a PACKAGE; between them and this file sit
#           the build, the composition root and argv handling, which is exactly
#           where a stale or mis-composed binary fails (R-4).
#
# The binary is compiled here rather than by the runner, which builds only ze
# and ze-test (internal/test/runner/runner.go, setupBinShims). It is written
# into the test's own directory, so nothing is written back into the checkout.
#
# The timeout is DECLARED because a cold build cache makes the first compile of
# the cmd/ze le personality far slower than the steady state.

option=timeout:value=180s

tmpfs=run.py:terminator=EOF_PY
"""Compile le, then drive it the way a developer does."""
import json
import os
import subprocess
import sys


def require(condition, message):
    if not condition:
        raise SystemExit(f'FAIL: {message}')


root = os.environ['ZE_REPO_ROOT']
binary = os.path.join(os.getcwd(), 'le')

compiled = subprocess.run(
    ['make', '--no-print-directory', 'le-build', f'ZE_BIN_DIR={os.path.dirname(binary)}'],
    cwd=root, capture_output=True, text=True, check=False,
)
require(compiled.returncode == 0, f'compiling the cmd/ze le personality failed: {compiled.stderr}')


def le(*args):
    return subprocess.run([binary, *args], capture_output=True, text=True, check=False)


# The usage page is the composition root read back: a tool that failed to
# register is a tool missing from this list.
usage = le('--help')
require(usage.returncode == 0, f'le --help exited {usage.returncode}')
require('parity' in usage.stderr + usage.stdout, 'le --help does not list the parity command')
require('token-economy' in usage.stderr + usage.stdout,
        'le --help does not list the token-economy command')

# The census answers structured data, and `| json` renders it with no
# per-tool JSON code anywhere in the tool.
answer = le('parity', '|', 'json')
try:
    census = json.loads(answer.stdout)
except json.JSONDecodeError as exc:
    raise SystemExit(f'FAIL: `le parity | json` did not answer JSON: {exc}\n{answer.stdout}') from exc

for key in ('gates', 'converted', 'forked', 'unported', 'unported-gates',
            'forked-gates', 'unknown-claims', 'unwired-claims', 'command-names',
            'script-files', 'script-files-by-language', 'script-dirs'):
    require(key in census, f'the census answered no {key!r} key: {sorted(census)}')
require(census['gates'] > 0, 'the census found no gate on the Python side')

# Converted, forked and unported still partition the gate population. The
# completed native cutover additionally pins every residual count and name list
# to zero, so a reopened migration cannot hide behind correct arithmetic.
require(census['converted'] + census['forked'] + census['unported'] == census['gates'],
        f"converted {census['converted']} + forked {census['forked']} + unported "
        f"{census['unported']} != {census['gates']} gates")
require(census['converted'] == census['gates'],
        f"converted {census['converted']} != {census['gates']} gates")
require(census['unported'] == 0, f"the census reports {census['unported']} unported gates")
require(census['forked'] == 0, f"the census reports {census['forked']} forked gates")
require(census['unported-gates'] == [],
        f"the census names unported gates: {census['unported-gates']}")
require(census['forked-gates'] == [],
        f"the census names forked gates: {census['forked-gates']}")
require(census['unknown-claims'] == [],
        f"the census names unknown claims: {census['unknown-claims']}")
require(census['unwired-claims'] == [],
        f"the census names unwired claims: {census['unwired-claims']}")

# The second population: the code still sitting under scripts/, derived from
# the filesystem rather than claimed by anybody.
require(sum(census['script-files-by-language'].values()) == census['script-files'],
        'the per-language counts do not sum to the file total')
require(sum(census['script-dirs'].values()) == census['script-files'],
        'the per-directory counts do not sum to the file total')

# The gate migration is complete, but code files under scripts/ are a second
# population. Their presence alone keeps parity red, so derive the expected exit
# from all three migration counts rather than pinning it to a constant.
want = 0 if (census['unported'] == 0 and census['forked'] == 0
             and census['script-files'] == 0) else 1
require(answer.returncode == want,
        f"`le parity` exited {answer.returncode} with {census['unported']} unported, "
        f"{census['forked']} forked and {census['script-files']} script files, want {want}")

# One payload, three renderings. Neither of these two passes through a line of
# tool-owned formatting code.
for operator, needle in (('yaml', 'gates:'), ('table', 'gates')):
    rendered = le('parity', '|', operator)
    require(needle in rendered.stdout,
            f'`le parity | {operator}` did not render the payload: {rendered.stdout[:200]!r}')

# ---- the perf nudge --------------------------------------------------------
# A NUDGE, never a gate: it always exits 0, and the one thing it may never do is
# block the build the developer is in the middle of.
listing = le('perf-bench', '|', 'json')
require(listing.returncode == 0, f'`le perf-bench | json` exited {listing.returncode}')
verbs = {row['verb'] for row in json.loads(listing.stdout)['actions']}
require('ze-perf-suggestion-report' in verbs,
        f'the perf-bench area lost the gate name every Make target spells: {sorted(verbs)}')
require('record' in verbs, f'the perf-bench area lists no record verb: {sorted(verbs)}')

nudge = le('perf-bench', 'ze-perf-suggestion-report', '|', 'json')
require(nudge.returncode == 0,
        f'the perf nudge exited {nudge.returncode}; it is advisory and never blocks')
report = json.loads(nudge.stdout)
require('origin' in report, f'the nudge answered no origin: {sorted(report)}')

# ---- the source-anchor reverse index ---------------------------------------
# The MIRROR of the design-doc index, in the same area. Its two gates keep their
# whole names as verbs, because leaction removes `ze-docs-to-code-` and a
# ze-doc-index- gate carries no such prefix.
docs = le('docs-to-code', '|', 'json')
require(docs.returncode == 0, f'`le docs-to-code | json` exited {docs.returncode}')
docverbs = {row['verb'] for row in json.loads(docs.stdout)['actions']}
for verb in ('check', 'update', 'ze-doc-index-check', 'ze-doc-index-update'):
    require(verb in docverbs, f'the docs-to-code area lost {verb!r}: {sorted(docverbs)}')

anchors = le('docs-to-code', 'ze-doc-index-check', '|', 'json')
require(anchors.returncode in (0, 1),
        f'the anchor check exited {anchors.returncode}, want a verdict')
checked = json.loads(anchors.stdout)
require(checked['paths'] > 100,
        f"the anchor check read {checked['paths']} code paths, so it proved nothing")
require(checked['file'] == 'ai/CODE-TO-DOCS.md',
        f"the check names {checked['file']!r} rather than the index it is about")

# ---- the token-economy report ---------------------------------------------
# THE ONE TOOL WHOSE INPUT IS NOT THIS CHECKOUT. It reads the machine-local
# Claude Code transcript store, which is 1.4 GB on the machine it was ported on
# and absent on a fresh one, so this test builds a store of its own and points
# the command at it. Reading the developer's real store here would make the
# runtime a property of whoever runs the suite.
store = os.path.join(os.getcwd(), 'store', '-fixture')
os.makedirs(store, exist_ok=True)
call = {
    'type': 'assistant', 'session_id': 'fix00001', 'sessionId': 'fix00001',
    'message': {
        'id': 'msg_1',
        'usage': {
            'input_tokens': 10, 'cache_creation_input_tokens': 20,
            'cache_read_input_tokens': 120000, 'output_tokens': 30,
        },
        'content': [{'type': 'tool_use', 'id': 'toolu_1', 'name': 'Read',
                     'input': {'file_path': 'internal/a.go'}}],
    },
}
result = {'type': 'user', 'message': {'content': [
    {'type': 'tool_result', 'tool_use_id': 'toolu_1', 'content': 'x' * 3600}]}}
with open(os.path.join(store, 'fix00001.jsonl'), 'w') as handle:
    # The SAME call written twice, which is how one API call reaches a
    # transcript. A report that counted records would say two.
    handle.write(json.dumps(call) + '\n')
    handle.write(json.dumps(call) + '\n')
    handle.write(json.dumps(result) + '\n')

fixture = ['token-economy', 'root', os.path.dirname(store), 'project', '-fixture']

economy = le(*fixture)
require(economy.returncode == 0,
        f'`le token-economy` exited {economy.returncode}; it is a report and never blocks')
require('API calls: 1' in economy.stdout,
        f'two records of one call were not deduped:\n{economy.stdout}')
require('Store: ' + store in economy.stdout,
        f'the report does not name the corpus it read:\n{economy.stdout}')

economy_json = le(*fixture, '|', 'json')
require(economy_json.returncode == 0,
        f'`le token-economy | json` exited {economy_json.returncode}')
payload = json.loads(economy_json.stdout)
for key in ('state', 'store', 'project', 'totals', 'histogram', 'capped', 'cap', 'top'):
    require(key in payload, f'the report answered no {key!r} key: {sorted(payload)}')
require(payload['totals']['calls'] == 1,
        f"the payload counted {payload['totals']['calls']} calls, want 1")
require(payload['state'] == 'ok', f"the payload state is {payload['state']!r}, want 'ok'")

# An absent store is SAID, never reported as a table of zeros: that would read
# as "this work is free".
absent = le('token-economy', 'root', os.getcwd(), 'project', '-nothing-here')
require(absent.returncode == 0, f'an absent store exited {absent.returncode}, want 0')
require('Found no transcript store there' in absent.stdout,
        f'an absent store did not say so:\n{absent.stdout}')

# A bound the caller passes is enforced rather than clamped.
refused = le('token-economy', 'cap', '0')
require(refused.returncode != 0, 'a cap below the bound was accepted')

# An unknown command is the caller's error and is refused, never guessed at.
unknown = le('no-such-tool')
require(unknown.returncode != 0, 'le accepted a command nobody registered')

print('OK')
EOF_PY

cmd=foreground:seq=1:exec=python3 run.py
expect=exit:code=0
expect=stdout:contains=OK
