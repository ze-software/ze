# Test: ze bgp decode pcap refuses a path and a dash together
# VALIDATES: spec-bgp-pcap-decode AC-17 -- the rejection happens at argument
# parsing and names both inputs, so the operator never meets the internal
# stdin-already-claimed error.
# Exercises: cmdDecode -> decodePcapInput, the argument count guard

cmd=foreground:seq=1:exec=ze bgp decode pcap session.pcap -
expect=exit:code=1
expect=stderr:contains=session.pcap
