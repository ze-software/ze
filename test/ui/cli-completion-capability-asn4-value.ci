# Test: ze config completion — capability asn4 mode value
# VALIDATES: asn4 is a capability-mode leaf whose completions are the four modes

tmpfs=test.conf:terminator=EOF_CONF
bgp {
	router-id 1.2.3.4
	session {
		asn {
			local 65000
		}
	}
	peer peer1 {
		connection {
			remote {
				ip 1.1.1.1
			}
			local {
				ip 127.0.0.1
			}
		}
		session {
			asn {
				remote 65001
			}
		}
	}
}
EOF_CONF

cmd=foreground:seq=1:exec=ze config completion --context bgp/peer/peer1/session/capability --input set+asn4+ test.conf
expect=exit:code=0
expect=stdout:contains=enable
expect=stdout:contains=disable
expect=stdout:contains=require
expect=stdout:contains=refuse
reject=stdout:pattern=true
