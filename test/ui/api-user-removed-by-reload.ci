# Test: REST users come from zefs and system.authentication independently of SSH,
#       keep strict AAA profiles, and follow live reloads.
# VALIDATES: AC-1, AC-2, AC-6, and AC-12 of
#            spec-hub-deferred-api-auth-independent-of-ssh-block.
# PREVENTS: API authentication and no-BGP AAA depending on environment.ssh,
#           config collisions retaining zefs credentials or recovery authority,
#           rebuilt authenticators reviving removed users, and authorization
#           profiles remaining pinned to the boot store after reload.
#
# One config-only boot proves AC-1 and AC-2 with no zefs database. Two further
# boots discriminate the zefs/config producer in runYANGConfig: distinct names,
# then a collision followed by boot-built and reload-built authenticator checks.
# None of the configs contains BGP or SSH.

option=timeout:value=120s

tmpfs=api-user-reload-check.py:mode=755:terminator=EOF_PY
#!/usr/bin/env python3
"""Drive REST authentication, strict authorization, and reload stages."""
import json
import os
import sys
import urllib.error
import urllib.request

from ze_api import wait_until

BASE_PATH = '/api/v1'


def request_status(port, user, password, command=None):
    if command is None:
        path = '/commands'
        data = None
    else:
        path = '/execute'
        data = json.dumps({'command': command}).encode('utf-8')
    req = urllib.request.Request(f'http://127.0.0.1:{port}{BASE_PATH}{path}', data=data)
    req.add_header('Authorization', f'Bearer {user}:{password}')
    if data is not None:
        req.add_header('Content-Type', 'application/json')
    try:
        return urllib.request.urlopen(req, timeout=5).status
    except urllib.error.HTTPError as err:
        return err.code
    except (urllib.error.URLError, ConnectionRefusedError, OSError):
        return None


def require(condition, message):
    if not condition:
        print('FAIL: ' + message, file=sys.stderr)
        raise SystemExit(1)
    print('OK: ' + message, file=sys.stderr)


def reload_generation():
    try:
        with open('reload.log', encoding='utf-8') as log:
            return log.read().count('sighup reload complete')
    except OSError:
        return 0


def main():
    stage = sys.argv[1]
    port1 = os.environ['ZE_REST_PORT']
    port2 = os.environ['ZE_REST_PORT2']
    expected_generation = {
        'boot-site': 1,
        'rebuilt': 2,
        'reload-site': 3,
    }.get(stage)
    if expected_generation is not None:
        require(wait_until(lambda: reload_generation() >= expected_generation,
                           attempts=60, delay=0.5),
                f'reload generation {expected_generation} completed')


    if stage == 'config-only':
        require(wait_until(lambda: request_status(port1, 'configuser', 'configpass') == 200,
                           attempts=60, delay=0.5),
                'a config user authenticates with no zefs, BGP, or SSH')
        require(request_status(port1, 'configuser', 'wrongpass') == 401,
                'a wrong config-user password is refused')
        require(request_status(port1, 'configuser', 'configpass', 'show version') == 200,
                'the config user can run the command their profile allows')
        denied_status = request_status(port1, 'configuser', 'configpass', 'show system goroutines summary')
        require(denied_status == 403,
                f'the config user is denied a command outside their profile (status {denied_status})')
        return

    if stage == 'distinct':
        require(wait_until(lambda: request_status(port1, 'configuser', 'configpass') == 200,
                           attempts=60, delay=0.5),
                'the distinct config user authenticates beside the zefs user')
        require(request_status(port1, 'poweruser', 'powerpass', 'show system goroutines summary') == 200,
                'the distinct zefs user executes through the recovery profile')
        return

    if stage == 'collision':
        collision_ready = wait_until(lambda: request_status(port1, 'poweruser', 'collisionpass') == 200,
                                     attempts=60, delay=0.5)
        collision_status = request_status(port1, 'poweruser', 'collisionpass')
        require(collision_ready,
                f'the colliding config credential wins at boot (status {collision_status})')
        require(request_status(port1, 'poweruser', 'powerpass') == 401,
                'the colliding zefs credential loses at boot')
        require(request_status(port1, 'poweruser', 'collisionpass', 'show version') == 200,
                'the colliding config user keeps their assigned allow rule')
        require(request_status(port1, 'poweruser', 'collisionpass', 'show system goroutines summary') == 403,
                'the colliding config user does not inherit zefs recovery authority')
        require(request_status(port1, 'bootuser', 'bootpass') == 200,
                'the boot-built authenticator admits an ordinary config user')
        return
    if stage == 'reload-boot':
        require(wait_until(lambda: request_status(port1, 'bootuser', 'bootpass') == 200,
                           attempts=60, delay=0.5),
                'the reload daemon starts from its config user source')
        require(request_status(port1, 'reloaduser', 'reloadpass') == 200,
                'the reload daemon admits the user that later reloads remove')
        require(request_status(port1, 'keepuser', 'keeppass', 'show version') == 200,
                'the unchanged user can run the probe command before profile reload')
        return


    if stage == 'boot-site':
        require(wait_until(lambda: request_status(port1, 'bootuser', 'bootpass') == 401,
                           attempts=60, delay=0.5),
                'the boot-built authenticator refuses a removed user')
        require(request_status(port1, 'newuser', 'newpass') == 200,
                'the boot-built authenticator sees a user added through the live provider')
        require(request_status(port1, 'reloaduser', 'reloadpass') == 200,
                'an unchanged user still authenticates after reload')
        require(request_status(port1, 'keepuser', 'keeppass') == 200,
                'the unchanged user still authenticates after their profile reload')
        require(request_status(port1, 'keepuser', 'keeppass', 'show version') == 403,
                'the unchanged user loses the probe command after profile reload')
        require(request_status(port1, 'poweruser', 'collisionpass') == 200,
                'the live provider admits a config user added by reload')
        require(request_status(port1, 'poweruser', 'powerpass') == 401,
                'the config-only reload does not gain a zefs credential')
        return

    if stage == 'rebuilt':
        rebuilt_ready = wait_until(lambda: request_status(port2, 'newuser', 'newpass') == 200,
                                   attempts=60, delay=0.5)
        port2_status = request_status(port2, 'newuser', 'newpass')
        port1_status = request_status(port1, 'newuser', 'newpass')
        require(rebuilt_ready,
                f'the moved listener proves the API authenticator was rebuilt from live users '
                f'(new status {port2_status}, old status {port1_status})')
        require(request_status(port2, 'reloaduser', 'reloadpass') == 200,
                'the rebuilt authenticator admits the current config user')
        require(request_status(port2, 'bootuser', 'bootpass') == 401,
                'the rebuilt authenticator does not revive the removed user')
        return

    require(wait_until(lambda: request_status(port2, 'reloaduser', 'reloadpass') == 401,
                       attempts=60, delay=0.5),
            'the reload-built authenticator refuses a later removed user')
    require(request_status(port2, 'keepuser', 'keeppass') == 200,
            'an unchanged user remains admitted by the reload-built authenticator')
    require(request_status(port2, 'newuser', 'newpass') == 200,
            'the user added by reload remains admitted')


if __name__ == '__main__':
    main()
EOF_PY

tmpfs=test-api-user-reload.sh:mode=755:terminator=EOF_SH
#!/bin/sh
set -e

ZE_DISTINCT_DIR=$(mktemp -d)
ZE_COLLISION_DIR=$(mktemp -d)
ZE_RELOAD_DIR=$(mktemp -d)
CONFIG_ONLY_DIR=$(mktemp -d)
DAEMON_PID=""
cleanup() {
	if [ -n "$DAEMON_PID" ]; then
		kill "$DAEMON_PID" 2>/dev/null || true
		wait "$DAEMON_PID" 2>/dev/null || true
	fi
	rm -rf "$ZE_DISTINCT_DIR" "$ZE_COLLISION_DIR" "$ZE_RELOAD_DIR" "$CONFIG_ONLY_DIR"
}
trap cleanup EXIT

ZE_REST_PORT=$((19500 + ($$ % 400)))
ZE_REST_PORT2=$((19950 + ($$ % 400)))
export ZE_REST_PORT ZE_REST_PORT2

CONFIGHASH=$(printf 'configpass\n' | ze passwd)
COLLISIONHASH=$(printf 'collisionpass\n' | ze passwd)
BOOTHASH=$(printf 'bootpass\n' | ze passwd)
RELOADHASH=$(printf 'reloadpass\n' | ze passwd)
KEEPHASH=$(printf 'keeppass\n' | ze passwd)
NEWHASH=$(printf 'newpass\n' | ze passwd)


cat > api-on-port1.conf << ZEAPI
api-server {
	rest {
		enabled true
		server main { ip 127.0.0.1; port $ZE_REST_PORT; }
	}
}
ZEAPI

cat > api-on-port2.conf << ZEAPI
api-server {
	rest {
		enabled true
		server main { ip 127.0.0.1; port $ZE_REST_PORT2; }
	}
}
ZEAPI

: > api-absent.conf

write_system() {
	cat > "$1" << ZESYSTEM
system {
	authentication {
$2
	}
	authorization {
		profile api-limited {
			run {
				default-action deny
				entry 10 { action allow; match "show version"; }
			}
			edit { default-action deny; }
		}
		profile api-denied {
			run { default-action deny; }
			edit { default-action deny; }
		}
	}
}
ZESYSTEM
}

user_entry_profile() {
	printf '\t\tuser %s { password "%s"; profile [ %s ]; }\n' "$1" "$2" "$3"
}

user_entry() {
	user_entry_profile "$1" "$2" api-limited
}

CONFIG_ONLY_USERS="$(user_entry configuser "$CONFIGHASH")"
DISTINCT_USERS="$(user_entry configuser "$CONFIGHASH")
$(user_entry bootuser "$BOOTHASH")
$(user_entry reloaduser "$RELOADHASH")
$(user_entry keepuser "$KEEPHASH")"
COLLISION_USERS="$(user_entry poweruser "$COLLISIONHASH")
$(user_entry bootuser "$BOOTHASH")
$(user_entry reloaduser "$RELOADHASH")
$(user_entry keepuser "$KEEPHASH")"
NO_BOOT_USERS="$(user_entry poweruser "$COLLISIONHASH")
$(user_entry reloaduser "$RELOADHASH")
$(user_entry_profile keepuser "$KEEPHASH" api-denied)
$(user_entry newuser "$NEWHASH")"
KEEP_ONLY_USERS="$(user_entry poweruser "$COLLISIONHASH")
$(user_entry_profile keepuser "$KEEPHASH" api-denied)
$(user_entry newuser "$NEWHASH")"

write_system users-config-only.conf "$CONFIG_ONLY_USERS"
write_system users-distinct.conf "$DISTINCT_USERS"
write_system users-collision.conf "$COLLISION_USERS"
write_system users-no-boot.conf "$NO_BOOT_USERS"
write_system users-keep-only.conf "$KEEP_ONLY_USERS"

write_config() {
	cat "$1" > api-user-reload.conf
	if [ -s "$2" ]; then
		cat >> api-user-reload.conf << ZEENV

environment {
ZEENV
		cat "$2" >> api-user-reload.conf
		cat >> api-user-reload.conf << ZEENV
}
ZEENV
	fi
}

stop_daemon() {
	if [ -n "$DAEMON_PID" ]; then
		kill -TERM "$DAEMON_PID" 2>/dev/null || true
		wait "$DAEMON_PID" 2>/dev/null || true
		DAEMON_PID=""
	fi
}

start_daemon() {
	stage=$1
	log=$2
	config_dir=$3
	rm -f daemon.ready
	ZE_READY_FILE="$PWD/daemon.ready" ZE_CONFIG_DIR="$config_dir" ze start api-user-reload.conf 2>"$log" &
	DAEMON_PID=$!
	if ! ./api-user-reload-check.py "$stage"; then
		echo "--- $log ---" >&2
		cat "$log" >&2
		exit 1
	fi
	i=0
	while [ ! -f daemon.ready ] && [ $i -lt 300 ]; do
		sleep 0.1
		i=$((i + 1))
	done
	if [ ! -f daemon.ready ]; then
		echo "FAIL: daemon never became ready" >&2
		cat "$log" >&2
		exit 1
	fi
}

reload_and_check() {
	kill -HUP "$DAEMON_PID"
	if ! ./api-user-reload-check.py "$1"; then
		echo "--- reload.log ---" >&2
		tail -n 10 reload.log >&2
		exit 1
	fi
}

# Boot 0: config-only REST and strict AAA, with no zefs database.
write_config users-config-only.conf api-on-port1.conf
start_daemon config-only config-only.log "$CONFIG_ONLY_DIR"
case "$(cat config-only.log)" in
	*"API auth mode: per-user (1 users)"*) ;;
	*) echo "FAIL: config-only boot did not publish the API auth profile" >&2; cat config-only.log >&2; exit 1 ;;
esac
stop_daemon

# Seed the real zefs producer for the distinct-name boot.
printf 'poweruser\npowerpass\n127.0.0.1\n2222\n' | ZE_CONFIG_DIR="$ZE_DISTINCT_DIR" ze init >/dev/null

# Boot 1: actual runYANGConfig merge with distinct zefs/config names.
write_config users-distinct.conf api-on-port1.conf
start_daemon distinct distinct.log "$ZE_DISTINCT_DIR"
case "$(cat distinct.log)" in
	*"API auth mode: per-user (5 users)"*) ;;
	*) echo "FAIL: distinct boot did not publish the merged API profile" >&2; cat distinct.log >&2; exit 1 ;;
esac
stop_daemon

# Boot 2: use a fresh zefs database so its active config pointer cannot
# override the collision fixture written for this boot.
printf 'poweruser\npowerpass\n127.0.0.1\n2222\n' | ZE_CONFIG_DIR="$ZE_COLLISION_DIR" ze init >/dev/null
write_config users-collision.conf api-on-port1.conf
start_daemon collision collision.log "$ZE_COLLISION_DIR"
case "$(cat collision.log)" in
	*"API auth mode: per-user (4 users)"*) ;;
	*) echo "FAIL: collision boot did not publish the deduplicated API profile" >&2; cat collision.log >&2; exit 1 ;;
esac
stop_daemon

# Boot 3: a fresh filesystem-backed config source exercises live reloads
# without a blob-store active pointer overriding the rewritten test file.
write_config users-distinct.conf api-on-port1.conf
start_daemon reload-boot reload.log "$ZE_RELOAD_DIR"

# Reload 1 removes bootuser, adds newuser, changes keepuser from the allowing
# profile to the denying profile, and removes api-server. The boot-built
# authenticator and authorizer must answer from the refreshed running state.
write_config users-no-boot.conf api-absent.conf
reload_and_check boot-site

# Reload 2 restores api-server on another port. The move proves UpdateAuth ran.
write_config users-no-boot.conf api-on-port2.conf
reload_and_check rebuilt

# Reload 3 removes reloaduser while leaving api-server absent. The authenticator
# installed by reload 2 must keep reading the live provider.
write_config users-keep-only.conf api-absent.conf
reload_and_check reload-site

stop_daemon
exit 0
EOF_SH

cmd=foreground:seq=1:exec=./test-api-user-reload.sh:timeout=120s
expect=exit:code=0
