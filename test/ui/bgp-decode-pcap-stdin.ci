# Test: ze bgp decode pcap - reads the capture from standard input
# VALIDATES: spec-bgp-pcap-decode AC-15 -- the piped capture decodes like the
# same capture given as a path. The "-" is handled at the CLI edge through
# internal/core/cliio, which is the scanned surface ./le dash-stdio check reads.
# Exercises: cmdDecode -> decodePcapInput -> cliio.OpenReader -> pcap.Reassemble

stdin=capture:

cmd=foreground:seq=1:exec=ze bgp decode pcap -:stdin=capture
expect=exit:code=0
expect=stdout:contains=KEEPALIVE
expect=stdout:contains=65000
