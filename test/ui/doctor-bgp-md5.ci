# Test: ze doctor --json warns about BGP MD5 on non-supporting platforms
# VALIDATES: AC-4 BGP MD5 platform detection emits doctor-bgp-md5.
#
# The peer carries `connection local ip` and `prefix { maximum }` because the
# BGP engine requires both ("local ip is required (use IP address or \"auto\")",
# PeersFromConfigTree). Without them this fixture was a config the daemon
# refuses to start on, and the test still asserted exit 0 -- which passed only
# because `ze doctor` never ran the engine's peer resolution. It does now
# (checkBGPPeerConfig, internal/component/doctor/checks_config.go). Fixing the
# config keeps this test about what it is named for: MD5 platform detection.

option=skip-os:value=linux,freebsd

tmpfs=bgp-md5.conf:terminator=EOF_CONF
bgp {
    router-id 1.2.3.4
    session {
        asn {
            local 65000
        }
    }
    peer peer1 {
        connection {
            md5 {
                password testing123
            }
            local {
                ip 192.0.2.254
            }
            remote {
                ip 192.0.2.1
            }
        }
        session {
            asn {
                remote 65001
            }
            family {
                ipv4/unicast {
                    prefix {
                        maximum 10000
                    }
                }
            }
        }
    }
}
EOF_CONF

cmd=foreground:seq=1:exec=ze doctor --json bgp-md5.conf
expect=exit:code=0
expect=stdout:contains=doctor-bgp-md5
