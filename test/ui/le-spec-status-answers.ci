# Test: the BUILT le binary reports the spec inventory over the real checkout,
#       prints exactly what the script prints, and answers the same records.
#
# VALIDATES: spec-le-is-a-ze-binary AC-11 over the REAL TREE, and AC-7 for the
#            spec inventory, against the artifact a developer runs.
# PREVENTS: a port that agrees with the script on fixtures and disagrees on the
#           checkout. The page is a fixed-width table of ~230 rows carrying
#           values a fixture tree does not hold -- multi-byte prose in a Phase
#           cell, a real git date, a Depends chain -- and a column that moved
#           under one of them would pass every unit test.
#
# Both sides are compiled here rather than by the runner, which builds only ze
# and ze-test (internal/test/runner/runner.go, setupBinShims). Both binaries are
# written into the test's own directory, so nothing is written back into the
# checkout.
#
# The page comparison is BYTE for byte. Nothing in this tool's output varies
# between two runs: there is no timestamp, the sort is total, and both sides ask
# the same git for the same dates.
#
# The one race this checkout can lose is another session editing the spec tree
# between the two runs. A difference is therefore re-read from the SCRIPT before
# it is reported: two script runs that disagree with each other are the tree
# moving, not the port. The re-read costs a whole inventory, so it happens only
# when there is a difference to explain.
#
# The timeout is DECLARED because a cold build of cmd/le precedes four walks of
# the spec tree, each asking git for one date per spec.

option=timeout:value=300s

tmpfs=run.py:terminator=EOF_PY
"""Compile both sides of the migration and check that they agree."""
import json
import os
import subprocess
import sys


def require(condition, message):
    if not condition:
        raise SystemExit(f'FAIL: {message}')


root = os.environ['ZE_REPO_ROOT']
here = os.getcwd()
binary = os.path.join(here, 'le')
script = os.path.join(here, 'spec-status')

for args in (['go', 'build', '-o', binary, './cmd/le'],
             ['go', 'build', '-o', script, 'scripts/status/spec_status.go']):
    built = subprocess.run(args, cwd=root, capture_output=True, text=True,
                           check=False, env={**os.environ, 'CGO_ENABLED': '0'})
    require(built.returncode == 0, f'{" ".join(args)} failed: {built.stderr}')


def run(argv, cwd):
    return subprocess.run(argv, cwd=cwd, capture_output=True, text=True, check=False)


# The script, invoked the way the ze-spec-status target invokes it: from the
# repository root, because its plan/ glob is relative to the working directory.
first = run([script], root)
# The command, invoked the way a developer does. It takes no path: the tree is
# the checkout, so the answer does not change with the working directory.
new = run([binary, 'spec-status'], here)

if (first.stdout, first.stderr, first.returncode) != (new.stdout, new.stderr, new.returncode):
    # Explain a difference before reporting it. A second script run that
    # disagrees with the first is another session editing the spec tree, which
    # is a fact about the checkout rather than about the port.
    second = run([script], root)
    require(first.stdout == second.stdout and first.stderr == second.stderr,
            'the tree moved under the comparison: two runs of the script disagree')

require(first.returncode == new.returncode,
        f'the script exited {first.returncode} and the command exited {new.returncode}')
require(first.stderr == new.stderr,
        f'the warnings differ.\n--- script ---\n{first.stderr}\n--- command ---\n{new.stderr}')
require(first.stdout == new.stdout,
        'the page differs over the checkout:\n'
        + '\n'.join(f'  script:  {a!r}\n  command: {b!r}'
                    for a, b in zip(first.stdout.split('\n'), new.stdout.split('\n'))
                    if a != b)[:2000])
require(first.stdout.count('\n') > 100,
        f'the comparison ran over {first.stdout.count(chr(10))} lines, which is too few to mean anything')

# One payload, every rendering. Nothing in the tool writes a line of JSON.
old_json = run([script, '--json'], root)
new_json = run([binary, 'spec-status', '|', 'json'], here)
try:
    old_records = json.loads(old_json.stdout)
    new_records = json.loads(new_json.stdout)
except json.JSONDecodeError as exc:
    raise SystemExit(f'FAIL: a JSON answer did not decode: {exc}') from exc

require(old_records == new_records,
        f'the records differ: script {len(old_records)}, command {len(new_records)}')
require(len(new_records) > 50,
        f'{len(new_records)} records is too few for this checkout to mean anything')
for key in ('name', 'status', 'bucket', 'git-modified', 'stale'):
    require(key in new_records[0], f'a record carries no {key!r}: {sorted(new_records[0])}')

# A row operator acts on the specs, which is what declaring the answer's shape
# buys. `| count` answers a number, never the page.
counted = run([binary, 'spec-status', '|', 'count'], here)
require(counted.stdout.strip() == str(len(new_records)),
        f'`le spec-status | count` answered {counted.stdout!r}, want {len(new_records)}')

# The tree is the checkout, so the rendering is a pipe operator and the script's
# flag is not an argument here.
refused = run([binary, 'spec-status', '--json'], here)
require(refused.returncode == 1,
        f'`le spec-status --json` exited {refused.returncode}, want 1')
require('takes no arguments' in refused.stderr,
        f'the refusal does not say why: {refused.stderr!r}')

print('OK')
EOF_PY

cmd=foreground:seq=1:exec=python3 run.py
expect=exit:code=0
expect=stdout:contains=OK
