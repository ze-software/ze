# Test: the built le binary runs the Docker evidence harness through recording
#       stand-ins and renders the structured report with global pipe operators.
#
# VALIDATES: keyword grammar, JSON environment transport, built-binary dispatch,
#            dotted keys, report shape, inner exits, and shared pipe behavior.
# PREVENTS: a Python producer fork or function-only proof for docker-run.

option=timeout:value=300s

tmpfs=run.py:terminator=EOF_PY
import json
import os
import stat
import subprocess


def require(condition, message):
    if not condition:
        raise SystemExit(f'FAIL: {message}')


root = os.environ['ZE_REPO_ROOT']
work = os.getcwd()


def feature_tags():
    found = set()
    with open(os.path.join(root, 'feature-gates.txt'), encoding='utf-8') as handle:
        for line in handle:
            words = line.split()
            if words and words[0].startswith('ze_'):
                found.add(words[0])
    return ','.join(['ze_core'] + sorted(found))


binary = os.path.join(work, 'le')
build_env = dict(os.environ)
build_env['CGO_ENABLED'] = '0'
compiled = subprocess.run(
    ['make', '--no-print-directory', 'le-build', f'ZE_BIN_DIR={os.path.dirname(binary)}'], cwd=root,
    capture_output=True, text=True, check=False, env=build_env,
)
require(compiled.returncode == 0, f'compiling le failed: {compiled.stderr}')

fixture = os.path.join(work, 'fixture')
os.makedirs(os.path.join(fixture, 'scripts', 'evidence'), exist_ok=True)
with open(os.path.join(fixture, 'go.mod'), 'w', encoding='utf-8') as handle:
    handle.write('module fixture\n')
with open(os.path.join(fixture, 'feature-gates.txt'), 'w', encoding='utf-8') as handle:
    handle.write('ze_bgp default\nze_l2tp default\n')
with open(os.path.join(fixture, 'scripts', 'evidence', 'proof.py'), 'w', encoding='utf-8') as handle:
    handle.write("print('container peer owns this path')\n")

stubs = os.path.join(work, 'stubs')
os.makedirs(stubs, exist_ok=True)
programs = {
    'go': r'''#!/usr/bin/env python3
import json, os, pathlib, sys
with open(os.environ['DOCKER_RECORD'], 'a', encoding='utf-8') as handle:
    json.dump({'program': 'go', 'args': sys.argv[1:]}, handle)
    handle.write('\n')
out = sys.argv[sys.argv.index('-o') + 1]
pathlib.Path(out).parent.mkdir(parents=True, exist_ok=True)
pathlib.Path(out).write_text('ze\n', encoding='utf-8')
''',
    'docker': r'''#!/usr/bin/env python3
import json, os, pathlib, sys
args = sys.argv[1:]
with open(os.environ['DOCKER_RECORD'], 'a', encoding='utf-8') as handle:
    json.dump({'program': 'docker', 'args': args,
               'dotted': sorted(k for k in os.environ if k.startswith('ze.'))}, handle)
    handle.write('\n')
if args[:2] == ['image', 'inspect']:
    raise SystemExit(0)
if args and args[0] == 'run':
    print('container-id')
    raise SystemExit(0)
if args and args[0] == 'rm':
    raise SystemExit(0)
if 'apk' in args:
    raise SystemExit(0)
if 'python3' in args:
    pathlib.Path(os.environ['DOCKER_TREE_EFFECT']).write_text('inner\n', encoding='utf-8')
    raise SystemExit(int(os.environ.get('DOCKER_INNER_CODE', '0')))
raise SystemExit(99)
''',
}
for name, body in programs.items():
    target = os.path.join(stubs, name)
    with open(target, 'w', encoding='utf-8') as handle:
        handle.write(body)
    os.chmod(target, os.stat(target).st_mode | stat.S_IEXEC | stat.S_IXGRP)


def le(*args, inner_code='0', record='calls.ndjson'):
    env = dict(os.environ)
    env['PATH'] = stubs + os.pathsep + env['PATH']
    env['ZE_REPO_ROOT'] = fixture
    env['ZE_DOCKER_EVIDENCE_IMAGE'] = 'ui:image'
    env['ZE_DOCKER_EVIDENCE_PLATFORM'] = 'linux/amd64'
    env['ZE_DOCKER_EVIDENCE_GOARCH'] = 'amd64'
    env['ZE_ORDERED'] = 'inherited'
    env['ze.l2tp.ncp.ip-timeout'] = '9'
    env['DOCKER_INNER_CODE'] = inner_code
    env['DOCKER_RECORD'] = os.path.join(work, record)
    env['DOCKER_TREE_EFFECT'] = os.path.join(fixture, 'inner-result.txt')
    return subprocess.run([binary, *args], capture_output=True, text=True,
                          check=False, env=env)


listing = le('evidence')
require(listing.returncode == 0 and 'docker-run' in listing.stdout,
        f'evidence listing did not publish docker-run: {listing.stdout!r} {listing.stderr!r}')

base = (
    'evidence', 'docker-run', 'script', 'scripts/evidence/proof.py',
    'packages', 'iproute2 python3',
    'environment', '["ZE_ORDERED=explicit","PUNCT=x:y=z,[]"]',
)
answer = le(*base, '|', 'json')
require(answer.returncode == 0, f'docker-run exited {answer.returncode}: {answer.stderr[-800:]}')
report = json.loads(answer.stdout)
require(report['verdict'] == 'pass' and report['code'] == 0 and report['cleanup'],
        f'docker verdict changed: {report!r}')
plan = report['plan']
for key in ('commands', 'environment', 'build-tags', 'module-mounted', 'ze-binary',
            'container', 'packages', 'script', 'image', 'platform', 'goarch'):
    require(key in plan, f'docker plan has no {key!r}: {sorted(plan)}')
require(plan['packages'] == ['iproute2', 'python3'], f'packages changed: {plan["packages"]!r}')
require(plan['environment'][-2:] == ['ZE_ORDERED=explicit', 'PUNCT=x:y=z,[]'],
        f'explicit environment order changed: {plan["environment"]!r}')
require('ze.l2tp.ncp.ip-timeout=9' in plan['environment'],
        f'dotted environment key was lost: {plan["environment"]!r}')
require(len(plan['commands']) == 6, f'report command count changed: {plan["commands"]!r}')
require(os.path.isfile(os.path.join(fixture, 'inner-result.txt')),
        'the rw-mounted tree has no inner effect')

with open(os.path.join(work, 'calls.ndjson'), encoding='utf-8') as handle:
    calls = [json.loads(line) for line in handle if line.strip()]
require(len(calls) == 6, f'docker-run made {len(calls)} commands, want 6: {calls}')
require([call['program'] for call in calls] == ['docker', 'go', 'docker', 'docker', 'docker', 'docker'],
        f'command order changed: {calls}')
inner = calls[-2]['args']
require('ze.l2tp.ncp.ip-timeout=9' in inner and 'ZE_ORDERED=inherited' in inner
        and 'ZE_ORDERED=explicit' in inner and 'PUNCT=x:y=z,[]' in inner,
        f'inner environment argv changed: {inner}')
require(inner.index('ZE_ORDERED=inherited') < inner.index('ZE_ORDERED=explicit'),
        f'inner environment order changed: {inner}')

failed = le(*base, '|', 'json', inner_code='3', record='failed.ndjson')
require(failed.returncode == 3, f'inner exit 3 became {failed.returncode}: {failed.stderr[-800:]}')
failed_report = json.loads(failed.stdout)
require(failed_report['verdict'] == 'fail' and failed_report['inner-exit-code'] == 3,
        f'inner failure report changed: {failed_report!r}')

for invalid in (
    ('evidence', 'docker-run'),
    ('evidence', 'docker-run', 'script', 'missing.py'),
    ('evidence', 'docker-run', 'script', 'scripts/evidence/proof.py', 'environment', '{}'),
    ('evidence', 'docker-run', 'scripts/evidence/proof.py'),
):
    refused = le(*invalid, record='refused.ndjson')
    require(refused.returncode != 0, f'grammar accepted {invalid!r}')

# JSON, YAML, table, and every global format/paging operator consume one report.
for operator in ('json', 'ndjson', 'table', 'text', 'yaml', 'raw', 'no-more'):
    rendered = le(*base, '|', operator, record=f'{operator}.ndjson')
    require(rendered.returncode == 0,
            f'global pipe {operator} exited {rendered.returncode}: {rendered.stderr[-800:]}')
    require(rendered.stdout.strip(), f'global pipe {operator} returned no answer')

# `log` acts on a sequence. This action answers once, so the catalog refuses it.
logged = le(*base, '|', 'log', '|', 'json', record='log.ndjson')
require(logged.returncode == 1 and logged.stdout == ''
        and logged.stderr == 'error: log requires a streaming command\n',
        f'one-shot log refusal changed: {logged.stdout!r} {logged.stderr!r}')
saved_path = os.path.join(work, 'saved-answer.json')
saved = le(*base, '|', 'save', saved_path, record='save.ndjson')
require(saved.returncode == 0 and os.path.getsize(saved_path) > 0,
        f'pipe save wrote no report: {saved.stderr[-800:]}')
print('LE_EVIDENCE_DOCKER_ANSWERS_OK')
EOF_PY

cmd=foreground:seq=1:exec=python3 run.py
expect=stdout:pattern=LE_EVIDENCE_DOCKER_ANSWERS_OK
expect=exit:code=0
