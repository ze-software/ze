# Test: ze doctor reports a bgp-gr plugin that runs out of process
# VALIDATES: checkGRInProcess (internal/component/bgp/plugins/gr/doctor.go) is
#            WIRED into `ze doctor` -- `plugin { external X { run "ze plugin
#            bgp-gr"; } }` produces the doctor-bgp-gr-out-of-process diagnostic,
#            and `ze show diagnostic` answers for the code it reports.
# PREVENTS:  the operator meeting the refusal only when the daemon fails to
#            start. A forked bgp-gr refuses to start (runGRPlugin, gr.go),
#            because the retention answer bgp-rr and bgp-rs read and the LLGR
#            egress state must live in the daemon; the check reports that from
#            the config before the daemon is started.
#
# This is the WIRING test. doctor_test.go calls checkGRInProcess directly, so
# dropping the registration in register.go leaves every unit test green
# (ai/rules/interop-and-goal-validation.md). Only this file drives the real
# entry point: a config file on disk -> ExtractPluginsFromTree ->
# DoctorCheckContext -> the registered check -> the JSON an operator reads.
#
# Every plugin below carries a DISTINCT name because the runner matches every
# expect= line against one accumulated stdout buffer for the whole file
# (runner_exec.go). The diagnostic message names the plugin, so "plugin <name>"
# is what separates the arrangement that must be reported from the two that
# must not be.
#
# The refusal itself is test/plugin/gr-external-refuses.ci.

# --- 1. The reported arrangement: bgp-gr forked as a child process ---
tmpfs=gr-external.conf:terminator=EOF_EXTERNAL
plugin {
    external grext {
        run "ze plugin bgp-gr"
    }
}
EOF_EXTERNAL

# The diagnostic is an error, because the daemon will not start with this
# config, so ze doctor exits 1.
cmd=foreground:seq=1:exec=ze doctor --json config gr-external.conf:exit=1
# The `"code":` prefix matters: `ze show diagnostic` below prints the same code, so a
# bare substring match on it would pass with the check unregistered.
expect=stdout:contains="code": "doctor-bgp-gr-out-of-process"
expect=stdout:contains=plugin grext: bgp-gr runs as a separate process
expect=stdout:contains=which it refuses, so the daemon will not start
expect=stdout:contains="severity": "error"

# --- 2. The code ze doctor printed resolves through ze show diagnostic ---
cmd=foreground:seq=2:exec=ze show diagnostic doctor-bgp-gr-out-of-process:exit=0
expect=stdout:contains=Graceful Restart plugin runs out of process

# --- 3. Contrast: `use bgp-gr` runs the engine in the daemon ---
# Without this, a check that warned unconditionally would satisfy case 1.
tmpfs=gr-internal.conf:terminator=EOF_INTERNAL
plugin {
    internal grint {
        use bgp-gr
    }
}
EOF_INTERNAL

cmd=foreground:seq=3:exec=ze doctor --json config gr-internal.conf:exit=0
reject=stdout:contains=plugin grint

# --- 4. An internal bgp-gr beside an external one ---
# The forked sibling still refuses to start, whatever runs beside it, so the
# daemon does not start with this config and the check reports the sibling.
tmpfs=gr-both.conf:terminator=EOF_BOTH
plugin {
    internal grpair {
        use bgp-gr
    }
    external grsib {
        run "ze plugin bgp-gr"
    }
}
EOF_BOTH

cmd=foreground:seq=4:exec=ze doctor --json config gr-both.conf:exit=1
expect=stdout:contains=plugin grsib: bgp-gr runs as a separate process
