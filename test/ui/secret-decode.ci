# Test: ze secret decode and ze secret encode -- the offline $9$ codec, reached
#       through the ze binary
# VALIDATES: decode prints the plaintext behind a $9$ value that secret.Encode
#            produced, given as an argument or on stdin; encode prints a $9$
#            value; a bcrypt hash, a SHA-crypt hash, a value without the $9$
#            prefix and a damaged $9$ value are each refused with exit 1, the
#            reason and the command that fixes it
# PREVENTS: an operator unable to read the BGP MD5 key or API token that a
#           ze:sensitive leaf holds, and a one-way hash answered as if it could
#           be decoded
#
# The $9$ vector is secret.Encode("bgp-md5 key!"). Encode picks a random salt,
# so one fixed output stands in for the round trip, which the unit test
# TestSecretRoundTrip proves through the same command handler.

stdin=secret:terminator=EOF_SECRET
$9$ahGUHTQn6Cuq.Cu0BSygoaJZUTQntpBCtuO
EOF_SECRET

stdin=hash:terminator=EOF_HASH
$2a$10$N9qo8uLOickgx2ZMRZoMyeIjZAgcfl7p92ldGxad68LJZdL17lhWy
EOF_HASH

cmd=foreground:seq=1:exec=ze secret decode '$9$ahGUHTQn6Cuq.Cu0BSygoaJZUTQntpBCtuO'
expect=exit:code=0
expect=stdout:contains=bgp-md5 key!

cmd=foreground:seq=2:exec=ze secret decode -:stdin=secret
expect=exit:code=0
expect=stdout:contains=bgp-md5 key!

cmd=foreground:seq=3:exec=ze secret encode 'bgp-md5 key!'
expect=exit:code=0
expect=stdout:pattern=^\$9\$[^ ]+

cmd=foreground:seq=4:exec=ze secret decode -:stdin=hash
expect=exit:code=1
expect=stderr:contains=one-way password hash ($2a$)
expect=stderr:contains=cannot be decoded
expect=stderr:contains=ze config set

cmd=foreground:seq=5:exec=ze secret decode '$6$salt$abcdef'
expect=exit:code=1
expect=stderr:contains=one-way password hash ($6$)

cmd=foreground:seq=6:exec=ze secret decode plaintext
expect=exit:code=1
expect=stderr:contains=does not start with $9$
expect=stderr:contains=ze secret decode '$9$...'

cmd=foreground:seq=7:exec=ze secret decode '$9$~~~~'
expect=exit:code=1
expect=stderr:contains=not a valid $9$ secret

cmd=foreground:seq=8:exec=ze secret decode
expect=exit:code=2
expect=stderr:contains=needs the value
