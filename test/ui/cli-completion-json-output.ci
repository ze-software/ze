# Test: `ze config completion` — the candidates at a context path
# VALIDATES: the completion engine answers the candidates the config tree
#            allows next, queried non-interactively

tmpfs=test.conf:terminator=EOF_CONF
bgp {
	router-id 1.2.3.4
	session {
		asn {
			local 65000
		}
	}
}
EOF_CONF

cmd=foreground:seq=1:exec=ze config completion --context bgp --input set+ test.conf
expect=exit:code=0
expect=stdout:contains=router-id
expect=stdout:contains=session
