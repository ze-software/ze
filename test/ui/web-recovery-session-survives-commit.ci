# Test: an operator who commits config in the web UI can still edit afterwards
# VALIDATES: the accepted local credential generation advances only when a local
#            credential changes, so a live break-glass session survives the
#            reload its own commit triggers.
# PREVENTS: the operator losing edit rights inside the request that committed.
#           Every reload advanced the generation, a bare SIGHUP included, and
#           aaa.AuthorizerForResult pins a `ze init` bootstrap admin's session to
#           the generation that authenticated it. The commit succeeded, the
#           commit bar came back read-only, and every later edit answered 403
#           until the operator logged in again.
#
# The session must belong to the zefs admin `ze init` writes, not to a config
# user: only the zefs account carries aaa.ReservedRecoveryProfile, and only a
# session holding that profile is pinned to a generation at all.
#
# The whole sequence is one shell driver because the ordering is the test: the
# second edit must run strictly after the commit, and http= steps run in their
# own phase with no way to place a request after another request's side effect.

option=timeout:value=90s

tmpfs=web-recovery-check.py:mode=755:terminator=EOF_PY
#!/usr/bin/env python3
"""Assert a break-glass web session keeps its edit rights across its own commit.

Requests carry the ze-session cookie the real login handler issues, so this is
the credential a browser tab holds (internal/component/web/auth.go). Each edit
is sent the way htmx sends it, with HX-Request, because that is the branch that
answers with the out-of-band commit bar the operator sees.
"""
import http.client
import os
import ssl
import sys
import urllib.parse

from ze_api import wait_until

BASE_URL = os.environ['ZE_WEB_URL']
CTX = ssl._create_unverified_context()
PARSED = urllib.parse.urlparse(BASE_URL)

# The commit bar the operator drives. A read-only session renders NO element
# with this id (internal/component/web/component_oob_save.templ), so its
# presence is the answer to "may this session still edit".
COMMIT_BAR = 'id="commit-bar"'


def post(path, form, headers):
    """POST a form and return (status, body). Returns (None, '') when unreachable.

    The transport failure is printed rather than swallowed: a refused or reset
    connection and a rejected credential are different diagnoses, and this test
    exists to tell them apart.
    """
    conn = http.client.HTTPSConnection(PARSED.hostname, PARSED.port, context=CTX, timeout=30)
    try:
        body = urllib.parse.urlencode(form)
        sent = {'Content-Type': 'application/x-www-form-urlencoded', 'Origin': BASE_URL}
        sent.update(headers)
        conn.request('POST', path, body, sent)
        response = conn.getresponse()
        return response.status, response.read().decode('utf-8', 'replace')
    except (OSError, http.client.HTTPException) as err:
        print(f'transport: POST {path}: {type(err).__name__}: {err}', file=sys.stderr)
        return None, ''
    finally:
        conn.close()


def login_cookie(user, password):
    """Return the ze-session token POST /login issues, or None.

    Set-Cookie rides the 303 the handler answers with, not the page the
    redirect leads to, so this reads the first response rather than following.
    """
    conn = http.client.HTTPSConnection(PARSED.hostname, PARSED.port, context=CTX, timeout=10)
    try:
        body = urllib.parse.urlencode({'username': user, 'password': password})
        conn.request('POST', '/login', body, {'Content-Type': 'application/x-www-form-urlencoded'})
        response = conn.getresponse()
        response.read()
        for name, value in response.getheaders():
            if name.lower() == 'set-cookie' and value.startswith('ze-session='):
                return value.split(';', 1)[0].split('=', 1)[1]
        return None
    except (ConnectionRefusedError, OSError):
        return None
    finally:
        conn.close()


def set_format(token, value):
    """Set `environment cli format default` as the browser's editor does."""
    return post('/config/set/environment/cli/format/',
                {'leaf': 'default', 'value': value},
                {'Cookie': f'ze-session={token}', 'HX-Request': 'true'})


def commit(token):
    return post('/config/commit', {}, {'Cookie': f'ze-session={token}', 'HX-Request': 'true'})


def reload_started():
    """Report whether the daemon logged the reload the commit hook triggers."""
    try:
        with open('daemon.log', encoding='utf-8') as log:
            return 'config reload started' in log.read()
    except OSError:
        return False


def wait_for_login(user, password):
    """Return the session token, retrying while the web listener comes up.

    The retry goes through wait_until rather than its own sleep loop, so
    the ci-sleep ratchet counts no sleep here. The predicate keeps the token it
    won in a one-element list, because wait_until reports only whether the
    predicate became truthy.
    """
    held = [None]

    def logged_in():
        held[0] = login_cookie(user, password)
        return held[0] is not None

    if not wait_until(logged_in, attempts=60, delay=0.5):
        return None
    return held[0]


def require(condition, message):
    if not condition:
        print('FAIL: ' + message, file=sys.stderr)
        sys.exit(1)
    print('OK: ' + message, file=sys.stderr)


def main():
    token = wait_for_login('recovery-admin', 'recoverypass')
    require(token is not None,
            'the zefs break-glass admin logs in through the web login form')

    status, body = set_format(token, 'table')
    require(status == 200 and COMMIT_BAR in body,
            f'the session may edit before it commits (status {status})')

    status, body = commit(token)
    require(status == 200 and 'Commit failed' not in body,
            f'the commit the operator asked for succeeds (status {status})')

    # Without this the test could pass on a daemon that never reloaded, and the
    # reload is the only thing that can move the accepted generation.
    require(wait_until(reload_started, attempts=60, delay=0.5),
            'the commit triggered the daemon reload the generation is decided by')

    require(COMMIT_BAR in body,
            'the commit answers with an editable commit bar, not a read-only one')

    status, body = set_format(token, 'json')
    require(status == 200 and COMMIT_BAR in body,
            f'the same session still edits after its own commit (status {status})')

    # The control. A credential the daemon never issued is refused, so the three
    # answers above mean the cookie was checked and accepted, not that the
    # daemon admits anyone.
    status, _ = set_format('not-a-session-token', 'text')
    require(status not in (None, 200),
            f'an invented session token is refused (status {status})')


if __name__ == '__main__':
    main()
EOF_PY

tmpfs=test-web-recovery.sh:mode=755:terminator=EOF_SH
#!/bin/sh
set -e

ZE_DIR=$(mktemp -d)
DAEMON_PID=""
cleanup() {
	if [ -n "$DAEMON_PID" ]; then
		kill "$DAEMON_PID" 2>/dev/null || true
		wait "$DAEMON_PID" 2>/dev/null || true
	fi
	rm -rf "$ZE_DIR"
}
trap cleanup EXIT

WEB_PORT=$((17300 + ($$ % 900)))
ZE_WEB_URL="https://127.0.0.1:$WEB_PORT"
export ZE_WEB_URL

# The real zefs producer. usersFromZefsDB (cmd/ze/hub/main_servers.go) is what
# attaches the reserved recovery profile, and nothing else in the daemon does,
# so a config-declared user cannot stand in for this account.
printf 'recovery-admin\nrecoverypass\n127.0.0.1\n2222\n' | ZE_CONFIG_DIR="$ZE_DIR" ze init >/dev/null

# The config declares no users at all, so the zefs admin is the whole local
# credential set and the commit below changes none of it.
cat > web-recovery.conf << ZECONF
environment {
	web {
		enabled true;
		server main { ip 127.0.0.1; port $WEB_PORT; }
	}
}
ZECONF

# ze.log defaults to warn, and "config reload started" is an info line from the
# plugin.server subsystem. The check below reads it to prove the commit really
# reloaded the daemon, so raise that one subsystem rather than the whole log.
rm -f daemon.ready
ZE_READY_FILE="$PWD/daemon.ready" ZE_CONFIG_DIR="$ZE_DIR" env 'ze.log.plugin.server=info' ze start web-recovery.conf 2>daemon.log &
DAEMON_PID=$!

# The web listener binds during service construction, while the commit hook is
# published later in daemon startup. Serving a login is therefore not proof that
# a commit would reload, so wait for the daemon's own readiness marker.
i=0
while [ ! -f daemon.ready ] && [ $i -lt 300 ]; do
	sleep 0.1
	i=$((i + 1))
done
if [ ! -f daemon.ready ]; then
	echo "FAIL: daemon never became ready, so no commit could reload it" >&2
	cat daemon.log >&2
	exit 1
fi

if ! ./web-recovery-check.py; then
	echo "--- daemon.log ---" >&2
	cat daemon.log >&2
	exit 1
fi
exit 0
EOF_SH

cmd=foreground:seq=1:exec=./test-web-recovery.sh:timeout=90s
expect=exit:code=0
