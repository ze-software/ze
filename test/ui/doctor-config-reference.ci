# Test: ze doctor --json — dangling config reference detected
# VALIDATES: AC-1/AC-2 dangling policy reference produces doctor-config-reference diagnostic
#
# The peer carries `connection local ip` and `prefix { maximum }` so the only
# fault left is the one under test. That does NOT make the config engine-valid:
# PeersFromConfigTree resolves filter references too, so the dangling policy IS
# an engine peer-resolution failure and checkBGPPeerConfig
# (internal/component/doctor/checks_config.go) necessarily reports it alongside
# doctor-config-reference. The two are inherently coupled here -- a `reject=` on
# doctor-config-bgp-peer is unsatisfiable, and asserting only `nonexistent-policy`
# is degenerate because BOTH messages contain it. See the assertion note below.

tmpfs=dangling.conf:terminator=EOF_CONF
bgp {
	router-id 1.2.3.4
	session {
		asn {
			local 65000
		}
	}
	peer peer1 {
		connection {
			local {
				ip 127.0.0.1
			}
			remote {
				ip 10.0.0.1
			}
		}
		session {
			asn {
				remote 65001
			}
			family {
				ipv4/unicast {
					prefix {
						maximum 10000
					}
				}
			}
		}
		filter {
			import [ nonexistent-policy ]
		}
	}
}
EOF_CONF

cmd=foreground:seq=1:exec=ze doctor --json dangling.conf
expect=exit:code=1
expect=stdout:contains=doctor-config-reference
expect=stdout:contains=nonexistent-policy
# The needle that makes exit=1 non-degenerate. `nonexistent-policy` alone does
# NOT: checkBGPPeerConfig reports the same dangling reference as `unknown filter
# "nonexistent-policy"`, so both diagnostics carry that string and either could
# be supplying the exit code. "references undefined filter" is emitted only by
# checkFilterRefs (internal/component/doctor/checks_config.go), so this pins the
# check the test is named for.
expect=stdout:contains=references undefined filter
