# Test: ze doctor --json — dangling config reference detected
# VALIDATES: AC-1/AC-2 dangling policy reference produces doctor-config-reference diagnostic
#
# The peer carries `connection local ip` and `prefix { maximum }` so the only
# fault left is the one under test. That does NOT make the config loadable:
# load validation refuses the dangling policy too. runChecks
# (internal/component/doctor/doctor.go) runs the parsed-config phase first, so
# checkFilterReferences (internal/component/bgp/config/filter_reference_doctor.go)
# reports doctor-config-reference before ReadConfig refuses the load, which is
# reported as doctor-config-parse and stops the run before post-config.
# doctor-config-bgp-peer, a post-config check, therefore never runs for this
# input. See the assertion note below.

tmpfs=dangling.conf:terminator=EOF_CONF
bgp {
	router-id 1.2.3.4
	session {
		asn {
			local 65000
		}
	}
	peer peer1 {
		connection {
			local {
				ip 127.0.0.1
			}
			remote {
				ip 10.0.0.1
			}
		}
		session {
			asn {
				remote 65001
			}
			family {
				ipv4/unicast {
					prefix {
						maximum 10000
					}
				}
			}
		}
		filter {
			import { filters [ nonexistent-policy ]; final accept; }
		}
	}
}
EOF_CONF

cmd=foreground:seq=1:exec=ze doctor --json config dangling.conf
expect=exit:code=1
expect=stdout:contains=doctor-config-reference
expect=stdout:contains=nonexistent-policy
# The needle that makes exit=1 non-degenerate. `nonexistent-policy` alone does
# NOT: the load refusal, reported as doctor-config-parse, also fails the run and
# can name the same filter, so either diagnostic could be supplying the exit
# code. "references undefined filter" is emitted only by checkFilterReferences
# (internal/component/bgp/config/filter_reference_doctor.go), so this pins the
# check the test is named for.
expect=stdout:contains=references undefined filter
