# Test: the BUILT le binary runs the three documentation gates over the real
#       checkout, reports what the scripts report, and answers as data.
#
# The three gates are three ACTIONS of one command, the way the Python le held
# them as gates of two areas. `le docvalid` with no action lists them with the
# writes marker each carries, which is what `le <area> --list` printed.
#
# VALIDATES: spec-le-is-a-ze-binary AC-11 over the REAL TREE and the REAL
#            REGISTRY, and AC-7 for the command, against the artifact a
#            developer runs.
# PREVENTS: a port that agrees with the scripts on fixtures and disagrees on the
#           checkout. The drift gate reads eight documents and both registries,
#           and the contract gate answers a 400-line table; a check that stopped
#           firing would pass every fixture in this repository.
#
# All three binaries are compiled here rather than by the runner, which builds
# only ze and ze-test (internal/test/runner/runner.go, setupBinShims), and all
# three carry THE SAME tag set: the full feature set, derived from
# feature-gates.txt the way scripts/le/devtools/toolchain.py derives it. That is
# load bearing here. Both sides read the live registry, so a reduced set
# compiles the address families out and the drift gate then reports eleven
# fabricated findings against documentation that is correct.
#
# The WRITING gate is driven over two COPIES, never over the checkout: a test
# that writes into the tree it runs from can leave a developer with a dirty
# working directory it did not explain. Each copy holds a stale table, so both
# runs must WRITE, and both resulting trees are compared byte for byte.
#
# The timeout is DECLARED because three links of the product precede two walks
# of the checkout.

option=timeout:value=900s

tmpfs=run.py:terminator=EOF_PY
"""Compile both sides of the migration and check that they agree."""
import json
import os
import re
import subprocess


def require(condition, message):
    if not condition:
        raise SystemExit(f'FAIL: {message}')


root = os.environ['ZE_REPO_ROOT']
here = os.getcwd()


def feature_tags():
    """ze_core plus every ze_* tag feature-gates.txt declares, sorted."""
    found = set()
    with open(os.path.join(root, 'feature-gates.txt'), encoding='utf-8') as handle:
        for line in handle:
            words = line.split()
            if words and words[0].startswith('ze_'):
                found.add(words[0])
    return ','.join(['ze_core'] + sorted(found))


TAGS = feature_tags()

binary = os.path.join(here, 'le')
script_drift = os.path.join(here, 'doc_drift')
script_contract = os.path.join(here, 'commands')

for args in (['go', 'build', '-tags', TAGS, '-o', binary, './cmd/le'],
             ['go', 'build', '-tags', TAGS, '-o', script_drift, 'scripts/docvalid/doc_drift.go'],
             ['go', 'build', '-tags', TAGS, '-o', script_contract, 'scripts/docvalid/commands.go']):
    built = subprocess.run(args, cwd=root, capture_output=True, text=True, check=False)
    require(built.returncode == 0, f'{" ".join(args)} failed: {built.stderr}')

ANSI = re.compile(r'\x1b\[[0-9;]*m')


def run(argv, cwd, env=None):
    return subprocess.run(argv, cwd=cwd, capture_output=True, text=True, check=False,
                          env=env if env is None else dict(os.environ, **env))


def joined(done):
    """The report, whichever stream carried it, with the palette stripped.

    The script writes its clean line to stdout and its findings to stderr; the
    command answers ONE payload the engine renders to stdout.
    """
    return ANSI.sub('', done.stdout + done.stderr)


# ---- ze-doc-drift-check -----------------------------------------------------

old = run([script_drift], root)
new = run([binary, 'docvalid', 'doc-drift-check'], here)
require(old.returncode == new.returncode,
        f'the drift script exited {old.returncode} and the command exited {new.returncode}\n'
        f'script:\n{joined(old)}\ncommand:\n{joined(new)}')
require(joined(old) == joined(new),
        f'the drift reports differ:\nscript:\n{joined(old)}\ncommand:\n{joined(new)}')

# ---- ze-command-contract-check ----------------------------------------------
# The rows are compared as a SET: the script sorts on the wire method alone with
# an unstable sort, so its own table changes between runs
# (scripts/docvalid/parity_test.go, TestScriptStillSortsOnOneKeyAlone).

old_contract = run([script_contract], root)
new_contract = run([binary, 'docvalid', 'command-contract-check'], here)
require(old_contract.returncode == new_contract.returncode,
        f'the contract script exited {old_contract.returncode} '
        f'and the command exited {new_contract.returncode}')
old_lines = sorted(old_contract.stdout.split('\n'))
new_lines = sorted(new_contract.stdout.split('\n'))
if old_lines != new_lines:
    only_script = [line for line in old_lines if line not in new_lines]
    only_command = [line for line in new_lines if line not in old_lines]
    raise SystemExit(f'FAIL: the contract reports hold different lines:\n'
                     f'  only the script: {only_script[:5]}\n'
                     f'  only the command: {only_command[:5]}')
require(len(old_lines) > 100,
        f'the contract comparison ran over {len(old_lines)} lines, too few to mean anything')

# The command's own table is the same every time, which is what the port fixed.
again = run([binary, 'docvalid', 'command-contract-check'], here)
require(again.stdout == new_contract.stdout,
        'the command answered two different tables over one unchanged tree')

# ---- one payload, every rendering -------------------------------------------

answer = run([binary, 'docvalid', 'command-contract-check', '|', 'json'], here)
try:
    result = json.loads(answer.stdout)
except json.JSONDecodeError as exc:
    raise SystemExit('FAIL: `le docvalid command-contract-check | json` did not answer JSON: '
                     f'{exc}\n{answer.stdout[:400]}') from exc
for key in ('yang-commands', 'handlers', 'local-handlers', 'orphan-yang',
            'orphan-handlers', 'orphan-local-handlers', 'skipped-handlers',
            'total-yang', 'total-handlers', 'total-local-handlers', 'valid'):
    require(key in result, f'the contract answered no {key!r} key: {sorted(result)}')
require(result['total-yang'] > 100,
        f"the contract answered {result['total-yang']} YANG commands, too few to be the product")
require(answer.returncode == new_contract.returncode,
        f'`| json` exited {answer.returncode} and the bare command exited {new_contract.returncode}')

# The drift answer carries ONE row set, so the engine renders the findings
# themselves: `| json` answers the array a script would iterate.
drift_json = run([binary, 'docvalid', 'doc-drift-check', '|', 'json'], here)
try:
    findings = json.loads(drift_json.stdout)
except json.JSONDecodeError as exc:
    raise SystemExit('FAIL: `le docvalid doc-drift-check | json` did not answer JSON: '
                     f'{exc}\n{drift_json.stdout[:400]}') from exc
require(isinstance(findings, list),
        f'the drift report answered {type(findings)}, want an array of findings')
require(drift_json.returncode == new.returncode,
        f'`| json` exited {drift_json.returncode} and the bare drift gate exited {new.returncode}')
for finding in findings:
    for key in ('file', 'message'):
        require(key in finding, f'a finding carries no {key!r}: {finding}')

# The command answers a DOCUMENT: the contract carries seven lists, and no
# reading of `count` over them is the one an operator meant. The refusal is BY
# NAME, before the gate walks the tree (letools/docvalid/register.go).
counted = run([binary, 'docvalid', 'command-contract-check', '|', 'count'], here)
require(counted.returncode != 0,
        f'`| count` was accepted over a document answer: {counted.stdout!r}')
require('count acts on rows' in counted.stderr,
        f'`| count` was refused for another reason: {counted.stderr!r}')

# ---- the listing says which action WRITES -----------------------------------

listing = run([binary, 'docvalid'], here)
require(listing.returncode == 0, f'`le docvalid` exited {listing.returncode}: {listing.stderr}')
for wanted in ('command-contract-check', 'doc-drift-check', 'docs-pipe-operators-update',
               'writes', 'checks'):
    require(wanted in listing.stdout, f'the listing does not name {wanted!r}:\n{listing.stdout}')
for line in listing.stdout.splitlines():
    if line.strip().startswith('docs-pipe-operators-update '):
        require('writes' in line, f'the generator is not marked as writing: {line!r}')

# ---- the writing gate, over two copies --------------------------------------

TABLE = 'docs/features/pipe-operators.generated.md'
trees = []
for name in ('script-tree', 'command-tree'):
    tree = os.path.join(here, name)
    os.makedirs(os.path.join(tree, 'docs', 'features'), exist_ok=True)
    with open(os.path.join(tree, TABLE), 'w', encoding='utf-8') as handle:
        handle.write('# a stale table\n')
    trees.append(tree)

script_tree, command_tree = trees
old_write = run([script_drift, '--root', script_tree, '--write-generated'], script_tree)
new_write = run([binary, 'docvalid', 'docs-pipe-operators-update'], here,
                env={'ZE_REPO_ROOT': command_tree})
require(old_write.returncode == 0 and new_write.returncode == 0,
        f'a write failed: script {old_write.returncode} {old_write.stderr}, '
        f'command {new_write.returncode} {new_write.stderr}')
require(joined(old_write) == joined(new_write),
        f'the write reports differ:\nscript: {joined(old_write)!r}\ncommand: {joined(new_write)!r}')


def digest(tree):
    out = {}
    for base, _, names in os.walk(tree):
        for name in names:
            path = os.path.join(base, name)
            with open(path, 'rb') as handle:
                out[os.path.relpath(path, tree)] = handle.read()
    return out


script_files, command_files = digest(script_tree), digest(command_tree)
differing = [path for path in sorted(set(script_files) | set(command_files))
             if script_files.get(path) != command_files.get(path)]
require(not differing, f'the two runs left different trees behind: {differing[:10]}')
require(b'stale' not in command_files[TABLE],
        'the generator did not overwrite the stale table, so this case proves nothing')

with open(os.path.join(root, TABLE), 'rb') as handle:
    published = handle.read()
require(command_files[TABLE] == published,
        'the table the generator writes is not the one the checkout publishes')

print('OK')
EOF_PY

cmd=foreground:seq=1:exec=python3 run.py
expect=exit:code=0
expect=stdout:contains=OK
