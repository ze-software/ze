# Test: ze config completion — bus endpoint external fields
# VALIDATES: bus > endpoint > external container shows run, respawn, timeout, on-exit

tmpfs=test.conf:terminator=EOF_CONF
bgp {
	router-id 1.2.3.4
	session {
		asn {
			local 65000
		}
	}
}
EOF_CONF

cmd=foreground:seq=1:exec=ze config completion --context bus/endpoint/ep1/external --input set+ test.conf
expect=exit:code=0
expect=stdout:contains=run
expect=stdout:contains=respawn
expect=stdout:contains=timeout
expect=stdout:contains=on-exit
