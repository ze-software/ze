# Test: every locally registered data command reaches the pipe layer
#
# VALIDATES: AC-10 -- every production MustRegisterLocalData command runs through
#   ze cli -c with a real pipe, without a daemon.
# PREVENTS: a converted local handler remaining unreachable from the client, or
#   a new registration landing without functional entry-to-pipe coverage.
#
# The local_json calls are the executable functional population. The registry
# population unit test derives production registrations from Go AST and derives
# coverage from these calls, so neither side is a hand-maintained command list.

option=timeout:value=45s

cmd=foreground:seq=1:exec=ze-test local-data-coverage
expect=exit:code=0
expect=stdout:contains=COVERED: show config completion [done]
expect=stdout:contains=COVERED: show config diff [done]
expect=stdout:contains=COVERED: show config dump [done]
expect=stdout:contains=COVERED: show config fix [done]
expect=stdout:contains=COVERED: show config history [done]
expect=stdout:contains=COVERED: show config ls [done]
expect=stdout:contains=COVERED: show data ls [done]
expect=stdout:contains=COVERED: show data registered [done]
expect=stdout:contains=COVERED: show env get [done]
expect=stdout:contains=COVERED: show env list [done]
expect=stdout:contains=COVERED: show env registered [done]
expect=stdout:contains=COVERED: show plugins [done]
expect=stdout:contains=COVERED: show schema events [done]
expect=stdout:contains=COVERED: show schema handlers [done]
expect=stdout:contains=COVERED: show schema list [done]
expect=stdout:contains=COVERED: show schema methods [done]
expect=stdout:contains=COVERED: show schema module [done]
expect=stdout:contains=COVERED: show schema protocol [done]
expect=stdout:contains=COVERED: show tacacs servers [done]
expect=stdout:contains=COVERED: show yang completion [done]
expect=stdout:contains=COVERED: show yang tree [done]
expect=stdout:contains=COVERED: validate config [done]
expect=stdout:contains=OK: 22/22 local-data commands and local one-shot save
