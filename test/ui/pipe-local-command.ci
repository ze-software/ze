# Test: a command served in the CLI's own process reaches the pipe layer
#
# VALIDATES: plan/spec-cli-pipe-operator-coverage.md AC-10 -- the 38 commands
#   that reached no pipe layer on any surface reach one.
# PREVENTS: `ze cli -c "show env list | json"` answering `unknown command`
#   again, which is what it did while YANG declared a wire method for the
#   command and no daemon handler implemented it. `ze help command --json`
#   published `global-pipes: true` for it at the same time, so the
#   machine-readable surface asserted support the daemon did not have.
#
# No daemon runs here on purpose: these commands are answered in the client's
# own process, so every chain below must work with nothing listening. That is
# also why the driver is Python: the chain has to reach `-c` as ONE argument,
# and a `|` on an exec= line does not survive as one.

tmpfs=run.py:terminator=EOF_PY
import json
import os
import subprocess
import sys

def require(condition, message):
    if not condition:
        raise SystemExit(message)

def count_of(text):
    # `| count` answers {"count": N}. With no format operator the default
    # rendering unwraps a single-key answer to its value, so the text is the
    # bare number. Both spellings are the same answer.
    parsed = json.loads(text)
    if isinstance(parsed, dict):
        return int(parsed['count'])
    return int(parsed)

def run(argv):
    r = subprocess.run(argv, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                       text=True, env=os.environ.copy(), check=False)
    return r.returncode, r.stdout, r.stderr

# 1. A format operator. The answer is structured data now, not the text the
#    command used to print, so it parses.
code, out, err = run(['ze', 'cli', '-c', 'show env list | json compact'])
require(code == 0, '| json exit=%d: %s%s' % (code, out, err))
payload = json.loads(out)
rows = payload['variables'] if isinstance(payload, dict) else payload
require(len(rows) > 10, 'the answer carries %d rows' % len(rows))
require(any(r['key'] == 'ze.cli.format' for r in rows), 'no ze.cli.format row: %r' % out[:200])

# 2. A row operator over the same answer. It could not run at all before.
code, out, err = run(['ze', 'cli', '-c', 'show env list | count'])
require(code == 0, '| count exit=%d: %s%s' % (code, out, err))
total = count_of(out)
require(total == len(rows), '| count answered %d, the answer has %d rows' % (total, len(rows)))

# 3. Nesting, which the owner requires: each match narrows the one before it.
code, out, err = run(['ze', 'cli', '-c', 'show env list | match ze.log | count'])
require(code == 0, 'one match exit=%d: %s%s' % (code, out, err))
one = count_of(out)
code, out, err = run(['ze', 'cli', '-c', 'show env list | match ze.log | match level | count'])
require(code == 0, 'two matches exit=%d: %s%s' % (code, out, err))
two = count_of(out)
require(0 < two < one < total,
        'match did not narrow twice: all=%d one=%d two=%d' % (total, one, two))

# 4. `| display` names the fields, so a tool can ask for a stable set and the
#    fields it did not name are gone.
code, out, err = run(['ze', 'cli', '-c',
                      'show env list | match ze.cli.format | display key | json compact'])
require(code == 0, '| display exit=%d: %s%s' % (code, out, err))
require('ze.cli.format' in out, 'display dropped the field it named: %r' % out)
require('description' not in out, 'display kept a field it did not name: %r' % out)

# 5. An unusable argument is refused rather than ignored.
code, out, err = run(['ze', 'cli', '-c', 'show env list | fill nosuchway'])
require(code == 1, 'a bad fill argument exit=%d, want 1: %s%s' % (code, out, err))

# 6. A second family, and the case a declared shape decides BEFORE the command
#    runs: `show schema protocol` answers one document, so every row operator
#    is refused over it by name. The refusal exits non-zero, so a script can
#    tell it from an answer.
code, out, err = run(['ze', 'cli', '-c', 'show schema protocol | json compact'])
require(code == 0, 'schema protocol exit=%d: %s%s' % (code, out, err))
require('version' in json.loads(out), 'schema protocol lost its payload: %r' % out)

code, out, err = run(['ze', 'cli', '-c', 'show schema protocol | first 1'])
require(code == 1, 'a row operator over a document exit=%d, want 1: %s%s' % (code, out, err))
combined = out + err
require('first' in combined, 'the refusal does not name the operator: %r' % combined)
require('rows' in combined, 'the refusal does not say why: %r' % combined)

# 7. The same family, where the answer DOES have rows.
code, out, err = run(['ze', 'cli', '-c', 'show schema list | count'])
require(code == 0, 'schema list count exit=%d: %s%s' % (code, out, err))
require(count_of(out) > 0, 'schema list counted nothing: %r' % out)

print('OK')
EOF_PY

cmd=foreground:seq=1:exec=python3 run.py
expect=exit:code=0
expect=stdout:contains=OK

# The `ze <verb>` form answers the same command through the same renderer, so
# its columns come out in the order the command declared: key first.
cmd=foreground:seq=2:exec=ze show env list
expect=exit:code=0
expect=stdout:contains=ze.log
