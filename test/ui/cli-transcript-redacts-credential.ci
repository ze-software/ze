# Test: `ze cli -c` records its command and the daemon's answer in a transcript
#       file, with the credential on the command line redacted.
# VALIDATES: with ze.cli.transcript enabled, the client of a `ze cli -c` session
#            creates $XDG_DATA_HOME/ze/transcripts/transcript-<stamp>-<pid>.log
#            (OpenTranscriptFile, internal/component/cli/transcript.go), writes
#            the session header, and records the command through
#            config.DisplayCommand, which replaces the token after a
#            credential keyword with <redacted>.
# PREVENTS: a transcript that is never written, and a credential typed on the
#           command line outliving the session in a file on disk.
#
# RUN GREEN on 2026-10-07, and observed RED first: with Record writing the
# raw command instead of config.DisplayCommand(command)
# (internal/component/cli/transcript.go), no transcript holds the redacted line.

option=timeout:value=60s
option=env:var=ZE_CONFIG_DIR:value=.
option=env:var=XDG_DATA_HOME:value=.
option=env:var=ze.ssh.password:value=testpass
option=env:var=ze.cli.transcript:value=true
# The SSH listener announces itself at INFO; the ready= barrier below reads it.
option=env:var=ze.log:value=info

stdin=init-answers:terminator=EOF_INIT
admin
testpass
127.0.0.1
$PORT2

EOF_INIT

tmpfs=transcript.conf:terminator=EOF_CONF
system {
	authentication {
		# bcrypt cost-4 hash of "testpass".
		user admin {
			password "$2a$04$UlwuiuH82Unfsq.XEMPGJeDkXwbm3KW.nvVaVXOd/JeFK8VjMjrQO"
		}
	}
}

environment {
	ssh {
		enabled true
		server main {
			ip 127.0.0.1;
			port $PORT2;
		}
	}
}
EOF_CONF

cmd=foreground:seq=1:exec=ze init:stdin=init-answers:exit=0
cmd=background:seq=2:exec=ze start transcript.conf:name=daemon:ready=SSH server listening
# The daemon answers this one: its rendering is what the transcript records.
cmd=foreground:seq=3:exec=ze cli -c "show version":exit=0
# The daemon answers this one too, and the token after `password` is the
# credential the transcript must never hold. A command the client serves
# locally (`show env list`) is not used: that branch records no transcript at
# all (cmd.ServeLocal runs before the credentials load, with a nil writer, in
# internal/component/cli/client/main.go; a journal row records the defect).
cmd=foreground:seq=4:exec=ze cli -c "show system subsystem list | match password hunter2"
expect=exit:code=0
cmd=stop:seq=5:name=daemon:signal=term
# One file per `ze cli -c` process: the tag is the client's pid.
expect=file:glob=ze/transcripts/transcript-*.log:count=2
expect=file:glob=ze/transcripts/transcript-*.log:contains=] > show version
expect=file:glob=ze/transcripts/transcript-*.log:contains=# Ze CLI Transcript
expect=file:glob=ze/transcripts/transcript-*.log:contains=# Host: 127.0.0.1:
expect=file:glob=ze/transcripts/transcript-*.log:contains=> show system subsystem list | match password <redacted>
expect=file:glob=ze/transcripts/transcript-*.log:not-contains=hunter2
