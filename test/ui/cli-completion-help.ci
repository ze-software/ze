# Test: ze config completion — usage text
# VALIDATES: no-args usage shows options and ghost flag
# NOTE: --help triggers os.Exit(0) from Go flag package which does not flush
# stderr when redirected to a file, so test via no-args path instead.

cmd=foreground:seq=1:exec=ze config completion
expect=exit:code=1
expect=stderr:contains=completion
expect=stderr:contains=context
expect=stderr:contains=ghost
