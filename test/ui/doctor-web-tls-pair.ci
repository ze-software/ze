# Test: ze doctor reports a stored web certificate and key that are not a pair.
# accept-only: the registered native fixture enforces this scenario's behavioral contract
# spec-fixit-appliance-cert-replace-unvalidated: `ze appliance replace-cert`
# now refuses to write such a pair, and this covers the appliance that already
# holds one, written by a ze that predates that validation. The web listener
# does not start there, and until this check nothing said why.
#
# The two files are a real certificate and a real key from two different
# elliptic-curve pairs, so the refusal comes from the pair check and not from
# unparseable material. The certificate is valid until 2126, so the expiry
# check stays silent and the run has exactly one finding to read.
#
# The fixture seeds the two keys into the tree store under the working
# directory the runner gives this test, and the doctor opens that store.

option=env:var=ZE_CONFIG_DIR:value=.

tmpfs=web.conf:terminator=EOF_CONF
environment {
	web {
		enabled true
	}
}
EOF_CONF

tmpfs=cert.pem:terminator=EOF_CERT
-----BEGIN CERTIFICATE-----
MIIBmTCCAT+gAwIBAgIUV6fdVuyHSp2yU0lm92eIe2YDyYwwCgYIKoZIzj0EAwIw
ITEfMB0GA1UEAwwWemUtZG9jdG9yLXdlYi10bHMtcGFpcjAgFw0yNjA4MTkwMDEw
MzFaGA8yMTI2MDcyNjAwMTAzMVowITEfMB0GA1UEAwwWemUtZG9jdG9yLXdlYi10
bHMtcGFpcjBZMBMGByqGSM49AgEGCCqGSM49AwEHA0IABMvYAFSikZq0Ku0udGAD
OMTLp7fpw3FZzzmz1YkX61tNRJA1Tz7DWMQwBLTQCDXz7HKLbfxGsG3fy0p3hiAW
6SijUzBRMB0GA1UdDgQWBBRrzv3UZaO93Os2KVqVkeH/o75adzAfBgNVHSMEGDAW
gBRrzv3UZaO93Os2KVqVkeH/o75adzAPBgNVHRMBAf8EBTADAQH/MAoGCCqGSM49
BAMCA0gAMEUCIDBY9QxzYw7Me1tR4Hvap6X/q1FHn6131D1mdcxZMEECAiEA5jeO
cHnFfIoADLXyJ3awp+VfGeYLXoOELeAjmnRZPNM=
-----END CERTIFICATE-----
EOF_CERT

tmpfs=foreign.key:terminator=EOF_KEY
-----BEGIN EC PRIVATE KEY-----
MHcCAQEEILtkYCa9XPlGFLBc1QTJa1+d6bykGJ37mn6tYR9jiDSXoAoGCCqGSM49
AwEHoUQDQgAEdGBWV1c2M0jkumwgual2+1egnbmHqpQ1C3zrEzZpzptTFcVhpV/a
jGgjPUai0Kqk1np08pUYbO0jUiocVBXBnw==
-----END EC PRIVATE KEY-----
EOF_KEY

cmd=foreground:seq=1:exec=le-test fixture ui/doctor-web-tls-pair
expect=exit:code=0
expect=stdout:contains=doctor-tls-invalid
expect=stdout:contains=certificate and key in storage are not a usable pair
expect=stdout:contains=OK: mismatched TLS pair diagnosed
