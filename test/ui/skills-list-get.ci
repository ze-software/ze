# Test: ze show skills and ze show skill — list and get bundled skills
# VALIDATES: AC-13 show skills, AC-14 show skill, AC-14b inner skill

cmd=foreground:seq=1:exec=ze show skills:exit=0
expect=exit:code=0
expect=stdout:contains=ze
expect=stdout:contains=ze-diagnostics

cmd=foreground:seq=2:exec=ze show skill ze:exit=0
expect=exit:code=0
expect=stdout:contains=ze

cmd=foreground:seq=3:exec=ze show skill ze-diagnostics:exit=0
expect=exit:code=0
expect=stdout:contains=diagnostic

cmd=foreground:seq=4:exec=ze show skill ze --full:exit=0
expect=exit:code=0
expect=stdout:contains=ze

cmd=foreground:seq=5:exec=ze show skills --json:exit=0
expect=exit:code=0
expect=stdout:contains="name"
expect=stdout:contains="description"
