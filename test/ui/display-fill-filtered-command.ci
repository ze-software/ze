# Test: `| display` and `| fill` apply to a command that owns pipe filters.
#
# VALIDATES: spec-cli-order-pipe AC-9. `show bgp rib` registers eleven pipe
#            filters of its own, and foldFilters splits a chain into the ones it
#            folds into server arguments and the ones the client still runs. That
#            switch has NO default arm, so an operator kind named nowhere in it
#            reaches neither side and nothing reports the loss. This file drives
#            the real daemon to prove both kinds are named.
#
# The routes are injected rather than learned, because the trap is in the client
# path and needs rows to show in the answer, not a session.
#
# The daemon runs with an ephemeral SSH listener; ZE_SSH_* carry the credentials
# `ze cli` has no flags for.
#
# The timeout is DECLARED because this file starts a daemon and launches `ze`
# several times, which a first (cold) run or a loaded host can take past the
# runner's derived bound while every assertion still holds.
option=timeout:value=60s

tmpfs=run.py:terminator=EOF_PY
import os
import subprocess

from ze_api import wait_until


def require(condition, message):
    if not condition:
        raise SystemExit(message)


def run(argv, env):
    r = subprocess.run(argv, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, env=env, check=False)
    return r.returncode, r.stdout, r.stderr


def cli(env, command):
    code, out, err = run(['ze', 'cli', '-c', command], env)
    require(code == 0, '%s exit=%d: %s%s' % (command, code, out, err))
    return out


def header_of(text):
    # `| text` writes the header row first and draws no border, so the first
    # non-empty line names the columns.
    for line in text.split('\n'):
        fields = line.split()
        if fields:
            return fields
    raise SystemExit('no rib table in: %r' % text)


password_hash = subprocess.check_output(['ze', 'passwd'], input='secret\n', text=True).strip()
with open('rib.conf', 'w', encoding='utf-8') as fh:
    fh.write('''plugin {
    internal bgp-rib {
        use bgp-rib
    }
}

bgp {
    router-id 192.0.2.254
    session {
        asn {
            local 65000
        }
    }
    group transit {
        peer peer1 {
            connection {
                remote {
                    ip 192.0.2.1
                }
                local {
                    ip 127.0.0.1
                }
            }
            session {
                asn {
                    remote 65001
                }
            }
            attach process bgp-rib {
                receive [ update state refresh ]
                send [ update ]
            }
        }
    }
}

system {
    authentication {
        user ci {
            password "''' + password_hash + '''"
            profile [ admin ]
        }
    }
}
''')

daemon_env = os.environ.copy()
daemon_env['ZE_SSH_EPHEMERAL'] = os.path.abspath('ssh.addr')
daemon_env['ZE_READY_FILE'] = os.path.abspath('ready')
daemon_env['ZE_CONFIG_DIR'] = os.getcwd()
# Leave port 179 alone: this suite runs unprivileged and a bind failure there
# takes the daemon down before it writes `ready`.
daemon_env['ze_test_bgp_port'] = str(12000 + os.getpid() % 40000)
daemon = subprocess.Popen(['ze', '-f', 'rib.conf'], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, env=daemon_env)


def daemon_ready():
    if daemon.poll() is not None:
        out, err = daemon.communicate()
        raise SystemExit('daemon exited early\nstdout:\n' + out + '\nstderr:\n' + err)
    return os.path.exists('ssh.addr') and os.path.exists('ready')


try:
    if not wait_until(daemon_ready, attempts=200, delay=0.1):
        raise SystemExit('daemon did not become ready')

    host, port = open('ssh.addr', encoding='utf-8').read().strip().rsplit(':', 1)
    cli_env = os.environ.copy()
    cli_env.update({
        'ZE_SSH_HOST': host,
        'ZE_SSH_PORT': port,
        'ZE_SSH_USERNAME': 'ci',
        'ZE_SSH_PASSWORD': 'secret',
        'ZE_CONFIG_DIR': os.getcwd(),
    })

    cli(cli_env, 'request bgp rib inject 192.0.2.1 ipv4/unicast 10.10.1.0/24 aspath 64501,64502')
    cli(cli_env, 'request bgp rib inject 192.0.2.1 ipv4/unicast 10.20.1.0/24 aspath 64601,64602')

    whole = cli(cli_env, 'show bgp rib | text')
    require('10.10.1.0/24' in whole, 'the injected route is not in the rib: %r' % whole)
    columns = header_of(whole)
    require(len(columns) > 2, 'the rib row is too narrow to say anything: %r' % columns)

    # The trap: an unclassified kind is dropped here in silence, so a passing
    # run needs the answer to CHANGE.
    cut = cli(cli_env, 'show bgp rib | display prefix | text')
    require(header_of(cut) == ['prefix'], 'the display was dropped on a filtered command: %r' % cut)
    require('10.10.1.0/24' in cut, 'the rows went missing with the columns: %r' % cut)

    # `| fill` is the second kind, and it is classified in the same switch.
    filled = cli(cli_env, 'show bgp rib | display prefix | fill alpha | text')
    filled_columns = header_of(filled)
    require(filled_columns[0] == 'prefix', 'the displayed column must lead: %r' % filled_columns)
    require(len(filled_columns) == len(columns), 'fill did not bring every column back: %r' % filled_columns)
    require(filled_columns[1:] == sorted(filled_columns[1:]), 'fill alpha did not order by name: %r' % filled_columns)

    # A server-side filter of the command's own still folds beside them.
    both = cli(cli_env, 'show bgp rib | prefix 10.10 | display prefix | text')
    require('10.10.1.0/24' in both, 'the server-side filter dropped its own route: %r' % both)
    require('10.20.1.0/24' not in both, 'the server-side filter stopped working: %r' % both)
finally:
    daemon.terminate()
    try:
        daemon.wait(timeout=5)
    except subprocess.TimeoutExpired:
        daemon.kill()
        daemon.wait(timeout=5)

print('OK')
EOF_PY

cmd=foreground:seq=1:exec=python3 run.py
expect=exit:code=0
expect=stdout:contains=OK
