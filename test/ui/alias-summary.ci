# Test: `show bgp summary | summary` answers the aggregate fields alone.
#
# VALIDATES: spec-cli-pipe-aliases AC-6. The alias expands to a `display` over
#            the five aggregate keys, and the peer rows are a sibling key that
#            names none of them, so the selection drops the array whole.
#
# The daemon runs with an ephemeral SSH listener; ZE_SSH_* carry the credentials
# `ze cli` has no flags for. The peers never establish, and nothing here needs
# them to: a row is built for every configured peer whatever its state.
#
# The timeout is DECLARED because this file starts a daemon and launches `ze`
# several times, which a first (cold) run or a loaded host can take past the
# runner's derived bound while every assertion still holds.
option=timeout:value=60s

tmpfs=run.py:terminator=EOF_PY
import os
import subprocess

from ze_api import wait_until


def require(condition, message):
    if not condition:
        raise SystemExit(message)


def run(argv, env):
    r = subprocess.run(argv, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, env=env, check=False)
    return r.returncode, r.stdout, r.stderr


password_hash = subprocess.check_output(['ze', 'passwd'], input='secret\n', text=True).strip()
with open('summary.conf', 'w', encoding='utf-8') as fh:
    fh.write('''bgp {
    router-id 10.255.255.254
    session {
        asn {
            local 65000
        }
    }
    group transit {
        peer peer1 {
            connection {
                remote {
                    ip 192.0.2.1
                }
                local {
                    ip 127.0.0.1
                }
            }
            session {
                asn {
                    remote 65001
                }
            }
        }
        peer peer2 {
            connection {
                remote {
                    ip 192.0.2.2
                }
                local {
                    ip 127.0.0.1
                }
            }
            session {
                asn {
                    remote 65002
                }
            }
        }
    }
}

system {
    authentication {
        user ci {
            password "''' + password_hash + '''"
            profile [ admin ]
        }
    }
}
''')

daemon_env = os.environ.copy()
daemon_env['ZE_SSH_EPHEMERAL'] = os.path.abspath('ssh.addr')
daemon_env['ZE_READY_FILE'] = os.path.abspath('ready')
daemon_env['ZE_CONFIG_DIR'] = os.getcwd()
# Leave port 179 alone: this suite runs unprivileged and a bind failure there
# takes the daemon down before it writes `ready`.
daemon_env['ze_test_bgp_port'] = str(12000 + os.getpid() % 40000)
daemon = subprocess.Popen(['ze', '-f', 'summary.conf'], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, env=daemon_env)


def daemon_ready():
    if daemon.poll() is not None:
        out, err = daemon.communicate()
        raise SystemExit('daemon exited early\nstdout:\n' + out + '\nstderr:\n' + err)
    return os.path.exists('ssh.addr') and os.path.exists('ready')


try:
    if not wait_until(daemon_ready, attempts=200, delay=0.1):
        raise SystemExit('daemon did not become ready')

    host, port = open('ssh.addr', encoding='utf-8').read().strip().rsplit(':', 1)
    cli_env = os.environ.copy()
    cli_env.update({
        'ZE_SSH_HOST': host,
        'ZE_SSH_PORT': port,
        'ZE_SSH_USERNAME': 'ci',
        'ZE_SSH_PASSWORD': 'secret',
        'ZE_CONFIG_DIR': os.getcwd(),
    })

    def cli(command):
        code, out, err = run(['ze', 'cli', '-c', command], cli_env)
        require(code == 0, '%s exit=%d: %s%s' % (command, code, out, err))
        return out

    # The whole answer first, so the assertions below measure a CHANGE rather
    # than an answer that was always narrow.
    whole = cli('show bgp summary | text')
    require('192.0.2.1' in whole, 'the peer rows are missing from the whole answer: %r' % whole)
    require('router-id' in whole, 'the summary does not carry router-id: %r' % whole)

    only = cli('show bgp summary | summary | text')
    for key in ('router-id', 'local-as', 'peers-configured', 'peers-established'):
        require(key in only, 'the aggregate %s is missing: %r' % (key, only))
    require('10.255.255.254' in only, 'the router-id value is missing: %r' % only)
    require('192.0.2.1' not in only, 'a peer row survived `| summary`: %r' % only)
    require('192.0.2.2' not in only, 'a peer row survived `| summary`: %r' % only)

    # "peers" is a prefix of two aggregate keys, so the rows array is looked for
    # by the key on a line of its own rather than by the word anywhere.
    for line in only.split('\n'):
        fields = line.split()
        require(not fields or fields[0] != 'peers', 'the peers array survived `| summary`: %r' % only)

    # The alias is a selection, so `| json` carries it too.
    as_json = cli('show bgp summary | summary | json')
    require('router-id' in as_json, '`| summary | json` dropped the aggregates: %r' % as_json)
    require('192.0.2.1' not in as_json, '`| summary | json` kept the peer rows: %r' % as_json)
finally:
    daemon.terminate()
    try:
        daemon.wait(timeout=5)
    except subprocess.TimeoutExpired:
        daemon.kill()
        daemon.wait(timeout=5)

print('OK')
EOF_PY

cmd=foreground:seq=1:exec=python3 run.py
expect=exit:code=0
expect=stdout:contains=OK
