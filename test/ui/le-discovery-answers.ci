# Test: the BUILT le binary generates the discovery indexes and routes the
#       changed-file gate, and it agrees with the scripts it replaces over the
#       real checkout.
#
# VALIDATES: spec-le-is-a-ze-binary AC-1, AC-7 and AC-11 over the REAL TREE, for
#            the discovery cluster of scripts/dev, against the artifact a
#            developer runs.
# PREVENTS: a generator that agrees with its script about the WORD "current" and
#           emits different bytes. ai/PACKAGE-MAP.md is committed and the commit
#           helper refuses a commit whose copy disagrees with the tree, so a port
#           writing different bytes would invalidate that gate for every session
#           on this machine while every verdict comparison still passed.
#
# The byte comparison here regenerates into a COPY of the checkout rather than
# into the checkout, because several sessions share this tree and one of them
# would otherwise find its index rewritten mid-run. The copy carries only what
# both generators read: the four package roots, ai/, and the git metadata the
# router asks about.
#
# The binary is compiled here rather than by the runner, which builds only ze
# and ze-test (internal/test/runner/runner.go, setupBinShims). It is written
# into the test's own directory, so nothing is written back into the checkout.
#
# No feature tag set is needed: neither generator reads the product registry.
# They read the tree.
#
# The timeout is DECLARED because a cold build cache makes the first compile of
# cmd/ze le personality far slower than the steady state, and because the two generators walk
# every Go file in the repository twice each.

option=timeout:value=600s

tmpfs=run.py:terminator=EOF_PY
"""Compile le, then compare each discovery gate with the script it replaces."""
import json
import os
import subprocess


def require(condition, message):
    if not condition:
        raise SystemExit(f'FAIL: {message}')


root = os.environ['ZE_REPO_ROOT']
here = os.getcwd()
binary = os.path.join(here, 'le')

build = subprocess.run(['make', '--no-print-directory', 'le-build',
                        f'ZE_BIN_DIR={os.path.dirname(binary)}'],
                       cwd=root, capture_output=True, text=True, check=False)
require(build.returncode == 0, f'building the cmd/ze le personality failed: {build.stderr}')


def run(argv, cwd, env=None):
    merged = dict(os.environ)
    if env:
        merged.update(env)
    return subprocess.run(argv, cwd=cwd, capture_output=True, text=True,
                          check=False, env=merged)


def script(name, *args, cwd=None):
    return run(['python3', os.path.join('scripts', 'dev', name), *args], cwd or root)


def le(*args, tree=None):
    # Run from the test directory, never from the root: the tree a command
    # judges comes from the checkout it discovers, not from where it was typed.
    return run([binary, *args], here, {'ZE_REPO_ROOT': tree} if tree else None)


# ---------------------------------------------------------------- the bytes --
#
# Two exports of HEAD, one per half. HEAD rather than the working tree because
# this checkout moves under a running test, and HEAD is the same 10,000 files
# for both halves however long each takes.
def export(name):
    dest = os.path.join(here, name)
    os.makedirs(dest, exist_ok=True)
    archive = subprocess.Popen(['git', 'archive', 'HEAD'], cwd=root,
                               stdout=subprocess.PIPE)
    untar = subprocess.Popen(['tar', '-x', '-C', dest], stdin=archive.stdout)
    archive.stdout.close()
    require(untar.wait() == 0, f'unpacking HEAD into {name} failed')
    require(archive.wait() == 0, f'exporting HEAD into {name} failed')
    return dest


for generator, command, output, unit in (
        ('package_map.py', 'discovery-index', 'ai/PACKAGE-MAP.md', 'packages'),
        ('docs_to_code.py', 'docs-to-code', 'ai/DOCS-TO-CODE.md', 'design docs'),
):
    script_tree = export(f'{command}-script')
    command_tree = export(f'{command}-command')

    wrote_script = script(generator, '--root', script_tree)
    require(wrote_script.returncode == 0,
            f'{generator} exited {wrote_script.returncode}: {wrote_script.stderr}')
    wrote_command = le(command, 'update', tree=command_tree)
    require(wrote_command.returncode == 0,
            f'le {command} update exited {wrote_command.returncode}: {wrote_command.stderr}')

    with open(os.path.join(script_tree, output), encoding='utf-8') as handle:
        from_script = handle.read()
    with open(os.path.join(command_tree, output), encoding='utf-8') as handle:
        from_command = handle.read()

    require(from_script == from_command,
            f'{output}: the two halves wrote different bytes\n'
            f'script wrote {len(from_script)} bytes, command wrote {len(from_command)}')
    # A comparison of two empty files proves nothing, and an export that failed
    # to unpack would produce exactly that.
    require(len(from_command) > 10000,
            f'{output} is {len(from_command)} bytes, so the comparison is vacuous')
    require(f'({unit}' in wrote_command.stdout or unit in wrote_command.stdout,
            f'le {command} update did not say what it wrote: {wrote_command.stdout}')

# --------------------------------------------------------------- the router --
#
# The gate that decides which checks a diff needs. Its dry run is compared over
# the WORKING TREE, because the whole point is which files this session changed.
old = script('verify_wiring_docs.py', '--dry-run')
new = le('doc-wiring', 'dry-run')
require(old.returncode == 0 and new.returncode == 0,
        f'doc-wiring dry run: the script exited {old.returncode} and the command {new.returncode}')
require(old.stdout == new.stdout,
        f'doc-wiring dry run: the halves select different gates\n'
        f'script:\n{old.stdout}\ncommand:\n{new.stdout}')
require(new.stderr == '', f'the dry run wrote to stderr: {new.stderr}')

# ------------------------------------------------------ the same verdict --
#
# Over the WORKING TREE the two halves must agree about whether the committed
# map is current, whatever the answer is. Requiring "current" here would redden
# this test whenever another session on this shared checkout adds a package and
# has not regenerated yet, which says nothing about the port.
old = script('package_map.py', '--check')
new = le('discovery-index', 'check')
require(old.returncode == new.returncode,
        f'discovery-index check: the script exited {old.returncode} and the command '
        f'{new.returncode}\nscript:\n{old.stdout}{old.stderr}\ncommand:\n{new.stdout}{new.stderr}')
# The script writes its stale warning to stderr and the command writes it to
# stdout: a verdict is the payload in a command, so it reaches the stream
# `| json` can carry. That is the one deliberate difference.
require((old.stdout + old.stderr) == (new.stdout + new.stderr),
        f'discovery-index check: the halves say different things\n'
        f'script:\n{old.stdout}{old.stderr}\ncommand:\n{new.stdout}{new.stderr}')

# ------------------------------------------------------- one payload, three --
#
# Nothing in any tool writes a line of JSON.
report = le('discovery-index', 'check', '|', 'json')
page = json.loads(report.stdout)
for key in ('file', 'packages', 'todo', 'stale', 'written'):
    require(key in page, f'the gate answered no {key!r} key: {sorted(page)}')
require(len(page['packages']) > 100,
        f"the map describes {len(page['packages'])} packages")
require(page['written'] is False, 'check mode reported a write')
require(all(row['path'] and row['responsibility'] for row in page['packages']),
        'a package row is missing its path or its responsibility')

counted = le('discovery-index', 'check', '|', 'count')
require(counted.stdout.strip() == str(len(page['packages'])),
        f"`| count` answered {counted.stdout!r} for {len(page['packages'])} packages")

# An operator is REFUSED on stderr with nothing rendered. The exit code is the
# gate's own verdict and says nothing about the rendering: over this shared
# checkout the map is stale whenever another session has added a package, and
# the answer is then 3 through every operator alike.
for operator in ('yaml', 'table'):
    rendered = le('discovery-index', 'check', '|', operator)
    require(rendered.stderr == '',
            f'`le discovery-index check | {operator}` was refused: {rendered.stderr}')
    require(len(rendered.stdout) > 1000,
            f'`| {operator}` rendered {len(rendered.stdout)} bytes')

# The router's answer is several lists rather than one row set, so it declares a
# document shape: every rendering works and the row operators are refused by
# name, before the tree is walked.
wiring = json.loads(le('doc-wiring', 'dry-run', '|', 'json').stdout)
for key in ('changed', 'targets', 'checks', 'failure-groups', 'declared-groups'):
    require(key in wiring, f'the router answered no {key!r} key: {sorted(wiring)}')
require(le('doc-wiring', 'dry-run', '|', 'yaml').returncode == 0,
        '`le doc-wiring dry-run | yaml` was refused')

# ------------------------------------------------------------ the refusals --
listing = le('discovery-index')
require(listing.returncode == 0, f'`le discovery-index` exited {listing.returncode}')
for word in ('check', 'update', 'writes', 'checks'):
    require(word in listing.stdout, f'the listing does not carry {word!r}:\n{listing.stdout}')

# An action an area does not hold answers 2, which a caller reads apart from a
# gate that ran and failed.
require(le('discovery-index', 'nonesuch').returncode == 2,
        'an unknown action did not answer 2')
require(le('docs-to-code', 'nonesuch').returncode == 2,
        'an unknown action did not answer 2')

# A value with no keyword before it is refused: keyword before value.
require(le('doc-wiring', 'somefile.go').returncode == 1,
        'a bare value was accepted')
require(le('doc-wiring', 'changed-file').returncode == 1,
        'a keyword with nothing after it was accepted')

# A stale index answers 3, not 1. The commit gate BLOCKS on drift and stays
# warn-only on a generator that failed, so flattening the two would turn a
# blocking gate into an advisory one.
stale_tree = os.path.join(here, 'stale')
os.makedirs(os.path.join(stale_tree, 'ai'), exist_ok=True)
for marker, body in (('go.mod', 'module example.com/stale\n'),
                     ('feature-gates.txt', 'ze_core\n')):
    with open(os.path.join(stale_tree, marker), 'w', encoding='utf-8') as handle:
        handle.write(body)
os.makedirs(os.path.join(stale_tree, 'internal', 'core', 'thing'), exist_ok=True)
with open(os.path.join(stale_tree, 'internal', 'core', 'thing', 'thing.go'),
          'w', encoding='utf-8') as handle:
    handle.write('// Package thing does a thing.\npackage thing\n')
with open(os.path.join(stale_tree, 'ai', 'PACKAGE-MAP.md'), 'w', encoding='utf-8') as handle:
    handle.write('stale\n')

drifted = le('discovery-index', 'check', tree=stale_tree)
require(drifted.returncode == 3,
        f'a stale index answered {drifted.returncode}, want 3: '
        f'{drifted.stdout}{drifted.stderr}')
require(le('discovery-index', 'update', tree=stale_tree).returncode == 0,
        'update did not repair the stale index')
require(le('discovery-index', 'check', tree=stale_tree).returncode == 0,
        'the index update just wrote still reads as stale')

# The same tree, now current, is where each operator's exit code is
# deterministic: 0, because the gate passed and the rendering succeeded.
for operator in ('json', 'yaml', 'table', 'count'):
    rendered = le('discovery-index', 'check', '|', operator, tree=stale_tree)
    require(rendered.returncode == 0,
            f'`| {operator}` over a current tree exited {rendered.returncode}: '
            f'{rendered.stdout}{rendered.stderr}')

print('PASS: le generates the discovery indexes byte for byte and routes the same gates')
EOF_PY

cmd=foreground:seq=1:exec=python3 run.py
expect=exit:code=0
expect=stdout:contains=PASS: le generates the discovery indexes
