# Test: the BUILT le binary publishes the same suite table the Python le
#       publishes, refuses an aggregate integration run, and renders both
#       answers through the pipe operators.
#
# VALIDATES: spec-le-is-a-ze-binary AC-11 over the REAL TREE for the functional
#            and integration areas, AC-7 for both, and the exit-code rule of
#            AC-8 against the artifact a developer runs.
# PREVENTS: a port that agrees with the script in a Go test and disagrees in the
#           binary. The suite table is read by two guards outside this program
#           (scripts/status/verify_run.go and the doc drift check), and BOTH
#           fail closed on an empty or unparseable answer -- so a shape change
#           here disables them rather than failing them, which no unit test of
#           either guard can see.
#
# Nothing here RUNS a suite. A gating run is 25 minutes of .ci work and this
# test is inside one; what is proven is the table, the dispatch and the
# refusals, which is everything between a developer's argv and the suite.
#
# le is compiled with the FULL feature tag set, derived from feature-gates.txt.
# The area reads no registry, but the binary links the product composition root
# through the tools that introspect it, and a reduced set changes what those
# register. Deriving the set here is what keeps this test from asserting about a
# smaller product than the one that ships.
#
# The timeout is DECLARED because a link of the product precedes every check.

option=timeout:value=900s

tmpfs=run.py:terminator=EOF_PY
"""Compile le and check that it agrees with the Python le about both areas."""
import json
import os
import subprocess


def require(condition, message):
    if not condition:
        raise SystemExit(f'FAIL: {message}')


root = os.environ['ZE_REPO_ROOT']
here = os.getcwd()


def feature_tags():
    """ze_core plus every ze_* tag feature-gates.txt declares, sorted."""
    found = set()
    with open(os.path.join(root, 'feature-gates.txt'), encoding='utf-8') as handle:
        for line in handle:
            words = line.split()
            if words and words[0].startswith('ze_'):
                found.add(words[0])
    return ','.join(['ze_core'] + sorted(found))


binary = os.path.join(here, 'le')
built = subprocess.run(['make', '--no-print-directory', 'le-build',
                        f'ZE_BIN_DIR={os.path.dirname(binary)}'],
                       cwd=root, capture_output=True, text=True, check=False)
require(built.returncode == 0, f'building the cmd/ze le personality failed: {built.stderr}')


def run(argv, cwd=here):
    return subprocess.run(argv, cwd=cwd, capture_output=True, text=True, check=False)


# ---- the suite table, both halves ------------------------------------------
# The script, invoked the way its two consumers invoke it.
script = run([os.path.join(root, 'le'), 'functional', '--list', '--json'], cwd=root)
require(script.returncode == 0, f'`./le functional --list --json` exited {script.returncode}')

# The command, invoked the way a developer does: the listing is a keyword and
# the rendering is a pipe operator, because le inherits the CLI contract.
command = run([binary, 'functional', 'list', '|', 'json'])
require(command.returncode == 0, f'`le functional list | json` exited {command.returncode}')

old = json.loads(script.stdout)
new = json.loads(command.stdout)
require(len(old) == len(new),
        f'the script published {len(old)} suites and the command {len(new)}')
require(len(old) > 20,
        f'the comparison ran over {len(old)} suites, which is too few to mean anything')
for left, right in zip(old, new):
    if left != right:
        differing = {k: (left.get(k), right.get(k))
                     for k in set(left) | set(right) if left.get(k) != right.get(k)}
        raise SystemExit(f'FAIL: suite {left.get("name")} differs: {differing}')

# The field the two outside guards actually read.
gating = [row['name'] for row in new if row['gating']]
require(len(gating) == 24, f'the command marks {len(gating)} suites gating, want 24')
for row in new:
    require(row['rerun'] == f'make {row["target"]}',
            f'suite {row["name"]} reruns with {row["rerun"]!r}, which is not its own target')

# ---- one payload, every rendering ------------------------------------------
for operator in ('yaml', 'table'):
    rendered = run([binary, 'functional', 'list', '|', operator])
    require(rendered.returncode == 0, f'`le functional list | {operator}` exited {rendered.returncode}')
    require('encode' in rendered.stdout, f'`| {operator}` dropped the first suite')

# ---- the refusals ----------------------------------------------------------
# A name this area does not hold is 2, which a caller can tell apart from a
# suite that ran and failed.
missing = run([binary, 'functional', 'no-such-suite'])
require(missing.returncode == 2,
        f'`le functional no-such-suite` exited {missing.returncode}, want 2')
require(missing.stdout == '', f'a refused command wrote to stdout: {missing.stdout!r}')

# The integration area names no aggregate run, and the bare command still
# ANSWERS the listing so a reader sees the names.
bare = run([binary, 'integration'])
require(bare.returncode == 2, f'`le integration` exited {bare.returncode}, want the refusal 2')
require('no aggregate run' in bare.stderr, f'the refusal said nothing: {bare.stderr!r}')

listing = run([binary, 'integration', '|', 'json'])
require(listing.returncode == 2, f'`le integration | json` exited {listing.returncode}, want 2')
actions = json.loads(listing.stdout)['actions']
# 12, not 13. The Python integration area declares 21 gates and nine of them
# belong to the Go areas that own their gate-name family: seven ze-deployment-,
# one ze-evidence- and one ze-qemu-. The ze-qemu- one left when its driver was
# ported, and this floor was not lowered with it.
require(len(actions) == 12, f'the integration area listed {len(actions)} gates, want 12')
verbs = {row['verb'] for row in actions}
require('iface-test' in verbs, 'ze-integration-iface-test did not shorten to iface-test')
require('ze-interop-test' in verbs, 'ze-interop-test lost the name every doc and shim spells')

# ---- the census ------------------------------------------------------------
# Both areas are claimed, so no gate of either is named as unported.
census = run([binary, 'parity', '|', 'json'])
counted = json.loads(census.stdout)
gates = json.loads(run([os.path.join(root, 'le'), 'gates', '--json'], cwd=root).stdout)
both = [g['name'] for g in gates if g['area'] in ('functional', 'integration')]
require(len(both) == 52, f'the Python le declares {len(both)} gates in the two areas, want 52')
left_over = [name for name in both if name in counted['unported-gates']]
require(left_over == [], f'these gates are still counted unported: {left_over}')

print('OK')
EOF_PY

cmd=foreground:seq=1:exec=python3 run.py
expect=exit:code=0
expect=stdout:contains=OK
