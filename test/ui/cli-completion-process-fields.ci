# Test: ze config completion — bus endpoint fields
# VALIDATES: bus > endpoint container shows internal, external, receive, send, encoding, format.
# VALIDATES: the removed old-syntax fields (processes, processes-match,
#            neighbor-changes) are not offered.

tmpfs=test.conf:terminator=EOF_CONF
bgp {
	filter {
		import {
			final accept
		}
		export {
			final accept
		}
	}
	router-id 1.2.3.4
	session {
		asn {
			local 65000
		}
	}
	peer peer1 {
		connection {
			remote {
				ip 1.1.1.1
			}
			local {
				ip 127.0.0.1
			}
		}
		session {
			asn {
				remote 65001
			}
		}
	}
}
EOF_CONF

cmd=foreground:seq=1:exec=ze config completion --context bus/endpoint/ep1 --input set+ test.conf
expect=exit:code=0
expect=stdout:contains=external
expect=stdout:contains=internal
expect=stdout:contains=receive
expect=stdout:contains=send
expect=stdout:contains=encoding
expect=stdout:contains=format
reject=stdout:contains=neighbor-changes
reject=stdout:contains=processes
