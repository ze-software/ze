# Test: the BUILT le binary runs the module-tier, repository and digest-anchor
#       gates over the real checkout, and agrees with the three scripts it
#       replaces on every stream and every exit code.
#
# VALIDATES: spec-le-is-a-ze-binary AC-1, AC-7, AC-8 and AC-11 over the REAL
#            TREE, for `dep_audit.py`, `validate.py` and `digest_check.py`,
#            against the artifact a developer runs rather than against a
#            function a test called.
# PREVENTS: a port that agrees with its script inside `go test` and disagrees
#           once the payload goes through the command engine. The pipe
#           operators, the refusals and the exit codes only exist in the built
#           binary; a package test never sees any of them.
#
# The binary is compiled here rather than by the runner, which builds only ze
# and ze-test (internal/test/runner/runner.go, setupBinShims). It is written
# into the test's own directory, so nothing is written back into the checkout.
#
# The comparison runs over the working tree, not over an export, because these
# three gates are what a developer runs against the tree in front of them and
# because the pages are verdicts rather than generated files. Several sessions
# share this checkout, so the two halves are run BACK TO BACK per gate and the
# assertion is on the pages, which change only when the tree does.
#
# No feature tag set is needed: none of the three reads the product registry.
# They read the tree.

option=timeout:value=600s

tmpfs=run.py:terminator=EOF_PY
"""Compile le, then compare each placement gate with the script it replaces."""
import os
import re
import subprocess

# The repository gate is the one that colors its page. The script writes the
# plain three-bit codes and a compiled Ze package may not, so the command writes
# the semantic palette (docs/architecture/cli/color-system.md). The SHADE is
# pinned by internal/le/repository's TestTheTwoSeveritiesAreColoredApart, and it is
# stripped here so this comparison is about the page.
ANSI = re.compile(r'\x1b\[[0-9;]*m')


def plain(text):
    return ANSI.sub('', text)


def require(condition, message):
    if not condition:
        raise SystemExit(f'FAIL: {message}')


root = os.environ['ZE_REPO_ROOT']
here = os.getcwd()
binary = os.path.join(here, 'le')

build = subprocess.run(['make', '--no-print-directory', 'le-build',
                        f'ZE_BIN_DIR={os.path.dirname(binary)}'],
                       cwd=root, capture_output=True, text=True, check=False)
require(build.returncode == 0, f'building the cmd/ze le personality failed: {build.stderr}')


def run(argv):
    return subprocess.run(argv, cwd=root, capture_output=True, text=True, check=False)


def script(*args):
    return run(['python3', os.path.join('scripts', 'dev', args[0]), *args[1:]])


def command(*args):
    return run([binary, *args])


def agree(name, left, right):
    require(left.returncode == right.returncode,
            f'{name}: the script exited {left.returncode} and the command exited {right.returncode}\n'
            f'script:\n{left.stdout}{left.stderr}\ncommand:\n{right.stdout}{right.stderr}')
    require(plain(left.stdout) == plain(right.stdout),
            f'{name}: different stdout\nscript:\n{left.stdout}\ncommand:\n{right.stdout}')
    require(plain(left.stderr) == plain(right.stderr),
            f'{name}: different stderr\nscript:\n{left.stderr}\ncommand:\n{right.stderr}')


# ── ze-digest-check ─────────────────────────────────────────────────────────
agree('ze-digest-check', script('digest_check.py'), command('digest'))

# ── ze-repository-check and ze-repository-tree-check ────────────────────────
agree('ze-repository-tree-check',
      script('validate.py', '--root', '.', '--changed-file', ''),
      command('repository', 'tree-check'))
agree('ze-repository-check',
      script('validate.py', '--root', '.'),
      command('repository', 'check'))

# ── ze-tier-check, ze-tier-selftest and the audit report ────────────────────
agree('ze-tier-check', script('dep_audit.py', '--check'), command('tier', 'check'))
agree('ze-tier-selftest', script('dep_audit.py', '--selftest'), command('tier', 'selftest'))
agree('tier report', script('dep_audit.py'), command('tier', 'report'))

# The audit is the richest of the three: one block per registry, every
# subsystem classified. A comparison of two empty pages would pass silently.
audit = command('tier', 'report')
require(audit.stdout.count('\nAREA: ') == 3,
        f'the audit covered {audit.stdout.count("AREA: ")} registries, want three')
require(audit.stdout.count('\n  ') > 100,
        'the audit lists almost no subsystem, so the comparison is vacuous')

# ── the payload renders through every operator (AC-7) ───────────────────────
for argv, marker in (
    (['digest', '|', 'json'], '"anchors"'),
    (['digest', '|', 'yaml'], 'digests:'),
    (['repository', 'tree-check', '|', 'json'], '"findings"'),
    (['repository', 'tree-check', '|', 'yaml'], 'issues:'),
    (['tier', 'check', '|', 'json'], '"gates"'),
    (['tier', 'report', '|', 'json'], '"module"'),
    (['tier', '|', 'table'], 'write-baseline'),
    (['repository', '|', 'table'], 'tree-check'),
):
    rendered = command(*argv)
    require(rendered.returncode in (0, 1),
            f'{argv} exited {rendered.returncode}: {rendered.stderr}')
    require(marker in rendered.stdout,
            f'{argv} did not render {marker}:\n{rendered.stdout}')

# `| count` acts on a chosen list, which is what a payload holding several of
# them requires.
counted = command('tier', 'check', '|', 'count', 'gates')
require(counted.stdout.strip() == '5',
        f'the check reports {counted.stdout.strip()} gates, want the script\'s five')

# ── the refusals keep their own codes (AC-8) ────────────────────────────────
refused = command('digest', 'nope')
require(refused.returncode == 1, f'a value after a single-gate command exited {refused.returncode}, want 1')
require('takes no arguments' in refused.stderr, f'the refusal does not say why: {refused.stderr}')

refused = command('repository', 'nope')
require(refused.returncode == 2, f'an unknown action exited {refused.returncode}, want 2')
require('no such action in repository' in refused.stderr, f'the refusal does not name the area: {refused.stderr}')

refused = command('tier', 'check', 'extra')
require(refused.returncode == 1, f'a value after an action exited {refused.returncode}, want 1')

# ── every gate is listed in help, so completion and `le --help` reach it ────
# help goes to stderr, which is where the engine writes a page nobody asked to
# pipe.
listed = command('--help')
page = listed.stdout + listed.stderr
for name in ('digest', 'repository', 'tier'):
    require(f'\n  {name} ' in page,
            f'`le --help` does not list {name}:\n{page}')

print('PASS: the three placement gates agree with their scripts over the checkout')
EOF_PY

cmd=foreground:seq=1:exec=python3 run.py
expect=exit:code=0
expect=stdout:contains=PASS: the three placement gates agree with their scripts
