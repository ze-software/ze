# Test: the BUILT le binary runs the three ASD-STE100 prose gates over an export
#       of the committed tree, reports what the script reports, and answers each
#       verdict as data.
#
# VALIDATES: spec-le-is-a-ze-binary AC-1, AC-7 and AC-11 over the WHOLE
#            REPOSITORY, for the gates ported out of scripts/dev/ste_check.py,
#            against the artifact a developer runs.
# PREVENTS: a port that agrees with its script on a fixture and disagrees on the
#           corpus. The review reads 8120 documents and 44957 findings, so a
#           detector that stopped firing on one surface would pass every fixture
#           case while the repository was told its prose is still measured.
#
# The population is a `git archive HEAD` export rather than the working tree.
# Several sessions share this checkout, and one document edited between the two
# runs would make the halves disagree about a tree neither of them got wrong.
# The export carries the script itself, which is tracked, and the script derives
# its checkout from its own __file__ rather than from ZE_REPO_ROOT.
#
# The binary is compiled here rather than by the runner, which builds only ze
# and ze-test (internal/test/runner/runner.go, setupBinShims). It is written
# into the test's own directory, so nothing is written back into the checkout.
#
# No feature tag set is needed: this tool reads the tree, git and markdown, and
# never the product registry.
#
# The timeout is DECLARED because the review is 38 seconds of Python and 44 of
# Go over the whole corpus, and a cold build cache makes the first compile of
# cmd/le far slower than the steady state.

option=timeout:value=900s

tmpfs=run.py:terminator=EOF_PY
"""Compile le, then compare each STE prose gate with its command."""
import json
import os
import subprocess


def require(condition, message):
    if not condition:
        raise SystemExit(f'FAIL: {message}')


root = os.environ['ZE_REPO_ROOT']
here = os.getcwd()
binary = os.path.join(here, 'le')

build = subprocess.run(['go', 'build', '-o', binary, './cmd/le'],
                       cwd=root, capture_output=True, text=True, check=False)
require(build.returncode == 0, f'building cmd/le failed: {build.stderr}')


def run(argv, cwd, env=None):
    merged = dict(os.environ)
    if env:
        merged.update(env)
    return subprocess.run(argv, cwd=cwd, capture_output=True, text=True,
                          check=False, env=merged)


# The committed tree, materialized once. Both halves judge this and nothing else.
export = os.path.join(here, 'export')
os.makedirs(export, exist_ok=True)
archive = subprocess.Popen(['git', 'archive', 'HEAD'], cwd=root,
                           stdout=subprocess.PIPE, stderr=subprocess.PIPE)
untar = subprocess.Popen(['tar', '-x', '-C', export], stdin=archive.stdout,
                         stderr=subprocess.PIPE)
archive.stdout.close()
untar_err = untar.communicate()[1]
require(untar.returncode == 0, f'extracting the export failed: {untar_err}')
require(archive.wait() == 0, 'git archive HEAD failed')
require(os.path.isfile(os.path.join(export, 'scripts', 'dev', 'ste_check.py')),
        'the export carries no copy of the script')

# The export becomes its OWN repository, and that is what makes the ratchet
# below mean anything. Without it the export is an ordinary directory inside
# this checkout, so both halves ask the PARENT repository what changed and both
# answer with whatever the sessions sharing this tree are editing.
for argv in (['init', '--quiet'], ['add', '--all'],
             ['-c', 'user.email=test@example.invalid', '-c', 'user.name=test',
              'commit', '--quiet', '-m', 'export']):
    done = run(['git', *argv], export)
    require(done.returncode == 0, f'git {argv[0]} in the export: {done.stderr}')


def script(*args):
    # The script derives its checkout from its own __file__, so the export's
    # own copy is what judges the export.
    return run(['python3', os.path.join(export, 'scripts', 'dev', 'ste_check.py'), *args],
               export)


def le(*args):
    # Run from the test directory, never from the export: the tree a command
    # judges comes from the checkout it is pointed at, not from where it was
    # typed.
    return run([binary, *args], here, {'ZE_REPO_ROOT': export})


# The whole-tree review: the page, byte for byte.
old = script()
new = le('ste', 'review')
require(old.returncode == 0, f'the script exited {old.returncode}: {old.stdout}{old.stderr}')
require(new.returncode == 0, f'the command exited {new.returncode}: {new.stdout}{new.stderr}')
require(old.stdout == new.stdout,
        'the two review pages differ.\n'
        f'script tail:\n{old.stdout[-1200:]}\ncommand tail:\n{new.stdout[-1200:]}')
require(new.stderr == '', f'the command wrote to stderr: {new.stderr}')

# The page truncates each habit at 15 findings, so two halves can agree on it
# while disagreeing about every finding under the cut. The payload is what says
# they do not.
old_json = json.loads(script('--json').stdout)
new_json = json.loads(le('ste', 'review', '|', 'json').stdout)
require(old_json == new_json,
        'the two review payloads differ: '
        f'{len(old_json["findings"])} findings against {len(new_json["findings"])}, '
        f'{old_json["totals"]} against {new_json["totals"]}')

# A gate that read nothing would print the same shape. These say how much of the
# corpus each half actually read.
require(new_json['documents-reviewed'] > 5000,
        f'the review read {new_json["documents-reviewed"]} documents')
require(sum(new_json['totals'].values()) == len(new_json['findings']),
        'the tally and the finding list disagree')
for surface in ('markdown', 'go-comments', 'yang-descriptions'):
    require(sum(new_json['counts'][surface].values()) > 0,
            f'the {surface} surface contributed no finding')

# The ratchet over the export: it was just committed, so nothing has changed and
# both halves examine zero documents and pass. The gate's own verdict line is
# what is compared, and the script prints it on stdout when it passes.
gate_old = script('--check')
gate_new = le('ste', 'check')
require('in 0 changed document(s)' in gate_new.stdout,
        f'the export is not a clean repository: {gate_new.stdout}')
require(gate_old.returncode == gate_new.returncode,
        f'the gate exited {gate_old.returncode} and the command exited {gate_new.returncode}')
require(gate_old.stdout + gate_old.stderr == gate_new.stdout,
        f'the gate pages differ.\nscript:\n{gate_old.stdout}{gate_old.stderr}\n'
        f'command:\n{gate_new.stdout}')

# The same gate over a document that grew a habit. This is what says the pass
# above is a measurement rather than a gate that stopped firing.
guide = os.path.join(export, 'docs', 'guide', 'quickstart.md')
with open(guide, 'r', encoding='utf-8') as handle:
    original = handle.read()
with open(guide, 'w', encoding='utf-8') as handle:
    handle.write(original + '\nThe daemon may start. It should typically work.\n')

grew_old = script('--check')
grew_new = le('ste', 'check')
require(grew_old.returncode == 3,
        f'the script did not report growth: {grew_old.returncode} {grew_old.stdout}')
require(grew_new.returncode == 3,
        f'the command did not report growth: {grew_new.returncode} {grew_new.stdout}')
require(grew_old.stdout + grew_old.stderr == grew_new.stdout,
        f'the growth pages differ.\nscript:\n{grew_old.stdout}{grew_old.stderr}\n'
        f'command:\n{grew_new.stdout}')

# The changed-file report over the same tree.
changed_old = script('--changed')
changed_new = le('ste', 'review-changed')
require(changed_old.returncode == changed_new.returncode,
        f'review-changed exited {changed_old.returncode} and {changed_new.returncode}')
require(changed_old.stdout + changed_old.stderr == changed_new.stdout,
        f'the changed pages differ.\nscript:\n{changed_old.stdout}\ncommand:\n{changed_new.stdout}')

# The commit-time form: the files of ONE commit rather than the working tree.
# The script takes bare paths; the command types each one after a `file`
# keyword, because a path in an untyped positional slot is what the CLI rule
# bans (ai/rules/cli.md).
scoped_old = script('--check', 'docs/guide/quickstart.md')
scoped_new = le('ste', 'check', 'file', 'docs/guide/quickstart.md')
require(scoped_old.returncode == 3 and scoped_new.returncode == 3,
        f'the scoped gate exited {scoped_old.returncode} and {scoped_new.returncode}')
require(scoped_old.stdout + scoped_old.stderr == scoped_new.stdout,
        f'the scoped pages differ.\nscript:\n{scoped_old.stdout}{scoped_old.stderr}\n'
        f'command:\n{scoped_new.stdout}')

# Naming a file that did NOT change passes, which is what says the scope was
# read rather than the whole tree gated.
other = le('ste', 'check', 'file', 'README.md')
require(other.returncode == 0, f'an unchanged file failed the gate: {other.stdout}')

with open(guide, 'w', encoding='utf-8') as handle:
    handle.write(original)

# Every answer is data, so every pipe operator reaches it with no per-tool code.
for verb in ('check', 'review', 'review-changed'):
    for operator in ('json', 'yaml', 'table'):
        piped = le('ste', verb, '|', operator)
        require(piped.returncode in (0, 3),
                f'`le ste {verb} | {operator}` was refused: {piped.stderr}')
        require(piped.stdout.strip() != '',
                f'`le ste {verb} | {operator}` rendered nothing')

# The three verbs are in the listing, and each says whether it writes. None
# does: this tool reads prose and reports.
listing = le('ste')
for word in ('check', 'review', 'review-changed'):
    require(word in listing.stdout, f'the listing does not carry {word!r}:\n{listing.stdout}')

# Read the flag from the payload rather than from the page: the page carries the
# reason text too, and one of the reasons holds the word "rewrites".
actions = json.loads(le('ste', '|', 'json').stdout)['actions']
require(len(actions) == 3, f'the area lists {len(actions)} actions, want 3')
require(not any(action['writes'] for action in actions),
        f'an action claims to write: {actions}')

# A bare path after a verb that takes none is refused, and so is a keyword the
# action does not hold.
refused = le('ste', 'review', 'docs')
require(refused.returncode == 1, f'a path argument answered {refused.returncode}')
require('takes no arguments' in refused.stderr, f'the refusal is silent: {refused.stderr!r}')

unknown = le('ste', 'check', 'docs/guide/quickstart.md')
require(unknown.returncode == 1, f'a bare path answered {unknown.returncode}')
require('unknown keyword' in unknown.stderr, f'the refusal is silent: {unknown.stderr!r}')

missing = le('ste', 'nonesuch')
require(missing.returncode == 2, f'an action the area does not hold answered {missing.returncode}')

print('OK')
EOF_PY

cmd=foreground:seq=1:exec=python3 run.py
expect=exit:code=0
expect=stdout:contains=OK
