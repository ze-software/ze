# Test: no command under `show bgp` answers the `summary` and `peers` aliases.
#
# VALIDATES: spec-cli-show-bgp-is-the-command AC-7 and assumption A-1, through
#            the real daemon rather than the registry. `registerAliases`
#            (internal/component/bgp/plugins/cmd/peer/peer.go) declares the two
#            aliases on `show bgp`, and a lookup takes the longest registered
#            command path that prefixes the command, so every path below the
#            parent would answer them unless its branch declares emptiness.
# PREVENTS:  `show bgp peer <selector> detail | peers` selecting a `peers` key
#            that answer does not carry and printing nothing, instead of saying
#            the operator named an operator that does not exist here.
#
#            The SELECTOR spellings are the reason this file drives the peer
#            branch. The registry resolves the string the operator typed, and
#            the dispatcher folds `192.0.2.1` out of the middle of it to reach
#            the handler. So `show bgp peer detail` is not a prefix of
#            `show bgp peer 192.0.2.1 detail`, and a registration per leaf
#            leaves the typed spelling resolving `show bgp` after all. The unit
#            table cannot catch a daemon that stops folding selectors.
#
# The daemon runs with an ephemeral SSH listener; ZE_SSH_* carry the credentials
# `ze cli` has no flags for. The peers never establish, and nothing here needs
# them to: a row is built for every configured peer whatever its state.
#
# The timeout is DECLARED because this file starts a daemon and launches `ze`
# several times, which a first (cold) run or a loaded host can take past the
# runner's derived bound while every assertion still holds.
option=timeout:value=60s

tmpfs=run.py:terminator=EOF_PY
import os
import subprocess

from ze_api import wait_until


def require(condition, message):
    if not condition:
        raise SystemExit(message)


def run(argv, env):
    r = subprocess.run(argv, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, env=env, check=False)
    return r.returncode, r.stdout, r.stderr


password_hash = subprocess.check_output(['ze', 'passwd'], input='secret\n', text=True).strip()
with open('children.conf', 'w', encoding='utf-8') as fh:
    fh.write('''bgp {
    router-id 192.0.2.254
    session {
        asn {
            local 65000
        }
    }
    group transit {
        peer peer1 {
            connection {
                remote {
                    ip 192.0.2.1
                }
                local {
                    ip 127.0.0.1
                }
            }
            session {
                asn {
                    remote 65001
                }
            }
        }
    }
}

system {
    authentication {
        user ci {
            password "''' + password_hash + '''"
            profile [ admin ]
        }
    }
}
''')

daemon_env = os.environ.copy()
daemon_env['ZE_SSH_EPHEMERAL'] = os.path.abspath('ssh.addr')
daemon_env['ZE_READY_FILE'] = os.path.abspath('ready')
daemon_env['ZE_CONFIG_DIR'] = os.getcwd()
# Leave port 179 alone: this suite runs unprivileged and a bind failure there
# takes the daemon down before it writes `ready`.
daemon_env['ze_test_bgp_port'] = str(12000 + os.getpid() % 40000)
daemon = subprocess.Popen(['ze', '-f', 'children.conf'], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, env=daemon_env)


def daemon_ready():
    if daemon.poll() is not None:
        out, err = daemon.communicate()
        raise SystemExit('daemon exited early\nstdout:\n' + out + '\nstderr:\n' + err)
    return os.path.exists('ssh.addr') and os.path.exists('ready')


try:
    if not wait_until(daemon_ready, attempts=200, delay=0.1):
        raise SystemExit('daemon did not become ready')

    host, port = open('ssh.addr', encoding='utf-8').read().strip().rsplit(':', 1)
    cli_env = os.environ.copy()
    cli_env.update({
        'ZE_SSH_HOST': host,
        'ZE_SSH_PORT': port,
        'ZE_SSH_USERNAME': 'ci',
        'ZE_SSH_PASSWORD': 'secret',
        'ZE_CONFIG_DIR': os.getcwd(),
    })

    # The control. The parent DOES answer both aliases, so a refusal below is a
    # refusal of the inheritance and not of a feature that never ran.
    code, out, err = run(['ze', 'cli', '-c', 'show bgp | peers | text'], cli_env)
    require(code == 0, 'show bgp | peers exit=%d: %s%s' % (code, out, err))
    require('192.0.2.1' in out, 'the parent alias answered no peer rows: %r' % out)

    code, out, err = run(['ze', 'cli', '-c', 'show bgp | summary | text'], cli_env)
    require(code == 0, 'show bgp | summary exit=%d: %s%s' % (code, out, err))
    require('router-id' in out, 'the parent alias answered no aggregates: %r' % out)

    # Each child is driven with BOTH names, because they are registered together
    # and a repair that reaches one can miss the other.
    children = (
        'show bgp peer list',
        'show bgp peer 192.0.2.1 detail',
        'show bgp peer 192.0.2.1 statistics',
        'show bgp peer 192.0.2.1 capabilities',
    )
    for child in children:
        # The child must answer on its own, so the refusals below cannot be a
        # command that was broken before any pipe was parsed.
        code, out, err = run(['ze', 'cli', '-c', child + ' | text'], cli_env)
        require(code == 0, '%s exit=%d: %s%s' % (child, code, out, err))
        require(out.strip() != '', '%s answered nothing: %r' % (child, out))

        for alias in ('peers', 'summary'):
            command = child + ' | ' + alias
            code, out, err = run(['ze', 'cli', '-c', command], cli_env)
            refusal = out + err
            require('unknown pipe operator' in refusal,
                    '%s: the inherited alias was accepted: exit=%d %r' % (command, code, refusal))
            require(alias in refusal, '%s: the refusal does not name it: %r' % (command, refusal))
finally:
    daemon.terminate()
    try:
        daemon.wait(timeout=5)
    except subprocess.TimeoutExpired:
        daemon.kill()
        daemon.wait(timeout=5)

print('OK')
EOF_PY

cmd=foreground:seq=1:exec=python3 run.py
expect=exit:code=0
expect=stdout:contains=OK
