# Test: the BUILT le binary runs the ported scripts/dev Python gates over the
#       real checkout, reports what each script reports, and answers each
#       verdict as data.
#
# VALIDATES: spec-le-is-a-ze-binary AC-1, AC-7 and AC-11 over the REAL TREE, for
#            the gates ported out of the Python half of scripts/dev, against the
#            artifact a developer runs.
# PREVENTS: a port that agrees with its script on fixtures and disagrees on the
#           checkout. Each of these is a GATE, so a check that quietly stopped
#           firing would pass every unit test and change what the repository is
#           told about itself.
#
# The binary is compiled here rather than by the runner, which builds only ze
# and ze-test (internal/test/runner/runner.go, setupBinShims). It is written
# into the test's own directory, so nothing is written back into the checkout.
#
# No feature tag set is needed: none of these four tools reads the product
# registry. They read the tree, git, and one markdown file.
#
# The timeout is DECLARED because a cold build cache makes the first compile of
# cmd/le far slower than the steady state.

option=timeout:value=300s

tmpfs=run.py:terminator=EOF_PY
"""Compile le, then compare each ported Python gate with its command."""
import json
import os
import subprocess


def require(condition, message):
    if not condition:
        raise SystemExit(f'FAIL: {message}')


root = os.environ['ZE_REPO_ROOT']
here = os.getcwd()
binary = os.path.join(here, 'le')

build = subprocess.run(['go', 'build', '-o', binary, './cmd/le'],
                       cwd=root, capture_output=True, text=True, check=False)
require(build.returncode == 0, f'building cmd/le failed: {build.stderr}')


def run(argv, cwd):
    return subprocess.run(argv, cwd=cwd, capture_output=True, text=True, check=False)


def script(name, *args):
    return run(['python3', os.path.join('scripts', 'dev', name), *args], root)


def le(*args):
    # Run from the test directory, never from the root: the tree a command
    # judges comes from the checkout it discovers, not from where it was typed.
    return run([binary, *args], here)


# Each pair: the script invoked the way its gate invokes it, and the command
# invoked the way a developer does. The two normalizations are DELIBERATE and
# are the only differences either pair carries. Everything else is byte for
# byte.
pairs = [
    ('gokrazy-gosum', script('gokrazy_gosum_check.py'), le('gokrazy-gosum'), None),
    ('arch-map check', script('arch_map.py', '--check'), le('arch-map', 'check'), None),
    ('protocol-skeleton report', script('protocol_skeleton_report.py'),
     le('protocol-skeleton', 'report'), ('--verbose for detail', '| json for detail')),
    ('protocol-skeleton selftest', script('protocol_skeleton_report.py', '--selftest'),
     le('protocol-skeleton', 'selftest'), None),
]

for name, old, new, rewrite in pairs:
    expected = old.stdout
    if rewrite:
        expected = expected.replace(rewrite[0], rewrite[1], 1)
    require(old.returncode == 0,
            f'{name}: this checkout does not pass the gate: {old.stdout}{old.stderr}')
    require(old.returncode == new.returncode,
            f'{name}: the script exited {old.returncode} and the command exited {new.returncode}')
    require(expected == new.stdout,
            f'{name}: the pages differ.\nscript:\n{expected}\ncommand:\n{new.stdout}')
    require(new.stderr == '', f'{name}: the command wrote to stderr: {new.stderr}')

# working-tree is compared for its SHAPE rather than byte for byte, and that is
# not a weaker test by choice. Its whole answer is what the working tree holds,
# this checkout is shared by several sessions at once, and a file written
# between the two runs would make the halves disagree about a tree neither of
# them got wrong. The byte comparison lives over fixture trees, in
# scripts/dev/parity_python_test.go.
old = script('working_tree_check.py')
new = le('working-tree')
require(old.returncode == 0 and new.returncode == 0,
        f'working-tree: the script exited {old.returncode} and the command {new.returncode}')
require(old.stdout.startswith('working tree: ') and new.stdout.startswith('working tree: '),
        f'working-tree: one half printed something else.\n{old.stdout}\n{new.stdout}')

# One payload, every rendering. Nothing in any tool writes a line of JSON.
report = le('gokrazy-gosum', '|', 'json')
try:
    gosum = json.loads(report.stdout)
except json.JSONDecodeError as exc:
    raise SystemExit(f'FAIL: `le gokrazy-gosum | json` did not answer JSON: {exc}\n'
                     f'{report.stdout[:400]}') from exc
for key in ('files', 'shared', 'conflicts'):
    require(key in gosum, f'the gate answered no {key!r} key: {sorted(gosum)}')
require(gosum['files'] >= 1, f"the gate read {gosum['files']} builddir go.sum files")
require(not gosum['conflicts'], f"the gate reported conflicts: {gosum['conflicts']}")
require(le('gokrazy-gosum', '|', 'yaml').returncode == 0, '`le gokrazy-gosum | yaml` was refused')
require(le('gokrazy-gosum', '|', 'table').returncode == 0, '`le gokrazy-gosum | table` was refused')

# A generated block carries its own count, so `| json` says what each list holds
# without anybody parsing the page.
blocks = json.loads(le('arch-map', 'check', '|', 'json').stdout)
require(len(blocks['blocks']) == 3, f"arch-map answered {len(blocks['blocks'])} blocks, want three")
require(all(item['directories'] > 0 for item in blocks['blocks']),
        f"a generated block counted nothing: {blocks['blocks']}")
require(blocks['stale'] is False, 'the architecture lists are stale in this checkout')
require(blocks['written'] is False, 'check mode reported a write')

# The selftest answers its cases as rows, so `| count` acts on them.
cases = json.loads(le('protocol-skeleton', 'selftest', '|', 'json').stdout)
require(isinstance(cases, list) and len(cases) >= 10,
        f'the selftest answered {cases!r}, want a row per case')
require(all(row['passed'] for row in cases), f'a selftest case failed: {cases}')
counted = le('protocol-skeleton', 'selftest', '|', 'count')
require(counted.stdout.strip() == str(len(cases)),
        f'`| count` answered {counted.stdout!r} for {len(cases)} cases')

# The areas list their actions, and each says whether it writes.
listing = le('arch-map')
require(listing.returncode == 0, f'`le arch-map` exited {listing.returncode}')
for word in ('check', 'update', 'writes', 'checks'):
    require(word in listing.stdout, f'the listing does not carry {word!r}:\n{listing.stdout}')

# An action an area does not hold answers 2, which a caller reads apart from a
# gate that ran and failed.
require(le('arch-map', 'nonesuch').returncode == 2, 'an unknown action did not answer 2')

# A command that judges the checkout takes no argument, and a value with no
# keyword before it is refused (ai/rules/cli.md).
refused = le('gokrazy-gosum', 'gokrazy/')
require(refused.returncode == 1, f'a path argument answered {refused.returncode}')
require('takes no arguments' in refused.stderr, f'the refusal is silent: {refused.stderr!r}')
require(le('working-tree', '3').returncode == 1, 'a bare number was accepted as a ceiling')
require(le('working-tree', 'max-areas', 'many').returncode == 1,
        'a ceiling that is not a number was accepted')
require(le('working-tree', 'max-areas', '99').returncode == 0,
        'a ceiling no tree can exceed still failed')

# Every ported command appears in the binary's own help.
helped = le()
for command in ('gokrazy-gosum', 'working-tree', 'arch-map', 'protocol-skeleton'):
    require(command in helped.stdout + helped.stderr,
            f'`le` does not list {command!r} in its help')

print('OK')
EOF_PY

cmd=foreground:seq=1:exec=python3 run.py
expect=exit:code=0
expect=stdout:contains=OK
