# Test: ze doctor reports the runtime kernel check through its user entry point
# VALIDATES: the appliance-runtime-kernel doctor check is registered in ze and runs
# under `ze doctor`. The run sits outside the Ze source tree, so the check cannot
# read gokrazy/kernel and says so rather than pass.
# PREVENTS: a check that only its unit test reaches, and a silent pass when the
# kernel config cannot be read.
# The no-builder wording (since 6aa76ad8a0 it carries the builder's own cause,
# such as an unusable hvf or kvm) needs a host with no builder, so it is proven
# by TestDoctorRuntimeKernelNamesTheBuilderCause, not here.

tmpfs=runtime-kernel.conf:terminator=EOF_CONF
environment {
    ntp {
        enabled true
    }
}
EOF_CONF

cmd=foreground:seq=1:exec=ze doctor --json config runtime-kernel.conf
expect=exit:code=0
expect=stdout:contains=doctor-appliance-runtime-kernel
expect=stdout:contains=cannot check the runtime kernel
expect=stdout:contains=gokrazy/kernel
expect=stdout:contains=run ze doctor from the top of the Ze source tree
