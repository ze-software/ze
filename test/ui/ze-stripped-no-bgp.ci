# Test: a BGP-free binary still serves its non-BGP config surface, and rejects bgp.
#
# VALIDATES: spec-fixit-bgp-off-plugin-functional -- the claim that a bare
# ze_core binary "links zero internal/component/bgp symbols and still runs the
# FIB and static routes" is exercised against a binary that ACTUALLY HAS BGP
# COMPILED OUT, rather than asserted by an `nm` symbol scan alone.
#
# PREVENTS: the gap the spec was opened for. Existing coverage was
# (a) TestBuildTag_Protocols_AbsentBinaryDropsSymbols, which proves symbols are
# absent but nothing about the surviving features working, and
# (b) test/parse/no-bgp-fib-only.ci, which validates a fib{} config against the
# FULL functional binary -- TestBuildTags (internal/test/runner/runner.go) folds
# in every default-on gate including ze_bgp, so it could never have detected the
# non-BGP surface wrongly depending on BGP.
#
# Why ze-stripped: mk/test-functional.mk builds it with tags "ze_core ze_ssh",
# so ze_bgp is off, and the runner puts that binary dir first on PATH -- which
# is what lets this reach it by bare name, the same way ze-stripped-surface.ci
# does. No new harness was needed; the spec assumed none existed.
#
# SCOPE, stated rather than implied: ze-stripped also drops ze_mrt and
# ze_flowexport (both gated in feature-gates.txt), so this covers only the
# ALWAYS-ON half of the claim -- fib and static routes. Proving the MRT and
# flow-export half needs a binary built with the default feature set MINUS
# ze_bgp, which the functional harness does not build today. That stays open.

tmpfs=run.py:terminator=EOF_PY
import subprocess
import sys


def validate(path):
    return subprocess.run(
        ["ze-stripped", "config", "validate", path],
        stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, check=False)


def require(condition, message):
    if not condition:
        raise SystemExit(message)


# 1. The non-BGP surface still parses on a binary with BGP compiled out.
ok = validate("fib-static.conf")
require(ok.returncode == 0,
        f"fib+static config rejected by a BGP-free binary: rc={ok.returncode} out={ok.stdout!r}")
require("valid" in ok.stdout, f"expected a validity report, got {ok.stdout!r}")

# 2. And BGP really is absent. Without this, step 1 would pass just as well on a
#    binary that still carried BGP, which is exactly the vacuity that made the
#    pre-existing parse test unable to detect anything.
bad = validate("with-bgp.conf")
require(bad.returncode != 0,
        f"a bgp block was ACCEPTED by a binary built without ze_bgp: out={bad.stdout!r}")

print("ze-stripped: non-BGP surface valid, bgp rejected")
EOF_PY

tmpfs=fib-static.conf:terminator=EOF_FIB
fib {
    kernel {
    }
}
EOF_FIB

tmpfs=with-bgp.conf:terminator=EOF_BGP
bgp {
    peer peer1 {
        connection {
            remote {
                ip 127.0.0.1
            }
        }
    }
}
EOF_BGP

cmd=foreground:seq=1:exec=python3 run.py
expect=exit:code=0
expect=stdout:contains=non-BGP surface valid, bgp rejected
