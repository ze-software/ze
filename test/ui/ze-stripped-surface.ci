# Test: ze-stripped omits setup commands but keeps update firmware dispatch.
# Exercises the shipped stripped binary through command discovery and daemon-backed CLI dispatch.

tmpfs=run.py:terminator=EOF_PY
import json
import os
import subprocess
import sys
import time

def require(condition, message):
    if not condition:
        raise SystemExit(message)

cmds = {entry['path'] for entry in json.loads(subprocess.check_output(['ze-stripped', 'help', 'command', '--json'], text=True))}
for forbidden in (
    'install',
    'service',
    'uninstall',
):
    require(forbidden not in cmds, f'{forbidden} unexpectedly present')
for required in (
    'update system firmware check',
    'update system firmware download',
    'update system firmware apply',
    'update system firmware restart',
    'update system firmware rollback',
):
    require(required in cmds, f'{required} unexpectedly missing')

install = subprocess.run(['ze-stripped', 'install'], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, check=False)
require(install.returncode != 0, 'install unexpectedly succeeded')
require('not included in ze-stripped' in install.stderr, install.stderr)

password_hash = subprocess.check_output(['ze-stripped', 'passwd'], input='secret\n', text=True).strip()
with open('stripped.conf', 'w', encoding='utf-8') as fh:
    fh.write('''system {
    authentication {
        user ci {
            password "''' + password_hash + '''"
            profile [ admin ]
        }
    }
}
''')

db_path = os.path.join(os.getcwd(), 'database.zefs')
with open('username.txt', 'w', encoding='utf-8') as fh:
    fh.write('ci')
with open('password.txt', 'w', encoding='utf-8') as fh:
    fh.write(password_hash)
for key, src in (
    ('meta/auth/local/username', 'username.txt'),
    ('meta/auth/local/password', 'password.txt'),
):
    subprocess.run(
        ['ze-stripped', 'data', '--path', db_path, 'write', key, src],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        check=True,
    )

daemon_env = os.environ.copy()
daemon_env['ZE_SSH_EPHEMERAL'] = os.path.abspath('ssh.addr')
daemon_env['ZE_READY_FILE'] = os.path.abspath('ready')
daemon_env['ZE_CONFIG_DIR'] = os.getcwd()
daemon = subprocess.Popen(['ze-stripped', '-f', 'stripped.conf'], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, env=daemon_env)
try:
    deadline = time.time() + 15
    while time.time() < deadline:
        if daemon.poll() is not None:
            out, err = daemon.communicate()
            raise SystemExit('daemon exited early\nstdout:\n' + out + '\nstderr:\n' + err)
        if os.path.exists('ssh.addr') and os.path.exists('ready'):
            break
        time.sleep(0.1)
    else:
        raise SystemExit('daemon did not become ready')

    host, port = open('ssh.addr', encoding='utf-8').read().strip().rsplit(':', 1)
    cli_env = os.environ.copy()
    cli_env.update({
        'ZE_SSH_HOST': host,
        'ZE_SSH_PORT': port,
        'ZE_SSH_USERNAME': 'ci',
        'ZE_SSH_PASSWORD': 'secret',
        'ZE_CONFIG_DIR': os.getcwd(),
    })
    subprocess.run(
        ['ze-stripped', 'data', '--path', db_path, 'write', f'meta/ssh/{host}/{port}/username', 'username.txt'],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        env=cli_env,
        check=True,
    )
    result = subprocess.run(
        ['ze-stripped', 'cli', '-c', 'update system firmware check'],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        env=cli_env,
        check=False,
    )
    combined = result.stdout + result.stderr
    require(result.returncode != 0, 'firmware check unexpectedly succeeded: ' + combined)
    require('self-update unavailable in ze-stripped' in combined, combined)
    require('update checker not configured' not in combined, combined)
finally:
    daemon.terminate()
    try:
        daemon.wait(timeout=5)
    except subprocess.TimeoutExpired:
        daemon.kill()
        daemon.wait(timeout=5)

print('OK')
EOF_PY

cmd=foreground:seq=1:exec=python3 run.py
expect=exit:code=0
expect=stdout:contains=OK
