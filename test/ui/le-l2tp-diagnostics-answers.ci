# Test: the built le binary drives both native L2TP diagnostics through the
#       Linux recording seam and renders their shared structured report.
#
# VALIDATES: gateless keyword grammar, all selectors, exact netlink payloads,
#            retained-object data, JSON, YAML, table, and CGO-free full tags.
# PREVENTS: a source-file fork, side effects before validation, or a diagnostic
#           that bypasses the shared le renderer.

option=timeout:value=300s

tmpfs=run.py:terminator=EOF_PY
import json
import os
import subprocess


def require(condition, message):
    if not condition:
        raise SystemExit(f'FAIL: {message}')


root = os.environ['ZE_REPO_ROOT']
work = os.getcwd()


def feature_tags():
    found = set()
    with open(os.path.join(root, 'feature-gates.txt'), encoding='utf-8') as handle:
        for line in handle:
            words = line.split()
            if words and words[0].startswith('ze_'):
                found.add(words[0])
    found.add('ze_test')
    return ','.join(['ze_core'] + sorted(found))


binary = os.path.join(work, 'le')
build_env = dict(os.environ)
build_env['CGO_ENABLED'] = '0'
compiled = subprocess.run(
    ['make', '--no-print-directory', 'le-build', f'ZE_BIN_DIR={os.path.dirname(binary)}'],
    cwd=root, capture_output=True, text=True, check=False, env=build_env,
)
require(compiled.returncode == 0, f'compiling le failed: {compiled.stderr}')


def le(record, *args):
    env = dict(os.environ)
    env['ZE_TEST_L2TP_DIAGNOSTIC_RECORD'] = os.path.join(work, record)
    return subprocess.run([binary, 'deployment', *args], capture_output=True,
                          text=True, check=False, env=env)


def calls(record):
    with open(os.path.join(work, record), encoding='utf-8') as handle:
        return [json.loads(line) for line in handle if line.strip()]


invalid_record = os.path.join(work, 'invalid.ndjson')
invalid = le('invalid.ndjson', 'l2tp-tunnel-diag', 'local', 'not-an-address')
require(invalid.returncode == 1, f'invalid address exited {invalid.returncode}')
require(not os.path.exists(invalid_record), 'invalid input reached the Linux seam')

pppox_args = (
    'l2tp-pppox-diag',
    'local', '0.0.0.0', 'remote', '127.0.0.1',
    'source-port', '1701', 'destination-port', '1701',
    'tunnel-id', '1', 'peer-tunnel-id', '100',
    'session-id', '1', 'peer-session-id', '100',
)
pppox = le('pppox.ndjson', *pppox_args, '|', 'json')
require(pppox.returncode == 0, f'PPPoX diagnostic failed: {pppox.stderr}')
pppox_report = json.loads(pppox.stdout)
require(pppox_report['diagnostic'] == 'l2tp-pppox-diag', pppox_report)
require(pppox_report['verdict'] == 'working', pppox_report)
require([item['kind'] for item in pppox_report['retained']] == ['tunnel', 'session'],
        f'PPPoX retained objects changed: {pppox_report}')
pppox_calls = calls('pppox.ndjson')
require([call['operation'] for call in pppox_calls] == [
    'socket inet', 'setsockopt reuseport', 'bind udp', 'resolve family',
    'tunnel-create', 'tunnel-dump', 'session-create', 'session-dump',
    'socket pppox', 'connect pppox', 'ioctl get channel', 'open /dev/ppp',
    'ioctl attach channel', 'open /dev/ppp', 'ioctl new unit',
    'ioctl connect unit', 'link ppp0',
], f'PPPoX operation order changed: {pppox_calls}')
by_name = {call['operation']: call for call in pppox_calls}
require(by_name['tunnel-create']['payload'] ==
        '01010000080009000100000008000a00640000000500070002000000'
        '06000200000000000800170003000000', by_name['tunnel-create'])
require(by_name['session-create']['payload'] ==
        '05010000080009000100000008000b000100000008000c0064000000'
        '0600010007000000', by_name['session-create'])
require(by_name['connect pppox']['payload'] ==
        '1800010000000000000003000000020006a57f00000100000000000000'
        '000100010064006400', by_name['connect pppox'])


tunnel_args = (
    'l2tp-tunnel-diag',
    'local', '172.30.0.1', 'remote', '172.30.0.2',
    'source-port', '1701', 'destination-port', '1702',
    'tunnel-id', '1', 'peer-tunnel-id', '100',
)
tunnel = le('tunnel.ndjson', *tunnel_args, '|', 'json')
require(tunnel.returncode == 0, f'tunnel diagnostic failed: {tunnel.stderr}')
tunnel_report = json.loads(tunnel.stdout)
require(tunnel_report['verdict'] == 'working', tunnel_report)
require(len(tunnel_report['retained']) == 1 and
        tunnel_report['retained'][0]['kind'] == 'tunnel', tunnel_report)
tunnel_calls = calls('tunnel.ndjson')
require([call['operation'] for call in tunnel_calls] ==
        ['resolve family', 'tunnel-create', 'tunnel-dump'], tunnel_calls)
require(tunnel_calls[1]['payload'] ==
        '01010000080009000100000008000a00640000000500070003000000'
        '060002000000000006001a00a506000006001b00a6060000'
        '08001800ac1e000108001900ac1e0002', tunnel_calls[1])


yaml = le('yaml.ndjson', *tunnel_args, '|', 'yaml')
require(yaml.returncode == 0 and 'diagnostic: l2tp-tunnel-diag' in yaml.stdout,
        f'YAML rendering failed: {yaml.stdout}{yaml.stderr}')
table = le('table.ndjson', *pppox_args, '|', 'table')
require(table.returncode == 0 and 'l2tp-pppox-diag' in table.stdout,
        f'table rendering failed: {table.stdout}{table.stderr}')
print('LE_L2TP_DIAGNOSTICS_ANSWERS_OK')
EOF_PY

cmd=foreground:seq=1:exec=python3 run.py
expect=exit:code=0
expect=stdout:contains=LE_L2TP_DIAGNOSTICS_ANSWERS_OK
