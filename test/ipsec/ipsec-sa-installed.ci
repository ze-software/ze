# Functional test: IKEv2 SA establishment between two local daemons
# Spec: plan/spec-ipsec-0-umbrella.md wiring row "ipsec-sa-installed"; wired by
# spec-test-coverage-gaps (AC-2/AC-3).
#
# Two unprivileged ze instances negotiate IKEv2 over loopback: the responder
# binds 127.0.0.2, the initiator 127.0.0.1, sharing one high-port knob
# (ze.test.ike.port -- internal/component/ike/engine/testport.go; production
# keeps the well-known UDP 500). The engine-steps executor on the initiator
# waits for the vpn-ipsec/sa-up event and asserts `show vpn ipsec sa` reports
# the peer established -- control-plane proof through user entry points.
#
# // the original (never-executed) revision asserted the kernel
# XFRM state too; XFRM install needs CAP_NET_ADMIN and cannot run natively
# unprivileged. Kernel-state assertions stay with the strongSwan interop lab
# (test/interop-ipsec/) and the QEMU pass; this test gates the IKEv2
# control plane (negotiation, SA table, sa-up event) natively.

option=env:var=ze_test_ike_port:value=$PORT2
# noop dataplane: unprivileged XFRM install is EPERM-fatal by design
# (engine/child.go); control-plane tests opt out of the kernel entirely
# (internal/component/ike/dataplane/noop.go).
option=env:var=ze_test_ike_dataplane:value=noop
option=timeout:value=40s

# ── Responder daemon (background): waits for the initiator on 127.0.0.2 ──
stdin=responder:terminator=EOF_RESPONDER
bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65533
				remote 65533
			}
			router-id 2.2.2.2
			family {
				ipv4/unicast { prefix { maximum 100; } }
			}
		}
	}
}

vpn {
	ipsec {
		esp-group esp-default {
			lifetime 3600
			proposal 1 {
				encryption aes256
				hash sha256
			}
		}
		ike-group ike-default {
			key-exchange ikev2
			lifetime 28800
			proposal 1 {
				dh-group 14
				encryption aes256
				hash sha256
			}
		}
		site-to-site {
			peer initiator {
				ike-group ike-default
				esp-group esp-default
				connection-type respond
				local-address 127.0.0.2
				remote-address 127.0.0.1
				authentication {
					mode pre-shared-secret
					pre-shared-secret test-key-1234
				}
			}
		}
	}
}
EOF_RESPONDER

# ── Initiator daemon (foreground) with the engine-steps executor ──
stdin=config:terminator=EOF_CONFIG
plugin {
	external engine-steps {
		run "ze-test engine-steps ./engine-steps.json"
		encoder json
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65533
				remote 65533
			}
			router-id 1.1.1.1
			family {
				ipv4/unicast { prefix { maximum 100; } }
			}
		}
	}
}

vpn {
	ipsec {
		esp-group esp-default {
			lifetime 3600
			proposal 1 {
				encryption aes256
				hash sha256
			}
		}
		ike-group ike-default {
			key-exchange ikev2
			lifetime 28800
			proposal 1 {
				dh-group 14
				encryption aes256
				hash sha256
			}
		}
		site-to-site {
			peer peer-1 {
				ike-group ike-default
				esp-group esp-default
				connection-type initiate
				local-address 127.0.0.1
				remote-address 127.0.0.2
				authentication {
					mode pre-shared-secret
					pre-shared-secret test-key-1234
				}
			}
		}
	}
}
EOF_CONFIG

cmd=background:seq=1:exec=ze -:stdin=responder
cmd=foreground:seq=2:exec=ze -:stdin=config:timeout=35s

# The FIRST sa-up of the run, which is the one an operator subscriber wants and
# the one nothing used to reach. The IKE engine defers its startup peer
# reconciliation to OnAllPluginsReady (ike/engine/register.go) so this event has
# a subscriber when it fires, and the executor declares its subscription before
# Run with enveloped delivery (internal/test/cli/cmd_engine_steps.go) so a
# delivery that beats the step still matches. Nothing here re-establishes, so a
# step-time subscribe would have no second sa-up to fall back on.
expect=event:namespace=vpn-ipsec:name=sa-up:timeout=20

# The initiator then polls `show vpn ipsec sa` until the negotiated SA reports
# the peer established -- proof that two unprivileged ze instances complete
# IKEv2 end to end (IKE_SA_INIT + IKE_AUTH over loopback, no CAP_NET_ADMIN).
command=show vpn ipsec sa
expect=output:contains=peer-1:timeout=20
# Gate on the negotiated ESP encryption algorithm (aes-cbc), which the SA row
# only carries once IKE_AUTH completes -- a REAL "established" proof. A plain
# `contains=established` would false-match the always-present "established-at"
# key while the SA is still sa-init-sent, so it is not a valid establishment
# gate (it once passed even when the two daemons shared one config file and no
# SA ever formed).
command=show vpn ipsec sa | json
expect=output:contains=aes-cbc:timeout=20
expect=output:contains=sha256:timeout=5
expect=exit:code=0
expect=stderr:contains=engine-steps: all steps passed
reject=stderr:pattern=panic recovered
reject=stderr:pattern=fatal error
