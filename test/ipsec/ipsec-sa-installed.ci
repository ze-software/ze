# Functional test: Child SA installed after IKE_AUTH
# Spec: plan/spec-ipsec-8-ikev2-child-xfrm.md (AC-1, AC-2, AC-3)
#
# Verifies: IKE_SA_INIT + IKE_AUTH complete, first Child SA created,
# dataplane InstallSA called with correct SPI, keys, if_id.
#
# Prerequisites: two ze instances with IPsec config, XFRM interfaces created.
# This test uses the IKE engine's internal event bus to verify SA installation.

# ze-test peer config for initiator
stdin=config:terminator=EOF_CONFIG
{
  "vpn": {
    "ipsec": {
      "esp-group": {
        "esp-default": {
          "lifetime": "3600",
          "proposal": {
            "1": {
              "encryption": "aes256",
              "hash": "sha256"
            }
          }
        }
      },
      "ike-group": {
        "ike-default": {
          "key-exchange": "ikev2",
          "lifetime": "28800",
          "proposal": {
            "1": {
              "dh-group": "14",
              "encryption": "aes256",
              "hash": "sha256"
            }
          }
        }
      },
      "site-to-site": {
        "peer-1": {
          "ike-group": "ike-default",
          "esp-group": "esp-default",
          "connection-type": "initiate",
          "local-address": "10.0.0.1",
          "remote-address": "10.0.0.2",
          "authentication": {
            "mode": "pre-shared-secret",
            "pre-shared-secret": "test-key-1234"
          }
        }
      }
    }
  }
}
EOF_CONFIG

# Expect: IKE SA established
expect=event:namespace=vpn-ipsec:name=sa-up:timeout=10

# Expect: Child SA installed
expect=event:namespace=vpn-ipsec:name=child-up:timeout=5
