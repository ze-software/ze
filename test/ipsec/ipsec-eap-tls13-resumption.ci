# Functional test: an EAP-TLS 1.3 authentication that follows an earlier one
# RESUMES it, through two real ze daemons. Spec: spec-ipsec-rfc9190, AC-4.
#
# RFC 9190 Section 2.1.2 makes issuing a session ticket a MUST on the EAP-TLS
# server, and Section 2.1.3 leaves using it to each end. The unit tests in
# internal/core/eap drive both roles over an in-memory transport; this test is
# what proves the ticket survives the things a daemon does between two
# authentications: the SA is torn down, the peer session is destroyed and
# rebuilt, and the store is looked up again by peer name
# (resumptionFor, internal/component/ike/engine/resumption.go).
#
# THERE IS NO INTEROP SCENARIO FOR THIS, and that is a finding rather than an
# omission (owner ruling 2026-09-08). No third-party implementation in the lab
# can drive ze's RFC 9190 resumption: strongSwan 5.9.14's TLS client never sends
# psk_key_exchange_modes (src/libtls/tls_peer.c send_client_hello) and its
# tls_cache_create has no caller, Libreswan states in its own comment that
# ikev2_eap.c carries "EAP responder transitions, there is no initiator code"
# and exports the MSK with the RFC 5216 label unconditionally, and OpenIKED
# speaks EAP-MSCHAPv2 only. Scenarios eap-tls, eap-tls13 and
# responder-eap-tls13 staying green is the evidence that issuing a ticket is
# invisible to a peer that does not resume.
#
# DISCRIMINATION, MEASURED 2026-09-08. With resumptionFor made to build a fresh
# store on every lookup, this test goes RED at 8.1s: the second authentication
# logs resumed=false and the expect for resumed=true finds nothing. With the
# lookup restored it is GREEN at 6.1s. That break is exactly the defect a
# per-session ticket key would be.
#
# THE OBSERVABLE IS THE LOG LINE, because nothing else reports it: DidResume
# appears in no CLI output and `show vpn ipsec sa | json` carries no EAP field.
# recordEAPTLSAuthentication (engine/resumption.go) writes one line per
# completed EAP-TLS authentication, on both roles, naming the outcome, and it
# also moves ze_ipsec_eap_tls_resumption_hits_total.
#
# WHAT MAKES IT FAIL. The first authentication logs resumed=false and the second
# logs resumed=true. A regression that loses the ticket -- a per-session ticket
# key, a peer that stops reading post-handshake records, a store rebuilt with
# the peer session -- leaves BOTH lines reading resumed=false, and the
# expect below finds no resumed=true.

option=env:var=ze_test_ike_port:value=$PORT2
# noop dataplane: unprivileged XFRM install is EPERM-fatal by design
# (engine/child.go); control-plane tests opt out of the kernel entirely.
option=env:var=ze_test_ike_dataplane:value=noop
# recordEAPTLSAuthentication logs at Info, and the default level is WARN.
option=env:var=ze_log_ike:value=info
# 90s: two complete EAP-TLS 1.3 authentications, plus the teardown between.
option=timeout:value=90s

# THE `crl` LEAF IS LOAD-BEARING, on both ends. Both daemons are Go, so they
# negotiate TLS 1.3, and RFC 9190 Section 5.4 makes the revocation status of every
# certificate on the chain mandatory to check there. A ca holding no list cannot
# answer that question, so ze refuses the exchange and no SA is established
# (checkChainRevocation, internal/core/eap/revocation.go). The list here revokes
# nothing, which is a real answer and is what a CA publishes while it has
# withdrawn no certificate. The whole PKI was reissued on 2026-09-05 to get a CA
# key that could sign one.
#
# ── Responder daemon (background): the EAP-TLS authenticator on 127.0.0.2 ──
stdin=responder:terminator=EOF_RESPONDER
pki {
	ca eap-test-ca {
		certificate 
		crl MIHSMHkCAQEwCgYIKoZIzj0EAwIwGTEXMBUGA1UEAxMOemUtZWFwLXRlc3QtY2EXDTI2MDgxMDE4NDQ0N1oXDTQ2MDgwNTE4NDQ0N1qgLzAtMB8GA1UdIwQYMBaAFIlr30nGHm5YPUhzQzkB+7BHjIZHMAoGA1UdFAQDAgEBMAoGCCqGSM49BAMCA0kAMEYCIQCpJj2n5GIUK1l6dmmf5JLrXAF/qIL8QwVX3bGO4ygqrwIhAJi1ACVWAiBkgbMKZ/dJ2KKZVd3gHLbM3AeLrcbyd/Vy
	}
	certificate eap-server {
		certificate 
		private {
			key MHcCAQEEIIKPDcrLot6VtzsXtUOaIBF/oAI3Jlxifh2JWf4h1EHUoAoGCCqGSM49AwEHoUQDQgAEAab8ockVZkYwPiLwCebDA6E5IjSoxk9o9zGsT4w6eFiPTd6vfqVeo7dWFYa1XYPUaHAkHV2O9DYZO1mxaTzkYg==
		}
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65533
				remote 65533
			}
			router-id 2.2.2.2
			family {
				ipv4/unicast { prefix { maximum 100; } }
			}
		}
	}
}

vpn {
	ipsec {
		esp-group esp-default {
			lifetime 3600
			proposal 1 {
				encryption aes256
				hash sha256
			}
		}
		ike-group ike-default {
			key-exchange ikev2
			lifetime 28800
			proposal 1 {
				dh-group 14
				encryption aes256
				hash sha256
			}
		}
		site-to-site {
			peer initiator {
				ike-group ike-default
				esp-group esp-default
				connection-type respond
				local-address 127.0.0.2
				remote-address 127.0.0.1
				authentication {
					mode eap-tls
					local-id "ze-eap-server"
					remote-id "ze-eap-client"
					certificate eap-server
					ca-certificate eap-test-ca
				}
			}
		}
	}
}
EOF_RESPONDER

# ── Initiator daemon (foreground): the EAP-TLS peer on 127.0.0.1 ──
stdin=config:terminator=EOF_CONFIG
plugin {
	external engine-steps {
		run "ze-test engine-steps ./engine-steps.json"
		encoder json
	}
}

pki {
	ca eap-test-ca {
		certificate 
		crl MIHSMHkCAQEwCgYIKoZIzj0EAwIwGTEXMBUGA1UEAxMOemUtZWFwLXRlc3QtY2EXDTI2MDgxMDE4NDQ0N1oXDTQ2MDgwNTE4NDQ0N1qgLzAtMB8GA1UdIwQYMBaAFIlr30nGHm5YPUhzQzkB+7BHjIZHMAoGA1UdFAQDAgEBMAoGCCqGSM49BAMCA0kAMEYCIQCpJj2n5GIUK1l6dmmf5JLrXAF/qIL8QwVX3bGO4ygqrwIhAJi1ACVWAiBkgbMKZ/dJ2KKZVd3gHLbM3AeLrcbyd/Vy
	}
	certificate eap-client {
		certificate 
		private {
			key MHcCAQEEIJ9snHyIlDelDor37ATQeE3KDOvIhxzzByB1Ny3+xX+coAoGCCqGSM49AwEHoUQDQgAEE5PByejXjoPmXtBgRUfT5rvf96CwAGXewxq+Ann78R0QhPxh6owssgC7I5MOW0pRcpx6WjA0hYatDqFbe3CYjg==
		}
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65533
				remote 65533
			}
			router-id 1.1.1.1
			family {
				ipv4/unicast { prefix { maximum 100; } }
			}
		}
	}
}

vpn {
	ipsec {
		esp-group esp-default {
			lifetime 3600
			proposal 1 {
				encryption aes256
				hash sha256
			}
		}
		ike-group ike-default {
			key-exchange ikev2
			lifetime 28800
			proposal 1 {
				dh-group 14
				encryption aes256
				hash sha256
			}
		}
		site-to-site {
			peer peer-1 {
				ike-group ike-default
				esp-group esp-default
				connection-type initiate
				local-address 127.0.0.1
				remote-address 127.0.0.2
				authentication {
					mode eap-tls
					local-id "ze-eap-client"
					# remote-id is set on purpose. Without it ze warns that every
					# certificate this authority issued authenticates as this peer,
					# and a functional test must not model that configuration.
					remote-id "ze-eap-server"
					certificate eap-client
					ca-certificate eap-test-ca
				}
			}
		}
	}
}
EOF_CONFIG

cmd=background:seq=1:exec=ze -:stdin=responder
cmd=foreground:seq=2:exec=ze -:stdin=config:timeout=80s

# 1. The first authentication. aes-cbc appears only once IKE_AUTH finished, and
#    IKE_AUTH cannot finish without the EAP MSK, so this is a completed EAP-TLS
#    exchange.
command=show vpn ipsec sa | json
expect=output:contains=aes-cbc:timeout=30
expect=output:contains=sha256:timeout=5
# It ran a full handshake: there was no ticket to offer.
expect=stderr:pattern=EAP-TLS authenticated.*resumed=false

# 2. The operator bounces the tunnel. The peer session is destroyed and rebuilt,
#    which is what the resumption store has to outlive.
command=clear vpn ipsec sa
expect=output:contains=clear-all:timeout=5

# 3. The second authentication RESUMES the first.
command=show vpn ipsec sa | json
expect=output:contains=aes-cbc:timeout=40
expect=output:contains=sha256:timeout=5
expect=stderr:pattern=EAP-TLS authenticated.*resumed=true
expect=exit:code=0
expect=stderr:contains=engine-steps: all steps passed
reject=stderr:pattern=panic recovered
reject=stderr:pattern=fatal error
