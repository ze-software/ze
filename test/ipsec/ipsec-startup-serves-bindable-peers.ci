# Functional test: the daemon starts IPsec when the configured interface supplies no address.
# VALIDATES: the STARTUP half of the reload refusal added by
#            spec-fixit-ipsec-peer-reload-ignored. `interface` supplies the local address
#            of every peer that names none, and a reload whose interface read fails must
#            roll the transaction back. Startup must do the opposite: report the condition
#            and apply the configuration, so the peers that carry their own local-address
#            still run. The two answers are the whole difference between the phases.
# PREVENTS: the regression that refusal created. applyIPsecConfig returned it to BOTH
#           callers and OnConfigure only logged it, so an `interface` that could not be
#           read at boot left the engine with no peer session, no IKE socket, no NAT-T
#           socket and no active config at all -- including for peers the interface cannot
#           affect. The same configuration used to warn and serve them.
#
# WHY AN INTERFACE THAT DOES NOT EXIST. `interface` is a plain string leaf
# (internal/component/ike/ipsec/yang/ze-ipsec-conf.yang), so no validator refuses a name
# nothing carries, and iface.Addresses answers such a name with an error. That is the
# lookup-failed branch, and it is what a box reaches when the daemon starts before its WAN
# link does.
#
# WHY BOTH KINDS OF PEER. peer-bound carries its own local-address and is unaffected by
# the interface; peer-unbound depends on it and is the peer the warning is about. A fix
# that dropped the dependent peer instead of refusing the whole config would still start
# peer-bound, so the assertion below names peer-unbound too: the engine applies the
# configuration it was given and says which peers cannot bind.
#
# WHY `ike engine configured`. It is the LAST line applyIPsecConfig writes, after the
# transports, the reconcile and the active-config store. A run that took the refusal
# branch returns before all of it, so this assertion cannot pass over the defect.

option=env:var=ze_test_ike_port:value=$PORT2
option=env:var=ze_log_ike:value=info
option=timeout:value=60s

stdin=config:terminator=EOF_CONFIG
plugin {
	external engine-steps {
		run "ze-test engine-steps ./engine-steps.json"
		encoder json
	}
}

# A bgp block routes the config through the main loader; without it a minimal
# environment-only parser owns plugin{} blocks
# (internal/component/hub/config.go parsePluginBlock).
bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65533
				remote 65533
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 100; } }
			}
		}
	}
}

vpn {
	ipsec {
		# No link carries this name, so the address lookup fails.
		interface ze-absent-test0
		esp-group esp-default {
			lifetime 3600
			proposal 1 {
				encryption aes256
				hash sha256
			}
		}
		ike-group ike-default {
			key-exchange ikev2
			lifetime 28800
			proposal 1 {
				dh-group 14
				encryption aes256
				hash sha256
			}
		}
		site-to-site {
			# Carries its own local-address, so the interface cannot affect it.
			peer peer-bound {
				ike-group ike-default
				esp-group esp-default
				connection-type respond
				local-address 127.0.0.1
				remote-address 127.0.0.2
				authentication {
					mode pre-shared-secret
					pre-shared-secret test-key-1234
				}
			}
			# Names no local-address, so it depends on the interface for one.
			peer peer-unbound {
				ike-group ike-default
				esp-group esp-default
				connection-type respond
				remote-address 127.0.0.3
				authentication {
					mode pre-shared-secret
					pre-shared-secret test-key-5678
				}
			}
		}
	}
}
EOF_CONFIG

cmd=foreground:seq=1:exec=ze -:stdin=config:timeout=45s

# The engine reports the unbindable peers rather than staying quiet about them, and then
# applies the configuration: both peer sessions start and the apply reaches its last line.
command=show vpn ipsec status
expect=stderr:contains=ike: peers without local-address will fail:timeout=20
expect=stderr:contains=ike: started peer:timeout=10
expect=stderr:contains=ike engine configured:timeout=10
expect=output:contains=engine-running:timeout=5
expect=output:contains=configured-peers:timeout=1
expect=exit:code=0
expect=stderr:contains=engine-steps: all steps passed
reject=stderr:pattern=panic recovered
reject=stderr:pattern=fatal error
