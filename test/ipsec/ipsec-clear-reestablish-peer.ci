# Functional test: clear vpn ipsec sa peer <name> re-establishes that peer
# Spec: plan/spec-fixit-ipsec-clear-reestablish.md (AC-2). Copied from
# ipsec-clear-sa.ci; identical two-daemon loopback setup and seams.
#
# Same flow as ipsec-clear-reestablish.ci but the operator bounces ONE peer by
# name (`clear vpn ipsec sa peer peer-1`) and the tunnel for that peer must
# re-establish within the bound. The per-peer path (TerminatePeerSA) is a distinct
# entry point from the all-SAs path (TerminateAllSAs); both StopGraceful the
# session so the peer gets an authenticated INFORMATIONAL Delete (Phase A).
#
# The <=10s AC-2 bound and changed-SPI proof are asserted by the executor at
# CI/QEMU; the mechanism is unit-tested (TestClearSendsIKEDelete, and the
# per-peer/same-map re-init identity via TestTerminateAllSAsReinitiates).

option=env:var=ze_test_ike_port:value=$PORT2
# noop dataplane: unprivileged XFRM install is EPERM-fatal by design.
option=env:var=ze_test_ike_dataplane:value=noop
option=timeout:value=60s

# -- Responder daemon (background): binds 127.0.0.2, waits for the initiator --
stdin=responder:terminator=EOF_RESPONDER
bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65533
				remote 65533
			}
			router-id 2.2.2.2
			family {
				ipv4/unicast { prefix { maximum 100; } }
			}
		}
	}
}

vpn {
	ipsec {
		esp-group esp-default {
			lifetime 3600
			proposal 1 {
				encryption aes256
				hash sha256
			}
		}
		ike-group ike-default {
			key-exchange ikev2
			lifetime 28800
			proposal 1 {
				dh-group 14
				encryption aes256
				hash sha256
			}
		}
		site-to-site {
			peer initiator {
				ike-group ike-default
				esp-group esp-default
				connection-type respond
				local-address 127.0.0.2
				remote-address 127.0.0.1
				authentication {
					mode pre-shared-secret
					pre-shared-secret test-key-1234
				}
			}
		}
	}
}
EOF_RESPONDER

# -- Initiator daemon (foreground) with the engine-steps executor --
stdin=config:terminator=EOF_CONFIG
plugin {
	external engine-steps {
		run "ze-test engine-steps ./engine-steps.json"
		encoder json
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65533
				remote 65533
			}
			router-id 1.1.1.1
			family {
				ipv4/unicast { prefix { maximum 100; } }
			}
		}
	}
}

vpn {
	ipsec {
		esp-group esp-default {
			lifetime 3600
			proposal 1 {
				encryption aes256
				hash sha256
			}
		}
		ike-group ike-default {
			key-exchange ikev2
			lifetime 28800
			proposal 1 {
				dh-group 14
				encryption aes256
				hash sha256
			}
		}
		site-to-site {
			peer peer-1 {
				ike-group ike-default
				esp-group esp-default
				connection-type initiate
				local-address 127.0.0.1
				remote-address 127.0.0.2
				authentication {
					mode pre-shared-secret
					pre-shared-secret test-key-1234
				}
			}
		}
	}
}
EOF_CONFIG

cmd=background:seq=1:exec=ze -:stdin=responder
cmd=foreground:seq=2:exec=ze -:stdin=config:timeout=55s

# 1. Wait for a REAL established SA.
command=show vpn ipsec sa | json
expect=output:contains=aes-cbc:timeout=25
expect=output:contains=sha256:timeout=5
# 2. Operator bounces only peer-1. The clear-peer action is dispatched to the engine.
command=clear vpn ipsec sa peer peer-1
expect=output:contains=clear-peer:timeout=5
expect=output:contains=peer-1:timeout=5
# 3. That peer's tunnel re-establishes within the bound.
command=show vpn ipsec sa | json
expect=output:contains=aes-cbc:timeout=30
expect=output:contains=sha256:timeout=5
expect=exit:code=0
expect=stderr:contains=engine-steps: all steps passed
reject=stderr:pattern=panic recovered
reject=stderr:pattern=fatal error
