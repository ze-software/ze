# Functional test: two overlapping operator SPD entries at distinct orders reach the
# REAL kernel SPD at the priority each order wrote, and read back through
# `show vpn ipsec dataplane policy`.
# Spec: plan/release/fixes/spec-rfc4301-architecture-gaps.md (AC-15, RFC 4301
#       Section 4.4.1: the management interface "MUST support (total) ordering of
#       these entries, as seen via this interface."). The listing is documented in
#       docs/architecture/ike/ipsec-dataplane-inspection.md.
#
# QUESTION: does the order an operator writes decide what the kernel holds, so the
# order seen through the management interface is the order the dataplane searches?
# A unit test reads the builder (spdPolicyParams) and a recording backend; only the
# kernel's own answer, through ListPolicies, shows the priority XFRM searches by.
#
# VALIDATES: `wide` (bypass, order 1000, 198.18.252.0/23 -> 198.18.254.0/24) and
#            `narrow` (discard, order 900, 198.18.252.0/24 -> 198.18.254.0/25), both
#            directions, overlap: a packet from 198.18.252.1 to 198.18.254.1 matches
#            both. Their orders differ, so the commit verifier accepts them
#            (verifySPDOrder), and the kernel holds each outbound half at the
#            priority its order wrote, 900 for the discard and 1000 for the bypass,
#            with the local prefix as the source. The discard entry reads back as
#            action discard (AC-14's read-back half).
# PREVENTS: an order lost between the config and the kernel (every entry at one
#           priority, so the kernel's insertion order decides), and a discard entry
#           installed as bypass.
#
# WHY ONE DAEMON, WHY unmatched bypass, WHY THE PEER: as
# test/ipsec/ipsec-icmp-type-selector.ci. The peer is connection-type respond, nobody
# initiates, and its selectors (198.18.246.0/24 -> 198.18.247.0/24) meet neither
# entry.
#
# WHY THESE PREFIXES. RFC 2544 benchmarking ranges (198.18.252.0/22) no other ipsec
# test installs.
#
# WHY EACH ASSERTION BINDS ITS KEYS ON ONE ROW: as ipsec-icmp-type-selector.ci, the
# keys of a row are sorted and no value is an object, so `[^}]*` stays in one row.
#
# RED PROOF: in internal/component/ike/engine/spd_policy.go spdPolicyParams, write a
# constant priority in place of the entry's order: both assertions fail on
# "priority". Swap SPActionDiscard for SPActionBypass in the builder: the first
# assertion fails on "action".
#
# Gated option=needs-linux:caps=net-admin,bpf: the daemon programs real XFRM
# policies, so this SKIPs on a host without CAP_NET_ADMIN and runs as root in the
# QEMU VM, where `fsuite ipsec` in internal/le/test/qemu/alltests.go executes it.

# bpf: the default `vpn ipsec application-override deny` loads a cgroup setsockopt guard.
option=needs-linux:caps=net-admin,bpf
# Serialize against every other real-XFRM ipsec test: the SPD is NODE-WIDE.
option=exclusive:group=ipsec-xfrm
option=env:var=ze_test_ike_port:value=$PORT2
option=timeout:value=90s
option=env:var=ze_log_ike:value=info

stdin=daemon:terminator=EOF_DAEMON
plugin {
	external engine-steps {
		run "le mock engine-steps ./engine-steps.json"
		encoder json
	}
}

vpn {
	ipsec {
		unmatched bypass
		policy wide {
			action bypass
			order 1000
			direction both
			local {
				prefix 198.18.252.0/23
			}
			remote {
				prefix 198.18.254.0/24
			}
		}
		policy narrow {
			action discard
			order 900
			direction both
			local {
				prefix 198.18.252.0/24
			}
			remote {
				prefix 198.18.254.0/25
			}
		}
		esp-group esp-default {
			lifetime 3600
			proposal 1 {
				encryption aes256
				hash sha256
			}
		}
		ike-group ike-default {
			key-exchange ikev2
			lifetime 28800
			proposal 1 {
				dh-group 14
				encryption aes256
				hash sha256
			}
		}
		site-to-site {
			peer idle {
				# Beside `unmatched bypass`, the default icmp-error-check true is
				# refused by a commit and only logged at a start (verifyICMPOverlap);
				# false keeps this test's subject.
				icmp-error-check false
				ike-group ike-default
				esp-group esp-default
				connection-type respond
				local-address 127.0.0.2
				remote-address 127.0.0.1
				mode tunnel
				traffic-selector 1 {
					local {
						prefix 198.18.246.0/24
					}
					remote {
						prefix 198.18.247.0/24
					}
				}
				authentication {
					mode pre-shared-secret
					pre-shared-secret test-key-1234
				}
			}
		}
	}
}
EOF_DAEMON

# The daemon carries the executor: the engine steps end with `request shutdown`, so
# this process exits when they are done.
cmd=foreground:seq=1:exec=ze -:stdin=daemon:timeout=80s

# ── Engine steps, dispatched inside the daemon ──

command=show vpn ipsec dataplane policy | json
# The discard entry, ranked first: outbound, local prefix as the source, priority 900.
expect=output:matches="action": ?"discard",[^}]*"direction": ?"out",[^}]*"dst": ?"198\.18\.254\.0/25",[^}]*"priority": ?900,[^}]*"role": ?"operator",[^}]*"src": ?"198\.18\.252\.0/24":timeout=30
# The bypass entry it overlaps, ranked after it at priority 1000.
expect=output:matches="action": ?"bypass",[^}]*"direction": ?"out",[^}]*"dst": ?"198\.18\.254\.0/24",[^}]*"priority": ?1000,[^}]*"role": ?"operator",[^}]*"src": ?"198\.18\.252\.0/23":timeout=10

expect=exit:code=0
expect=stderr:contains=engine-steps: all steps passed
reject=stderr:pattern=could not install operator SPD policy
reject=stderr:pattern=share order
reject=stderr:pattern=panic recovered
reject=stderr:pattern=fatal error
