# Functional test: two real ze daemons complete EAP-TLS with explicit
# allowed-identities and server-identity constraints, establish the IPsec SA,
# and log both verified RFC 5216 Section 5.2 identities (peer-id and server-id).
# Spec: spec-eap-tls-identity-authorization, AC-1, AC-2, AC-3, User Story 1.
#
# ONE QUESTION: Does the full daemon path from YANG config through
# validateIPsecSections, eapTLSServerConfig, buildPeerTLSConfig, and
# recordEAPTLSAuthentication authorize matching SAN certificates on both roles
# and log peer-id and server-id? Unit tests drive internal/core/eap and engine
# builders separately; this test proves the real two-daemon IKEv2 + EAP-TLS 1.3
# exchange end-to-end.
#
# ITS PAIR IS ipsec-eap-tls-identity-rejected.ci, which uses the same PKI with
# non-matching allowed-identities and server-identity and proves neither SA
# establishes.

option=env:var=ze_test_ike_port:value=$PORT2
# noop dataplane: unprivileged XFRM install is EPERM-fatal by design
# (engine/child.go); control-plane tests opt out of the kernel entirely.
option=env:var=ze_test_ike_dataplane:value=noop
# recordEAPTLSAuthentication logs at Info, and the default level is WARN.
option=env:var=ze_log_ike:value=info
option=timeout:value=60s

# ── Responder daemon (background): EAP-TLS authenticator on 127.0.0.2 ──
stdin=responder:terminator=EOF_RESPONDER
pki {
	ca eap-test-ca {
		certificate 
		crl MIHQMHkCAQEwCgYIKoZIzj0EAwIwGTEXMBUGA1UEAxMOemUtZWFwLXRlc3QtY2EXDTI2MDgxMDE4NDQ0N1oXDTQ2MDgwNTE4NDQ0N1qgLzAtMB8GA1UdIwQYMBaAFE2XhLsyOrvFrwWX7trQ77dF/BM7MAoGA1UdFAQDAgEBMAoGCCqGSM49BAMCA0cAMEQCIHxLVbhiIqGH5PRxVBG1qI19g05llIsTBLnQvw21YM4BAiAkEtA8swxL2qdZGLsPfob19Y1nYGb9uik87eSglBdzKg==
	}
	certificate eap-server {
		certificate 
		private {
			key MHcCAQEEIIKPDcrLot6VtzsXtUOaIBF/oAI3Jlxifh2JWf4h1EHUoAoGCCqGSM49AwEHoUQDQgAEAab8ockVZkYwPiLwCebDA6E5IjSoxk9o9zGsT4w6eFiPTd6vfqVeo7dWFYa1XYPUaHAkHV2O9DYZO1mxaTzkYg==
		}
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65533
				remote 65533
			}
			router-id 2.2.2.2
			family {
				ipv4/unicast { prefix { maximum 100; } }
			}
		}
	}
}

vpn {
	ipsec {
		esp-group esp-default {
			lifetime 3600
			proposal 1 {
				encryption aes256
				hash sha256
			}
		}
		ike-group ike-default {
			key-exchange ikev2
			lifetime 28800
			proposal 1 {
				dh-group 14
				encryption aes256
				hash sha256
			}
		}
		site-to-site {
			peer initiator {
				ike-group ike-default
				esp-group esp-default
				connection-type respond
				local-address 127.0.0.2
				remote-address 127.0.0.1
				authentication {
					mode eap-tls
					local-id "ze-eap-server"
					remote-id "ze-eap-client"
					certificate eap-server
					ca-certificate eap-test-ca
					allowed-identities "ze-eap-client"
				}
			}
		}
	}
}
EOF_RESPONDER

# ── Initiator daemon (foreground): EAP-TLS peer on 127.0.0.1 ──
stdin=config:terminator=EOF_CONFIG
bus {
	endpoint engine-steps {
		external {
			run "le mock engine-steps ./engine-steps.json";
		}
		encoding json;
	}
}

pki {
	ca eap-test-ca {
		certificate 
		crl MIHQMHkCAQEwCgYIKoZIzj0EAwIwGTEXMBUGA1UEAxMOemUtZWFwLXRlc3QtY2EXDTI2MDgxMDE4NDQ0N1oXDTQ2MDgwNTE4NDQ0N1qgLzAtMB8GA1UdIwQYMBaAFE2XhLsyOrvFrwWX7trQ77dF/BM7MAoGA1UdFAQDAgEBMAoGCCqGSM49BAMCA0cAMEQCIHxLVbhiIqGH5PRxVBG1qI19g05llIsTBLnQvw21YM4BAiAkEtA8swxL2qdZGLsPfob19Y1nYGb9uik87eSglBdzKg==
	}
	certificate eap-client {
		certificate 
		private {
			key MHcCAQEEIJ9snHyIlDelDor37ATQeE3KDOvIhxzzByB1Ny3+xX+coAoGCCqGSM49AwEHoUQDQgAEE5PByejXjoPmXtBgRUfT5rvf96CwAGXewxq+Ann78R0QhPxh6owssgC7I5MOW0pRcpx6WjA0hYatDqFbe3CYjg==
		}
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65533
				remote 65533
			}
			router-id 1.1.1.1
			family {
				ipv4/unicast { prefix { maximum 100; } }
			}
		}
	}
}

vpn {
	ipsec {
		esp-group esp-default {
			lifetime 3600
			proposal 1 {
				encryption aes256
				hash sha256
			}
		}
		ike-group ike-default {
			key-exchange ikev2
			lifetime 28800
			proposal 1 {
				dh-group 14
				encryption aes256
				hash sha256
			}
		}
		site-to-site {
			peer peer-1 {
				ike-group ike-default
				esp-group esp-default
				connection-type initiate
				local-address 127.0.0.1
				remote-address 127.0.0.2
				authentication {
					mode eap-tls
					local-id "ze-eap-client"
					remote-id "ze-eap-server"
					certificate eap-client
					ca-certificate eap-test-ca
					server-identity "ze-eap-server"
				}
			}
		}
	}
}
EOF_CONFIG

cmd=background:seq=1:exec=ze -:stdin=responder
cmd=foreground:seq=2:exec=ze -:stdin=config:timeout=50s

command=show vpn ipsec sa | json
expect=output:contains=aes-cbc:timeout=30
expect=output:contains=sha256:timeout=5
expect=stderr:pattern=EAP-TLS authenticated.*peer-id=ze-eap-client
expect=stderr:pattern=EAP-TLS authenticated.*server-id=ze-eap-server
expect=exit:code=0
expect=stderr:contains=engine-steps: all steps passed
reject=stderr:pattern=not authorized by allowed-identities
reject=stderr:pattern=does not match expected server-identity
reject=stderr:pattern=panic recovered
reject=stderr:pattern=fatal error
