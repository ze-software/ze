# Test: last-peer removal hides a forked IKE engine's retained device finding.
# Spec: plan/release/fixes/spec-ipsec-dual-form-receive-spd-bypass.md (AC-14)
#
# QUESTION: does the running daemon's doctor follow the configured peer set
# across removal and re-addition when the failure state belongs to the actual
# forked ze plugin ike process? The matching internal case does not cross the
# process boundary. The unrelated read warning proves the runtime callback
# continues answering while the device finding is absent.
#
# The zetest-only backend keeps a synthetic retained failure and counter-read
# warning. No handshake, Child SA, BPF program or packet delivery is claimed.
# The identical IKE and observer plugin blocks, and vpn unmatched bypass, stay
# in every configuration. The focused observer reuses live-stages' reload
# fence, then checks the device condition and counter warning in one doctor
# answer. It rejects an unreachable or missing callback in every phase.
#
# The existing apply-time TUN probe remains real. needs-linux sends this case
# through Ze's own-system guest; a successful real probe is not its subject.
#
# DISCRIMINATION: remove only espFormDeviceFindings' tun == nil early return.
# The no-peer stage must fail because the retained device finding survives.

option=needs-linux
option=env:var=ze_test_ike_dataplane:value=recording-esp-form-retained
option=env:var=ze_test_ike_port:value=$PORT2
option=timeout:value=90s

stdin=config:terminator=EOF_CONFIG
plugin {
	external ike {
		run "ze plugin ike"
		encoder json
	}
	external ipsec-doctor-peer-removal-test {
		run "le test fixture ipsec/doctor-peer-removal"
		encoder json
	}
}
vpn {
	ipsec {
		unmatched bypass
		ike-group ike-test {
			key-exchange ikev2
			lifetime 28800
			proposal 1 {
				dh-group 14
				encryption aes256
				hash sha256
			}
		}
		esp-group esp-test {
			lifetime 3600
			proposal 1 {
				encryption aes256
				hash sha256
			}
		}
		site-to-site {
			peer idle-peer {
				connection-type respond
				local-address 127.0.0.1
				remote-address 127.0.0.2
				ike-group ike-test
				esp-group esp-test
				icmp-error-check false
				authentication {
					mode pre-shared-secret
					pre-shared-secret functional-test-key
				}
			}
		}
	}
}
EOF_CONFIG

tmpfs=no-peer.conf:terminator=EOF_NO_PEER
plugin {
	external ike {
		run "ze plugin ike"
		encoder json
	}
	external ipsec-doctor-peer-removal-test {
		run "le test fixture ipsec/doctor-peer-removal"
		encoder json
	}
}
vpn {
	ipsec {
		unmatched bypass
		ike-group ike-test {
			key-exchange ikev2
			lifetime 28800
			proposal 1 {
				dh-group 14
				encryption aes256
				hash sha256
			}
		}
		esp-group esp-test {
			lifetime 3600
			proposal 1 {
				encryption aes256
				hash sha256
			}
		}
	}
}
EOF_NO_PEER

tmpfs=with-peer.conf:terminator=EOF_WITH_PEER
plugin {
	external ike {
		run "ze plugin ike"
		encoder json
	}
	external ipsec-doctor-peer-removal-test {
		run "le test fixture ipsec/doctor-peer-removal"
		encoder json
	}
}
vpn {
	ipsec {
		unmatched bypass
		ike-group ike-test {
			key-exchange ikev2
			lifetime 28800
			proposal 1 {
				dh-group 14
				encryption aes256
				hash sha256
			}
		}
		esp-group esp-test {
			lifetime 3600
			proposal 1 {
				encryption aes256
				hash sha256
			}
		}
		site-to-site {
			peer idle-peer {
				connection-type respond
				local-address 127.0.0.1
				remote-address 127.0.0.2
				ike-group ike-test
				esp-group esp-test
				icmp-error-check false
				authentication {
					mode pre-shared-secret
					pre-shared-secret functional-test-key
				}
			}
		}
	}
}
EOF_WITH_PEER

cmd=foreground:seq=1:exec=ze -:stdin=config:timeout=85s
expect=exit:code=0
expect=stderr:contains=IPSEC_DOCTOR_PEER_REMOVAL_AND_READD_PASSED
reject=stderr:pattern=ZE-OBSERVER-FAIL
reject=stderr:pattern=panic recovered
reject=stderr:pattern=fatal error
