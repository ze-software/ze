# Functional test: DPD timeout triggers close-action
# Spec: plan/spec-ipsec-8-ikev2-child-xfrm.md (AC-5, AC-6)
#
# Verifies: DPD probes sent, peer unreachable, timeout fires,
# connection restarted per close-action.
#
# Prerequisites: two ze instances, one stops responding after SA established.

stdin=config:terminator=EOF_CONFIG
{
  "vpn": {
    "ipsec": {
      "esp-group": {
        "esp-default": {
          "lifetime": "3600",
          "proposal": {
            "1": {
              "encryption": "aes256",
              "hash": "sha256"
            }
          }
        }
      },
      "ike-group": {
        "ike-dpd": {
          "key-exchange": "ikev2",
          "lifetime": "28800",
          "dead-peer-detection": {
            "action": "restart",
            "interval": "2",
            "timeout": "6"
          },
          "proposal": {
            "1": {
              "dh-group": "14",
              "encryption": "aes256",
              "hash": "sha256"
            }
          }
        }
      },
      "site-to-site": {
        "peer-1": {
          "ike-group": "ike-dpd",
          "esp-group": "esp-default",
          "connection-type": "initiate",
          "local-address": "10.0.0.1",
          "remote-address": "10.0.0.2",
          "authentication": {
            "mode": "pre-shared-secret",
            "pre-shared-secret": "test-key-1234"
          }
        }
      }
    }
  }
}
EOF_CONFIG

# Expect: IKE SA established
expect=event:namespace=vpn-ipsec:name=sa-up:timeout=10

# Expect: Child SA installed
expect=event:namespace=vpn-ipsec:name=child-up:timeout=5

# Kill responder to simulate dead peer
# (test harness handles this)

# Expect: Child SA torn down after DPD timeout
expect=event:namespace=vpn-ipsec:name=child-down:timeout=15

# Expect: SA torn down
expect=event:namespace=vpn-ipsec:name=sa-down:timeout=5
