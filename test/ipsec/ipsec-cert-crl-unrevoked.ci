# Functional test: a ca holding a current CRL that does not list the peer's
# certificate leaves that peer authenticating, through two real ze daemons.
# Spec: spec-ike-certificate-revocation-and-purpose, AC-1 (the permitted
# survivor: an unrevoked certificate under the same CRL authenticates).
#
# ITS PAIR IS ipsec-cert-revoked.ci. The PKI differs by the initiator's crl line
# alone: here the same CA's list revokes only serial 0x010005, a serial no
# certificate in this test carries, where the pair's list revokes 0x010003, the
# responder's certificate. A list that is configured and current is therefore
# read, and only the listed serial is refused. This file also loads the
# engine-steps observer, which the pair cannot use because nothing establishes
# there.
#
# THE OBSERVABLE IS THE ESTABLISHED SA. aes-cbc appears in `show vpn ipsec sa`
# on the initiator only once IKE_AUTH finished, and IKE_AUTH finishes only after
# getRemoteCert (engine/cert_payload.go) accepted the responder's certificate
# against the list. A check that refused every chain under a configured list,
# or misread the serial, turns this test red.
option=env:var=ze_test_ike_port:value=$PORT2
# noop dataplane: unprivileged XFRM install is EPERM-fatal by design
# (engine/child.go); control-plane tests opt out of the kernel entirely.
option=env:var=ze_test_ike_dataplane:value=noop
option=timeout:value=60s

# ── Responder daemon (background): x509 authentication on 127.0.0.2. Its ca
# holds no crl, so it checks no revocation and accepts the initiator ──
stdin=responder:terminator=EOF_RESPONDER
pki {
	ca ze-cert-test-ca {
		certificate 
	}
	certificate ze-cert-responder {
		certificate 
		private {
			key MHcCAQEEIMgZHsiqQ6NBDGfi+tJaZQE4tg4hNzooTpbDXYer06PEoAoGCCqGSM49AwEHoUQDQgAElvI2zWkIYG/Pd/CEZ5RE7MBdMw9ljF6mjduyA31dPHfDzLmBYvHSjAhMTCS36LW62UpbRzDYCRVs5mM7VehN8g==
		}
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65533
				remote 65533
			}
			router-id 2.2.2.2
			family {
				ipv4/unicast { prefix { maximum 100; } }
			}
		}
	}
}

vpn {
	ipsec {
		esp-group esp-default {
			lifetime 3600
			proposal 1 {
				encryption aes256
				hash sha256
			}
		}
		ike-group ike-default {
			key-exchange ikev2
			lifetime 28800
			proposal 1 {
				dh-group 14
				encryption aes256
				hash sha256
			}
		}
		site-to-site {
			peer initiator {
				ike-group ike-default
				esp-group esp-default
				connection-type respond
				local-address 127.0.0.2
				remote-address 127.0.0.1
				authentication {
					mode x509
					local-id "ze-cert-responder"
					remote-id "ze-cert-initiator"
					certificate ze-cert-responder
					ca-certificate ze-cert-test-ca
				}
			}
		}
	}
}
EOF_RESPONDER

# ── Initiator daemon (foreground): x509 authentication on 127.0.0.1, judging
# the responder's certificate ──
stdin=config:terminator=EOF_CONFIG
plugin {
	external engine-steps {
		run "le mock engine-steps ./engine-steps.json"
		encoder json
	}
}

pki {
	ca ze-cert-test-ca {
		certificate 
		crl 
	}
	certificate ze-cert-initiator {
		certificate 
		private {
			key MHcCAQEEIEfeLRWC9PEAtTrbIZ6AabjI+MQr8XbWb9cZJCFwC8XCoAoGCCqGSM49AwEHoUQDQgAErxoDb89FQUUzGqVpGpeeQhGjd6VFDZR9oW35DWBzOieE+4E3Zh02FPpP/0w97R4e7FOc60gQGfElGRgwDqx9rA==
		}
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65533
				remote 65533
			}
			router-id 1.1.1.1
			family {
				ipv4/unicast { prefix { maximum 100; } }
			}
		}
	}
}

vpn {
	ipsec {
		esp-group esp-default {
			lifetime 3600
			proposal 1 {
				encryption aes256
				hash sha256
			}
		}
		ike-group ike-default {
			key-exchange ikev2
			lifetime 28800
			proposal 1 {
				dh-group 14
				encryption aes256
				hash sha256
			}
		}
		site-to-site {
			peer peer-1 {
				ike-group ike-default
				esp-group esp-default
				connection-type initiate
				local-address 127.0.0.1
				remote-address 127.0.0.2
				authentication {
					mode x509
					local-id "ze-cert-initiator"
					remote-id "ze-cert-responder"
					certificate ze-cert-initiator
					ca-certificate ze-cert-test-ca
				}
			}
		}
	}
}
EOF_CONFIG

cmd=background:seq=1:exec=ze -:stdin=responder
cmd=foreground:seq=2:exec=ze -:stdin=config:timeout=50s

command=show vpn ipsec sa
expect=output:contains=peer-1:timeout=30
command=show vpn ipsec sa | json
expect=output:contains=aes-cbc:timeout=30
expect=output:contains=sha256:timeout=5
expect=exit:code=0
expect=stderr:contains=engine-steps: all steps passed
reject=stderr:pattern=was revoked by
reject=stderr:pattern=remote AUTH verification failed
reject=stderr:pattern=panic recovered
reject=stderr:pattern=fatal error
