# Functional test: the daemon's doctor names a peer that sent, on its established IKE SA,
# an authenticated message whose payloads do not parse, and the SA stays up.
# Spec: plan/release/fixes/spec-single-owner-lifecycle-4-ike-unauthenticated-input.md
# (closed; the check landed in commits 9019fe4d21..b2ced10cac).
#
# THE ONE QUESTION. When a peer holding the IKE SA's keys sends Ze an INFORMATIONAL
# response that passes its integrity check and whose inner payload chain does not parse,
# does `show doctor` on the running daemon report `doctor-ipsec-peer-malformed-message`
# for that peer, with the SA still established? A unit test hands handleOwnedInbound a
# hand-built SA; only a live daemon proves the real socket path reaches the counted arm
# on the SA the engine's ActiveTable holds, and that the daemon route of doctor runs the
# engine's post-config check over that table.
#
# VALIDATES: checkIPsecPeerMalformedMessage (internal/component/ike/engine/
# doctor_peer_malformed.go), declared in the engine's Registration.DoctorChecks
# (engine/register.go), over the count handleOwnedInbound keeps in its INFORMATIONAL
# response arm (inbound.go, the inboundInvalid case). RFC 7296 Section 3.1 forbids an
# answer to a response, so the drop and its WARN line are Ze's only reaction.
#
# PREVENTS: an authenticated malformed message that leaves no operator-visible record but
# a WARN line, and a malformed response that ends the SA. Red when the
# countPeerMalformedMessage call in that arm is removed, or when the
# ipsec-peer-malformed-message entry leaves Registration.DoctorChecks: the doctor answer
# then never holds the code and the re-dispatched step times out.
#
# HOW. The compiled peer ipsec/malformed-response-peer
# (internal/test/fixture/tunnel_fixture_ipsec_malformed_response.go) binds 127.0.0.3 on
# $PORT2 and initiates to this daemon (127.0.0.2) with the same proposals and
# pre-shared-secret, deriving its keys with Ze's own ike/crypto and encoding with
# ike/wire. After one INFORMATIONAL liveness exchange crosses the established SA, it sends
# exactly one sealed INFORMATIONAL response (Message ID 0, which no rekey of Ze's holds)
# whose inner chain is a Notify header claiming 255 octets with nothing after it. It
# then answers Ze's own INFORMATIONAL requests, so the SA stays up. This daemon is the
# only one, so the runner writes its config to ze-bgp.conf in the work directory, the
# daemon's config directory, which the daemon route of doctor admits.
#
# The daemon uses the noop dataplane: the claim is about IKE state.

option=env:var=ze_test_ike_port:value=$PORT2
option=env:var=ze_test_ike_dataplane:value=noop
option=timeout:value=60s

stdin=config:terminator=EOF_CONFIG
plugin {
	external engine-steps {
		run "le mock engine-steps ./engine-steps.json"
		encoder json
	}
}

vpn {
	ipsec {
		esp-group esp-default {
			lifetime 3600
			proposal 1 {
				encryption aes256
				hash sha256
			}
		}
		ike-group ike-default {
			key-exchange ikev2
			lifetime 28800
			proposal 1 {
				dh-group 14
				encryption aes256
				hash sha256
			}
		}
		site-to-site {
			peer fixture-peer {
				ike-group ike-default
				esp-group esp-default
				connection-type respond
				local-address 127.0.0.2
				remote-address 127.0.0.3
				authentication {
					mode pre-shared-secret
					pre-shared-secret test-key-1234
				}
			}
		}
	}
}
EOF_CONFIG

cmd=background:seq=1:exec=le test fixture ipsec/malformed-response-peer $PORT2:name=peer:timeout=58s:ready=PEER: listening on
expect=stdout:contains=PEER-ESTABLISHED: IKE SA up
expect=stdout:contains=PEER-MALFORMED: sent one sealed INFORMATIONAL response
cmd=foreground:seq=2:exec=ze -:stdin=config:timeout=55s

# ── The daemon's doctor, re-dispatched until the finding is there ──
# The executor splits the pipe chain off before it dispatches, as SSH does
# (pipedEngineDispatch, internal/test/cli/cmd_engine_steps.go), so the daemon
# answers `show doctor config <file>` and the step reads that answer as JSON.
command=show doctor config ze-bgp.conf | json
expect=output:contains=doctor-ipsec-peer-malformed-message:timeout=40
# The finding names the peer and counts the one message the peer sent.
expect=output:contains=ipsec peer fixture-peer sent 1 IKE messages on its live IKE SA:timeout=5

# ── The SA survived the malformed response ──
command=show vpn ipsec sa | json
expect=output:contains=fixture-peer:timeout=5
expect=output:contains=aes-cbc:timeout=5
expect=exit:code=0
expect=stderr:contains=engine-steps: all steps passed

# ── The counted arm's WARN line (inbound.go, the INFORMATIONAL response arm) ──
expect=stderr:contains=ike: INFORMATIONAL response authenticated but its payloads do not parse, dropped

reject=stderr:pattern=ZE-OBSERVER-FAIL
reject=stderr:pattern=panic recovered
reject=stderr:pattern=fatal error
