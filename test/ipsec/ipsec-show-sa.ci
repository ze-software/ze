# Functional test: show vpn ipsec sa
# Spec: plan/spec-ipsec-10-cli-diag.md (AC-1, AC-2, AC-11)
#
# Verifies: show vpn ipsec sa lists SAs with peer, algorithms, uptime.
# Pipe operators (json, table, yaml, count, match) produce valid output.
#
# Prerequisites: two ze instances with IPsec config, SA established.

stdin=config:terminator=EOF_CONFIG
{
  "vpn": {
    "ipsec": {
      "esp-group": {
        "esp-default": {
          "lifetime": "3600",
          "proposal": { "1": { "encryption": "aes256", "hash": "sha256" } }
        }
      },
      "ike-group": {
        "ike-default": {
          "key-exchange": "ikev2",
          "lifetime": "28800",
          "proposal": { "1": { "dh-group": "14", "encryption": "aes256", "hash": "sha256" } }
        }
      },
      "site-to-site": {
        "peer-1": {
          "ike-group": "ike-default",
          "esp-group": "esp-default",
          "connection-type": "initiate",
          "local-address": "10.0.0.1",
          "remote-address": "10.0.0.2",
          "authentication": { "mode": "pre-shared-secret", "pre-shared-secret": "test-key-1234" }
        }
      }
    }
  }
}
EOF_CONFIG

# Wait for SA to establish
expect=event:namespace=vpn-ipsec:name=sa-up:timeout=10

# Run show command
command=show vpn ipsec sa
expect=output:contains=peer-1:timeout=5
expect=output:contains=established:timeout=1
