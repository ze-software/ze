# Functional test: clear vpn ipsec sa re-establishes against a live responder
# Spec: plan/spec-fixit-ipsec-clear-reestablish.md (AC-1). Copied from
# ipsec-clear-sa.ci -- same two-unprivileged-daemon loopback setup, high-port seam
# (ze.test.ike.port), and noop dataplane.
#
# Two ze instances negotiate IKEv2 over loopback (responder binds 127.0.0.2,
# initiator 127.0.0.1). After a REAL SA is established (aes-cbc + sha256 only
# populate `show vpn ipsec sa | json` once IKE_AUTH completes), the initiator's
# engine-steps executor runs `clear vpn ipsec sa` and then re-asserts that the
# tunnel re-establishes -- aes-cbc reappears -- within a BOUNDED window.
#
# Why the bound proves the fix: on unfixed code the responder still holds the
# peer's old SA and drops the initiator's re-sent IKE_SA_INIT (responderBusy held
# across the SA's established life), so the tunnel only self-heals after the
# responder's ~150s DPD timeout. The 60s option (with a 30s re-establish poll) is
# ~2.5x under that path, so a green here cannot be the DPD fallback -- it is the
# graceful-Delete-on-clear (Phase A) plus responder parallel-accept (Phase B) fix.
# The <=10s AC-1 bound and the changed-SPI proof are asserted by the executor at
# CI/QEMU; the unit tests TestClearSendsIKEDelete, TestResponderAcceptsReinitAfter-
# StaleSA and TestResponderSupersedesOnAuthenticatedInit prove the mechanism.

option=env:var=ze_test_ike_port:value=$PORT2
# noop dataplane: unprivileged XFRM install is EPERM-fatal by design.
option=env:var=ze_test_ike_dataplane:value=noop
# 60s total: room for a second full handshake, kept well under the ~150s DPD path
# so the test proves the fix and not the fallback.
option=timeout:value=60s

# -- Responder daemon (background): binds 127.0.0.2, waits for the initiator --
stdin=responder:terminator=EOF_RESPONDER
bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65533
				remote 65533
			}
			router-id 2.2.2.2
			family {
				ipv4/unicast { prefix { maximum 100; } }
			}
		}
	}
}

vpn {
	ipsec {
		esp-group esp-default {
			lifetime 3600
			proposal 1 {
				encryption aes256
				hash sha256
			}
		}
		ike-group ike-default {
			key-exchange ikev2
			lifetime 28800
			proposal 1 {
				dh-group 14
				encryption aes256
				hash sha256
			}
		}
		site-to-site {
			peer initiator {
				ike-group ike-default
				esp-group esp-default
				connection-type respond
				local-address 127.0.0.2
				remote-address 127.0.0.1
				authentication {
					mode pre-shared-secret
					pre-shared-secret test-key-1234
				}
			}
		}
	}
}
EOF_RESPONDER

# -- Initiator daemon (foreground) with the engine-steps executor --
stdin=config:terminator=EOF_CONFIG
plugin {
	external engine-steps {
		run "ze-test engine-steps ./engine-steps.json"
		encoder json
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65533
				remote 65533
			}
			router-id 1.1.1.1
			family {
				ipv4/unicast { prefix { maximum 100; } }
			}
		}
	}
}

vpn {
	ipsec {
		esp-group esp-default {
			lifetime 3600
			proposal 1 {
				encryption aes256
				hash sha256
			}
		}
		ike-group ike-default {
			key-exchange ikev2
			lifetime 28800
			proposal 1 {
				dh-group 14
				encryption aes256
				hash sha256
			}
		}
		site-to-site {
			peer peer-1 {
				ike-group ike-default
				esp-group esp-default
				connection-type initiate
				local-address 127.0.0.1
				remote-address 127.0.0.2
				authentication {
					mode pre-shared-secret
					pre-shared-secret test-key-1234
				}
			}
		}
	}
}
EOF_CONFIG

cmd=background:seq=1:exec=ze -:stdin=responder
cmd=foreground:seq=2:exec=ze -:stdin=config:timeout=55s

# 1. Wait for a REAL established SA (aes-cbc + sha256 appear only after IKE_AUTH).
command=show vpn ipsec sa | json
expect=output:contains=aes-cbc:timeout=25
expect=output:contains=sha256:timeout=5
# 2. Operator bounces the tunnel. The clear-all action is dispatched to the engine,
#    which sends the peer an authenticated INFORMATIONAL Delete (Phase A) and
#    re-initiates.
command=clear vpn ipsec sa
expect=output:contains=clear-all:timeout=5
# 3. The tunnel re-establishes within the bound: aes-cbc reappears on the fresh SA.
#    On unfixed code this would time out (the responder drops the re-init, ~150s).
command=show vpn ipsec sa | json
expect=output:contains=aes-cbc:timeout=30
expect=output:contains=sha256:timeout=5
expect=exit:code=0
expect=stderr:contains=engine-steps: all steps passed
reject=stderr:pattern=panic recovered
reject=stderr:pattern=fatal error
