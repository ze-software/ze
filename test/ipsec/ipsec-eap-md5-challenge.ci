# Functional test: an operator selects the EAP MD5-Challenge method on both ends
# and the tunnel establishes. Spec: spec-eap-notification-and-nak, D-1 option A.
#
# Two unprivileged ze instances negotiate IKEv2 over loopback, exactly as
# ipsec-eap-tls-clienthello.ci does. The responder is the EAP authenticator and
# the initiator is the EAP peer, and both carry authentication mode eap-md5, so
# the whole method runs in real daemons rather than over an in-memory transport.
#
# The subject is the selection surface: the eap-md5 enum value in
# ze-ipsec-conf.yang, ipsec.AuthEAPMD5, and the two producers that read it,
# NewEAPSession (engine/eap_auth.go) for the authenticator and startEAPExchange
# (engine/fsm.go) for the peer. Before this test no configuration reached
# md5ChallengeMethod or handleMD5ChallengeRequest at all.
#
# The gate is the negotiated ESP encryption algorithm on the SA, which appears
# only once IKE_AUTH has finished. IKE_AUTH cannot finish without the AUTH
# payloads of RFC 7296 Section 2.16, and MD5-Challenge derives no MSK, so those
# payloads are the SK_pi and SK_pr pair that section prescribes for a method
# that establishes no shared key. An established SA is therefore the proof that
# the keyless AUTH path works end to end.
#
# The warning is asserted too. RFC 7296 Section 2.16 says such a method SHOULD
# NOT be used, so adopting this configuration writes one line naming the peer,
# the mode and that sentence (warnKeylessEAPModes, engine/eap_auth.go).
#
# WHAT REVERTING PROVES, measured on 2026-09-01: with the AuthEAPMD5 arm of
# eapMethodType (engine/eap_auth.go) deleted, the mode still parses and both
# daemons still start, and the test is RED in 2.9s. The authenticator logs
# `ike: create EAP session failed ... auth mode eap-md5 is not an EAP method`,
# no EAP exchange runs, and `show vpn ipsec sa` never reports peer-1 with a
# negotiated algorithm. Restoring the arm returns it to PASS.
#
# The needles carry no literal colon, because the .ci parser splits a directive
# on it (docs/architecture/testing/ci-format.md).

option=env:var=ze_test_ike_port:value=$PORT2
# noop dataplane: unprivileged XFRM install is EPERM-fatal by design
# (engine/child.go); control-plane tests opt out of the kernel entirely.
option=env:var=ze_test_ike_dataplane:value=noop
option=timeout:value=60s

# ── Responder daemon (background): the EAP authenticator on 127.0.0.2, running
# MD5-Challenge against the shared secret below ──
stdin=responder:terminator=EOF_RESPONDER
pki {
	ca eap-test-ca {
		certificate 
	}
	certificate eap-server {
		certificate 
		private {
			key MHcCAQEEIAtyVG/P13ZcsFIvu3Y6j1tIwu4NTatJnm4dvDsHj72voAoGCCqGSM49AwEHoUQDQgAEz4irhidUXvMf2M8F4mlc8aa4dyztBmHreoYRrUdrDtgK7c6aw6+N0DVGY1KV6SEKzlzUo60tn1XkYTVHqUxBqg==
		}
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65533
				remote 65533
			}
			router-id 2.2.2.2
			family {
				ipv4/unicast { prefix { maximum 100; } }
			}
		}
	}
}

vpn {
	ipsec {
		esp-group esp-default {
			lifetime 3600
			proposal 1 {
				encryption aes256
				hash sha256
			}
		}
		ike-group ike-default {
			key-exchange ikev2
			lifetime 28800
			proposal 1 {
				dh-group 14
				encryption aes256
				hash sha256
			}
		}
		site-to-site {
			peer initiator {
				ike-group ike-default
				esp-group esp-default
				connection-type respond
				local-address 127.0.0.2
				remote-address 127.0.0.1
				authentication {
					mode eap-md5
					local-id "ze-eap-server"
					remote-id "ze-eap-client"
					certificate eap-server
					ca-certificate eap-test-ca
					# The CHAP secret of RFC 1994 Section 4.1, which both ends
					# hash with the challenge. The authenticator refuses to run
					# the method without one.
					pre-shared-secret "md5-challenge-secret"
				}
			}
		}
	}
}
EOF_RESPONDER

# ── Initiator daemon (foreground): the EAP peer on 127.0.0.1, configured for
# the same method and the same secret ──
stdin=config:terminator=EOF_CONFIG
plugin {
	external engine-steps {
		run "ze-test engine-steps ./engine-steps.json"
		encoder json
	}
}

pki {
	ca eap-test-ca {
		certificate 
	}
	certificate eap-client {
		certificate 
		private {
			key MHcCAQEEINuZlDX/7b+1y/anmTXCJKeS/LY3SV/IzyAAsa0HiX9ZoAoGCCqGSM49AwEHoUQDQgAErylToGd9Bj1/JVoz57qU0usT3ZTDIMYqjQkC4JThKC+/76/lx6pvBcxdUCbnrO7ms+G+nGUiDiqA0i5RFWS83Q==
		}
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65533
				remote 65533
			}
			router-id 1.1.1.1
			family {
				ipv4/unicast { prefix { maximum 100; } }
			}
		}
	}
}

vpn {
	ipsec {
		esp-group esp-default {
			lifetime 3600
			proposal 1 {
				encryption aes256
				hash sha256
			}
		}
		ike-group ike-default {
			key-exchange ikev2
			lifetime 28800
			proposal 1 {
				dh-group 14
				encryption aes256
				hash sha256
			}
		}
		site-to-site {
			peer peer-1 {
				ike-group ike-default
				esp-group esp-default
				connection-type initiate
				local-address 127.0.0.1
				remote-address 127.0.0.2
				authentication {
					mode eap-md5
					local-id "ze-eap-client"
					# remote-id is set on purpose. Without it ze warns that every
					# certificate this authority issued authenticates as this peer,
					# and a functional test must not model that configuration.
					remote-id "ze-eap-server"
					certificate eap-client
					ca-certificate eap-test-ca
					pre-shared-secret "md5-challenge-secret"
				}
			}
		}
	}
}
EOF_CONFIG

cmd=background:seq=1:exec=ze -:stdin=responder
cmd=foreground:seq=2:exec=ze -:stdin=config:timeout=50s

command=show vpn ipsec sa
expect=output:contains=peer-1:timeout=30
command=show vpn ipsec sa | json
expect=output:contains=aes-cbc:timeout=30
expect=output:contains=sha256:timeout=5
expect=exit:code=0
expect=stderr:contains=engine-steps: all steps passed
expect=stderr:contains=this peer runs an EAP method that establishes no shared key
expect=stderr:contains=EAP methods that do not establish a shared key SHOULD NOT be used
reject=stderr:pattern=EAP process failed
reject=stderr:pattern=panic recovered
reject=stderr:pattern=fatal error
