# Functional test: an operator narrows a live peer's traffic selectors and commits.
# VALIDATES: spec-fixit-ipsec-peer-reload-ignored AC-1 and AC-5 -- the reload restarts the
#            peer, the restarted session carries the EDITED selectors, and the kernel
#            policy after the reload names the newly configured prefix.
# PREVENTS: the defect the spec exists to remove. peerConfigChanged compared eight named
#           members of ipsec.SiteToSitePeer and TrafficSelectors was not among them, so a
#           selector edit committed successfully, `show configuration` agreed, and the
#           running tunnel kept carrying the prefix the edit removed. The failure
#           direction is the dangerous one: an operator narrows a peer to STOP carrying a
#           prefix, and it keeps carrying it.
#
# WHY THE KERNEL AND NOT A LOG LINE. The claim is that the edit reaches the dataplane. A
# log line saying the peer restarted would pass while the replacement Child SA still
# programmed the old scope, which is the half of the defect the guard alone does not fix:
# startPeerSession is the only writer of ps.peerCfg, initiator.go copies it into
# sa.PeerCfg, and the installed policy is built from that value.
#
# WHY ONE DATAPLANE AND NOT TWO. The kernel keys an XFRM state on (src, dst, spi, proto)
# and the two ends of one negotiated Child SA are the SAME two states, so a second
# XfrmStateAdd answers EEXIST. peer-a therefore runs the real xfrm backend and peer-b the
# noop one, and every kernel assertion below is about peer-a.
#
# WHY peer-a IS THE DAEMON THIS TEST RELOADS, AND WHY ITS FILE IS ze-bgp.conf. Only a
# command whose binary is literally `ze` gets its `-` replaced by a config FILE and gets a
# daemon.pid written for it (zeReadyFileEnabled and the substitution loop in
# runner_exec.go both test `binName == "ze"`). peer-b launches through `env` to set its own
# dataplane, so its binary is `env`, its config is PIPED to stdin, and it publishes no pid.
# peer-a is therefore the only daemon with a file to rewrite and a pid to signal, and its
# file takes the default name ze-bgp.conf because it is the only block that reaches
# zeConfigFileName (runner_config.go). MEASURED 2026-08-23: an earlier revision rewrote
# ze-peer-a.conf, a file nobody reads, and the test reported the reload as ignored.
#
# WHY peer-b KEEPS THE WIDE SELECTORS. RFC 7296 Section 2.9 lets a responder narrow a
# proposal to a subset of its own policy, never widen it. peer-b's policy stays the /25
# pair, so peer-a's narrowed /26 proposal is inside it and peer-b answers with peer-a's
# choice. Narrowing both ends at once would leave the answer explainable by either end.
#
# WHY THESE PREFIXES. The policies are real and node-wide for the life of the test, so
# they name RFC 5737 documentation addresses no traffic can be using. They are halves of
# TEST-NET-2, distinct as printed strings from the TEST-NET-1 halves and quarters
# ipsec-child-rekey-xfrm.ci and ipsec-child-rekey-xfrm-narrowing.ci install, and from the
# TEST-NET-2/3 /24 pair ipsec-teardown-leaves-nothing.ci installs.
#
# Gated option=needs-linux:caps=net-admin: peer-a programs real XFRM state, so this SKIPs
# on a host without CAP_NET_ADMIN (the unprivileged dev box) and runs as root in the QEMU
# VM, where `fsuite ipsec` in scripts/evidence/qemu-all-tests.sh executes the suite.

option=needs-linux:caps=net-admin
# Serialize against every other real-XFRM ipsec test. `ip xfrm state` and
# `ip xfrm policy` are NODE-WIDE, so a sibling running concurrently adds SPIs and
# policies this test's readers cannot tell from its own.
option=exclusive:group=ipsec-xfrm
option=env:var=ze_test_ike_port:value=$PORT2
option=timeout:value=120s
option=env:var=ze_log_ike:value=info

tmpfs=reload.py:mode=755:terminator=EOF_RELOAD
#!/usr/bin/env python3
"""Watch a traffic-selector edit travel from a config file to the kernel.

Three facts are read from `ip xfrm`, in order: the tunnel installs a policy naming the
WIDE prefix, the operator's edit lands (config file rewritten, SIGHUP sent), and the
kernel then holds a policy naming the NARROW prefix with no policy naming the wide one.

The ESP SPIs are read across the same three points. A restart is what applies the edit
(RFC 7296 Section 2.9.2), so the replacement states must be a different pair: a kernel
still holding the original SPIs would mean the tunnel never came back.
"""
import os
import re
import shutil
import signal
import subprocess
import sys

from ze_api import wait_until

# The three halves of the negotiated selector. WIDE_LOCAL is what the peer starts with,
# NARROW_LOCAL is what the operator edits it to, and REMOTE is unchanged by the edit.
WIDE_LOCAL = "198.51.100.0/25"
NARROW_LOCAL = "198.51.100.0/26"
REMOTE = "198.51.100.128/25"


def run(*cmd):
    out = subprocess.run(cmd, capture_output=True, text=True)
    if out.returncode != 0:
        sys.exit(f"{' '.join(cmd)} failed: {out.stderr.strip()}")
    return out.stdout


def spis():
    """Every ESP SPI the kernel currently holds a state for."""
    return frozenset(re.findall(r"\bspi (0x[0-9a-fA-F]+)", run("ip", "xfrm", "state")))


def policies(local):
    """This tunnel's policy selectors that name `local`, one normalised string each.

    The selector line carries the addresses, the protocol and the ports; the `dir` line
    that follows says which direction it is. Matching is on a whole FIELD, so the wide
    prefix and the narrow prefix inside it never match each other.
    """
    found = []
    selector = None
    for line in run("ip", "xfrm", "policy").splitlines():
        fields = line.split()
        if not fields:
            continue
        if fields[0] == "src":
            selector = " ".join(fields) if (local in fields and REMOTE in fields) else None
        elif selector is not None and fields[0] == "dir":
            found.append(f"{selector} | {fields[1]}")
            selector = None
    return frozenset(found)


if not wait_until(lambda: len(spis()) >= 2 and len(policies(WIDE_LOCAL)) >= 2,
                  attempts=400, delay=0.25):
    sys.exit(f"the tunnel never reached the kernel: states={sorted(spis())} "
             f"policies={sorted(policies(WIDE_LOCAL))}")
wide_spis, wide_policies = spis(), policies(WIDE_LOCAL)
print("INSTALLED-WIDE:", " | ".join(sorted(wide_policies)))
print("INSTALLED-SPIS:", " ".join(sorted(wide_spis)))

# The operator's edit: the peer's traffic-selector block now names the /26, and nothing
# else in the file changed. SIGHUP is the commit.
if not wait_until(lambda: os.path.exists("daemon.pid"), attempts=200, delay=0.05):
    sys.exit("daemon.pid never appeared, so there is no daemon to reload")
with open("daemon.pid") as f:
    pid = int(f.read().strip())
shutil.copy("config2.conf", "ze-bgp.conf")
os.kill(pid, signal.SIGHUP)
print("RELOADED: sent SIGHUP to pid", pid)

# The edit reaches the kernel. The peer restarts, re-initiates, and the replacement Child
# SA programs the narrowed scope. The wide policies must be gone: a policy that stays is
# traffic the operator asked ze to stop protecting.
if not wait_until(lambda: len(policies(NARROW_LOCAL)) >= 2 and not policies(WIDE_LOCAL),
                  attempts=400, delay=0.25):
    print("WIDE-SURVIVED: the reload did not reach the kernel")
    print("  wide:  ", " | ".join(sorted(policies(WIDE_LOCAL))))
    print("  narrow:", " | ".join(sorted(policies(NARROW_LOCAL))))
    sys.exit(1)
print("NARROWED:", " | ".join(sorted(policies(NARROW_LOCAL))))

if spis() & wide_spis:
    print("SPIS-SURVIVED: the original states outlived the restart:", " ".join(sorted(spis() & wide_spis)))
    sys.exit(1)
print("RESTARTED:", " ".join(sorted(spis())))
EOF_RELOAD

# peer-a's config AFTER the operator's edit. The ONLY difference from the peer-a block
# below is the local prefix of traffic-selector 1: /25 became /26.
tmpfs=config2.conf:terminator=EOF_CONFIG2
vpn {
	ipsec {
		esp-group esp-default {
			lifetime 3600
			proposal 1 {
				encryption aes256
				hash sha256
			}
		}
		ike-group ike-default {
			key-exchange ikev2
			lifetime 28800
			proposal 1 {
				dh-group 14
				encryption aes256
				hash sha256
			}
		}
		site-to-site {
			peer peer-b {
				ike-group ike-default
				esp-group esp-default
				connection-type initiate
				local-address 127.0.0.1
				remote-address 127.0.0.2
				mode tunnel
				traffic-selector 1 {
					protocol 6
					local {
						prefix 198.51.100.0/26
						port 179
					}
					remote {
						prefix 198.51.100.128/25
					}
				}
				authentication {
					mode pre-shared-secret
					pre-shared-secret test-key-1234
				}
			}
		}
	}
}
EOF_CONFIG2

# ── peer-b (background, noop dataplane, WIDE selectors): binds 127.0.0.2 ──
# It responds and never reloads. Its policy stays the /25 pair, so RFC 7296 Section 2.9
# lets it answer peer-a's narrowed proposal with peer-a's own choice.
stdin=peer-b:terminator=EOF_PEER_B
vpn {
	ipsec {
		esp-group esp-default {
			lifetime 3600
			proposal 1 {
				encryption aes256
				hash sha256
			}
		}
		ike-group ike-default {
			key-exchange ikev2
			lifetime 28800
			proposal 1 {
				dh-group 14
				encryption aes256
				hash sha256
			}
		}
		site-to-site {
			peer peer-a {
				ike-group ike-default
				esp-group esp-default
				connection-type respond
				local-address 127.0.0.2
				remote-address 127.0.0.1
				mode tunnel
				traffic-selector 1 {
					protocol 6
					local {
						prefix 198.51.100.128/25
					}
					remote {
						prefix 198.51.100.0/25
						port 179
					}
				}
				authentication {
					mode pre-shared-secret
					pre-shared-secret test-key-1234
				}
			}
		}
	}
}
EOF_PEER_B

# ── peer-a (background, REAL xfrm): binds 127.0.0.1, and is the daemon reloaded ──
stdin=peer-a:terminator=EOF_PEER_A
vpn {
	ipsec {
		esp-group esp-default {
			lifetime 3600
			proposal 1 {
				encryption aes256
				hash sha256
			}
		}
		ike-group ike-default {
			key-exchange ikev2
			lifetime 28800
			proposal 1 {
				dh-group 14
				encryption aes256
				hash sha256
			}
		}
		site-to-site {
			peer peer-b {
				ike-group ike-default
				esp-group esp-default
				connection-type initiate
				local-address 127.0.0.1
				remote-address 127.0.0.2
				mode tunnel
				traffic-selector 1 {
					protocol 6
					local {
						prefix 198.51.100.0/25
						port 179
					}
					remote {
						prefix 198.51.100.128/25
					}
				}
				authentication {
					mode pre-shared-secret
					pre-shared-secret test-key-1234
				}
			}
		}
	}
}
EOF_PEER_A

cmd=background:seq=1:exec=env ze_test_ike_dataplane=noop ze -:stdin=peer-b:name=peer-b
cmd=background:seq=2:exec=ze -:stdin=peer-a:name=peer-a
cmd=foreground:seq=3:exec=python3 reload.py:timeout=110s
# signal=term, not the default kill: peer-a's policies are REAL and node-wide, and the
# release that removes them runs on the way out of runEngine. A SIGKILLed peer-a leaves
# them in the kernel for the rest of the suite, where ipsec-teardown-leaves-nothing.ci
# asserts the XFRM tables are empty.
cmd=stop:seq=4:name=peer-a:signal=term
cmd=stop:seq=5:name=peer-b:signal=term

expect=exit:code=0
expect=stdout:contains=INSTALLED-WIDE:
expect=stdout:contains=RELOADED:
expect=stdout:contains=NARROWED:
expect=stdout:contains=RESTARTED:
reject=stdout:pattern=WIDE-SURVIVED
reject=stdout:pattern=SPIS-SURVIVED
reject=stderr:pattern=panic recovered
reject=stderr:pattern=fatal error
