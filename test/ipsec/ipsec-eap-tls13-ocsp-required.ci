# Functional test: an EAP-TLS 1.3 peer that USES Certificate Status Requests
# REFUSES an authenticator that staples nothing, through two real ze daemons.
# Spec: spec-ipsec-rfc9190, AC-5.
#
# RFC 9190 Section 5.4: "When an EAP-TLS peer uses Certificate Status Requests to
# check the revocation status of the EAP-TLS server's certificate chain, it MUST
# treat a CertificateEntry (but not the trust anchor) without a valid
# CertificateStatus extension as invalid and abort the handshake with an
# appropriate alert."
#
# ITS PAIR IS ipsec-eap-tls13-ocsp-stapling.ci, which is this configuration with
# one leaf added: ocsp-response on the authenticator's pki certificate. There the
# SA establishes. The two files differ by that leaf and by nothing else, so what
# they measure together is the leaf rather than the daemon.
#
# WHAT MAKES IT FAIL. A peer that stopped enforcing the status would establish
# the SA here, and `show vpn ipsec sa` would carry aes-cbc, which the reject
# below refuses. The expect names the peer's own diagnosis, so a failure for any
# other reason -- a bad certificate, a revoked chain, a dead responder -- reads as
# a red rather than as this test passing for the wrong reason.
option=env:var=ze_test_ike_port:value=$PORT2
# noop dataplane: unprivileged XFRM install is EPERM-fatal by design
# (engine/child.go); control-plane tests opt out of the kernel entirely.
option=env:var=ze_test_ike_dataplane:value=noop
# The EAP-TLS outcome is logged at Info, and the default level is WARN.
option=env:var=ze_log_ike:value=info
option=timeout:value=40s

# THE `crl` LEAF IS LOAD-BEARING on both ends, and it is not what this test
# measures. Both daemons are Go, so they negotiate TLS 1.3, where RFC 9190
# Section 5.4 makes the revocation status of every certificate on the chain
# mandatory to check. A ca holding no list cannot answer that, and ze would
# refuse the exchange for THAT reason rather than for the certificate status
# (checkChainRevocation, internal/core/eap/revocation.go). The list here revokes
# nothing, which is the answer a CA publishes while it has withdrawn nothing.
#
# ── Responder daemon (background): the EAP-TLS authenticator on 127.0.0.2 ──
stdin=responder:terminator=EOF_RESPONDER
pki {
	ca ocsp-test-ca {
		certificate 
		crl MIHRMHoCAQEwCgYIKoZIzj0EAwIwGjEYMBYGA1UEAxMPemUtb2NzcC10ZXN0LWNhFw0yNjA5MDgwMDAwMDBaFw00NjA5MDMwMDAwMDBaoC8wLTAfBgNVHSMEGDAWgBT7gJ5yurlA6KsuzDUBYqyLxRxy2zAKBgNVHRQEAwIBATAKBggqhkjOPQQDAgNHADBEAiAYVgLacJ6tYZ/wrP0tForGOgOVj76SD9EkeJB07tyEXwIgVGSHQEYv9xLnxnuX1MYL/txZCLfILCANgvJGfLRNbNs=
	}
	certificate eap-server {
		certificate 

		private {
			key MIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQgLpZ+bbZJWIyDymyLcoSpBABu1Yq0CJShZ+azquz8JiehRANCAATL+v7HDrFTrHsCoz228qYTnGaWgMBeeZRFeNK8KQyfdFAYqm5tGMW8zXvsIDS7ym2To8npjxxmh5No3OXI/nuL
		}
	}
}


bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65533
				remote 65533
			}
			router-id 2.2.2.2
			family {
				ipv4/unicast { prefix { maximum 100; } }
			}
		}
	}
}

vpn {
	ipsec {
		esp-group esp-default {
			lifetime 3600
			proposal 1 {
				encryption aes256
				hash sha256
			}
		}
		ike-group ike-default {
			key-exchange ikev2
			lifetime 28800
			proposal 1 {
				dh-group 14
				encryption aes256
				hash sha256
			}
		}
		site-to-site {
			peer initiator {
				ike-group ike-default
				esp-group esp-default
				connection-type respond
				local-address 127.0.0.2
				remote-address 127.0.0.1
				authentication {
					mode eap-tls
					local-id "ze-eap-server"
					remote-id "ze-eap-client"
					certificate eap-server
					ca-certificate ocsp-test-ca
				}
			}
		}
	}
}
EOF_RESPONDER

# ── Initiator daemon (foreground): the EAP-TLS peer on 127.0.0.1 ──
stdin=config:terminator=EOF_CONFIG
pki {
	ca ocsp-test-ca {
		certificate 
		crl MIHRMHoCAQEwCgYIKoZIzj0EAwIwGjEYMBYGA1UEAxMPemUtb2NzcC10ZXN0LWNhFw0yNjA5MDgwMDAwMDBaFw00NjA5MDMwMDAwMDBaoC8wLTAfBgNVHSMEGDAWgBT7gJ5yurlA6KsuzDUBYqyLxRxy2zAKBgNVHRQEAwIBATAKBggqhkjOPQQDAgNHADBEAiAYVgLacJ6tYZ/wrP0tForGOgOVj76SD9EkeJB07tyEXwIgVGSHQEYv9xLnxnuX1MYL/txZCLfILCANgvJGfLRNbNs=
	}
	certificate eap-client {
		certificate 
		private {
			key MIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQg8cmSmEkwYa3J9Nbs3ppthbjQvItkUQbzsSjjZ/BBN8+hRANCAARtPLwVhJFBs11Lqg2/ECgf7gYIqClDvnkDGLEYnmDEqcbev/a2F7nxYZgzQuGSZSNX+TfM/3bI3yTJ4L5XrRaz
		}
	}
}


bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65533
				remote 65533
			}
			router-id 1.1.1.1
			family {
				ipv4/unicast { prefix { maximum 100; } }
			}
		}
	}
}

vpn {
	ipsec {
		esp-group esp-default {
			lifetime 3600
			proposal 1 {
				encryption aes256
				hash sha256
			}
		}
		ike-group ike-default {
			key-exchange ikev2
			lifetime 28800
			proposal 1 {
				dh-group 14
				encryption aes256
				hash sha256
			}
		}
		site-to-site {
			peer peer-1 {
				ike-group ike-default
				esp-group esp-default
				connection-type initiate
				local-address 127.0.0.1
				remote-address 127.0.0.2
				authentication {
					mode eap-tls
					local-id "ze-eap-client"
					# remote-id is set on purpose. Without it ze warns that every
					# certificate this authority issued authenticates as this peer,
					# and a functional test must not model that configuration.
					remote-id "ze-eap-server"
					certificate eap-client
					ca-certificate ocsp-test-ca
					certificate-status-request true
				}
			}
		}
	}
}
EOF_CONFIG

cmd=background:seq=1:exec=ze -:stdin=responder
cmd=foreground:seq=2:exec=ze -:stdin=config:timeout=40s

# THE AWAIT IS THE WAIT, and there is no `command=` step at all. `expect=stderr`
# is evaluated once, over the accumulated output, after the run ends, so
# something has to hold the run open until the exchange has failed; a command
# step would end it as soon as the step passed, which here is before the
# EAP-TLS handshake has run. `await=` blocks on the line itself, so this test
# takes as long as the refusal takes and no longer. It is the shape
# ipsec-eap-nak-unacceptable-type.ci already uses, for the same reason: ze
# exposes no CLI surface that reports an authentication it refused.
await=stderr:contains=stapled no OCSP response:timeout=30s

# The peer refuses the authenticator, and its own diagnosis names the missing
# CertificateStatus, so a failure for any other reason does not pass here.
expect=stderr:pattern=stapled no OCSP response

# NEITHER end establishes an SA. Both daemons write to this stream, so this
# refuses the initiator's "SA established" line and the responder's as well.
reject=stderr:pattern=SA established
reject=stderr:pattern=panic recovered
reject=stderr:pattern=fatal error
