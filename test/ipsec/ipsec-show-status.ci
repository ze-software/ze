# Functional test: show vpn ipsec status
# Spec: plan/spec-ipsec-10-cli-diag.md (AC-3)
#
# Verifies: show vpn ipsec status shows engine state, configured count, active count.

stdin=config:terminator=EOF_CONFIG
{
  "vpn": {
    "ipsec": {
      "esp-group": {
        "esp-default": {
          "lifetime": "3600",
          "proposal": { "1": { "encryption": "aes256", "hash": "sha256" } }
        }
      },
      "ike-group": {
        "ike-default": {
          "key-exchange": "ikev2",
          "lifetime": "28800",
          "proposal": { "1": { "dh-group": "14", "encryption": "aes256", "hash": "sha256" } }
        }
      },
      "site-to-site": {
        "peer-1": {
          "ike-group": "ike-default",
          "esp-group": "esp-default",
          "connection-type": "initiate",
          "local-address": "10.0.0.1",
          "remote-address": "10.0.0.2",
          "authentication": { "mode": "pre-shared-secret", "pre-shared-secret": "test-key-1234" }
        }
      }
    }
  }
}
EOF_CONFIG

expect=event:namespace=vpn-ipsec:name=sa-up:timeout=10

command=show vpn ipsec status
expect=output:contains=engine-running:timeout=5
expect=output:contains=configured-peers:timeout=1
