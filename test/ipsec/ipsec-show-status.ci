# Functional test: show vpn ipsec status
# Spec: plan/spec-ipsec-10-cli-diag.md (AC-3); wired by spec-test-coverage-gaps
# (AC-2/AC-3): the command=/expect=output directives below are executed by the
# daemon-spawned `ze-test engine-steps` external plugin (the runner writes
# ./engine-steps.json into the test dir; see
# internal/test/runner/engine_steps.go for the execution model).
#
# Verifies: show vpn ipsec status reports engine state and configured peers on
# a live daemon, end to end through CLI dispatch.
#
# // the original (never-executed) revision also expected
# expect=event:namespace=vpn-ipsec:name=sa-up, but this single-daemon test has
# no IKE responder to negotiate with -- peer-1 initiates toward an address
# nothing answers, so sa-up can never fire here. SA-lifecycle events are
# asserted by the responder-backed tests (ipsec-sa-installed) and the
# strongSwan interop lab (test/ipsec-interop/).

stdin=config:terminator=EOF_CONFIG
plugin {
	external engine-steps {
		run "ze-test engine-steps ./engine-steps.json"
		encoder json
	}
}

# A bgp block routes the config through the main loader; without it a minimal
# environment-only parser owns plugin{} blocks
# (internal/component/hub/config.go parsePluginBlock).
bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65533
				remote 65533
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 100; } }
			}
		}
	}
}

vpn {
	ipsec {
		esp-group esp-default {
			lifetime 3600
			proposal 1 {
				encryption aes256
				hash sha256
			}
		}
		ike-group ike-default {
			key-exchange ikev2
			lifetime 28800
			proposal 1 {
				dh-group 14
				encryption aes256
				hash sha256
			}
		}
		site-to-site {
			peer peer-1 {
				ike-group ike-default
				esp-group esp-default
				connection-type initiate
				local-address 10.0.0.1
				remote-address 10.0.0.2
				authentication {
					mode pre-shared-secret
					pre-shared-secret test-key-1234
				}
			}
		}
	}
}
EOF_CONFIG

cmd=foreground:seq=1:exec=ze -:stdin=config:timeout=30s

command=show vpn ipsec status
expect=output:contains=engine-running:timeout=5
expect=output:contains=configured-peers:timeout=1
expect=exit:code=0
expect=stderr:contains=engine-steps: all steps passed
reject=stderr:pattern=panic recovered
reject=stderr:pattern=fatal error
