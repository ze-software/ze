# Functional test: two peers bound to no pool may not hold one inner address.
# Spec: spec-ike-unbound-peer-inner-address (AC-1, AC-12,
# user stories 1 and 3). Design: docs/architecture/ike/ipsec-8-ikev2-child-xfrm.md.
#
# VALIDATES: RFC 3948 Section 5.1 through the real IKE_AUTH entry point. The hub
# runs two `respond` peers with no virtual-IP pool and no traffic-selector, so
# each spoke chooses its own inner selectors. Both spokes propose TSi 10.1.2.3/32
# and TSr 0.0.0.0/0. spoke-a's Child SA installs first; spoke-b's IKE_AUTH Child
# SA would be a second tunnel to the same inner address, so one packet to
# 10.1.2.3 could be sent into either. The hub refuses it with TS_UNACCEPTABLE
# (RFC 7296 Section 2.9) and keeps spoke-b's IKE SA (Section 2.21.2).
#
# PREVENTS: the hub installing both Child SAs, which is what it did before the
# guard: two outbound policies for 10.1.2.3/32 and traffic for that address sent
# to whichever the kernel picks.
#
# WHAT DISCRIMINATES. The hub's engine-steps executor reads `show vpn ipsec sa |
# json`, whose peers list is sorted by peer name: spoke-a carries a child-sa
# whose ts-remote is 10.1.2.3/32, and spoke-b's object holds no nested object at
# all, so it has no child-sa. With the guard removed spoke-b's object carries a
# child-sa and the last step never holds.
#
# ORDER. spoke-a starts only once the hub serves, and spoke-b only once spoke-a
# logged its installed Child SA (ready=), so "first" is an event, never a delay.
# The fence ends the run once the hub's steps passed AND spoke-b logged the
# refusal; every daemon writes into the one fence, so the order of the two lines
# does not matter.
#
# Every daemon uses the noop dataplane: the guard is in the engine, above the
# dataplane, and the unprivileged host cannot program XFRM.

option=env:var=ze_test_ike_port:value=$PORT2
option=env:var=ze_test_ike_dataplane:value=noop
option=env:var=ze.log.ike:value=info
option=timeout:value=60s

# ── Hub (background): two unbound respond peers and the engine-steps executor ──
stdin=hub:terminator=EOF_HUB
plugin {
	external engine-steps {
		run "le mock engine-steps ./engine-steps.json"
		encoder json
	}
}

# A bgp block routes the config through the main loader; without it a minimal
# environment-only parser owns plugin{} blocks
# (internal/component/hub/config.go parsePluginBlock).
bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.2
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65533
				remote 65533
			}
			router-id 1.1.1.1
			family {
				ipv4/unicast { prefix { maximum 100; } }
			}
		}
	}
}

vpn {
	ipsec {
		esp-group esp-default {
			lifetime 3600
			proposal 1 {
				encryption aes256
				hash sha256
			}
		}
		ike-group ike-default {
			key-exchange ikev2
			lifetime 28800
			proposal 1 {
				dh-group 14
				encryption aes256
				hash sha256
			}
		}
		site-to-site {
			# No traffic-selector and no virtual-ip-pool: the spoke chooses its
			# inner address, which is the case RFC 3948 Section 5.1 guards.
			peer spoke-a {
				ike-group ike-default
				esp-group esp-default
				connection-type respond
				local-address 127.0.0.1
				remote-address 127.0.0.2
				authentication {
					mode pre-shared-secret
					pre-shared-secret test-key-a
				}
			}
			peer spoke-b {
				ike-group ike-default
				esp-group esp-default
				connection-type respond
				local-address 127.0.0.1
				remote-address 127.0.0.3
				authentication {
					mode pre-shared-secret
					pre-shared-secret test-key-b
				}
			}
		}
	}
}
EOF_HUB

# ── spoke-a (background): proposes inner 10.1.2.3/32 first ──
stdin=spoke-a:terminator=EOF_SPOKE_A
vpn {
	ipsec {
		esp-group esp-default {
			lifetime 3600
			proposal 1 {
				encryption aes256
				hash sha256
			}
		}
		ike-group ike-default {
			key-exchange ikev2
			lifetime 28800
			proposal 1 {
				dh-group 14
				encryption aes256
				hash sha256
			}
		}
		site-to-site {
			peer hub {
				ike-group ike-default
				esp-group esp-default
				connection-type initiate
				local-address 127.0.0.2
				remote-address 127.0.0.1
				mode tunnel
				traffic-selector 1 {
					local {
						prefix 10.1.2.3/32
					}
					remote {
						prefix 0.0.0.0/0
					}
				}
				authentication {
					mode pre-shared-secret
					pre-shared-secret test-key-a
				}
			}
		}
	}
}
EOF_SPOKE_A

# ── spoke-b (foreground): proposes the same inner address second ──
stdin=spoke-b:terminator=EOF_SPOKE_B
vpn {
	ipsec {
		esp-group esp-default {
			lifetime 3600
			proposal 1 {
				encryption aes256
				hash sha256
			}
		}
		ike-group ike-default {
			key-exchange ikev2
			lifetime 28800
			proposal 1 {
				dh-group 14
				encryption aes256
				hash sha256
			}
		}
		site-to-site {
			peer hub {
				ike-group ike-default
				esp-group esp-default
				connection-type initiate
				local-address 127.0.0.3
				remote-address 127.0.0.1
				mode tunnel
				traffic-selector 1 {
					local {
						prefix 10.1.2.3/32
					}
					remote {
						prefix 0.0.0.0/0
					}
				}
				authentication {
					mode pre-shared-secret
					pre-shared-secret test-key-b
				}
			}
		}
	}
}
EOF_SPOKE_B

cmd=background:seq=1:exec=ze -:stdin=hub:name=hub
# AC-12: the hub's refusal names both peers, the overlap and the fix.
expect=stderr:contains=ike: refused the IKE_AUTH Child SA, keeping the IKE SA
expect=stderr:contains=peer spoke-b proposed the tunnel
expect=stderr:contains=that peer spoke-a already holds, so one packet could be sent into either tunnel (RFC 3948 Section 5.1)
expect=stderr:contains=virtual-ip-pool
expect=stderr:contains=engine-steps: all steps passed
reject=stderr:pattern=panic recovered
reject=stderr:pattern=fatal error
cmd=background:seq=2:exec=env ze_config_dir=spoke-a-store ze -:stdin=spoke-a:name=spoke-a:ready=child-sa: installed
cmd=foreground:seq=3:exec=ze -:stdin=spoke-b:timeout=55s
await=stderr:contains=engine-steps: all steps passed:timeout=50s:then=stop
await=stderr:contains=ike: peer authenticated and refused the Child SA, keeping the IKE SA
# spoke-b keeps its IKE SA and names the notify the hub answered (RFC 7296 Section 2.21.2).
expect=stderr:contains=TS_UNACCEPTABLE

# The hub's steps (the hub is the only daemon that loads the executor).
command=show vpn ipsec sa | json
expect=output:json=peers.0.peer-name=spoke-a:timeout=40
expect=output:json=peers.0.child-sa.ts-remote=10.1.2.3/32:timeout=20
expect=output:json=peers.1.peer-name=spoke-b:timeout=20
# spoke-b's IKE SA is up (its encryption is set only once IKE_AUTH completed)
# and its object holds no nested object, so no child-sa.
expect=output:json=peers.1.encryption=aes-cbc:timeout=20
expect=output:matches=\{[^{}]*"peer-name":"spoke-b"[^{}]*\}:timeout=20
