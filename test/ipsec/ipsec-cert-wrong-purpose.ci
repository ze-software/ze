# Functional test: the IKE initiator refuses a peer whose certificate was issued
# for another purpose, a TLS server certificate whose extended key usage names
# serverAuth alone, through two real ze daemons. Spec:
# spec-ike-certificate-revocation-and-purpose, AC-2, user story 2.
#
# RFC 4945 Section 5.1.3.12: "If EKU present AND contains either id-kp-ipsecIKE
# or anyExtendedKeyUsage, continue." and "Otherwise, reject cert." Two
# unprivileged ze instances negotiate IKEv2 over loopback with x509
# authentication. The responder presents ze-cert-responder serial 0x010004,
# whose EKU is serverAuth only. Neither ca holds a crl, so no revocation check
# runs and the purpose check in getRemoteCert (engine/cert_payload.go) is the
# only thing that can refuse it.
#
# ITS PAIR IS ipsec-cert-purpose-ipsec-ike.ci, which is this configuration with
# the responder's certificate line swapped for serial 0x010003: the same key,
# subject and SAN, with EKU serverAuth plus id-kp-ipsecIKE. There the SA
# establishes. A check that refused every EKU would pass this test and fail that
# one; a check that ignored the EKU would do the reverse.
#
# WHAT MAKES IT FAIL. With the purpose check removed the initiator accepts the
# responder: the await below never sees `extended key usage` and times out, and
# the initiator logs "ike: SA established", which the reject refuses.
#
# THE RESPONDER ESTABLISHES ITS SIDE. The initiator's certificate carries
# id-kp-ipsecIKE, so the responder accepts it and answers IKE_AUTH before the
# initiator judges the responder's certificate. The observable is the
# initiator's log, and the reject names the initiator's line ("ike: SA
# established"), which the responder's "ike: responder ..." lines do not match.
# The initiator's "ike: SA established" line, which the reject below refuses, is
# logged at Info, and the default level is WARN.
option=env:var=ze_log_ike:value=info
option=env:var=ze_test_ike_port:value=$PORT2
# noop dataplane: unprivileged XFRM install is EPERM-fatal by design
# (engine/child.go); control-plane tests opt out of the kernel entirely.
option=env:var=ze_test_ike_dataplane:value=noop
option=timeout:value=60s

# ── Responder daemon (background): x509 authentication on 127.0.0.2. Its ca
# holds no crl, so it checks no revocation and accepts the initiator ──
stdin=responder:terminator=EOF_RESPONDER
pki {
	ca ze-cert-test-ca {
		certificate 
	}
	certificate ze-cert-responder {
		certificate 
		private {
			key MHcCAQEEIMgZHsiqQ6NBDGfi+tJaZQE4tg4hNzooTpbDXYer06PEoAoGCCqGSM49AwEHoUQDQgAElvI2zWkIYG/Pd/CEZ5RE7MBdMw9ljF6mjduyA31dPHfDzLmBYvHSjAhMTCS36LW62UpbRzDYCRVs5mM7VehN8g==
		}
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65533
				remote 65533
			}
			router-id 2.2.2.2
			family {
				ipv4/unicast { prefix { maximum 100; } }
			}
		}
	}
}

vpn {
	ipsec {
		esp-group esp-default {
			lifetime 3600
			proposal 1 {
				encryption aes256
				hash sha256
			}
		}
		ike-group ike-default {
			key-exchange ikev2
			lifetime 28800
			proposal 1 {
				dh-group 14
				encryption aes256
				hash sha256
			}
		}
		site-to-site {
			peer initiator {
				ike-group ike-default
				esp-group esp-default
				connection-type respond
				local-address 127.0.0.2
				remote-address 127.0.0.1
				authentication {
					mode x509
					local-id "ze-cert-responder"
					remote-id "ze-cert-initiator"
					certificate ze-cert-responder
					ca-certificate ze-cert-test-ca
				}
			}
		}
	}
}
EOF_RESPONDER

# ── Initiator daemon (foreground): x509 authentication on 127.0.0.1, judging
# the responder's certificate ──
stdin=config:terminator=EOF_CONFIG
pki {
	ca ze-cert-test-ca {
		certificate 
	}
	certificate ze-cert-initiator {
		certificate 
		private {
			key MHcCAQEEIEfeLRWC9PEAtTrbIZ6AabjI+MQr8XbWb9cZJCFwC8XCoAoGCCqGSM49AwEHoUQDQgAErxoDb89FQUUzGqVpGpeeQhGjd6VFDZR9oW35DWBzOieE+4E3Zh02FPpP/0w97R4e7FOc60gQGfElGRgwDqx9rA==
		}
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65533
				remote 65533
			}
			router-id 1.1.1.1
			family {
				ipv4/unicast { prefix { maximum 100; } }
			}
		}
	}
}

vpn {
	ipsec {
		esp-group esp-default {
			lifetime 3600
			proposal 1 {
				encryption aes256
				hash sha256
			}
		}
		ike-group ike-default {
			key-exchange ikev2
			lifetime 28800
			proposal 1 {
				dh-group 14
				encryption aes256
				hash sha256
			}
		}
		site-to-site {
			peer peer-1 {
				ike-group ike-default
				esp-group esp-default
				connection-type initiate
				local-address 127.0.0.1
				remote-address 127.0.0.2
				authentication {
					mode x509
					local-id "ze-cert-initiator"
					remote-id "ze-cert-responder"
					certificate ze-cert-initiator
					ca-certificate ze-cert-test-ca
				}
			}
		}
	}
}
EOF_CONFIG

cmd=background:seq=1:exec=ze -:stdin=responder
cmd=foreground:seq=2:exec=ze -:stdin=config:timeout=50s

# THE AWAIT IS THE WAIT: ze exposes no CLI surface that reports an
# authentication it refused, so the run is held open on the refusal line itself.
await=stderr:contains=extended key usage:timeout=40s

# The initiator refused the responder in IKE_AUTH, for the certificate's purpose.
expect=stderr:pattern=remote AUTH verification failed.*extended key usage
reject=stderr:pattern=ike: SA established
reject=stderr:pattern=panic recovered
reject=stderr:pattern=fatal error
