# Functional test: show vpn ipsec peer name <name> (per-peer IKE + child SA detail)
# Spec: plan/spec-ipsec-10-cli-diag.md (AC-4); wired by spec-test-coverage-gaps
# (AC-3).
#
# Two unprivileged ze instances negotiate IKEv2 over loopback (responder binds
# 127.0.0.2, initiator 127.0.0.1, sharing ze.test.ike.port). Once the SA is
# established the initiator's engine-steps executor asserts that
# `show vpn ipsec peer name peer-1` renders the per-peer detail view: the
# `ike-sas` list with the negotiated algorithm (aes-cbc) and the nested
# `child-sa` block (inbound/outbound ESP SPIs) that the flat `show vpn ipsec sa`
# table does not carry -- proof of the peer-detail surface through the CLI.
#
# // the original (never-executed) revision asserted the sa-up EVENT
# (expect=event:namespace=vpn-ipsec:name=sa-up) against a single non-establishing
# daemon. The initial sa-up fires at startup before any runtime subscription can
# be placed, and the only pre-establishment subscribe path is namespace-locked to
# bgp (dispatch.go registerSubscriptions) -- a real product gap deferred to
# spec-fixit-plugin-event-subscription. The peer detail is asserted here via
# `show vpn ipsec peer name peer-1` output, which needs no event subscription.

option=env:var=ze_test_ike_port:value=$PORT2
# noop dataplane: unprivileged XFRM install is EPERM-fatal by design.
option=env:var=ze_test_ike_dataplane:value=noop
option=timeout:value=40s

# ── Responder daemon (background): binds 127.0.0.2, waits for the initiator ──
stdin=responder:terminator=EOF_RESPONDER
bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65533
				remote 65533
			}
			router-id 2.2.2.2
			family {
				ipv4/unicast { prefix { maximum 100; } }
			}
		}
	}
}

vpn {
	ipsec {
		esp-group esp-default {
			lifetime 3600
			proposal 1 {
				encryption aes256
				hash sha256
			}
		}
		ike-group ike-default {
			key-exchange ikev2
			lifetime 28800
			proposal 1 {
				dh-group 14
				encryption aes256
				hash sha256
			}
		}
		site-to-site {
			peer initiator {
				ike-group ike-default
				esp-group esp-default
				connection-type respond
				local-address 127.0.0.2
				remote-address 127.0.0.1
				authentication {
					mode pre-shared-secret
					pre-shared-secret test-key-1234
				}
			}
		}
	}
}
EOF_RESPONDER

# ── Initiator daemon (foreground) with the engine-steps executor ──
stdin=config:terminator=EOF_CONFIG
plugin {
	external engine-steps {
		run "ze-test engine-steps ./engine-steps.json"
		encoder json
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65533
				remote 65533
			}
			router-id 1.1.1.1
			family {
				ipv4/unicast { prefix { maximum 100; } }
			}
		}
	}
}

vpn {
	ipsec {
		esp-group esp-default {
			lifetime 3600
			proposal 1 {
				encryption aes256
				hash sha256
			}
		}
		ike-group ike-default {
			key-exchange ikev2
			lifetime 28800
			proposal 1 {
				dh-group 14
				encryption aes256
				hash sha256
			}
		}
		site-to-site {
			peer peer-1 {
				ike-group ike-default
				esp-group esp-default
				connection-type initiate
				local-address 127.0.0.1
				remote-address 127.0.0.2
				authentication {
					mode pre-shared-secret
					pre-shared-secret test-key-1234
				}
			}
		}
	}
}
EOF_CONFIG

cmd=background:seq=1:exec=ze -:stdin=responder
cmd=foreground:seq=2:exec=ze -:stdin=config:timeout=35s

# `show vpn ipsec peer name peer-1` renders the per-peer detail. Poll its `| json`
# for the negotiated aes-cbc, which only populates after IKE_AUTH completes -- a
# precise "established" wait. Then assert the peer-detail shape: the `ike-sas`
# list and the nested `child-sa` block with inbound/outbound ESP SPIs (installed
# by the noop dataplane on establishment), neither of which the flat SA table
# carries.
command=show vpn ipsec peer name peer-1 | json
expect=output:contains=aes-cbc:timeout=25
expect=output:contains=ike-sas:timeout=3
expect=output:contains=child-sa:timeout=3
expect=output:contains=inbound-spi:timeout=3
expect=output:contains=outbound-spi:timeout=3
expect=output:contains=peer-name:timeout=3
expect=exit:code=0
expect=stderr:contains=engine-steps: all steps passed
reject=stderr:pattern=panic recovered
reject=stderr:pattern=fatal error
