# Test: Workbench singleton Save button persists form changes through /config/form/
# VALIDATES: /show/system/identity/ -> click Save -> /config/form/ merges with existing pending config
# PREVENTS: Save button no-op when other pending changes already exist

option=timeout:value=60s

action=open:path=/cli
expect=element:id=terminal-input
action=fill:id=terminal-input:value=set bgp router-id 10.0.0.1
action=press:id=terminal-input:key=Enter
action=wait:ms=1200
action=fill:id=terminal-input:value=set system dns timeout 7
action=press:id=terminal-input:key=Enter
action=wait:ms=1200

action=open:path=/show/system/identity/
expect=element:id=workbench-shell
expect=element:id=field-hostname
expect=html:contains=wb-form-post
expect=html:contains=/config/form/
expect=html:not-contains=/admin/system/identity/save

action=fill:id=field-hostname:value=web-form-save-host
action=fill:id=field-domain:value=wb-form-save.example
action=click:id=workbench-form-save
action=wait

action=open:path=/config/diff
expect=html:contains=bgp router-id 10.0.0.1
expect=html:contains=system dns timeout 7
expect=html:contains=system host web-form-save-host
expect=html:contains=system domain wb-form-save.example