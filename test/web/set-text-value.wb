# Test: setting a text field value persists after wait
# VALIDATES: filling an input triggers hx-post and value is accepted
# PREVENTS: broken hx-post on blur, value not saved to editor tree

option=timeout:value=30s

action=open:path=/show/environment/daemon/
# By the editor's own id. Finding it by "zeuser" found it through its
# PLACEHOLDER, which was the accessible name only while the label was unbound;
# the placeholder is also the DEFAULT here, so the selector went stale the
# moment the schema changed it.
action=fill:id=input-environment-sdaemon-suser:value=testadmin
action=wait:ms=2000

# ACCEPTED, not merely typed. The snapshot is an accessibility tree: a textbox
# renders its accessible NAME or nothing, never its value, so asserting the
# typed text could never pass here. It would also have been the wrong question.
# A browser shows what you typed whether or not anything was posted, so the
# proof that the edit reached the editor tree is the state only a POST
# produces: the field carries the set tag, and the commit bar counts the change.
expect=html:contains=ze-field-tag-set
expect=element:text=1 pending change
