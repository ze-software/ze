# Test: a fresh browser opens the graphical YANG editor by default
# VALIDATES: AC-31 of spec-web-cli-config-one-off-defects, with no mode override
# PREVENTS: the unfinished Workbench becoming the default interface

option=timeout:value=30s

action=open:path=/show/
expect=element:id=finder
expect=element:text=environment
expect=element:not-text=panic
expect=element:not-id=workbench-shell
