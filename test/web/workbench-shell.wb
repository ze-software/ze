# Test: default Web UI renders Workbench shell without bottom CLI
# VALIDATES: /show/ opens the operator workbench with top navigation and workspace
# PREVENTS: Finder fallback or CLI footer leaking onto normal pages

option=timeout:value=30s

action=open:path=/show/
expect=element:id=workbench-shell
expect=element:id=workbench-topbar
expect=element:id=workbench-nav
expect=element:id=workbench-workspace
expect=element:text=Dashboard
expect=element:text=Interfaces
expect=element:text=Routing
expect=element:text=CLI
expect=element:not-id=cli-bar
expect=element:not-id=cli-input
expect=element:not-text=panic
