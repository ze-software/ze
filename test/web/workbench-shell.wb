# Test: an explicit Workbench selection renders its shell without bottom CLI
# VALIDATES: /show/ retains the experimental Workbench with navigation and workspace
# PREVENTS: changing the default from removing the alternative interface

option=env:var=ze.web.ui-mode:value=workbench
option=timeout:value=30s

action=open:path=/show/
expect=element:id=workbench-shell
expect=element:id=workbench-topbar
expect=element:id=workbench-nav
expect=element:id=workbench-workspace
expect=element:text=Dashboard
expect=element:text=Interfaces
expect=element:text=Routing
expect=element:text=CLI
expect=element:text=YANG editor
expect=element:not-id=cli-bar
expect=element:not-id=cli-input
expect=element:not-text=Workbench requires a viewport
expect=element:not-text=panic
