# Test: Live Log page renders and the SSE stream connects
# VALIDATES: AC-12 -- Live Log page opens the SSE stream and reaches "Connected"
# PREVENTS: Live Log stuck on static "Connecting..." text forever

option=timeout:value=30s

action=open:path=/show/logs/live/
expect=element:id=workbench-shell
expect=html:contains=Live Log
expect=element:id=log-stream
# log-live.js flips #log-status to "Connected. Waiting for events..." on SSE open;
# asserting the connected state proves the stream is live, not stuck on "Connecting".
expect=html:contains=Connected
