# Test: a genuine reader inspects caller-held configuration through native controls
# VALIDATES: AC-45, descriptor-derived inspection through the real daemon.
# PREVENTS: edit authorization being required for a read or source bytes becoming a candidate.

option=timeout:value=90s
option=server:kind=daemon
option=auth:user=admin:password=ze-supplied-admin:role=admin
option=auth:user=noc:password=ze-supplied-reader:role=read-only

action=login:user=noc:password=ze-supplied-reader
action=open:path=/show/
action=click:id=graphical-actions-toggle
action=click:id=graphical-supplied-toggle
expect=element:not-id=graphical-edit-toggle

action=select:id=graphical-supplied-command:value=show config supplied dump
action=fill:id=graphical-supplied-content:value=bgp { router-id 203.0.113.253; peer peer1 { description supplied-native-paste; connection { remote { ip 127.0.0.1; } local { ip 127.0.0.1; } } session { asn { remote 65533; local 65533; } } } } system { host supplied-native-paste; }
action=click:id=graphical-supplied-submit
expect=element:id=graphical-supplied-result
expect=html:id=graphical-supplied-result:contains=supplied-native-paste
action=select:id=graphical-supplied-command:value=show config supplied fmt
action=fill:id=graphical-supplied-content:value=bgp { router-id 203.0.113.253; peer peer1 { description supplied-native-format; connection { remote { ip 127.0.0.1; } local { ip 127.0.0.1; } } session { asn { remote 65533; local 65533; } } } } system { host supplied-native-format; }
action=click:id=graphical-supplied-submit
expect=html:id=graphical-supplied-result:contains=supplied-native-format
expect=html:id=graphical-supplied-result:contains=system host supplied-native-format
action=select:id=graphical-supplied-command:value=show config supplied graph
action=fill:id=graphical-supplied-content:value=bgp { router-id 203.0.113.253; peer peer1 { description supplied-native-graph; connection { remote { ip 127.0.0.1; } local { ip 127.0.0.1; } } session { asn { remote 65533; local 65533; } } } } system { host supplied-native-graph; }
action=click:id=graphical-supplied-submit
expect=html:id=graphical-supplied-result:contains="nodes"
expect=html:id=graphical-supplied-result:contains="edges"
action=select:id=graphical-supplied-command:value=show config supplied validation
action=fill:id=graphical-supplied-content:value=bgp { router-id 203.0.113.253; peer peer1 { description supplied-native-validation; connection { remote { ip 127.0.0.1; } local { ip 127.0.0.1; } } session { asn { remote 65533; local 65533; } } } } system { host supplied-native-validation; }
action=click:id=graphical-supplied-submit
expect=html:id=graphical-supplied-result:contains=valid           true
expect=html:id=graphical-supplied-result:contains=path            supplied.conf
action=open:path=/cli
action=fill:id=terminal-input:value=show confirmed | format config
action=press:id=terminal-input:key=Enter
expect=element:text=1.2.3.4
expect=element:not-text=supplied-native-paste
expect=element:not-text=supplied-native-format
expect=element:not-text=supplied-native-validation

