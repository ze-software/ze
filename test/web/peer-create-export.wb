# Test: create a peer through CLI mode and verify graphical configuration
# VALIDATES: a missing peer is refused until set creates it and its remote IP survives navigation
# PREVENTS: navigation manufacturing a peer or a new peer losing its fields

option=env:var=ze.web.ui-mode:value=finder
option=timeout:value=30s

action=open:path=/show/bgp/peer/test-peer/
expect=element:id=notif-toast
expect=html:contains=class="notification-message">entry "test-peer" does not exist</span>
expect=url:contains=/show/
expect=url:not-contains=/show/bgp/

# The notification consumes its error query. Reading the list also proves that
# following a missing entry URL did not create that entry in the candidate.
action=open:path=/show/bgp/peer/
expect=element:id=btn-add-entry
expect=html:not-contains=data-row-key="test-peer"

action=click:text=CLI
expect=element:id=terminal-input

action=fill:id=terminal-input:value=set bgp peer test-peer connection remote ip 192.168.1.1
action=press:id=terminal-input:key=Enter
action=wait
expect=element:text=192.168.1.1

action=open:path=/show/bgp/peer/test-peer/connection/remote/
expect=breadcrumb:contains=test-peer
expect=element:text=192.168.1.1
expect=html:contains=value="192.168.1.1"
