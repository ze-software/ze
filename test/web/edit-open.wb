# Test: BGP show view renders leaf fields and children
# VALIDATES: BGP container renders leaf names and child container links
# PREVENTS: missing leaf rendering, broken container template

option=env:var=ze.web.ui-mode:value=finder
option=timeout:value=30s

action=open:path=/show/bgp/
expect=element:id=input-bgp-srouter--id
expect=element:text=router-id
expect=html:contains=Router ID
expect=element:text=peer
expect=element:text=group
expect=element:text=session
