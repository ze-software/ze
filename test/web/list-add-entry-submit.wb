# Test: Workbench Add action creates a BGP group pending config row
# VALIDATES: table Add buttons open real config-entry forms and save through config mutation
# PREVENTS: /show/.../add links routing to dead pages

option=timeout:value=45s

action=open:path=/show/bgp/group/
expect=element:id=workbench-shell
expect=element:text=BGP Groups
expect=element:text=Add Group

action=click:id=btn-add-entry
action=wait:ms=500
expect=element:text=Add Group
expect=element:id=field-name

action=fill:id=field-name:value=web-group
action=click:text=Save
action=wait:ms=1000
expect=element:text=web-group
action=open:path=/config/changes
expect=html:contains=commit-bar visible
expect=html:contains=pending change
