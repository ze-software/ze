# Test: create firewall objects graphically and configure them in CLI mode
# VALIDATES: table, chain and term add forms combine with CLI fields and successful publication
# PREVENTS: broken add forms, incorrect context or configuration loss

option=env:var=ze.web.ui-mode:value=finder
option=timeout:value=60s

action=open:path=/show/firewall/table/
action=click:id=btn-add-entry-finder-show-firewall-table
action=fill:text=name:value=filter
action=press:key=Enter
action=wait-until:path=/show/firewall/table/:contains=/show/firewall/table/filter/
expect=element:text=filter

action=open:path=/show/
expect=element:text=CLI
expect=element:not-id=cli-input
action=click:text=CLI
expect=element:id=terminal-input

# The web-only server commits configuration through the real validator but
# applies no kernel rules. Name the target backend instead of a host default.
action=fill:id=terminal-input:value=set firewall backend nft
action=press:id=terminal-input:key=Enter
action=wait

action=fill:id=terminal-input:value=set firewall table filter family inet
action=press:id=terminal-input:key=Enter
action=wait

action=open:path=/show/firewall/table/filter/chain/
action=click:id=btn-add-entry-finder-show-firewall-table-filter-chain
action=fill:text=name:value=input
action=press:key=Enter
action=wait-until:path=/show/firewall/table/filter/chain/:contains=/show/firewall/table/filter/chain/input/
expect=element:text=input

action=open:path=/show/
expect=element:text=CLI
expect=element:not-id=cli-input
action=click:text=CLI
expect=element:id=terminal-input

action=fill:id=terminal-input:value=set firewall table filter chain input type filter
action=press:id=terminal-input:key=Enter
action=wait

action=fill:id=terminal-input:value=set firewall table filter chain input hook input
action=press:id=terminal-input:key=Enter
action=wait

action=fill:id=terminal-input:value=set firewall table filter chain input priority 0
action=press:id=terminal-input:key=Enter
action=wait

action=fill:id=terminal-input:value=set firewall table filter chain input policy drop
action=press:id=terminal-input:key=Enter
action=wait

action=open:path=/show/firewall/table/filter/chain/input/term/
action=click:id=btn-add-entry-finder-show-firewall-table-filter-chain-input-term
action=fill:text=name:value=allow-bgp
action=press:key=Enter
action=wait-until:path=/show/firewall/table/filter/chain/input/term/:contains=/show/firewall/table/filter/chain/input/term/allow-bgp/
expect=element:text=allow-bgp

action=open:path=/show/
expect=element:text=CLI
expect=element:not-id=cli-input
action=click:text=CLI
expect=element:id=terminal-input

action=fill:id=terminal-input:value=set firewall table filter chain input term allow-bgp from protocol tcp
action=press:id=terminal-input:key=Enter
action=wait

action=fill:id=terminal-input:value=set firewall table filter chain input term allow-bgp from destination-port 179
action=press:id=terminal-input:key=Enter
action=wait

action=fill:id=terminal-input:value=set firewall table filter chain input term allow-bgp then accept
action=press:id=terminal-input:key=Enter
action=wait

action=fill:id=terminal-input:value=top
action=press:id=terminal-input:key=Enter
action=wait

action=fill:id=terminal-input:value=commit now
action=press:id=terminal-input:key=Enter
action=wait
expect=element:text=commit successful

action=open:path=/config/diff
expect=element:text=Review changes (0)
action=open:path=/show/firewall/
expect=element:id=input-firewall-sbackend
expect=html:contains=value="nft"
action=open:path=/show/firewall/table/
expect=element:text=filter
