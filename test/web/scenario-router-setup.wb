# Test: configure BGP peer in CLI mode, verify table, commit
# VALIDATES: CLI set creates a peer shown graphically before and after a successful commit
# PREVENTS: peer creation, table refresh or publication losing data

option=env:var=ze.web.ui-mode:value=finder
option=timeout:value=60s

action=open:path=/show/bgp/peer/
expect=element:text=CLI
expect=element:not-id=cli-input
action=click:text=CLI
expect=element:id=terminal-input

action=fill:id=terminal-input:value=set bgp router-id 10.0.0.9
action=press:id=terminal-input:key=Enter
action=wait

action=fill:id=terminal-input:value=set bgp session asn local 65000
action=press:id=terminal-input:key=Enter
action=wait

action=fill:id=terminal-input:value=set bgp peer setup-test connection remote ip 192.0.2.1
action=press:id=terminal-input:key=Enter
action=wait

action=fill:id=terminal-input:value=set bgp peer setup-test connection local ip auto
action=press:id=terminal-input:key=Enter
action=wait

action=fill:id=terminal-input:value=set bgp peer setup-test session asn remote 64500
action=press:id=terminal-input:key=Enter
action=wait

action=open:path=/show/bgp/peer/
expect=element:text=setup-test

action=click:text=CLI
expect=element:id=terminal-input

action=fill:id=terminal-input:value=commit now
action=press:id=terminal-input:key=Enter
action=wait
expect=element:text=commit successful

action=open:path=/config/diff
expect=element:text=Review changes (0)
action=open:path=/show/bgp/peer/
expect=element:text=setup-test
expect=element:text=192.0.2.1
