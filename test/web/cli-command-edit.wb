# Test: CLI edit navigates to a configured YANG path
# VALIDATES: edit changes terminal context and schema completion follows that position
# PREVENTS: edit leaving completion at the root or refusing an existing block

option=env:var=ze.web.ui-mode:value=finder
option=timeout:value=30s

action=open:path=/show/
expect=element:text=CLI
expect=element:not-id=cli-input
action=click:text=CLI
expect=element:id=terminal-input

action=fill:id=terminal-input:value=set environment daemon user browser-nav
action=press:id=terminal-input:key=Enter
action=wait

action=fill:id=terminal-input:value=edit environment
action=press:id=terminal-input:key=Enter
action=wait
expect=element:text=ze[environment]#

action=fill:id=terminal-input:value=set
action=press:id=terminal-input:key=?
expect=element:text=log
expect=element:text=daemon
