# Test: BGP local container shows AS number input field
# VALIDATES: local container renders AS number as interactive input
# PREVENTS: numeric fields not rendering in nested container

option=timeout:value=30s

action=open:path=/show/bgp/session/asn/

# INTERACTIVE is the claim, so the assertion is the wiring rather than the text:
# an editor that renders without hx-post draws a box the operator can type into
# and cannot save from.
expect=element:id=input-bgp-ssession-sasn-slocal
expect=html:contains=hx-post="/config/set/bgp/session/asn"
