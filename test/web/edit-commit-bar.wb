# Test: YANG editor chrome links to the dedicated CLI
# VALIDATES: the graphical page carries its CLI link, theme toggle and error control
# PREVENTS: missing toolbar controls or inaccessible command mode

option=env:var=ze.web.ui-mode:value=finder
option=timeout:value=30s

action=open:path=/show/bgp/
expect=element:text=CLI
expect=element:text=Errors
expect=element:id=theme-toggle
expect=element:not-id=cli-input
action=click:text=CLI
expect=element:id=terminal-input
