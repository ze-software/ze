# Test: CLI completion dropdown navigates with arrow keys
# VALIDATES: ArrowDown selects an actual completion and Enter accepts it and closes the menu
# PREVENTS: history navigation replacing dropdown navigation

option=env:var=ze.web.ui-mode:value=finder
option=timeout:value=30s

action=open:path=/show/
expect=element:text=CLI
expect=element:not-id=cli-input
action=click:text=CLI
expect=element:id=terminal-input

# A multi-match prefix keeps the menu open; sh has only show and auto-completes.
action=fill:id=terminal-input:value=s
action=press:id=terminal-input:key=Tab
expect=element:text=show
expect=html:contains=class="terminal-completions"

action=press:id=terminal-input:key=ArrowDown
expect=html:contains=class="cli-completion-item selected"

action=press:id=terminal-input:key=Enter
expect=html:contains=class="terminal-completions is-hidden" id="terminal-completions"
expect=element:id=terminal-input
