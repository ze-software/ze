# Test: Workbench creates and edits interface configuration
# VALIDATES: users can add an interface from the Interfaces page and see a pending change
# PREVENTS: interface management being possible only through the old bottom CLI

option=timeout:value=60s

action=open:path=/show/iface/
expect=element:id=workbench-shell
expect=element:text=Interfaces
expect=element:text=Add Interface

action=click:id=btn-add-entry
action=wait:ms=500
expect=element:text=Add Interface
expect=element:id=field-interface-name

action=fill:id=field-interface-name:value=web-eth0
action=click:text=Save
action=wait:ms=1000
expect=element:text=web-eth0
expect=element:text=Review & Commit

# The leaf editor names its INPUT after the whole path (fieldInputID,
# internal/component/web/view.go) and keeps field-<leaf> for the wrapper div,
# which holds no value.
action=open:path=/show/interface/ethernet/web-eth0/
action=wait
expect=element:id=input-interface-sethernet-sweb--eth0-smtu
action=fill:id=input-interface-sethernet-sweb--eth0-smtu:value=9000
action=click:text=Save
action=wait:ms=1000

# The DIFF, not the presence of the commit bar. Creating the interface already
# made the bar visible, so "Review & Commit" is true whether or not this edit
# saved anything. 9000 rather than 1500 for the same reason: 1500 is the YANG
# default, so the tree reads the same whether the POST landed or not.
action=open:path=/config/diff
expect=html:contains=mtu 9000
