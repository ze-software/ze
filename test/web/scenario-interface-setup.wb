# Test: Workbench creates and edits interface configuration
# VALIDATES: users can add an interface from the Interfaces page and see a pending change
# PREVENTS: interface management being possible only through the old bottom CLI

option=timeout:value=60s

action=open:path=/show/iface/
expect=element:id=workbench-shell
expect=element:text=Interfaces
expect=element:text=Add Interface

action=click:id=btn-add-entry
action=wait:ms=500
expect=element:text=Add Interface
expect=element:id=field-interface-name

action=fill:id=field-interface-name:value=web-eth0
action=click:text=Save
action=wait:ms=1000
expect=element:text=web-eth0
expect=element:text=Review & Commit

action=open:path=/show/interface/ethernet/web-eth0/
action=wait
expect=element:id=field-mtu
action=fill:id=field-mtu:value=1500
action=click:text=Save
action=wait:ms=1000
expect=element:text=Review & Commit
