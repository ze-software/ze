# Test: create peer in CLI mode and inspect table fields
# VALIDATES: graphical peer views expose the configured name, remote IP and remote ASN
# PREVENTS: candidate fields being lost or omitted from graphical readback

option=env:var=ze.web.ui-mode:value=finder
option=timeout:value=60s

action=open:path=/show/bgp/peer/
expect=element:text=CLI
expect=element:not-id=cli-input
action=click:text=CLI
expect=element:id=terminal-input

action=fill:id=terminal-input:value=set bgp peer field-test connection remote ip 10.99.0.2
action=press:id=terminal-input:key=Enter
action=wait

action=fill:id=terminal-input:value=set bgp peer field-test session asn remote 65099
action=press:id=terminal-input:key=Enter
action=wait

action=open:path=/show/bgp/peer/
expect=element:text=field-test
expect=element:text=10.99.0.2

action=open:path=/show/bgp/peer/field-test/session/asn/
expect=element:text=65099
expect=html:contains=value="65099"
