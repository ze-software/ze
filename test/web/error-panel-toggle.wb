# Test: error panel button is clickable
# VALIDATES: clicking Errors button does not crash page
# PREVENTS: error panel JS broken, button not wired

option=timeout:value=30s

action=open:path=/show/bgp/
expect=element:text=Errors

action=click:text=Errors
action=wait:ms=500

# The page is still rendering its own content after the click. router-id is the
# leaf NAME, which is the editor's accessible name; the YANG description this
# asserted before was the name an unbound editor fell back to.
expect=element:text=router-id
