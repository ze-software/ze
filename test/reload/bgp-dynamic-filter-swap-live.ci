# Test: a reload that changes a dynamic group's `$remote_as` import chain keeps
#       the RUNNING dynamic session and enforces the new chain, resolved with the
#       AS the peer announced.
# Initial config: one dynamic group (iBGP, AS 65533) whose import chain is
#                 `bgp-filter-prefix:ALLOW-$remote_as`; prefix-lists ALLOW-65533
#                 (10.0.0.0/8 ge 16 le 24 accept) and DENY-65533 (same entry,
#                 reject). The test peer dials Ze and announces 10.1.0.0/24.
# Live change:    the staged fixture (reload/live-stages, run inside the daemon)
#                 rewrites the chain to `bgp-filter-prefix:DENY-$remote_as` and
#                 sends SIGHUP.
# Expected:       one TCP connection. The same UPDATE (10.0.0.0/24) evaluated
#                 against the dynamic peer's live chain answers accept before
#                 the reload and reject after it, which it can only do when the
#                 template's `$remote_as` was resolved to 65533 against the
#                 running peer. 10.1.0.0/24, accepted before the reload, is still
#                 received after it: the swap re-imports nothing (R-21, re-import
#                 owned by spec-bgp-filtered-route-storage AC-3).
#
# VALIDATES: spec-bgp-live-receive-binding-and-bfd-keep-session AC-22 (wiring
#            row "dynamic step -> write section resolves next against the learned
#            AS -> copier"), with the dry-run pattern of
#            reload-import-policy-applies.ci (show policy test reads the chain
#            runIngressPolicyChain reads).
# PREVENTS: a dynamic import-policy edit that resets every dynamic session, and a
#           swap that writes the template chain unresolved (`DENY-$remote_as`
#           names no prefix-list) onto a running peer.
#
# DISCRIMINATION: the continuity carrier is the clean-shutdown NOTIFICATION, as
# in reload-dynamic-peer-survives.ci: the peer dials once and never re-dials, so
# the Cease/Administrative Shutdown it expects arrives on the first connection
# only when the reload kept it.
#
# Red until that spec's Phase 3: today the template change restarts the dynamic
# peer ("dynamic peer restart required ... changed=group template"), the peer
# reads Cease subcode 6, and the after-reload policy test finds no peer.
option=timeout:value=60s
option=env:var=ze.log.bgp.reactor:value=info

stdin=peer:terminator=EOF_PEER
option=asn:value=65533
option=tcp_connections:value=1
option=timeout:value=50s
# ze-peer creates this file on the daemon's first UPDATE; the staged fixture
# holds its first read until it exists.
option=established-file:path=established
# 10.1.0.0/24, origin IGP, empty AS_PATH (iBGP), next-hop 10.0.0.1,
# LOCAL_PREF 100: announced once the OPEN exchange is done. ALLOW-65533 accepts it.
# Sent once. The dynamic session is held until every plugin, bgp-filter-prefix
# included, finished startup (Reactor.peersStarted), so this one copy meets a
# connected filter plugin; the stage's `show bgp rib received` reads it.
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00300200000015400101004002004003040A00000140050400000064180A0100
# EOR from ze
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
# The clean shutdown after the last stage, on the SAME connection: Cease (6) /
# Administrative Shutdown (2, RFC 4486) with the RFC 8203 default text.
expect=bgp:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002D0306021741646D696E6973747261746976652053687574646F776E
EOF_PEER

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	internal bgp-rib {
		use bgp-rib
	}
	external live-stages {
		run "le test fixture reload/live-stages stages.script"
		encoder json
	}
}

bgp {
	policy {
		prefix-list ALLOW-65533 {
			entry 10.0.0.0/8 {
				ge 16
				le 24
				action accept
			}
		}
		prefix-list DENY-65533 {
			entry 10.0.0.0/8 {
				ge 16
				le 24
				action reject
			}
		}
	}

	group ix {
		connection {
			remote {
				ip dynamic
				connect false
				range 127.0.0.0/8
			}
			local {
				ip 127.0.0.1
				accept true
			}
		}
		session {
			asn {
				local 65533
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast {
					mode enable
					prefix {
						maximum 10000
					}
				}
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		filter {
			import [ bgp-filter-prefix:ALLOW-$remote_as ]
		}
		attach process bgp-rib {
			receive [ update-received state ]
		}
	}
}
EOF_CONF

# The second config: the import chain is the ONLY difference (ALLOW -> DENY).
# The plugin block is byte-identical, so the staged fixture survives the reload.
tmpfs=config2.conf:terminator=EOF_CONF2
plugin {
	internal bgp-rib {
		use bgp-rib
	}
	external live-stages {
		run "le test fixture reload/live-stages stages.script"
		encoder json
	}
}

bgp {
	policy {
		prefix-list ALLOW-65533 {
			entry 10.0.0.0/8 {
				ge 16
				le 24
				action accept
			}
		}
		prefix-list DENY-65533 {
			entry 10.0.0.0/8 {
				ge 16
				le 24
				action reject
			}
		}
	}

	group ix {
		connection {
			remote {
				ip dynamic
				connect false
				range 127.0.0.0/8
			}
			local {
				ip 127.0.0.1
				accept true
			}
		}
		session {
			asn {
				local 65533
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast {
					mode enable
					prefix {
						maximum 10000
					}
				}
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		filter {
			import [ bgp-filter-prefix:DENY-$remote_as ]
		}
		attach process bgp-rib {
			receive [ update-received state ]
		}
	}
}
EOF_CONF2

tmpfs=stages.script:terminator=EOF_SCRIPT
# Before the reload: the live chain is ALLOW-65533 and the peer's route is in.
await-file established
has show policy test peer 127.0.0.1 import update FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002F02000000144001010040020602010000FDE940030401010101180A0000 => "action":"accept"
has show bgp rib received => 10.1.0.0/24
reload config2.conf
# After it: the live chain is DENY-65533, and the route accepted before stays.
has show policy test peer 127.0.0.1 import update FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002F02000000144001010040020602010000FDE940030401010101180A0000 => "action":"reject"
has show bgp rib received => 10.1.0.0/24
say DYNAMIC-FILTER-SWAP: the reloaded chain rejects, the route accepted before stays
EOF_SCRIPT

cmd=background:seq=1:exec=le test peer --dial 127.0.0.1:$PORT:stdin=peer
cmd=foreground:seq=2:exec=ze --plugin ze.bgp-filter-prefix -:stdin=ze-bgp:timeout=60s

expect=stderr:contains=DYNAMIC-FILTER-SWAP: the reloaded chain rejects, the route accepted before stays
reject=stderr:pattern=ZE-OBSERVER-FAIL
reject=stderr:pattern=dynamic peer restart required
# The session under test is a DYNAMIC peer's, built once, before the reload.
expect=stderr:contains=dynamic peer created
reject=stderr:pattern=received SIGHUP[\s\S]*dynamic peer created
