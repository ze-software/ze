# Reload 5 (accepted): deletes peer lab and updates receive > from to /bgp/peer/edge1 in one commit.
tmpfs=reload5-clean-delete.conf:terminator=EOF_CONF5
system {
	authentication {
		user admin {
			password "$2a$04$UlwuiuH82Unfsq.XEMPGJeDkXwbm3KW.nvVaVXOd/JeFK8VjMjrQO"
		}
	}
}
environment {
	ssh {
