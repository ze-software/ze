cmd=foreground:seq=1:exec=ze init:stdin=init-answers:exit=0
cmd=background:seq=2:name=peer-edge1:exec=le test peer --bind 127.0.0.2 --port $PORT:stdin=peer-edge1
cmd=background:seq=3:name=peer-lab:exec=le test peer --bind 127.0.0.3 --port $PORT:stdin=peer-lab
cmd=background:seq=4:name=daemon:exec=ze start running.conf:ready=Ze running.
expect=stderr:contains=/bgp/peer/lab
reject=stderr:pattern=ZE-OBSERVER-FAIL
reject=stderr:pattern=panic
reject=stderr:pattern=peer restart required

# Phase 0: wait for both sessions up and both initial routes recorded in collector.
cmd=foreground:seq=5:exec=le test fixture plugin/bus-wait-file edge1.up:exit=0
cmd=foreground:seq=6:exec=le test fixture plugin/bus-wait-file lab.up:exit=0
cmd=foreground:seq=7:exec=le test fixture plugin/bus-assert-implied poll-file-contains col.log 10.1.0.0/24:exit=0
cmd=foreground:seq=8:exec=le test fixture plugin/bus-assert-implied poll-file-contains col.log 10.11.0.0/24:exit=0

# Reload 1: narrow collector to edge1 only -> 10.2.0.0/24 recorded, 10.12.0.0/24 filtered out (causal fence: RIB holds both).
cmd=foreground:seq=9:exec=le test fixture plugin/bus-sighup-reload reload1-edge1.conf running.conf r1.applied:exit=0
expect=stdout:contains=OK: SIGHUP reload reload1-edge1.conf applied
cmd=foreground:seq=10:exec=ze cli -c "request peer * refresh ipv4/unicast":exit=0
cmd=foreground:seq=11:exec=le test fixture daemon/await-answer-all "show bgp rib" 10.2.0.0/24 10.12.0.0/24:exit=0
cmd=foreground:seq=12:exec=le test fixture plugin/bus-assert-implied poll-file-contains col.log 10.2.0.0/24:exit=0
cmd=foreground:seq=13:exec=le test fixture plugin/bus-assert-implied file-not-contains col.log 10.12.0.0/24:exit=0

# Reload 2: switch collector to lab only -> 10.13.0.0/24 recorded, 10.3.0.0/24 filtered out (causal fence: RIB holds both).
cmd=foreground:seq=14:exec=le test fixture plugin/bus-sighup-reload reload2-lab.conf running.conf r2.applied:exit=0
expect=stdout:contains=OK: SIGHUP reload reload2-lab.conf applied
cmd=foreground:seq=15:exec=ze cli -c "request peer * refresh ipv4/unicast":exit=0
cmd=foreground:seq=16:exec=le test fixture daemon/await-answer-all "show bgp rib" 10.3.0.0/24 10.13.0.0/24:exit=0
cmd=foreground:seq=17:exec=le test fixture plugin/bus-assert-implied poll-file-contains col.log 10.13.0.0/24:exit=0
cmd=foreground:seq=18:exec=le test fixture plugin/bus-assert-implied file-not-contains col.log 10.3.0.0/24:exit=0

# Reload 3: remove receive > from -> both 10.4.0.0/24 and 10.14.0.0/24 recorded.
cmd=foreground:seq=19:exec=le test fixture plugin/bus-sighup-reload reload3-all.conf running.conf r3.applied:exit=0
expect=stdout:contains=OK: SIGHUP reload reload3-all.conf applied
cmd=foreground:seq=20:exec=ze cli -c "request peer * refresh ipv4/unicast":exit=0
cmd=foreground:seq=21:exec=le test fixture plugin/bus-assert-implied poll-file-contains col.log 10.4.0.0/24:exit=0
cmd=foreground:seq=22:exec=le test fixture plugin/bus-assert-implied poll-file-contains col.log 10.14.0.0/24:exit=0

# Confirm zero session resets across Reloads 1-3 on both peers.
cmd=foreground:seq=23:exec=ze cli -c "show bgp peer detail edge1 | json":exit=0
expect=stdout:pattern="connections-dropped":\s*0
cmd=foreground:seq=24:exec=ze cli -c "show bgp peer detail lab | json":exit=0
expect=stdout:pattern="connections-dropped":\s*0

# Reload 4 (refused): deleting lab while receive > from still names /bgp/peer/lab fails.
cmd=foreground:seq=25:exec=ze config validate reload4-dangling-lab.conf:exit=1
expect=stdout:contains=bus > endpoint collector > receive > from: "/bgp/peer/lab" names no configured bus participant
cmd=foreground:seq=26:exec=le test fixture plugin/bus-sighup-reload-refused reload4-dangling-lab.conf running.conf r4.refused:exit=0
expect=stdout:contains=OK: SIGHUP reload reload4-dangling-lab.conf failed

# Reload 5 (accepted): deleting lab and updating receive > from in one commit passes.
cmd=foreground:seq=27:exec=le test fixture plugin/bus-sighup-reload reload5-clean-delete.conf running.conf r5.applied:exit=0
expect=stdout:contains=OK: SIGHUP reload reload5-clean-delete.conf applied
cmd=foreground:seq=28:exec=ze cli -c "show bgp peer list":exit=0
expect=stdout:contains=edge1
reject=stdout:contains=lab

cmd=stop:seq=29:name=daemon:signal=term
cmd=stop:seq=30:name=peer-edge1
cmd=stop:seq=31:name=peer-lab
