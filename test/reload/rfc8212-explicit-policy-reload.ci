# Test: an Established EBGP session gains and loses explicit policy by live
#       reload, without a session reset (RFC 8212 Section 3).
# Topology: peer-1 (127.0.0.1, AS 65001) is the source and starts with NO
#   filter block at all; peer-3 (127.0.0.3, AS 65003) is the explicitly
#   policied positive control, offering 10.72.2.0/24 and a longer 10.72.3.0/24;
#   peer-2 (127.0.0.2, IBGP) is the downstream echo peer whose echoes the
#   observer reads as the bytes Ze wrote to it. Route Refresh is negotiated.
# Method (`reload/rfc8212-explicit-policy-reload`, rfc8212_reload.go,
#   rfc8212ReloadRecover):
#   Export stage (AC-6 export, AC-7):
#   - with no export policy the configured 192.168.0.0/24 is held back: only
#     the EOR reaches the source, and its effective export final is reject;
#   - reload adds `filter export { final accept; }`: 192.168.0.0/24 reaches
#     the source's ORIGINAL socket (export.announced);
#   - reload removes the only export policy: it is withdrawn (export.withdrawn);
#   - reload adds it again: re-announced (export.restored);
#   each step answers `applied`, keeps every session's ports and counters and
#   sends no ROUTE-REFRESH.
#   Import stage (AC-6 import, D-1 recovery):
#   - the source answers 192.168.1.0/24 with 10.72.1.0/24 and 10.72.3.0/24,
#     both denied by the absent import policy; the downstream holds only the
#     control's 10.72.2.0/24 and 10.72.3.0/24;
#   - reload adds `filter import { final accept; }`: Ze sends ONE ROUTE-REFRESH
#     on the same session, the source re-sends, and the downstream gains
#     10.72.1.0/24 with the source's attributes, selected best.
# Track A (D-1 refresh on import relaxation) is NOT implemented yet: the import
#   stage is red until it lands. The export stage runs first and is green now.
# Discrimination of the export stage: an overlay mutant of
#   reactor/peer_settings_apply.go with `finalChanged := false` turns it red.
# RFC requirement: RFC8212-3-2 positive -- a reload that gives the Established
# EBGP source peer-1 an explicit export `final accept` sends it the configured
# 192.168.0.0/24 on the same session, and adding it again after its removal
# sends it again.
#
option=timeout:value=180s

stdin=source:terminator=EOF_SOURCE
option=tcp_connections:value=1
option=linger:value=true
option=asn:value=65001
# No export policy: Ze's EOR only.
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
expect=bgp:conn=1:seq=2:announced=18C0A800
action=rewrite:conn=1:seq=2:source=marker:dest=export.announced
expect=bgp:conn=1:seq=3:withdrawn=18C0A800
action=rewrite:conn=1:seq=3:source=marker:dest=export.withdrawn
expect=bgp:conn=1:seq=4:announced=18C0A800
action=rewrite:conn=1:seq=4:source=marker:dest=export.restored
# Seed: export 192.168.1.0/24 arrives; answer with 10.72.1.0/24 and the
# preferred (shorter AS_PATH) 10.72.3.0/24. Origin IGP, AS_PATH 65001,
# NEXT_HOP 192.0.2.1, MED 9, COMMUNITY 65001:99. The second also carries
# ATOMIC_AGGREGATE so the reader does not coalesce the two.
expect=bgp:conn=1:seq=5:announced=18C0A801
action=send:conn=1:seq=5:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF003D02000000224001010040020602010000FDE9400304C000020180040400000009C00804FDE90063180A4801
action=send:conn=1:seq=5:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF004002000000254001010040020602010000FDE9400304C000020180040400000009400600C00804FDE90063180A4803
# Re-send the same two ONLY after an IPv4 unicast ROUTE-REFRESH on this socket.
expect=bgp:conn=1:seq=6:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170500010001
action=send:conn=1:seq=6:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF003D02000000224001010040020602010000FDE9400304C000020180040400000009C00804FDE90063180A4801
action=send:conn=1:seq=6:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF004002000000254001010040020602010000FDE9400304C000020180040400000009400600C00804FDE90063180A4803
EOF_SOURCE

stdin=alternate:terminator=EOF_ALTERNATE
option=tcp_connections:value=1
option=linger:value=true
option=asn:value=65003
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
# Seed: 10.72.2.0/24 and the longer alternate 10.72.3.0/24. AS_PATH 65003 x3,
# NEXT_HOP 192.0.2.3, MED 9, COMMUNITY 65003:33.
expect=bgp:conn=1:seq=2:announced=18C0A801
action=send:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0045020000002A4001010040020E02030000FDEB0000FDEB0000FDEB400304C000020380040400000009C00804FDEB0021180A4802
action=send:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0045020000002A4001010040020E02030000FDEB0000FDEB0000FDEB400304C000020380040400000009C00804FDEB0021180A4803
EOF_ALTERNATE

stdin=sink:terminator=EOF_SINK
option=tcp_connections:value=1
option=linger:value=true
option=asn:value=65000
EOF_SINK

tmpfs=marker:terminator=EOF_MARKER
source saw the expected UPDATE on its original connection
EOF_MARKER

stdin=ze-bgp:terminator=EOF_CONF
plugin {
    internal adj-rib-in { use bgp-adj-rib-in; }
    internal rs { use bgp-rs; }
    internal rib { use bgp-rib; }
    external rfc8212-reload { run "le test fixture reload/rfc8212-explicit-policy-reload"; encoder json; }
}
bgp {
    peer peer-1 {
        connection { remote { ip 127.0.0.1; } local { ip 127.0.0.4; accept false; } }
        session {
            asn { local 65000; remote 65001; }
            router-id 1.2.3.4;
            family { ipv4/unicast { prefix { maximum 10000; } } }
            # Absent means not advertised: the import recovery needs Route Refresh.
            capability { graceful-restart disable; route-refresh enable; }
        }
        behavior { group-updates disable; }
        update {
            attribute { origin igp; next-hop 10.0.0.1; }
            nlri { ipv4/unicast add 192.168.0.0/24; }
        }
        attach process rfc8212-reload { send [ update ]; }
        attach process adj-rib-in { receive [ update-received state ]; }
        attach process rs { receive [ update-received state open-received refresh ]; }
        attach process rib { receive [ update state refresh ]; }
    }
    peer peer-2 {
        connection { remote { ip 127.0.0.2; } local { ip 127.0.0.5; accept false; } }
        session {
            asn { local 65000; remote 65000; }
            aigp { enabled false; }
            router-id 1.2.3.4;
            family { ipv4/unicast { prefix { maximum 10000; } } }
            capability { graceful-restart disable; }
        }
        behavior { group-updates disable; }
        attach process rfc8212-reload { receive [ update-received state ]; send [ update ]; }
        attach process rs { receive [ state open-received refresh ]; send [ update ]; }
        # bgp-rib is the only writer of the invalidation: its sent inventory holds
        # every copy bgp-rs forwarded here, and its apply withdraws or replaces
        # them, so it needs this peer's send permission as well as bgp-rs.
        attach process rib { receive [ update-sent state refresh ]; send [ update ]; }
    }
    peer peer-3 {
        connection { remote { ip 127.0.0.3; } local { ip 127.0.0.6; accept false; } }
        session {
            asn { local 65000; remote 65003; }
            router-id 1.2.3.4;
            family { ipv4/unicast { prefix { maximum 10000; } } }
            capability { graceful-restart disable; }
        }
        behavior { group-updates disable; }
        filter { import { final accept; } export { final accept; } }
        attach process rfc8212-reload { send [ update ]; }
        attach process adj-rib-in { receive [ update-received state ]; }
        attach process rs { receive [ update-received state open-received refresh ]; }
        attach process rib { receive [ update state refresh ]; }
    }
}
EOF_CONF

cmd=background:seq=1:exec=le test peer --port $PORT:stdin=source
cmd=background:seq=2:exec=le test peer --bind 127.0.0.2 --port $PORT --mode echo:stdin=sink
cmd=background:seq=3:exec=le test peer --bind 127.0.0.3 --port $PORT:stdin=alternate
cmd=foreground:seq=4:exec=ze -:stdin=ze-bgp:timeout=180s

expect=exit:code=0
reject=stderr:pattern=ZE-OBSERVER-FAIL
reject=stderr:pattern=peer restart required
reject=stderr:pattern=panic recovered
