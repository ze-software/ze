cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer
cmd=background:seq=2:exec=le test peer --bind 127.0.0.2 --port $PORT:stdin=destb
cmd=background:seq=3:exec=le test peer --bind 127.0.0.3 --port $PORT:stdin=destc
cmd=foreground:seq=4:exec=ze --plugin ze.bgp-filter-community -:stdin=ze-bgp:timeout=60s
expect=exit:code=0
expect=stderr:contains=BLACKHOLE-AGREEMENT-RELOAD: B refused after its agreement was removed, C agreed after one was added
reject=stderr:pattern=panic recovered
reject=stderr:pattern=fatal error
reject=stderr:pattern=LIVE-STAGES line
