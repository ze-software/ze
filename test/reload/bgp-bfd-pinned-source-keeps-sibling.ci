# Test: a single-hop BFD session pinned to a second local address sends its
#       Control packets from that address, so the session to the same remote
#       system from the first local address is left alone.
# Initial config: one iBGP peer to 127.0.0.1 with `connection local ip auto`
#                 and no BFD opt-in, and the `bfd` root with profile fast.
# Reloads:        config2.conf (the peer gains a single-hop opt-in: client A,
#                 keyed on lo and local 127.0.0.1, which Linux lo holds as part
#                 of 127.0.0.0/8, opens session S to itself), config3.conf (a
#                 pinned single-hop-session to 127.0.0.1 from local 127.0.0.2:
#                 session P, keyed apart from S by its local address).
# Expected:       P sends several Control packets while S stays Up and the BGP
#                 peer is never torn down for BFD.
#
# VALIDATES: RFC 5883 Section 4.1, "Multiple sessions between the same pair of
#            systems must have at least one endpoint address distinct from one
#            another", at the real entry point: P's packets leave from
#            127.0.0.2, so they reach ze from 127.0.0.2, match no session (P's
#            peer answers nothing) and never touch S.
# PREVENTS: the L3 defect of spec-bgp-live-receive-binding-and-bfd-keep-session
#           (journal unwired-feature.md, 2026-10-12): transport.Outbound carried
#           no source address, P's packets left from 127.0.0.1, arrived with
#           Your Discriminator zero and the address pair of S, and S read the
#           remote state Down, so BGP sent Cease "BFD Down".
#
# Linux only: darwin's lo holds 127.0.0.1 alone, so a session from 127.0.0.2
# cannot send there, and off Linux the transport sets no source address
# (pktinfoPin, udp_other.go).
#
# DISCRIMINATION: with `Local: key.Local` removed from Loop.sendLocked, P's
# packets leave from 127.0.0.1 and reach S. Observed 2026-10-13 (two runs of a
# mutant ze): the daemon stops before the say line, "1/1 FAIL" at 8.5 s and
# 9.5 s, against "1/1 PASS" for the working tree. Should S survive long enough,
# its transition history keeps the Down with diagnostic
# neighbor-signaled-session-down, so the `lacks` step below never holds.
option=needs-linux
option=timeout:value=60s
option=env:var=ze.bfd.test-parallel:value=true
# BFD binds the RFC 5881 and RFC 5883 fixed ports; see test/plugin/bgp-bfd-opt-in.ci.
option=exclusive:group=bfd-ports

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=50s
option=linger:value=true
# ze-peer creates this file on the daemon's first UPDATE; the staged fixture
# holds its first reload until it exists.
option=established-file:path=established
# EOR from ze
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external live-stages {
		run "le test fixture reload/live-stages stages.script"
		encoder json
	}
}

bfd {
	enabled true
	profile fast {
		detect-multiplier 3
		desired-min-tx-us 50000
		required-min-rx-us 50000
	}
}

bgp {
	router-id 1.2.3.4
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip auto
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast {
					prefix {
						maximum 10000
					}
				}
			}
		}
	}
}
EOF_CONF

# First reload: the peer gains a single-hop opt-in (client A, session S).
tmpfs=config2.conf:terminator=EOF_CONF2
plugin {
	external live-stages {
		run "le test fixture reload/live-stages stages.script"
		encoder json
	}
}

bfd {
	enabled true
	profile fast {
		detect-multiplier 3
		desired-min-tx-us 50000
		required-min-rx-us 50000
	}
}

bgp {
	router-id 1.2.3.4
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip auto
				accept false
			}
			bfd {
				enabled true
				profile fast
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast {
					prefix {
						maximum 10000
					}
				}
			}
		}
	}
}
EOF_CONF2

# Second reload: session P, pinned to local 127.0.0.2.
tmpfs=config3.conf:terminator=EOF_CONF3
plugin {
	external live-stages {
		run "le test fixture reload/live-stages stages.script"
		encoder json
	}
}

bfd {
	enabled true
	profile fast {
		detect-multiplier 3
		desired-min-tx-us 50000
		required-min-rx-us 50000
	}

	single-hop-session 127.0.0.1 {
		local 127.0.0.2
		profile fast
	}
}

bgp {
	router-id 1.2.3.4
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip auto
				accept false
			}
			bfd {
				enabled true
				profile fast
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast {
					prefix {
						maximum 10000
					}
				}
			}
		}
	}
}
EOF_CONF3

# P sends once a second while it is Down (RFC 5880 Section 6.8.3), so four
# packets from P is three seconds in which each one would have reached S.
# "tx-packets" is followed by "vrf" in a session's JSON object, and P, which never
# changes state, carries no "transitions". S's transitions list every state
# change it made, so a Down that P's packets caused stays in the answer.
tmpfs=stages.script:terminator=EOF_SCRIPT
await-file established
reload config2.conf
has show bfd sessions => "state":"up"
reload config3.conf
has show bfd sessions => "local":"127.0.0.2"
has show bfd sessions => "tx-packets":4,"vrf"
lacks show bfd sessions => "neighbor-signaled-session-down"
has show bfd sessions => "state":"up"
say BFD-PINNED-SOURCE: the session pinned to 127.0.0.2 sent while its sibling stayed up
EOF_SCRIPT

cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=60s

expect=stderr:contains=BFD-PINNED-SOURCE: the session pinned to 127.0.0.2 sent while its sibling stayed up
reject=stderr:pattern=ZE-OBSERVER-FAIL
