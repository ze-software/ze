# Test: SIGHUP turns API authentication ON without a restart
# VALIDATES: spec-fixit-mgmt-listener-auth-guard-deferred-reload-auth-rebuild
# AC-1 -- a reload that turns authentication on rebuilds it on the running
# server. The daemon starts with a REST listener that has no token, so an
# unauthenticated GET is served. The reloaded config adds a token and changes no
# listen address, which is the case the old code could not see at all: the
# change set was built from addresses alone, an auth-only edit produced no
# change, and reloadListeners returned nil having logged nothing.
# PREVENTS: an operator turning authentication on, seeing a clean reload, and
# being served by a listener that still gates nothing until the daemon restarts.
#
# The reloaded config enables REST and no gRPC, so this also holds the marking
# rule: a gRPC surface the daemon never built must not refuse the reload.

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=30s
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER


# Post-SIGHUP config: the same REST endpoint, now with a token. No address
# changes, so the reload's whole job is the credential rebuild.
tmpfs=config2.conf:terminator=EOF_CONF2
plugin {
	external mgmt-auth-rebuild-test {
		run "ze-test fixture reload/mgmt-guard-reload-auth-rebuild $PORT2"
		encoder json
	}
}

environment {
	api-server {
		token "reload-secret"
		rest {
			enabled true
			server main {
				ip 127.0.0.1
				port $PORT2
			}
		}
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF2


stdin=ze-conf:terminator=EOF_CONF
plugin {
	external mgmt-auth-rebuild-test {
		run "ze-test fixture reload/mgmt-guard-reload-auth-rebuild $PORT2"
		encoder json
	}
}

environment {
	api-server {
		rest {
			enabled true
			server main {
				ip 127.0.0.1
				port $PORT2
			}
		}
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=background:seq=2:exec=ze-test fixture reload/mgmt-guard-reload-auth-rebuild-trigger
cmd=foreground:seq=3:exec=ze -:stdin=ze-conf:timeout=30s
expect=exit:code=0
expect=stderr:contains=sighup reload complete
