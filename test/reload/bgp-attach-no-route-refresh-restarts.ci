# Test: a reload that attaches a route-bearing receive-only process to a running
#       peer that did NOT negotiate Route Refresh restarts the peer.
# Initial config: one iBGP peer; Ze advertises Route Refresh, but the peer drops
#                 capability 2 from its OPEN, so Route Refresh is not negotiated.
#                 The peer announces 192.168.1.0/24 right after its OPEN.
# Live change:    the peer rewrites the config and sends SIGHUP once Ze's
#                 End-of-RIB arrived. The new config adds bgp-adj-rib-in, bound
#                 `receive [ update-received state ]`.
# Expected:       Ze cannot ask the peer to re-send the routes the new process
#                 never saw, so the peer restarts: NOTIFICATION Cease subcode 6,
#                 a second connection, and the restart log line names
#                 ProcessBindings.
#
# VALIDATES: spec-bgp-live-receive-binding-and-bfd-keep-session AC-10 (wiring
#            row "feedCatchUp impossible -> restart branch"): the restart answer
#            is kept for the one case the swap cannot bring level.
# PREVENTS: a swap that keeps the session while the gained process holds none of
#           the routes the session already carried.
#
# Green today, and it must stay green: today every operator binding change
# restarts the peer. After that spec's Phase 2 it is the Route Refresh check
# (feedCatchUp) that keeps this a restart.
option=timeout:value=60s
option=env:var=ze.log.bgp.reactor:value=debug

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=2
option=timeout:value=50s
# The peer's OPEN carries no Route Refresh (RFC 2918 Section 2, code 2), so the
# capability is not negotiated whatever Ze advertises.
option=open:value=drop-capability:code=2
# 192.168.1.0/24, origin IGP, empty AS_PATH (iBGP), next-hop 10.0.0.1,
# LOCAL_PREF 100: announced once the OPEN exchange is done.
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00300200000015400101004002004003040A0000014005040000006418C0A801
# EOR from ze
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
# Then the reload that attaches the process.
action=rewrite:conn=1:seq=2:source=config2.conf:dest=ze-bgp.conf
action=sighup:conn=1:seq=2
# RFC 4486 Section 4: the restart is a configuration change, so the session
# reads NOTIFICATION Cease (6), subcode 6 "Other Configuration Change".
expect=bgp:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0015030606
# Connection 2: the restarted session, which the new process sees from its start.
action=send:conn=2:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00300200000015400101004002004003040A0000014005040000006418C0A801
expect=bgp:conn=2:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	internal bgp-rib {
		use bgp-rib
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				route-refresh enable
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		# Route Refresh needs a process that may put routes on the wire
		# (validatePeerProcessCaps). Bound in both configs, so it never changes.
		attach process bgp-rib {
			receive [ update state refresh ]
			send [ update ]
		}
	}
}

EOF_CONF

# The second config declares bgp-adj-rib-in and attaches it receive-only.
tmpfs=config2.conf:terminator=EOF_CONF2
plugin {
	internal bgp-rib {
		use bgp-rib
	}
	internal adj-rib-in {
		use bgp-adj-rib-in
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				route-refresh enable
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		# Route Refresh needs a process that may put routes on the wire
		# (validatePeerProcessCaps). Bound in both configs, so it never changes.
		attach process bgp-rib {
			receive [ update state refresh ]
			send [ update ]
		}
		attach process adj-rib-in {
			receive [ update-received state ]
		}
	}
}

EOF_CONF2

cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=60s

# The restart names the binding change that forced it.
expect=stderr:pattern=peer restart required
expect=stderr:pattern=changed=ProcessBindings
reject=stderr:pattern=peer settings swapped in place
