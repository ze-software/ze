# Test: a reload that adds a session family to a graceful-restart peer with
#       no graceful-restart family list restarts the session, and the new OPEN
#       carries the GR capability naming the added family.
# Initial config: peer1 carries ipv4/unicast and graceful-restart with no family
#                 container, so the GR capability names every session family.
# Live change:    config2.conf adds ipv6/unicast to peer1's session families.
# Expected:       no refusal; the session restarts (two TCP connections), and
#                 the second OPEN's GR capability names ipv4/unicast and
#                 ipv6/unicast.
#
# VALIDATES: spec-runtime-peer-plugin-capabilities AC-2 through a second
#            plugin: gr's candidate declaration, derived from the session
#            families, is the one the restarted session's OPEN carries.
# PREVENTS:  a restarted session whose OPEN carries the start-time GR payload,
#            which no longer names the families the session negotiates.
option=timeout:value=60s
# The reactor logs each restart decision, with its reason, at info.
option=env:var=ze.log.bgp.reactor:value=info

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=2
option=timeout:value=50s
# ze's OPEN is each connection's seq 1.
option=open:value=inspect-open-message
# ze-peer writes established on the first session's first UPDATE and
# established-2 on the second's; the staged fixture waits on both.
option=established-file:path=established
# conn 1: MP ipv4/unicast, 4-octet AS 1, GR (40 06) restart-time 120,
# ipv4/unicast (0001 01 00).
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF003301040001005A010203041602140104000100014104000000014006007800010100
# EOR from ze
expect=bgp:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
# The reload restarts the session: Cease (6) / Other Configuration
# Change (6, RFC 4486).
expect=bgp:conn=1:seq=3:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0015030606
# conn 2: MP ipv4/unicast and ipv6/unicast, 4-octet AS 1, GR (40 0A)
# restart-time 120 naming ipv4/unicast (0001 01 00) and ipv6/unicast
# (0002 01 00).
expect=bgp:conn=2:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF003D01040001005A0102030420021E010400010001010400020001410400000001400A00780001010000020100
expect=bgp:conn=2:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
# The clean shutdown after the last stage, on the second connection:
# Cease (6) / Administrative Shutdown (2) with the RFC 8203 default text.
expect=bgp:conn=2:seq=3:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002D0306021741646D696E6973747261746976652053687574646F776E
EOF_PEER

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external live-stages {
		run "le test fixture reload/live-stages stages.script"
		encoder json
	}
}

plugin {
	internal gr {
		use bgp-gr
	}
}
bgp {
	router-id 1.2.3.4
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart {
					restart-time 120
				}
			}
		}
		attach process gr {
			receive [ open-received state eor ]
			send [ update ]
		}
	}
}
EOF_CONF

# The reload. The plugin block is byte-identical in both configs, so the
# staged fixture survives.
tmpfs=config2.conf:terminator=EOF_CONF2
plugin {
	external live-stages {
		run "le test fixture reload/live-stages stages.script"
		encoder json
	}
}

plugin {
	internal gr {
		use bgp-gr
	}
}
bgp {
	router-id 1.2.3.4
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
				ipv6/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart {
					restart-time 120
				}
			}
		}
		attach process gr {
			receive [ open-received state eor ]
			send [ update ]
		}
	}
}
EOF_CONF2

tmpfs=stages.script:terminator=EOF_SCRIPT
await-file established
reload config2.conf
await-file established-2
say GR-FAMILY-RESTARTED: second session established
EOF_SCRIPT

cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=60s

expect=stderr:contains=GR-FAMILY-RESTARTED: second session established
reject=stderr:pattern=ZE-OBSERVER-FAIL
reject=stderr:pattern=cannot change while ze runs
expect=stderr:contains=peer restart required
reject=stderr:pattern=ze signal restart
