# Test: Config reload adds a route
# Initial config has one static route (192.168.1.0/24)
# After SIGHUP: config has two routes (192.168.1.0/24 + 10.0.0.0/24)
# Expected: ONE TCP connection for the whole run, and the added route arrives on
#           the established session. The route that did not change is not re-sent.
#
# VALIDATES: a reload that edits `static { route ... }` delivers the DIFFERENCE on
#            the running session (deliverStaticRouteDelta, peer_static_wire.go).
# PREVENTS: the bounce this test used to assert. StaticRoutes sat outside
#           hotSwappableSettings, so adding one prefix tore the connection down and
#           re-established it, and the peer re-learned the whole set to receive one
#           route.
#
# DISCRIMINATION: the single tcp_connections slot and the stderr rules are both
# positive statements about the swap. Taking StaticRoutes back out of
# hotSwappableSettings logs "peer restart required" and dials a second connection
# the peer does not offer; delivering the field without the delta leaves the wire
# silent after SIGHUP and the seq=2 expectation times out.

# The in-place swap is logged at debug, as BIRD prints nothing for a successful
# soft reconfigure.
option=env:var=ze.log.bgp.reactor:value=debug

# ze-peer expectations
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1

# Connection 1: One static route + EOR
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00300200000015400101004002004003040A0000014005040000006418C0A801
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000

# After initial messages: rewrite config (add second route) and send SIGHUP
action=rewrite:conn=1:seq=2:source=config2.conf:dest=ze-bgp.conf
action=sighup:conn=1:seq=2

# The reload announces the ADDED route on the same connection. The route the two
# configurations share is not re-announced: the session already holds it.
expect=bgp:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00300200000015400101004002004003040A00000140050400000064180A0000
EOF_PEER

# Initial ze bgp configuration (one route)
stdin=ze-bgp:terminator=EOF_CONF
bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}


		update {
			attribute {
				origin igp
				local-preference 100
				next-hop 10.0.0.1
			}
			nlri {
				ipv4/unicast add 192.168.1.0/24
			}
		}
	}
}
EOF_CONF

# Rewritten config: one more route, and nothing else differs
tmpfs=config2.conf:terminator=EOF_CONF2
bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}


		update {
			attribute {
				origin igp
				local-preference 100
				next-hop 10.0.0.1
			}
			nlri {
				ipv4/unicast add 192.168.1.0/24
				ipv4/unicast add 10.0.0.0/24
			}
		}
	}
}
EOF_CONF2

# Process orchestration
cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=20s

# Wait for the reload to finish before the runner stops the daemon.
await=stderr:contains=sighup reload complete

# The reload took the swap branch and named the peer it swapped.
expect=stderr:pattern=peer settings swapped in place
# ... and never took the restart branch, which is the branch that bounces.
reject=stderr:pattern=peer restart required
