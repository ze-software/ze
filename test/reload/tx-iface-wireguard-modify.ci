# Test: WireGuard peer modification via SIGHUP-applied transaction
# Initial config has a wireguard wgmod0 with one peer (endpoint, keepalive,
# one allowed-ips entry). Updated config keeps wgmod0 but modifies the peer:
# changes the endpoint IP, adds a second allowed-ips entry, bumps the
# keepalive. Reconciliation must apply the diff without recreating the
# netdev (wireguardSpecEqual returns false, applyWireguards calls
# ConfigureWireguardDevice once). Daemon survives.
#
# Like the other reload tests, this validates wiring (spec-diff
# detection, Configure dispatch) rather than kernel state. Kernel
# round-trips are covered by the integration tests under
# internal/plugins/iface/netlink (gated on CAP_NET_ADMIN + wg module).

option=needs-linux:caps=net-admin
stdin=peer:terminator=EOF_PEER

expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00300200000015400101004002004003040A0000014005040000006418C0A801
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# Initial config (peer moved to the reload): wireguard wgmod0 with one peer
# // the `peer peer1` block moves OUT of this initial config and into
# config2.conf below -- it is not deleted, and the two peer expectations above are
# unchanged. This is the fix, not a relaxation: while the peer existed up-front,
# both expectations were satisfiable PRE-reload, the check peer exited, and the
# runner killed the daemon before the SIGHUP ever landed (measured: "received
# SIGHUP" 0 times, test green in ~2.2s). Moving the peer into the reloaded config
# makes the same expectations reachable only AFTER the transaction applies.
stdin=ze-bgp:terminator=EOF_CONF
bgp {
}

interface {
	wireguard wgmod0 {
		listen-port 51824
		private-key "AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE="
		peer site2 {
			public-key "AgICAgICAgICAgICAgICAgICAgICAgICAgICAgICAgI="
			endpoint {
				ip 198.51.100.2
				port 51820
			}
			allowed-ips [ 10.0.0.2/32 ]
			persistent-keepalive 25
		}
	}
}
EOF_CONF

# Updated config: same wgmod0, modified peer (endpoint + allowed-ips + keepalive)
tmpfs=config2.conf:terminator=EOF_CONF2
bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}

		update {
			attribute {
				origin igp
				local-preference 100
				next-hop 10.0.0.1
			}
			nlri {
				ipv4/unicast add 192.168.1.0/24
			}
		}
	}
}

interface {
	wireguard wgmod0 {
		listen-port 51824
		private-key "AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE="
		peer site2 {
			public-key "AgICAgICAgICAgICAgICAgICAgICAgICAgICAgICAgI="
			endpoint {
				ip 198.51.100.99
				port 51820
			}
			allowed-ips [ 10.0.0.2/32 192.168.20.0/24 ]
			persistent-keepalive 60
		}
	}
}
EOF_CONF2

# // the two `sleep 2` lines and the trailing `kill -TERM` are removed
# and an `expect=stderr` assertion is added below, so this file's assertion count
# rises. The first sleep let the check peer finish and the runner kill the daemon
# before the SIGHUP; the second raced the reload it was meant to follow.

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=background:seq=2:exec=ze-test fixture reload/tx-iface-wireguard-modify-trigger
cmd=foreground:seq=3:exec=ze -:stdin=ze-bgp:timeout=20s
# The asserted OnConfigApply success log is Info level and the default log level
# is WARN, so the interface subsystem must be raised for it to reach stderr.
option=env:var=ze.log.interface:value=info
expect=stderr:contains=interface config reloaded via transaction
