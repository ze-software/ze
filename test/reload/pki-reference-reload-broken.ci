# spec-pki-full-chain AC-3 / R-5 on the reload path, end to end.
#
# ONE commit repoints environment.web.certificate at a name no pki entry
# defines. The reload must be REJECTED and say which leaf and which name are at
# fault.
#
# The failure mode this closes is silent: a listener that keeps serving, or
# quietly falls back to a self-signed certificate, while the config names an
# operator certificate. The operator would see a working HTTPS endpoint and
# learn otherwise from a client's trust error.
#
# The daemon stays up: a broken web certificate reference rejects the COMMIT, it
# does not kill the process.


tmpfs=hub.conf:terminator=EOF_CONF
plugin {
}

pki {
	ca web-ca {
		certificate 
	}
	certificate lan {
		certificate 
		private {
			key MHcCAQEEIJWSrBva0yYuEY9NyV6LSqFoZ4eRNSoFUCZj9KdmaPuioAoGCCqGSM49AwEHoUQDQgAE9ujhR+AuyNpjClq9wS3fPg4sLDh2JYdiXLRih2EDVDNJAhFQEQ6RbqhwdSMnZUmPBBuoNbt1T6U+jcrRyF0VhA==
		}
	}
}

environment {
	web {
		enabled true
		server default {
			ip 127.0.0.1
			port 18862
		}
		certificate lan
	}
}
EOF_CONF

tmpfs=broken.conf:terminator=EOF_BROKEN
plugin {
}

pki {
	ca web-ca {
		certificate 
	}
	certificate lan {
		certificate 
		private {
			key MHcCAQEEIF8P68dMdBI35GQFFrQjWo8/snH8TjJQrH2G2cK1lRQKoAoGCCqGSM49AwEHoUQDQgAERr7nZZ0Tb4Lri+LXKMbyhkSCMaW1XidikxRNJOJR9tN87Jx6i89FiuIOzaYpmLnVBzlA1aZM326x28DtTX+/9A==
		}
	}
}

environment {
	web {
		enabled true
		server default {
			ip 127.0.0.1
			port 18862
		}
		certificate no-such-certificate
	}
}
EOF_BROKEN

cmd=background:seq=1:exec=ze-test fixture reload/pki-reference-reload-broken-trigger
cmd=foreground:seq=2:exec=ze start hub.conf:timeout=40s
expect=exit:code=0
expect=stderr:contains=reload error
expect=stderr:contains=environment.web.certificate
expect=stderr:contains=no-such-certificate
reject=stderr:pattern=sighup reload complete
