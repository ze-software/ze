# Test: Rapid successive SIGHUPs handled correctly
# First SIGHUP: config change (add route) is delivered on the running session
# Second SIGHUP: config unchanged, daemon should no-op
# Expected: exactly ONE connection, daemon survives both reloads
#
# VALIDATES: two reloads in a row leave the session up -- the first because a
#            route-set edit is a swap (deliverStaticRouteDelta, peer_static_wire.go),
#            the second because nothing changed at all.
# PREVENTS: a second SIGHUP arriving while the first is still applying and tearing
#           the peer down, and the restart the first reload used to cost.
#
# DISCRIMINATION: the single tcp_connections slot plus the stderr reject. Either
# reload taking the restart branch dials a second connection the peer does not
# offer, and logs the line the reject rule names.

# The in-place swap is logged at debug, as BIRD prints nothing for a successful
# soft reconfigure.
option=env:var=ze.log.bgp.reactor:value=debug

# ze-peer expectations
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1

# Connection 1: One static route + EOR
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00300200000015400101004002004003040A0000014005040000006418C0A801
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000

# After initial messages: rewrite config (add second route) and send SIGHUP
action=rewrite:conn=1:seq=2:source=config2.conf:dest=ze-bgp.conf
action=sighup:conn=1:seq=2

# The first reload announces the ADDED route on the same connection.
expect=bgp:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00300200000015400101004002004003040A00000140050400000064180A0000

# Second SIGHUP with no rewrite: the config is unchanged, so the reload is a no-op
# and the session is left alone.
action=sighup:conn=1:seq=3
EOF_PEER

# Initial ze bgp configuration (one route)
stdin=ze-bgp:terminator=EOF_CONF
bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}


		update {
			attribute {
				origin igp
				local-preference 100
				next-hop 10.0.0.1
			}
			nlri {
				ipv4/unicast add 192.168.1.0/24
			}
		}
	}
}
EOF_CONF

# Rewritten config (two routes - count change triggers restart on first SIGHUP)
tmpfs=config2.conf:terminator=EOF_CONF2
bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}


		update {
			attribute {
				origin igp
				local-preference 100
				next-hop 10.0.0.1
			}
			nlri {
				ipv4/unicast add 192.168.1.0/24
				ipv4/unicast add 10.0.0.0/24
			}
		}
	}
}
EOF_CONF2

# Process orchestration
cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=25s

# Wait for the reload to finish before the runner stops the daemon.
await=stderr:contains=sighup reload complete

# Neither reload took the restart branch, which is the branch that bounces.
reject=stderr:pattern=peer restart required
