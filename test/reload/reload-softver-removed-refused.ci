# Test: a reload that removes software-version from a peer that stays
#       configured is refused.
# Initial config: peer1 advertises software-version.
# Live change:    config2.conf drops the capability block; peer1 stays.
# Expected:       the reload is refused naming peer1, the software-version leaf
#                 and plugin bgp-softver; one TCP connection.
#
# VALIDATES: AC-2c of spec-bgp-open-session-rfc-defects: a code removed from a
#            live peer is a change, unlike a removed peer.
# PREVENTS:  ze continuing to send a capability the operator removed.
option=timeout:value=60s

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=50s
# ze-peer creates this file on the daemon's first UPDATE; the staged fixture
# holds its first reload until it exists.
option=established-file:path=established
# EOR from ze
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
# The clean shutdown after the last stage, on the SAME connection: Cease (6) /
# Administrative Shutdown (2, RFC 4486) with the RFC 8203 default text.
expect=bgp:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002D0306021741646D696E6973747261746976652053687574646F776E
EOF_PEER

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external live-stages {
		run "le test fixture reload/live-stages stages.script"
		encoder json
	}
}

bgp {
	router-id 1.2.3.4
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				software-version {
					encoding legacy
				}
			}
		}
	}
}
EOF_CONF

# The reload. The plugin block is byte-identical in both configs, so the
# staged fixture survives.
tmpfs=config2.conf:terminator=EOF_CONF2
plugin {
	external live-stages {
		run "le test fixture reload/live-stages stages.script"
		encoder json
	}
}

bgp {
	router-id 1.2.3.4
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
		}
	}
}
EOF_CONF2

tmpfs=stages.script:terminator=EOF_SCRIPT
await-file established
reload config2.conf
say SOFTVER-REMOVED-REFUSED: reload refused, session kept
EOF_SCRIPT

cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze --plugin ze.bgp-softver -:stdin=ze-bgp:timeout=60s

expect=stderr:contains=peer peer1: capability software-version cannot change while ze runs (plugin bgp-softver).
expect=stderr:contains=  under systemd: systemctl restart ze
expect=stderr:contains=SOFTVER-REMOVED-REFUSED: reload refused, session kept
reject=stderr:pattern=ZE-OBSERVER-FAIL
reject=stderr:pattern=peer restart required
reject=stderr:pattern=ze signal restart
