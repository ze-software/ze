# Test: a reload that edits the definition a `match` instance names makes the
#       match judge with the new definition, on the same session.
# Initial config: one dynamic group (iBGP, AS 65533) whose import chain is
#                 `[ as-path-length-MAX-LEN prefix-list-ALLOW ]`: two match
#                 instances, one naming as-path-length MAX-LEN (max 3), one
#                 naming prefix-list ALLOW (10.0.0.0/8 ge 16 le 24 accept).
#                 The test peer dials Ze and announces 10.1.0.0/24 (empty
#                 AS_PATH, iBGP), which both members accept at startup.
# Live change:    the staged fixture (reload/live-stages, run inside the
#                 daemon) reloads twice. config2 changes only MAX-LEN's max
#                 (3 -> 1); config3 then changes only ALLOW's entry action
#                 (accept -> reject). The chain, the match blocks and the
#                 plugin block are byte-identical in all three configs.
# Expected:       evaluated against the peer's live chain,
#                 - UPDATE A (AS_PATH 65001 65002, 10.0.0.0/24) answers accept
#                   before the first reload and reject after it;
#                 - UPDATE B (AS_PATH 65001, 10.0.0.0/24) answers accept after
#                   the first reload (the prefix-list still accepts, so A's
#                   reject is the as-path-length edit) and reject after the
#                   second;
#                 - 10.1.0.0/24, in the RIB before the first reload, is still
#                   received after each reload, the second included, where
#                   ALLOW now rejects it: the apply re-evaluates no stored
#                   route (import re-evaluation is spec-bgp-filtered-route-
#                   storage AC-3);
#                 and the dynamic peer is built once and keeps its connection.
#
# VALIDATES: the match path's equivalent of bgp-filter-aspath-length-reload.ci
#            and bgp-filter-prefix-definition-reload.ci: a definition edited
#            on reload reaches the compiled library chain
#            (config compileLibraryChains, run by PeersFromTree on every
#            reload) of a peer whose chain names it, with no session bounce.
# PREVENTS: a reload that keeps the chain compiled from the startup
#           definitions because the chain's member names did not change.
#
# DISCRIMINATION: with peerSettingsEqual (reactor_api.go) clearing the
# compiled library chain of both ImportPolicy values before it compares them,
# the reload judges the peer unchanged and keeps the startup chain: the stage
# after config2 answers "action":"accept" for UPDATE A and fails. With that
# stage removed, the stage after config3 answers accept for UPDATE B and fails.
# With the peer's announcement removed (the action=send line), the first
# `show bgp rib received` stage finds no 10.1.0.0/24 and fails, so the RIB
# stages read the route the peer sent.
option=timeout:value=60s
option=env:var=ze.log.bgp.reactor:value=info

stdin=peer:terminator=EOF_PEER
option=asn:value=65533
option=tcp_connections:value=1
option=timeout:value=50s
# ze-peer creates this file on the daemon's first UPDATE; the staged fixture
# holds its first read until it exists.
option=established-file:path=established
# 10.1.0.0/24, origin IGP, empty AS_PATH (iBGP), next-hop 10.0.0.1,
# LOCAL_PREF 100: announced once the OPEN exchange is done. Both members
# accept it at startup. Sent once. The dynamic session is held until every
# plugin finished startup (Reactor.peersStarted); the stages'
# `show bgp rib received` read it.
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00300200000015400101004002004003040A00000140050400000064180A0100
# EOR from ze
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
# The clean shutdown after the last stage, on the SAME connection: Cease (6) /
# Administrative Shutdown (2, RFC 4486) with the RFC 8203 default text.
expect=bgp:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002D0306021741646D696E6973747261746976652053687574646F776E
EOF_PEER

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	internal bgp-rib {
		use bgp-rib
	}
	external live-stages {
		run "le test fixture reload/live-stages stages.script"
		encoder json
	}
}

	policy {
		as-path-length MAX-LEN {
			max 3
		}
		match as-path-length-MAX-LEN {
			as-path-length MAX-LEN
		}
		prefix-list ALLOW {
			entry 10.0.0.0/8 {
				ge 16
				le 24
				action accept
			}
		}
		match prefix-list-ALLOW {
			prefix-list ALLOW
		}
	}

bgp {
	group ix {
		connection {
			remote {
				ip dynamic
				connect false
				range 127.0.0.0/8
			}
			local {
				ip 127.0.0.1
				accept true
			}
		}
		session {
			asn {
				local 65533
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast {
					mode enable
					prefix {
						maximum 10000
					}
				}
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		filter {
			import { filters [ as-path-length-MAX-LEN prefix-list-ALLOW ]; final accept; }
		}
		attach process bgp-rib {
			receive [ update-received state ]
		}
	}
}
EOF_CONF

# config2: MAX-LEN's max (3 -> 1) is the ONLY difference from the first config.
tmpfs=config2.conf:terminator=EOF_CONF2
plugin {
	internal bgp-rib {
		use bgp-rib
	}
