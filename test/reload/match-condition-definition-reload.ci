		}
		prefix-list ALLOW {
			entry 10.0.0.0/8 {
				ge 16
				le 24
				action accept
			}
		}
		match prefix-list-ALLOW {
			prefix-list ALLOW
		}
	}

bgp {
	group ix {
		connection {
			remote {
				ip dynamic
				connect false
				range 127.0.0.0/8
			}
			local {
				ip 127.0.0.1
				accept true
			}
		}
		session {
