}
EOF_CONF2

# config3: ALLOW's entry action (accept -> reject) is the ONLY difference from config2.
tmpfs=config3.conf:terminator=EOF_CONF3
plugin {
	internal bgp-rib {
		use bgp-rib
	}
	external live-stages {
		run "le test fixture reload/live-stages stages.script"
		encoder json
	}
}

	policy {
		as-path-length MAX-LEN {
			max 1
		}
		match as-path-length-MAX-LEN {
			as-path-length MAX-LEN
		}
		prefix-list ALLOW {
			entry 10.0.0.0/8 {
				ge 16
				le 24
				action reject
			}
		}
		match prefix-list-ALLOW {
			prefix-list ALLOW
		}
	}

bgp {
	group ix {
		connection {
			remote {
				ip dynamic
				connect false
				range 127.0.0.0/8
			}
			local {
				ip 127.0.0.1
				accept true
			}
		}
		session {
			asn {
				local 65533
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast {
					mode enable
					prefix {
						maximum 10000
					}
				}
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		filter {
			import { filters [ as-path-length-MAX-LEN prefix-list-ALLOW ]; final accept; }
		}
		attach process bgp-rib {
			receive [ update-received state ]
		}
	}
}
EOF_CONF3

tmpfs=stages.script:terminator=EOF_SCRIPT
# Before the reloads: max 3 accepts A's AS_PATH of length 2, ALLOW accepts,
# and the peer's route is in.
await-file established
has show policy test peer 127.0.0.1 import update FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF003302000000184001010040020A02020000FDE90000FDEA40030401010101180A0000 => "action":"accept"
has show bgp rib received => 10.1.0.0/24
reload config2.conf
# After the first: max 1 rejects A; B (length 1) still passes both members.
has show policy test peer 127.0.0.1 import update FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF003302000000184001010040020A02020000FDE90000FDEA40030401010101180A0000 => "action":"reject"
has show policy test peer 127.0.0.1 import update FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002F02000000144001010040020602010000FDE940030401010101180A0000 => "action":"accept"
has show bgp rib received => 10.1.0.0/24
say MATCH-DEFINITION-RELOAD: the edited as-path-length max rejects
reload config3.conf
# After the second: the edited prefix-list rejects B; the route accepted
# before stays.
has show policy test peer 127.0.0.1 import update FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002F02000000144001010040020602010000FDE940030401010101180A0000 => "action":"reject"
has show bgp rib received => 10.1.0.0/24
say MATCH-DEFINITION-RELOAD: the edited prefix-list rejects
EOF_SCRIPT

cmd=background:seq=1:exec=le test peer --dial 127.0.0.1:$PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=60s

expect=stderr:contains=MATCH-DEFINITION-RELOAD: the edited as-path-length max rejects
expect=stderr:contains=MATCH-DEFINITION-RELOAD: the edited prefix-list rejects
reject=stderr:pattern=ZE-OBSERVER-FAIL
reject=stderr:pattern=LIVE-STAGES line
reject=stderr:pattern=dynamic peer restart required
# The session under test is a DYNAMIC peer's, built once, before the reloads.
expect=stderr:contains=dynamic peer created
reject=stderr:pattern=received SIGHUP[\s\S]*dynamic peer created
