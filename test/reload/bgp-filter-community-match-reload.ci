# Test: a reload that edits a community-match entry's action makes
#       bgp-filter-community-match answer with the new definition.
# Initial config: one dynamic group (iBGP, AS 65533) whose import chain is
#                 `bgp-filter-community-match:NOEXP`. The test peer dials Ze.
# Live change:    the staged fixture (reload/live-stages, run inside the
#                 daemon) rewrites the action of NOEXP's one entry (accept ->
#                 reject) and sends SIGHUP. Nothing else changes.
# Expected:       the same UPDATE (COMMUNITY NO_EXPORT, 10.0.0.0/24) evaluated
#                 against the peer's live chain answers "action":"accept"
#                 before the reload and "action":"reject" after it, which it
#                 can only do when the plugin installed the edited definition
#                 at config-apply.
#
# VALIDATES: spec-plugin-reload-applies-or-refuses AC-1 for
#            bgp-filter-community-match.
# PREVENTS: the silent reload: with OnConfigure alone the SDK answered
#           config-apply OK and the plugin kept its startup definitions.
#
# DISCRIMINATION: with newCommunityMatchConfigTx().Register(p) replaced by
# p.OnConfigure(newCommunityMatchConfigTx().Configure), the after-reload policy
# test still answers "action":"accept" and the stage fails.
option=timeout:value=60s
option=env:var=ze.log.bgp.reactor:value=info

stdin=peer:terminator=EOF_PEER
option=asn:value=65533
option=tcp_connections:value=1
option=timeout:value=50s
# ze-peer creates this file on the daemon's first UPDATE; the staged fixture
# holds its first read until it exists.
option=established-file:path=established
# EOR from ze
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
# The clean shutdown after the last stage, on the SAME connection: Cease (6) /
# Administrative Shutdown (2, RFC 4486) with the RFC 8203 default text.
expect=bgp:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002D0306021741646D696E6973747261746976652053687574646F776E
EOF_PEER

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external live-stages {
		run "le test fixture reload/live-stages stages.script"
		encoder json
	}
}

	policy {
		community-match NOEXP {
			entry no-export {
				type standard
				action accept
			}
		}
	}

bgp {
	group ix {
		connection {
			remote {
				ip dynamic
				connect false
				range 127.0.0.0/8
			}
			local {
				ip 127.0.0.1
				accept true
			}
		}
		session {
			asn {
				local 65533
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast {
					mode enable
					prefix {
						maximum 10000
					}
				}
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		filter {
			import { filters [ bgp-filter-community-match:NOEXP ]; final accept; }
		}
	}
}
EOF_CONF

# The second config: the action of NOEXP's one entry (accept -> reject) is the
# ONLY difference. The chain and the plugin block are byte-identical, so no
# peer is touched and the staged fixture survives.
tmpfs=config2.conf:terminator=EOF_CONF2
plugin {
	external live-stages {
		run "le test fixture reload/live-stages stages.script"
		encoder json
	}
}

	policy {
		community-match NOEXP {
			entry no-export {
				type standard
				action reject
			}
		}
	}

bgp {
	group ix {
		connection {
			remote {
				ip dynamic
				connect false
				range 127.0.0.0/8
			}
			local {
				ip 127.0.0.1
				accept true
			}
		}
		session {
			asn {
				local 65533
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast {
					mode enable
					prefix {
						maximum 10000
					}
				}
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		filter {
			import { filters [ bgp-filter-community-match:NOEXP ]; final accept; }
		}
	}
}
EOF_CONF2

tmpfs=stages.script:terminator=EOF_SCRIPT
# Before the reload: the no-export entry accepts.
await-file established
has show policy test peer 127.0.0.1 import update FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0036020000001B4001010040020602010000FDE940030401010101C00804FFFFFF01180A0000 => "action":"accept"
reload config2.conf
# After it: the same entry rejects.
has show policy test peer 127.0.0.1 import update FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0036020000001B4001010040020602010000FDE940030401010101C00804FFFFFF01180A0000 => "action":"reject"
say COMMUNITY-MATCH-RELOAD: the edited entry rejects
EOF_SCRIPT

cmd=background:seq=1:exec=le test peer --dial 127.0.0.1:$PORT:stdin=peer
cmd=foreground:seq=2:exec=ze --plugin ze.bgp-filter-community-match -:stdin=ze-bgp:timeout=60s

expect=stderr:contains=COMMUNITY-MATCH-RELOAD: the edited entry rejects
reject=stderr:pattern=ZE-OBSERVER-FAIL
reject=stderr:pattern=LIVE-STAGES line
reject=stderr:pattern=dynamic peer restart required
# The session under test is a DYNAMIC peer's, built once, before the reload.
expect=stderr:contains=dynamic peer created
reject=stderr:pattern=received SIGHUP[\s\S]*dynamic peer created
