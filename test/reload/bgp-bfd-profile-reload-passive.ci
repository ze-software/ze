# Test: a bfd-only edit that makes a BGP peer's single-hop profile passive is refused
#
# VALIDATES: a SIGHUP whose only change sets passive on profile fast is refused (RFC 5881 Section 3, Active role on a single hop).
# PREVENTS: a bfd-only change reaching only the bfd plugin, so the peer's session is refused at start and BGP runs unmonitored.
#
# Method: ze starts on the first config, the trigger fixture copies the second
# over it and sends SIGHUP once the daemon is ready, and the daemon's own
# reload outcome line is asserted. The server delivers a plugin that reads the
# bfd root (registry ConfigReads) every root it holds, whole, when any of them
# changed (plugin/server reloadConfigSections).

option=env:var=ze.bfd.test-parallel:value=true
# BFD binds the RFC 5881 fixed ports; see test/plugin/bgp-bfd-opt-in.ci.
option=exclusive:group=bfd-ports

stdin=ze-bgp:terminator=EOF_CONF
bfd {
	enabled true
	profile fast {
		detect-multiplier 3
		desired-min-tx-us 50000
		required-min-rx-us 50000
	}
}

bgp {
	peer peer1 {
		connection {
			local {
				ip 127.0.0.1
				accept false
			}
			remote {
				ip 127.0.0.254
			}
			bfd {
				enabled true
				mode single-hop
				profile fast
			}
		}
		session {
			asn {
				local 65001
				remote 65002
			}
			router-id 10.0.0.1
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
		}
	}
}
EOF_CONF

tmpfs=next.conf:terminator=EOF_NEXT
bfd {
	enabled true
	profile fast {
		detect-multiplier 3
		desired-min-tx-us 50000
		required-min-rx-us 50000
		passive true
	}
}

bgp {
	peer peer1 {
		connection {
			local {
				ip 127.0.0.1
				accept false
			}
			remote {
				ip 127.0.0.254
			}
			bfd {
				enabled true
				mode single-hop
				profile fast
			}
		}
		session {
			asn {
				local 65001
				remote 65002
			}
			router-id 10.0.0.1
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
		}
	}
}
EOF_NEXT

cmd=background:seq=1:exec=le test fixture reload/bgp-bfd-profile-reload-passive-trigger
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=30s
# Stop once the refused reload has reported, never after a timer.
await=stderr:contains=reload error:then=stop
# The refusal names the plugin that verified, so another plugin's check cannot
# stand in for this one.
expect=stderr:contains=plugin bgp verify failed: bgp verify: peer 127.0.0.254
expect=stderr:contains=sets passive
reject=stderr:contains=sighup reload complete
