# Test: Config apply ordering -- remove peer then remove interface
# Initial config: one BGP peer + one dummy interface
# After SIGHUP: both peer and interface removed
# The operation graph solver must order:
#   REMOVE_PEER(peer1) -> REMOVE_INTERFACE(dummy)
# so the peer is drained/stopped before the interface is torn down.
# Expected: daemon survives with zero peers after ordering-aware removal.

# ze-peer expectations
option=needs-linux:caps=net-admin
stdin=peer:terminator=EOF_PEER

# Connection 1: Static route (192.168.1.0/24) + EOR from initial config
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00300200000015400101004002004003040A0000014005040000006418C0A801
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000

# After initial exchange: rewrite config (remove peer + interface) and SIGHUP
action=rewrite:conn=1:seq=2:source=config2.conf:dest=ze-bgp.conf
action=sighup:conn=1:seq=2
EOF_PEER

# Initial ze bgp configuration (one peer + one dummy interface)
stdin=ze-bgp:terminator=EOF_CONF
bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}


		update {
			attribute {
				origin igp
				local-preference 100
				next-hop 10.0.0.1
			}
			nlri {
				ipv4/unicast add 192.168.1.0/24
			}
		}
	}
}

interface {
	dummy order-del0 {
	}
}
EOF_CONF

# Rewritten config (empty -- peer and interface both removed)
tmpfs=config2.conf:terminator=EOF_CONF2
bgp {
}
EOF_CONF2

# Process orchestration
cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=20s
