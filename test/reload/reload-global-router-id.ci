# Test: a reload that changes the global router-id re-OPENs the peer with it
#
# VALIDATES: RFC 4271 Section 4.2 -- "A given BGP speaker sets the value of its
#            BGP Identifier to an IP address that is assigned to that BGP
#            speaker." The peer inherits the global router-id. After SIGHUP with
#            the global router-id changed from 1.2.3.4 to 2.2.2.2, ze closes the
#            session with Cease "Other Configuration Change" (RFC 4486 Section 4)
#            and the next OPEN carries BGP Identifier 02020202.
# PREVENTS:  a reload that keeps the session on the old Identifier, or that
#            refuses a global router-id change as restart-only.
#
# Each OPEN: 16 marker octets, length 0x0025 = 37, type 01, version 04, My AS
# 0xFDE8 = 65000, Hold Time 0x005A = 90, BGP Identifier (01020304, then
# 02020202), Optional Parameters Length 0x08, one capability parameter carrying
# ASN4 alone (code 0x41, length 04, AS 0x0000FDE8).
# `show bgp` reporting the new router-id is asserted by
# test/plugin/data-restore-config-live.ci.

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=2
option=open:value=inspect-open-message

expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00250104FDE8005A0102030408020641040000FDE8
expect=bgp:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000

action=rewrite:conn=1:seq=3:source=config2.conf:dest=ze-bgp.conf
action=sighup:conn=1:seq=3

expect=bgp:conn=1:seq=3:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0015030606

expect=bgp:conn=2:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00250104FDE8005A0202020208020641040000FDE8
expect=bgp:conn=2:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

stdin=ze-bgp:terminator=EOF_CONF
bgp {
	router-id 1.2.3.4
	session {
		asn {
			local 65000
		}
	}
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				remote 65000
			}
		}
	}
}
EOF_CONF

tmpfs=config2.conf:terminator=EOF_CONF2
bgp {
	router-id 2.2.2.2
	session {
		asn {
			local 65000
		}
	}
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				remote 65000
			}
		}
	}
}
EOF_CONF2

cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=20s
