# Test: a reload that adds a receive-only endpoint to a dynamic group's bus send
#       list keeps the RUNNING dynamic session, tells the endpoint the session
#       is up, and brings it level with the routes the peer announced before.
# Initial config: one dynamic group (iBGP, Route Refresh), feeding bgp-rib only,
#                 and no configured peer. The test peer dials Ze, so the only
#                 session is the dynamic one the inbound connection creates.
#                 The peer announces 192.168.1.0/24 right after its OPEN.
# Live change:    the peer rewrites the config and sends SIGHUP once Ze's
#                 End-of-RIB arrived. The new config adds the already-running
#                 external endpoint attach-live to group ix's bus > send > to
#                 list (group ix's bus > receive > from stays bgp-rib only).
# Expected:       no NOTIFICATION and no second TCP connection; Ze sends one
#                 ROUTE-REFRESH for ipv4/unicast; the peer re-sends the route;
#                 the process receives `state up` with reason `attached` before
#                 any UPDATE, then the route: the configured peer's ordered bind
#                 delivery (bgp-attach-receive-only-live.ci), reached through the
#                 dynamic step.
#
# VALIDATES: spec-bgp-live-receive-binding-and-bfd-keep-session AC-9 (wiring
#            row "journaled dynamic step -> ordered bind delivery -> targeted up")
#            and spec-explicit-plugin-and-attach-config S19.
# PREVENTS: a dynamic template bus feed edit that resets every dynamic session,
#           and a gained endpoint fed an UPDATE before it is told the session is
#           up.
#
# A dynamic step that restarted the peer on the template change (the rule
# before that spec's Phase 3) makes the peer read a NOTIFICATION where it
# expects the ROUTE-REFRESH, and it never re-dials (tcp_connections=1).
option=timeout:value=60s
option=env:var=ze.log.bgp.reactor:value=info

stdin=peer:terminator=EOF_PEER
option=asn:value=65533
option=tcp_connections:value=1
option=timeout:value=50s
option=linger:value=true

# 192.168.1.0/24, origin IGP, empty AS_PATH (iBGP), next-hop 10.0.0.1,
# LOCAL_PREF 100: announced once the OPEN exchange is done.
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00300200000015400101004002004003040A0000014005040000006418C0A801
# EOR from ze
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
# Then the reload that attaches the process.
action=rewrite:conn=1:seq=2:source=config2.conf:dest=ze-bgp.conf
action=sighup:conn=1:seq=2
# RFC 2918 Section 3: ROUTE-REFRESH, AFI 1, reserved 0, SAFI 1. The process
# gained a feed of routes this peer already sent.
expect=bgp:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170500010001
# The peer answers the refresh by re-sending its Adj-RIB-Out.
action=send:conn=1:seq=3:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00300200000015400101004002004003040A0000014005040000006418C0A801
EOF_PEER

# The endpoint runs from boot, outside group ix's bus > send > to list, so no
# event reaches it until the reload widens the group's send list.
stdin=ze-bgp:terminator=EOF_CONF
bus {
	endpoint bgp-rib {
		internal bgp-rib;
	}
	endpoint attach-live {
		external {
			run "le test fixture plugin/attach-receive-only-live";
		}
		encoding json;
	}
}

bgp {
	group ix {
		connection {
			remote {
				ip dynamic
				connect false
				range 127.0.0.0/8
			}
			local {
				ip 127.0.0.1
				accept true
			}
		}
		session {
			asn {
				local 65533
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast {
					mode enable
					prefix {
						maximum 10000
					}
				}
			}
			capability {
				route-refresh enable
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		# Route Refresh needs an endpoint that may put routes on the wire
		# (validatePeerProcessCapsOnGraph). bgp-rib holds that grant in both
		# configs; attach-live is never in bus > receive > from.
		bus {
			receive {
				allow [ bgp:update ];
				from [ /bus/endpoint/bgp-rib ];
			}
			send {
				allow [ bgp:update bgp:state bgp:refresh ];
				to [ /bus/endpoint/bgp-rib ];
			}
		}
	}
}

EOF_CONF

# The second config adds attach-live to group ix's bus > send > to list only.
tmpfs=config2.conf:terminator=EOF_CONF2
bus {
	endpoint bgp-rib {
		internal bgp-rib;
	}
	endpoint attach-live {
		external {
			run "le test fixture plugin/attach-receive-only-live";
		}
		encoding json;
	}
}

bgp {
	group ix {
		connection {
			remote {
				ip dynamic
				connect false
				range 127.0.0.0/8
			}
			local {
				ip 127.0.0.1
				accept true
			}
		}
		session {
			asn {
				local 65533
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast {
					mode enable
					prefix {
						maximum 10000
					}
				}
			}
			capability {
				route-refresh enable
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		# Route Refresh needs an endpoint that may put routes on the wire
		# (validatePeerProcessCapsOnGraph). bgp-rib holds that grant in both
		# configs; attach-live is added receive-only (bus > send > to only).
		bus {
			receive {
				allow [ bgp:update ];
				from [ /bus/endpoint/bgp-rib ];
			}
			send {
				allow [ bgp:update bgp:state bgp:refresh ];
				to [ /bus/endpoint/bgp-rib /bus/endpoint/attach-live ];
			}
		}
	}
}

EOF_CONF2

cmd=background:seq=1:exec=le test peer --dial 127.0.0.1:$PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=60s

await=stderr:contains=ATTACH-LIVE: attached up before the route the peer re-sent:then=stop
reject=stderr:contains=ATTACH-LIVE: UPDATE delivered before the attached up
# The session under test is a DYNAMIC peer's, built once, before the reload.
expect=stderr:contains=dynamic peer created
reject=stderr:pattern=received SIGHUP[\s\S]*dynamic peer created
