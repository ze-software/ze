# Test: a reload that removes software-version from a peer that stays
#       configured restarts the session, and the new OPEN carries no code 75.
# Initial config: peer1 advertises software-version; ze-peer mirrors it.
# Live change:    config2.conf drops the capability block; peer1 stays.
# Expected:       no refusal; the session restarts (Cease 6/6, two TCP
#                 connections), and the second OPEN carries no code 75.
#
# VALIDATES: spec-runtime-peer-plugin-capabilities AC-2 and AC-5: an empty
#            candidate declaration removes the code, and a removed code the
#            peer advertised restarts the session.
# PREVENTS:  ze continuing to send a capability the operator removed.
option=timeout:value=60s
# The reactor logs each restart decision, with its reason, at info.
option=env:var=ze.log.bgp.reactor:value=info

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=2
option=timeout:value=50s
# ze's OPEN is each connection's seq 1.
option=open:value=inspect-open-message
# ze-peer writes established on the first session's first UPDATE and
# established-2 on the second's; the staged fixture waits on both.
option=established-file:path=established
# conn 1: MP ipv4/unicast, 4-octet AS 1, software-version legacy
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF003601040001005A010203041902170104000100014104000000014B09085A652F302E312E30
# EOR from ze
expect=bgp:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
# The reload restarts the session: Cease (6) / Other Configuration
# Change (6, RFC 4486).
expect=bgp:conn=1:seq=3:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0015030606
# conn 2: MP ipv4/unicast and 4-octet AS 1 only: no code 75
expect=bgp:conn=2:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002B01040001005A010203040E020C010400010001410400000001
expect=bgp:conn=2:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
# The clean shutdown after the last stage, on the second connection:
# Cease (6) / Administrative Shutdown (2) with the RFC 8203 default text.
expect=bgp:conn=2:seq=3:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002D0306021741646D696E6973747261746976652053687574646F776E
EOF_PEER

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external live-stages {
		run "le test fixture reload/live-stages stages.script"
		encoder json
	}
}

bgp {
	router-id 1.2.3.4
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				software-version {
					encoding legacy
				}
			}
		}
	}
}
EOF_CONF

# The reload. The plugin block is byte-identical in both configs, so the
# staged fixture survives.
tmpfs=config2.conf:terminator=EOF_CONF2
plugin {
	external live-stages {
		run "le test fixture reload/live-stages stages.script"
		encoder json
	}
}

bgp {
	router-id 1.2.3.4
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
		}
	}
}
EOF_CONF2

tmpfs=stages.script:terminator=EOF_SCRIPT
await-file established
reload config2.conf
await-file established-2
say SOFTVER-REMOVED-RESTARTED: second session established
EOF_SCRIPT

cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze --plugin ze.bgp-softver -:stdin=ze-bgp:timeout=60s

expect=stderr:contains=SOFTVER-REMOVED-RESTARTED: second session established
reject=stderr:pattern=ZE-OBSERVER-FAIL
reject=stderr:pattern=cannot change while ze runs
expect=stderr:contains=peer restart required
reject=stderr:pattern=ze signal restart
