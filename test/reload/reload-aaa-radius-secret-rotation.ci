# Test: a rotated RADIUS shared secret reaches the running daemon over SIGHUP
#
# Flow:
# 1. ze-test radius-mock starts on a random UDP port with key "ze-mock-key" and
#    accepts admin:testpass with Filter-Id=admin.
# 2. The daemon boots with the WRONG key, so the RADIUS chain cannot
#    authenticate admin. No local admin user exists, so nothing else can.
# 3. `ze cli` must be REFUSED. That is the before-state the rotation fixes.
# 4. The config is rewritten with the mock's key and the daemon gets SIGHUP.
# 5. `ze cli` must now SUCCEED, and the daemon must report source=radius.
#
# VALIDATES: a config reload rebuilds the AAA chain, so a RADIUS shared secret
#            rotated by an operator applies to the running daemon.
# PREVENTS: the headline defect this work exists to remove. A RADIUS client
#           holds the address, the shared secret and the timeout it was
#           CONSTRUCTED with and re-reads none of them, so before the reload
#           rebuilt the bundle a rotated secret was accepted into the
#           configuration, reported as committed, and reached nothing until the
#           daemon restarted.
#
# The daemon is never restarted between the two attempts: the same process
# refuses the first and accepts the second.

tmpfs=test-reload-aaa-radius-rotation.sh:mode=755:terminator=EOF_SH
#!/bin/sh
set -e

# Signal test runner readiness
touch daemon.ready

# Start RADIUS mock on a random UDP port, address written to mock.addr.
ze-test radius-mock --port 0 --key ze-mock-key \
	--user admin:testpass:admin --addr-file mock.addr 2>mock.log &
MOCK_PID=$!
trap 'kill $MOCK_PID 2>/dev/null || true; wait $MOCK_PID 2>/dev/null || true' EXIT

# Wait for the mock to report its listening address.
MOCK_ADDR=""
for i in $(seq 1 30); do
	if [ -s mock.addr ]; then
		MOCK_ADDR=$(cat mock.addr)
		break
	fi
	sleep 0.1
done
if [ -z "$MOCK_ADDR" ]; then
	echo "FAIL: RADIUS mock did not report address" >&2
	cat mock.log >&2
	exit 1
fi
MOCK_IP=$(echo "$MOCK_ADDR" | cut -d: -f1)
MOCK_PORT=$(echo "$MOCK_ADDR" | cut -d: -f2)
echo "mock at $MOCK_ADDR" >&2

# BGP port derived from PID so concurrent tests do not collide.
export ze_test_bgp_port=$((10000 + ($$ % 20000)))

# The daemon owns the SSH port, so read it from the daemon's own log rather than
# assuming one. The reload re-resolves the listener, so read it again after the
# reload instead of trusting the boot answer.
ssh_port() {
	grep -o 'address=127\.0\.0\.1:[0-9]*' daemon.log 2>/dev/null | tail -1 | cut -d: -f2
}

# write_config <radius-key> -- the only difference between boot and reload.
write_config() {
	cat > reload-aaa-radius-rotation.conf <<ZECONF
bgp {
	peer peer1 {
		connection {
			remote { ip 127.0.0.1; }
			local  { ip 127.0.0.1; accept false; }
		}
		session { asn { local 65533; remote 65533; } }
	}
}

system {
	authentication {
		radius {
			server ${MOCK_IP} { port ${MOCK_PORT}; key "$1"; }
			timeout 2;
		}
	}
	authorization {
		profile admin { run { default-action allow; } edit { default-action allow; } }
	}
}

environment {
	ssh {
		enabled true
		server main { ip 127.0.0.1; port 0; }
	}
}
ZECONF
}

# Boot with a secret the mock does not share.
write_config "wrong-key"

ze start reload-aaa-radius-rotation.conf 2>daemon.log &
DAEMON_PID=$!
trap 'kill $DAEMON_PID 2>/dev/null || true; wait $DAEMON_PID 2>/dev/null || true; kill $MOCK_PID 2>/dev/null || true; wait $MOCK_PID 2>/dev/null || true' EXIT

# Wait for the SSH listener.
SSH_PORT=""
for i in $(seq 1 100); do
	SSH_PORT=$(ssh_port)
	if [ -n "$SSH_PORT" ]; then
		break
	fi
	sleep 0.2
done
if [ -z "$SSH_PORT" ]; then
	echo "FAIL: SSH server did not start" >&2
	cat daemon.log >&2
	exit 1
fi
echo "ssh on :$SSH_PORT" >&2

ADMIN_DIR=$(mktemp -d)
trap 'rm -rf "$ADMIN_DIR"; kill $DAEMON_PID 2>/dev/null || true; wait $DAEMON_PID 2>/dev/null || true; kill $MOCK_PID 2>/dev/null || true; wait $MOCK_PID 2>/dev/null || true' EXIT
printf 'admin\ntestpass\n127.0.0.1\n%s\n' "$SSH_PORT" | ZE_CONFIG_DIR="$ADMIN_DIR" ze init >/dev/null

# Attempt 1: the running secret is wrong, so RADIUS must refuse and no local
# admin user exists to answer instead.
if ZE_CONFIG_DIR="$ADMIN_DIR" ZE_SSH_PASSWORD="testpass" ze cli -c "show bgp" >attempt1.log 2>&1; then
	echo "FAIL: admin authenticated while the configured shared secret was wrong" >&2
	cat attempt1.log >&2
	cat daemon.log >&2
	exit 1
fi
echo "OK: the wrong shared secret is refused" >&2

# Rotate the secret in the configuration and reload the RUNNING daemon.
write_config "ze-mock-key"
kill -HUP $DAEMON_PID

RELOADED=""
for i in $(seq 1 100); do
	if grep -q "sighup reload complete" daemon.log 2>/dev/null; then
		RELOADED=yes
		break
	fi
	sleep 0.2
done
if [ -z "$RELOADED" ]; then
	echo "FAIL: the daemon did not report a completed SIGHUP reload" >&2
	cat daemon.log >&2
	exit 1
fi
echo "OK: reload complete" >&2

# The reload re-resolves the SSH listener. It normally keeps the same port, so
# re-read it and re-point the client only when the daemon moved.
RELOAD_PORT=$(ssh_port)
if [ -z "$RELOAD_PORT" ]; then
	echo "FAIL: no SSH listener after the reload" >&2
	cat daemon.log >&2
	exit 1
fi
if [ "$RELOAD_PORT" != "$SSH_PORT" ]; then
	SSH_PORT=$RELOAD_PORT
	ADMIN_DIR=$(mktemp -d)
	printf 'admin\ntestpass\n127.0.0.1\n%s\n' "$SSH_PORT" | ZE_CONFIG_DIR="$ADMIN_DIR" ze init >/dev/null
	echo "ssh moved to :$SSH_PORT" >&2
fi

# Attempt 2: the same process, no restart, now holding the rotated secret.
if ! ZE_CONFIG_DIR="$ADMIN_DIR" ZE_SSH_PASSWORD="testpass" ze cli -c "show bgp" >attempt2.log 2>&1; then
	echo "FAIL: the rotated shared secret did not reach the running daemon" >&2
	cat attempt2.log >&2
	cat daemon.log >&2
	cat mock.log >&2
	exit 1
fi
echo "OK: the rotated shared secret authenticates without a restart" >&2

# Give the daemon a beat to emit the auth-success log, then replay it so the
# .ci runner's expect=stderr matchers can see it.
sleep 0.3
cat daemon.log >&2

exit 0
EOF_SH

cmd=foreground:seq=1:exec=./test-reload-aaa-radius-rotation.sh:timeout=60s
expect=exit:code=0
# The daemon reports the reload it ran, and the SSH login that followed it,
# authenticated by the RADIUS backend rather than by a local bcrypt user.
expect=stderr:pattern=sighup reload complete
expect=stderr:pattern=auth success.*source=radius
