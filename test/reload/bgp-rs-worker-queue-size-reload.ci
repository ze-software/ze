# Test: a live edit of bgp { route-server { worker-queue-size } } reaches bgp-rs
# Initial config: bgp-rs runs with worker-queue-size 8192.
# After SIGHUP:   worker-queue-size is 16384, and nothing else changes.
# Expected: bgp-rs applies the reloaded size and logs it. Workers created after
#           the apply get the new channel capacity; a worker that already
#           exists keeps its own until it idles out (5 s) and is recreated.
#
# VALIDATES: the reload half of the worker-queue-size leaf. bgp-rs declares
#            WantsConfig bgp, so it is a participant in every bgp transaction,
#            and its verify/apply pair takes the new value into the worker pool
#            (setChanSize), which is what the apply log line reports.
# PREVENTS: the acked-and-dropped reload. With OnConfigure alone, the SDK
#           answers config-apply OK and calls nothing, so the commit succeeded
#           while the workers kept the boot size until a restart.
#
# DISCRIMINATION: the apply line is written by the SDK transaction's installer,
# after it has called setChanSize, at boot (size=8192) and again on the reload's
# apply (size=16384). The await fences on the reloaded size, so the boot line
# cannot satisfy it: without the reload's apply the await never matches and the
# test times out. That the size reaches the pool is proven in Go by
# TestQueueSizeConfigTxAppliesAReloadedSize (rs/config_tx_test.go): no show
# command or metric reports a worker's channel capacity.

option=env:var=ze.log.bgp.rs:value=info

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=20s

# ze has nothing to announce at boot, so it sends End-of-RIB alone.
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000

# Rewrite the config with the new worker-queue-size, then SIGHUP.
action=rewrite:conn=1:seq=2:source=config2.conf:dest=ze-bgp.conf
action=sighup:conn=1:seq=2
EOF_PEER

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	internal rr {
		use bgp-rs
	}
}
bgp {
	route-server {
		worker-queue-size 8192
	}
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65001
				remote 65001
			}
			router-id 10.0.0.2
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
		}
	}
}
EOF_CONF

# Rewritten config: worker-queue-size is the only difference.
tmpfs=config2.conf:terminator=EOF_CONF2
plugin {
	internal rr {
		use bgp-rs
	}
}
bgp {
	route-server {
		worker-queue-size 16384
	}
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65001
				remote 65001
			}
			router-id 10.0.0.2
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
		}
	}
}
EOF_CONF2

cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=20s
await=stderr:contains=msg="worker-queue-size applied" subsystem=bgp.rs size=16384:then=stop
expect=stderr:pattern=worker-queue-size applied.*size=8192
expect=stderr:pattern=worker-queue-size applied.*size=16384
reject=stderr:pattern=peer restart required
reject=stderr:pattern=panic
