# Test: daemon quit command dumps goroutines and exits
# VALIDATES: daemon quit RPC dispatches, dumps stacks, daemon exits cleanly
# PREVENTS: quit command broken or daemon hanging after quit

# ze-peer expectations
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=15s

# EOR
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000

# After EOR: send SIGTERM to trigger shutdown (quit is tested via plugin dispatch)
action=sigterm:conn=1:seq=2
EOF_PEER

# Native test observer: dispatches daemon quit

# ze bgp configuration
tmpfs=ze-bgp.conf:terminator=EOF_CONF
plugin {
	external quit-test {
		run "ze-test fixture reload/signal-quit"
		encoder json
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

# Process orchestration
cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze start ze-bgp.conf:timeout=15s
expect=exit:code=0
