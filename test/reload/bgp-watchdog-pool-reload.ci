# Test: a reload that removes an announced entry from a watchdog pool withdraws
#       that entry's route, and the entry the pool keeps is not re-sent.
# Initial config: peer1's watchdog pool wd-pool holds two entries, 10.0.0.0/24
#                 (MED 1) and 10.0.1.0/24 (MED 2), neither with a withdraw leaf
#                 (the plugin reads its presence, not its value), so both
#                 are announced when the session comes up.
# Live change:    the staged fixture (reload/live-stages, run inside the daemon)
#                 removes the 10.0.0.0/24 update block and sends SIGHUP. A
#                 watchdog update block is not a static route
#                 (hasWatchdogContainer, bgp_routes.go), so the reactor neither
#                 restarts the peer nor withdraws the route itself: only the
#                 watchdog plugin's apply can.
# Expected:       the peer receives exactly one more UPDATE, the withdraw of
#                 10.0.0.0/24; 10.0.1.0/24 keeps its announce state and is not
#                 announced twice (R-7).
#
# VALIDATES: spec-plugin-reload-applies-or-refuses AC-1 and R-7 for
#            bgp-watchdog.
# PREVENTS: the silent reload: with OnConfigure alone the SDK answered
#           config-apply OK and the removed entry stayed announced.
#
# DISCRIMINATION: with the OnConfigVerify, OnConfigApply and OnConfigRollback
# registrations removed from watchdogConfigTx.register, no withdraw is sent,
# the updates-sent stage never reaches 4 and the run fails.
option=timeout:value=60s

stdin=peer:terminator=EOF_PEER
option=asn:value=65533
option=tcp_connections:value=1
option=timeout:value=50s
option=established-file:path=established
# The EOR and the two announces share one step: their order on the wire is not
# what this test claims.
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
expect=bgp:conn=1:seq=1:announced=180A0000
expect=bgp:conn=1:seq=1:announced=180A0001
# After the reload removed the entry: the withdraw of 10.0.0.0/24.
expect=bgp:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF001B020004180A00000000
# The clean shutdown after the last stage, on the SAME connection: Cease (6) /
# Administrative Shutdown (2, RFC 4486) with the RFC 8203 default text.
expect=bgp:conn=1:seq=3:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002D0306021741646D696E6973747261746976652053687574646F776E
EOF_PEER

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external live-stages {
		run "le test fixture reload/live-stages stages.script"
		encoder json
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65533
				remote 65533
			}
			router-id 10.0.0.10
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
		}

		update {
			attribute {
				origin igp
				local-preference 100
				med 1
				next-hop 1.2.3.4
			}
			nlri {
				ipv4/unicast add 10.0.0.0/24
			}
			watchdog {
				name wd-pool
			}
		}
		update {
			attribute {
				origin igp
				local-preference 100
				med 2
				next-hop 1.2.3.4
			}
			nlri {
				ipv4/unicast add 10.0.1.0/24
			}
			watchdog {
				name wd-pool
			}
		}
		attach process bgp-watchdog {
			receive [ state ]
			send [ update ]
		}
	}
}
EOF_CONF

# The second config: the 10.0.0.0/24 update block is the ONLY difference. The
# plugin block, the session and the kept entry are byte-identical.
tmpfs=config2.conf:terminator=EOF_CONF2
plugin {
	external live-stages {
		run "le test fixture reload/live-stages stages.script"
		encoder json
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65533
				remote 65533
			}
			router-id 10.0.0.10
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
		}

		update {
			attribute {
				origin igp
				local-preference 100
				med 2
				next-hop 1.2.3.4
			}
			nlri {
				ipv4/unicast add 10.0.1.0/24
			}
			watchdog {
				name wd-pool
			}
		}
		attach process bgp-watchdog {
			receive [ state ]
			send [ update ]
		}
	}
}
EOF_CONF2

tmpfs=stages.script:terminator=EOF_SCRIPT
# Before the reload: the EOR and the two announces are on the wire.
await-file established
has show bgp peer 127.0.0.1 detail => "updates-sent":3,
reload config2.conf
# After it: the removed entry's withdraw is the fourth UPDATE, and nothing
# else follows it. This fences the shutdown behind it.
has show bgp peer 127.0.0.1 detail => "updates-sent":4,
say WATCHDOG-POOL-RELOAD: the removed entry is withdrawn
EOF_SCRIPT

cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze --plugin ze.bgp-watchdog -:stdin=ze-bgp:timeout=60s

expect=stderr:contains=WATCHDOG-POOL-RELOAD: the removed entry is withdrawn
reject=stderr:pattern=ZE-OBSERVER-FAIL
reject=stderr:pattern=LIVE-STAGES line
reject=stderr:pattern=peer restart required
