# Test: Config apply ordering -- three-way router-id rotation
# Initial config: peer1 rid=1.2.3.4, peer2 rid=5.6.7.8, peer3 rid=9.10.11.12
# After SIGHUP: peer1 rid=5.6.7.8, peer2 rid=9.10.11.12, peer3 rid=1.2.3.4
# This is a three-way rotation that exercises cycle detection in the solver.
# In production a three-way IP rotation produces address cycles resolved via
# the dual-presence fallback (AllowDual on ADD_ADDRESS operations).
# Here the rotation of router-ids validates the end-to-end reload path
# with three concurrent peer restarts after ordering resolution.
# Expected: all three peers reconnect and resend their routes.

# ze-peer expectations (router-id ordering works on both macOS and Linux)
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=3
option=conn_map:value=router-id

# Connection 1: peer1 rid=1.2.3.4 static route (192.168.1.0/24) + EOR
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00300200000015400101004002004003040A0000014005040000006418C0A801
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000

# Connection 2: peer2 rid=5.6.7.8 static route (10.0.0.0/24) + EOR
expect=bgp:conn=2:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00300200000015400101004002004003040A00000140050400000064180A0000
expect=bgp:conn=2:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000

# Connection 3: peer3 rid=9.10.11.12 static route (172.16.0.0/16) + EOR
expect=bgp:conn=3:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002F0200000015400101004002004003040A0000014005040000006410AC10
expect=bgp:conn=3:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000

# After all three peers established: rewrite config (rotate router-ids) and SIGHUP
action=rewrite:conn=3:seq=2:source=config2.conf:dest=ze-bgp.conf
action=sighup:conn=3:seq=2

# Connection 4: peer3 now rid=1.2.3.4 (lowest), resends 172.16.0.0/16
expect=bgp:conn=4:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002F0200000015400101004002004003040A0000014005040000006410AC10
expect=bgp:conn=4:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000

# Connection 5: peer1 now rid=5.6.7.8, resends 192.168.1.0/24
expect=bgp:conn=5:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00300200000015400101004002004003040A0000014005040000006418C0A801
expect=bgp:conn=5:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000

# Connection 6: peer2 now rid=9.10.11.12 (highest), resends 10.0.0.0/24
expect=bgp:conn=6:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00300200000015400101004002004003040A00000140050400000064180A0000
expect=bgp:conn=6:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
action=sigterm:conn=6:seq=2
EOF_PEER

# Initial ze bgp configuration (three peers with distinct router-ids)
stdin=ze-bgp:terminator=EOF_CONF
bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}


		update {
			attribute {
				origin igp
				local-preference 100
				next-hop 10.0.0.1
			}
			nlri {
				ipv4/unicast add 192.168.1.0/24
			}
		}
	}

	peer peer2 {
		connection {
			remote {
				ip 127.0.0.2
			}
			local {
				ip 127.0.0.2
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 5.6.7.8
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}


		update {
			attribute {
				origin igp
				local-preference 100
				next-hop 10.0.0.1
			}
			nlri {
				ipv4/unicast add 10.0.0.0/24
			}
		}
	}

	peer peer3 {
		connection {
			remote {
				ip 127.0.0.3
			}
			local {
				ip 127.0.0.3
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 9.10.11.12
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}


		update {
			attribute {
				origin igp
				local-preference 100
				next-hop 10.0.0.1
			}
			nlri {
				ipv4/unicast add 172.16.0.0/16
			}
		}
	}
}
EOF_CONF

# Rewritten config (three-way rotation of router-ids)
# peer1: 1.2.3.4 -> 5.6.7.8
# peer2: 5.6.7.8 -> 9.10.11.12
# peer3: 9.10.11.12 -> 1.2.3.4
tmpfs=config2.conf:terminator=EOF_CONF2
bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 5.6.7.8
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}


		update {
			attribute {
				origin igp
				local-preference 100
				next-hop 10.0.0.1
			}
			nlri {
				ipv4/unicast add 192.168.1.0/24
			}
		}
	}

	peer peer2 {
		connection {
			remote {
				ip 127.0.0.2
			}
			local {
				ip 127.0.0.2
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 9.10.11.12
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}


		update {
			attribute {
				origin igp
				local-preference 100
				next-hop 10.0.0.1
			}
			nlri {
				ipv4/unicast add 10.0.0.0/24
			}
		}
	}

	peer peer3 {
		connection {
			remote {
				ip 127.0.0.3
			}
			local {
				ip 127.0.0.3
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}


		update {
			attribute {
				origin igp
				local-preference 100
				next-hop 10.0.0.1
			}
			nlri {
				ipv4/unicast add 172.16.0.0/16
			}
		}
	}
}
EOF_CONF2

# Process orchestration
cmd=background:seq=1:exec=ze-peer --bind 0.0.0.0 --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=30s
