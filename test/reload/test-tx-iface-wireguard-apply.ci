# Test: WireGuard interface created via SIGHUP-applied transaction
# Verifies that a wireguard list entry with one peer reaches the iface
# backend through OnConfigVerify -> OnConfigApply -> applyWireguards ->
# Backend.CreateWireguardDevice + Backend.ConfigureWireguardDevice. The
# daemon must survive applying a config that creates a wireguard with
# private-key, listen-port, fwmark, and a peer carrying all optional
# fields (endpoint, allowed-ips, persistent-keepalive, preshared-key).
#
# Like test-tx-iface-tunnel-create.ci, this validates wiring (parser,
# dispatch, backend method invocation). The actual netlink LinkAdd and
# wgctrl ConfigureDevice calls may succeed or fail depending on test
# runner privileges (CAP_NET_ADMIN) and whether the wireguard kernel
# module is loaded; failures are logged at Debug level and do not
# crash the daemon. Kernel-state round-trips are covered by integration
# tests under internal/plugins/iface/netlink.
#
# The BGP peer connection confirms the daemon is still live after the
# reload. Base64 keys below are dummy (all-ones, all-twos, all-threes,
# all-fours) -- do NOT use in production.

# ze-peer expectations
# This test creates interfaces during a config reload, so it needs
# CAP_NET_ADMIN, not merely Linux. skip-os:value=darwin only hid it from macOS:
# on the unprivileged GitHub runner the reload transaction failed with
# 'operation not permitted' creating the link, and the assertion failed.
# caps=net-admin gates on the capability and names the runner where the test
# executes (ai/rules/qemu-testing.md).
option=needs-linux:caps=net-admin
stdin=peer:terminator=EOF_PEER

expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00300200000015400101004002004003040A0000014005040000006418C0A801
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

# Initial config (peer moved to the reload): no wireguard
# // the `peer peer1` block moves OUT of this initial config and into
# config2.conf below -- it is not deleted, and the two peer expectations above are
# unchanged. This is the fix, not a relaxation: while the peer existed up-front,
# both expectations were satisfiable PRE-reload, the check peer exited, and the
# runner killed the daemon before the SIGHUP ever landed (measured: "received
# SIGHUP" 0 times, test green in ~2.2s). Moving the peer into the reloaded config
# makes the same expectations reachable only AFTER the transaction applies.
stdin=ze-bgp:terminator=EOF_CONF
bgp {
}
EOF_CONF

# Updated config: same BGP peer + wireguard wgapply0 with one peer
tmpfs=config2.conf:terminator=EOF_CONF2
bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}

		update {
			attribute {
				origin igp
				local-preference 100
				next-hop 10.0.0.1
			}
			nlri {
				ipv4/unicast add 192.168.1.0/24
			}
		}
	}
}

interface {
	wireguard wgapply0 {
		listen-port 51821
		fwmark 4660
		private-key "AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE="
		peer site2 {
			public-key "AgICAgICAgICAgICAgICAgICAgICAgICAgICAgICAgI="
			preshared-key "BAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQ="
			endpoint {
				ip 198.51.100.2
				port 51820
			}
			allowed-ips [ 10.0.0.2/32 192.168.10.0/24 ]
			persistent-keepalive 25
		}
	}
}
EOF_CONF2

# // the two `sleep 2` lines and the trailing `kill -TERM` are removed
# and an `expect=stderr` assertion is added below, so this file's assertion count
# rises. The first sleep let the check peer finish and the runner kill the daemon
# before the SIGHUP; the second raced the reload it was meant to follow.
tmpfs=trigger.sh:mode=755:terminator=EOF_TRIGGER
#!/bin/sh
while [ ! -f daemon.pid ]; do sleep 0.1; done
while [ ! -f daemon.ready ]; do sleep 0.1; done
cp config2.conf ze-bgp.conf
kill -HUP $(cat daemon.pid)
EOF_TRIGGER

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=background:seq=2:exec=sh trigger.sh
cmd=foreground:seq=3:exec=ze -:stdin=ze-bgp:timeout=20s
# The asserted OnConfigApply success log is Info level and the default log level
# is WARN, so the interface subsystem must be raised for it to reach stderr.
option=env:var=ze.log.interface:value=info
# The interface section does not exist in the initial config, so the reload
# STARTS the interface plugin rather than reconfiguring a running one: it takes
# the OnConfigure path (internal/component/iface/register.go:430, "interface
# config applied"), not OnConfigApply's "interface config reloaded via
# transaction" (register.go:623). Because there is no interface section at boot,
# ANY occurrence of this line is necessarily post-reload, so matching it against
# accumulated stderr is sound. Confirmed in QEMU: the daemon logs "interface
# backend loaded" / "interface config applied" / "interface monitor started"
# between "received SIGHUP" and "sighup reload complete".
expect=stderr:contains=interface config applied
