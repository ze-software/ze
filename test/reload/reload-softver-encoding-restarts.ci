# Test: a reload that changes a running peer's software-version encoding
#       restarts the session, and the new OPEN carries the new encoding.
# Initial config: peer1 advertises software-version with encoding legacy;
#                 ze-peer mirrors ze's OPEN, so it advertises code 75 back.
# Live change:    the staged fixture (reload/live-stages) reloads config2.conf,
#                 where the encoding is draft and nothing else differs.
# Expected:       no refusal; the session restarts (Cease 6/6, two TCP
#                 connections), and the second OPEN carries code 75 in the
#                 draft encoding.
#
# VALIDATES: spec-runtime-peer-plugin-capabilities AC-2 and AC-5: the composed
#            config-verify carries softver's candidate declaration, the engine
#            installs it, and the reload restarts a session whose peer
#            advertised the changed code (RFC 5492 Section 1).
# PREVENTS:  a reload accepted while the session keeps running on the OPEN
#            that carried the old encoding.
option=timeout:value=60s
# The reactor logs each restart decision, with its reason, at info.
option=env:var=ze.log.bgp.reactor:value=info

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=2
option=timeout:value=50s
# ze's OPEN is each connection's seq 1.
option=open:value=inspect-open-message
# ze-peer writes established on the first session's first UPDATE and
# established-2 on the second's; the staged fixture waits on both.
option=established-file:path=established
# conn 1: MP ipv4/unicast, 4-octet AS 1, software-version legacy (4B 09 08 "Ze/0.1.0")
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF003601040001005A010203041902170104000100014104000000014B09085A652F302E312E30
# EOR from ze
expect=bgp:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
# The reload restarts the session: Cease (6) / Other Configuration
# Change (6, RFC 4486).
expect=bgp:conn=1:seq=3:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0015030606
# conn 2: the same, software-version draft (4B 08 "Ze/0.1.0")
expect=bgp:conn=2:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF003501040001005A010203041802160104000100014104000000014B085A652F302E312E30
expect=bgp:conn=2:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
# The clean shutdown after the last stage, on the second connection:
# Cease (6) / Administrative Shutdown (2) with the RFC 8203 default text.
expect=bgp:conn=2:seq=3:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002D0306021741646D696E6973747261746976652053687574646F776E
EOF_PEER

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external live-stages {
		run "le test fixture reload/live-stages stages.script"
		encoder json
	}
}

bgp {
	router-id 1.2.3.4
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				software-version {
					encoding legacy
				}
			}
		}
	}
}
EOF_CONF

# The reload. The plugin block is byte-identical in both configs, so the
# staged fixture survives.
tmpfs=config2.conf:terminator=EOF_CONF2
plugin {
	external live-stages {
		run "le test fixture reload/live-stages stages.script"
		encoder json
	}
}

bgp {
	router-id 1.2.3.4
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				software-version {
					encoding draft
				}
			}
		}
	}
}
EOF_CONF2

tmpfs=stages.script:terminator=EOF_SCRIPT
await-file established
reload config2.conf
await-file established-2
say SOFTVER-ENCODING-RESTARTED: second session established
EOF_SCRIPT

cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze --plugin ze.bgp-softver -:stdin=ze-bgp:timeout=60s

expect=stderr:contains=SOFTVER-ENCODING-RESTARTED: second session established
reject=stderr:pattern=ZE-OBSERVER-FAIL
reject=stderr:pattern=cannot change while ze runs
expect=stderr:contains=peer restart required
reject=stderr:pattern=ze signal restart
