# Test: bgp-persist plugin loaded and the session survives a reload
# VALIDATES: the persist plugin loads, the session establishes, and a route-set
#            reload is delivered on the RUNNING session with the plugin attached
#            (deliverStaticRouteDelta, peer_static_wire.go).
# PREVENTS: the persist plugin breaking the session or the reload. The fixture
#           asserted a reconnect until the route-set edit became a swap; a restart
#           now fails it, because the peer offers one connection slot.

# ze-peer expectations
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=20s

# Connection 1: Static route + EOR
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00300200000015400101004002004003040A0000014005040000006418C0A801
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000

# After initial messages: rewrite config (add second route) and SIGHUP
action=rewrite:conn=1:seq=2:source=config2.conf:dest=ze-bgp.conf
action=sighup:conn=1:seq=2

# The reload announces the ADDED route on the same connection.
expect=bgp:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00300200000015400101004002004003040A00000140050400000064180A0000
action=sigterm:conn=1:seq=3
EOF_PEER

# Initial ze bgp configuration (one static route + persist plugin)
tmpfs=ze-bgp.conf:terminator=EOF_CONF
plugin {
	internal persist {
		use bgp-persist
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}

		attach process persist {
			receive [ update-sent state open-received ]
			send [ update ]
		}

		update {
			attribute {
				origin igp
				local-preference 100
				next-hop 10.0.0.1
			}
			nlri {
				ipv4/unicast add 192.168.1.0/24
			}
		}
	}
}
EOF_CONF

# Rewritten config (two routes -- count change triggers peer restart)
tmpfs=config2.conf:terminator=EOF_CONF2
plugin {
	internal persist {
		use bgp-persist
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}

		attach process persist {
			receive [ update-sent state open-received ]
			send [ update ]
		}

		update {
			attribute {
				origin igp
				local-preference 100
				next-hop 10.0.0.1
			}
			nlri {
				ipv4/unicast add 192.168.1.0/24
			}
		}
		update {
			attribute {
				origin igp
				local-preference 100
				next-hop 10.0.0.1
			}
			nlri {
				ipv4/unicast add 10.0.0.0/24
			}
		}
	}
}
EOF_CONF2

# Process orchestration
cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze start ze-bgp.conf:timeout=20s
