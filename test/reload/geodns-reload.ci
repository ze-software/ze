# Test: a live edit of service { geodns } reaches the geodns plugin
# Initial config: geodns serves zone a.example. on 127.0.0.1:$PORT.
# After SIGHUP:   geodns serves a.example. and b.example.
# Expected: geodns installs the reloaded config at apply, logs it with both
#           zones counted, and answers the SOA of b.example., which only the
#           reloaded config serves.
#
# VALIDATES: spec-plugin-reload-applies-or-refuses row 23, AC-1: geodns's
#            verify/apply pair publishes the resolver snapshot of the reloaded
#            config (geodnsInstaller.install), and the DNS listener answers
#            from it.
# PREVENTS: the acked-and-dropped reload. With OnConfigure alone, the SDK
#           answers config-apply OK and calls nothing, so the commit succeeded
#           while geodns kept answering from the boot zones until a restart.
#
# DISCRIMINATION: client/dns-query asks 127.0.0.1:$PORT for the SOA of
# b.example. until the answer names it, and the test asserts its OK line. The
# boot config has no such zone, and only the apply handler publishes the
# reloaded one: with OnConfigure alone the query never matches, the client
# fails, and the "zones=2" expectation fails too. That an edit elsewhere under
# service publishes nothing is proven in Go by
# TestConfigTxUnchangedSubtreeIsNoop (geodns/config_tx_unchanged_test.go).

option=env:var=ze.log.geodns:value=info

stdin=ze-bgp:terminator=EOF_CONF
service {
	geodns {
		enabled true
		listener v4 {
			ip 127.0.0.1
			port $PORT
		}
		zone a.example.
		nameserver 192.0.2.53
	}
}
EOF_CONF

tmpfs=config2.conf:terminator=EOF_CONF2
service {
	geodns {
		enabled true
		listener v4 {
			ip 127.0.0.1
			port $PORT
		}
		zone a.example.
		zone b.example.
		nameserver 192.0.2.53
	}
}
EOF_CONF2

cmd=background:seq=1:exec=le test fixture reload/tx-protocol-sighup-trigger
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=20s
await=stderr:contains=sighup reload complete
expect=stderr:pattern=geodns: config applied.*zones=1
expect=stderr:pattern=geodns: config applied.*zones=2
cmd=foreground:seq=3:exec=le test fixture client/dns-query 127.0.0.1:$PORT b.example. SOA b.example.
expect=stderr:contains=OK: dns SOA b.example. served b.example.
reject=stderr:contains=reload error
reject=stderr:pattern=panic
