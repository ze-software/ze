# Test: a transport the daemon never built does not refuse the reload
# VALIDATES: spec-fixit-mgmt-listener-auth-guard-deferred-reload-auth-rebuild
# AC-5 -- one `api-server` block answers for REST and gRPC together, so a config
# that enables REST alone classified gRPC as well. gRPC has no server handle to
# rebuild, so the reload guard refused the WHOLE SIGHUP: an operator removing the
# API token was told "grpc cannot change its authentication while running" by a
# daemon running no gRPC server. The reload must proceed, and the REST listener
# it does run must stop demanding a bearer.
# PREVENTS: a guard refusing a migration on behalf of a server that does not
# exist. The refusal is correct for a RUNNING surface that cannot rebuild (AC-4);
# what makes it wrong here is the classification, and the fix is at the marking
# site (markMgmtAuth, cmd/ze/hub/mgmt_auth_reload.go).
#
# The condition AC-5 was first written with -- an api-server block with NO
# enabled transport -- cannot reach this path: ExtractAPIConfig
# (internal/component/config/loader_extract.go) returns ok=false when neither
# rest nor grpc is enabled, so nothing is classified and no reloader answers.
# One transport enabled and the other absent is the shape that reproduces, and
# it is the common one.

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=30s
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

tmpfs=mgmt-unbuilt-transport.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
"""Verify removing the API token takes effect over a REST-only api-server.

Before the SIGHUP the listener demands the boot token. After it, the same
listener serves an unauthenticated read: the reload was neither refused by
the gRPC surface that was never built, nor silently dropped.
"""

import json
import os
import urllib.error
import urllib.request

from ze_api import API, result_json_data, runtime_fail

REST_URL = 'http://127.0.0.1:$PORT2/api/v1/commands'
BOOT_TOKEN = 'boot-token'


def dispatch(api, command):
    resp = api._call_engine(
        'ze-plugin-engine:dispatch-command', {'command': command})
    if resp is None:
        return {'status': 'error', 'data': 'engine call returned None'}
    return resp.get('result', {})


def rest_status(token=None):
    """HTTP status of a REST read, or 0 when the listener does not answer."""
    req = urllib.request.Request(REST_URL)
    if token is not None:
        req.add_header('Authorization', 'Bearer ' + token)
    try:
        with urllib.request.urlopen(req, timeout=3) as resp:
            return resp.status
    except urllib.error.HTTPError as err:
        return err.code
    except (urllib.error.URLError, OSError):
        return 0


def generation_of(result):
    """Reload generation from `show reload-status`, or -1 when the dispatch has
    not completed. Poll-safe: never raises."""
    if result is None or result.get('status') != 'done':
        return -1
    try:
        data = result_json_data(result, {})
    except json.JSONDecodeError:
        return -1
    gen = data.get('generation')
    return gen if isinstance(gen, int) else -1


def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()
    api.wait_for_post_startup(timeout=5.0)

    if not api.wait_until(lambda: rest_status(token=BOOT_TOKEN) == 200, attempts=60, delay=0.25):
        runtime_fail('before SIGHUP: REST never answered on the boot token')
    status = rest_status()
    if status != 401:
        runtime_fail(f'before SIGHUP: unauthenticated read status={status}, want 401')

    baseline = generation_of(api.dispatch_until_done('show reload-status', attempts=40, delay=0.1))
    if baseline < 0:
        runtime_fail('before SIGHUP: show reload-status returned no generation')

    with open('observer.initial-ok', 'w') as f:
        f.write('ok')

    if not api.wait_until(lambda: os.path.exists('reload.done'), attempts=100, delay=0.1):
        runtime_fail('trigger.sh never created the reload.done marker')

    fenced = api.dispatch_until(
        'show reload-status',
        lambda r: generation_of(r) > baseline,
        attempts=150,
        delay=0.1,
    )
    if generation_of(fenced) <= baseline:
        runtime_fail(f'reload generation never advanced past {baseline}: {fenced!r}')

    status = rest_status()
    if status != 200:
        runtime_fail(f'after SIGHUP: unauthenticated read status={status}, want 200')

    dispatch(api, 'request shutdown')
    api.wait_for_shutdown()


if __name__ == '__main__':
    main()
EOF_RUN

# Post-SIGHUP config: the token is gone. The listen address is untouched, so the
# reload's whole job is the credential rebuild on the one transport that runs.
tmpfs=config2.conf:terminator=EOF_CONF2
plugin {
	external mgmt-unbuilt-transport-test {
		run ./mgmt-unbuilt-transport.run
		encoder json
	}
}

environment {
	api-server {
		rest {
			enabled true
			server main {
				ip 127.0.0.1
				port $PORT2
			}
		}
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		process mgmt-unbuilt-transport-test {
		}
	}
}
EOF_CONF2

tmpfs=trigger.sh:mode=755:terminator=EOF_TRIGGER
#!/bin/sh
while [ ! -f daemon.pid ]; do sleep 0.1; done
while [ ! -f daemon.ready ]; do sleep 0.1; done
while [ ! -f observer.initial-ok ]; do sleep 0.1; done
cp config2.conf ze-bgp.conf
kill -HUP $(cat daemon.pid)
touch reload.done
EOF_TRIGGER

# Initial config: REST enabled with a token, and no grpc block at all. That is
# the surface the daemon builds; gRPC is the one it does not.
stdin=ze-conf:terminator=EOF_CONF
plugin {
	external mgmt-unbuilt-transport-test {
		run ./mgmt-unbuilt-transport.run
		encoder json
	}
}

environment {
	api-server {
		token "boot-token"
		rest {
			enabled true
			server main {
				ip 127.0.0.1
				port $PORT2
			}
		}
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		process mgmt-unbuilt-transport-test {
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=background:seq=2:exec=sh trigger.sh
cmd=foreground:seq=3:exec=ze -:stdin=ze-conf:timeout=30s
expect=exit:code=0
expect=stderr:contains=sighup reload complete
