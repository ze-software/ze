# Test: a BFD session shared by an unpinned client widens again when a pinned
#       client leaves, so a later client pinned to another local address shares
#       it instead of opening a second session to the same remote system.
# Initial config: one iBGP peer to 127.0.0.1 with `connection local ip auto`
#                 and no BFD opt-in, and the `bfd` root with profile fast.
# Live change:    the staged fixture (reload/live-stages, run inside the daemon)
#                 reloads config2.conf (the peer gains a non-strict opt-in by
#                 this spec's swap: client A, no local address, opens session
#                 S), config3.conf (a pinned single-hop-session to 127.0.0.1
#                 from local 127.0.0.1: client B joins S and narrows it),
#                 config4.conf (B removed: it leaves S) and config5.conf (the
#                 same pinned session from local 127.0.0.2: client C).
# Expected:       after the last reload `show bfd sessions` lists ONE session to
#                 127.0.0.1, held by A and C (refcount 2), and no session held
#                 by one client alone.
#
# VALIDATES: spec-bgp-live-receive-binding-and-bfd-keep-session AC-24 at the real
#            entry point. RFC 5882 Section 4.4: "If multiple control protocols
#            wish to establish BFD sessions with the same remote system for the
#            same data protocol, all MUST share a single BFD session."
# PREVENTS: a departed pinned client leaving the shared session narrowed to its
#           local address, which splits every later client pinned elsewhere
#           onto a second session to the same neighbor.
#
# The spec's first sketch held S with a static route's unpinned next-hop; the
# static plugin loads the interface plugin, which has no backend on darwin, so
# the BGP peer's swap is client A here and a pinned session is B.
#
# DISCRIMINATION: with the engine before ce9ee9c2df (the narrowed `joined` key
# never widened on release), C fails to share and opens a second session: the
# table then holds two sessions to 127.0.0.1 with refcount 1 each.
option=timeout:value=60s
option=env:var=ze.bfd.test-parallel:value=true
# BFD binds the RFC 5881 fixed ports; see test/plugin/bgp-bfd-opt-in.ci.
option=exclusive:group=bfd-ports

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=50s
option=linger:value=true
# ze-peer creates this file on the daemon's first UPDATE; the staged fixture
# holds its first reload until it exists.
option=established-file:path=established
# EOR from ze
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external live-stages {
		run "le test fixture reload/live-stages stages.script"
		encoder json
	}
}

bfd {
	enabled true
	profile fast {
		detect-multiplier 3
		desired-min-tx-us 50000
		required-min-rx-us 50000
	}
}

bgp {
	router-id 1.2.3.4
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip auto
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast {
					prefix {
						maximum 10000
					}
				}
			}
		}
	}
}
EOF_CONF

# First reload: the peer gains the opt-in (client A).
tmpfs=config2.conf:terminator=EOF_CONF2
plugin {
	external live-stages {
		run "le test fixture reload/live-stages stages.script"
		encoder json
	}
}

bfd {
	enabled true
	profile fast {
		detect-multiplier 3
		desired-min-tx-us 50000
		required-min-rx-us 50000
	}
}

bgp {
	router-id 1.2.3.4
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip auto
				accept false
			}
			bfd {
				enabled true
				mode single-hop
				profile fast
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast {
					prefix {
						maximum 10000
					}
				}
			}
		}
	}
}
EOF_CONF2

# Second reload: client B pinned to local 127.0.0.1 joins.
tmpfs=config3.conf:terminator=EOF_CONF3
plugin {
	external live-stages {
		run "le test fixture reload/live-stages stages.script"
		encoder json
	}
}

bfd {
	enabled true
	profile fast {
		detect-multiplier 3
		desired-min-tx-us 50000
		required-min-rx-us 50000
	}

	single-hop-session 127.0.0.1 {
		local 127.0.0.1
		profile fast
	}
}

bgp {
	router-id 1.2.3.4
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip auto
				accept false
			}
			bfd {
				enabled true
				mode single-hop
				profile fast
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast {
					prefix {
						maximum 10000
					}
				}
			}
		}
	}
}
EOF_CONF3

# Third reload: client B removed.
tmpfs=config4.conf:terminator=EOF_CONF4
plugin {
	external live-stages {
		run "le test fixture reload/live-stages stages.script"
		encoder json
	}
}

bfd {
	enabled true
	profile fast {
		detect-multiplier 3
		desired-min-tx-us 50000
		required-min-rx-us 50000
	}
}

bgp {
	router-id 1.2.3.4
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip auto
				accept false
			}
			bfd {
				enabled true
				mode single-hop
				profile fast
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast {
					prefix {
						maximum 10000
					}
				}
			}
		}
	}
}
EOF_CONF4

# Fourth reload: client C pinned to local 127.0.0.2.
tmpfs=config5.conf:terminator=EOF_CONF5
plugin {
	external live-stages {
		run "le test fixture reload/live-stages stages.script"
		encoder json
	}
}

bfd {
	enabled true
	profile fast {
		detect-multiplier 3
		desired-min-tx-us 50000
		required-min-rx-us 50000
	}

	single-hop-session 127.0.0.1 {
		local 127.0.0.2
		profile fast
	}
}

bgp {
	router-id 1.2.3.4
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip auto
				accept false
			}
			bfd {
				enabled true
				mode single-hop
				profile fast
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast {
					prefix {
						maximum 10000
					}
				}
			}
		}
	}
}
EOF_CONF5

tmpfs=stages.script:terminator=EOF_SCRIPT
await-file established
reload config2.conf
has show bfd sessions => "refcount":1
reload config3.conf
has show bfd sessions => "refcount":2
reload config4.conf
has show bfd sessions => "refcount":1
reload config5.conf
has show bfd sessions => "refcount":2
lacks show bfd sessions => "refcount":1
say BFD-SHARED-WIDENS: the pinned client joined the session the departed client had narrowed
EOF_SCRIPT

cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=60s

expect=stderr:contains=BFD-SHARED-WIDENS: the pinned client joined the session the departed client had narrowed
reject=stderr:pattern=ZE-OBSERVER-FAIL
