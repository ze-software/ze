# Test: a reload that edits a community definition a peer's egress tag names
#       makes bgp-filter-community tag the next UPDATE with the new value.
# Topology (bgp-rs, ze AS 65000): A 127.0.0.1 AS 65001 sources the routes;
#          B 127.0.0.2 AS 65002 tags every egress UPDATE with standard
#          community TAG (value 65000:1).
# Stages (the live-stages fixture orders them, the reload waits until processed):
# 1. A sends U1 (10.0.0.0/24). B receives it with COMMUNITY 65000:1 (FDE80001).
# 2. reload config2: TAG's value becomes 65000:2. Nothing else changes: B's
#    egress block still names TAG.
# 3. route to A fences A's next UPDATE behind the processed reload; A sends U2
#    (10.0.1.0/24). B receives it with 65000:2 (FDE80002), which it can only do
#    when the plugin installed the edited definition at config-apply.
# Not claimed: whether U1 is re-sent to B with the new tag
# (spec-bgp-export-policy-reload-readvertise owns that).
#
# VALIDATES: spec-plugin-reload-applies-or-refuses AC-1 for bgp-filter-community
#            (user story 2).
# PREVENTS: the silent reload: with OnConfigure alone the SDK answered
#           config-apply OK and the plugin kept tagging with 65000:1.
#
# DISCRIMINATION: with newCommunityConfigTx().Register(p) replaced by
# p.OnConfigure(newCommunityConfigTx().Configure), U2 reaches B with 65000:1
# and B's third expectation fails.
#
# U1: ORIGIN IGP, AS_PATH [65001], NEXT_HOP 1.1.1.1, NLRI 10.0.0.0/24
# U2: U1 with NLRI 10.0.1.0/24
option=timeout:value=60s

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=50s
option=linger:value=true
option=asn:value=65001
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002F02000000144001010040020602010000FDE940030401010101180A0000
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
expect=bgp:conn=1:seq=2:announced=18C0A801
action=send:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002F02000000144001010040020602010000FDE940030401010101180A0001
EOF_PEER

stdin=destb:terminator=EOF_DESTB
option=tcp_connections:value=1
option=timeout:value=50s
option=linger:value=true
option=asn:value=65002
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
expect=bgp:conn=1:seq=2:announced=180A0000:attribute=8,FDE80001
action=rewrite:conn=1:seq=2:source=marker.txt:dest=b-first
expect=bgp:conn=1:seq=3:announced=180A0001:attribute=8,FDE80002
action=rewrite:conn=1:seq=3:source=marker.txt:dest=b-second
EOF_DESTB

tmpfs=marker.txt:terminator=EOF_MARKER
marker
EOF_MARKER

tmpfs=stages.script:terminator=EOF_SCRIPT
await-file b-first
reload config2.conf
route 127.0.0.1 update text nhop 10.0.0.1 nlri add 192.168.1.0/24
await-file b-second
say COMMUNITY-RELOAD: the UPDATE after the reload carries the edited tag
EOF_SCRIPT

# Startup: TAG is 65000:1.
stdin=ze-bgp:terminator=EOF_CONF
plugin {
	internal adj-rib-in {
		use bgp-adj-rib-in
	}
	internal rs {
		use bgp-rs
	}
	external stages {
		run "le test fixture reload/live-stages stages.script"
		encoder json
	}
}
bgp {
	# RFC 8212: an EBGP direction with no policy is refused; this test exchanges routes.
	filter {
		import { final accept; }
		export { final accept; }
	}
	community {
		standard TAG {
			value [ 65000:1 ]
		}
	}
	peer peer-a {
		connection {
			remote { ip 127.0.0.1; }
			local { ip 127.0.0.1; accept false; }
		}
		session {
			asn { local 65000; remote 65001; }
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability { graceful-restart disable; }
		}
		attach process stages {
			send [ update ]
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
		attach process adj-rib-in {
			receive [ update-received state ]
			send [ update ]
		}
	}
	peer peer-b {
		connection {
			remote { ip 127.0.0.2; }
			local { ip 127.0.0.2; accept false; }
		}
		session {
			asn { local 65000; remote 65002; }
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability { graceful-restart disable; }
		}
		filter {
			egress {
				community {
					tag [ TAG ]
				}
			}
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
		attach process adj-rib-in {
			receive [ update-received state ]
			send [ update ]
		}
	}
}
EOF_CONF

# The reload: TAG's value is the ONLY difference (65000:1 -> 65000:2).
tmpfs=config2.conf:terminator=EOF_CONF2
plugin {
	internal adj-rib-in {
		use bgp-adj-rib-in
	}
	internal rs {
		use bgp-rs
	}
	external stages {
		run "le test fixture reload/live-stages stages.script"
		encoder json
	}
}
bgp {
	# RFC 8212: an EBGP direction with no policy is refused; this test exchanges routes.
	filter {
		import { final accept; }
		export { final accept; }
	}
	community {
		standard TAG {
			value [ 65000:2 ]
		}
	}
	peer peer-a {
		connection {
			remote { ip 127.0.0.1; }
			local { ip 127.0.0.1; accept false; }
		}
		session {
			asn { local 65000; remote 65001; }
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability { graceful-restart disable; }
		}
		attach process stages {
			send [ update ]
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
		attach process adj-rib-in {
			receive [ update-received state ]
			send [ update ]
		}
	}
	peer peer-b {
		connection {
			remote { ip 127.0.0.2; }
			local { ip 127.0.0.2; accept false; }
		}
		session {
			asn { local 65000; remote 65002; }
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability { graceful-restart disable; }
		}
		filter {
			egress {
				community {
					tag [ TAG ]
				}
			}
		}
		attach process rs {
			receive [ update-received state open-received refresh ]
			send [ update ]
		}
		attach process adj-rib-in {
			receive [ update-received state ]
			send [ update ]
		}
	}
}
EOF_CONF2

cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer
cmd=background:seq=2:exec=le test peer --bind 127.0.0.2 --port $PORT:stdin=destb
cmd=foreground:seq=3:exec=ze --plugin ze.bgp-filter-community -:stdin=ze-bgp:timeout=60s
expect=exit:code=0
expect=stderr:contains=COMMUNITY-RELOAD: the UPDATE after the reload carries the edited tag
reject=stderr:pattern=panic recovered
reject=stderr:pattern=fatal error
reject=stderr:pattern=LIVE-STAGES line
reject=stderr:pattern=peer restart required
