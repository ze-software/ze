# Test: a reload that attaches a sent-direction process to a running peer, after
#       Ze advertised a route to it, restarts the peer.
# Initial config: one iBGP peer that negotiates Route Refresh; Ze announces the
#                 static route 192.168.1.0/24 and End-of-RIB to it.
# Live change:    the peer rewrites the config and sends SIGHUP once Ze's
#                 End-of-RIB arrived. The new config adds bgp-adj-rib-in, bound
#                 `receive [ update-sent state ]`.
# Expected:       Ze cannot replay what it already sent into the new process's
#                 view (ROUTE-REFRESH asks the PEER to re-send, never Ze), so the
#                 peer restarts: NOTIFICATION Cease subcode 6, a second
#                 connection that carries the route again, and the restart log
#                 line names ProcessBindings.
#
# VALIDATES: spec-bgp-live-receive-binding-and-bfd-keep-session AC-13 (wiring
#            row "sent-direction arm (hasAdvertised) -> restart").
# PREVENTS: a swap that keeps the session while the gained process never sees
#           the routes Ze advertised before it attached.
#
# It must stay a restart: the sent-direction arm (hasAdvertised) keeps it
# one, although Route Refresh is negotiated. AC-13's
# other half (the same reload on a session where Ze advertised nothing keeps
# one connection) is that spec's unit test TestSentDirectionGrantNeedsNothingAdvertised.
option=timeout:value=60s
option=env:var=ze.log.bgp.reactor:value=debug

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=2
option=timeout:value=50s
# Connection 1: Ze's static route (192.168.1.0/24) and End-of-RIB, so Ze has
# advertised before the reload.
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00300200000015400101004002004003040A0000014005040000006418C0A801
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
# Then the reload that attaches the sent-direction process.
action=rewrite:conn=1:seq=2:source=config2.conf:dest=ze-bgp.conf
action=sighup:conn=1:seq=2
# RFC 4486 Section 4: the restart is a configuration change, so the session
# reads NOTIFICATION Cease (6), subcode 6 "Other Configuration Change".
expect=bgp:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0015030606
# Connection 2: the restarted session re-sends the route, now in the new
# process's view.
expect=bgp:conn=2:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00300200000015400101004002004003040A0000014005040000006418C0A801
expect=bgp:conn=2:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	internal bgp-rib {
		use bgp-rib
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				route-refresh enable
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		# Route Refresh needs a process that may put routes on the wire
		# (validatePeerProcessCaps). Bound in both configs, so it never changes.
		attach process bgp-rib {
			receive [ update state refresh ]
			send [ update ]
		}
		update {
			attribute {
				origin igp
				local-preference 100
				next-hop 10.0.0.1
			}
			nlri {
				ipv4/unicast add 192.168.1.0/24
			}
		}
	}
}

EOF_CONF

# The second config declares bgp-adj-rib-in and attaches it to the sent direction.
tmpfs=config2.conf:terminator=EOF_CONF2
plugin {
	internal bgp-rib {
		use bgp-rib
	}
	internal adj-rib-in {
		use bgp-adj-rib-in
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				route-refresh enable
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		# Route Refresh needs a process that may put routes on the wire
		# (validatePeerProcessCaps). Bound in both configs, so it never changes.
		attach process bgp-rib {
			receive [ update state refresh ]
			send [ update ]
		}
		update {
			attribute {
				origin igp
				local-preference 100
				next-hop 10.0.0.1
			}
			nlri {
				ipv4/unicast add 192.168.1.0/24
			}
		}
		attach process adj-rib-in {
			receive [ update-sent state ]
		}
	}
}

EOF_CONF2

cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=60s

# The restart names the binding change that forced it.
expect=stderr:pattern=peer restart required
expect=stderr:pattern=changed=ProcessBindings
reject=stderr:pattern=peer settings swapped in place
