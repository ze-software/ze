# Test: a live edit of a peer's IRR as-set is ENFORCED by the running IRR filter
# Initial config: peer1 is filtered by bgp-filter-irr:65001 with as-set AS-V4ONLY
#                 (mock IRR: 192.0.2.0/24 only).
# After SIGHUP:   the same peer's as-set is AS-TEST (mock IRR: 10.0.0.0/24,
#                 10.0.1.0/24, 172.16.0.0/16), and a sentinel route is added.
# Expected: 10.0.0.0/24, sent by the peer AFTER the reload, is accepted by the
#           IRR filter. Under the boot as-set it would be refused.
#
# VALIDATES: spec-terminal-demo-showcase AC-1 -- "the commit applies: a prefix
#            outside the new set is refused at ingress ..., an in-set prefix is
#            accepted. The commit never reports success while the filter keeps its
#            old config".
# PREVENTS: the fail-open reload this test was written for. runFilterIRR
#           (filter_irr.go) registered OnConfigure alone. The SDK answers a
#           config-apply with no handler as OK and calls nothing, so every live IRR
#           edit was accepted and ignored: the filter kept the as-set it booted
#           with.
#
# DISCRIMINATION: 10.0.0.0/24 is in AS-TEST and absent from AS-V4ONLY, so the one
# filter decision on it names which as-set the running filter holds. Without the
# apply handler the decision is "irr filter reject"; with it, "irr filter accept".
#
# ORDERING: ze-peer has no sleep, so the reload is ordered ahead of the peer's
# UPDATE by a sentinel. The new config adds 192.168.1.0/24 to peer1; ze announces
# it only once the reload is applied, and the peer sends its UPDATE only after it
# has received that announcement. The engine applies every participant of the
# transaction before it reports the reload done, and the IRR filter holds a
# filtered UPDATE (bounded, firstResolveWait) until the new as-set's first
# resolution has finished, so the decision cannot read a half-applied state.

option=env:var=ze.log.bgp.filter.irr:value=info

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=30s

# Connection 1: ze has nothing to announce at boot, so it sends End-of-RIB alone.
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000

# Rewrite the config with the new as-set and the sentinel route, then SIGHUP.
action=rewrite:conn=1:seq=2:source=config2.conf:dest=ze-bgp.conf
action=sighup:conn=1:seq=2

# The sentinel: 192.168.1.0/24 from AS 65000, next-hop 10.0.0.1.
#   ORIGIN 40010100, AS_PATH 40020602010000FDE8 (AS_SEQ [65000]),
#   NEXT_HOP 4003040A000001, NLRI 18C0A801
expect=bgp:conn=1:seq=3:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002F02000000144001010040020602010000FDE84003040A00000118C0A801

# UPDATE from AS 65001 carrying 10.0.0.0/24, in AS-TEST and not in AS-V4ONLY.
#   ORIGIN 40010100, AS_PATH 40020602010000FDE9 (AS_SEQ [65001]),
#   NEXT_HOP 40030401010101, NLRI 180A0000
action=send:conn=1:seq=4:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002F02000000144001010040020602010000FDE940030401010101180A0000
EOF_PEER

stdin=ze-bgp:terminator=EOF_CONF
bgp {
	policy {
		irr {
			server 127.0.0.1:$PORT2
			refresh-interval 3600
		}
	}

	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
			irr {
				as-set AS-V4ONLY
			}
		}
		behavior {
			group-updates disable
		}

		filter {
			import [ bgp-filter-irr:65001 ]
		}
	}
}
EOF_CONF

# Rewritten config: the as-set and the sentinel route are the only differences.
tmpfs=config2.conf:terminator=EOF_CONF2
bgp {
	policy {
		irr {
			server 127.0.0.1:$PORT2
			refresh-interval 3600
		}
	}

	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
			irr {
				as-set AS-TEST
			}
		}
		behavior {
			group-updates disable
		}

		filter {
			import [ bgp-filter-irr:65001 ]
		}

		update {
			attribute {
				origin igp
				next-hop 10.0.0.1
			}
			nlri {
				ipv4/unicast add 192.168.1.0/24
			}
		}
	}
}
EOF_CONF2

cmd=background:seq=1:exec=le test irr --port $PORT2
cmd=background:seq=2:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=3:exec=ze --plugin ze.bgp-filter-irr --plugin ze.bgp-adj-rib-in -:stdin=ze-bgp:timeout=30s
# Wait for the filter's decision on the peer's UPDATE before the runner stops the
# daemon. Either decision ends the wait; the assertions below say which it was.
await=stderr:contains=msg="irr filter
expect=stderr:pattern=irr filter accept
expect=stderr:pattern=filter=65001
reject=stderr:pattern=irr filter reject
reject=stderr:pattern=peer restart required
reject=stderr:pattern=panic
