# Test: a reload that edits an as-path-list's entries makes bgp-filter-aspath
#       answer with the new definition.
# Initial config: one dynamic group (iBGP, AS 65533) whose import chain is
#                 `bgp-filter-aspath:ALLOW-$remote_as`; as-path-list ALLOW-65533
#                 (entry "65001" accept). The test peer dials Ze.
# Live change:    the staged fixture (reload/live-stages, run inside the daemon)
#                 rewrites the entry's action to reject and sends SIGHUP.
#                 Nothing else changes: the chain still names ALLOW-65533.
# Expected:       the same UPDATE (AS_PATH 65001, 10.0.0.0/24) evaluated
#                 against the peer's live chain answers accept before the
#                 reload and reject after it, which it can only do when the
#                 plugin installed the edited list at config-apply.
#
# VALIDATES: spec-plugin-reload-applies-or-refuses AC-1 for bgp-filter-aspath.
# PREVENTS: the silent reload: with OnConfigure alone the SDK answered
#           config-apply OK and the plugin kept its startup lists.
#
# DISCRIMINATION: with newAsPathConfigTx().Register(p) replaced by
# p.OnConfigure(newAsPathConfigTx().Configure), the after-reload policy test
# answers accept and the stage fails.
option=timeout:value=60s
option=env:var=ze.log.bgp.reactor:value=info

stdin=peer:terminator=EOF_PEER
option=asn:value=65533
option=tcp_connections:value=1
option=timeout:value=50s
# ze-peer creates this file on the daemon's first UPDATE; the staged fixture
# holds its first read until it exists.
option=established-file:path=established
# 10.1.0.0/24, origin IGP, empty AS_PATH (iBGP), next-hop 10.0.0.1,
# LOCAL_PREF 100: announced once the OPEN exchange is done. ALLOW-65533 does not match its empty AS_PATH, so it only keeps the session busy.
# Sent once. The dynamic session is held until every plugin, bgp-filter-prefix
# included, finished startup (Reactor.peersStarted), so this one copy meets a
# connected filter plugin; the stage's `show bgp rib received` reads it.
action=send:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00300200000015400101004002004003040A00000140050400000064180A0100
# EOR from ze
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
# The clean shutdown after the last stage, on the SAME connection: Cease (6) /
# Administrative Shutdown (2, RFC 4486) with the RFC 8203 default text.
expect=bgp:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002D0306021741646D696E6973747261746976652053687574646F776E
EOF_PEER

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	internal bgp-rib {
		use bgp-rib
	}
	external live-stages {
		run "le test fixture reload/live-stages stages.script"
		encoder json
	}
}

bgp {
	policy {
		as-path-list ALLOW-65533 {
			entry "65001" {
				action accept
			}
		}
	}

	group ix {
		connection {
			remote {
				ip dynamic
				connect false
				range 127.0.0.0/8
			}
			local {
				ip 127.0.0.1
				accept true
			}
		}
		session {
			asn {
				local 65533
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast {
					mode enable
					prefix {
						maximum 10000
					}
				}
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		filter {
			import [ bgp-filter-aspath:ALLOW-$remote_as ]
		}
		attach process bgp-rib {
			receive [ update-received state ]
		}
	}
}
EOF_CONF

# The second config: the action of ALLOW-65533's one entry is the ONLY
# difference (accept -> reject). The chain and the plugin block are
# byte-identical, so no peer is touched and the staged fixture survives.
tmpfs=config2.conf:terminator=EOF_CONF2
plugin {
	internal bgp-rib {
		use bgp-rib
	}
	external live-stages {
		run "le test fixture reload/live-stages stages.script"
		encoder json
	}
}

bgp {
	policy {
		as-path-list ALLOW-65533 {
			entry "65001" {
				action reject
			}
		}
	}

	group ix {
		connection {
			remote {
				ip dynamic
				connect false
				range 127.0.0.0/8
			}
			local {
				ip 127.0.0.1
				accept true
			}
		}
		session {
			asn {
				local 65533
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast {
					mode enable
					prefix {
						maximum 10000
					}
				}
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		filter {
			import [ bgp-filter-aspath:ALLOW-$remote_as ]
		}
		attach process bgp-rib {
			receive [ update-received state ]
		}
	}
}
EOF_CONF2

tmpfs=stages.script:terminator=EOF_SCRIPT
# Before the reload: ALLOW-65533 accepts an AS_PATH of 65001.
await-file established
has show policy test peer 127.0.0.1 import update FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002F02000000144001010040020602010000FDE940030401010101180A0000 => "action":"accept"
reload config2.conf
# After it: the same chain names the edited list, which now rejects.
has show policy test peer 127.0.0.1 import update FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002F02000000144001010040020602010000FDE940030401010101180A0000 => "action":"reject"
say AS-PATH-LIST-RELOAD: the edited as-path-list rejects
EOF_SCRIPT

cmd=background:seq=1:exec=le test peer --dial 127.0.0.1:$PORT:stdin=peer
cmd=foreground:seq=2:exec=ze --plugin ze.bgp-filter-aspath -:stdin=ze-bgp:timeout=60s

expect=stderr:contains=AS-PATH-LIST-RELOAD: the edited as-path-list rejects
reject=stderr:pattern=ZE-OBSERVER-FAIL
reject=stderr:pattern=dynamic peer restart required
# The session under test is a DYNAMIC peer's, built once, before the reload.
expect=stderr:contains=dynamic peer created
reject=stderr:pattern=received SIGHUP[\s\S]*dynamic peer created
