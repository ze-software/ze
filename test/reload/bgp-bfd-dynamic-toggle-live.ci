# Test: a reload that adds a non-strict BFD opt-in to a dynamic group's template
#       opens a BFD session for the RUNNING dynamic peer, and a second reload that
#       removes it closes that session, with no BGP restart in between.
# Initial config: one dynamic group (iBGP, AS 65533), no `bfd` root. The test
#                 peer dials Ze, so the only session is the dynamic one.
# Live change:    the staged fixture (reload/live-stages, run inside the daemon)
#                 reloads config2.conf (adds the `bfd` root with profile fast and
#                 the template's `connection bfd { profile fast }`), reads
#                 `show bfd sessions`, then reloads config3.conf (the opt-in
#                 removed, the `bfd` root kept) and reads it again.
# Expected:       one TCP connection for the whole test; after the first reload
#                 `show bfd sessions` lists the single-hop session to 127.0.0.1
#                 under profile fast; after the second it no longer lists it.
#
# VALIDATES: spec-bgp-live-receive-binding-and-bfd-keep-session AC-19 (wiring
#            row "journaled dynamic step -> peerSettingsSwapPlan ->
#            applyHotSwappableSettings -> startBFDClient / stopBFDClient").
# PREVENTS: an IXP operator enabling or disabling BFD on a dynamic group and
#           resetting every dynamic session in it.
#
# DISCRIMINATION: the continuity carrier is the clean-shutdown NOTIFICATION, as
# in reload-dynamic-peer-survives.ci: the peer dials once and never re-dials, so
# the Cease/Administrative Shutdown it expects arrives on the first connection
# only when both reloads kept it. ze-peer runs no BFD, so the session stays Down
# and never Up, which ends no BGP session (A-3).
#
# Red until that spec's Phase 4 (the dynamic step lands in Phase 3): today the
# template change restarts the dynamic peer ("dynamic peer restart required ...
# changed=group template"), the peer reads Cease subcode 6, and `show bfd
# sessions` never lists 127.0.0.1. AC-19's strict half (non-strict <-> strict
# restarts, log names BFD) is AC-7's rule and not asserted here.
option=timeout:value=60s
option=env:var=ze.log.bgp.reactor:value=info
option=env:var=ze.bfd.test-parallel:value=true
# BFD binds the RFC 5881 fixed ports; see test/plugin/bgp-bfd-opt-in.ci.
option=exclusive:group=bfd-ports

stdin=peer:terminator=EOF_PEER
option=asn:value=65533
option=tcp_connections:value=1
option=timeout:value=50s
# ze-peer creates this file on the daemon's first UPDATE; the staged fixture
# holds its first reload until it exists.
option=established-file:path=established
# EOR from ze
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
# The clean shutdown after the last stage, on the SAME connection: Cease (6) /
# Administrative Shutdown (2, RFC 4486) with the RFC 8203 default text.
expect=bgp:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002D0306021741646D696E6973747261746976652053687574646F776E
EOF_PEER

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external live-stages {
		run "le test fixture reload/live-stages stages.script"
		encoder json
	}
}

bgp {
	group ix {
		connection {
			remote {
				ip dynamic
				connect false
				range 127.0.0.0/8
			}
			local {
				ip 127.0.0.1
				accept true
			}
		}
		session {
			asn {
				local 65533
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast {
					mode enable
					prefix {
						maximum 10000
					}
				}
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

# First reload: the bfd root and the opt-in in the group template. The plugin
# block is byte-identical in all three configs, so the staged fixture survives.
tmpfs=config2.conf:terminator=EOF_CONF2
plugin {
	external live-stages {
		run "le test fixture reload/live-stages stages.script"
		encoder json
	}
}

bfd {
	enabled true
	profile fast {
		detect-multiplier 3
		desired-min-tx-us 50000
		required-min-rx-us 50000
	}
}

bgp {
	group ix {
		connection {
			remote {
				ip dynamic
				connect false
				range 127.0.0.0/8
			}
			local {
				ip 127.0.0.1
				accept true
			}
			bfd {
				enabled true
				mode single-hop
				profile fast
			}
		}
		session {
			asn {
				local 65533
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast {
					mode enable
					prefix {
						maximum 10000
					}
				}
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF2

# Second reload: the opt-in removed.
tmpfs=config3.conf:terminator=EOF_CONF3
plugin {
	external live-stages {
		run "le test fixture reload/live-stages stages.script"
		encoder json
	}
}

bfd {
	enabled true
	profile fast {
		detect-multiplier 3
		desired-min-tx-us 50000
		required-min-rx-us 50000
	}
}

bgp {
	group ix {
		connection {
			remote {
				ip dynamic
				connect false
				range 127.0.0.0/8
			}
			local {
				ip 127.0.0.1
				accept true
			}
		}
		session {
			asn {
				local 65533
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast {
					mode enable
					prefix {
						maximum 10000
					}
				}
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF3

tmpfs=stages.script:terminator=EOF_SCRIPT
await-file established
# First reload: the bfd root and the template's non-strict opt-in.
reload config2.conf
has show bfd sessions => "peer":"127.0.0.1"
has show bfd sessions => "profile":"fast"
# Second reload: the opt-in removed, the bfd root kept so the read still answers.
reload config3.conf
lacks show bfd sessions => "peer":"127.0.0.1"
say BFD-DYNAMIC-TOGGLE: session opened by the first reload and closed by the second
EOF_SCRIPT

cmd=background:seq=1:exec=le test peer --dial 127.0.0.1:$PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=60s

expect=stderr:contains=BFD-DYNAMIC-TOGGLE: session opened by the first reload and closed by the second
reject=stderr:pattern=ZE-OBSERVER-FAIL
reject=stderr:pattern=dynamic peer restart required
# The session under test is a DYNAMIC peer's, built once, before the reloads.
expect=stderr:contains=dynamic peer created
reject=stderr:pattern=received SIGHUP[\s\S]*dynamic peer created
