# Test: a reload that edits a remove-private-as definition's replace-with makes
#       bgp-filter-remove-private-as answer with the new definition.
# Initial config: one dynamic group (iBGP, AS 65533) whose import chain is
#                 `bgp-filter-remove-private-as:STRIP`. The test peer dials Ze.
# Live change:    the staged fixture (reload/live-stages, run inside the
#                 daemon) rewrites STRIP's replace-with (peer-as -> none) and
#                 sends SIGHUP. Nothing else changes.
# Expected:       the same UPDATE (AS_PATH 65001, 10.0.0.0/24) evaluated
#                 against the peer's live chain answers as-path 65533 before
#                 the reload and "delta":"as-path [] remove-private strip"
#                 after it, which it can only do when the plugin installed the
#                 edited definition at config-apply.
#
# VALIDATES: spec-plugin-reload-applies-or-refuses AC-1 for
#            bgp-filter-remove-private-as.
# PREVENTS: the silent reload: with OnConfigure alone the SDK answered
#           config-apply OK and the plugin kept its startup definitions.
#
# DISCRIMINATION: with newRemovePrivateASConfigTx().Register(p) replaced by
# p.OnConfigure(newRemovePrivateASConfigTx().Configure), the after-reload
# policy test still answers as-path 65533 and the stage fails.
option=timeout:value=60s
option=env:var=ze.log.bgp.reactor:value=info

stdin=peer:terminator=EOF_PEER
option=asn:value=65533
option=tcp_connections:value=1
option=timeout:value=50s
# ze-peer creates this file on the daemon's first UPDATE; the staged fixture
# holds its first read until it exists.
option=established-file:path=established
# EOR from ze
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
# The clean shutdown after the last stage, on the SAME connection: Cease (6) /
# Administrative Shutdown (2, RFC 4486) with the RFC 8203 default text.
expect=bgp:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002D0306021741646D696E6973747261746976652053687574646F776E
EOF_PEER

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external live-stages {
		run "le test fixture reload/live-stages stages.script"
		encoder json
	}
}

	policy {
		remove-private-as STRIP {
			replace-with peer-as
		}
	}

bgp {
	group ix {
		connection {
			remote {
				ip dynamic
				connect false
				range 127.0.0.0/8
			}
			local {
				ip 127.0.0.1
				accept true
			}
		}
		session {
			asn {
				local 65533
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast {
					mode enable
					prefix {
						maximum 10000
					}
				}
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		filter {
			import { filters [ bgp-filter-remove-private-as:STRIP ]; final accept; }
		}
	}
}
EOF_CONF

# The second config: STRIP's replace-with (peer-as -> none) is the ONLY
# difference. The chain and the plugin block are byte-identical, so no peer is
# touched and the staged fixture survives.
tmpfs=config2.conf:terminator=EOF_CONF2
plugin {
	external live-stages {
		run "le test fixture reload/live-stages stages.script"
		encoder json
	}
}

	policy {
		remove-private-as STRIP {
		}
	}

bgp {
	group ix {
		connection {
			remote {
				ip dynamic
				connect false
				range 127.0.0.0/8
			}
			local {
				ip 127.0.0.1
				accept true
			}
		}
		session {
			asn {
				local 65533
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast {
					mode enable
					prefix {
						maximum 10000
					}
				}
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		filter {
			import { filters [ bgp-filter-remove-private-as:STRIP ]; final accept; }
		}
	}
}
EOF_CONF2

tmpfs=stages.script:terminator=EOF_SCRIPT
# Before the reload: STRIP replaces the private 65001 with the peer's AS.
await-file established
has show policy test peer 127.0.0.1 import update FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002F02000000144001010040020602010000FDE940030401010101180A0000 => as-path 65533
reload config2.conf
# After it: it removes 65001 instead.
has show policy test peer 127.0.0.1 import update FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002F02000000144001010040020602010000FDE940030401010101180A0000 => "delta":"as-path [] remove-private strip"
say REMOVE-PRIVATE-AS-RELOAD: the edited definition removes
EOF_SCRIPT

cmd=background:seq=1:exec=le test peer --dial 127.0.0.1:$PORT:stdin=peer
cmd=foreground:seq=2:exec=ze --plugin ze.bgp-filter-remove-private-as -:stdin=ze-bgp:timeout=60s

expect=stderr:contains=REMOVE-PRIVATE-AS-RELOAD: the edited definition removes
reject=stderr:pattern=ZE-OBSERVER-FAIL
reject=stderr:pattern=LIVE-STAGES line
reject=stderr:pattern=dynamic peer restart required
# The session under test is a DYNAMIC peer's, built once, before the reload.
expect=stderr:contains=dynamic peer created
reject=stderr:pattern=received SIGHUP[\s\S]*dynamic peer created
