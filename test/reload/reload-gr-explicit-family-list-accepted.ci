# Test: a reload that adds a session family to a graceful-restart peer with an
#       explicit graceful-restart family list that does not name it is
#       accepted, and the peer restarts as for any capability-block change.
# Initial config: peer1 carries ipv4/unicast and graceful-restart with
#                 family { name ipv4/unicast }.
# After SIGHUP:   ipv6/unicast is added to the session families; the GR family
#                 list is unchanged.
# Expected:       no refusal; the peer restarts (Cease 6/6) and reconnects with
#                 both families.
#
# VALIDATES: AC-2g of spec-bgp-open-session-rfc-defects: the GR payload is the
#            explicit list, so gr's declaration does not change and the SDK's
#            comparison accepts the reload.
# PREVENTS:  a refusal for an edit that leaves every plugin-declared capability
#            as it was.
# The restart reason is logged at debug level.
option=env:var=ze.log.bgp.reactor:value=debug
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=2
option=timeout:value=30s
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
action=rewrite:conn=1:seq=2:source=config2.conf:dest=ze-bgp.conf
action=sighup:conn=1:seq=2
# RFC 4486 Section 4: the restart is a configuration change, Cease (6) /
# Other Configuration Change (6).
expect=bgp:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0015030606
# Connection 2: both families negotiated, an EOR for each.
expect=bgp:conn=2:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
expect=bgp:conn=2:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF001E0200000007900F0003000201
EOF_PEER

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	internal gr {
		use bgp-gr
	}
}
bgp {
	router-id 1.2.3.4
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart {
					restart-time 120
					family {
						name ipv4/unicast
					}
				}
			}
		}
		attach process gr {
			receive [ open-received state eor ]
			send [ update ]
		}
	}
}
EOF_CONF

tmpfs=config2.conf:terminator=EOF_CONF2
plugin {
	internal gr {
		use bgp-gr
	}
}
bgp {
	router-id 1.2.3.4
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
				ipv6/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart {
					restart-time 120
					family {
						name ipv4/unicast
					}
				}
			}
		}
		attach process gr {
			receive [ open-received state eor ]
			send [ update ]
		}
	}
}
EOF_CONF2

cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=30s

expect=stderr:pattern=peer restart required
reject=stderr:pattern=cannot change while ze runs
