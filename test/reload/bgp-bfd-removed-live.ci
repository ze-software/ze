# Third reload: the opt-in removed, the bfd root kept so the read still answers.
tmpfs=config4.conf:terminator=EOF_CONF4
plugin {
	external live-stages {
		run "le test fixture reload/live-stages stages.script"
		encoder json
	}
}

bfd {
	enabled true
	profile fast {
		detect-multiplier 3
		desired-min-tx-us 50000
		required-min-rx-us 50000
	}
}

bgp {
	router-id 1.2.3.4
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast {
					prefix {
						maximum 10000
					}
				}
			}
		}
	}
}
EOF_CONF4

tmpfs=stages.script:terminator=EOF_SCRIPT
await-file established
has show bfd sessions => "peer":"127.0.0.1"
reload config2.conf
lacks show bfd sessions => "peer":"127.0.0.1"
reload config3.conf
has show bfd sessions => "peer":"127.0.0.1"
reload config4.conf
lacks show bfd sessions => "peer":"127.0.0.1"
say BFD-REMOVED-LIVE: session closed by enabled false and by removal, BGP kept
EOF_SCRIPT

cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=60s

expect=stderr:contains=BFD-REMOVED-LIVE: session closed by enabled false and by removal, BGP kept
reject=stderr:pattern=ZE-OBSERVER-FAIL
reject=stderr:pattern=peer restart required
