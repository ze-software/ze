# Test: a reload that removes a configured peer's non-strict BFD opt-in, or sets
#       it `enabled false`, closes the peer's BFD session and keeps the BGP
#       session.
# Initial config: one iBGP peer with `connection bfd { profile fast }` and the
#                 `bfd` root, so the session opened on entry to Established is
#                 listed.
# Live change:    the staged fixture (reload/live-stages, run inside the daemon)
#                 reloads config2.conf (`enabled false`), config3.conf (enabled
#                 again) and config4.conf (the opt-in removed, the `bfd` root
#                 kept), reading `show bfd sessions` after each.
# Expected:       one TCP connection for the whole test; the session is listed
#                 before the first reload, gone after it, back after the second
#                 and gone after the third.
#
# VALIDATES: spec-bgp-live-receive-binding-and-bfd-keep-session AC-6 (wiring
#            row "reload -> peerSettingsSwapPlan -> applyHotSwappableSettings ->
#            applyBFDOptInChange -> stopBFDClient").
# PREVENTS: an operator removing BFD from one peer and resetting the BGP session
#           BFD was there to protect.
#
# DISCRIMINATION: the continuity carrier is the clean-shutdown NOTIFICATION, as
# in bgp-bfd-dynamic-toggle-live.ci: tcp_connections=1 and the Cease /
# Administrative Shutdown arrives on the first connection only when every
# reload kept it. With BFD outside the hot-swap set (hotSwappableSettings not
# copying it) the first reload logs "peer restart required ... changed=BFD"
# and sends Cease subcode 6 on connection 1.
option=timeout:value=60s
option=env:var=ze.log.bgp.reactor:value=info
option=env:var=ze.bfd.test-parallel:value=true
# BFD binds the RFC 5881 fixed ports; see test/plugin/bgp-bfd-opt-in.ci.
option=exclusive:group=bfd-ports

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=50s
# ze-peer creates this file on the daemon's first UPDATE; the staged fixture
# holds its first reload until it exists.
option=established-file:path=established
# EOR from ze
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
# The clean shutdown after the last stage, on the SAME connection: Cease (6) /
# Administrative Shutdown (2, RFC 4486) with the RFC 8203 default text.
expect=bgp:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002D0306021741646D696E6973747261746976652053687574646F776E
EOF_PEER

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external live-stages {
		run "le test fixture reload/live-stages stages.script"
		encoder json
	}
}

bfd {
	enabled true
	profile fast {
		detect-multiplier 3
		desired-min-tx-us 50000
		required-min-rx-us 50000
	}
}

bgp {
	router-id 1.2.3.4
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
			bfd {
				enabled true
				mode single-hop
				profile fast
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast {
					prefix {
						maximum 10000
					}
				}
			}
		}
	}
}
EOF_CONF

# First reload: the opt-in kept and set `enabled false`. The plugin block is
# byte-identical in all configs, so the staged fixture survives.
tmpfs=config2.conf:terminator=EOF_CONF2
plugin {
	external live-stages {
		run "le test fixture reload/live-stages stages.script"
		encoder json
	}
}

bfd {
	enabled true
	profile fast {
		detect-multiplier 3
		desired-min-tx-us 50000
		required-min-rx-us 50000
	}
}

bgp {
	router-id 1.2.3.4
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
			bfd {
				enabled false
				mode single-hop
				profile fast
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast {
					prefix {
						maximum 10000
					}
				}
			}
		}
	}
}
EOF_CONF2

