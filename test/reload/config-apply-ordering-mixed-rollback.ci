# Test: one participant's apply fails in a transaction that mixes decomposed
#       operations with coarse root nodes, and the rollback reaches both kinds.
#
# The reload removes the only BGP peer and changes rsvp-te { refresh-period } in
# the same commit. The bgp root is decomposed, so it contributes a remove-peer
# operation. No component decomposes rsvp-te, so each observer declaring that
# root is represented by one coarse node. Coarse nodes are synthesized in sorted
# participant order, so the failer sorts before the observer and refuses its
# section apply after the remove-peer has already run.
#
# The executor then replays the applied operations' inverses, which re-adds the
# peer, and the orchestrator publishes the transaction-wide rollback, which the
# bridge turns into one config-rollback per participant. The coarse node's
# participant is reached by the second of those and never by the first:
# rollbackApplied skips a coarse node on purpose, because config-operation-rollback
# has no SDK default handler.
#
# VALIDATES: AC-7 -- the decomposed operation replays its inverse, the coarse
#            node's participant receives the section rollback, and the
#            transaction reports rolled back.
# PREVENTS: R-4. A coarse node whose rollback was emitted as a per-operation
#           rollback would answer "unknown method", and a coarse node left out
#           of the rollback entirely would leave one participant applied while
#           every other one was undone.
#
# The assertions are each positive. The second TCP connection is the re-added
# peer dialing again and announcing its route again, which only the inverse of
# the remove-peer can produce. The observer's line is printed from its own
# OnConfigRollback. The daemon's "config apply partial failure" is what
# reload_tx.go writes for StateRolledBack.
#
# The reverse ORDER of the inverses is not observable here, because the bgp root
# contributes one operation. TestExecuteRollsBackMixedTransaction
# (internal/component/config/transaction/executor_test.go) is what covers the
# order; this test covers that both node kinds are reached at all.
#
# DISCRIMINATION: skip the section rollback for a coarse node, by making
# TxCoordinator.runOperationPath return StateRolledBack without calling
# publishRollback (internal/component/config/transaction/orchestrator.go). The
# observer then receives nothing and its line is never printed, while the
# decomposed inverse still runs and the peer still reconnects. The rejected
# reading is that the daemon surviving the failed reload proves the rollback:
# it survives an apply failure with no rollback at all.

# The observers are external plugins: their stderr joins the daemon's.
stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=2

# Connection 1: the peer from the initial config.
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00300200000015400101004002004003040A0000014005040000006418C0A801
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000

# Connection 2: the same peer, re-added by the inverse of the remove-peer that
# the rollback replayed. It sends the SAME two messages connection 1 sent, and
# the first of them is what makes this assertion cover AC-7 rather than the
# session alone: the peer is back only if it announces 192.168.1.0/24 again.
#
# The bytes are identical to connection 1's because the inverse restores the
# settings the reactor was running (runningPeerSettings,
# internal/component/bgp/reactor/operation.go). Rebuilding the peer from the
# operation's config subtree instead restored a session that announced nothing:
# the routes live in the `update` block, which the full config loader reads and
# this package's parser does not.
expect=bgp:conn=2:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00300200000015400101004002004003040A0000014005040000006418C0A801
expect=bgp:conn=2:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external config-apply-ordering-mixed-rollback-failer {
		run "ze-test fixture reload/config-apply-ordering-mixed-rollback-failer"
		encoder json
	}
	external config-apply-ordering-mixed-rollback-observer {
		run "ze-test fixture reload/config-apply-ordering-mixed-rollback-observer"
		encoder json
	}
}

rsvp-te {
	router-id 10.0.0.1
	refresh-period 30
	interface lo {
		max-bandwidth 10e9
		max-reservable-bandwidth 8e9
		address 127.0.0.1/8
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}

		update {
			attribute {
				origin igp
				local-preference 100
				next-hop 10.0.0.1
			}
			nlri {
				ipv4/unicast add 192.168.1.0/24
			}
		}
	}
}
EOF_CONF

# Reloaded config: the peer is gone and refresh-period changed, so the
# transaction carries one decomposed bgp operation and two coarse rsvp-te nodes.
tmpfs=config2.conf:terminator=EOF_CONF2
plugin {
	external config-apply-ordering-mixed-rollback-failer {
		run "ze-test fixture reload/config-apply-ordering-mixed-rollback-failer"
		encoder json
	}
	external config-apply-ordering-mixed-rollback-observer {
		run "ze-test fixture reload/config-apply-ordering-mixed-rollback-observer"
		encoder json
	}
}

rsvp-te {
	router-id 10.0.0.1
	refresh-period 10
	interface lo {
		max-bandwidth 10e9
		max-reservable-bandwidth 8e9
		address 127.0.0.1/8
	}
}

bgp {
}
EOF_CONF2

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=background:seq=2:exec=ze-test fixture reload/config-apply-ordering-mixed-rollback-trigger
cmd=foreground:seq=3:exec=ze -:stdin=ze-bgp:timeout=40s

expect=exit:code=0
expect=stderr:contains=OK: mixed rollback: the failing participant refused its section apply
expect=stderr:contains=OK: mixed rollback: the coarse node received the section rollback
expect=stderr:contains=config apply partial failure
reject=stderr:contains=unknown method
reject=stderr:contains=operation dependency cycle
