tmpfs=stages.script:terminator=EOF_SCRIPT
await-file established
has show bfd sessions => "refcount":1
reload config2.conf
has show bfd sessions => "refcount":2
reload config3.conf
has show bfd sessions => "refcount":1
reload config4.conf
has show bfd sessions => "refcount":2
lacks show bfd sessions => "refcount":1
say BFD-STATIC-SHARED-WIDENS: the pinned client joined the session the static route holds
EOF_SCRIPT

cmd=foreground:seq=1:exec=le test fixture static/static-bfd-shared-session-widens-setup
cmd=background:seq=2:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=3:exec=ze -:stdin=ze-bgp:timeout=60s

expect=stderr:contains=BFD-STATIC-SHARED-WIDENS: the pinned client joined the session the static route holds
reject=stderr:pattern=ZE-OBSERVER-FAIL
