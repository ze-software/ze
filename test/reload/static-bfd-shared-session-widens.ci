# Test: a BFD session held by a static route's next-hop (an unpinned client)
#       widens again when a pinned client leaves, so a later client pinned to
#       another local address shares it instead of opening a second session to
#       the same remote system.
# Setup:          two dummy links, zebfa 198.18.91.1/24 and zebfb
#                 198.18.91.2/24, so the next-hop 198.18.91.9 is on two
#                 connected links and its BFD request derives no link and no
#                 local address (api.SessionRequest.Canonical). On one link it
#                 would take that link's address and be pinned from the start.
# Initial config: the `bfd` root with profile fast and a static route whose
#                 next-hop 198.18.91.9 names bfd-profile fast: client A, no
#                 local address, opens session S at boot.
# Live change:    the staged fixture (reload/live-stages, run inside the daemon)
#                 reloads config2.conf (a pinned single-hop-session to
#                 198.18.91.9 from local 198.18.91.1, on zebfa: client B joins S
#                 and narrows it), config3.conf (B removed: it leaves S) and
#                 config4.conf (the same pinned session from local 198.18.91.2,
#                 on zebfb: client C).
# Expected:       after the last reload `show bfd sessions` lists ONE session to
#                 198.18.91.9, held by A and C (refcount 2), and no session
#                 held by one client alone. Nothing answers on the dummy links,
#                 so S stays Down; the table, not the state, is the proof.
#
# VALIDATES: spec-bgp-live-receive-binding-and-bfd-keep-session AC-24 at the real
#            entry point, with the static-route client the spec first named
#            (bgp-bfd-shared-session-widens.ci is the BGP-peer variant).
#            RFC 5882 Section 4.4: "If multiple control protocols wish to
#            establish BFD sessions with the same remote system for the same
#            data protocol, all MUST share a single BFD session."
# PREVENTS: a departed pinned client leaving the shared session narrowed to its
#           local address, which splits every later client pinned elsewhere
#           onto a second session to the same neighbor.
#
# DISCRIMINATION: with the engine before ce9ee9c2df (the narrowed `joined` key
# never widened on release), C fails to share and opens a second session: the
# table then holds two sessions to 198.18.91.9 with refcount 1 each.
# static loads the interface plugin, which needs a Linux backend, as every
# test under test/static does.
option=needs-linux:caps=net-admin
option=timeout:value=60s
option=env:var=ze.bfd.test-parallel:value=true
# BFD binds the RFC 5881 fixed ports; see test/plugin/bgp-bfd-opt-in.ci.
option=exclusive:group=bfd-ports

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=50s
# ze-peer creates this file on the daemon's first UPDATE; the staged fixture
# holds its first reload until it exists.
option=established-file:path=established
# EOR from ze
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
# The clean shutdown after the last stage: Cease (6) / Administrative Shutdown
# (2, RFC 4486) with the RFC 8203 default text.
expect=bgp:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002D0306021741646D696E6973747261746976652053687574646F776E
EOF_PEER

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external live-stages {
		run "le test fixture reload/live-stages stages.script"
		encoder json
	}
}

bfd {
	enabled true
	profile fast {
		detect-multiplier 3
		desired-min-tx-us 50000
		required-min-rx-us 50000
	}
}

static {
	table default {
		route 192.0.2.0/24 {
			next {
				hop 198.18.91.9 {
					bfd-profile fast
				}
			}
		}
	}
}

# The BGP peer only paces the script (its established-file) and carries the
# clean shutdown; it has no BFD opt-in.
bgp {
	router-id 1.2.3.4
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast {
					prefix {
						maximum 10000
					}
				}
			}
		}
	}
}
EOF_CONF

# First reload: client B pinned to local 198.18.91.1 joins.
tmpfs=config2.conf:terminator=EOF_CONF2
plugin {
	external live-stages {
		run "le test fixture reload/live-stages stages.script"
		encoder json
	}
}

bfd {
	enabled true
	profile fast {
		detect-multiplier 3
		desired-min-tx-us 50000
		required-min-rx-us 50000
	}

	single-hop-session 198.18.91.9 {
		local 198.18.91.1
		profile fast
	}
}

static {
	table default {
		route 192.0.2.0/24 {
			next {
				hop 198.18.91.9 {
					bfd-profile fast
				}
			}
		}
	}
}

# The BGP peer only paces the script (its established-file) and carries the
# clean shutdown; it has no BFD opt-in.
bgp {
	router-id 1.2.3.4
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast {
					prefix {
						maximum 10000
					}
				}
			}
		}
	}
}
EOF_CONF2

