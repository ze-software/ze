# Test: a commit that edits the CONTENT of the profile a running non-strict
#       peer's BFD opt-in names reaches the peer's live BFD session in place,
#       and keeps the BGP session.
# Initial config: one iBGP peer with a non-strict `connection bfd { profile fast }`
#                 opt-in; profile fast runs Detect Mult 3, so the session to the
#                 peer exists under fast from the start.
# Live change:    an SSH session editor load-merges `bfd profile fast
#                 detect-multiplier 7` and commits. The peer's own config does
#                 not change, so the BGP reactor sees no edit at all.
# Expected:       one TCP connection; `show bfd sessions` lists the session to the
#                 peer under profile fast with Detect Mult 7.
#
# VALIDATES: spec-bgp-live-receive-binding-and-bfd-keep-session AC-25 for a
#            protocol client: SSH commit -> bfd OnConfigApply -> applyConfig ->
#            applyPinned -> reprofileClients -> engine.Loop.Reprofile ->
#            session.Machine.ApplyTimers.
# PREVENTS: a BGP peer's BFD session that keeps the timers its profile resolved
#           to when the peer asked, so a profile edit changes nothing until the
#           BGP session is torn down.
#
# DISCRIMINATION: with applyPinned not calling reprofileClients, the session
# keeps Detect Mult 3 and stage 2 fails on `detect-multiplier: 7`.
option=timeout:value=60s
option=env:var=ze.bfd.test-parallel:value=true
option=env:var=ze.log.bgp.reactor:value=debug
# BFD binds the RFC 5881 fixed ports; see test/plugin/bgp-bfd-opt-in.ci.
option=exclusive:group=bfd-ports

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=50s
option=linger:value=true
# EOR from ze, once: the commit does not restart the session
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER

tmpfs=bgp-bfd-profile-timer-edit-live.conf:terminator=EOF_CONF
system {
    authentication {
        user admin {
            password "$2a$04$UlwuiuH82Unfsq.XEMPGJeDkXwbm3KW.nvVaVXOd/JeFK8VjMjrQO"
        }
    }
}

environment {
    ssh {
        enabled true
        server main {
            ip 127.0.0.1;
            port $PORT2;
        }
    }
}

bfd {
    enabled true
    profile fast {
        detect-multiplier 3
        desired-min-tx-us 50000
        required-min-rx-us 50000
    }
    profile slow {
        detect-multiplier 5
        desired-min-tx-us 300000
        required-min-rx-us 300000
    }
}

plugin {
    internal adj-rib-in {
        use bgp-adj-rib-in
    }
}

bgp {
    router-id 1.2.3.4
    peer peer1 {
        connection {
            remote {
                ip 127.0.0.1
            }
            local {
                ip 127.0.0.1
                accept false
            }
            bfd {
                enabled true
                mode single-hop
                profile fast
            }
        }
        session {
            asn {
                local 1
                remote 1
            }
            router-id 1.2.3.4
            family {
                ipv4/unicast { prefix { maximum 10000; } }
            }
        }
        attach process adj-rib-in {
            receive [ update-received state ]
        }
    }
}
EOF_CONF

tmpfs=bfd-profile-fast-mult.conf:terminator=EOF_TOPIC
bfd {
    profile fast {
        detect-multiplier 7
    }
}
EOF_TOPIC

tmpfs=bgp-bfd-profile-timer-edit-live.script:terminator=EOF_SCRIPT
cli show bfd sessions | yaml
has peer: 127.0.0.1
has profile: fast
has detect-multiplier: 3
send load file absolute merge bfd-profile-fast-mult.conf
wait Configuration merged from
send commit now
wait Session committed:
cli show bfd sessions | yaml
has peer: 127.0.0.1
has profile: fast
has detect-multiplier: 7
EOF_SCRIPT

cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze start bgp-bfd-profile-timer-edit-live.conf:timeout=60s
cmd=foreground:seq=3:exec=le test fixture plugin/session-editor $PORT2 bgp-bfd-profile-timer-edit-live.conf bgp-bfd-profile-timer-edit-live.script:timeout=60s
expect=exit:code=0
