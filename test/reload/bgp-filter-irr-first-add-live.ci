# Test: an IRR filter ADDED by a live commit is enforced by the running filter
# Initial config: peer1 has no IRR as-set and no import filter. bgp-filter-irr
#                 runs anyway: its ConfigRoots is bgp, so the engine starts it
#                 at boot for any config with a bgp block (getConfigPathPlugins).
# After SIGHUP:   peer1 gains `irr { as-set AS-TEST }` and
#                 `import [ bgp-filter-irr:65001 ]`, and a sentinel route.
# Expected: 10.0.0.0/24, sent by the peer AFTER the reload, is judged by the IRR
#           filter against AS-TEST and accepted.
#
# VALIDATES: spec-terminal-demo-showcase AC-1 and its A-1 (a first-time IRR
#            block in a live commit reaches the filter).
# PREVENTS: the fail-open reload: with OnConfigure alone the running filter
#           never enrolled the ASN, so the UPDATE was refused "no-prefix-list"
#           while the commit had reported success.
#
# DISCRIMINATION: without the apply handler ASN 65001 is never enrolled and the
# filter logs "irr filter reject"; with it, "irr filter accept".
#
# ORDERING: as in bgp-filter-irr-added-live.ci, the sentinel route announced by
# the reload orders the peer's UPDATE after it.

option=env:var=ze.log.bgp.filter.irr:value=info

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=30s

# Connection 1: ze has nothing to announce at boot, so it sends End-of-RIB alone.
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000

# Rewrite the config with the IRR filter and the sentinel route, then SIGHUP.
action=rewrite:conn=1:seq=2:source=config2.conf:dest=ze-bgp.conf
action=sighup:conn=1:seq=2

# The sentinel: 192.168.1.0/24 from AS 65000, next-hop 10.0.0.1.
#   ORIGIN 40010100, AS_PATH 40020602010000FDE8 (AS_SEQ [65000]),
#   NEXT_HOP 4003040A000001, NLRI 18C0A801
expect=bgp:conn=1:seq=3:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002F02000000144001010040020602010000FDE84003040A00000118C0A801

# UPDATE from AS 65001 carrying 10.0.0.0/24, in AS-TEST.
#   ORIGIN 40010100, AS_PATH 40020602010000FDE9 (AS_SEQ [65001]),
#   NEXT_HOP 40030401010101, NLRI 180A0000
action=send:conn=1:seq=4:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002F02000000144001010040020602010000FDE940030401010101180A0000
EOF_PEER

stdin=ze-bgp:terminator=EOF_CONF
bgp {
	policy {
		irr {
			server 127.0.0.1:$PORT2
			refresh-interval 3600
		}
	}

	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

# Rewritten config: the IRR as-set, the import filter and the sentinel route are
# the only differences.
tmpfs=config2.conf:terminator=EOF_CONF2
bgp {
	policy {
		irr {
			server 127.0.0.1:$PORT2
			refresh-interval 3600
		}
	}

	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65001
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
			irr {
				as-set AS-TEST
			}
		}
		behavior {
			group-updates disable
		}

		filter {
			import [ bgp-filter-irr:65001 ]
		}

		update {
			attribute {
				origin igp
				next-hop 10.0.0.1
			}
			nlri {
				ipv4/unicast add 192.168.1.0/24
			}
		}
	}
}
EOF_CONF2

cmd=background:seq=1:exec=le test irr --port $PORT2
cmd=background:seq=2:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=3:exec=ze --plugin ze.bgp-filter-irr --plugin ze.bgp-adj-rib-in -:stdin=ze-bgp:timeout=30s
# Wait for the filter's decision on the peer's UPDATE before the runner stops the
# daemon. Either decision ends the wait; the assertions below say which it was.
await=stderr:contains=msg="irr filter
expect=stderr:pattern=irr filter accept
expect=stderr:pattern=filter=65001
reject=stderr:pattern=irr filter reject
reject=stderr:pattern=peer restart required
reject=stderr:pattern=panic
