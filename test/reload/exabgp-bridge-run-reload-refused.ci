# Test: a reload that changes an exabgp bridge script's run command is
#       refused while the bridge runs, naming the leaf.
# Initial config: the exabgp bridge runs process helper and feeds peer1.
# Live change:    config2.conf gives process helper another run command;
#                 nothing else changes.
# Expected:       the reload is refused at verify naming the leaf path
#                 `exabgp bridge process helper`, saying it cannot change while
#                 ze runs, with the restart steps; the session stays up on one
#                 TCP connection.
#
# VALIDATES: spec-plugin-reload-applies-or-refuses row 27, AC-8 (owner
#            decision Q4 = e1): bridgeRunner.verifyReload refuses every
#            non-capability change under exabgp bridge.
# PREVENTS:  the acked-and-dropped reload. With OnConfigure alone the SDK
#            answered config-verify and config-apply OK, the commit succeeded,
#            and the script kept running the old command.
#
# DISCRIMINATION: the refusal line is written only by verifyReload; with
# registerReloadHandlers removed from runInternalBridge the reload is accepted
# and the first expectation fails.
option=timeout:value=60s

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=50s
# ze-peer creates this file on the daemon's first UPDATE; the staged fixture
# holds its first reload until it exists.
option=established-file:path=established
# EOR from ze
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
# The helper script's route, 1.1.0.0/24 next-hop 101.1.101.1 (as in
# test/plugin/exabgp-bridge-internal.ci).
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0030020000001540010100400200400304650165014005040000006418010100
# The clean shutdown after the last stage, on the SAME connection: Cease (6) /
# Administrative Shutdown (2, RFC 4486) with the RFC 8203 default text.
expect=bgp:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002D0306021741646D696E6973747261746976652053687574646F776E
EOF_PEER

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external live-stages {
		run "le test fixture reload/live-stages stages.script"
		encoder json
	}
}

exabgp {
	bridge {
		process helper {
			run "le test fixture plugin/exabgp-bridge-helper"
		}
		family ipv4/unicast
		route-refresh false
	}
}
plugin {
	internal exabgp-bridge {
		use exabgp-bridge
	}
}
bgp {
	router-id 1.2.3.4
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
		}
		attach process exabgp-bridge {
			receive [ * ]
			send [ * ]
		}
	}
}
EOF_CONF

# The reload: process helper's run command is the only difference. The
# plugin block is byte-identical in both configs, so the staged fixture
# survives.
tmpfs=config2.conf:terminator=EOF_CONF2
plugin {
	external live-stages {
		run "le test fixture reload/live-stages stages.script"
		encoder json
	}
}

exabgp {
	bridge {
		process helper {
			run "le test fixture plugin/exabgp-bridge-helper --edited"
		}
		family ipv4/unicast
		route-refresh false
	}
}
plugin {
	internal exabgp-bridge {
		use exabgp-bridge
	}
}
bgp {
	router-id 1.2.3.4
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
		}
		attach process exabgp-bridge {
			receive [ * ]
			send [ * ]
		}
	}
}
EOF_CONF2

tmpfs=stages.script:terminator=EOF_SCRIPT
await-file established
reload config2.conf
say BRIDGE-RUN-REFUSED: reload refused, session kept
EOF_SCRIPT

cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=60s

expect=stderr:contains=exabgp bridge process helper cannot change while ze runs (plugin exabgp-bridge): the bridge's scripts keep the config they started with.
expect=stderr:contains=  under systemd: systemctl restart ze
expect=stderr:contains=BRIDGE-RUN-REFUSED: reload refused, session kept
reject=stderr:pattern=ZE-OBSERVER-FAIL
reject=stderr:pattern=peer restart required
reject=stderr:pattern=capability route-refresh cannot change
reject=stderr:pattern=ze signal restart
