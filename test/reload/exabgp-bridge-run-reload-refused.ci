# Test: a reload that changes an ExaBGP wrapper endpoint's external run command
#       is refused while ze runs, naming the endpoint, the changed `run` leaf,
#       and `restart ze`.
# Initial config: external bus endpoint `helper` runs `ze exabgp plugin` over
#                 `plugin/exabgp-bridge-helper` and feeds peer1.
# Live change:    config2.conf gives endpoint `helper` another `external > run`
#                 command; nothing else changes.
# Expected:       the reload is refused before apply by
#                 RefuseChangedDeclarations, naming plugin "helper" (run) and
#                 `restart ze`, `show reload-status` reports failed, and the
#                 session stays up on one TCP connection with the helper's
#                 route intact.
#
# VALIDATES: spec-explicit-plugin-and-attach-config E-1 (external-plugin
#            restart-only ruling) and spec-plugin-reload-applies-or-refuses
#            AC-8: RefuseChangedDeclarations refuses any change to an external
#            endpoint's `run` leaf on reload.
# PREVENTS:  the acked-and-dropped reload where changing an ExaBGP script
#            endpoint's `run` command commits while the old subprocess keeps
#            running.
#
# DISCRIMINATION: the refusal is produced by RefuseChangedDeclarations
# (internal/component/plugin/server/reload_declarations.go) comparing the
# external endpoint's `run` field; without it `show reload-status` reads
# "applied" and the refusal assertions fail.
option=timeout:value=60s

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=50s
# ze-peer creates this file on the daemon's first UPDATE; the staged fixture
# holds its first reload until it exists.
option=established-file:path=established
# EOR from ze
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
# The helper script's route, 1.1.0.0/24 next-hop 101.1.101.1 (as in
# test/plugin/exabgp-bridge-sdk.ci).
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0030020000001540010100400200400304650165014005040000006418010100
# The clean shutdown after the last stage, on the SAME connection: Cease (6) /
# Administrative Shutdown (2, RFC 4486) with the RFC 8203 default text.
expect=bgp:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002D0306021741646D696E6973747261746976652053687574646F776E
EOF_PEER

stdin=ze-bgp:terminator=EOF_CONF
bus {
	endpoint live-stages {
		external {
			run "le test fixture reload/live-stages stages.script";
		}
		encoding json;
	}
	endpoint helper {
		external {
			run "ze exabgp plugin --family ipv4/unicast le test fixture plugin/exabgp-bridge-helper";
		}
		encoding json;
	}
}
bgp {
	router-id 1.2.3.4
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
		}
	}
}
EOF_CONF

# The reload: endpoint helper's external run command is the only difference.
# live-stages is byte-identical in both configs, so the staged fixture survives.
tmpfs=config2.conf:terminator=EOF_CONF2
bus {
	endpoint live-stages {
		external {
			run "le test fixture reload/live-stages stages.script";
		}
		encoding json;
	}
	endpoint helper {
		external {
			run "ze exabgp plugin --family ipv4/unicast le test fixture plugin/exabgp-bridge-helper --edited";
		}
		encoding json;
	}
}
bgp {
	router-id 1.2.3.4
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
		}
	}
}
EOF_CONF2

tmpfs=stages.script:terminator=EOF_SCRIPT
await-file established
reload config2.conf
has show reload-status => "last-outcome":"failed"
# The helper is a forked process whose first line reaches the daemon whenever
# the machine lets it start, before or after the reload. The EOR and its route
# are the two UPDATEs: this fences the shutdown behind the route, which the
# peer expects, and shows the session and the helper still carry it after the
# refused reload.
has show bgp peer 127.0.0.1 detail => "updates-sent":2,
say BRIDGE-RUN-REFUSED: reload refused, session kept
EOF_SCRIPT

cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=60s

expect=stderr:contains=the new config changes the external plugins ze runs, which change only when ze restarts
expect=stderr:pattern=it changes plugin.*helper.*\(run\)
expect=stderr:contains=restart ze
expect=stderr:contains=BRIDGE-RUN-REFUSED: reload refused, session kept
reject=stderr:pattern=ZE-OBSERVER-FAIL
reject=stderr:pattern=peer restart required
reject=stderr:pattern=ze signal restart
reject=stderr:pattern=systemctl restart ze
