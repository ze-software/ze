# Test: a reload reaching a plugin that registered no apply handler is refused.
# Initial config: peer1 established; the plugin-without-apply fixture wants the
#                 bgp root and registers neither OnConfigApply nor
#                 DeclareAppliesNothing.
# Live change:    config2.conf adds a description to peer1, so bgp changes and
#                 the fixture is a participant.
# Expected:       the SDK refuses at config-verify, naming the plugin, the
#                 changed root and the restart routes; the session is kept.
#
# VALIDATES: AC-10 of spec-plugin-reload-applies-or-refuses: a participant SDK
#            plugin with no apply handler and no declaration is refused at
#            verify, with the restart routes as the next step, never
#            `ze signal restart`.
# PREVENTS:  a plugin accepting a reload it never applies, so the operator's
#            change is reported committed and the plugin keeps the old config.
#
# DISCRIMINATION: under a ze whose SDK verify accepts a plugin with no apply
# handler (the default before Phase 5), the reload commits and the refusal
# line never appears.
option=timeout:value=60s

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=50s
# ze-peer creates this file on the daemon's first UPDATE; the staged fixture
# holds its first reload until it exists.
option=established-file:path=established
# EOR from ze
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
# The clean shutdown after the last stage, on the SAME connection: Cease (6) /
# Administrative Shutdown (2, RFC 4486) with the RFC 8203 default text.
expect=bgp:conn=1:seq=2:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF002D0306021741646D696E6973747261746976652053687574646F776E
EOF_PEER

stdin=ze-bgp:terminator=EOF_CONF
plugin {
	external live-stages {
		run "le test fixture reload/live-stages stages.script"
		encoder json
	}
	external plugin-without-apply {
		run "le test fixture reload/plugin-without-apply"
		encoder json
	}
}

bgp {
	router-id 1.2.3.4
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
		}
	}
}
EOF_CONF

# The reload. The plugin block is byte-identical in both configs, so both
# fixtures survive.
tmpfs=config2.conf:terminator=EOF_CONF2
plugin {
	external live-stages {
		run "le test fixture reload/live-stages stages.script"
		encoder json
	}
	external plugin-without-apply {
		run "le test fixture reload/plugin-without-apply"
		encoder json
	}
}

bgp {
	router-id 1.2.3.4
	peer peer1 {
		description "an edit the fixture cannot apply"
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
		}
	}
}
EOF_CONF2

tmpfs=stages.script:terminator=EOF_SCRIPT
await-file established
reload config2.conf
say PLUGIN-WITHOUT-APPLY-REFUSED: reload refused, session kept
EOF_SCRIPT

cmd=background:seq=1:exec=le test peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=60s

expect=stderr:contains=plugin plugin-without-apply cannot apply a change to bgp while ze runs: it registered no config apply handler
expect=stderr:contains=  under systemd: systemctl restart ze
expect=stderr:contains=PLUGIN-WITHOUT-APPLY-REFUSED: reload refused, session kept
reject=stderr:pattern=ZE-OBSERVER-FAIL
reject=stderr:pattern=ze signal restart
