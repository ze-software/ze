# Test: SIGHUP transactional commit promotes candidate to active
# VALIDATES: AC-7 -- SIGHUP writes edited file as candidate, promotes it to active, and records rollback.
# PREVENTS: successful reload leaving active pointer stale or candidate pointer present.

option=env:var=ZE_STORAGE_BLOB:value=false

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
action=rewrite:conn=1:seq=1:source=tx-new.conf:dest=ze-bgp.conf
action=sighup:conn=1:seq=1
EOF_PEER

stdin=ze-bgp:terminator=EOF_CONF
bgp {
    peer peer1 {
        connection {
            remote {
                ip 127.0.0.1
            }
            local {
                ip 127.0.0.1
                accept false
            }
        }
        session {
            asn {
                local 1
                remote 1
            }
            router-id 1.2.3.4
            family {
                ipv4/unicast { prefix { maximum 10000; } }
            }
            capability {
                graceful-restart disable
            }
        }
        behavior {
            group-updates disable
        }
    }
}
EOF_CONF

tmpfs=tx-new.conf:terminator=EOF_NEW_CONF
bgp {
    peer peer1 {
        connection {
            remote {
                ip 127.0.0.1
            }
            local {
                ip 127.0.0.1
                accept false
            }
        }
        session {
            asn {
                local 1
                remote 1
            }
            router-id 2.2.2.2
            family {
                ipv4/unicast { prefix { maximum 10000; } }
            }
            capability {
                graceful-restart disable
            }
        }
        behavior {
            group-updates disable
        }
    }
}
EOF_NEW_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=foreground:seq=2:exec=ze -:stdin=ze-bgp:timeout=20s

await=stderr:contains=sighup reload complete
expect=file:path=meta/config/active:exists=true
expect=file:path=meta/config/candidate:absent=true
expect=file:path=meta/config/rollback:exists=true
expect=file:glob=rollback/ze-bgp-*.conf:count=2
expect=file:glob=rollback/ze-bgp-*.conf:contains=router-id 1.2.3.4
expect=file:glob=rollback/ze-bgp-*.conf:contains=router-id 2.2.2.2
