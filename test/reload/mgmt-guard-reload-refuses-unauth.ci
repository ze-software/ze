# Test: SIGHUP refuses a reload that would expose a rebuilt listener
# VALIDATES: spec-fixit-mgmt-listener-auth-guard-deferred-reload-auth-rebuild
# AC-3 -- the exposure guard is re-run over the authentication the reload
# PRODUCES, not the one the server was constructed with. The daemon starts with
# an authenticated REST listener on loopback. The reloaded config removes the
# token AND moves the listener to 0.0.0.0, so the pair the reload would produce
# is non-loopback and unauthenticated. The whole reload is refused before any
# listener rebinds, and the credentials the reload had already installed are put
# back: the listener still answers 401 without a bearer and 200 with the token
# it booted on.
# PREVENTS: classifying on the BOOT record. That record says "authenticated",
# because that is what the server was when it started, so the guard would wave
# the migration through and publish a listener that gates nothing.

stdin=peer:terminator=EOF_PEER
option=tcp_connections:value=1
option=timeout:value=30s
expect=bgp:conn=1:seq=1:hex=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00170200000000
EOF_PEER


# Post-SIGHUP config: the token is gone and REST is asked for 0.0.0.0. Either
# half alone is allowed; together they are the pair the guard refuses.
tmpfs=config2.conf:terminator=EOF_CONF2
plugin {
	external mgmt-refuses-unauth-test {
		run "ze-test fixture reload/mgmt-guard-reload-refuses-unauth $PORT2"
		encoder json
	}
}

environment {
	api-server {
		rest {
			enabled true
			server main {
				ip 0.0.0.0
				port $PORT2
			}
		}
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF2


stdin=ze-conf:terminator=EOF_CONF
plugin {
	external mgmt-refuses-unauth-test {
		run "ze-test fixture reload/mgmt-guard-reload-refuses-unauth $PORT2"
		encoder json
	}
}

environment {
	api-server {
		token "boot-token"
		rest {
			enabled true
			server main {
				ip 127.0.0.1
				port $PORT2
			}
		}
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 1
				remote 1
			}
			router-id 1.2.3.4
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

cmd=background:seq=1:exec=ze-peer --port $PORT:stdin=peer
cmd=background:seq=2:exec=ze-test fixture reload/mgmt-guard-reload-refuses-unauth-trigger
cmd=foreground:seq=3:exec=ze -:stdin=ze-conf:timeout=30s
expect=exit:code=0
expect=stderr:contains=listener migration: rest listener
expect=stderr:contains=cannot serve a non-loopback address without authentication
