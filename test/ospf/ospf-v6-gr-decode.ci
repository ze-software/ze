# OSPFv3 Grace-LSA decode: LS Type 0x000B + LS ID = Interface ID + two TLVs round-trip
#
# VALIDATES: OSPF Graceful Restart (spec-ospf-ext-9, RFC 3623 / RFC 5187) via the runner.
# PREVENTS: a GR behavior compiling but never exercised end-to-end through the test gate.

cmd=foreground:seq=1:exec=go test -v ./internal/plugins/ospf/v3/packet -run TestGraceLSAv6RoundTrip|TestGraceLSAv6BodyBuild|TestGraceLSAv6TLVRoundTrip -count=1:timeout=90s
expect=exit:code=0
expect=stdout:contains=PASS
