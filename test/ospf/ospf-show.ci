# Test: OSPFv2 show / clear command dispatch through the daemon.
#
# VALIDATES: spec-ospf-13 -- `show ospf` process summary (AC-1) reports router-id,
# ABR status and stub-router (max-metric) state (AC-10); the six show lists dispatch
# (AC-2..7); the six database subviews filter by LS type (AC-4); the three clear actions
# return a clearResult (AC-9).
# PREVENTS: package-level CLI tests passing while the ze-show:ospf-* / ze-clear:ospf-*
# command path is not registered or the configured daemon cannot answer it.

# Live FRR/QEMU kernel convergence remains owned by the spec-ospf-13 interop scenarios.
option=needs-linux:caps=net-admin
# OSPFv2 opens raw proto-89 sockets on eth0/eth1 and reads their IPv4 for the
# multicast join; provision the dummy links inside the per-test netns.
option=netns-link:name=eth0:address=10.0.1.1/24
option=netns-link:name=eth1:address=10.0.2.1/24

tmpfs=ospf-show.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
"""Assert OSPF show/clear commands dispatch through the daemon command path."""

import sys

from ze_api import API, runtime_fail, result_json_data, result_text_data


def dispatch(api, command):
    resp = api._call_engine(
        'ze-plugin-engine:dispatch-command', {'command': command})
    if resp is None:
        return {'status': 'error', 'data': 'engine call returned None'}
    return resp.get('result', {})


def assert_done(api, command):
    result = dispatch(api, command)
    if result.get('status') != 'done':
        runtime_fail(
            f"{command}: expected done, got status={result.get('status')} "
            f"data={result_text_data(result)[:200]}")
    return result


def assert_list(api, command):
    data = result_json_data(assert_done(api, command), None)
    if data is None:
        data = []
    if not isinstance(data, list):
        runtime_fail(f"{command}: expected list, got {data!r}")
    return data


def assert_dict(api, command):
    data = result_json_data(assert_done(api, command), None)
    if not isinstance(data, dict):
        runtime_fail(f"{command}: expected dict, got {data!r}")
    return data


def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()
    api.wait_for_post_startup(timeout=5.0)

    # AC-1 / AC-10: process summary reflects router-id, ABR (two attached areas) and the
    # configured stub-router (max-metric router-lsa always).
    summary = assert_dict(api, 'show ospf')
    if summary.get('router-id') != '10.0.0.1':
        runtime_fail(f"show ospf: router-id = {summary.get('router-id')!r}")
    if not summary.get('abr'):
        runtime_fail(f"show ospf: expected abr=true for two areas, got {summary!r}")
    stub = summary.get('stub-router') or {}
    if not stub.get('always') or not stub.get('active'):
        runtime_fail(f"show ospf: expected stub-router always/active, got {stub!r}")

    # AC-2..7: the six show lists dispatch.
    for cmd in (
        'show ospf neighbor',
        'show ospf interface',
        'show ospf database',
        'show ospf route',
        'show ospf border-routers',
        'show ospf spf',
    ):
        assert_list(api, cmd)

    # AC-4: the six per-LS-type database subviews dispatch.
    for cmd in (
        'show ospf database router',
        'show ospf database network',
        'show ospf database summary',
        'show ospf database asbr-summary',
        'show ospf database external',
        'show ospf database nssa-external',
    ):
        assert_list(api, cmd)

    # AC-9: the three clear actions return a clearResult.
    for cmd in (
        'clear ospf process',
        'clear ospf neighbor',
        'clear ospf counters',
    ):
        res = assert_dict(api, cmd)
        if res.get('action') != cmd:
            runtime_fail(f"{cmd}: action = {res.get('action')!r}")

    print('OK: OSPF show/clear dispatch OK', file=sys.stderr)

    dispatch(api, 'request shutdown')
    api.wait_for_shutdown()


if __name__ == '__main__':
    main()
EOF_RUN

stdin=ze-conf:terminator=EOF_CONF
plugin {
	external ospf-show {
		run ./ospf-show.run
		encoder json
	}
}

ospf {
	router-id 10.0.0.1
	max-metric {
		router-lsa {
			always true
		}
	}
	areas {
		area 0.0.0.0 {
			area-type normal
		}
		area 0.0.0.1 {
			area-type normal
		}
	}
	interfaces {
		interface eth0 {
			area 0.0.0.0
		}
		interface eth1 {
			area 0.0.0.1
		}
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65000
			}
			router-id 10.0.0.1
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
		process ospf-show {
		}
	}
}
EOF_CONF

cmd=foreground:seq=1:exec=ze -:stdin=ze-conf:timeout=15s
expect=exit:code=0
expect=stderr:contains=OSPF show/clear dispatch OK
reject=stderr:pattern=engine idle
reject=stderr:pattern=panic
reject=stderr:pattern=fatal error
