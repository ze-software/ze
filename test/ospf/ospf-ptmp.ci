# Test: OSPFv2 point-to-multipoint interface at runtime (spec-ospf-ext-8).
#
# VALIDATES: the daemon starts a point-to-multipoint interface, it enters the
# point-to-point ISM state with no DR/BDR elected, and `show ospf interface`
# reports network type point-to-multipoint.
# PREVENTS: a PtMP interface being parsed but taking the broadcast (Waiting/DR)
# ISM path, or the show snapshot not surfacing the new network type.
#
# PLATFORM: needs-linux:caps=net-admin -- an active point-to-multipoint interface
# needs a real link with an IPv4 address (OSPF binds a raw proto-89 socket and
# reads the interface IPv4 for its multicast join), provisioned in the per-test netns.
option=needs-linux:caps=net-admin
option=netns-link:name=ptmp0:address=10.0.0.1/24


stdin=ze-conf:terminator=EOF_CONF
plugin {
	external ospf-ptmp {
		run "ze-test fixture ospf/ospf-ptmp"
		encoder json
	}
}

ospf {
	router-id 10.0.0.1
	areas {
		area 0.0.0.0 { }
	}
	interfaces {
		interface ptmp0 {
			area 0.0.0.0
			network-type point-to-multipoint
		}
	}
}

bgp {
	peer peer1 {
		connection {
			remote { ip 127.0.0.1; }
			local { ip 127.0.0.1; accept false; }
		}
		session {
			asn { local 65000; remote 65000; }
			router-id 10.0.0.1
			family { ipv4/unicast { prefix { maximum 10000; } } }
			capability { graceful-restart disable; }
		}
		behavior { group-updates disable; }
	}
}
EOF_CONF

cmd=foreground:seq=1:exec=ze -:stdin=ze-conf:timeout=15s
expect=exit:code=0
expect=stderr:contains=OSPF point-to-multipoint interface renders with no DR
reject=stderr:pattern=panic
reject=stderr:pattern=fatal error
