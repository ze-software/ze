# Test: OSPFv2 point-to-multipoint interface at runtime (spec-ospf-ext-8).
#
# VALIDATES: the daemon starts a point-to-multipoint interface, it enters the
# point-to-point ISM state with no DR/BDR elected, and `show ospf interface`
# reports network type point-to-multipoint.
# PREVENTS: a PtMP interface being parsed but taking the broadcast (Waiting/DR)
# ISM path, or the show snapshot not surfacing the new network type.
#
# PLATFORM: needs-linux:caps=net-admin -- an active point-to-multipoint interface
# needs a real link with an IPv4 address (OSPF binds a raw proto-89 socket and
# reads the interface IPv4 for its multicast join), provisioned in the per-test netns.
option=needs-linux:caps=net-admin
option=netns-link:name=ptmp0:address=10.0.0.1/24

tmpfs=ospf-ptmp.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
"""Assert the runtime OSPF point-to-multipoint interface snapshot."""

import sys

from ze_api import API, runtime_fail, result_json_data, result_text_data


def dispatch(api, command):
    resp = api._call_engine(
        'ze-plugin-engine:dispatch-command', {'command': command})
    if resp is None:
        return {'status': 'error', 'data': 'engine call returned None'}
    return resp.get('result', {})


def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()
    api.wait_for_post_startup(timeout=5.0)

    result = dispatch(api, 'show ospf interface')
    if result.get('status') != 'done':
        runtime_fail(
            f"show ospf interface: status={result.get('status')} "
            f"data={result_text_data(result)[:200]}")
    rows = result_json_data(result, None)
    if not isinstance(rows, list):
        runtime_fail(f"show ospf interface: expected list, got {rows!r}")

    by_name = {row.get('name'): row for row in rows if isinstance(row, dict)}
    row = by_name.get('ptmp0')
    if row is None:
        runtime_fail(f"missing ptmp0 in {rows!r}")
    if row.get('network_type') != 'point-to-multipoint':
        runtime_fail(f"ptmp0 network_type = {row.get('network_type')!r}, want point-to-multipoint")
    # Point-to-multipoint takes the point-to-point ISM branch: no DR/BDR election.
    if row.get('state') not in ('point-to-point', 'down'):
        runtime_fail(f"ptmp0 state = {row.get('state')!r}, want point-to-point")
    if row.get('dr') not in ('', '0.0.0.0'):
        runtime_fail(f"ptmp0 elected a DR {row.get('dr')!r}; PtMP has no DR")

    print('OK: OSPF point-to-multipoint interface renders with no DR', file=sys.stderr)
    dispatch(api, 'request shutdown')
    api.wait_for_shutdown()


if __name__ == '__main__':
    main()
EOF_RUN

stdin=ze-conf:terminator=EOF_CONF
plugin {
	external ospf-ptmp {
		run ./ospf-ptmp.run
		encoder json
	}
}

ospf {
	router-id 10.0.0.1
	areas {
		area 0.0.0.0 { }
	}
	interfaces {
		interface ptmp0 {
			area 0.0.0.0
			network-type point-to-multipoint
		}
	}
}

bgp {
	peer peer1 {
		connection {
			remote { ip 127.0.0.1; }
			local { ip 127.0.0.1; accept false; }
		}
		session {
			asn { local 65000; remote 65000; }
			router-id 10.0.0.1
			family { ipv4/unicast { prefix { maximum 10000; } } }
			capability { graceful-restart disable; }
		}
		behavior { group-updates disable; }
		process ospf-ptmp { }
	}
}
EOF_CONF

cmd=foreground:seq=1:exec=ze -:stdin=ze-conf:timeout=15s
expect=exit:code=0
expect=stderr:contains=OSPF point-to-multipoint interface renders with no DR
reject=stderr:pattern=panic
reject=stderr:pattern=fatal error
