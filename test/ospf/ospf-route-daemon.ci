# Test: OSPFv2 route daemon wiring.
#
# VALIDATES: spec-ospf-8-spf-rib -- the real OSPF plugin boots with a top-level
# `ospf { ... }` config, `show ospf route` is wired, and no route is fabricated
# when the node has no adjacency.
# PREVENTS: unwired route snapshot handlers and phantom SPF routes with no peer.

# The live multi-node route add, ECMP, and withdraw kernel assertions are owned by
# spec-ospf-13 FRR/QEMU interop, matching the IS-IS SPF/RIB functional split.
option=skip-os:value=darwin

tmpfs=ospf-route.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
"""Assert `show ospf route` is empty with no adjacency (no phantom routes)."""

import sys

from ze_api import API, runtime_fail, result_json_data, result_text_data


def dispatch(api, command):
    resp = api._call_engine(
        'ze-plugin-engine:dispatch-command', {'command': command})
    if resp is None:
        return {'status': 'error', 'data': 'engine call returned None'}
    return resp.get('result', {})


def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()
    api.wait_for_post_startup(timeout=5.0)

    r = dispatch(api, 'show ospf route')
    if r.get('status') != 'done':
        runtime_fail(
            f"show ospf route: expected done, got status={r.get('status')} "
            f"data={result_text_data(r)[:200]}")
    routes = result_json_data(r, None)
    if routes is None:
        routes = []
    if not isinstance(routes, list):
        runtime_fail(f"show ospf route: expected list, got {routes!r}")
    if routes:
        runtime_fail(f"show ospf route: expected empty list (no peer), got {routes!r}")

    print('OK: OSPF route table empty with no adjacency (SPF wired, no phantom routes)',
          file=sys.stderr)

    dispatch(api, 'request shutdown')
    api.wait_for_shutdown()


if __name__ == '__main__':
    main()
EOF_RUN

stdin=ze-conf:terminator=EOF_CONF
plugin {
	external ospf-route {
		run ./ospf-route.run
		encoder json
	}
}

ospf {
	router-id 10.0.0.1
	areas {
		area 0.0.0.0 {
			area-type normal
		}
	}
	interfaces {
		interface lo {
			area 0.0.0.0
			network-type loopback
			passive true
		}
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65000
			}
			router-id 10.0.0.1
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

cmd=foreground:seq=1:exec=ze -:stdin=ze-conf:timeout=15s
expect=exit:code=0
expect=stderr:contains=OSPF route table empty with no adjacency
reject=stderr:pattern=engine idle
reject=stderr:pattern=panic
reject=stderr:pattern=fatal error
