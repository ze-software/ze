# Test: `show ospf ldp-sync` reports per-interface LDP-IGP sync state.
#
# VALIDATES: spec-ospf-ext-11 AC-1 + AC-13 -- an ldp-sync interface that has no LDP
# session is reported by `show ospf ldp-sync` as not-synchronized with the effective
# Router-LSA metric forced to LSInfinity (65535). Uses a passive point-to-point
# interface so the test needs no raw socket / real device (the LDP-sync machine is
# created for every enrolled ldp-sync interface, active or passive).
# PREVENTS: the show command not dispatching, or an ldp-sync interface not being
# costed out while LDP is not yet synchronized.

# External-plugin daemon test: the ospf suite does not provision the hub TLS
# acceptor natively, so this runs in the full CI / QEMU environment (mirrors
# ospf-show.ci). The state-machine logic itself is covered natively by the
# ospf/lsdb/spf unit tests.
option=skip-os:value=darwin

tmpfs=ospf-ldp-sync-show.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
"""Assert `show ospf ldp-sync` reports an ldp-sync interface not-synchronized."""

import sys

from ze_api import API, runtime_fail, result_json_data


def dispatch(api, command):
    resp = api._call_engine(
        'ze-plugin-engine:dispatch-command', {'command': command})
    if resp is None:
        return {'status': 'error', 'data': 'engine call returned None'}
    return resp.get('result', {})


def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()
    api.wait_for_post_startup(timeout=5.0)

    result = dispatch(api, 'show ospf ldp-sync')
    if result.get('status') != 'done':
        runtime_fail(f"show ospf ldp-sync: status={result.get('status')}")
    rows = result_json_data(result, None) or []
    by_iface = {r.get('interface'): r for r in rows if isinstance(r, dict)}
    if 'eth0' not in by_iface:
        runtime_fail(f"show ospf ldp-sync: eth0 missing, got {rows!r}")
    row = by_iface['eth0']
    if row.get('state') != 'not-synchronized':
        runtime_fail(f"eth0 state = {row.get('state')!r}, want not-synchronized")
    if row.get('effective-metric') != 65535:
        runtime_fail(f"eth0 effective-metric = {row.get('effective-metric')!r}, want 65535 (LSInfinity)")

    print('OK: show ospf ldp-sync reports not-synchronized/LSInfinity', file=sys.stderr)

    dispatch(api, 'request shutdown')
    api.wait_for_shutdown()


if __name__ == '__main__':
    main()
EOF_RUN

stdin=ze-conf:terminator=EOF_CONF
plugin {
	external ospf-ldp-sync-show {
		run ./ospf-ldp-sync-show.run
		encoder json
	}
}

ospf {
	router-id 10.0.0.1
	areas {
		area 0.0.0.0 {
			area-type normal
		}
	}
	interfaces {
		interface eth0 {
			area 0.0.0.0
			network-type point-to-point
			passive true
			cost 100
			ldp-sync {
				enable true
				holddown 30
			}
		}
	}
}
EOF_CONF

# 60s to match the rest of test/ospf. A harness backstop, not a behavioural
# deadline: this test's assertions are the show-output checks below, none of
# which is a wall-clock bound.
cmd=foreground:seq=1:exec=ze -:stdin=ze-conf:timeout=60s
expect=exit:code=0
expect=stderr:contains=show ospf ldp-sync reports not-synchronized/LSInfinity
reject=stderr:pattern=panic
reject=stderr:pattern=fatal error
