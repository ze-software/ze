# Test: IPv4 route over OSPFv3 originates on the IPv4-unicast instance (spec-ospf-ext-15).
#
# VALIDATES: spec-ospf-ext-15 AC-8/AC-13 -- with an IPv4-unicast-over-OSPFv3 instance
# (Instance ID 64) configured and IPv4 redistribution enabled, the daemon runs the
# IPv4-unicast AF engine so a redistributed IPv4 prefix originates an OSPFv3 AS-External-LSA
# on that instance (and, in the interop scenario, installs into the IPv4 FIB on the peer).
# PREVENTS: the IPv4-over-OSPFv3 instance not starting, or IPv4 redistribution being routed
# to the IPv6-unicast instance instead of the IPv4-unicast one.

# Raw IPv6 sockets + FIB install are Linux-only; the peer-side route install is proven by
# the ospf-multiaf-v4-frr interop scenario. This single-node smoke test runs under QEMU
# (authored-pending-QEMU).
option=needs-linux:caps=net-admin
# OSPFv3 opens a raw proto-89 socket on eth1 (IPv6 link-local, auto on link-up);
# provision the dummy link inside the per-test netns.
option=netns-link:name=eth1


stdin=ze-conf:terminator=EOF_CONF
plugin {
	external ospf-multiaf-v4-route {
		run "ze-test fixture ospf/ospf-multiaf-v4-route"
		encoder json
	}
}

ospf {
	router-id 10.0.0.1
	address-family {
		ipv4-unicast {
			instance-id 64
			areas {
				area 0.0.0.0 {
					area-type normal
				}
			}
			interfaces {
				interface eth1 {
					area 0.0.0.0
					network-type point-to-point
				}
			}
		}
	}
	redistribute connected {
		metric 20
		metric-type type-2
	}
}
EOF_CONF

cmd=foreground:seq=1:exec=ze -:stdin=ze-conf:timeout=15s
expect=exit:code=0
expect=stderr:contains=OK: IPv4-unicast-over-OSPFv3 instance running for redistribution
