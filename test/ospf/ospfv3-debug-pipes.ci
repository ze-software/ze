# Test: OSPFv3 new commands honour all pipe operators.
#
# VALIDATES: spec-ospf-ext-14 -- every new IPv6 command's snapshot marshals to JSON so ApplyPipes can render all operators (AC-19).
# PREVENTS: a regression in the OSPF debug/introspection surface.
#
# Live FRR/QEMU multicast convergence is owned by the ospf-debug-*-frr interop scenarios.

cmd=foreground:seq=1:exec=go test -v ./internal/plugins/ospf -run TestV3NewCommandsPipeComplete -count=1:timeout=60s
expect=exit:code=0
expect=stdout:contains=TestV3NewCommandsPipeComplete
expect=stdout:contains=PASS
