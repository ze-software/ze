# Test: adding/removing an OSPFv3 address family starts/stops its engine (spec-ospf-ext-15).
#
# VALIDATES: spec-ospf-ext-15 AC-12 -- a config that adds an OSPFv3 address family brings up
# its engine; the other AF is unaffected. (Runtime removal + clean shutdown of a removed AF's
# engine is proven at the unit level by TestAFReconcileAddRemove; this daemon test confirms
# the add path end-to-end.)
# PREVENTS: an added AF never opening its instance, or one AF's engine disturbing another.

# Raw IPv6 sockets are Linux-only; runs under QEMU (authored-pending-QEMU).
option=needs-linux:caps=net-admin
# OSPFv3 opens raw proto-89 sockets on eth0/eth1 (IPv6 link-local, auto on link-up);
# provision the dummy links inside the per-test netns.
option=netns-link:name=eth0
option=netns-link:name=eth1


stdin=ze-conf:terminator=EOF_CONF
plugin {
	external ospf-multiaf-reconcile {
		run "ze-test fixture ospf/ospf-multiaf-reconcile"
		encoder json
	}
}

ospf {
	router-id 10.0.0.1
	address-family {
		ipv6-unicast {
			instance-id 0
			areas {
				area 0.0.0.0 {
					area-type normal
				}
			}
			interfaces {
				interface eth0 {
					area 0.0.0.0
					network-type point-to-point
				}
			}
		}
		ipv4-unicast {
			instance-id 64
			areas {
				area 0.0.0.0 {
					area-type normal
				}
			}
			interfaces {
				interface eth1 {
					area 0.0.0.0
					network-type point-to-point
				}
			}
		}
	}
}
EOF_CONF

cmd=foreground:seq=1:exec=ze -:stdin=ze-conf:timeout=15s
expect=exit:code=0
expect=stderr:contains=OK: added OSPFv3 address family engine is up
