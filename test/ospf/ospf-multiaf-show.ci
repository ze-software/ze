# Test: OSPFv3 multi-AF show identifies each address-family instance (spec-ospf-ext-15).
#
# VALIDATES: spec-ospf-ext-15 AC-10 -- `show ospf ipv6` lists every configured OSPFv3
# address-family instance with its address family and Instance ID (RFC 5838 §2 debugging
# requirement), so multiple AF instances on a link are distinguishable.
# PREVENTS: the per-AF instances being invisible to the operator, or the show handler not
# being registered on the daemon command path.

# The daemon opens raw IPv6 sockets to run the OSPFv3 engines; darwin lacks that path, so
# this runs under the Linux/QEMU functional harness (authored-pending-QEMU).
option=needs-linux:caps=net-admin
# OSPFv3 opens raw proto-89 sockets on eth0/eth1 (IPv6 link-local, auto on link-up);
# provision the dummy links inside the per-test netns.
option=netns-link:name=eth0
option=netns-link:name=eth1


stdin=ze-conf:terminator=EOF_CONF
plugin {
	external ospf-multiaf-show {
		run "ze-test fixture ospf/ospf-multiaf-show"
		encoder json
	}
}

ospf {
	router-id 10.0.0.1
	address-family {
		ipv6-unicast {
			instance-id 0
			areas {
				area 0.0.0.0 {
					area-type normal
				}
			}
			interfaces {
				interface eth0 {
					area 0.0.0.0
					network-type point-to-point
				}
			}
		}
		ipv4-unicast {
			instance-id 64
			areas {
				area 0.0.0.0 {
					area-type normal
				}
			}
			interfaces {
				interface eth1 {
					area 0.0.0.0
					network-type point-to-point
				}
			}
		}
	}
}
EOF_CONF

cmd=foreground:seq=1:exec=ze -:stdin=ze-conf:timeout=15s
expect=exit:code=0
expect=stderr:contains=OK: show ospf ipv6 identifies both AF instances
