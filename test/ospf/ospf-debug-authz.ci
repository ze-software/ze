# Test: OSPFv2 inject double-gate (authz + debug-enablement).
#
# VALIDATES: spec-ospf-ext-14 -- a read-only user is denied `debug` and a debug-disabled router rejects inject (AC-16/AC-17).
# PREVENTS: a regression in the OSPF debug/introspection surface.
#
# Live FRR/QEMU multicast convergence is owned by the ospf-debug-*-frr interop scenarios.

cmd=foreground:seq=1:exec=go test -v ./internal/component/authz ./internal/plugins/ospf -run 'TestInjectDeniedReadOnly|TestInjectRequiresDebugEnabled' -count=1:timeout=60s
expect=exit:code=0
expect=stdout:contains=TestInjectDeniedReadOnly
expect=stdout:contains=TestInjectRequiresDebugEnabled
expect=stdout:contains=PASS
