# Test: OSPFv2 Multi-Instance set tracks config -- an unconfigured Instance ID is absent
# (spec-ospf-ext-12, RFC 6549).
#
# VALIDATES: the running instance set is exactly the configured set. A config with only the
# base instance (no per-interface instance-id) runs exactly one OSPFv2 engine, and
# `show ospf instance` lists only Instance ID 0 -- no phantom non-zero instance. This is the
# observable contract of the reconcile/teardown path: an Instance ID not in config has no
# engine (and therefore sends no Hellos and holds no neighbors).
# PREVENTS: a regression where a torn-down or never-configured instance keeps an engine.
#
# In-run reload teardown (remove Instance ID 5 from a running config and see its engine,
# Hellos, and neighbors disappear) is covered by the unit test TestInstanceRemovedTearsDown
# and by the QEMU interop scenario; the functional daemon harness applies config once.
# Requires the full daemon and a raw socket, so it does not run on darwin.
option=skip-os:value=darwin


stdin=ze-conf:terminator=EOF_CONF
plugin {
	external ospf-instance-teardown {
		run "ze-test fixture ospf/ospf-instance-teardown"
		encoder json
	}
}

ospf {
	router-id 10.0.0.1
	areas {
		area 0.0.0.0 {
			area-type normal
		}
	}
	interfaces {
		interface eth0 {
			area 0.0.0.0
		}
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65000
			}
			router-id 10.0.0.1
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

cmd=foreground:seq=1:exec=ze -:stdin=ze-conf:timeout=15s
expect=exit:code=0
expect=stderr:contains=OSPF instance set tracks config OK
reject=stderr:pattern=engine idle
reject=stderr:pattern=panic
reject=stderr:pattern=fatal error
