# Test: OSPFv2 ABR inter-area CLI dispatch.
#
# VALIDATES: spec-ospf-9-inter-area-abr -- daemon command path for the new
# border-router and SPF snapshots under a multi-area OSPF config.
# PREVENTS: package-level ABR tests passing while the user-facing command path is
# not registered or the configured multi-area daemon cannot start.

# Live FRR/QEMU kernel convergence remains owned by spec-ospf-13.
option=skip-os:value=darwin

tmpfs=ospf-inter-area-cli.run:mode=755:terminator=EOF_RUN
#!/usr/bin/env python3
"""Assert OSPF ABR show commands dispatch through the daemon command path."""

import sys

from ze_api import API, runtime_fail, result_json_data, result_text_data


def dispatch(api, command):
    resp = api._call_engine(
        'ze-plugin-engine:dispatch-command', {'command': command})
    if resp is None:
        return {'status': 'error', 'data': 'engine call returned None'}
    return resp.get('result', {})


def assert_list(api, command):
    result = dispatch(api, command)
    if result.get('status') != 'done':
        runtime_fail(
            f"{command}: expected done, got status={result.get('status')} "
            f"data={result_text_data(result)[:200]}")
    data = result_json_data(result, None)
    if data is None:
        data = []
    if not isinstance(data, list):
        runtime_fail(f"{command}: expected list, got {data!r}")
    return data


def main():
    api = API()
    api.declare_done()
    api.wait_for_config()
    api.capability_done()
    api.wait_for_registry()
    api.ready()
    api.wait_for_post_startup(timeout=5.0)

    assert_list(api, 'show ospf border-routers')
    assert_list(api, 'show ospf route')
    spf = assert_list(api, 'show ospf spf')
    if len(spf) < 2:
        runtime_fail(f"show ospf spf: expected two configured areas, got {spf!r}")
    print('OK: OSPF inter-area CLI dispatch OK', file=sys.stderr)

    dispatch(api, 'request shutdown')
    api.wait_for_shutdown()


if __name__ == '__main__':
    main()
EOF_RUN

stdin=ze-conf:terminator=EOF_CONF
plugin {
	external ospf-inter-area-cli {
		run ./ospf-inter-area-cli.run
		encoder json
	}
}

ospf {
	router-id 10.0.0.1
	areas {
		area 0.0.0.0 {
			area-type normal
			ranges {
				range 10.0.0.0/8 {
					cost 10
				}
			}
		}
		area 0.0.0.1 {
			area-type normal
		}
	}
}

bgp {
	peer peer1 {
		connection {
			remote {
				ip 127.0.0.1
			}
			local {
				ip 127.0.0.1
				accept false
			}
		}
		session {
			asn {
				local 65000
				remote 65000
			}
			router-id 10.0.0.1
			family {
				ipv4/unicast { prefix { maximum 10000; } }
			}
			capability {
				graceful-restart disable
			}
		}
		behavior {
			group-updates disable
		}
	}
}
EOF_CONF

cmd=foreground:seq=1:exec=ze -:stdin=ze-conf:timeout=15s
expect=exit:code=0
expect=stderr:contains=OSPF inter-area CLI dispatch OK
reject=stderr:pattern=engine idle
reject=stderr:pattern=panic
reject=stderr:pattern=fatal error
