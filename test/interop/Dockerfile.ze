# Multi-stage build for Ze BGP daemon.
# Produces a minimal Alpine image with just the ze binary.

FROM golang:1.26-alpine AS builder

RUN apk add --no-cache git

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .

# ze and ze-test are both cmd/ze selected by build tag (Makefile: bin/ze uses ze_core,
# bin/ze-test uses ze_test). The daemon personality (ze_core_dispatch.go) and the test
# runner (ze_test_register.go) are tag-gated, so an untagged build has neither.
RUN CGO_ENABLED=0 go build -tags ze_core -o /ze ./cmd/ze
RUN CGO_ENABLED=0 go build -tags ze_test -o /ze-test ./cmd/ze

FROM alpine:3.21

RUN apk add --no-cache tini python3

COPY --from=builder /ze /usr/local/bin/ze
COPY --from=builder /ze-test /usr/local/bin/ze-test

# ze_api.py is needed by process plugin scripts that announce routes.
COPY test/scripts/ze_api.py /usr/lib/ze/ze_api.py
ENV PYTHONPATH=/usr/lib/ze

# tini ensures proper signal handling (SIGTERM → ze process).
ENTRYPOINT ["tini", "--", "ze"]
