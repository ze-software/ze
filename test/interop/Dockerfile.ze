# Ze image for the general BGP interop lab.
#
# It expects two pre-built linux binaries, at test/interop/ze-linux and
# test/interop/ze-test-linux, which `./le integration interop` cross-compiles
# before it builds this image (internal/le/interoplab/zebuild.go, StageBinaries,
# declared by internal/le/interoplab/bgp/run.go, LabBinaries). A bare
# `docker build -f test/interop/Dockerfile.ze .` on a clean checkout fails at
# the COPY until that action has run.
#
# The binaries are built rather than compiled here on purpose. A Go compiler and
# linker inside this image was killed by the kernel three times on an idle
# 31 GiB workstation on 2026-09-06, and took 40m39s on a small VM on 2026-09-04.
#
# ze and ze-test are both cmd/ze selected by build tag: the daemon personality
# takes ze_core ze_distro and the test personality takes ze_test. Both also
# carry every gate feature-gates.txt declares, because a personality tag alone
# leaves every compile-out-able feature off and BGP itself is one of them
# (ze_bgp). The producer reads that manifest through internal/le/featuretags, so
# this file names no feature and cannot drift from the shipped binary.

FROM alpine:3.21

# nftables supplies the `nft` CLI. Ze programs the kernel over netlink and needs
# no binary, but a scenario that asserts what reached the KERNEL has no other
# instrument: `show firewall` renders the registry's own record, and the nft
# readback skips every table outside the ze_ ownership prefix
# (internal/plugins/firewall/nft/readback_linux.go).
RUN apk add --no-cache tini nftables

COPY test/interop/ze-linux /usr/local/bin/ze
COPY test/interop/ze-test-linux /usr/local/bin/ze-test

# tini ensures proper signal handling (SIGTERM → ze process).
ENTRYPOINT ["tini", "--", "ze"]
