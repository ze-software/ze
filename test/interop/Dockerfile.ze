# Multi-stage build for Ze BGP daemon.
# Produces a minimal Alpine image with just the ze binary.

FROM golang:1.27-alpine AS builder

RUN apk add --no-cache git

WORKDIR /src
COPY . .

# ze and ze-test are both cmd/ze selected by build tag. The daemon personality
# uses ze_core and the test personality uses ze_test; an untagged build has
# neither registration set.
#
# The personality tag alone is NOT enough: every compile-out-able feature is off
# unless its tag is passed, and BGP itself is one of them (feature-gates.txt,
# ze_bgp). A `-tags ze_core` image rejects the `bgp` config root as an unknown
# top-level keyword, so both interop and perf would test a daemon with no BGP.
# The native interop runner derives the feature set from feature-gates.txt and
# passes it as one build argument. The image build never parses the manifest.
ARG ZE_FEATURES
RUN CGO_ENABLED=0 go build -mod=vendor -tags "ze_core ze_distro $ZE_FEATURES" -o /ze ./cmd/ze && \
    CGO_ENABLED=0 go build -mod=vendor -tags "ze_test $ZE_FEATURES" -o /ze-test ./cmd/ze

FROM alpine:3.21

# nftables supplies the `nft` CLI. Ze programs the kernel over netlink and needs
# no binary, but a scenario that asserts what reached the KERNEL has no other
# instrument: `show firewall` renders the registry's own record, and the nft
# readback skips every table outside the ze_ ownership prefix
# (internal/plugins/firewall/nft/readback_linux.go).
RUN apk add --no-cache tini nftables

COPY --from=builder /ze /usr/local/bin/ze
COPY --from=builder /ze-test /usr/local/bin/ze-test


# tini ensures proper signal handling (SIGTERM → ze process).
ENTRYPOINT ["tini", "--", "ze"]
