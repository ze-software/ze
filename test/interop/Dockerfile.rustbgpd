# rustbgpd daemon for performance testing.
# Builds the latest stable release tag from GitHub source.
# v0.81.0 declares rust-version 1.95.

FROM rust:1.99.1-trixie AS builder

RUN apt-get update && apt-get install -y protobuf-compiler && rm -rf /var/lib/apt/lists/*

# Upstream's release profile, unchanged (fat LTO, one codegen unit). Its link
# needs about 16 GB in the Docker VM. Only the daemon binary is built, the one
# artifact copied out.
WORKDIR /src
RUN git clone --depth 1 --branch v0.81.0 https://github.com/lance0/rustbgpd.git . && \
    cargo build --release --locked -p rustbgpd --bin rustbgpd

FROM debian:trixie-slim

RUN apt-get update && apt-get install -y --no-install-recommends tini && rm -rf /var/lib/apt/lists/*

COPY --from=builder /src/target/release/rustbgpd /usr/local/bin/rustbgpd

ENTRYPOINT ["tini", "--", "rustbgpd"]
CMD ["/etc/rustbgpd/config.toml"]
