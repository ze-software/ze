# freeRtr BGP daemon for performance testing.
# Builds the launcher from the Ze context and freeRtr from the named `freertr` context.
#
# freeRtr has its own TCP/IP stack -- rawInt.bin bridges the Docker
# network interface to freeRtr's virtual interface layer via UDP.

FROM eclipse-temurin:21-jdk-alpine AS java-builder
WORKDIR /build
COPY --from=freertr /src/compiler.txt /src/manifest.txt /src/module-info.java src/
COPY --from=freertr /src/org/ src/org/
RUN cd src && javac @compiler.txt && \
    cd /build/binOut && \
    jar -cmf /build/src/manifest.txt /build/rtr.jar .

FROM alpine:3.21 AS native-builder
RUN apk add --no-cache gcc musl-dev linux-headers
WORKDIR /build
COPY --from=freertr /misc/native/rawInt.c /misc/native/utils.h ./
RUN gcc -O3 -Wall -o rawInt.bin rawInt.c -lpthread && strip rawInt.bin

FROM golang:1.26-alpine AS fixture-builder
WORKDIR /src
COPY tools/freertr-entrypoint/main.go .
RUN CGO_ENABLED=0 go build -o /freertr-entrypoint main.go

FROM eclipse-temurin:21-jre-alpine

RUN apk add --no-cache tini iproute2 iptables ethtool

COPY --from=java-builder /build/rtr.jar /opt/freertr/rtr.jar
COPY --from=native-builder /build/rawInt.bin /opt/freertr/rawInt.bin
COPY --from=fixture-builder /freertr-entrypoint /opt/freertr/entrypoint

# The compiled launcher bridges eth0 to freeRtr's virtual interface via rawInt.
# It starts freeRtr first, waits for TCP port 2323, flushes the kernel address,
# configures the interface, and then starts rawInt. It forwards termination to
# both children and fails if either exits unexpectedly.

ENTRYPOINT ["tini", "--"]
CMD ["/opt/freertr/entrypoint"]
