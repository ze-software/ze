# StayRTR: Cloudflare's RTR server (RFC 8210), the cache side of RPKI origin
# validation, for interoperability testing.
#
# WHY A THIRD-PARTY CACHE. Ze is the RTR CLIENT in production and was the RTR
# SERVER in every test that exercised the protocol: scenario rpki-frr runs
# `le mock rpki` and 25 functional tests run `le mock rtr`, both of them
# Ze's own Go. A disagreement between Ze's encoder and Ze's decoder is invisible
# to a codec that round-trips against itself, and the disagreement fails OPEN:
# a prefix whose VRP was mis-decoded reads NotFound, NotFound is accepted, and
# the operator sees a working router that validates nothing.
#
# StayRTR is the reference RTR server most operators run, it is fed by a static
# VRP file rather than by a live RPKI trust anchor fetch, and that file is what
# a scenario writes. Routinator would need the trust anchors and an rsync/RRDP
# fetch to produce any VRP at all, which makes the cache content depend on the
# public repository rather than on the scenario.
#
# Pinned by version, not by `latest`: an image whose payload changes under the
# test turns an interop verdict into a moving target.

FROM golang:1.27-alpine3.24 AS builder

# The release source, fetched through the module proxy and checked against the
# checksum database, then patched before the build.
#
# THE PATCH. StayRTR v0.6.4 speaks RTR versions 0 and 1, so it refuses Ze's
# first query, which asks for version 2. It refuses by queueing an Error Report
# (Error Code 4, Unsupported Protocol Version) on the client's transmit channel
# and cancelling the client's context at once (lib/server.go, checkVersion,
# SendWrongVersionError, Disconnect). Its sendLoop then selects between the
# queued PDU and the cancel, and Go picks at random among ready cases, so the
# Error Report is sometimes never written and Ze reads a bare close.
# draft-ietf-sidrops-8210bis Section 7 says the cache "MUST send an Error Report
# PDU with Protocol Version C and Error Code 4". With no Error Report there is
# no version for Ze to retry at, so the attempt fails, and RFC 8210 Section 6
# has Ze wait the default Retry Interval of 600 seconds before it asks that
# cache again, as BIRD's proto/rpki and rtrlib also do. Observed in
# rtr-stayrtr-preference: the standby cache's first contact read "read header:
# EOF" with one connection in StayRTR's log, and the scenario timed out. The
# patch has sendLoop write what is already queued before it returns.
COPY <<'EOF' /stayrtr-send-queued-before-close.patch
--- a/lib/server.go
+++ b/lib/server.go
@@ -759,7 +759,16 @@
 		select {
 		case pdu := <-c.transmits:
 			c.wr.Write(pdu.Bytes())
 		case <-ctx.Done():
-			return ctx.Err()
+			// Write what was queued before the cancel, so an Error Report
+			// queued just before Disconnect reaches the client.
+			for {
+				select {
+				case pdu := <-c.transmits:
+					c.wr.Write(pdu.Bytes())
+				default:
+					return ctx.Err()
+				}
+			}
 		}
 	}
EOF

RUN set -eu; \
    apk add --no-cache patch; \
    module=$(go mod download -json github.com/bgp/stayrtr@v0.6.4 | sed -n 's/^[[:space:]]*"Dir": "\(.*\)",$/\1/p'); \
    cp -R "$module" /src; \
    chmod -R u+w /src; \
    cd /src; \
    patch -p1 < /stayrtr-send-queued-before-close.patch; \
    go build -o /go/bin/stayrtr ./cmd/stayrtr

FROM alpine:3.24.3

RUN apk add --no-cache tini

COPY --from=builder /go/bin/stayrtr /usr/local/bin/stayrtr

# The scenario mounts its VRP file at /vrps.json. `-checktime=false` because
# that file carries no signed validity window: with the default the cache
# refuses its own input and serves an empty set, which would make every prefix
# read NotFound for a reason that has nothing to do with Ze.
# Pin the served protocol before the first query. In v0.6.4 the default
# negotiation path reports version 0 when it rejects Ze's initial v2 query.
# Enforcing v1 makes that Error Report advertise the supported v1 instead.
# `-refresh` is how often StayRTR re-reads /vrps.json. The RTR timers it sends
# Ze in End of Data are `-rtr.refresh` and `-rtr.retry` (defaults 3600 and 600
# seconds): set to 10, so a client polls every 10 seconds and retries a failed
# cache after 10, which is what makes failover and fail-back between two caches
# (rtr-stayrtr-preference) observable inside a checker's wait.
ENTRYPOINT ["tini", "--", "stayrtr"]
CMD ["-bind", ":8282", "-cache", "/vrps.json", "-checktime=false", "-refresh", "10", "-rtr.refresh", "10", "-rtr.retry", "10", "-protocol", "1", "-enforce.version=true"]
