# RustyBGP daemon for performance testing.
# Builds the latest release tag, v0.2.0, from GitHub source using musl for
# static linking (a pinned release, never moving master).

FROM rust:1.99.1-alpine3.24 AS builder

RUN apk add --no-cache musl-dev protobuf-dev git make

WORKDIR /src
RUN git clone --depth 1 --branch v0.2.0 https://github.com/osrg/rustybgp.git . && \
    cargo build --release

FROM alpine:3.24.3

RUN apk add --no-cache tini

COPY --from=builder /src/target/release/rustybgpd /usr/local/bin/rustybgpd

ENTRYPOINT ["tini", "--", "rustybgpd"]
CMD ["-f", "/etc/rustybgp/config.toml"]
