# Kea DHCPv6 server (kea-dhcp6) for interoperability testing of ze's DHCPv6
# client.
#
# Kea is built from the upstream 3.2.1 release, because owner decision
# (ai/META-DECISIONS.md) has every lab peer run its latest stable release and
# Alpine 3.24 packages 3.0.3. The build uses the paths of the Alpine package:
# configuration under /etc/kea, the memfile lease database and the server DUID
# under /var/lib/kea, the pid file under /run/kea.
#
# Kea 3 refuses a lease file, a control socket, a log file or a hook library
# outside its own directories. The scenario configurations name none of them:
# the memfile database takes its default name in /var/lib/kea and every logger
# writes to stdout, so they parse unchanged (`kea-dhcp6 -t`). Where a scenario
# later needs one, it lives in the directory Kea expects.
#
# iproute2 is present so a checker can read the container's interface state
# over `docker exec`. tini forwards the SIGTERM that stops the server.
#
# Every start deletes the persisted server DUID, so Kea generates a new one: a
# checker that stops and starts the container changes the server's identity
# while the memfile lease database, which lives in the container and not in a
# mount, keeps the lease. The pid file is removed too, because the container's
# file system outlives the process that wrote it.
#
# The lab mounts the scenario's configuration read-only at
# /etc/kea/kea-dhcp6.conf. Every start copies it to /run/kea/kea-dhcp6.conf and
# runs Kea on the copy, because SIGHUP makes Kea re-read the file it started
# with: a checker that changes the server's configuration under a running
# lease writes the copy and sends SIGHUP.

FROM alpine:3.24.3 AS build

# sha256 of the upstream release tarball, taken 2026-10-22.
ARG KEA_VERSION=3.2.1
ARG KEA_SHA256=3478220be62b3aa361a2c7f97d5d2989b934f7864e82d4bd17056e1e208b9735

RUN apk add --no-cache boost-dev build-base curl log4cplus-dev meson openssl-dev python3 scanelf

WORKDIR /src
RUN curl -fsSL -o kea.tar.xz "https://downloads.isc.org/isc/kea/${KEA_VERSION}/kea-${KEA_VERSION}.tar.xz" \
    && echo "${KEA_SHA256}  kea.tar.xz" | sha256sum -c - \
    && tar -xJf kea.tar.xz --strip-components=1 \
    && meson setup build --prefix=/usr --sysconfdir=/etc --localstatedir=/var \
        -Drunstatedir=run -Dcrypto=openssl -Dkrb5=disabled -Dmysql=disabled \
        -Dnetconf=disabled -Dpostgresql=disabled \
    && meson compile -C build \
    && meson install -C build --destdir /out \
    && rm -rf /out/usr/include /out/usr/share/doc /out/usr/share/man \
    && scanelf --needed --nobanner --format '%n#p' --recursive /out \
        | tr ',' '\n' | sort -u | grep -v '^libkea' | sed 's/^/so:/' > /out/.kea-rundeps

FROM alpine:3.24.3

COPY --from=build /out/ /

# The runtime libraries are the shared objects the installed binaries need,
# read from the binaries by scanelf rather than listed by hand.
RUN apk add --no-cache iproute2 tini $(cat /.kea-rundeps) \
    && rm /.kea-rundeps && mkdir -p /var/lib/kea /run/kea

ENV KEA_LOCKFILE_DIR=none

ENTRYPOINT ["tini", "--", "/bin/sh", "-c", "rm -f /var/lib/kea/kea-dhcp6-serverid /run/kea/*.pid && cp /etc/kea/kea-dhcp6.conf /run/kea/kea-dhcp6.conf && exec kea-dhcp6 -c /run/kea/kea-dhcp6.conf"]
