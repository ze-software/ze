# Kea DHCPv6 server (kea-dhcp6) for interoperability testing of ze's DHCPv6
# client. Alpine ships Kea in its community repository.
#
# iproute2 is present so a checker can read the container's interface state
# over `docker exec`. tini forwards the SIGTERM that stops the server.
#
# Every start deletes the persisted server DUID, so Kea generates a new one: a
# checker that stops and starts the container changes the server's identity
# while the memfile lease database, which lives in the container and not in a
# mount, keeps the lease. The pid file is removed too, because the container's
# file system outlives the process that wrote it.
#
# The lab mounts the scenario's configuration read-only at
# /etc/kea/kea-dhcp6.conf. Every start copies it to /run/kea/kea-dhcp6.conf and
# runs Kea on the copy, because SIGHUP makes Kea re-read the file it started
# with: a checker that changes the server's configuration under a running
# lease writes the copy and sends SIGHUP.

FROM alpine:3.21

RUN apk add --no-cache kea-dhcp6 iproute2 tini && mkdir -p /var/lib/kea /run/kea

ENV KEA_LOCKFILE_DIR=none

ENTRYPOINT ["tini", "--", "/bin/sh", "-c", "rm -f /var/lib/kea/kea-dhcp6-serverid /run/kea/*.pid && cp /etc/kea/kea-dhcp6.conf /run/kea/kea-dhcp6.conf && exec kea-dhcp6 -c /run/kea/kea-dhcp6.conf"]
