; The lab zone. www holds two A records; alias is a CNAME to www; big holds
; thirty TXT records, about 3 KB, so neither a 1232-octet UDP reply from
; Unbound to ze nor one from ze to the client can carry it, and both must
; set TC and be retried over TCP.
$ORIGIN lab.example.
$TTL 300
@       SOA   ns.lab.example. hostmaster.lab.example. 1 3600 600 86400 60
@       NS    ns
ns      A     172.30.0.40
www     A     192.0.2.10
www     A     192.0.2.11
alias   CNAME www
big     TXT   "record-01-0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz0123456789"
big     TXT   "record-02-0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz0123456789"
big     TXT   "record-03-0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz0123456789"
big     TXT   "record-04-0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz0123456789"
big     TXT   "record-05-0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz0123456789"
big     TXT   "record-06-0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz0123456789"
big     TXT   "record-07-0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz0123456789"
big     TXT   "record-08-0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz0123456789"
