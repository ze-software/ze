# FRR daemons for bmp-locrib-receiver-frr.
#
# The one difference from test/interop/daemons is bgpd_options: FRR's BMP
# support is a bgpd MODULE, so `bmp targets` is not a command until bgpd is
# started with -M bmp. Loading it in the shared file would add the module to
# every scenario in the suite for the benefit of this one.
zebra=yes
bgpd=yes
ospfd=no
ospf6d=no
ripd=no
ripngd=no
isisd=no
pimd=no
pim6d=no
ldpd=no
nhrpd=no
eigrpd=no
babeld=no
sharpd=no
pbrd=no
bfdd=no
fabricd=no
vrrpd=no
pathd=no

bgpd_options="  -A 127.0.0.1 -M bmp"
