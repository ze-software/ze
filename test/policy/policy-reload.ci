# Test: Policy change reconciled on config reload.
# VALIDATES: spec-policy-routing AC-8, AC-9 -- config reload removes old
#            policy nftables table and ip rules, applies new config.
# PREVENTS: stale nftables rules or ip rules after config change.
#
# Requires CAP_NET_ADMIN.

option=needs-linux:caps=net-admin

stdin=ze-bgp:terminator=EOF_CONF
firewall {
	backend nft;
}
policy {
	route test-reload {
		interface eth0;
		rule r1 {
			from {
				protocol tcp;
				destination-port 80;
			}
			then {
				accept;
			}
		}
	}
}
EOF_CONF

tmpfs=config2.conf:terminator=EOF_CONF2
firewall {
	backend nft;
}
policy {
	route test-reload {
		interface eth0;
		rule r1 {
			from {
				protocol tcp;
				destination-port 80;
			}
			then {
				drop;
			}
		}
	}
}
EOF_CONF2

option=env:var=ze.log.policy.routes:value=info
option=env:var=ze.log.firewall:value=info

cmd=background:seq=1:exec=ze -:stdin=ze-bgp
cmd=foreground:seq=2:exec=ze-test fixture policy/policy-reload:timeout=15s
expect=exit:code=0
expect=stderr:contains=policy routes applied
expect=stdout:contains=PHASE1_OK
expect=stdout:contains=PHASE2_OK
