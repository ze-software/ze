# Test: next-hop auto-allocates table, adds route, fwmark + ip rule.
# VALIDATES: spec-policy-routing AC-14 -- next-hop action auto-allocates
#            a kernel routing table from 2000-2999, adds a default route
#            via the next-hop, and creates fwmark + ip rule.
# PREVENTS: next-hop parsed but kernel table/route/rule not created.
#
# THE DISCRIMINATING ASSERTION is ROUTE_GET_MARKED. Listing the rule and the
# route back proves both objects exist, and a route sitting in a table no lookup
# reaches reads back exactly like a route that carries traffic. So the fixture
# asks the KERNEL to route a packet carrying the mark: the answer has to be the
# auto route, which puts applyIPRules and applyAutoRoutes both on one result.
# The control is the same lookup without the mark, and the fixture fails the run
# when it resolves.
#
# Requires CAP_NET_ADMIN.

option=needs-linux:caps=net-admin

# The next-hop 10.0.0.1 needs a connected route to resolve. enterTestNetns brings
# up only loopback, so without an interface on 10.0.0.0/24 the auto-route RouteAdd
# fails "network is unreachable". Provision eth1 (the match interface the config
# names) with a same-subnet address inside the per-test netns. Inert off netns
# mode, so the host is never touched.
option=netns-link:name=eth1:address=10.0.0.2/24

stdin=ze-bgp:terminator=EOF_CONF
firewall {
	backend nft;
}
policy {
	route redirect-alt {
		interface eth1;
		rule web-to-alt {
			from {
				destination-port 80,443;
				protocol tcp;
			}
			then {
				next-hop 10.0.0.1;
			}
		}
	}
}
EOF_CONF

option=env:var=ze.log.policy.routes:value=info
option=env:var=ze.log.firewall:value=info

cmd=background:seq=1:exec=ze -:stdin=ze-bgp
cmd=foreground:seq=2:exec=ze-test fixture policy/policy-next-hop:timeout=10s
expect=exit:code=0
expect=stderr:contains=policy routes applied
expect=stdout:contains=table inet ze_pr
expect=stdout:contains=meta mark set
expect=stdout:contains=IP_RULE_AUTO:
expect=stdout:contains=AUTO_ROUTE:
expect=stdout:pattern=ROUTE_GET_MARKED: .*via 10.0.0.1
expect=stdout:contains=ROUTE_GET_CONTROL: unmarked lookup
