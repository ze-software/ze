# Test: "table 100" action creates fwmark + ip rule.
# VALIDATES: spec-policy-routing AC-4 -- "table 100" in then-block produces
#            nftables SetMark action and kernel ip rule mapping fwmark to
#            routing table 100.
# PREVENTS: fwmark or ip rule not created for table action.
#
# THE DISCRIMINATING ASSERTION is ROUTE_GET_MARKED. A rule read back out of
# `ip rule show` proves the rule exists, and a rule the kernel never consults
# reads back exactly the same, so the fixture asks the KERNEL where a packet
# carrying the mark would go. The probe prefix is staged in table 100 and
# nowhere else, and the fixture fails the run when the same lookup without the
# mark resolves too, which is what makes the marked answer mean anything.
#
# Requires CAP_NET_ADMIN.

option=needs-linux:caps=net-admin

stdin=ze-bgp:terminator=EOF_CONF
firewall {
	backend nft;
}
policy {
	route test-table {
		interface eth0;
		rule redirect {
			from {
				destination-port 80,443;
				protocol tcp;
			}
			then {
				table 100;
			}
		}
	}
}
EOF_CONF

option=env:var=ze.log.policy.routes:value=info
option=env:var=ze.log.firewall:value=info

cmd=background:seq=1:exec=ze -:stdin=ze-bgp
cmd=foreground:seq=2:exec=le test fixture policy/policy-set-table:timeout=10s
expect=exit:code=0
expect=stderr:contains=policy routes applied
expect=stdout:contains=table inet ze_pr
expect=stdout:contains=meta mark set
expect=stdout:contains=IP_RULE:
expect=stdout:contains=lookup 100
expect=stdout:pattern=ROUTE_GET_MARKED: .*table 100
expect=stdout:contains=ROUTE_GET_CONTROL: unmarked lookup
