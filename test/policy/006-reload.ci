# Test: Policy change reconciled on config reload.
# VALIDATES: spec-policy-routing AC-8, AC-9 -- config reload removes old
#            policy nftables table and ip rules, applies new config.
# PREVENTS: stale nftables rules or ip rules after config change.
#
# Requires CAP_NET_ADMIN.

option=needs-linux:caps=net-admin

tmpfs=driver.py:mode=755:terminator=EOF_PY
#!/usr/bin/env python3
import os, shutil, signal, subprocess, sys, time
from ze_api import wait_for_daemon_ready, wait_for_output

def nft_table_exists(name):
    try:
        subprocess.check_output(["nft", "list", "table", "inet", name],
                                stderr=subprocess.DEVNULL, text=True)
        return True
    except subprocess.CalledProcessError:
        return False

def rule_lines(dump):
    """The chain's RULE lines only, with the structural lines removed.

    MUST be used for every verdict assertion below. `nft list table` prints the
    base-chain declaration inside the chain body:

        type filter hook prerouting priority mangle; policy accept;

    and that line ALWAYS contains the word "accept", for every possible policy
    config: translate.go hardcodes `Policy: firewall.PolicyAccept` on the ze_pr
    base chain (internal/plugins/policyroute/translate.go:51), which
    lower_linux.go:148 lowers to nftables.ChainPolicyAccept.

    So a naive `"accept" in dump` matches the chain POLICY, never a rule. That
    made both phases wrong in opposite directions and left this test unpassable
    by construction:
      - phase 1's `"accept" not in dump` could never be true, so PHASE1_OK was
        printed even if the accept rule had never been programmed (vacuous);
      - phase 2's `"accept" in dump` was always true, so it failed with "old
        accept rule still present" while the kernel actually held only the new
        `drop` rule -- i.e. the reload had worked correctly all along.
    """
    rules = []
    for line in dump.splitlines():
        s = line.strip()
        if not s or s in ("{", "}"):
            continue
        # `table inet ze_pr {`, `chain prerouting {`, and the `type ...` base-chain
        # declaration are structure, not rules.
        if s.startswith(("table ", "chain ", "type ")):
            continue
        rules.append(s)
    return rules

def wait_rules(predicate):
    """Block until `nft list table inet ze_pr` satisfies predicate(rule_lines).

    Returns as soon as the condition is true, or when DEADLINE passes; every
    assertion below is left to the caller, unchanged, so a genuine failure still
    reports its own phase message against a fresh readback.

    This replaces two fixed-duration holds (a 0.5s "settle" after boot and a
    1.5s "hold" after SIGHUP). Both were sized on a fast native host, and this
    test is option=needs-linux, so it runs under QEMU emulation over a 9p
    mount, where programming nftables is exactly the thing that misses a
    guessed duration first. The failure would have surfaced as "old accept rule
    still present after reload" -- i.e. it would have read as a product
    regression rather than a test that waited on a clock instead of on state
    (ai/rules/fix-dont-record.md).

    Same shape as the daemon.pid/daemon.ready poll below: bounded, and it
    returns the moment the kernel actually holds the expected ruleset.
    """
    # // test-relax: the hand-rolled poll body became ze_api.wait_for_output.
    # Same condition, same DEADLINE, same fall-through on exhaustion (the helper
    # returns the last output rather than raising, precisely so the assertions
    # below keep reporting their own phase message). The internal sleep is
    # ratchet-exempt in the helper. attempts is derived from the budget still
    # REMAINING, so two calls continue to share one 12s deadline rather than
    # getting 12s each.
    #
    # The nft_table_exists pre-check is gone because the helper subsumes it: a
    # `nft list table` on a missing table exits non-zero, which the helper turns
    # into "", and rule_lines("") is [] -- the same empty-ruleset the predicate
    # used to be handed. Neither phase predicate is satisfiable by [], so a
    # missing table still cannot complete the wait early.
    remaining = max(0.0, DEADLINE - time.monotonic())
    wait_for_output(
        ["nft", "list", "table", "inet", "ze_pr"],
        lambda dump: predicate(rule_lines(dump)),
        attempts=max(1, int(remaining / 0.05)),
        delay=0.05,
    )

# One budget for both kernel-readback polls, well inside the suite's per-test
# timeout so a genuine failure reports THIS driver's phase message rather than
# an opaque test-level timeout.
DEADLINE = time.monotonic() + 12.0

# // test-relax: hand-rolled daemon-readiness for-loop -> ze_api.wait_for_daemon_ready
# (same 200x0.05s budget, ratchet-exempt internal sleep). It also folds in the
# pid read, which closes a real race this driver had: daemon.pid is created
# before it is written, so exists() could be followed by int("") and a traceback
# that looks nothing like a readiness problem.
pid = wait_for_daemon_ready()

# Wait for the initial apply to reach nftables: the accept rule is the signal.
wait_rules(lambda rs: any("accept" in r for r in rs))

if not nft_table_exists("ze_pr"):
    sys.exit("Phase 1 FAIL: ze_pr table missing after boot")

before = subprocess.check_output(["nft", "list", "table", "inet", "ze_pr"], text=True)
before_rules = rule_lines(before)
if not before_rules:
    sys.exit("Phase 1 FAIL: ze_pr has no rules at all; got:\n" + before)
if not any("accept" in r for r in before_rules):
    sys.exit("Phase 1 FAIL: accept rule missing; got:\n" + before)
sys.stdout.write("PHASE1_OK\n")

shutil.copy("config2.conf", "ze-bgp.conf")
os.kill(pid, signal.SIGHUP)

# Wait for the reload to land, on the RULESET rather than on a clock: it is
# complete only once drop is programmed AND accept is gone. Requiring both in one
# predicate also avoids sampling mid-reload, when the chain can legitimately hold
# neither rule or both.
wait_rules(lambda rs: any("drop" in r for r in rs) and not any("accept" in r for r in rs))

if not nft_table_exists("ze_pr"):
    sys.exit("Phase 2 FAIL: ze_pr table missing after reload")

after = subprocess.check_output(["nft", "list", "table", "inet", "ze_pr"], text=True)
after_rules = rule_lines(after)
if not after_rules:
    sys.exit("Phase 2 FAIL: ze_pr has no rules after reload; got:\n" + after)
if any("accept" in r for r in after_rules):
    sys.exit("Phase 2 FAIL: old accept rule still present after reload; got:\n" + after)
if not any("drop" in r for r in after_rules):
    sys.exit("Phase 2 FAIL: new drop rule missing after reload; got:\n" + after)

sys.stdout.write("PHASE2_OK\n")
os.kill(pid, signal.SIGTERM)
EOF_PY

stdin=ze-bgp:terminator=EOF_CONF
firewall {
	backend nft;
}
policy {
	route test-reload {
		interface eth0;
		rule r1 {
			from {
				protocol tcp;
				destination-port 80;
			}
			then {
				accept;
			}
		}
	}
}
EOF_CONF

tmpfs=config2.conf:terminator=EOF_CONF2
firewall {
	backend nft;
}
policy {
	route test-reload {
		interface eth0;
		rule r1 {
			from {
				protocol tcp;
				destination-port 80;
			}
			then {
				drop;
			}
		}
	}
}
EOF_CONF2

option=env:var=ze.log.policy.routes:value=info
option=env:var=ze.log.firewall:value=info

cmd=background:seq=1:exec=ze -:stdin=ze-bgp
cmd=foreground:seq=2:exec=python3 driver.py:timeout=15s
expect=exit:code=0
expect=stderr:contains=policy routes applied
expect=stdout:contains=PHASE1_OK
expect=stdout:contains=PHASE2_OK
