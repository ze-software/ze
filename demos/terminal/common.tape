Set Shell "/src/tmp/terminal-demos/bin/ze-demo shell"
Set FontFamily "JetBrains Mono"
Set FontSize 20
Set Width 1680
Set Height 1008
Set Padding 17
Set Framerate 30
Set TypingSpeed 125ms
Set WaitTimeout 30s
Set Theme { "name": "Ze", "black": "#1d1133", "red": "#ff6f9d", "green": "#3ee6a8", "yellow": "#ffc93c", "blue": "#6fc3ff", "magenta": "#c792ea", "cyan": "#1fc9c0", "white": "#e6d9f2", "brightBlack": "#8f7aa8", "brightRed": "#ff8db4", "brightGreen": "#65f0bc", "brightYellow": "#ffda70", "brightBlue": "#94d3ff", "brightMagenta": "#d8a9f2", "brightCyan": "#68ddd7", "brightWhite": "#fffaff", "background": "#1d1133", "foreground": "#e6d9f2", "selection": "#4b315f", "cursor": "#3ee6a8" }
