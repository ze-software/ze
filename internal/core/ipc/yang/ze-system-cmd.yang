module ze-system-cmd {
    namespace "urn:ze:system:cmd";
    prefix syscmd;

    import ze-extensions { prefix ze; }

    description
        "System operational command tree for Ze CLI.
         Covers system introspection and daemon lifecycle commands.";

    revision 2026-03-16 {
        description "Initial revision";
    }

    revision 2026-06-04 {
        description "Verb-first grammar: process reads under show, lifecycle actions under request.";
    }

    // System group

    container system {
        config false;
        description "The subcommands are help, dispatch, version, subsystem and command. This
container carries none of them itself, and each subcommand below reads the
daemon rather than the config.";
        ze:help "Daemon introspection and command dispatch.";

        container help {
            config false;
            ze:command "ze-system:help";
            description "The list carries the built-in commands first, then the commands the plugins
registered, each written as 'name - description'. A plugin command marked
hidden is left out. With no dispatcher, Ze answers a short fixed list
instead.";
            ze:help "List the subcommands the system verb accepts.";
        }

        container dispatch {
            config false;
            ze:command "ze-system:dispatch";
            description "Ze joins the words after the keyword into one command string and runs it
through the text dispatcher the CLI uses. A plugin command is reachable this
way. With no dispatcher, the command fails with 'dispatcher not available'.";
            ze:help "Dispatch a text command through the command dispatcher.";
        }

        container version {
            config false;
            description "Two commands sit here, software and api. software answers the ze build, and
api answers the IPC protocol number. The two numbers name different things and
change at different times.";
            ze:help "Software and protocol version information.";

            container software {
                config false;
                ze:command "ze-system:version-software";
                description "The answer carries a version key and a build-date key. Both come from the
values the build stamped into the binary, so a daemon that was never rebuilt
reports the same pair after a restart.";
                ze:help "Show the ze software version.";
            }

            container api {
                config false;
                ze:command "ze-system:version-api";
                description "The answer carries one version key. It holds the IPC protocol number that the
daemon and its clients agree on, and it is not the ze software version.";
                ze:help "Show the IPC protocol version.";
            }
        }

        container subsystem {
            config false;
            description "One command sits here, list. A subsystem is a plugin process the daemon
started, and the process manager owns that set.";
            ze:help "Inspect the registered subsystems.";

            container list {
                config false;
                ze:command "ze-system:subsystem-list";
                description "Each row carries the process name, its stage, a running flag and a command
count. The command count comes from the dispatcher registry, which is what
counts the commands the process actually registered.";
                ze:help "List the subsystems registered in the daemon.";
            }
        }

        container command {
            config false;
            description "Three commands sit here: list, help and complete. All three read the same
dispatcher, so a command missing from one is missing from the other two.";
            ze:help "Inspect the commands the daemon knows.";

            container list {
                config false;
                ze:command "ze-system:command-list";
                description "The rows carry the built-in commands first, then the commands the plugins
registered. Each row carries the command name, its summary and its long
explanation. Add the word verbose to put the source of each row beside it.";
                ze:help "List every command the daemon knows.";
            }

            container help {
                config false;
                ze:command "ze-system:command-help";
                description "The answer carries command, description, long-help and source. A command a
plugin registered also carries args and its timeout. An unknown name fails
with 'unknown command: <name>'.";
                ze:help "Show the detailed help for one command.";
            }

            container complete {
                config false;
                ze:command "ze-system:command-complete";
                description "Ze completes a command NAME from the partial text. Write 'args' before the
command name to complete an ARGUMENT of that command instead, in the form
'system command complete args <cmd> [<completed>...] <partial>'.";
                ze:help "List the completion candidates for a partial command.";
            }
        }
    }

    // Process status

    container show {
        config false;

        container status {
            config false;
            ze:command "ze-system:daemon-status";
            description "The answer carries the uptime, the peer count and the daemon start time. This
command needs a running reactor, so a daemon that has none refuses it.";
            ze:help "Show process status, uptime, and resource usage.";
        }
    }

    // Process lifecycle actions

    container request {
        config false;

        container shutdown {
            config false;
            ze:command "ze-system:daemon-shutdown";
            description "Ze writes the accepted answer first and stops after, so teardown cannot close
the requesting connection under its own reply. The answer message is 'shutdown
initiated'. A daemon with no reactor uses the same signal-based teardown that
SIGTERM triggers.";
            ze:help "Gracefully shutdown: drain connections, close peers, exit.";
        }

        container reboot {
            config false;
            ze:command "ze-system:daemon-reboot";
            description "Ze writes the accepted answer first, then runs the reboot. The answer message
is 'reboot initiated'. A daemon with no reboot function configured fails with
'reboot not available'.";
            ze:help "Gracefully shutdown then reboot the system.";
        }

        container halt {
            config false;
            ze:command "ze-system:daemon-quit";
            description "Ze writes every goroutine stack through the daemon logger at warning
level, with a 1 MB buffer, and then stops. Use it where a daemon is stuck
and the stacks are the evidence.";
            ze:help "Dump goroutine stacks to stderr and terminate immediately.";
        }

        container reload {
            config false;
            ze:command "ze-system:daemon-reload";
            description "Ze reads the config from disk, verifies it with every plugin that asked for
the config roots, and then applies it to each. Every plugin verifies before
any plugin applies. A failure at any step answers 'reload failed:
<error>'.";
            ze:help "Reload the configuration without restarting.";
        }

        container quiesce {
            config false;
            ze:command "ze-system:quiesce";
            description "It is a test and operator barrier that replaces a fixed sleep.";
            ze:help "Block until every subsystem has drained pending async work, then reply.";
        }
    }
}
