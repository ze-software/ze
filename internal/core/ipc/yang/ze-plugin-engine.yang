module ze-plugin-engine {
    namespace "urn:ze:plugin:engine";
    prefix engine;

    import ze-extensions { prefix ze; }
    import ze-types { prefix zt; }

    description
        "RPCs served by the engine for plugins to call (Socket A).
         Plugins use these RPCs during startup and runtime to register,
         declare capabilities, signal readiness, and inject routes.";

    revision 2026-02-01 {
        description "Initial revision";
    }

    // Stage 1: Plugin declares itself to the engine.

    rpc declare-registration {
        description "Called during Stage 1 of the 5-stage startup protocol.";
        ze:help "Plugin declares families, commands, config wants, and YANG schema.";
        input {
            list family {
                key "name";
                leaf name {
                    type string;
                    ze:help "Address family (e.g., ipv4/unicast, l2vpn/evpn)";
                }
                leaf mode {
                    type enumeration {
                        enum encode { ze:help "Encode text to wire"; }
                        enum decode { ze:help "Decode wire to JSON"; }
                        enum both { ze:help "Encode and decode"; }
                    }
                    ze:help "Family handling mode";
                }
            }
            list command {
                key "name";
                leaf name {
                    type string;
                    ze:help "Command name";
                }
                leaf description {
                    type string;
                    ze:help "Command description";
                }
                leaf-list args {
                    type string;
                    ze:help "Argument names";
                }
                leaf completable {
                    type boolean;
                    default false;
                    ze:help "Supports tab completion";
                }
            }
            leaf-list wants-config {
                type string;
                ze:help "Config roots to receive (e.g., bgp, environment, *)";
            }
            container schema {
                ze:help "YANG schema declaration";
                leaf module {
                    type string;
                    ze:help "YANG module name";
                }
                leaf namespace {
                    type string;
                    ze:help "YANG namespace URI";
                }
                leaf yang-text {
                    type string;
                    ze:help "Full YANG module text";
                }
                leaf-list handlers {
                    type string;
                    ze:help "Handler paths (e.g., bgp, bgp.peer)";
                }
            }
            list filter {
                key "name";
                description
                    "Config references a filter by name, in a filter block for
                     the import direction or the export direction.";
                ze:help
                    "Named route filters this plugin offers.";
                leaf name {
                    type string;
                    ze:help "Filter name (the part after : in <plugin>:<filter>)";
                }
                leaf direction {
                    type enumeration {
                        enum import { ze:help "Ingress filtering"; }
                        enum export { ze:help "Egress filtering"; }
                        enum both { ze:help "Ingress and egress filtering"; }
                    }
                    ze:help "Which direction(s) this filter handles";
                }
                leaf-list attributes {
                    type string;
                    ze:help "Attribute names to receive (e.g., as-path, community)";
                }
                leaf nlri {
                    type boolean;
                    default true;
                    ze:help "Whether to include NLRI list in filter input";
                }
                leaf raw {
                    type boolean;
                    default false;
                    ze:help "Whether to include raw wire bytes";
                }
                leaf on-error {
                    type enumeration {
                        enum reject { ze:help "Fail-closed: drop update on error"; }
                        enum accept { ze:help "Fail-open: pass update on error"; }
                    }
                    default reject;
                    ze:help "Behavior when filter IPC fails";
                }
                leaf-list overrides {
                    type string;
                    ze:help "Default filters this filter replaces (e.g., rfc:no-self-as)";
                }
            }
            list pipe {
                key "command name";
                description
                    "An alias is a word an operator types after the pipe
                     character, and it stands for an operator chain.";
                ze:help
                    "Pipe aliases this plugin offers for its own commands.";
                leaf command {
                    type string;
                    ze:help "Command path the alias sits on (one of this plugin's own declared commands)";
                }
                leaf name {
                    type string;
                    ze:help "The word an operator types after the pipe character (kebab-case)";
                }
                leaf description {
                    type string;
                    ze:help "The line completion and help show beside the name";
                }
                leaf expansion {
                    type string;
                    ze:help "The operator chain the name stands for, for example: display kind vrp-count";
                }
            }
        }
    }

    // Stage 3: Plugin declares OPEN capabilities.

    rpc declare-capabilities {
        description "Called during Stage 3 of the 5-stage startup protocol.";
        ze:help "Plugin declares capabilities for BGP OPEN injection.";
        input {
            list capability {
                key "code";
                leaf code {
                    type uint8;
                    ze:help "BGP capability code (RFC 5492)";
                }
                leaf encoding {
                    type enumeration {
                        enum hex { ze:help "Hex-encoded payload"; }
                        enum b64 { ze:help "Base64-encoded payload"; }
                        enum text { ze:help "Text payload"; }
                    }
                    default hex;
                    ze:help "Payload encoding";
                }
                leaf payload {
                    type string;
                    ze:help "Encoded capability value (empty for zero-length)";
                }
                leaf-list peers {
                    type string;
                    ze:help "Peer addresses (empty = global/all peers)";
                }
            }
        }
    }

    // Stage 5: Plugin signals readiness.

    rpc ready {
        description "Called during Stage 5 of the 5-stage startup protocol.";
        ze:help "Plugin signals it is operational and ready to process events.";
    }

    // Runtime: Route injection.

    rpc update-route {
        description
            "The answer carries the announced and withdrawn NLRI counts and nothing
else. A plugin that needs the target handler's structured response calls
dispatch-command instead, which preserves it. The peer selector defaults to
every peer, so an omitted selector is not a no-op.";
        ze:help "Plugin injects a route update to matching peers.";
        input {
            leaf peer-selector {
                type string;
                default "*";
                ze:help "Peer selector (* for all, or specific IP)";
            }
            leaf command {
                type string;
                mandatory true;
                ze:help "Route command (e.g., announce/withdraw text)";
            }
        }
        output {
            leaf announced {
                type uint32;
                ze:help "Number of NLRIs announced";
            }
            leaf withdrawn {
                type uint32;
                ze:help "Number of NLRIs withdrawn";
            }
        }
    }

    // Runtime: Command dispatch (inter-plugin communication).

    rpc dispatch-command {
        description "Enables inter-plugin communication: the engine routes the command
to the target plugin via longest-match registry lookup and returns
the full {status, data} response. Unlike update-route, which
extracts only route counters, this preserves structured responses.";
        ze:help "Plugin dispatches a command through the engine's command dispatcher.";
        input {
            leaf command {
                type string;
                mandatory true;
                ze:help "Command string to dispatch (e.g., bgp rib list)";
            }
        }
        output {
            leaf status {
                type string;
                ze:help "Response status (done or error)";
            }
            leaf data {
                type string;
                ze:help "JSON-encoded response data from target handler";
            }
        }
    }

    // Runtime: Event subscription management.

    rpc subscribe-events {
        description
            "An empty peer list means every peer rather than none. The format decides how
much of each message the engine builds. Hex and base64 carry the bytes. Parsed
carries the decoded message, and full carries both. A plugin that asks for
parsed pays the decode cost on every event.";
        ze:help "Request event delivery from the engine.";
        input {
            leaf-list events {
                type string;
                ze:help "Event types (update, open, notification, keepalive, state, all)";
            }
            leaf-list peers {
                type string;
                ze:help "Peer filter (empty = all peers)";
            }
            leaf format {
                type string;
                default "parsed";
                ze:help "Event format (hex, base64, parsed, full)";
            }
        }
    }

    rpc unsubscribe-events {
        description "It cancels the whole subscription subscribe-events created. There is no
per-event and no per-peer form, so a plugin that wants a narrower set
unsubscribes and subscribes again with the set it wants.";
        ze:help "Stop event delivery.";
    }

    // Runtime: Wire decoding services.
    // Plugins call these to decode BGP wire data via the engine's parsers.

    rpc decode-nlri {
        description "Engine routes to the compile-time plugin registry for decoding.";
        ze:help "Decode NLRI hex for a specific address family.";
        input {
            leaf family {
                type string;
                mandatory true;
                ze:help "Address family (e.g., ipv4/unicast, l2vpn/evpn)";
            }
            leaf hex {
                type string;
                mandatory true;
                ze:help "Hex-encoded NLRI wire bytes";
            }
        }
        output {
            leaf json {
                type string;
                ze:help "JSON-encoded decoded NLRI";
            }
        }
    }

    rpc encode-nlri {
        description "Engine routes to the compile-time plugin registry for encoding.";
        ze:help "Encode NLRI from text arguments for a specific address family.";
        input {
            leaf family {
                type string;
                mandatory true;
                ze:help "Address family (e.g., ipv4/flow, l2vpn/evpn)";
            }
            leaf-list args {
                type string;
                ze:help "Encoding arguments (family-specific)";
            }
        }
        output {
            leaf hex {
                type string;
                ze:help "Hex-encoded NLRI wire bytes";
            }
        }
    }

    rpc decode-mp-reach {
        description "Engine extracts address family, next-hop, and decoded NLRI.";
        ze:help "Decode a full MP_REACH_NLRI attribute value (RFC 4760 Section 3).";
        input {
            leaf hex {
                type string;
                mandatory true;
                ze:help "Hex-encoded MP_REACH_NLRI value (after TLV header)";
            }
            leaf add-path {
                type boolean;
                default false;
                ze:help "Whether NLRI includes ADD-PATH path-id (RFC 7911)";
            }
        }
        output {
            leaf family {
                type string;
                ze:help "Decoded address family (e.g., ipv4/unicast)";
            }
            leaf next-hop {
                type string;
                ze:help "Decoded next-hop address";
            }
            leaf nlri {
                type string;
                ze:help "JSON array of decoded NLRI entries";
            }
        }
    }

    rpc decode-mp-unreach {
        description "Engine extracts address family and decoded withdrawn NLRI.";
        ze:help "Decode a full MP_UNREACH_NLRI attribute value (RFC 4760 Section 4).";
        input {
            leaf hex {
                type string;
                mandatory true;
                ze:help "Hex-encoded MP_UNREACH_NLRI value (after TLV header)";
            }
            leaf add-path {
                type boolean;
                default false;
                ze:help "Whether NLRI includes ADD-PATH path-id (RFC 7911)";
            }
        }
        output {
            leaf family {
                type string;
                ze:help "Decoded address family (e.g., ipv4/unicast)";
            }
            leaf nlri {
                type string;
                ze:help "JSON array of decoded withdrawn NLRI entries";
            }
        }
    }

    rpc decode-update {
        description "Engine parses attributes, NLRI, and withdrawn routes.
Returns ze-bgp JSON format (same structure as deliver-event).";
        ze:help "Decode a full UPDATE message body (RFC 4271 Section 4.3).";
        input {
            leaf hex {
                type string;
                mandatory true;
                ze:help "Hex-encoded UPDATE body (after 19-byte BGP header)";
            }
            leaf add-path {
                type boolean;
                default false;
                ze:help "Whether NLRI includes ADD-PATH path-id (RFC 7911)";
            }
        }
        output {
            leaf json {
                type string;
                ze:help "ze-bgp JSON with update attributes and NLRI";
            }
        }
    }

    // Runtime: Event emission (plugin-generated events).

    rpc emit-event {
        description "The engine routes the event to all plugins subscribed to the
matching namespace and event-type.";
        ze:help "Plugin emits a custom event to subscribers.";
        input {
            leaf namespace {
                type string;
                mandatory true;
                ze:help "Event namespace (e.g., bgp, rib)";
            }
            leaf event-type {
                type string;
                mandatory true;
                ze:help "Event type (e.g., rpki, update)";
            }
            leaf direction {
                type string;
                default "received";
                ze:help "Event direction (received, sent, both)";
            }
            leaf peer-address {
                type string;
                default "*";
                ze:help "Peer address for event routing (* for all)";
            }
            leaf event {
                type string;
                mandatory true;
                ze:help "JSON-encoded event payload";
            }
        }
        output {
            leaf delivered {
                type uint32;
                ze:help "Number of plugins that received the event";
            }
        }
    }

    // Error identities.

    identity registration-conflict {
        description "Family or command already claimed by another plugin";
    }

    identity stage-timeout {
        description "Barrier timeout exceeded during startup";
    }

    identity invalid-route {
        description "Route parsing failed";
    }
}
