module ze-system-api {
    namespace "urn:ze:system:api";
    prefix sys;

    import ze-extensions { prefix ze; }
    import ze-types { prefix zt; }

    description
        "System-level API operations for Ze.
         RPCs for version queries, shutdown, and command introspection.";

    revision 2026-02-01 {
        description "Initial revision";
    }

    rpc help {
        description "List the subcommands the system verb accepts.";
        output {
            leaf-list subcommands { type string; description "Available subcommands"; }
        }
    }

    rpc version-software {
        description "Show the ze software version.";
        output {
            leaf version { type string; description "Software version string"; }
        }
    }

    rpc version-api {
        description "Show the IPC protocol version.";
        output {
            leaf version { type string; description "API protocol version"; }
        }
    }

    // Daemon lifecycle (system-wide operations affecting all plugins)

    rpc daemon-shutdown {
        description "Shut the daemon down gracefully.";
    }

    rpc daemon-reboot {
        description "Shut the daemon down gracefully, then reboot the system (root is required on Linux).";
    }

    rpc daemon-quit {
        description "Dump every goroutine stack, then shut the daemon down.";
    }

    rpc daemon-status {
        description "Show the daemon uptime, peer count, and start time.";
        output {
            leaf uptime-seconds { type uint32; description "Seconds since start"; }
            leaf peer-count { type uint32; description "Number of configured peers"; }
            leaf start-time { type string; description "ISO 8601 start timestamp"; }
        }
    }

    rpc daemon-reload {
        description "Reload the configuration.";
    }

    rpc quiesce {
        description "Block until every subsystem drains its pending async work.";
        ze:help "It is a test and operator barrier that replaces a fixed sleep.";
        output {
            leaf-list quiesced { type string; description "Subsystems that were asked to drain"; }
            leaf-list failed { type string; description "Subsystems that failed or timed out"; }
        }
    }

    rpc subsystem-list {
        description "List the subsystems registered in the daemon.";
        output {
            list subsystem {
                leaf name { type string; description "Subsystem name"; }
                leaf description { type string; description "Subsystem description"; }
            }
        }
    }

    rpc command-list {
        description "List every command the daemon knows.";
        output {
            list command {
                uses zt:command-info;
            }
        }
    }

    rpc command-help {
        description "Show the detailed help for one command.";
        input {
            leaf name { type string; mandatory true; description "Command name"; }
        }
        output {
            leaf help { type string; description "Detailed help text"; }
        }
    }

    rpc command-complete {
        description "List the completion candidates for a partial command.";
        input {
            leaf partial { type string; mandatory true; description "Partial command string"; }
            leaf arg { type string; description "Current argument being completed"; }
        }
        output {
            leaf-list completions { type string; description "Completion candidates"; }
        }
    }

    rpc dispatch {
        description "Dispatch a text command through the command dispatcher.";
        input {
            leaf-list args { type string; description "Command words to join and dispatch"; }
        }
        output {
            leaf status { type string; description "Result status (ok or error)"; }
            leaf data { type string; description "Response data"; }
        }
    }
}
