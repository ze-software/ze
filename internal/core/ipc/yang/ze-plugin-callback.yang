module ze-plugin-callback {
    namespace "urn:ze:plugin:callback";
    prefix callback;

    import ze-extensions { prefix ze; }
    import ze-types { prefix zt; }
    import ze-plugin-engine { prefix engine; }

    description
        "RPCs served by the plugin for the engine to call (Socket B).
         The engine uses these RPCs during startup to deliver config and
         registry, and at runtime to deliver events and request encoding.";

    revision 2026-11-27 {
        description "Add runtime-inspect and drift-check read-only diagnostic callback RPCs";
    }

    revision 2026-02-01 {
        description "Initial revision";
    }

    rpc runtime-ready {
        ze:method "ze-plugin-callback:runtime-ready";
        ze:help "Join the plugin's declared initialization.";
        description "An empty receipt delivered through the ordinary callback loop after ready. A plugin declaring started-handler must answer only after its initialization succeeds. Failure or a missing receipt fails startup.";
    }

    grouping source-policy-receipt {
        description "Exact identity shared by a source-policy request and its receipt.";
        leaf transaction-id {
            type string { length "1..256"; }
            mandatory true;
            ze:help "Original transaction identity";
            description "Must match the retained transaction.";
        }
        leaf operation {
            type enumeration {
                enum prepare { ze:help "Pin original source state"; }
                enum apply { ze:help "Invalidate source eligibility"; }
                enum abort { ze:help "Restore pinned source state"; }
                enum finalize { ze:help "Release accepted transaction pins"; }
            }
            mandatory true;
            ze:help "Source-policy lifecycle operation";
            description "Unknown or absent operations are refused.";
        }
        container source {
            description "Captured original source identity, never a successor.";
            ze:help "Captured source identity";
            leaf peer {
                type string { length "1..256"; }
                mandatory true;
                ze:help "Source peer identity";
                description "The source peer selected by the coordinator.";
            }
            leaf peer-owner {
                type uint64 { range "1..max"; }
                mandatory true;
                ze:help "Peer incarnation";
                description "Stable across reconnects of this peer object.";
            }
            leaf session-generation {
                type uint64 { range "1..max"; }
                mandatory true;
                ze:help "Captured session generation";
                description "Independent of the source policy epoch.";
            }
            leaf policy-epoch {
                type uint64 { range "1..max"; }
                mandatory true;
                ze:help "Original source policy epoch";
                description "The epoch pinned at prepare.";
            }
            leaf receive-frontier {
                type uint64;
                mandatory true;
                ze:help "Receive publication frontier";
                description "Explicit zero is valid; absent or null is malformed.";
            }
            leaf template-generation {
                type uint64;
                mandatory true;
                ze:help "Captured template generation";
                description "Explicit zero is valid for a source without a dynamic template.";
            }
        }
        leaf next-policy-epoch {
            type uint64;
            mandatory true;
            ze:help "Target policy epoch";
            description "Apply requires a fresh epoch newer than the original. Abort carries explicit zero for a transaction that was prepared and never applied (the owner only releases its pins), or a fresh epoch newer than the original after apply. Prepare and finalize require explicit zero.";
        }
    }

    grouping current-selection-scope {
        description "Exact destination incarnation shared by current selection queries and replies.";
        leaf destination {
            type string;
            mandatory true;
            ze:help "Destination peer address";
            description "The exact selecting connection answers for this destination address.";
        }
        leaf destination-session {
            type uint64 { range "1..max"; }
            mandatory true;
            ze:help "Destination session token";
            description "The original destination UP event's initial-replay token, never a newer session.";
        }
    }

    grouping current-selection-key {
        description "Native advertisement key and the revision being checked.";
        leaf family {
            type string { length "1..max"; }
            mandatory true;
            ze:help "Registered native family";
            description "Family of the native advertisement key; not necessarily an IP prefix.";
        }
        leaf key-nlri {
            type binary { length "1..max"; }
            mandatory true;
            ze:help "Native advertisement key bytes";
            description "Advertisement framing with the source ADD-PATH identifier removed, encoded as base64.";
        }
        leaf revision {
            type uint64 { range "1..max"; }
            mandatory true;
            ze:help "Requested selection revision";
            description "Echoed without substituting the current revision.";
        }
    }

    grouping origin-admission-identity {
        description "Exact original accepted-record query identity.";
        leaf admission-id {
            type uint64 { range "1..max"; }
            mandatory true;
            ze:help "Original accepted-record ID";
            description "One opaque identity allocated before the original synchronous consumer call. It is not an origin receipt.";
        }
        leaf family {
            type string { length "12..12"; pattern "ipv[46]/unicast"; }
            mandatory true;
            ze:help "Original unicast prefix family";
            description "Only the current IPv4 or IPv6 unicast redistribution feed is represented.";
        }
        leaf prefix {
            type string { length "1..43"; }
            mandatory true;
            ze:help "Original canonical source prefix";
            description "A masked canonical network prefix of the stated family.";
        }
        leaf destination {
            type string { length "1..256"; }
            mandatory true;
            ze:help "Concrete destination peer address";
            description "The caller resolves and separately authenticates the original configured Peer.";
        }
        leaf peer-owner {
            type uint64 { range "1..max"; }
            mandatory true;
            ze:help "Concrete configured Peer identity";
            description "Engine-derived Peer incarnation, never an authority asserted by the producer.";
        }
        leaf operation {
            type uint8 { range "1..2"; }
            mandatory true;
            ze:help "One announces; two removes";
            description "The existing OriginIntakeOperation values. An exact retiring record can answer withdrawal only.";
        }
    }

    grouping origin-admission-snapshot {
        description "Original immutable accepted data, never publisher or send authority.";
        leaf protocol {
            type string { length "1..64"; pattern "[a-z0-9-]+"; }
            mandatory true;
            ze:help "Original source protocol";
            description "The canonical producer protocol, separate from the BGP preference class.";
        }
        leaf bgp-class {
            type uint8 { range "0..2"; }
            mandatory true;
            ze:help "Original BGP source class";
            description "Zero for non-BGP, one internal BGP, two external BGP. BGP requires its explicit original class.";
        }
        leaf source-instance {
            type uint32;
            mandatory true;
            ze:help "Original source instance";
            description "Explicit zero is valid only for a real aggregate producer.";
        }
        leaf table {
            type uint32;
            mandatory true;
            ze:help "Original source table";
            description "The producer table, including an explicit zero.";
        }
        leaf source-metric {
            type uint32;
            mandatory true;
            ze:help "Original source preference metric";
            description "The original pre-transform metric, distinct from optional wire MED.";
        }
        leaf distance-override {
            type uint8;
            mandatory true;
            ze:help "Original distance override";
            description "Zero is valid when has-distance-override is true.";
        }
        leaf has-distance-override {
            type boolean;
            mandatory true;
            ze:help "Whether original distance is present";
            description "Explicit false distinguishes no override from a present zero override.";
        }
        leaf next-hop {
            type string { length "0..256"; }
            mandatory true;
            ze:help "Accepted original next hop";
            description "An original address, or an explicit empty value for the existing BGP local self choice.";
        }
        leaf origin-asn {
            type uint32;
            mandatory true;
            ze:help "Accepted origin ASN";
            description "Preserves the accepted route build; it confers no source authority.";
        }
        leaf tag {
            type uint32;
            mandatory true;
            ze:help "Accepted route tag";
            description "The accepted transformed tag, including zero.";
        }
        leaf metric {
            type uint32;
            mandatory true;
            ze:help "Accepted optional wire MED";
            description "Meaningful only when has-metric is true; not the original source preference metric.";
        }
        leaf has-metric {
            type boolean;
            mandatory true;
            ze:help "Whether an import transform set wire MED";
            description "A producer metric alone never implies MULTI_EXIT_DISC.";
        }
        leaf rule-generation {
            type uint64;
            mandatory true;
            ze:help "Actual evaluator generation";
            description "Explicit zero is valid for the initial evaluator. It is not another source identity.";
        }
        leaf peer-scope {
            type uint8 { range "1..2"; }
            mandatory true;
            ze:help "All peers or exactly one peer";
            description "One all peers, two exact peer. Missing or unknown scope never implies a wildcard.";
        }
        leaf peer {
            type string { length "0..256"; }
            mandatory true;
            ze:help "Accepted exact peer scope";
            description "Empty for all-peer scope; otherwise the exact canonical destination address.";
        }
        leaf-list community {
            type uint32;
            max-elements 65535;
            ze:help "Accepted standard BGP communities";
            description "Owned values; the callback also enforces the actual transport frame bound.";
        }
    }

    rpc origin-admission-lookup {
        ze:method "ze-plugin-callback:origin-admission-lookup";
        ze:help "Read one original accepted redistribution record.";
        description "The exact original accepting connection answers on an independent bounded read-only worker. The caller separately authenticates publisher, process, accepted lifetime and send grants. Stage 1 and supplied JSON facts grant no route authority.";
        input {
            uses origin-admission-identity;
            leaf deadline-ms {
                type int64 { range "1..max"; }
                mandatory true;
                ze:help "Absolute bounded read deadline";
                description "Unix milliseconds, no later than thirty seconds from admission.";
            }
        }
        output {
            uses origin-admission-identity;
            leaf state {
                type uint8 { range "1..2"; }
                mandatory true;
                ze:help "Current or exact retiring accepted record";
                description "One current, two retiring. Retiring is valid only for the exact withdrawal operation.";
            }
            container snapshot {
                presence "A successful lookup carries its original accepted snapshot.";
                ze:help "Original immutable accepted source and build";
                description "Missing or stale records return an explicit error, never an empty successful snapshot.";
                uses origin-admission-snapshot;
            }
        }
    }

    rpc origin-intake {
        ze:method "ze-plugin-callback:origin-intake";
        ze:help "Admit or remove one exact engine-authorized local contribution.";
        description "The exact registered deciding connection owns candidate mutation. One bounded independent worker may call the engine; CurrentSelection remains read-only. Cancellation joins mutation and reply completion. The engine validates original sender, native syntax and concrete scope before offering, and checks issued receipt freshness before and after the callback. The plugin serializes source/key/scope and refuses older generations. No received-source reference or forwarding authority is manufactured.";
        input {
            leaf operation {
                type uint8 { range "1..2"; }
                mandatory true;
                ze:help "One announces; two removes the exact contribution";
                description "Numeric rpc.OriginIntakeOperation: one announce, two withdraw; zero and unknown values are refused.";
            }
            leaf destination {
                type string { length "1..max"; }
                mandatory true;
                ze:help "Concrete authorized destination peer address";
                description "An IP address, including scoped IPv6, resolved by the engine's existing selector and send grants.";
            }
            leaf peer-owner {
                type uint64 { range "1..max"; }
                mandatory true;
                ze:help "Exact original configured Peer identity";
                description "Distinguishes same-address siblings; it is engine-derived, not a selector supplied by a plugin.";
            }
            leaf origin-receipt {
                type uint64 { range "1..max"; }
                mandatory true;
                ze:help "Issued generation reused by SelectedRouteOrigin";
                description "The existing SelectedRoute.OriginReceipt binds producer, original source, native key, concrete Peer and deciding process incarnation.";
            }
            leaf deadline-ms {
                type int64 { range "1..max"; }
                mandatory true;
                ze:help "Absolute mutation deadline in Unix milliseconds";
                description "No later than thirty seconds; queued and active mutation must honor cancellation and join before acknowledgment.";
            }
            container producer {
                ze:help "Original authenticated local producer";
                description "Descriptive engine provenance. Its name does not authorize a replacement process.";
                leaf kind {
                    type uint8 { range "1..2"; }
                    mandatory true;
                    ze:help "One process; two explicit operator";
                    description "Numeric rpc.OriginProducerKind. Zero is unspecified and refused.";
                }
                leaf name {
                    type string;
                    ze:help "Original process name, absent for operator";
                    description "Required for process kind and forbidden for operator. The receipt captures the process incarnation.";
                }
            }
            container source {
                ze:help "Accepted original source facts";
                description "The engine preserves original protocol/instance, metric and explicit distance presence; it does not elect candidates or infer protocol from BGP ORIGIN.";
                leaf kind {
                    type uint8 { range "1..3"; }
                    mandatory true;
                    ze:help "Local BGP, configured BGP or redistributed source";
                    description "Numeric rpc.OriginSourceKind: one local BGP, two configured BGP, three redistributed. Zero is refused.";
                }
                leaf protocol {
                    type string;
                    ze:help "Registered original redistribution protocol";
                    description "Required for redistributed source and absent for local/configured BGP; not the process name or BGP ORIGIN.";
                }
                leaf instance { type uint64; mandatory true; ze:help "Original source instance, including explicit zero"; }
                leaf metric { type uint32; mandatory true; ze:help "Accepted source metric"; }
                leaf distance { type uint8; mandatory true; ze:help "Accepted override value, independent of presence"; }
                leaf has-distance { type boolean; mandatory true; ze:help "Whether the accepted policy supplied a distance override"; }
            }
            container route {
                ze:help "Owned original local build data";
                description "Contains native advertisement bytes without ADD-PATH framing, original attribute bytes and portable ASN-width facts. SourceContext is only an engine-local handle; a forked reader must not look it up in its own registry or assume unknown means ASN4.";
                leaf family { type string { length "1..max"; } mandatory true; ze:help "Registered native route family"; }
                leaf key-nlri { type binary { length "1..max"; } mandatory true; ze:help "Native advertisement key without source path identifier"; }
                leaf source-path-id { type uint32; mandatory true; ze:help "Original path identifier, including legal zero"; }
                leaf source-add-path { type boolean; mandatory true; ze:help "Original path-ID presence independent of its value"; }
                leaf attributes { type binary; mandatory true; ze:help "Owned original attribute block"; }
                leaf attributes-explicit { type boolean; mandatory true; ze:help "Whether an explicit block was supplied, including empty"; }
                leaf source-context { type uint16; mandatory true; ze:help "Opaque original engine encoding-context handle"; }
                leaf as-path-known { type boolean; mandatory true; ze:help "Whether original AS-path encoding width is known"; }
                leaf as-path-asn4 { type boolean; mandatory true; ze:help "Four-octet AS-path encoding only when known"; description "Unknown width must carry false; readers retain unknown bytes opaque rather than assuming ASN4."; }
                leaf next-hop-policy {
                    type uint8 { range "0..3"; }
                    mandatory true;
                    ze:help "Original late-bound next-hop policy";
                    description "Zero unset for a family requiring no next hop, one explicit, two self, three default candidate. Engine family validation precedes intake.";
                }
                leaf next-hop { type string; ze:help "Explicit/default address; absent for self or unset"; }
                leaf origin-as { type uint32; mandatory true; ze:help "Original local virtual-origin AS, zero for ordinary synthesis"; }
            }
        }
        output {
            uses engine:update-route-result;
        }
    }

    rpc current-selection {
        ze:method "ze-plugin-callback:current-selection";
        ze:help "Read current desired selection independently of ordinary callbacks.";
        description "Runs on one bounded independent connection worker before the ordinary callback queue. Reads only a published desired-selection snapshot, with no engine RPC, I/O, election locks or candidate payload. The exact authenticated selecting connection supplies process identity; the reply grants no forwarding permission.";
        input {
            uses current-selection-scope;
            leaf deadline-ms {
                type int64 { range "1..max"; }
                mandatory true;
                ze:help "Absolute lookup deadline";
                description "Unix milliseconds, bounded to thirty seconds. Expired requests do not invoke the handler.";
            }
            list keys {
                min-elements 1;
                ordered-by user;
                ze:help "Native keys whose current state is required";
                description "Ordered lookup batch. Both its encoded request and widest complete reply must fit the RPC frame limit; larger queries are split before admission.";
                uses current-selection-key;
            }
        }
        output {
            uses current-selection-scope;
            leaf cut {
                type uint64;
                mandatory true;
                ze:help "Current scope selection cut";
                description "Published global selection frontier for this destination scope. Explicit zero is valid for a fresh empty scope; no per-key absence history is returned.";
            }
            list results {
                ordered-by user;
                ze:help "Exact ordered current-state results";
                description "One result per requested key, preserving its family, bytes and requested revision.";
                uses current-selection-key;
                leaf presence {
                    type uint8 { range "1..2"; }
                    mandatory true;
                    ze:help "Explicit present or absent state";
                    description "One means present; two means absent. Zero and unknown values are refused.";
                }
                leaf current-revision {
                    type uint64;
                    mandatory true;
                    ze:help "Current key revision or explicit zero";
                    description "Nonzero and at most cut for a present key, zero for an absent key. An old but current key revision remains valid under a newer scope cut.";
                }
            }
        }
    }

    rpc event-settlement {
        ze:method "ze-plugin-callback:event-settlement";
        ze:help "Await asynchronous work after event application.";
        description "The engine first awaits its applied event FIFO. The callback then acknowledges downstream work on an independent worker, while ordinary callbacks remain live.";
        input {
            leaf deadline-ms {
                type int64 { range "1..max"; }
                mandatory true;
                ze:help "Absolute settlement deadline in Unix milliseconds";
                description "The handler and queue waiting honor this bound. Expired requests do not invoke the handler.";
            }
        }
        output {
            leaf deadline-ms {
                type int64 { range "1..max"; }
                mandatory true;
                ze:help "Exact request deadline";
                description "Echoes the request deadline so the caller can verify the completed receipt.";
            }
            leaf status {
                type enumeration {
                    enum ok { ze:help "Downstream work completed"; }
                    enum error { ze:help "Settlement failed"; }
                }
                mandatory true;
                ze:help "Actual settlement outcome";
                description "Only ok with no error acknowledges completed work. A failed outcome carries its cause.";
            }
            leaf error {
                type string { length "0..4096"; }
                ze:help "Settlement failure cause";
                description "Names failed downstream work. Absent on success and required for a failed receipt.";
            }
        }
    }

    rpc source-policy {
        ze:method "ze-plugin-callback:source-policy";
        ze:help "Settle a captured source-policy lifecycle operation.";
        description "Prepare follows strict event application drain. The owner fences asynchronous work and downstream settlement before returning. It retains pins until abort or finalize; this is not shutdown drain.";
        input {
            uses source-policy-receipt;
            leaf deadline-ms {
                type int64 { range "1..max"; }
                mandatory true;
                ze:help "Absolute operation deadline in Unix milliseconds";
                description "Expired requests never invoke the handler; all owner work must honor this bound.";
            }
        }
        output {
            uses source-policy-receipt;
            leaf status {
                type enumeration {
                    enum ok { ze:help "Owner work settled"; }
                    enum error { ze:help "Owner work failed"; }
                }
                mandatory true;
                ze:help "Actual operation outcome";
                description "Only ok acknowledges completed work for the exact echoed identity.";
            }
            leaf error {
                type string { length "0..4096"; }
                ze:help "Owner failure";
                description "Explains failed application or settlement; absent on success.";
            }
        }
    }

    rpc config-complete {
        ze:method "ze-plugin-callback:config-complete";
        ze:help "Complete retained config undo after whole-reload acceptance or abort.";
        description "An acknowledged completion for the captured plugin lifetime. Accepted follows irreversible publication; rejection follows original operation undo and old configuration restoration. A receipt means cleanup finished, not queued.";
        input {
            leaf transaction-id {
                type string { length "1..256"; }
                mandatory true;
                ze:help "Original transaction identity";
                description "Must match retained work; never selects a newer transaction.";
            }
            leaf accepted {
                type boolean;
                mandatory true;
                ze:help "Whether publication is irreversible";
                description "True releases undo without rollback; false completes a restored transaction.";
            }
            leaf deadline-ms {
                type int64 { range "1..max"; }
                mandatory true;
                ze:help "Absolute completion deadline in Unix milliseconds";
                description "The handler must finish cleanup within this deadline.";
            }
        }
        output {
            leaf transaction-id {
                type string { length "1..256"; }
                mandatory true;
                ze:help "Completed transaction identity";
                description "Echoes the request identity; mismatched receipts are refused.";
            }
            leaf accepted {
                type boolean;
                mandatory true;
                ze:help "Completed decision";
                description "Echoes the request decision.";
            }
            leaf status {
                type enumeration {
                    enum ok { ze:help "Cleanup completed"; }
                    enum error { ze:help "Cleanup failed"; }
                }
                mandatory true;
                ze:help "Actual completion outcome";
                description "Only ok acknowledges completed cleanup.";
            }
            leaf error {
                type string { length "0..4096"; }
                ze:help "Cleanup failure";
                description "Names the failed owner operation without claiming rollback after acceptance.";
            }
        }
    }

    grouping bus-filter-rule {
        description "Compiled send or receive message rule with its resolved target participants.";
        leaf message {
            type string { length "3..256"; }
            mandatory true;
            ze:help "Canonical message name";
            description "Qualified bus message name (namespace:name or cli:<prefix>) governed by this rule.";
        }
        leaf allowed {
            type boolean;
            ze:help "Whether this message is permitted";
            description "True when the participant allow-list admits this message.";
        }
        leaf target-all {
            type boolean;
            ze:help "Unscoped target set matching all participants";
            description "True when the rule targets every eligible participant, including future dynamic participants.";
        }
        leaf target-none {
            type boolean;
            ze:help "Explicitly empty target set";
            description "True when the rule explicitly suppresses all targets via none.";
        }
        list target {
            key "path";
            ze:help "Resolved target participants";
            description "Concrete participants currently reachable under this rule, with their canonical paths and remote addresses.";
            leaf path {
                type string { length "1..512"; }
                mandatory true;
                ze:help "Canonical bus participant path";
                description "Short canonical bus path of the resolved target participant.";
            }
            leaf endpoint-name {
                type string { length "1..128"; }
                ze:help "Target endpoint name";
                description "Endpoint process name when the target participant is an endpoint.";
            }
            leaf address {
                type string { length "1..128"; }
                ze:help "Target remote IP address";
                description "Concrete remote IP address of a protocol peer target when applicable.";
            }
            leaf-list secondary-paths {
                type string { length "1..512"; }
                ze:help "Secondary lookup paths";
                description "Optional alias paths resolving to the same target participant.";
            }
        }
    }

    grouping bus-participant-filter {
        description "Compiled bus filter for one participant, delivered at Stage 2 and on delivery-graph rebuilds.";
        container participant-filter {
            ze:help "Participant compiled bus filter";
            description "Effective send and receive rules and resolved target sets compiled for this participant.";
            leaf participant-path {
                type string { length "1..512"; }
                ze:help "Canonical path of this participant";
                description "Canonical bus path assigned to the receiving participant.";
            }
            leaf endpoint-name {
                type string { length "1..128"; }
                ze:help "Endpoint process name";
                description "Process or endpoint name of this participant.";
            }
            leaf send-all {
                type boolean;
                ze:help "All declared sends admitted";
                description "True when no send allow-list narrows the participant's declared sends.";
            }
            leaf send-none {
                type boolean;
                ze:help "All sends suppressed";
                description "True when the send allow-list is explicitly none.";
            }
            leaf send-to-all {
                type boolean;
                ze:help "Unscoped send destination set";
                description "True when the participant's block-level send destination scope covers all eligible participants, including future dynamic peers.";
            }
            leaf send-to-none {
                type boolean;
                ze:help "Explicitly empty send destination set";
                description "True when the participant's block-level send destination scope is explicitly none.";
            }
            list send {
                key "message";
                ze:help "Compiled send rules";
                description "Per-message send rules and resolved destination targets for this participant.";
                uses bus-filter-rule;
            }
            leaf receive-all {
                type boolean;
                ze:help "All declared receptions admitted";
                description "True when no receive allow-list narrows the participant's declared receptions.";
            }
            leaf receive-none {
                type boolean;
                ze:help "All receptions suppressed";
                description "True when the receive allow-list is explicitly none.";
            }
            leaf receive-from-all {
                type boolean;
                ze:help "Unscoped receive source set";
                description "True when the participant's block-level receive source scope covers all eligible participants, including future dynamic peers.";
            }
            leaf receive-from-none {
                type boolean;
                ze:help "Explicitly empty receive source set";
                description "True when the participant's block-level receive source scope is explicitly none.";
            }
            list receive {
                key "message";
                ze:help "Compiled receive rules";
                description "Per-message receive rules and resolved source targets for this participant.";
                uses bus-filter-rule;
            }
        }
    }

    // Stage 2: Engine delivers configuration.

    rpc configure {
        ze:method "ze-plugin-callback:configure";
        description "Called during Stage 2 of the 5-stage startup protocol.";
        ze:help "Engine delivers configuration sections to the plugin.";
        input {
            list section {
                key "root";
                description
                    "The list holds one entry for each root the plugin asked for that has
                     config, in the order the plugin named them. A plugin that asked for
                     nothing receives an empty list and the claims beside it.";
                ze:help "Config subtrees the plugin asked for at Stage 1.";
                leaf root {
                    type string;
                    description
                        "One section arrives for each root the plugin named in wants-config at
                         Stage 1, and a root with no config is left out. The value repeats the
                         name the plugin asked for.";
                    ze:help "Config root name (e.g., bgp, environment)";
                }
                leaf data {
                    type string;
                    description
                        "The subtree is wrapped in its full path from the root, so a plugin that
                         asked for bgp reads an object with one bgp key. The order of a
                         reordered list travels inside it.";
                    ze:help "JSON-encoded config data for this root";
                }
            }
            list bus-catalog {
                key "message";
                description
                    "Complete catalog of messages registered on the daemon's bus (compiled-in
                     and declared external sends), delivered at Stage 2 beside claims.";
                ze:help "Registered bus message catalog.";
                leaf message {
                    type string { length "3..256"; }
                    mandatory true;
                    ze:help "Canonical message name (namespace:name or cli:<prefix>)";
                    description "Registered message identifier on the bus.";
                }
                leaf-list sender-kinds {
                    type string { length "1..128"; }
                    ze:help "Participant kinds that declared sending this message";
                    description "Sorted list of registered sender kinds for this message.";
                }
                list tags {
                    key "name";
                    max-elements 32;
                    ze:help "Tags declared for this message";
                    description "Tag definitions registered for this bus message.";
                    uses engine:message-tag;
                }
            }
            uses bus-participant-filter;
        }
    }

    // Runtime: Live bus participant filter update.

    rpc participant-filter {
        ze:method "ze-plugin-callback:participant-filter";
        description "Delivered asynchronously to running plugins whenever the daemon rebuilds its compiled bus delivery graph (for example after config reload or dynamic peer admission).";
        ze:help "Engine pushes an updated compiled bus filter to the plugin.";
        input {
            uses bus-participant-filter;
        }
    }

    // Stage 4: Engine shares command registry.

    rpc share-registry {
        ze:method "ze-plugin-callback:share-registry";
        description "Called during Stage 4 of the 5-stage startup protocol.";
        ze:help "Engine shares the full command registry with the plugin.";
        input {
            list command {
                key "name";
                description
                    "The engine builds the list from the plugin registry after every plugin
                     registered, so it is complete at Stage 4. A plugin reads it to learn which
                     commands dispatch-command can reach.";
                ze:help "Every command any plugin registered.";
                leaf name {
                    type string;
                    description
                        "The name is the one the owning plugin declared at Stage 1. The list
                         holds every plugin's commands, this plugin's own included.";
                    ze:help "Command name";
                }
                leaf plugin {
                    type string;
                    description
                        "The process name of the plugin that declared the command. A plugin
                         reads it to learn which peer process answers a dispatch.";
                    ze:help "Plugin that registered this command";
                }
                leaf encoding {
                    type string;
                    description
                        "The value is copied from the registry row and is absent when the owning
                         plugin declared none.";
                    ze:help "Command encoding (text, hex, b64)";
                }
            }
        }
    }

    // Runtime: Event delivery.

    rpc deliver-event {
        ze:method "ze-plugin-callback:deliver-event";
        description "Timeout on delivery is FATAL (program terminates).";
        ze:help "Engine delivers a BGP event to the plugin.";
        input {
            leaf event {
                type string;
                mandatory true;
                description
                    "The body is built in the format the plugin asked for in subscribe-events:
                     hex, base64, parsed or full. A plugin that asked for an envelope reads
                     the namespace and event name around the payload.";
                ze:help "JSON-encoded BGP event";
            }
        }
    }

    // Runtime: NLRI encoding/decoding callbacks.

    rpc encode-nlri {
        ze:method "ze-plugin-callback:encode-nlri";
        description "The plugin answers one hex string, which the engine writes to the wire as
the NLRI body. A plugin that registers no OnEncodeNLRI handler cannot answer,
so the family it claims stays unencodable and the engine has nothing to send.";
        ze:help "Engine requests NLRI encoding from the plugin.";
        input {
            leaf family {
                type string;
                mandatory true;
                description
                    "The form is afi/safi, and it is one of the families the plugin declared
                     with mode encode or both. The engine calls the plugin that registered
                     that family.";
                ze:help "Address family (e.g., ipv4/flow, l2vpn/evpn)";
            }
            leaf-list args {
                type string;
                description
                    "The words are the operator's text after the family name, in order. The
                     plugin defines their form, and the engine passes them without reading
                     them.";
                ze:help "Encoding arguments";
            }
        }
        output {
            leaf hex {
                type string;
                description
                    "The text is the NLRI body as hex with no separator. The engine decodes it
                     and writes the bytes into the UPDATE.";
                ze:help "Hex-encoded NLRI wire bytes";
            }
        }
    }

    rpc decode-nlri {
        ze:method "ze-plugin-callback:decode-nlri";
        description "The plugin answers a value, and the SDK marshals it ONCE into the json
field rather than encoding a string that holds encoded JSON. This is the
receive direction of encode-nlri, and a plugin that claims a family declares
both or the family works in one direction only.";
        ze:help "Engine requests NLRI decoding from the plugin.";
        input {
            leaf family {
                type string;
                mandatory true;
                description
                    "The form is afi/safi, and it is one of the families the plugin declared
                     with mode decode or both.";
                ze:help "Address family";
            }
            leaf hex {
                type string;
                mandatory true;
                description
                    "The text is the NLRI field alone, as hex with no separator. The
                     MP_REACH_NLRI header is already removed.";
                ze:help "Hex-encoded NLRI wire bytes";
            }
            leaf add-path {
                type boolean;
                default false;
                description
                    "The session negotiated a four-octet Path Identifier before each NLRI,
                     including identifiers of zero. The bytes alone do not specify framing.";
                ze:help "NLRI carries negotiated ADD-PATH identifiers";
            }
            leaf withdraw {
                type boolean;
                default false;
                description
                    "True selects MP_UNREACH withdrawal semantics. False or absent selects
                     announcement semantics. The caller supplies the enclosing message's
                     action; a decoder must not infer it from the NLRI bytes.";
                ze:help "Decode NLRI with withdrawal semantics";
            }
        }
        output {
            leaf json {
                type string;
                description
                    "The value is the plugin's decoded NLRI as one JSON document. The engine
                     places it in the event it delivers to subscribers.";
                ze:help "JSON-encoded decoded NLRI";
            }
        }
    }

    rpc decode-capability {
        ze:method "ze-plugin-callback:decode-capability";
        description "The engine passes the numeric capability code and the option bytes as hex,
so a plugin decodes a code the engine itself does not know. The answer is
marshaled once into the json field, the shape decode-nlri also uses.";
        ze:help "Engine requests capability decoding from the plugin.";
        input {
            leaf code {
                type uint8;
                mandatory true;
                description
                    "The value is the capability code from the OPEN message, in the range 0 to
                     255 of RFC 5492.";
                ze:help "BGP capability code";
            }
            leaf hex {
                type string;
                mandatory true;
                description
                    "The text is the capability value alone, as hex with no separator. The code
                     and length bytes are already removed.";
                ze:help "Hex-encoded capability bytes";
            }
        }
        output {
            leaf json {
                type string;
                description
                    "The value is the plugin's decoded capability as one JSON document.";
                ze:help "JSON-encoded decoded capability";
            }
        }
    }

    // Runtime: Command execution.

    rpc execute-command {
        ze:method "ze-plugin-callback:execute-command";
        description "The serial correlates the answer with this request. The engine can have
several requests in flight on one connection. A handler CAN answer with
records, which is a walk and not a built value. Over the socket that arrives
as a head, its records and a terminator. Over the direct bridge it collapses
to the single document the record path would have carried.";
        ze:help "Engine requests the plugin to execute a command.";
        input {
            leaf serial {
                type string;
                mandatory true;
                description
                    "The engine sets it, and the plugin copies it into its answer unchanged.
                     Two requests in flight on one connection never share a serial.";
                ze:help "Correlation serial for response tracking";
            }
            leaf command {
                type string;
                mandatory true;
                description
                    "The name is one the plugin declared at Stage 1, and the engine sends the
                     declared name rather than the text the operator typed.";
                ze:help "Command to execute";
            }
            leaf-list args {
                type string;
                description
                    "The words are the operator's arguments after the command name, in order.
                     On a completion request they are the arguments already completed.";
                ze:help "Command arguments";
            }
            leaf peer {
                type string;
                description
                    "The value is the peer selector the command was reached under, and it is
                     absent when there was none. On a completion request the engine puts the
                     partial word here instead.";
                ze:help "Peer context for the command";
            }
        }
        output {
            leaf status {
                type enumeration {
                    enum done { ze:help "Command completed successfully"; }
                    enum error { ze:help "Command failed"; }
                }
                description
                    "The engine reads error as a failed command and reports the data field
                     as its message. Any other value is passed through as the response status.";
                ze:help "Execution result status";
            }
            leaf data {
                type string;
                description
                    "On done, the bytes are the answer the engine passes to the operator without
                     decoding them. On error, the text is the message the operator reads.";
                ze:help "JSON result data or error message";
            }
        }
    }

    // Runtime: Route filter callback.

    rpc filter-update {
        ze:method "ze-plugin-callback:filter-update";
        description
            "The engine sends the routes queued for the plugin when the exchange starts,
             at most 64 (FilterUpdateBatchMax), and the plugin answers one verdict per
             route in request order, all within one 5 second timeout.";
        ze:help "Engine sends UPDATE attributes to a named filter plugin.";
        input {
            list routes {
                description
                    "One entry per route of the exchange, in the order the engine queued them:
                     routes from one source keep the order that source produced them.";
                ze:help "The routes of one exchange";
                leaf filter {
                    type string;
                    mandatory true;
                    description
                        "The name is the one the peer's filter block references, without the
                         plugin prefix. The engine reads the on-error policy and the declared reads from
                         the declaration of this name, or from a name-pattern it matches when none does.";
                    ze:help "Filter name (declared at stage 1)";
                }
                leaf direction {
                    type string;
                    mandatory true;
                    description
                        "The value is import for an UPDATE the peer sent and export for one Ze is
                         about to send. A teardown answer is honored on import alone.";
                    ze:help "import or export";
                }
                leaf peer {
                    type string;
                    mandatory true;
                    description
                        "The address of the peer the UPDATE was received from, or the peer it is
                         about to be sent to.";
                    ze:help "Peer IP address";
                }
                leaf peer-as {
                    type uint32;
                    mandatory true;
                    description
                        "The value is the AS number of that same peer, as a plain number.";
                    ze:help "Peer ASN";
                }
                leaf update {
                    type string;
                    mandatory true;
                    description
                        "The text is the chain's running result, so a modify an earlier filter
                         answered is already applied when this filter reads it. A modify this filter
                         answers is applied before the next filter runs. A chain that also holds
                         in-process filters sends the empty string: its filters read fields.";
                    ze:help "Text-format attributes and NLRI (only declared attributes; empty in a mixed chain)";
                }
                anyxml fields {
                    description
                        "A JSON object holding the route fields the filter declared it reads, keyed
                         by vocabulary field name, each value in the shape the UPDATE event's attr map
                         uses. A declared field the route does not carry is left out, and the member
                         is absent when the filter declared no route field. In a chain of plugin
                         filters alone, the values are the route as the chain received it: a modify
                         an earlier filter answered reaches this filter in update alone. In a chain
                         that also holds in-process filters, the values are the route as the earlier
                         members left it, their sets applied.";
                    ze:help "Declared route fields keyed by field name (JSON object)";
                }
                leaf raw {
                    type string;
                    description
                        "The bytes are the UPDATE body after the 19-byte header, base64 encoded
                         because the field is bytes on the wire. It is present when the filter
                         declared the raw entry in its reads and the engine holds the body.";
                    ze:help "Base64-encoded raw UPDATE body (if the filter's reads hold raw)";
                }
            }
        }
        output {
            list verdicts {
                description
                    "One entry per route, in request order. A reply with more or fewer
                     verdicts than routes is malformed: none is applied, and every route of the
                     batch takes the filter's on-error.";
                ze:help "One verdict per route, in request order";
                leaf action {
                    type enumeration {
                        enum accept { ze:help "Pass update unchanged"; }
                        enum reject { ze:help "Drop update, short-circuit chain"; }
                        enum modify { ze:help "Apply delta changes"; }
                        enum withdraw { ze:help "Remove the route: withdrawn on import, withdrawn toward the peer on export"; }
                    }
                    mandatory true;
                    description
                        "A withdraw removes the route rather than only stopping it: on import the
                         route is treated as withdrawn by the peer that sent it, on export it is
                         withdrawn toward the destination. It is answered by a filter the policy
                         chain runs as a member; a text-mode filter answering it fails under its
                         on-error. A value outside the four is read as reject, and the chain
                         records that the filter failed rather than decided.";
                    ze:help "Filter decision";
                }
                leaf update {
                    type string;
                    description
                        "The text names the attributes to change and nothing else. The engine
                         rejects the route when the delta touches an attribute the filter did not
                         declare.";
                    ze:help "Delta-only modified attributes (action=modify)";
                }
                leaf raw {
                    type string;
                    description
                        "The bytes replace the whole UPDATE body, base64 encoded like the input
                         field. The engine reads it on a modify answer alone.";
                    ze:help "Base64-encoded full raw UPDATE body replacement (action=modify with raw)";
                }
                list sets {
                    description
                        "Read on action=modify for a filter in a chain that also holds in-process
                         members. A set of a field the filter did not declare in its sets, an action
                         the field does not take, or a value of the wrong shape fails the route under
                         the filter's on-error, and none of the route's sets apply.";
                    ze:help "Route fields the filter changes (action=modify)";
                    leaf field {
                        type string;
                        mandatory true;
                        ze:help "Vocabulary field name (local-preference, med, community, as-path, prefix, family)";
                    }
                    leaf action {
                        type enumeration {
                            enum set { ze:help "Replace the value"; }
                            enum increment { ze:help "Add to the current value"; }
                            enum decrement { ze:help "Subtract from the current value"; }
                            enum add { ze:help "Add one value to a list field"; }
                            enum remove { ze:help "Remove one value: a community, private AS numbers, a prefix, a family"; }
                            enum prepend { ze:help "Prepend local AS copies to the AS path"; }
                        }
                        mandatory true;
                        ze:help "How the field changes";
                    }
                    anyxml value {
                        ze:help "The value in the field's shape: a number, a community, a mode, a prefix or a family";
                    }
                }
                leaf error {
                    type string;
                    description
                        "Set when the filter could not judge this route: the engine applies the
                         filter's on-error to this route alone and reads nothing else of the
                         verdict.";
                    ze:help "Why the filter could not judge the route";
                }
            }
        }
    }

    // Runtime: Independent read-only Go runtime inspection.

    rpc runtime-inspect {
        ze:method "ze-plugin-callback:runtime-inspect";
        ze:help "Inspect plugin Go runtime diagnostics independently of ordinary callbacks.";
        description "Runs on one SDK-owned bounded independent connection worker before the ordinary callback queue so inspection keeps answering even when a plugin event loop is blocked. Diagnostic saturation, deadline expiry, or collector errors never close the production connection.";
        input {
            leaf kind {
                type enumeration {
                    enum goroutines { ze:help "Capture bounded Go goroutine stack dump"; }
                    enum profile { ze:help "Capture bounded runtime/pprof profile"; }
                    enum log-recent { ze:help "Capture recent structured log entries from the plugin log ring"; }
                    enum runtime-stats { ze:help "Capture Go runtime memory and scheduler statistics"; }
                }
                mandatory true;
                ze:help "Runtime inspection kind";
                description "Selects which bounded read-only runtime snapshot to capture.";
            }
            leaf deadline-ms {
                type int64 { range "1..max"; }
                mandatory true;
                ze:help "Absolute inspection deadline in Unix milliseconds";
                description "Bounded to 65 seconds from admission. Expired requests are refused without invoking collectors.";
            }
            leaf profile-type {
                type enumeration {
                    enum cpu { ze:help "CPU execution profile"; }
                    enum heap { ze:help "Heap memory allocation profile"; }
                    enum goroutine { ze:help "Goroutine stack profile"; }
                    enum allocs { ze:help "Past memory allocations profile"; }
                    enum mutex { ze:help "Mutex contention profile"; }
                    enum block { ze:help "Goroutine blocking profile"; }
                }
                ze:help "Profile type when kind is profile";
                description "Required when kind is profile; selects the runtime/pprof profile to capture.";
            }
            leaf duration-ms {
                type int64 { range "0..60000"; }
                ze:help "CPU profile sampling duration in milliseconds";
                description "Used when kind is profile and profile-type is cpu. Zero selects the 10000 ms default; explicit values must be in 1000..60000.";
            }
            leaf log-level {
                type string;
                ze:help "Optional log level filter for log-recent";
                description "Exact log level name accepted by slogutil (debug, info, warn, error, or aliases).";
            }
            leaf log-component {
                type string;
                ze:help "Optional component filter for log-recent";
                description "Exact subsystem or component name to filter recent structured logs.";
            }
            leaf log-count {
                type uint32 { range "0..256"; }
                ze:help "Maximum number of log entries for log-recent";
                description "Zero selects the maximum of 256 entries.";
            }
        }
        output {
            leaf kind {
                type enumeration {
                    enum goroutines { ze:help "Bounded Go goroutine stack dump"; }
                    enum profile { ze:help "Bounded runtime/pprof profile"; }
                    enum log-recent { ze:help "Recent structured log entries"; }
                    enum runtime-stats { ze:help "Go runtime memory and scheduler statistics"; }
                }
                mandatory true;
                ze:help "Echoed inspection kind";
                description "Must match the requested input kind.";
            }
            leaf pid {
                type int32 { range "1..max"; }
                mandatory true;
                ze:help "OS process ID of the answering plugin";
                description "Positive process identifier returned by os.Getpid inside the answering process.";
            }
            leaf truncated {
                type boolean;
                ze:help "Whether payload was truncated to its wire size bound";
                description "True when goroutine-stacks hit 4 MiB or raw profile bytes hit 8 MiB.";
            }
            leaf goroutine-stacks {
                type string;
                ze:help "Raw runtime.Stack text for goroutines kind";
                description "Bounded to 4 MiB; truncated is set true if the buffer cap was reached.";
            }
            leaf profile-type {
                type string;
                ze:help "Captured profile type";
                description "Echoes the requested profile-type when kind is profile.";
            }
            leaf profile-count {
                type int32;
                ze:help "Sample count reported by pprof.Profile.Count";
                description "Populated for snapshot profiles (heap, goroutine, allocs, mutex, block).";
            }
            leaf profile-data {
                type string;
                ze:help "Base64-encoded pprof protobuf bytes";
                description "Raw pprof bytes are capped at 8 MiB before base64 encoding so the frame stays below 16 MiB.";
            }
            leaf sampling-rate {
                type int64;
                ze:help "Active runtime sampling rate for mutex or block profiles";
                description "Present for mutex (SetMutexProfileFraction) and block (BlockProfileRate) profiles, including explicit zero when disabled.";
            }
            list log-entries {
                ordered-by user;
                ze:help "Recent structured log entries newest-first";
                description "Up to 256 entries captured from the plugin's process-local slogutil log ring.";
                leaf timestamp {
                    type string;
                    ze:help "RFC3339 UTC timestamp";
                }
                leaf level {
                    type string;
                    ze:help "Log severity level";
                }
                leaf component {
                    type string;
                    ze:help "Subsystem or component name";
                }
                leaf message {
                    type string;
                    ze:help "Log message text";
                }
                anyxml attributes {
                    ze:help "Structured log attributes map";
                }
            }
            container runtime-stats {
                ze:help "Go runtime memory and scheduler vitals";
                description "Populated when kind is runtime-stats.";
                leaf alloc { type uint64; ze:help "Allocated heap bytes"; }
                leaf total-alloc { type uint64; ze:help "Cumulative allocated bytes"; }
                leaf sys { type uint64; ze:help "Total bytes obtained from the OS"; }
                leaf heap-alloc { type uint64; ze:help "Allocated heap bytes"; }
                leaf heap-sys { type uint64; ze:help "Heap bytes obtained from the OS"; }
                leaf heap-in-use { type uint64; ze:help "Bytes in in-use heap spans"; }
                leaf heap-objects { type uint64; ze:help "Number of allocated heap objects"; }
                leaf stack-in-use { type uint64; ze:help "Bytes in stack spans"; }
                leaf num-gc { type uint32; ze:help "Completed GC cycles"; }
                leaf gc-cpu-pct { type decimal64 { fraction-digits 6; } ze:help "Percentage of CPU spent in GC"; }
                leaf num-goroutines { type int32; ze:help "Current goroutine count"; }
                leaf num-cpu { type int32; ze:help "Logical CPU count"; }
                leaf max-procs { type int32; ze:help "Active GOMAXPROCS value"; }
                leaf go-version { type string; ze:help "Go runtime version string"; }
            }
        }
    }

    // Runtime: Read-only dataplane drift inspection.

    rpc drift-check {
        ze:method "ze-plugin-callback:drift-check";
        ze:help "Inspect intended versus actual dataplane state for one declared subsystem.";
        description "Called by the daemon to compare a plugin's intended configuration or in-memory state against programmed kernel or dataplane state. The callback is strictly read-only and must not mutate runtime state or raise report warnings.";
        input {
            leaf subsystem {
                type string;
                mandatory true;
                ze:help "Declared drift subsystem name";
                description "One of the drift-subsystems names declared by this plugin at Stage 1.";
            }
        }
        output {
            leaf subsystem {
                type string;
                mandatory true;
                ze:help "Checked drift subsystem name";
                description "Echoes the checked subsystem name.";
            }
            leaf status {
                type enumeration {
                    enum clean { ze:help "Intended and actual dataplane state match"; }
                    enum drifted { ze:help "One or more divergences detected"; }
                    enum unavailable { ze:help "Subsystem has no active checker or dataplane backend"; }
                    enum error { ze:help "Inspection failed before comparison completed"; }
                }
                mandatory true;
                ze:help "Drift check outcome";
                description "Summarizes whether intended and actual dataplane state agree.";
            }
            leaf checked {
                type int32;
                ze:help "Number of intended or programmed objects inspected";
                description "Total count of objects evaluated during this drift check.";
            }
            leaf drifted {
                type int32;
                ze:help "Total number of divergences detected";
                description "Total count of findings before truncation.";
            }
            leaf truncated {
                type boolean;
                ze:help "Whether findings were capped at the per-subsystem limit";
                description "True when more divergences existed than returned in findings.";
            }
            list findings {
                ordered-by user;
                ze:help "Bounded list of detected divergences";
                description "Individual missing, extra, or mismatched dataplane entries.";
                leaf subject {
                    type string;
                    mandatory true;
                    ze:help "Divergent object identifier";
                    description "Human-readable key naming the table, route, interface, or entry.";
                }
                leaf kind {
                    type enumeration {
                        enum missing { ze:help "Intended object is absent from the dataplane"; }
                        enum extra { ze:help "Unexpected Ze-owned object is present in the dataplane"; }
                        enum mismatch { ze:help "Dataplane object differs from intended attributes"; }
                    }
                    mandatory true;
                    ze:help "Divergence classification";
                    description "Classifies the difference between intended and actual state.";
                }
                leaf expected {
                    type string;
                    ze:help "Intended value";
                    description "Expected attribute or state when applicable.";
                }
                leaf actual {
                    type string;
                    ze:help "Observed dataplane value";
                    description "Actual attribute or state read from the dataplane when applicable.";
                }
                leaf detail {
                    type string;
                    ze:help "Additional diagnostic context";
                    description "Optional plain-text explanation of the divergence.";
                }
            }
            leaf error {
                type string;
                ze:help "Inspection error message";
                description "Populated when status is error to explain why the check could not complete.";
            }
        }
    }

    // Shutdown: Clean termination.

    rpc bye {
        ze:method "ze-plugin-callback:bye";
        description "Plugin should respond, then cleanup and exit with code 0.";
        ze:help "Engine requests the plugin to shut down cleanly.";
        input {
            leaf reason {
                type string;
                description
                    "The SDK hands the text to the plugin's bye handler. A plugin reads it to
                     tell a daemon stop from a restart, and nothing else reads it.";
                ze:help "Shutdown reason (e.g., shutdown, restart)";
            }
        }
    }

    // Error identities.

    identity configuration-failed {
        description "Configuration parsing or application failed";
    }

    identity encode-error {
        description "NLRI encoding failed";
    }

    identity decode-error {
        description "NLRI or capability decoding failed";
    }

    identity command-error {
        description "Command execution failed";
    }
}
