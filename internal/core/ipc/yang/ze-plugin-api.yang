module ze-plugin-api {
    namespace "urn:ze:plugin:api";
    prefix plug;

    description
        "Plugin lifecycle API operations for Ze.
         RPCs for plugin session management and health checking.";

    revision 2026-02-01 {
        description "Initial revision";
    }

    // Introspection

    rpc help {
        description "List the subcommands the plugin verb accepts.";
        output {
            leaf-list subcommands { type string; description "Available subcommands"; }
        }
    }

    rpc command-list {
        description "List every command a plugin registered, with its summary.";
        output {
            list command {
                leaf name { type string; description "Command name"; }
                leaf description { type string; description "Command description"; }
            }
        }
    }

    rpc command-help {
        description "Show one plugin command's summary, explanation, arguments, and source plugin.";
        input {
            leaf name { type string; mandatory true; description "Command name"; }
        }
        output {
            leaf help { type string; description "Detailed help text"; }
        }
    }

    rpc command-complete {
        description "List the completion candidates for a partial plugin command.";
        input {
            leaf partial { type string; mandatory true; description "Partial command string"; }
        }
        output {
            leaf-list completions { type string; description "Completion candidates"; }
        }
    }

    // Session lifecycle

    rpc session-ready {
        description "Signal that this plugin process finished its initialization.";
    }

    rpc session-peer-ready {
        description "Signal that this peer's plugin process finished its initialization.";
    }

    rpc session-ping {
        description "Answer a health check with the daemon process id.";
        output {
            leaf pong { type boolean; description "Always true when alive"; }
        }
    }

    rpc session-bye {
        description "Tell the daemon this session is disconnecting.";
    }
}
