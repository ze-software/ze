module ze-ospf-cmd {
    namespace "urn:ze:ospf:cmd";
    prefix ospfcmd;
    import ze-extensions { prefix ze; }
    description
        "show ospf ... command tree. Owned by the ospf component so removing it
         removes these command nodes together with the handlers in
         internal/plugins/ospf/cmd_show.go. The show subtree container-merges onto
         the generic show verb root; the wire methods bind into the CENTRAL ze-show
         namespace (Go-registered RPCs, the LDP/IS-IS model). Commands are
         object-rooted (no shared `ip` container); see
         docs/architecture/cli/command-namespacing.md and
         ai/rules/plugin-self-containment.md.";
    revision 2026-07-02 {
        description "Add the `request ospf graceful-restart` operator action (RFC 3623 planned
             restart trigger, spec-ospf-ext-9); add `show ospf instance` for OSPFv2
             Multi-Instance (RFC 6549, spec-ospf-ext-12).";
    }
    revision 2026-06-26 {
        description "Object-rooted: dropped the show/clear `ip` container so the tree is show ospf ... / clear ospf ... (was show ip ospf ...).";
    }
    revision 2026-06-21 {
        description "Initial revision: show ip ospf neighbor/interface/database/route/border-routers/spf (spec-ospf-13).";
    }

    container show {
        config false;
        description "Read-only commands to inspect system, protocol, and network state.";

        container ospf {
            config false;
            ze:command "ze-show:ospf";
            description "Show the OSPFv2 process summary (RFC 2328).";
            ze:help "Returns the router-id, the areas, the ABR and ASBR status, and the
stub-router (max-metric) state.";

            container instance {
                config false;
                ze:command "ze-show:ospf-instance";
                description "Show the configured OSPFv2 instances (RFC 6549 Multi-Instance).";
                ze:help "Lists each Instance ID with its router-id and the size of its isolated area,
interface, neighbor, and link-state database state.";
            }

            container graceful-restart {
                config false;
                ze:command "ze-show:ospf-graceful-restart";
                description "Show OSPFv2 (IPv4) Graceful Restart state (RFC 3623).";
                ze:help "The restarter state (in-restart or not, grace end, reason) and the
per-neighbor helper sessions (which neighbors are being helped and their
remaining grace).";
            }

            container segment-routing {
                config false;
                ze:command "ze-show:ospf-segment-routing";
                description "Show OSPFv2 (IPv4) Segment Routing state (RFC 8665).";
                ze:help "The configured SRGB/SRLB label ranges, the advertised SR-Algorithm,
this node's node Prefix-SIDs, and the Adjacency-SIDs allocated per adjacency.";
            }

            container ipv6 {
                config false;
                ze:command "ze-show:ospf-ipv6";
                description "Show the OSPFv3 (IPv6) address-family instances (RFC 5838).";
                ze:help "Lists each configured address family (ipv6-unicast, ipv6-multicast,
ipv4-unicast, ipv4-multicast) with its Instance ID, router-id, and
neighbor/interface counts, so multiple AF instances on a link are
distinguishable.";
                container interface {
                    config false;
                    ze:command "ze-show:ospf-ipv6-interface";
                    description "Show OSPFv3 (IPv6-family) interfaces and their RFC 4552 IPsec status.";
                    ze:help "Returns per interface whether IPsec is configured, the protocol (ah/esp) and
SPI, and whether the kernel SA is installed. The key is never shown.";
                    container detail {
                        config false;
                        ze:command "ze-show:ospfv3-interface-detail";
                        description "Show the full per-interface OSPFv3 state (spec-ospf-ext-14).";
                        ze:help "Returns the ISM state, the DR and BDR by Router ID, the timers, the
local Interface ID, and the Instance ID.";
                    }
                }
                container graceful-restart {
                    config false;
                    ze:command "ze-show:ospf-ipv6-graceful-restart";
                    description "Show OSPFv3 (IPv6) Graceful Restart state (RFC 5187).";
                    ze:help "The restarter state (in-restart or not, grace end, reason) and the
per-neighbor helper sessions (which neighbors are being helped and their
remaining grace).";
                }
                container segment-routing {
                    config false;
                    ze:command "ze-show:ospf-ipv6-segment-routing";
                    description "Show OSPFv3 (IPv6) Segment Routing state (RFC 8666).";
                    ze:help "The configured SRGB/SRLB label ranges, the advertised SR-Algorithm,
this node's node Prefix-SIDs, and the Adjacency-SIDs allocated per adjacency.";
                }
                container database {
                    config false;
                    ze:command "ze-show:ospfv3-database";
                    description "Show the OSPFv3 (IPv6) link-state database with each native scope-aware LSA decoded (RFC 5340).";
                    ze:help "Base types decode into named fields; unknown function codes fall back to a
scope-aware header + body-hex view (spec-ospf-ext-14).";
                    container detail {
                        config false;
                        ze:command "ze-show:ospfv3-database-detail";
                        description "Decode every OSPFv3 LSA body with its scope-aware header (RFC 5340 section A.4.2.1).";
                        ze:help "The parent command decodes the base types only. This form decodes
every LSA body. An unknown function code then arrives as a scope-aware header
beside its body hex, rather than as a named record.";
                    }
                    container router {
                        config false;
                        description "Router-LSAs (RFC 5340 section A.4.3).";
                        ze:help "RFC 5340 Appendix A.4.3 gives the Router-LSA area flooding scope and the LS
Type 0x2001. Ze reads the per-area store for it. The bare form lists the
headers, and the detail form below decodes each body.";
                        container detail {
                            config false;
                            ze:command "ze-show:ospfv3-database-router-detail";
                            description "Decode each OSPFv3 Router-LSA body.";
                            ze:help "Each body decodes into its interface records: the type, the metric, the
Interface ID, the neighbor Interface ID and the neighbor Router ID. RFC 5340
Section 2.2 states that a Router-LSA no longer contains a network address and
expresses topology only.";
                        }
                    }
                    container scope {
                        config false;
                        description "Filter the OSPFv3 database by RFC 5340 section A.4.2.1 flooding scope (S2/S1 bits).";
                        ze:help "RFC 5340 Section 2.3 defines three flooding scopes, and the LS Type field
carries them in its S2 and S1 bits. Link-local scope stops at the link, area
scope stops at one area, and AS scope reaches the whole routing domain. The
three commands below read one scope each.";
                        container link {
                            config false;
                            ze:command "ze-show:ospfv3-database-scope-link";
                            description "Show only link-local (S2/S1 = 00) LSAs, including the per-interface Link-LSA store.";
                            ze:help "Ze reads the per-interface Link-LSA store as well as the area store, so a
Link-LSA appears here beside its interface. RFC 5340 Section 2.3 states that a
link-local LSA is flooded on the local link and no further.";
                        }
                        container area {
                            config false;
                            ze:command "ze-show:ospfv3-database-scope-area";
                            description "Show only area-scope (S2/S1 = 01) LSAs.";
                            ze:help "RFC 5340 Section 2.3 gives area scope to the router-LSA, the network-LSA,
the inter-area-prefix-LSA, the inter-area-router-LSA and the
intra-area-prefix-LSA. Ze reads the per-area store for them.";
                        }
                        container as {
                            config false;
                            ze:command "ze-show:ospfv3-database-scope-as";
                            description "Show only AS-scope (S2/S1 = 10) LSAs.";
                            ze:help "RFC 5340 Section 2.3 states that an AS-scope LSA is flooded throughout the
routing domain, and that a router which originates one is an AS Boundary
Router. Ze reads the AS-wide store for it, and no area appears in the answer.";
                        }
                    }
                    container router-information {
                        config false;
                        ze:command "ze-show:ospfv3-database-router-information";
                        description "Show the OSPFv3 Router Information LSAs (RFC 7770).";
                        ze:help "The LSA carries function code 12. Each one decodes into its
capability bits and its TLVs.";
                    }
                    container extended {
                        config false;
                        ze:command "ze-show:ospfv3-database-extended";
                        description "Show the extended OSPFv3 LSAs (RFC 8362).";
                        ze:help "Covers E-Router, E-Network, E-Inter-Area, E-AS-External, E-Link and
E-Intra-Area-Prefix. Each LSA decodes into named TLVs.";
                    }
                    container segment-routing {
                        config false;
                        ze:command "ze-show:ospfv3-database-segment-routing";
                        description "Summarise the OSPFv3 Segment Routing content (RFC 8666) carried in the RI and extended LSAs.";
                        ze:help "This is a summary rather than a decode. The Segment Routing content lives in
the Router Information LSA and in the extended LSAs, and the two commands
above decode those LSAs in full.";
                    }
                }
                container instance {
                    config false;
                    ze:command "ze-show:ospfv3-instance";
                    description "Enumerate the active OSPFv3 address-family instances (RFC 5838 section 2).";
                    ze:help "Each instance carries its address family, its Instance ID, its area
count, and its neighbor count.";
                }
                container neighbor {
                    config false;
                    ze:command "ze-show:ospfv3-neighbor";
                    description "Show the OSPFv3 (IPv6) neighbors.";
                    ze:help "Each neighbor carries the link-local address as its identity, the
adjacency state, the DR and BDR by Router ID, and the dead time.";
                    container detail {
                        config false;
                        ze:command "ze-show:ospfv3-neighbor-detail";
                        description "Show the full per-neighbor OSPFv3 state (spec-ospf-ext-14).";
                        ze:help "Returns the advertised Interface ID, the DD sequence, the decoded
Options (R/V6/E/N/AF), the list sizes, the last NSM event, and the timers.";
                    }
                }
                container spf {
                    config false;
                    ze:command "ze-show:ospfv3-spf";
                    description "Show the OSPFv3 (IPv6) per-area SPF run history.";
                    ze:help "The history is read from the IPv6 unicast engine alone. Another
                             address family is not covered here. A router that runs no OSPFv3
                             engine answers an empty list rather than an error. That reads the
                             same as a router whose engine has run no SPF yet.";
                    container detail {
                        config false;
                        ze:command "ze-show:ospfv3-spf-detail";
                        description "Explain why each OSPFv3 route won (spec-ospf-ext-14), AF/Instance-ID tagged.";
                        ze:help "The command is read-only.";
                    }
                }
            }

            container neighbor {
                config false;
                ze:command "ze-show:ospf-neighbor";
                description "Show OSPF neighbors.";
                ze:help "Returns each neighbor's router-id, interface, adjacency state, DR/BDR,
priority, dead time, and address.";
                container detail {
                    config false;
                    ze:command "ze-show:ospf-neighbor-detail";
                    description "Show the full per-neighbor state (spec-ospf-ext-14).";
                    ze:help "Returns the DD sequence, the decoded Options including the RFC 5250
O-bit, the request and summary list sizes, the last NSM event, and the
timers.";
                }
            }

            container interface {
                config false;
                ze:command "ze-show:ospf-interface";
                description "Show OSPF-enabled interfaces.";
                ze:help "Returns area, network-type, cost, ISM state, DR/BDR, hello/dead intervals,
priority, and passive flag per interface.";
                container detail {
                    config false;
                    ze:command "ze-show:ospf-interface-detail";
                    description "Show the full per-interface state (spec-ospf-ext-14).";
                    ze:help "Returns the ISM state, the DR and BDR election detail, all three
timers, and the opaque-capable neighbor count.";
                }
            }

            container database {
                config false;
                ze:command "ze-show:ospf-database";
                description "Show the OSPF link-state database.";
                ze:help "Lists each LSA with its LS Type, Link State ID, Advertising Router, sequence
number, age, and checksum.";

                container router {
                    config false;
                    ze:command "ze-show:ospf-database-router";
                    description "Show only Router-LSAs (Type 1).";
                    ze:help "RFC 2328 Section 12.4.1 states that every router originates a Router-LSA.
The LSA describes the collected states of the router's interfaces to one area.
It is flooded throughout a single area only, and Ze reads the per-area store
for it.";
                }
                container network {
                    config false;
                    ze:command "ze-show:ospf-database-network";
                    description "Show only Network-LSAs (Type 2).";
                    ze:help "RFC 2328 Section 12.4.2 states that the Designated Router originates a
Network-LSA for a broadcast or NBMA network. The LSA lists the routers
connected to that network. It is flooded throughout a single area only. A
point-to-point link has no Designated Router, so it produces none.";
                }
                container summary {
                    config false;
                    ze:command "ze-show:ospf-database-summary";
                    description "Show only Summary-LSAs (Type 3, inter-area network).";
                    ze:help "RFC 2328 Section 12.4.3 states that an area border router originates a
Summary-LSA. A Type 3 Summary-LSA describes a route to a network outside the
area and inside the AS. Ze reads the per-area store for it.";
                }
                container asbr-summary {
                    config false;
                    ze:command "ze-show:ospf-database-asbr-summary";
                    description "Show only ASBR-Summary-LSAs (Type 4).";
                    ze:help "RFC 2328 Section 12.4.3 states that a Type 4 Summary-LSA describes a route
to an AS boundary router. A Type 3 describes a route to a network instead.
Both come from an area border router, and both are flooded through one area.";
                }
                container external {
                    config false;
                    ze:command "ze-show:ospf-database-external";
                    description "Show only AS-external-LSAs (Type 5).";
                    ze:help "RFC 2328 Section 12.4.4 states that an AS boundary router originates an
AS-external-LSA. The LSA describes a route to a destination in another
Autonomous System, and it is flooded throughout the AS. Ze reads the AS-wide
store for it, so no area appears in the answer.";
                }
                container nssa-external {
                    config false;
                    ze:command "ze-show:ospf-database-nssa-external";
                    description "Show only NSSA-external-LSAs (Type 7, RFC 3101).";
                    ze:help "RFC 3101 Section 2.3 states that a Type 7 LSA is advertised only within a
single NSSA. A border router does not flood it into the backbone. It
translates selected Type 7 LSAs into Type 5 instead, so a translated route
appears under the AS-external view and not here.";
                }
                container opaque-link {
                    config false;
                    ze:command "ze-show:ospf-database-opaque-link";
                    description "Show only link-local opaque-LSAs (Type 9, RFC 5250).";
                    ze:help "RFC 5250 Section 3 gives link-state type-9 a link-local scope. A
                             type-9 opaque LSA is not flooded beyond the local subnetwork. This
                             view is therefore per link. No other link holds an LSA listed here,
                             and no router past the local segment holds one.";
                    container detail {
                        config false;
                        ze:command "ze-show:ospf-database-opaque-link-detail";
                        description "Decode each link-local opaque LSA body (RFC 5250).";
                        ze:help "A body with a typed decoder returns its TLVs, which are TE,
Router-Information, Extended and Segment-Routing. Every other body returns a
generic type, length and hex view (spec-ospf-ext-14).";
                    }
                }
                container opaque-area {
                    config false;
                    ze:command "ze-show:ospf-database-opaque-area";
                    description "Show only area-scope opaque-LSAs (Type 10, RFC 5250).";
                    ze:help "RFC 5250 Section 3 gives link-state type-10 an area-local scope: a
                             type-10 opaque LSA is not flooded beyond the borders of its area.
                             So this view is per area, and an area border router does not carry
                             what it lists into the backbone.";
                    container detail {
                        config false;
                        ze:command "ze-show:ospf-database-opaque-area-detail";
                        description "Decode each area-scope opaque LSA body (RFC 5250).";
                        ze:help "A body with a typed decoder returns its TLVs, which are TE,
Router-Information, Extended and Segment-Routing. Every other body returns a
generic type, length and hex view (spec-ospf-ext-14).";
                    }
                }
                container opaque-as {
                    config false;
                    ze:command "ze-show:ospf-database-opaque-as";
                    description "Show only AS-scope opaque-LSAs (Type 11, RFC 5250).";
                    ze:help "RFC 5250 Section 3 floods link-state type-11 throughout the
                             autonomous system. It takes the scope of an AS-external (type-5)
                             LSA. A type-11 opaque LSA reaches every transit area. It is not
                             flooded into a stub area or an NSSA. A router does not originate
                             one into a connected stub area or NSSA. One received from a
                             neighbor inside such an area is rejected.";
                    container detail {
                        config false;
                        ze:command "ze-show:ospf-database-opaque-as-detail";
                        description "Decode each AS-scope opaque LSA body (RFC 5250).";
                        ze:help "A body with a typed decoder returns its TLVs, which are TE,
Router-Information, Extended and Segment-Routing. Every other body returns a
generic type, length and hex view (spec-ospf-ext-14).";
                    }
                }
                container router-information {
                    config false;
                    ze:command "ze-show:ospf-database-router-information";
                    description "Show the Router Information LSAs (RFC 7770) for both address families.";
                    ze:help "OSPFv2 opaque type 4 and OSPFv3 function code 12, decoded into the
advertised informational capability bits and the TLV list.";
                }
            }

            container te-database {
                config false;
                ze:command "ze-show:ospf-te-database";
                description "Show the OSPF Traffic Engineering Database (RFC 3630 / RFC 5392).";
                ze:help "Router addresses plus TE links with their Link ID, local/remote address,
link type, TE metric, bandwidths, admin group, and (for inter-AS links) remote
AS and remote ASBR.";
            }

            container route {
                config false;
                ze:command "ze-show:ospf-route";
                description "Show OSPF-computed routes.";
                ze:help "Lists each prefix with its path type (intra/inter/external-1/2), cost,
next-hops, and area.";

                container fast-reroute {
                    config false;
                    ze:command "ze-show:ospf-route-fast-reroute";
                    description "Show OSPF fast-reroute (LFA / TI-LFA) backups (RFC 5286).";
                    ze:help "Lists each prefix's primary next-hops with their pre-computed loop-free
backup, protection class (node/link/downstream), and TI-LFA repair label
stack. Unprotected primaries are shown as unprotected.";
                }
            }

            container virtual-links {
                config false;
                ze:command "ze-show:ospf-virtual-links";
                description "Show OSPF virtual links (RFC 2328 section 15).";
                ze:help "Lists each configured virtual link with its transit area, remote router-id,
adjacency state, computed cost, and transit next hop.";
            }

            container border-routers {
                config false;
                ze:command "ze-show:ospf-border-routers";
                description "Show routes to OSPF area-border and AS-boundary routers.";
                ze:help "Lists each reachable ABR/ASBR with its router-id, cost, next-hops, and area.";
            }

            container spf {
                config false;
                ze:command "ze-show:ospf-spf";
                description "Show recent OSPF SPF runs.";
                ze:help "Returns the most recent per-area SPF runs with their timestamp, duration, node
count, and pending state.";
                container detail {
                    config false;
                    ze:command "ze-show:ospf-spf-detail";
                    description "Explain why each route won the SPF calculation (spec-ospf-ext-14).";
                    ze:help "Returns the candidate paths considered for each prefix, the winning
cost, and the RFC 2328 section 16.4 path-preference tie-break. The command is
read-only, so the route table and the SPF run count do not change.";
                }
            }

            container ldp-sync {
                config false;
                ze:command "ze-show:ospf-ldp-sync";
                description "Show OSPF LDP-IGP synchronization state (RFC 5443, RFC 6138).";
                ze:help "Lists each ldp-sync interface with its state (not-synchronized / hold-down /
synchronized), remaining hold-down, effective metric, and whether it is stuck
not-synchronized after having been synchronized.";
            }
        }
    }

    container clear {
        config false;

        container ospf {
            config false;
            description "Reset OSPF runtime state without reconfiguring.";
            ze:help "The subcommands drop adjacencies, zero counters or restart the process. None of
                     them edits the configuration, so a cleared router rebuilds the same state it held
                     before.";

            container process {
                config false;
                ze:command "ze-clear:ospf-process";
                description "Full OSPF reset: tear down every adjacency and re-run SPF.";
                ze:help "Adjacencies re-form from the next Hello; the configuration is unchanged.";
            }

            container neighbor {
                config false;
                ze:command "ze-clear:ospf-neighbor";
                description "Tear down every OSPF adjacency so neighbors re-form.";
                ze:help "Adjacencies re-learn from the next Hello.";
            }

            container counters {
                config false;
                ze:command "ze-clear:ospf-counters";
                description "Reset the OSPF SPF-run history.";
                ze:help "Monotonic Prometheus series are not reset; the SPF-run log is cleared.";
            }
        }
    }

    container request {
        config false;

        container ospf {
            config false;
            description "OSPFv2 operational actions (RFC 2328).";
            ze:help "The actions run against the live process and change no configuration. A router
                     restarted after one of them comes back to the state its config describes.";

            container graceful-restart {
                config false;
                ze:command "ze-ospf:graceful-restart-prepare";
                description "Trigger a planned OSPFv2 graceful restart (RFC 3623 section 2.1).";
                ze:help "The engine originates one Grace-LSA per interface, persists the non-volatile
restart fact, and suppresses route churn so the FIB is retained across the
ensuing control-plane restart. Refused when graceful-restart is not
configured.";
            }
        }
    }

    container debug {
        config false;
        description "OSPF debug LSA injection (spec-ospf-ext-14).";
        ze:help "Denied by the read-only authz profile and off by default; a testing/research
facility that injects a crafted LSA into this router's LSDB, which then floods
normally.";

        container ip {
            config false;
            description "IPv4 OSPF debug commands.";
            ze:help "These act on OSPFv2 alone. The OSPFv3 equivalents are under debug ipv6, and the
                     controls that hold for both families are under debug ospf.";
            container ospf {
                config false;
                description "OSPFv2 debug commands.";
                ze:help "The scope is the IPv4 address family. A router that also runs OSPFv3 keeps that
                         instance untouched by anything here.";
                container inject {
                    config false;
                    description "Inject crafted OSPFv2 LSAs for testing.";
                    ze:help "Injection is refused until debug ospf inject is enabled, so the command cannot
                             fire on a router nobody armed. It exists to drive a decoder against an LSA a real
                             neighbor is unlikely to send.";
                    container opaque {
                        config false;
                        ze:command "ze-debug:ospf-inject";
                        description "Inject a crafted IPv4 opaque LSA into the local LSDB (RFC 5250).";
                        ze:help "The default Opaque Type is Private-Use so a test LSA never collides with a
standards-track consumer. Requires `debug ospf inject enable`.";

                        container scope {
                            config false;
                            ze:modifier "required";
                            description "Flooding scope of the injected LSA.";
                            ze:help "The keyword is required and takes link, area or as. Any other word is
refused. For link scope Ze uses the first configured interface.";
                            leaf scope {
                                type enumeration {
                                    enum link;
                                    enum area;
                                    enum as;
                                }
                                mandatory true;
                                description "Link-local, area, or AS flooding scope.";
                            }
                        }
                        container id {
                            config false;
                            ze:modifier "required";
                            description "Opaque ID of the injected LSA.";
                            ze:help "The keyword is required and the value is a 24-bit number, so 16777215 is the
largest. A larger number is refused with 'opaque id exceeds 24 bits (max
16777215)'.";
                            leaf opaque-id {
                                type uint32 {
                                    range "0..16777215";
                                }
                                mandatory true;
                                description "24-bit Opaque ID (RFC 5250 Appendix A.2).";
                            }
                        }
                        container type {
                            config false;
                            ze:modifier "once";
                            description "Opaque Type of the injected LSA.";
                            ze:help "Defaults to a Private-Use type so a test LSA never collides with a
standards-track consumer.";
                            leaf type {
                                type uint8 {
                                    range "128..255";
                                }
                                mandatory true;
                                description "Private-Use Opaque Type (RFC 5250 Section 9).";
                            }
                        }
                        container hex {
                            config false;
                            ze:modifier "repeat";
                            description "Raw body octets, appended in the order supplied.";
                            ze:help "Repeat the keyword to append more octets, and mix it with tlv freely: the
body grows in the order the keywords are typed. Ze refuses a body longer than
the LSA maximum, which is 65535 bytes minus the 20-octet header.";
                            leaf body {
                                type string {
                                    pattern "[0-9a-fA-F]*";
                                }
                                mandatory true;
                                description "Body octets as hex.";
                            }
                        }
                        container tlv {
                            config false;
                            ze:modifier "repeat";
                            description "One 4-octet-aligned opaque TLV, appended to the body.";
                            ze:help "Ze builds the TLV from a decimal type and a hex value. It writes the
2-byte type and the 2-byte length, then pads the result with zeros to a
multiple of 4 octets. Repeat the keyword to append more TLVs.";
                            leaf type {
                                type uint16;
                                mandatory true;
                                description "TLV type.";
                            }
                            leaf value-hex {
                                type string {
                                    pattern "[0-9a-fA-F]*";
                                }
                                mandatory true;
                                description "TLV value as hex.";
                            }
                        }
                        container withdraw {
                            config false;
                            ze:modifier "once";
                            description "MaxAge-flush the LSA instead of originating it.";
                            ze:help "Ze reoriginates the LSA at MaxAge, which is what tells the neighbors to
remove it. The scope and the id still select which LSA goes, so pass the same
pair the origination used.";
                        }
                    }
                }
            }
        }

        container ipv6 {
            config false;
            description "IPv6 OSPF debug commands.";
            ze:help "These act on OSPFv3 alone. The OSPFv2 equivalents are under debug ip, and the
                     controls that hold for both families are under debug ospf.";
            container ospf {
                config false;
                description "OSPFv3 debug commands.";
                ze:help "The scope is the IPv6 address family. A router that also runs OSPFv2 keeps that
                         instance untouched by anything here.";
                container inject {
                    config false;
                    description "Inject crafted OSPFv3 LSAs for testing.";
                    ze:help "Injection is refused until debug ospf inject is enabled, so the command cannot
                             fire on a router nobody armed. It exists to drive a decoder against an LSA a real
                             neighbor is unlikely to send.";
                    container lsa {
                        config false;
                        ze:command "ze-debug:ospfv3-inject";
                        description "Inject a crafted OSPFv3 LSA into the local LSDB (RFC 5340).";
                        ze:help "The flooding scope is derived from the LS Type S2/S1 bits (a reserved scope is
rejected). Requires `debug ospf inject enable`.";

                        container type {
                            config false;
                            ze:modifier "required";
                            description "LS Type of the injected LSA.";
                            ze:help "Its S2/S1 bits carry the flooding scope, which is why the scope keyword is a
cross-check and not the source.";
                            leaf ls-type {
                                type string {
                                    pattern "(0[xX])?[0-9a-fA-F]{1,4}";
                                }
                                mandatory true;
                                description "16-bit LS Type in hex, such as 0x2009.";
                            }
                        }
                        container id {
                            config false;
                            ze:modifier "required";
                            description "Link State ID of the injected LSA.";
                            ze:help "The keyword is required and the value is a 32-bit number. The Link State ID
and the LS Type together select the LSA. A withdraw MUST repeat the same pair
the origination used.";
                            leaf link-state-id {
                                type uint32;
                                mandatory true;
                                description "32-bit Link State ID.";
                            }
                        }
                        container scope {
                            config false;
                            ze:modifier "once";
                            description "Cross-check on the scope the LS Type states.";
                            ze:help "Supplying a scope that disagrees with the LS Type is refused; supplying none
accepts the LS Type.";
                            leaf scope {
                                type enumeration {
                                    enum link;
                                    enum area;
                                    enum as;
                                }
                                mandatory true;
                                description "Link-local, area, or AS flooding scope.";
                            }
                        }
                        container hex {
                            config false;
                            ze:modifier "repeat";
                            description "Raw body octets, appended in the order supplied.";
                            ze:help "Repeat the keyword to append more octets, and the body grows in the order
the keywords are typed. OSPFv3 takes no tlv keyword here, so a structured body
is written as hex.";
                            leaf body {
                                type string {
                                    pattern "[0-9a-fA-F]*";
                                }
                                mandatory true;
                                description "Body octets as hex.";
                            }
                        }
                        container withdraw {
                            config false;
                            ze:modifier "once";
                            description "MaxAge-flush the LSA instead of originating it.";
                            ze:help "Ze reoriginates the LSA at MaxAge, which is what tells the neighbors to
remove it. A link-local LSA is withdrawn from the per-interface store, and any
other scope is withdrawn from the backbone area store.";
                        }
                    }
                }
            }
        }

        container ospf {
            config false;
            description "Address-family-independent OSPF debug controls.";
            ze:help "What is set here holds for OSPFv2 and OSPFv3 together. A control that binds one
                     family alone lives under debug ip or debug ipv6.";
            container inject {
                config false;
                description "Enable or disable OSPF debug LSA injection.";
                ze:help "It is the arming switch both injection commands read. Injection stays refused
                         while it is off, so a router is never one typo away from a crafted LSA.";
                container enable {
                    config false;
                    ze:command "ze-debug:ospf-inject-enable";
                    description "Enable OSPF debug LSA injection (shared across both address families).";
                    ze:help "Off by default.";
                }
                container disable {
                    config false;
                    ze:command "ze-debug:ospf-inject-disable";
                    description "Disable OSPF debug LSA injection.";
                    ze:help "One flag covers both address families, so this stops IPv4 and IPv6
injection together. An inject after it fails with 'debug injection not enabled
(run `debug ospf inject enable`)'. The flag is never written to the config, so
a reboot returns the router to injection off.";
                }
            }
        }
    }
}
