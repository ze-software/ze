module ze-skills-cmd {
    namespace "urn:ze:skills:cmd";
    prefix skillscmd;
    import ze-extensions { prefix ze; }
    description "The show skills and show skill commands, owned by the skills plugin, which registers their handlers. See the plugin self-containment rule.";
    revision 2026-10-12 { description "Rename skills list and skills get to show skills and show skill: the first word of a command is its verb."; }
    revision 2026-10-08 { description "Initial: declare the skills command the skills plugin already served."; }

    container show {
        config false;
        ze:help "Read-only commands to inspect system, protocol, and network state.";

        container skills {
            config false;
            ze:command "ze-skills:show-skills";
            description "Each skill is a Markdown document bundled with the binary, so it always
matches the running version. Prints each bundled skill with its one-line description.";
            ze:help "List the agent skills this binary carries.";
        }

        container skill {
            config false;
            ze:command "ze-skills:show-skill";
            description "Prints the named skill's Markdown document.";
            ze:help "Fetch one bundled agent skill by name.";
            leaf name {
                type string { length "1..64"; }
                mandatory true;
                description "A skill name as show skills prints it. An unknown name is refused.";
                ze:help "Skill name.";
            }
        }
    }
}
