module ze-support-cmd {
    namespace "urn:ze:support:cmd";
    prefix supportcmd;
    import ze-extensions { prefix ze; }
    description "The support command, owned by the support plugin, which registers its handler. See the plugin self-containment rule.";
    revision 2026-10-08 { description "Initial: declare the support command the support plugin already served."; }

    container support {
        config false;
        ze:command "ze-support:support";
        description "The archive holds logs, config, state and diagnostics, and is what to send
when you report an issue. Secrets are redacted unless asked for. Modules can be selected
or excluded, and a time window narrows the logs the archive holds.";
        ze:help "Collect logs, config, state and diagnostics into one archive.";
    }
}
