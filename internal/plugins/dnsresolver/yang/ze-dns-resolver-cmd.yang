module ze-dns-resolver-cmd {
    namespace "urn:ze:dns-resolver:cmd";
    prefix dnsrescmd;

    import ze-extensions { prefix ze; }

    description
        "show dns-resolver and clear dns-resolver cache all. Owned by the
         dnsresolver plugin because both handlers read or reset the resolver's
         live state. See ai/rules/plugin-self-containment.md.";

    revision 2026-10-27 {
        description "Initial revision";
    }

    container show {
        config false;

        container dns-resolver {
            config false;
            ze:command "ze-dnsresolver:show-dns-resolver";
            description "Enabled, mode, listeners, allow-from count, upstreams, limits, the
answer and negative cache entry counts, cache hits, misses and hit rate, the queries
refused (by reason), rate-limited and dropped, and the upstream exchanges by result.";
            ze:help "LAN DNS resolver status, cache and counters.";
        }
    }

    container clear {
        config false;

        container dns-resolver {
            config false;
            ze:help "LAN DNS resolver clearing operations.";

            container cache {
                config false;
                description "Clear dns-resolver cache alone is refused: say all to empty the
answer and the negative cache. Emptying is never the default.";
                ze:help "LAN DNS resolver cache clearing operations: all.";

                container all {
                    config false;
                    ze:command "ze-dnsresolver:clear-dns-resolver-cache";
                    description "Empties the answer and the negative cache, so the next query for any
name goes upstream. The counters are kept.";
                    ze:help "Empty every LAN DNS resolver cache.";
                }
            }
        }
    }
}
