module ze-traffic-cmd {
    namespace "urn:ze:traffic:cmd";
    prefix trafficcmd;
    import ze-extensions { prefix ze; }
    description "show traffic control (QoS) command. Owned by the traffic component because the handler reads traffic.GetBackend(). Container-merges onto the show verb root under the shared `traffic` namespace. See ai/rules/plugin-self-containment.md.";
    revision 2026-07-02 { description "Nest under show traffic control (was show traffic); traffic becomes a namespace shared with show traffic usage."; }
    revision 2026-06-03 { description "Relocate show traffic out of the central show schema into the traffic component (plugin self-containment)."; }

    container show {
        config false;
        description "Read-only commands to inspect system, protocol, and network state.";

        container traffic {
            config false;
            description "Traffic subsystem: QoS control and byte-usage accounting.";

            container control {
                config false;
                ze:command "ze-show:traffic";
                description "Show traffic control (QoS) configuration per interface.";
                ze:help "Without arguments, lists every interface with its qdisc type and class/filter
counts. With an interface name, shows the full qdisc and class breakdown. Use
this to verify your shaping is applied.";
            }
        }
    }
}
