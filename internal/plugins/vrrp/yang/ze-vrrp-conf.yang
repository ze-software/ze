module ze-vrrp-conf {
    namespace "urn:ze:vrrp:conf";
    prefix vrrp;

    import ze-types { prefix zt; }
    import ze-extensions { prefix ze; }
    import ze-iface-conf { prefix iface; }

    description
        "VRRP (Virtual Router Redundancy Protocol) configuration for Ze:
         RFC 9568 (VRRPv3, default) and RFC 3768 (VRRPv2, opt-in for IPv4).
         Attaches under an interface unit's ipv4/ipv6 container as
         `vrrp { group <vrid> { ... } }`. The vrrp container carries
         ze:backend \"netlink\" so the iface backend gate rejects it under a
         VPP-backed interface tree until native VPP VRRP lands (spec-vrrp-7).
         VRID namespaces are independent per family (RFC 9568 separate virtual
         routers). Cross-leaf constraints (interval-vs-version, IPv6 first-VIP
         link-local, owner detection, duplicate-VIP) live in the plugin
         verifier, not per-leaf, because they need sibling context.";

    revision 2026-07-15 {
        description "Initial revision (spec-vrrp-5).";
    }

    grouping vrrp-group-ipv4 {
        description "VRRP groups on an IPv4 interface unit (RFC 9568 / RFC 3768).";

        container vrrp {
            ze:backend "netlink";
            description "VRRP virtual routers hosted on this IPv4 unit.";

            list group {
                key "name";
                description "One virtual router, identified by an operator-assigned name.
                             The name is a config label only and is never sent on the wire;
                             the VRID leaf carries the protocol identity.";

                leaf name {
                    type zt:node-name;
                    description "Config-level group name (free-form label, used as list key).
                                 Not sent on the wire.";
                }

                leaf vrid {
                    type uint8 {
                        range "1..255";
                    }
                    mandatory true;
                    description "Virtual Router Identifier (RFC 9568 Section 5.2.3). Unique per
                                 interface unit and address family; the IPv4 and IPv6 VRID
                                 spaces are independent.";
                }

                leaf-list virtual-address {
                    type zt:ipv4-address;
                    min-elements 1;
                    max-elements 16;
                    ze:syntax "bracket";
                    description "Virtual IPv4 addresses, encoded on the wire in
                                 configuration order (RFC 9568 Section 5.2.9).
                                 An address equal to a real address on this unit
                                 makes this router the owner (priority forced to
                                 255, accept-mode forced true).";
                }

                leaf priority {
                    type uint8 {
                        range "1..254";
                    }
                    default 100;
                    description "Election priority (RFC 9568 Section 5.2.4). 255 is
                                 reserved for the address owner and assigned
                                 automatically; it is never operator-set.";
                }

                leaf preempt {
                    type boolean;
                    default "true";
                    description "Preempt_Mode (RFC 9568 Section 6.4.2): a higher-priority
                                 Backup takes over from a live lower-priority Active router.";
                }

                leaf preempt-delay-seconds {
                    type uint16 {
                        range "0..3600";
                    }
                    default 0;
                    description "Preemption hold-time (Junos semantics; not in RFC 9568).
                                 Armed on the first losing advert while a higher-priority
                                 local router waits; never delays dead-master failover.";
                }

                leaf advertise-interval-milliseconds {
                    type uint32 {
                        range "10..255000";
                    }
                    default 1000;
                    description "Advertisement interval in milliseconds. The native range
                                 spans both versions; the plugin verifier narrows it per
                                 version. v3: multiples of 10 ms within 10..40950 (wire =
                                 centiseconds, RFC 9568 erratum 8301). v2: whole seconds
                                 within 1000..255000 (wire = seconds).";
                }

                leaf version {
                    type enumeration {
                        enum "2" {
                            value 2;
                            description "RFC 3768 (VRRPv2), IPv4 only, auth type 0 only.";
                        }
                        enum "3" {
                            value 3;
                            description "RFC 9568 (VRRPv3).";
                        }
                    }
                    default "3";
                    description "Protocol version. Present only for IPv4 groups; IPv6 is
                                 always VRRPv3 (RFC 9568).";
                }

                leaf accept-mode {
                    type boolean;
                    default "false";
                    description "Accept_Mode (RFC 9568 Section 6.1/6.4.3): a non-owner
                                 Active accepts packets addressed to the virtual addresses.
                                 v3 semantics only; combining true with version 2 is
                                 rejected by the plugin verifier. Enforced on the
                                 dataplane: with false on a non-owner, the router still
                                 answers ARP and Neighbor Discovery for the virtual
                                 addresses and still forwards for the virtual MAC, but
                                 does not accept packets addressed to them, so a ping to
                                 a virtual address gets no reply. The address owner
                                 accepts whatever this leaf says.";
                }
            }
        }
    }

    grouping vrrp-group-ipv6 {
        description "VRRP groups on an IPv6 interface unit (RFC 9568 only).";

        container vrrp {
            ze:backend "netlink";
            description "VRRP virtual routers hosted on this IPv6 unit.";

            list group {
                key "name";
                description "One virtual router, identified by an operator-assigned name.
                             The name is a config label only and is never sent on the wire;
                             the VRID leaf carries the protocol identity.";

                leaf name {
                    type zt:node-name;
                    description "Config-level group name (free-form label, used as list key).
                                 Not sent on the wire.";
                }

                leaf vrid {
                    type uint8 {
                        range "1..255";
                    }
                    mandatory true;
                    description "Virtual Router Identifier (RFC 9568 Section 5.2.3). Unique per
                                 interface unit and address family; the IPv4 and IPv6 VRID
                                 spaces are independent.";
                }

                leaf-list virtual-address {
                    type zt:ipv6-address;
                    min-elements 1;
                    max-elements 16;
                    ze:syntax "bracket";
                    description "Virtual IPv6 addresses, encoded on the wire in
                                 configuration order. The FIRST address MUST be an IPv6
                                 link-local (fe80::/10) address: it is the advertisement
                                 source identity (RFC 9568 Section 5.2.9, erratum 8300),
                                 enforced by the plugin verifier.";
                }

                leaf priority {
                    type uint8 {
                        range "1..254";
                    }
                    default 100;
                    description "Election priority (RFC 9568 Section 5.2.4). 255 is
                                 reserved for the address owner and assigned automatically.";
                }

                leaf preempt {
                    type boolean;
                    default "true";
                    description "Preempt_Mode (RFC 9568 Section 6.4.2).";
                }

                leaf preempt-delay-seconds {
                    type uint16 {
                        range "0..3600";
                    }
                    default 0;
                    description "Preemption hold-time (Junos semantics; not in RFC 9568).";
                }

                leaf advertise-interval-milliseconds {
                    type uint32 {
                        range "10..40950";
                    }
                    default 1000;
                    description "Advertisement interval in milliseconds, multiples of 10 ms
                                 (wire = centiseconds, RFC 9568 erratum 8301).";
                }

                leaf accept-mode {
                    type boolean;
                    default "false";
                    description "Accept_Mode (RFC 9568 Section 6.1/6.4.3), v3 semantics.";
                }
            }
        }
    }

    augment "/iface:interface/iface:ethernet/iface:unit/iface:ipv4" {
        uses vrrp-group-ipv4;
    }

    augment "/iface:interface/iface:ethernet/iface:unit/iface:ipv6" {
        uses vrrp-group-ipv6;
    }

    augment "/iface:interface/iface:veth/iface:unit/iface:ipv4" {
        uses vrrp-group-ipv4;
    }

    augment "/iface:interface/iface:veth/iface:unit/iface:ipv6" {
        uses vrrp-group-ipv6;
    }

    augment "/iface:interface/iface:bridge/iface:unit/iface:ipv4" {
        uses vrrp-group-ipv4;
    }

    augment "/iface:interface/iface:bridge/iface:unit/iface:ipv6" {
        uses vrrp-group-ipv6;
    }

    augment "/iface:interface/iface:dummy/iface:unit/iface:ipv4" {
        uses vrrp-group-ipv4;
    }

    augment "/iface:interface/iface:dummy/iface:unit/iface:ipv6" {
        uses vrrp-group-ipv6;
    }
}
