module ze-vrrp-conf {
    namespace "urn:ze:vrrp:conf";
    prefix vrrp;

    import ze-types { prefix zt; }
    import ze-extensions { prefix ze; }
    import ze-iface-conf { prefix iface; }

    description
        "VRRP (Virtual Router Redundancy Protocol) configuration for Ze:
         RFC 9568 (VRRPv3, default) and RFC 3768 (VRRPv2, opt-in for IPv4).
         Attaches under an interface unit's ipv4/ipv6 container as
         `vrrp { group <vrid> { ... } }`. The vrrp container carries
         ze:backend \"netlink\" so the iface backend gate rejects it under a
         VPP-backed interface tree until native VPP VRRP lands (spec-vrrp-7).
         VRID namespaces are independent per family (RFC 9568 separate virtual
         routers). Cross-leaf constraints (interval-vs-version, IPv6 first-VIP
         link-local, owner detection, duplicate-VIP) live in the plugin
         verifier, not per-leaf, because they need sibling context.";

    revision 2026-07-15 {
        description "Initial revision (spec-vrrp-5).";
    }

    grouping vrrp-group-ipv4 {
        description "VRRP groups on an IPv4 interface unit (RFC 9568 / RFC 3768).";

        container vrrp {
            ze:backend "netlink";
            description "VRRP virtual routers hosted on this IPv4 unit.";

            list group {
                key "name";
                description "One virtual router, identified by an operator-assigned name.";
                ze:help "The name is a config label only, and Ze never sends it on
                         the wire. The VRID leaf carries the protocol identity.";

                leaf name {
                    type zt:node-name;
                    description "Config-level group name (free-form label, used as list key).
                                 Not sent on the wire.";
                }

                leaf vrid {
                    type uint8 {
                        range "1..255";
                    }
                    mandatory true;
                    description "Virtual Router Identifier (RFC 9568 Section 5.2.3).";
                    ze:help "The VRID is unique per interface unit and per address
                             family. The IPv4 VRID space and the IPv6 VRID space
                             are independent.";
                }

                leaf-list virtual-address {
                    type zt:ipv4-address;
                    min-elements 1;
                    max-elements 16;
                    ze:syntax "bracket";
                    description "Virtual IPv4 addresses, encoded on the wire in configuration order.";
                    ze:help "RFC 9568 Section 5.2.9 sets the wire order, which is
                             the configuration order. An address equal to a real
                             address on this unit makes this router the owner. Ze
                             then forces the priority to 255, and forces
                             accept-mode to true.";
                }

                leaf priority {
                    type uint8 {
                        range "1..254";
                    }
                    default 100;
                    description "Election priority (RFC 9568 Section 5.2.4).";
                    ze:help "255 is reserved for the address owner, and Ze assigns
                             it automatically. An operator never sets it.";
                }

                leaf preempt {
                    type boolean;
                    default "true";
                    description "Preempt_Mode (RFC 9568 Section 6.4.2).";
                    ze:help "A Backup router with a higher priority takes over from
                             a live Active router with a lower priority.";
                }

                leaf preempt-delay-seconds {
                    type uint16 {
                        range "0..3600";
                    }
                    default 0;
                    description "Preemption hold-time, in Junos semantics.";
                    ze:help "RFC 9568 does not define this hold-time. Ze arms it on
                             the first losing advertisement while a local router
                             with a higher priority waits. It never delays failover
                             from a dead Active router.";
                }

                leaf advertise-interval-milliseconds {
                    type uint32 {
                        range "10..255000";
                    }
                    default 1000;
                    description "Advertisement interval in milliseconds.";
                    ze:help "The native range spans both versions, and the plugin
                             verifier narrows it per version. Version 3 takes
                             multiples of 10 ms within 10..40950, and the wire
                             carries centiseconds (RFC 9568 erratum 8301). Version
                             2 takes whole seconds within 1000..255000, and the
                             wire carries seconds.";
                }

                leaf version {
                    type enumeration {
                        enum "2" {
                            value 2;
                            description "RFC 3768 (VRRPv2), IPv4 only, auth type 0 only.";
                        }
                        enum "3" {
                            value 3;
                            description "RFC 9568 (VRRPv3).";
                        }
                    }
                    default "3";
                    description "Protocol version.";
                    ze:help "The leaf is present only for an IPv4 group. An IPv6
                             group is always VRRPv3 (RFC 9568).";
                }

                leaf accept-mode {
                    type boolean;
                    default "false";
                    description "Accept_Mode (RFC 9568 Sections 6.1 and 6.4.3).";
                    ze:help "A non-owner Active router accepts packets addressed to
                             the virtual addresses. The leaf carries version 3
                             semantics only, and the plugin verifier rejects true
                             beside version 2.
                             The dataplane enforces the leaf. With false on a
                             non-owner, the router still answers ARP and Neighbor
                             Discovery for the virtual addresses, and still
                             forwards for the virtual MAC. It does not accept
                             packets addressed to them, so a ping to a virtual
                             address gets no reply. The address owner accepts
                             whatever this leaf says.";
                }
            }
        }
    }

    grouping vrrp-group-ipv6 {
        description "VRRP groups on an IPv6 interface unit (RFC 9568 only).";

        container vrrp {
            ze:backend "netlink";
            description "VRRP virtual routers hosted on this IPv6 unit.";

            list group {
                key "name";
                description "One virtual router, identified by an operator-assigned name.";
                ze:help "The name is a config label only, and Ze never sends it on
                         the wire. The VRID leaf carries the protocol identity.";

                leaf name {
                    type zt:node-name;
                    description "Config-level group name (free-form label, used as list key).
                                 Not sent on the wire.";
                }

                leaf vrid {
                    type uint8 {
                        range "1..255";
                    }
                    mandatory true;
                    description "Virtual Router Identifier (RFC 9568 Section 5.2.3).";
                    ze:help "The VRID is unique per interface unit and per address
                             family. The IPv4 VRID space and the IPv6 VRID space
                             are independent.";
                }

                leaf-list virtual-address {
                    type zt:ipv6-address;
                    min-elements 1;
                    max-elements 16;
                    ze:syntax "bracket";
                    description "Virtual IPv6 addresses, encoded on the wire in configuration order.";
                    ze:help "The FIRST address MUST be an IPv6 link-local address
                             in fe80::/10, because it is the advertisement source
                             identity (RFC 9568 Section 5.2.9, erratum 8300). The
                             plugin verifier enforces it.";
                }

                leaf priority {
                    type uint8 {
                        range "1..254";
                    }
                    default 100;
                    description "Election priority (RFC 9568 Section 5.2.4).";
                    ze:help "255 is reserved for the address owner, and Ze assigns
                             it automatically.";
                }

                leaf preempt {
                    type boolean;
                    default "true";
                    description "Preempt_Mode (RFC 9568 Section 6.4.2).";
                }

                leaf preempt-delay-seconds {
                    type uint16 {
                        range "0..3600";
                    }
                    default 0;
                    description "Preemption hold-time, in Junos semantics.";
                    ze:help "RFC 9568 does not define this hold-time. Ze takes the
                             behavior from Junos.";
                }

                leaf advertise-interval-milliseconds {
                    type uint32 {
                        range "10..40950";
                    }
                    default 1000;
                    description "Advertisement interval in milliseconds.";
                    ze:help "The value is a multiple of 10 ms. The wire carries
                             centiseconds (RFC 9568 erratum 8301).";

                }

                leaf accept-mode {
                    type boolean;
                    default "false";
                    description "Accept_Mode (RFC 9568 Section 6.1/6.4.3), v3 semantics.";
                }
            }
        }
    }

    augment "/iface:interface/iface:ethernet/iface:unit/iface:ipv4" {
        uses vrrp-group-ipv4;
    }

    augment "/iface:interface/iface:ethernet/iface:unit/iface:ipv6" {
        uses vrrp-group-ipv6;
    }

    augment "/iface:interface/iface:veth/iface:unit/iface:ipv4" {
        uses vrrp-group-ipv4;
    }

    augment "/iface:interface/iface:veth/iface:unit/iface:ipv6" {
        uses vrrp-group-ipv6;
    }

    augment "/iface:interface/iface:bridge/iface:unit/iface:ipv4" {
        uses vrrp-group-ipv4;
    }

    augment "/iface:interface/iface:bridge/iface:unit/iface:ipv6" {
        uses vrrp-group-ipv6;
    }

    augment "/iface:interface/iface:dummy/iface:unit/iface:ipv4" {
        uses vrrp-group-ipv4;
    }

    augment "/iface:interface/iface:dummy/iface:unit/iface:ipv6" {
        uses vrrp-group-ipv6;
    }
}
