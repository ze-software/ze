module ze-pki-cmd {
    namespace "urn:ze:pki:cmd";
    prefix pkicmd;
    import ze-extensions    { prefix ze; }
    import ze-cli-show-cmd  { prefix clishowcmd; }
    description "PKI show commands: certificate listing and detailed inspection.
         Relocated from the central show schema for plugin self-containment.";
    revision 2026-09-03 { description "show pki local-ca pem exports the root of the certificate authority this daemon issues its own components' certificates from. It is a separate noun from certificate, which addresses an operator-configured store entry by name, because the local root is generated at first start and is named by nothing."; }
    revision 2026-08-30 { description "Each output form of show pki certificate name is its own command: pem, bundle pem and fingerprint. The forms are mutually exclusive tails, so the model states them as sibling containers rather than a description stating an alternation a handler switch reads."; }
    revision 2026-06-03 { description "Initial revision: relocated from ze-cli-show-cmd."; }

    augment "/clishowcmd:show" {
        container pki {
            config false;
            description "TLS certificates and CA trust store.";
            ze:help "These are the certificates Ze itself presents and trusts for its own listeners
                     and clients. They are not the certificates a peer presents over BGP or IPsec.";
            container certificates {
                config false;
                ze:command "ze-show:pki-certificates";
                description "List all loaded certificates with expiry dates.";
                ze:help "Shows name, type (CA or device), subject, issuer, expiry, and validity status.
Check here to find certificates approaching expiration.";
            }
            container local-ca {
                config false;
                description "The certificate authority this daemon issues its own components' certificates from.";
                ze:help "Ze generates this root at its first start and keeps it. It signs the leaf the plugin
                         hub and the management hub serve. It is not one of the certificates the pki block
                         configures, and it has no name.";
                container pem {
                    config false;
                    ze:command "ze-show:pki-local-ca-pem";
                    description "Export the root certificate of the local certificate authority as PEM.";
                    ze:help "Give this text to each client that must trust this node, in its
                             `pki ca <name> certificate` block. The output holds the certificate only:
                             the root private key never leaves the daemon.";
                }
            }

            container certificate {
                config false;
                description "Inspect a specific certificate in detail or export forms.";
                ze:help "The detail view decodes the certificate for a reader. An export form writes it in
                         a shape another program consumes, and the two answer the same certificate.";
                container name {
                    config false;
                    ze:command "ze-show:pki-certificate";
                    description "Inspect a specific certificate in detail.";
                    ze:help "Each export form is a command of its own.";
                    leaf name {
                        type string;
                        mandatory true;
                        description "Certificate name";
                    }

                    container pem {
                        config false;
                        ze:command "ze-show:pki-certificate-pem";
                        description "Export the certificate, and any intermediate it carries, as PEM.";
                        ze:help "Use this form to give the certificate to another system.";
                        leaf name {
                            type string;
                            mandatory true;
                            description "Certificate name";
                        }
                    }

                    container bundle {
                        config false;
                        description "Export forms that carry more than the certificate.";
                        ze:help "A bundle carries the chain, so it holds the issuers a verifier needs and not the
                                 leaf alone. Use the plain PEM export when only the certificate is wanted.";

                        container pem {
                            config false;
                            ze:command "ze-show:pki-certificate-bundle-pem";
                            description "Export the certificate, its intermediates and its private key as one PEM stream.";
                            ze:help "Device certificates only: a CA certificate in the store holds no private key.";
                            leaf name {
                                type string;
                                mandatory true;
                                description "Certificate name";
                            }
                        }
                    }

                    container fingerprint {
                        config false;
                        ze:command "ze-show:pki-certificate-fingerprint";
                        description "Show the hash of the certificate, to verify its identity against the one another system reports.";
                        ze:help "Without an algorithm, SHA-256.";
                        leaf name {
                            type string;
                            mandatory true;
                            description "Certificate name";
                        }

                        container algorithm {
                            config false;
                            ze:modifier "choice";
                            description "Which hash to take of the certificate.";
                            ze:help "The keyword takes one word, sha256, sha384 or sha512, and the
word is case-insensitive. Any other word fails with the message 'pki:
unsupported hash algorithm'. A second word after the algorithm is refused.";
                            leaf algorithm {
                                type enumeration {
                                    enum sha256;
                                    enum sha384;
                                    enum sha512;
                                }
                                description "Hash algorithm. Without one, sha256.";
                            }
                        }
                    }
                }
            }
        }
    }
}
