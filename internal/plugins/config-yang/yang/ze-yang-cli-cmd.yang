module ze-yang-cli-cmd {
    namespace "urn:ze:yang:cli:cmd";
    prefix yangclicmd;
    import ze-extensions { prefix ze; }
    description "show yang command tree. Owned by the config yang subsystem because these handlers render and document the YANG model tree. See ai/rules/plugin-self-containment.md.";
    revision 2026-06-06 { description "Relocated show yang out of the central show schema (plugin self-containment)."; }

    container show {
        config false;
        description "Read-only commands to inspect system, protocol, and network state.";

        container yang {
            config false;
            description "YANG model tree visualization and documentation.";

            container tree {
                config false;
                ze:command "ze-show:yang-tree";
                description "Print the YANG tree for a module in a readable hierarchy.";
                ze:help "Shows node types, data types, and config-vs-state annotations. Similar to
'pyang -f tree'. Useful for understanding the config or command structure.";
            }

            container completion {
                config false;
                ze:command "ze-show:yang-completion";
                description "Show YANG paths available for tab completion.";
                ze:help "Lists every valid completion point in the command tree.";
            }

            container doc {
                config false;
                ze:command "ze-show:yang-doc";
                description "Generate command reference docs from YANG schemas.";
                ze:help "Produces structured documentation with descriptions, arguments, and usage
patterns for every registered command.";
            }
        }
    }
}
