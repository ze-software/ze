module ze-resolve-cmd {
    namespace "urn:ze:resolve:cmd";
    prefix resolvecmd;
    import ze-extensions { prefix ze; }
    description "Look up DNS, ASN, PeeringDB, and IRR data from the router, inspect the DNS cache, and clear the DNS resolver cache. Owned by the resolve component because every handler reads or resets the resolver (resolvers.DNS). Container-merges onto the resolve, show, and clear verb roots. See ai/rules/plugin-self-containment.md.";
    revision 2026-04-04 { description "Initial revision"; }
    revision 2026-08-29 { description "Declare the value each lookup takes: the hostname of the A, AAAA and TXT lookups, the address of the reverse lookup, and the AS number of the Cymru and PeeringDB lookups. The descriptions spelled them in prose and the model stated nothing."; }
    revision 2026-06-03 { description "Relocated clear dns cache out of the central clear schema, and show dns lookup/cache out of the central show schema, into the resolve component (plugin self-containment)."; }
    revision 2026-09-02 { description "Add show resolve rir and update resolve rir: which Regional Internet Registry holds an AS number, and the operator order that refreshes the delegation table."; }

    container resolve {
        config false;
        description "DNS, ASN, PeeringDB, and IRR resolution tools.";
        ze:help "Each lookup runs on the router, so the answer is what the router reaches
and not what your workstation reaches. Each family of lookups needs its own resolver to be
configured.";

        container dns {
            config false;
            description "DNS record lookups from the router.";
            ze:help "The answers come from the daemon's own resolver and are stored in its
cache. A name that resolves to nothing is not cached, so the next lookup asks again.";

            container a {
                config false;
                ze:command "ze-resolve:dns-a";
                description "Look up IPv4 addresses (A records) for a hostname.";
                ze:help "The answer is the list of IPv4 addresses. A valid cache entry
answers without a query, and a fresh answer is cached for the TTL the server gave.";
                leaf hostname { type string { length "1..253"; } mandatory true; description "Hostname to look up"; }
            }
            container aaaa {
                config false;
                ze:command "ze-resolve:dns-aaaa";
                description "Look up IPv6 addresses (AAAA records) for a hostname.";
                ze:help "The answer is the list of IPv6 addresses. A valid cache entry
answers without a query, and a fresh answer is cached for the TTL the server gave.";
                leaf hostname { type string { length "1..253"; } mandatory true; description "Hostname to look up"; }
            }
            container txt {
                config false;
                ze:command "ze-resolve:dns-txt";
                description "Look up TXT records for a hostname.";
                ze:help "Returns all TXT strings.";
                leaf hostname { type string { length "1..253"; } mandatory true; description "Hostname to look up"; }
            }
            container ptr {
                config false;
                ze:command "ze-resolve:dns-ptr";
                description "Reverse-lookup an IP address to its hostname (PTR).";
                ze:help "The address is turned into its in-addr.arpa or ip6.arpa name before
the query. The cache holds the answer under that name, so show dns cache record takes it in
that form.";
                leaf ip-address { type string { pattern '[0-9a-fA-F:.]+(%[a-zA-Z0-9_.-]+)?'; } mandatory true; description "IP address to reverse-look-up"; }
            }
        }

        container cymru {
            config false;
            description "AS number lookups via Team Cymru.";
            ze:help "The router must have a Cymru resolver configured, and the command fails
without one. An AS number Team Cymru does not name answers (unknown) instead of an error.";

            container asn-name {
                config false;
                ze:command "ze-resolve:cymru-asn-name";
                description "Find out who owns an AS number.";
                ze:help "Queries Team Cymru DNS to return the organization name for the ASN.";
                leaf asn { type uint32; mandatory true; description "AS number"; }
            }
        }

        container peeringdb {
            config false;
            description "PeeringDB lookups for peering information.";
            ze:help "The router must have a PeeringDB client configured, and both commands
fail without one. Each one takes an AS number.";

            container max-prefix {
                config false;
                ze:command "ze-resolve:peeringdb-max-prefix";
                description "Get max-prefix limits for an ASN from PeeringDB.";
                ze:help "Returns IPv4 and IPv6 prefix limits. Apply via the config editor.";
                leaf asn { type uint32; mandatory true; description "AS number"; }
            }
            container as-set {
                config false;
                ze:command "ze-resolve:peeringdb-as-set";
                description "Find the IRR AS-SET registered for an ASN in PeeringDB.";
                ze:help "Feed the result into 'resolve irr expand' to get the full member list.";
                leaf asn { type uint32; mandatory true; description "AS number"; }
            }
        }

        container irr {
            config false;
            description "Internet Routing Registry (WHOIS) queries.";
            ze:help "The router must have an IRR client configured, and both commands fail
without one. Each one takes an AS-SET name rather than an AS number.";

            container expand {
                config false;
                ze:command "ze-resolve:irr-expand";
                description "Expand an AS-SET into its member AS numbers.";
                ze:help "Recursively resolves nested AS-SET objects via WHOIS into a flat list. Useful
for building prefix filters from IRR data.";
            }
            container prefix {
                config false;
                ze:command "ze-resolve:irr-prefix";
                description "Get all prefixes announced by an AS-SET's members.";
                ze:help "Expands the AS-SET, then returns every route/route6 object for each member
ASN. Use this to build or verify prefix filters.";
            }
        }
    }

    container show {
        config false;
        description "Read-only commands to inspect system, protocol, and network state.";

        container dns {
            config false;
            description "DNS lookups and cache inspection.";
            ze:help "show dns lookup asks the network and stores what it gets, so it fills
the cache. The cache commands under it only read.";

            container lookup {
                config false;
                ze:command "ze-show:dns-lookup";
                description "Look up a DNS name from the router.";
                ze:help "Resolves <hostname> using the daemon's DNS resolver (falls back to the system
resolver if no DNS component is configured). Default type is A. Returns
records, TTL, and query time. Supports A, AAAA, MX, NS, TXT, CNAME, and PTR.";
                leaf hostname {
                    type string;
                    mandatory true;
                    description "Hostname to resolve";
                }
                leaf type {
                    type enumeration {
                        enum A;
                        enum AAAA;
                        enum MX;
                        enum NS;
                        enum TXT;
                        enum CNAME;
                        enum PTR;
                    }
                    description "DNS record type";
                }
            }

            container cache {
                config false;
                description "Inspect the DNS cache.";
                ze:help "Each operation is modeled as its own command so completion, help, and
generated references show distinct read-only actions.";

                container stats {
                    config false;
                    ze:command "ze-show:dns-cache-stats";
                    description "Show the DNS cache hit, miss, eviction, expiry, and hit-rate counters.";
                    ze:help "It reads the counters and does not change the
cache contents.";
                }

                container list {
                    config false;
                    ze:command "ze-show:dns-cache-list";
                    description "List all non-expired DNS cache entries, sorted by shortest TTL first.";
                    ze:help "An entry whose TTL has run out is left out rather than reported
as expired. The count beside the list is the number of entries reported.";
                }

                container record {
                    config false;
                    ze:command "ze-show:dns-cache-record";
                    description "Show DNS cache entries for one record name.";
                    ze:help "The name must match the cache key exactly, and a reverse lookup
is held under its in-addr.arpa or ip6.arpa name. A name that is not cached answers an empty
list and a count of zero.";
                    leaf name {
                        type string;
                        mandatory true;
                        description "Record name to inspect";
                    }
                }
            }
        }

        container resolve {
            config false;
            description "Resolution data held on the router.";
            ze:help "The data is held on the router, so no command here reaches the network.
update resolve is what refreshes it.";

            container rir {
                config false;
                ze:command "ze-show:resolve-rir";
                description "Show which Regional Internet Registry holds an AS number.";
                ze:help "Reads the RIR delegation table that ships with the binary, or the newer
copy an earlier 'update resolve rir' stored. Reaches no network. Reports the
registry, its whois server, and the delegated range that holds the AS number.
An AS number in no delegated range and a table that cannot be read are two
different answers.";
                leaf asn { type uint32; mandatory true; description "AS number to look up"; }
            }
        }
    }

    container update {
        config false;

        container resolve {
            config false;
            description "Refresh the resolution data held on the router.";
            ze:help "The refresh fetches the delegation file of each of the five Regional
Internet Registries. It stores nothing when any fetch or parse fails, so the previous table
stays in place.";

            container rir {
                config false;
                ze:command "ze-update:resolve-rir";
                description "Refresh the RIR delegation table from the five registry delegation files.";
                ze:help "Fetches the delegation file of each of the five Regional Internet
Registries, parses them, and stores one table under the meta/rir/delegation key.
All-or-nothing: a run in which any fetch or parse fails stores nothing and
leaves the previous copy in place.";
            }
        }
    }

    container clear {
        config false;

        container dns {
            config false;
            description "DNS cache clearing operations.";
            ze:help "Every form needs a DNS resolver, and each one fails with DNS cache not
available without it. Nothing here reaches the network.";

            container cache {
                config false;
                ze:command "ze-clear:dns-cache";
                description "Flush all DNS cache entries and reset all DNS cache counters.";
                ze:help "The entries and the four counters go together. Use clear dns cache
stats to zero the counters and keep the entries, or clear dns cache record to evict one
name.";

                container record {
                    config false;
                    ze:command "ze-clear:dns-cache-record";
                    description "Evict DNS cache entries for one record name, or one name and type when a type is provided.";
                    ze:help "Add type <record-type> after the name to evict one type, and
give no other tail. An unknown type is reported inside the answer rather than as an error.";
                    leaf name {
                        type string;
                        mandatory true;
                        description "Record name to evict";
                    }
                    leaf type {
                        type enumeration {
                            enum A;
                            enum AAAA;
                            enum MX;
                            enum NS;
                            enum TXT;
                            enum CNAME;
                            enum PTR;
                        }
                        description "Optional DNS record type to evict for the named record";
                    }
                }

                container stats {
                    config false;
                    ze:command "ze-clear:dns-cache-stats";
                    description "Reset DNS cache hit, miss, eviction, and expiry counters without removing cached entries.";
                    ze:help "The cached entries stay, so the next lookup is still served
from the cache. Only the hit, miss, eviction and expiry counters go to zero.";
                }
            }
        }
    }
}
