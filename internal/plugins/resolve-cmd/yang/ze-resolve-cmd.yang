module ze-resolve-cmd {
    namespace "urn:ze:resolve:cmd";
    prefix resolvecmd;
    import ze-extensions { prefix ze; }
    import ze-types { prefix zt; }
    description "Look up DNS, ASN, PeeringDB, and IRR data from the router, inspect the DNS cache, and clear the DNS resolver cache. Owned by the resolve component because every handler reads or resets the resolver (resolvers.DNS). Container-merges onto the resolve, show, and clear verb roots. See ai/rules/plugin-self-containment.md.";
    revision 2026-04-04 { description "Initial revision"; }
    revision 2026-08-29 { description "Declare the value each lookup takes: the hostname of the A, AAAA and TXT lookups, the address of the reverse lookup, and the AS number of the Cymru and PeeringDB lookups. The descriptions spelled them in prose and the model stated nothing."; }
    revision 2026-06-03 { description "Relocated clear dns cache out of the central clear schema, and show dns lookup/cache out of the central show schema, into the resolve component (plugin self-containment)."; }
    revision 2026-09-02 { description "Add show resolve rir and update resolve rir: which Regional Internet Registry holds an AS number, and the operator order that refreshes the delegation table."; }

    container resolve {
        config false;
        description "Each lookup runs on the router, so the answer is what the router reaches
and not what your workstation reaches. Each family of lookups needs its own resolver to be
configured.";
        ze:help "DNS, ASN, PeeringDB, and IRR resolution tools.";

        container dns {
            config false;
            description "The answers come from the daemon's own resolver and are stored in its
cache. A name that resolves to nothing is not cached, so the next lookup asks again.";
            ze:help "DNS record lookups from the router.";

            container a {
                config false;
                ze:command "ze-resolve:dns-a";
                description "The answer is the list of IPv4 addresses. A valid cache entry
answers without a query, and a fresh answer is cached for the TTL the server gave.";
                ze:help "Look up IPv4 addresses (A records) for a hostname.";
                leaf hostname { type string { length "1..253"; } mandatory true; ze:help "Hostname to look up"; }
            }
            container aaaa {
                config false;
                ze:command "ze-resolve:dns-aaaa";
                description "The answer is the list of IPv6 addresses. A valid cache entry
answers without a query, and a fresh answer is cached for the TTL the server gave.";
                ze:help "Look up IPv6 addresses (AAAA records) for a hostname.";
                leaf hostname { type string { length "1..253"; } mandatory true; ze:help "Hostname to look up"; }
            }
            container txt {
                config false;
                ze:command "ze-resolve:dns-txt";
                description "Returns all TXT strings.";
                ze:help "Look up TXT records for a hostname.";
                leaf hostname { type string { length "1..253"; } mandatory true; ze:help "Hostname to look up"; }
            }
            container ptr {
                config false;
                ze:command "ze-resolve:dns-ptr";
                description "The address is turned into its in-addr.arpa or ip6.arpa name before
the query. The cache holds the answer under that name, so show dns cache record takes it in
that form.";
                ze:help "Reverse-lookup an IP address to its hostname (PTR).";
                leaf ip-address { type string { pattern '[0-9a-fA-F:.]+(%[a-zA-Z0-9_.-]+)?'; } mandatory true; ze:help "IP address to reverse-look-up"; }
            }
        }

        container cymru {
            config false;
            description "The router must have a Cymru resolver configured, and the command fails
without one. An AS number Team Cymru does not name answers (unknown) instead of an error.";
            ze:help "AS number lookups via Team Cymru.";

            container asn-name {
                config false;
                ze:command "ze-resolve:cymru-asn-name";
                description "Queries Team Cymru DNS to return the organization name for the ASN.";
                ze:help "Find out who owns an AS number.";
                leaf asn { type zt:asn-notated; mandatory true; ze:help "AS number"; }
            }
        }

        container peeringdb {
            config false;
            description "The router must have a PeeringDB client configured, and both commands
fail without one. Each one takes an AS number.";
            ze:help "PeeringDB lookups for peering information.";

            container max-prefix {
                config false;
                ze:command "ze-resolve:peeringdb-max-prefix";
                description "Returns IPv4 and IPv6 prefix limits. Apply via the config editor.";
                ze:help "Get max-prefix limits for an ASN from PeeringDB.";
                leaf asn { type zt:asn-notated; mandatory true; ze:help "AS number"; }
            }
            container as-set {
                config false;
                ze:command "ze-resolve:peeringdb-as-set";
                description "Feed the result into 'resolve irr expand' to get the full member list.";
                ze:help "Find the IRR AS-SET registered for an ASN in PeeringDB.";
                leaf asn { type zt:asn-notated; mandatory true; ze:help "AS number"; }
            }
        }

        container irr {
            config false;
            description "The router must have an IRR client configured, and both commands fail
without one. Each one takes an AS-SET name rather than an AS number.";
            ze:help "Internet Routing Registry (WHOIS) queries.";

            container expand {
                config false;
                ze:command "ze-resolve:irr-expand";
                description "Recursively resolves nested AS-SET objects via WHOIS into a flat list. Useful
for building prefix filters from IRR data.";
                ze:help "Expand an AS-SET into its member AS numbers.";
            }
            container prefix {
                config false;
                ze:command "ze-resolve:irr-prefix";
                description "Expands the AS-SET, then returns every route/route6 object for each member
ASN. Use this to build or verify prefix filters.";
                ze:help "Get all prefixes announced by an AS-SET's members.";
            }
        }
    }

    container show {
        config false;
        ze:help "Read-only commands to inspect system, protocol, and network state.";

        container dns {
            config false;
            description "show dns lookup asks the network and stores what it gets, so it fills
the cache. The cache commands under it only read.";
            ze:help "DNS lookups and cache inspection.";

            container lookup {
                config false;
                ze:command "ze-show:dns-lookup";
                description "Resolves <hostname> using the daemon's DNS resolver (falls back to the system
resolver if no DNS component is configured). Default type is A. Returns
records, TTL, and query time. Supports A, AAAA, MX, NS, TXT, CNAME, and PTR.";
                ze:help "Look up a DNS name from the router.";
                leaf hostname {
                    type string;
                    mandatory true;
                    ze:help "Hostname to resolve";
                }
                leaf type {
                    type enumeration {
                        enum A;
                        enum AAAA;
                        enum MX;
                        enum NS;
                        enum TXT;
                        enum CNAME;
                        enum PTR;
                    }
                    ze:help "DNS record type";
                }
            }

            container cache {
                config false;
                description "Each operation is modeled as its own command so completion, help, and
generated references show distinct read-only actions.";
                ze:help "Inspect the DNS cache.";

                container stats {
                    config false;
                    ze:command "ze-show:dns-cache-stats";
                    description "It reads the counters and does not change the
cache contents.";
                    ze:help "Show the DNS cache hit, miss, eviction, expiry, and hit-rate counters.";
                }

                container list {
                    config false;
                    ze:command "ze-show:dns-cache-list";
                    description "An entry whose TTL has run out is left out rather than reported
as expired. The count beside the list is the number of entries reported.";
                    ze:help "List all non-expired DNS cache entries, sorted by shortest TTL first.";
                }

                container record {
                    config false;
                    ze:command "ze-show:dns-cache-record";
                    description "The name must match the cache key exactly, and a reverse lookup
is held under its in-addr.arpa or ip6.arpa name. A name that is not cached answers an empty
list and a count of zero.";
                    ze:help "Show DNS cache entries for one record name.";
                    leaf name {
                        type string;
                        mandatory true;
                        ze:help "Record name to inspect";
                    }
                }
            }
        }

        container resolve {
            config false;
            description "The data is held on the router, so no command here reaches the network.
update resolve is what refreshes it.";
            ze:help "Resolution data held on the router.";

            container rir {
                config false;
                ze:command "ze-show:resolve-rir";
                description "Reads the RIR delegation table that ships with the binary, or the newer
copy an earlier 'update resolve rir' stored. Reaches no network. Reports the
registry, its whois server, and the delegated range that holds the AS number.
An AS number in no delegated range and a table that cannot be read are two
different answers.";
                ze:help "Show which Regional Internet Registry holds an AS number.";
                leaf asn { type zt:asn-notated; mandatory true; ze:help "AS number to look up"; }
            }
        }
    }

    container update {
        config false;

        container resolve {
            config false;
            description "The refresh fetches the delegation file of each of the five Regional
Internet Registries. It stores nothing when any fetch or parse fails, so the previous table
stays in place.";
            ze:help "Refresh the resolution data held on the router.";

            container rir {
                config false;
                ze:command "ze-update:resolve-rir";
                description "Fetches the delegation file of each of the five Regional Internet
Registries, parses them, and stores one table under the meta/rir/delegation key.
All-or-nothing: a run in which any fetch or parse fails stores nothing and
leaves the previous copy in place.";
                ze:help "Refresh the RIR delegation table from the five registry delegation files.";
            }
        }
    }

    container clear {
        config false;

        container dns {
            config false;
            description "Every form needs a DNS resolver, and each one fails with DNS cache not
available without it. Nothing here reaches the network.";
            ze:help "DNS cache clearing operations.";

            container cache {
                config false;
                ze:command "ze-clear:dns-cache";
                description "The entries and the four counters go together. Use clear dns cache
stats to zero the counters and keep the entries, or clear dns cache record to evict one
name.";
                ze:help "Flush all DNS cache entries and reset all DNS cache counters.";

                container record {
                    config false;
                    ze:command "ze-clear:dns-cache-record";
                    description "Add type <record-type> after the name to evict one type, and
give no other tail. An unknown type is reported inside the answer rather than as an error.";
                    ze:help "Evict DNS cache entries for one record name, or one name and type when a type is provided.";
                    leaf name {
                        type string;
                        mandatory true;
                        ze:help "Record name to evict";
                    }
                    leaf type {
                        type enumeration {
                            enum A;
                            enum AAAA;
                            enum MX;
                            enum NS;
                            enum TXT;
                            enum CNAME;
                            enum PTR;
                        }
                        ze:help "Optional DNS record type to evict for the named record";
                    }
                }

                container stats {
                    config false;
                    ze:command "ze-clear:dns-cache-stats";
                    description "The cached entries stay, so the next lookup is still served
from the cache. Only the hit, miss, eviction and expiry counters go to zero.";
                    ze:help "Reset DNS cache hit, miss, eviction, and expiry counters without removing cached entries.";
                }
            }
        }
    }
}
