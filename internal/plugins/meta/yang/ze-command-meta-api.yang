module ze-command-meta-api {
  namespace "urn:ze:command:meta:api";
  prefix command-meta-api;

  organization "Ze Project";
  description
    "Command discovery, completion, and plugin configuration RPCs.
     Owned by the command component. See ai/rules/plugin-self-containment.md.";

  revision 2026-06-06 {
    description "Relocated from central meta API schema (plugin self-containment).";
  }

  rpc help { description "List subcommands."; }
  rpc command-list { description "List commands."; }
  rpc command-help { description "Show command details."; }
  rpc command-complete { description "Complete command/args."; }
  rpc event-list { description "List available event types."; }
  rpc plugin-encoding { description "Set event encoding (json|text)."; }
  rpc plugin-format { description "Set wire format (hex|base64|parsed|full)."; }
  rpc plugin-ack { description "Set ACK timing (sync|async)."; }
}
