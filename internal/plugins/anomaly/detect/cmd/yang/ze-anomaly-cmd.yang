module ze-anomaly-cmd {
    namespace "urn:ze:anomaly:cmd";
    prefix anomalycmd;
    import ze-extensions { prefix ze; }
    description "show anomaly command tree. Owned by the anomaly-detect plugin.";
    revision 2026-07-02 { description "Initial: behavioral anomaly incident report."; }

    container show {
        config false;
        description "Read-only commands to inspect system, protocol, and network state";

        container anomaly {
            config false;
            ze:command "ze-show:anomaly";
            description "Show recent behavioral anomaly incidents (report-only): source entity, cohort,
fired features with their deviation z-scores, combined score, and severity. The detector reports;
the anomaly/shape responder (Spec 2b) acts.";
        }
    }
}
