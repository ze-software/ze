module ze-anomaly-observe-cmd {
    namespace "urn:ze:anomaly-observe:cmd";
    prefix anomalyobservecmd;
    import ze-extensions { prefix ze; }
    // The plugin holds the incident lifecycle store, so removing the plugin
    // removes this node and its handler together. The command container-merges
    // onto the shared `anomaly` namespace that `show anomaly detect` and
    // `show anomaly shape` also merge onto. See ai/rules/plugins.md.
    description "The show anomaly observe command tree, owned by the anomaly-observe plugin.";
    revision 2026-08-17 { description "Initial: show anomaly observe."; }

    container show {
        config false;
        description "Read-only commands to inspect system, protocol, and network state.";

        container anomaly {
            config false;
            description "Behavioral anomaly detection and response subsystem.";

            container observe {
                config false;
                ze:command "ze-show:anomaly-observe";
                description "Show the behavioral anomaly incident lifecycle, newest first.";
                ze:help "Per incident: the source entity, cohort, fired features with their
deviation z-scores, combined score, severity, start time, end time, and whether
it is still active. Finalized incidents stay in the list, so this shows a
finished incident's duration, which `show anomaly detect` cannot.";
            }
        }
    }
}
