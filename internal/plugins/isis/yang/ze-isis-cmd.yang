module ze-isis-cmd {
    namespace "urn:ze:isis:cmd";
    prefix isiscmd;
    import ze-extensions { prefix ze; }
    // Removing the component removes these command nodes together with the
    // handlers in internal/plugins/isis/cmd_show.go. Both verbs bind into the
    // CENTRAL ze-show and ze-clear command namespaces, which are the
    // Go-registered RPCs and the LDP/iface model, so there is no per-component
    // ze-isis-api module. The show and clear subtrees container-merge onto the
    // generic show and clear verb roots.
    // See ai/rules/plugin-self-containment.md.
    description "The show isis and clear isis command tree, owned by the isis component.";
    // show isis neighbor, database[ detail], route, interface, hostname and
    // spf-log, and clear isis adjacency and counters.
    revision 2026-06-18 {
        description "Initial revision: the show isis and clear isis commands (spec-isis-13).";
    }

    container show {
        config false;
        description "Read-only commands to inspect system, protocol, and network state.";

        container isis {
            config false;
            description "IS-IS neighbors, database, routes, interfaces, hostnames, and SPF history.";
            ze:help "The IS-IS commands read the state ISO/IEC 10589 and RFC 1195
define: the neighbors, the link-state database, the routes, the interfaces, the
hostnames, and the SPF history.";

            container neighbor {
                config false;
                ze:command "ze-show:isis-neighbor";
                description "Show IS-IS adjacencies.";
                ze:help "Returns the neighbor System ID, interface, level, adjacency state, and hold
time for each IS-IS neighbor.";
            }

            container database {
                config false;
                ze:command "ze-show:isis-database";
                description "Show the IS-IS link-state database.";
                ze:help "Lists each LSP with its LSP ID, sequence number, remaining lifetime, checksum,
and overload bit, across Level-1 and Level-2. The own field is true on the
LSPs this node originated and false on the LSPs it learned from a neighbor.";

                container detail {
                    config false;
                    ze:command "ze-show:isis-database-detail";
                    description "Show the IS-IS link-state database with TLV detail.";
                    ze:help "Expands each LSP into its decoded TLVs (type, length, value) so you can read
exactly what each node advertises. It carries the same fields as the summary
view, the own field included.";
                }
            }

            container route {
                config false;
                ze:command "ze-show:isis-route";
                description "Show IS-IS-computed routes.";
                ze:help "Lists each prefix the SPF installed with its metric, level, up/down bit, and
next-hops (address and outgoing interface).";

                container ipv6 {
                    config false;
                    ze:command "ze-show:isis-route-ipv6";
                    description "Show IS-IS-computed IPv6 routes (RFC 5308).";
                    ze:help "Lists each IPv6 prefix the SPF installed with its metric, level, and next-hops
(link-local address and outgoing interface).";
                }
            }

            container interface {
                config false;
                ze:command "ze-show:isis-interface";
                description "Show IS-IS-enabled circuits.";
                ze:help "Returns level, circuit type, metric, hello interval, hold multiplier, passive
flag, DIS state, and the count of Up adjacencies per circuit.";
            }

            container hostname {
                config false;
                ze:command "ze-show:isis-hostname";
                description "Show the IS-IS dynamic-hostname mapping (RFC 5301).";
                ze:help "Maps each System ID to the hostname it advertises in TLV 137.";
            }

            container spf-log {
                config false;
                ze:command "ze-show:isis-spf-log";
                description "Show recent IS-IS SPF runs.";
                ze:help "Returns the most recent SPF runs with their timestamp, level, trigger,
duration, and node count.";
            }
        }
    }

    container clear {
        config false;

        container isis {
            config false;
            description "Reset IS-IS runtime state without reconfiguring.";

            container adjacency {
                config false;
                ze:command "ze-clear:isis-adjacency";
                description "Tear down every IS-IS adjacency so neighbors re-form.";
                ze:help "Adjacencies re-learn from the next Hello; the circuit is not closed and the
configuration is unchanged.";
            }

            container counters {
                config false;
                ze:command "ze-clear:isis-counters";
                description "Reset IS-IS observational counters and the SPF log.";
                ze:help "Monotonic Prometheus series are not reset; the SPF-run history is cleared.";
            }
        }
    }
}
