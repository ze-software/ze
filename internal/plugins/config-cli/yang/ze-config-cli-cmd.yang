module ze-config-cli-cmd {
    namespace "urn:ze:config:cli:cmd";
    prefix configclicmd;
    import ze-extensions { prefix ze; }
    // These handlers inspect, compare, and format configuration files through
    // the config backend. See ai/rules/plugin-self-containment.md.
    description "The show config command tree, owned by the config CLI.";
    revision 2026-11-17 { description "Expose supplied conversion, repair plans and masked source inspection through shared producers."; }
    revision 2026-11-16 { description "Add bounded caller-supplied configuration inspection and comparison through the same command handlers on every surface."; }
    revision 2026-11-02 { description "Declare strip-private on show config dump, and check and diff on show config fmt, so every surface can make those choices."; }
    revision 2026-10-24 { description "Add show config running, the configuration the daemon applied, answered by the daemon."; }
    revision 2026-10-12 { description "Rename validate config to show config validation: the first word of a command is its verb."; }
    revision 2026-10-08 { description "Declare show config graph and validate config, which the config CLI already served."; }
    // Every command that enumerates a set now spells the verb the same way.
    revision 2026-08-31 { description "Renamed show config ls to show config list."; }
    // The model now states the grammar, and the generated usage line reads it.
    revision 2026-08-29 { description "Declare the value the description spelled in prose."; }
    revision 2026-06-06 { description "Relocated show config out of the central show schema (plugin self-containment)."; }

    grouping supplied-content {
        description "One command-packet-sized caller input, shared by every supplied inspection.";
        leaf content {
            type string {
                length "4..261120" {
                    error-message "content is 4 to 261,120 padded base64 characters, at most 195,840 input bytes in one SSH command packet. Use a smaller input or inspect the file with the local ze config command.";
                }
                pattern "([A-Za-z0-9+/]{4})*([A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?" {
                    error-message "content must be padded base64. Encode the input bytes as base64 and give the result after content.";
                }
            }
            mandatory true;
            description "Caller-held bytes encoded as padded base64. The whole input is bounded to
195,840 decoded bytes and never recorded in command history or accounting.";
            ze:help "Input bytes in padded base64, at most 195,840 bytes.";
        }
    }

    grouping supplied-source {
        description "A single supplied source with an optional diagnostic label.";
        uses supplied-content;
        leaf name {
            type string {
                length "1..255";
                pattern '[^/\\]+' {
                    error-message "name is a filename label without a directory. Give the filename alone.";
                }
            }
            description "An optional filename label for diagnostics, without a directory or control
characters. The default is supplied.conf. No file is opened or written.";
            ze:help "Filename label for diagnostics; no file is opened.";
        }
    }

    grouping source-file {
        leaf file {
            type string { length "1..4096"; }
            mandatory true;
            description "A configuration filename on the answering host. The local route also
accepts - for stdin. Daemon routes confine the path to configured directories.";
            ze:help "Configuration filename on the answering host.";
        }
    }

    grouping source-path {
        leaf path {
            type string { length "1..4096"; }
            description "A quoted sequence of configuration path words, including quoted list
keys where needed. It selects a subtree and never names a file.";
            ze:help "Configuration path, such as bgp peer edge.";
        }
    }

    grouping output-form {
        leaf format {
            type enumeration {
                enum set { ze:help "Write flat set commands."; }
                enum hierarchical { ze:help "Write nested configuration blocks."; }
            }
            default set;
            description "The output form. Both forms preserve values and hash plaintext
passwords through the same producer used by ze config migrate.";
            ze:help "Output form: set or hierarchical.";
        }
    }

    grouping detached-preview {
        leaf dry-run {
            type empty;
            description "Return the masked difference without serializing a changed configuration.
Every form remains detached and never publishes into a file or live candidate.";
            ze:help "Return only the masked change preview.";
        }
    }

    grouping detached-change {
        uses supplied-content;
        uses detached-preview;
    }

    container show {
        config false;
        ze:help "Read-only commands to inspect system, protocol, and network state.";

        container config {
            config false;
            description "Everything here reads. Nothing under show config applies a change, so it is safe
                         against a production router.";
            ze:help "Inspect, compare, and format configuration.";

            container set {
                config false;
                ze:command "ze-config-cli:show-config-set";
                description "Read a confined source file and apply one base64-encoded set command.
The transformed text is returned without changing the source or live candidate.";
                ze:help "Return a detached file transformed by one set command.";
                uses source-file;
                uses detached-change;
            }

            container activate {
                config false;
                ze:command "ze-config-cli:show-config-activate";
                description "Read a confined source file and apply one base64-encoded activate command.
The transformed text is returned without changing the source or live candidate.";
                ze:help "Return a detached file transformed by one activate command.";
                uses source-file;
                uses detached-change;
            }

            container deactivate {
                config false;
                ze:command "ze-config-cli:show-config-deactivate";
                description "Read a confined source file and apply one base64-encoded deactivate command.
The transformed text is returned without changing the source or live candidate.";
                ze:help "Return a detached file transformed by one deactivate command.";
                uses source-file;
                uses detached-change;
            }

            container replace {
                config false;
                ze:command "ze-config-cli:show-config-replace";
                description "Read a confined source file and validate base64-encoded replacement bytes
against it. Return shared-editor serialization without publishing the replacement.";
                ze:help "Return a validated detached replacement of a file.";
                uses source-file;
                uses detached-change;
            }

            container migrate {
                config false;
                ze:command "ze-config-cli:show-config-migrate";
                description "Read a confined configuration file and convert its written form.
The result is returned as text; the source file is never rewritten.";
                ze:help "Convert a configuration file between its two written forms.";
                uses source-file;
                uses output-form;
            }

            container fix-plan {
                config false;
                ze:command "ze-config-cli:show-config-fix-plan";
                description "Read a confined configuration file and return its validation
diagnostics and repair candidates without applying a repair.";
                ze:help "Plan configuration repairs without applying them.";
                uses source-file;
            }

            container source {
                config false;
                ze:command "ze-config-cli:show-config-source";
                description "Read a confined configuration file and display its unexpanded
source tree with parsed secret leaves masked, optionally at a selected path.";
                ze:help "Display a file's masked source tree at an optional path.";
                uses source-file;
                uses source-path;
            }

            container environment-validation {
                config false;
                ze:command "ze-config-cli:show-config-environment-validation";
                description "Check explicitly set registered environment values against their types
and report range failures recorded by their readers. Only this process's
environment is judged; no configuration file or candidate is changed.";
                ze:help "Check environment values the answering process cannot use.";
            }

            container supplied {
                config false;
                description "Inspect caller-held configuration through the normal command channel.
Nothing is staged, applied, loaded into the daemon environment, or written to a
file. Native input syntax and answer masking match the existing file readers.";
                ze:help "Inspect configuration supplied as bytes by the caller.";

                container set {
                    config false;
                    ze:command "ze-config-cli:show-config-supplied-set";
                    description "The content JSON contains before configuration and after holding exactly
one set command. Both sources and assigned values stay inside masked content.
Return the transformed text without changing a file or live candidate.";
                    ze:help "Transform detached configuration with one set command.";
                    uses detached-change;
                }

                container activate {
                    config false;
                    ze:command "ze-config-cli:show-config-supplied-activate";
                    description "The content JSON contains before configuration and after holding exactly
one activate command. Return the changed text without publishing it anywhere.";
                    ze:help "Transform detached configuration with one activate command.";
                    uses detached-change;
                }

                container deactivate {
                    config false;
                    ze:command "ze-config-cli:show-config-supplied-deactivate";
                    description "The content JSON contains before configuration and after holding exactly
one deactivate command. Return the changed text without publishing it anywhere.";
                    ze:help "Transform detached configuration with one deactivate command.";
                    uses detached-change;
                }

                container replace {
                    config false;
                    ze:command "ze-config-cli:show-config-supplied-replace";
                    description "The content JSON contains before and after configuration text.
Validate the replacement transition and return shared-editor serialization.
No source file, store or live candidate is changed.";
                    ze:help "Validate and serialize a detached configuration replacement.";
                    uses detached-change;
                }

                container migrate {
                    config false;
                    ze:command "ze-config-cli:show-config-supplied-migrate";
                    description "Convert current configuration bytes between set commands and nested
blocks through the local converter. No file or candidate is written.";
                    ze:help "Convert supplied configuration between its two written forms.";
                    uses supplied-source;
                    uses output-form;
                }

                container fix-plan {
                    config false;
                    ze:command "ze-config-cli:show-config-supplied-fix-plan";
                    description "Validate supplied bytes and report diagnostic repair candidates.
An invalid configuration still answers its plan; nothing is applied.";
                    ze:help "Plan repairs for supplied configuration without applying them.";
                    uses supplied-source;
                }

                container source {
                    config false;
                    ze:command "ze-config-cli:show-config-supplied-source";
                    description "Display a source tree before inheritance resolution, with parsed
secret leaves masked. An unparseable whole source is returned for repair.";
                    ze:help "Read the masked source tree at an optional path.";
                    uses supplied-source;
                    uses source-path;
                }

                container dump {
                    config false;
                    ze:command "ze-config-cli:show-config-supplied-dump";
                    description "Parse and resolve supplied configuration bytes with the same producer
as show config dump. Sensitive values retain its encoded or stripped display.";
                    ze:help "Show the resolved tree from supplied configuration bytes.";
                    uses supplied-source;
                    leaf strip-private {
                        type empty;
                        description "Replace sensitive values with the same placeholder as the file-based
dump, so the resolved tree can be shared without its secrets.";
                        ze:help "Replace sensitive values with a marker.";
                    }
                }
                container validation {
                    config false;
                    ze:command "ze-config-cli:show-config-supplied-validation";
                    description "Check supplied configuration with the existing full validation producer.
An invalid configuration retains its diagnostics and failed verdict. Nothing is applied.";
                    ze:help "Validate supplied configuration without applying it.";
                    uses supplied-source;
                }
                container fmt {
                    config false;
                    ze:command "ze-config-cli:show-config-supplied-fmt";
                    description "Format supplied configuration through the existing formatter. The
answer is formatted configuration text, or the selected check or diff diagnostic.
This command has no file-write option.";
                    ze:help "Format supplied configuration without writing a file.";
                    uses supplied-source;
                    leaf check {
                        type empty;
                        description "Report whether formatting would change the supplied bytes, with the
same verdict as show config fmt check.";
                        ze:help "Report whether formatting is needed.";
                    }
                    leaf diff {
                        type empty;
                        description "Show the formatting changes as the same diagnostic hunks as show
config fmt diff, using the supplied name as a label.";
                        ze:help "Show what formatting would change.";
                    }
                }
                container graph {
                    config false;
                    ze:command "ze-config-cli:show-config-supplied-graph";
                    description "Build the dependency graph from supplied bytes through the existing
graph producer. Inactive configuration contributes no dependency.";
                    ze:help "Show dependencies from supplied configuration bytes.";
                    uses supplied-source;
                }
                container diff {
                    config false;
                    ze:command "ze-config-cli:show-config-supplied-diff";
                    description "Compare two caller-held sources with the existing resolved diff and
secret masking. Decode content as one JSON object with required before and after
string fields, each holding native configuration text. Duplicate, missing,
unknown or nonstring fields and trailing data are refused. The combined JSON
envelope, not each individual source, has the content byte limit.";
                    ze:help "Compare two supplied configurations with secrets masked.";
                    uses supplied-content;
                }
            }

            container dump {
                config false;
                ze:command "ze-config-cli:show-config-dump";
                description "Parses the config and outputs it after includes, defaults, and group
inheritance have been applied. It reads the file you name, so it shows what the
daemon would load from it. To see what a running daemon applied, use
show config running.";
                ze:help "Show the fully resolved configuration tree of a file.";
                leaf strip-private {
                    type empty;
                    description "Replace every sensitive value in the answer with a marker, so the tree
can be shared without its secrets.";
                    ze:help "Replace sensitive values with a marker.";
                }
            }

            container running {
                config false;
                ze:command "ze-config:show-config-running";
                description "The running daemon answers with the configuration it applied, from
memory, not from a file. A reload the daemon refused leaves this answer
unchanged, while the config file already holds the refused text. Secret values
are replaced with a placeholder.";
                ze:help "Show the configuration the running daemon applied.";
            }

            container diff {
                config false;
                ze:command "ze-config-cli:show-config-diff";
                description "Shows what was added, removed, or changed. Commonly used with rollback
revisions to review what changed before you roll back.";
                ze:help "Compare two configuration versions side by side.";
            }

            container history {
                config false;
                ze:command "ze-config-cli:show-config-history";
                description "Shows revisions with timestamps and commit metadata. Pair with 'show config
diff' to review changes before rolling back.";
                ze:help "List available configuration rollback points.";
                leaf file {
                    type string { length "1..4096"; }
                    mandatory true;
                    description "The configuration whose stored revision history is listed. Standard input has no revision history.";
                    ze:help "Configuration file whose revisions are listed.";
                }
            }

            container list {
                config false;
                ze:command "ze-config-cli:show-config-list";
                description "Shows archived snapshots and the active config.";
                ze:help "List all configuration files stored in the database.";
            }

            container cat {
                config false;
                ze:command "ze-config-cli:show-config-cat";
                description "Outputs the config as-is.";
                ze:help "Print the full text of a stored configuration snapshot.";
                leaf id {
                    type string { length "1..128"; }
                    mandatory true;
                    description "The value is a key that show config list prints. Ze reads that file from
the configuration store and writes its bytes unchanged.";
                    ze:help "Stored configuration snapshot id.";
                }
            }

            container fmt {
                config false;
                ze:command "ze-config-cli:show-config-fmt";
                description "Normalizes indentation and ordering. Output goes to stdout (read-only). To
rewrite the file in place, use 'ze config fmt -w' from the CLI.";
                ze:help "Pretty-print the configuration with consistent formatting.";

                leaf check {
                    type empty;
                    description "Answers whether the file needs formatting instead of the formatted text:
exit 0 when it is formatted, 1 with the file named when it is not.";
                    ze:help "Report whether formatting is needed";
                }
                leaf diff {
                    type empty;
                    description "Answers the unified diff formatting would apply instead of the formatted
text.";
                    ze:help "Show what formatting would change";
                }
            }

            container graph {
                config false;
                ze:command "ze-config-cli:show-config-graph";
                description "Prints the dependency graph of a config file as JSON. Inactive blocks
are left out, so the graph is the one the daemon would build.";
                ze:help "Show how components and peers depend on each other, as JSON.";
                leaf file {
                    type string { length "1..4096"; }
                    mandatory true;
                    description "The config file to read, or - to read it on stdin.";
                    ze:help "Config file path, or - for stdin.";
                }
            }

            container validation {
                config false;
                ze:command "ze-config-cli:show-config-validation";
                description "Both the grammar of the file and the meaning of its values are checked,
and each problem is reported with the diagnostic code that explains it. Nothing is
applied.";
                ze:help "Check a config for errors without applying it.";
                leaf file {
                    type string { length "1..4096"; }
                    mandatory true;
                    description "The config file to check, or - to read it on stdin.";
                    ze:help "Config file path, or - for stdin.";
                }
                leaf pending {
                    type empty;
                    description "Check the saved <file>.draft source instead of the committed file. The daemon confines the draft path itself, including symbolic links.";
                    ze:help "Validate the saved draft beside the selected file.";
                }
            }
        }
    }
}
