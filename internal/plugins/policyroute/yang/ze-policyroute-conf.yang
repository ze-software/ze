module ze-policyroute-conf {
    namespace "urn:ze:policyroute:conf";
    prefix policyroute;

    import ze-extensions { prefix ze; }
    import ze-firewall-conf { prefix fw; }

    description
        "Policy-based routing configuration for Ze.
         Steers packets to alternate routing tables or next-hops
         based on L3/L4 match criteria. Implemented via nftables
         packet marking and ip rule table selection.";

    revision 2026-04-23 {
        description "Initial revision.";
    }

    container policy {
        description "Policy routing configuration.";

        list route {
            key "name";
            description "A named policy route applied to ingress interfaces.";

            leaf name {
                type string;
                description "Policy route name.";
            }

            leaf-list interface {
                type string;
                description
                    "Ingress interface(s) to match. A trailing '*' enables
                     prefix (wildcard) matching (e.g. 'l2tp*').";
            }

            list rule {
                key "name";
                ordered-by user;
                description "Ordered list of match/action rules.";

                leaf name {
                    type string;
                    description "Rule name.";
                }

                leaf order {
                    type uint32;
                    description "Evaluation order of this rule, lower values first.";
                    ze:help
                        "Evaluation order (lower values first). Rules with
                         equal order are sorted by name. If omitted,
                         defaults to 0.";
                }

                container from {
                    description "Packet match criteria.";

                    leaf source-address {
                        type string;
                        ze:validate "ipv4-prefix|ipv6-prefix|set-ref";
                        description "Source IP prefix or @set reference.";
                    }

                    leaf destination-address {
                        type string;
                        ze:validate "ipv4-prefix|ipv6-prefix|set-ref";
                        description "Destination IP prefix or @set reference.";
                    }

                    leaf source-port {
                        type string;
                        ze:validate "port-spec";
                        description "Source port or port range (e.g. '80,443').";
                    }

                    leaf destination-port {
                        type string;
                        ze:validate "port-spec";
                        description "Destination port or port range.";
                    }

                    leaf protocol {
                        type fw:protocol-name;
                        description "L4 protocol to match.";
                        ze:help
                            "The value set is the one every firewall backend can
                             lower, so a spelling outside it is refused at commit
                             rather than at the next firewall reconcile.";

                    }

                    leaf tcp-flags {
                        type string;
                        description
                            "Comma-separated TCP flags to match
                             (fin, syn, rst, psh, ack, urg).";
                    }
                }

                container then {
                    description "Action for matching packets.";

                    leaf accept {
                        type empty;
                        description "Skip this policy (packet routes normally).";
                    }

                    leaf drop {
                        type empty;
                        description "Drop matching packets.";
                    }

                    leaf table {
                        type uint32 {
                            range "1..999|3000..max";
                        }
                        description "Route matching packets through this kernel routing table.";
                        ze:help
                            "Ze routes each matching packet through the kernel
                             routing table with this number. Range 1000-2999 is
                             reserved for ze internal use, which covers the VRF
                             tables and the policy-routing tables Ze allocates.";
                    }

                    leaf next-hop {
                        type string;
                        ze:validate "ipv4-address|ipv6-address";
                        description "Redirect matching packets to this next-hop.";
                        ze:help
                            "Ze allocates a kernel routing table from range
                             2000-2999 for this next-hop. Ze then manages the
                             default route, the fwmark, and the ip rule in that
                             table internally.";

                    }

                    leaf tcp-mss {
                        type uint16 {
                            range "1..65535";
                        }
                        description "Clamp TCP MSS to this value (bytes).";
                    }
                }
            }
        }
    }
}
