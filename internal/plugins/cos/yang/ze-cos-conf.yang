module ze-cos-conf {
    namespace "urn:ze:cos:conf";
    prefix cos;

    import ze-types { prefix zt; }
    import ze-extensions { prefix ze; }

    description
        "Class-of-service profile definitions and interface bindings.
         Profiles define named 802.1p PCP-to-priority mappings that can
         be referenced from interface configuration instead of inline
         ingress-qos-map / egress-qos-map lists.";

    revision 2026-06-12 {
        description "Initial revision";
    }

    container class-of-service {
        description "Named class-of-service profiles.";
        ze:help "A profile maps the 3-bit PCP field of an 802.1Q header to an internal
priority, in the ingress direction and in the egress direction. An interface leaf and a
unit leaf name the profile they use.";

        list ieee-802.1p {
            key "name";
            description "An 802.1p QoS profile.";
            ze:help "The profile defines the mapping between the 3-bit PCP field in the
802.1Q header and the internal priorities. It covers the ingress direction and the
egress direction.";

            leaf name {
                type zt:node-name;
                description "Name of this profile, in lowercase letters, digits and hyphens.";
                ze:help "The name is the list key. The class-of-service leaf of an
interface, and of a unit, names one profile.";
            }

            container ingress {
                description "PCP-to-priority mapping of a received tagged frame.";
                ze:help "Ze reads this mapping when it takes the internal priority of a
frame it receives.";

                list pcp {
                    key "value";
                    description "Map one received PCP value to an internal priority.";
                    ze:help "The list key is the PCP value, so the list holds at most one
entry for each of the eight values.";

                    leaf value {
                        type uint8 {
                            range "0..7";
                        }
                        description "PCP value in the 802.1Q header of the received frame.";
                        ze:help "IEEE 802.1Q defines the Priority Code Point field, which
is 3 bits wide and holds a value from 0 to 7.";
                    }

                    leaf priority {
                        type uint8 {
                            range "0..7";
                        }
                        mandatory true;
                        description "Internal priority Ze gives to a matching frame.";
                        ze:help "The value runs from 0 to 7.";
                    }
                }
            }

            container egress {
                description "Priority-to-PCP mapping of a transmitted tagged frame.";
                ze:help "Ze reads this mapping when it stamps the PCP field of a frame it
transmits.";

                list priority {
                    key "value";
                    description "Map one internal priority to a transmitted PCP value.";
                    ze:help "The list key is the internal priority, so the list holds at
most one entry for each of the eight priorities.";

                    leaf value {
                        type uint8 {
                            range "0..7";
                        }
                        description "Internal priority of the outgoing packet.";
                        ze:help "The value runs from 0 to 7.";
                    }

                    leaf pcp {
                        type uint8 {
                            range "0..7";
                        }
                        mandatory true;
                        description "PCP value Ze stamps in the 802.1Q header.";
                        ze:help "IEEE 802.1Q defines the Priority Code Point field, which
is 3 bits wide and holds a value from 0 to 7.";
                    }
                }
            }
        }
    }

    grouping qos-maps {
        description "Inline 802.1p QoS maps for VLAN sub-interfaces.
                     Maps translate between the 3-bit PCP field of the
                     802.1Q tag header and kernel-internal priority.";

        list ingress-qos-map {
            key "pcp";
            description "Map the 802.1p PCP value of a received tagged frame to an internal priority.";
            ze:help "The map needs vlan-id. A frame whose PCP value has no entry keeps
priority 0.";

            leaf pcp {
                type uint8 {
                    range "0..7";
                }
                description "PCP value in the 802.1Q header of the received frame.";
                ze:help "IEEE 802.1Q defines the Priority Code Point field, which is
3 bits wide and holds a value from 0 to 7.";
            }

            leaf priority {
                type uint8 {
                    range "0..7";
                }
                mandatory true;
                description "Internal priority Ze gives to a matching frame.";
                ze:help "The value runs from 0 to 7.";
            }
        }

        list egress-qos-map {
            key "priority";
            description "Map the internal priority of an outgoing packet to the 802.1p PCP value.";
            ze:help "Ze stamps the PCP value in the 802.1Q header. The map needs vlan-id.
Ze sends a priority with no entry as PCP 0.";

            leaf priority {
                type uint8 {
                    range "0..7";
                }
                description "Internal priority of the outgoing packet.";
                ze:help "The value runs from 0 to 7.";
            }

            leaf pcp {
                type uint8 {
                    range "0..7";
                }
                mandatory true;
                description "PCP value Ze stamps in the 802.1Q header.";
                ze:help "IEEE 802.1Q defines the Priority Code Point field, which is
3 bits wide and holds a value from 0 to 7.";
            }
        }
    }

    grouping cos-unit-leaves {
        description "Per-unit class-of-service leaves: profile reference,
                     inline QoS maps, merged into interface units via
                     container-merge.";

        leaf class-of-service {
            type string;
            description "Class-of-service profile of this unit.";
            ze:help "The value is the name of a profile. The value 'none' stops the unit
from inheriting the profile of the parent interface.";
        }

        uses qos-maps;
    }

    grouping cos-interface-leaves {
        description "Interface-level class-of-service leaf merged into L2
                     interface types via container-merge.";

        leaf class-of-service {
            type string;
            description "Name of a class-of-service ieee-802.1p profile, or 'none'.";
            ze:help "The value 'none' disables inheritance. When this leaf is set on the
interface, every VLAN unit inherits the profile. A unit that sets its own profile keeps
that one.";
        }
    }

    container interface {
        description "Interface-level class-of-service bindings and inline QoS maps.";
        ze:help "This container merges into ze-iface-conf. Remove the cos plugin and
every QoS leaf disappears from the interfaces.";

        list ethernet {
            key "name";
            // The canonical node is owned by ze-iface-conf.yang. This module only
            // attaches the class-of-service leaves to it, and states the same fact
            // in wording the prose ratchet accepts.
            description "Physical or virtual Ethernet interface.";

            leaf name {
                type string;
                description "OS interface name, such as eth0 or ens3. It must match a kernel interface that exists.";
            }
            uses cos-interface-leaves;

            list unit {
                key "name";
                description "Logical interface unit.";

                leaf name {
                    type zt:node-name;
                    description "Unit name, in lowercase alphanumeric characters and hyphens.";
                }
                uses cos-unit-leaves;
            }
        }

        list dummy {
            key "name";
            // The canonical node is owned by ze-iface-conf.yang. This module only
            // attaches the class-of-service leaves to it, and states the same fact
            // in wording the prose ratchet accepts.
            description "Dummy interface, which behaves like a loopback.";

            leaf name {
                type string;
                description "Dummy interface name, such as dummy0. Ze creates the interface at apply time.";
            }
            uses cos-interface-leaves;

            list unit {
                key "name";
                description "Logical interface unit.";

                leaf name {
                    type zt:node-name;
                    description "Unit name, in lowercase alphanumeric characters and hyphens.";
                }
                uses cos-unit-leaves;
            }
        }

        list veth {
            key "name";
            // The canonical node is owned by ze-iface-conf.yang. This module only
            // attaches the class-of-service leaves to it, and states the same fact
            // in wording the prose ratchet accepts.
            description "Virtual ethernet pair interface";

            leaf name {
                type string;
                description "Veth interface name, such as veth0. Ze creates the pair at apply time.";
            }
            uses cos-interface-leaves;

            list unit {
                key "name";
                description "Logical interface unit.";

                leaf name {
                    type zt:node-name;
                    description "Unit name, in lowercase alphanumeric characters and hyphens.";
                }
                uses cos-unit-leaves;
            }
        }

        list bridge {
            key "name";
            // The canonical node is owned by ze-iface-conf.yang. This module only
            // attaches the class-of-service leaves to it, and states the same fact
            // in wording the prose ratchet accepts.
            description "Linux bridge interface, which forwards Ethernet frames between member ports at L2.";

            leaf name {
                type string;
                description "Bridge interface name, such as br0. Ze creates the bridge at apply time.";
            }
            uses cos-interface-leaves;

            list unit {
                key "name";
                description "Logical interface unit.";

                leaf name {
                    type zt:node-name;
                    description "Unit name, in lowercase alphanumeric characters and hyphens.";
                }
                uses cos-unit-leaves;
            }
        }
    }
}
