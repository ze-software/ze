module ze-fib-conf {
    namespace "urn:ze:fib:conf";
    prefix fib;

    import ze-extensions { prefix ze; }

    description
        "FIB configuration for Ze.
         Contains the kernel backend configuration for route programming.
         Admin distance settings are in ze-rib-conf (RIB concept).";

    revision 2026-04-04 {
        description "Move admin-distance to ze-rib-conf.";
    }

    container fib {
        description "Forwarding Information Base configuration.";

        container kernel {
            description "OS kernel route programming via netlink (Linux).";

            leaf flush-on-stop {
                type boolean;
                default false;
                description
                    "Remove every ze-installed route when the plugin stops.";
                ze:help
                    "When true, the plugin removes every route it installed as it
                     stops. The default false keeps those routes in the kernel
                     after shutdown, which supports graceful restart.";
            }

            leaf sweep-delay {
                type uint16;
                default 30;
                units seconds;
                description
                    "Time to wait after startup before Ze sweeps stale routes.";
                ze:help
                    "The delay lets BGP reconverge and refresh the matching routes
                     before Ze removes the stale ones. The default is 30 seconds.";

            }
        }
    }
}
