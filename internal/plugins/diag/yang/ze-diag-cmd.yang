module ze-diag-cmd {
    namespace "urn:ze:diag:cmd";
    prefix diagcmd;
    import ze-extensions { prefix ze; }
    description "Diagnostic command tree: capture (control-plane, raw, interface) and tcp-check. Owned by the diag component. See ai/rules/plugin-self-containment.md.";
    revision 2026-06-06 { description "Relocated capture and tcp-check out of the central show schema (plugin self-containment)."; }

    container show {
        config false;
        description "Read-only commands to inspect system, protocol, and network state";

        container tcp-check {
            config false;
            ze:command "ze-show:tcp-check";
            description "Test TCP connectivity to a remote host and port.
Tries to open a TCP connection and reports success or failure with
the connection time. Use 'source <IP>' to bind a specific local
address. Quick way to verify a peer's BGP port is reachable.";
            leaf host {
                type string;
                mandatory true;
                description "Target host";
            }
            leaf port {
                type uint16;
                mandatory true;
                description "Target port";
            }
            leaf source {
                type string;
                description "Source IP address";
            }
            leaf timeout {
                type string {
                    pattern '\d+[smh]?';
                }
                description "Connection timeout";
            }
        }

        container capture {
            config false;
            ze:command "ze-show:capture";
            description "Show captured control-plane messages.
Returns protocol messages you previously enabled capture for. Without
a protocol keyword, shows all protocols.
Usage: show capture [protocol <l2tp|bgp>] [tunnel-id <tunnel-id>]
[count <count>] [peer <peer>]. Use this to debug
session establishment issues.";
            leaf protocol {
                type enumeration {
                    enum l2tp;
                    enum bgp;
                }
                description "Protocol filter";
            }
            leaf tunnel-id {
                // Identifiers are string-typed (ai/rules/cli-grammar.md "Identifiers
                // Are Strings"); the pattern keeps the 0-65535 numeric shape.
                type string {
                    pattern '[0-9]{1,5}';
                }
                description "L2TP tunnel ID filter";
            }
            leaf count {
                type uint32;
                description "Maximum number of messages";
            }
            leaf peer {
                type string;
                description "Peer address filter";
            }

            container raw {
                config false;
                ze:command "ze-show:capture-raw";
                description "Control raw byte capture for protocol debugging.
Actions: start (begin capturing), stop (halt), dump (retrieve).
Protocols: l2tp, bgp. Output formats: pcap (for Wireshark), json.
Limit with count <N>.";
                leaf action {
                    type enumeration {
                        enum start;
                        enum stop;
                        enum dump;
                    }
                    description "Capture action";
                }
                leaf protocol {
                    type enumeration {
                        enum l2tp;
                        enum bgp;
                    }
                    description "Protocol to capture";
                }
                leaf format {
                    type enumeration {
                        enum pcap;
                        enum json;
                    }
                    description "Output format";
                }
                leaf count {
                    type uint32;
                    description "Maximum number of messages";
                }
            }

            container interface {
                config false;
                ze:command "ze-show:capture-interface";
                description "Capture live packets on an interface (like tcpdump).
Uses AF_PACKET for zero-copy capture. Filter by protocol and port.
Limit with count or duration. Output as pcap (for Wireshark) or text.
Snap-len controls how many bytes per packet are captured.";
                leaf iface {
                    type string;
                    description "Interface name";
                }
                leaf count {
                    type uint32 {
                        range "1..10000";
                    }
                    description "Packet count";
                }
                leaf duration {
                    type string {
                        pattern '\d+[smh]?';
                    }
                    description "Capture duration";
                }
                leaf snap-len {
                    type uint32 {
                        range "64..65535";
                    }
                    description "Snap length in bytes";
                }
                leaf format {
                    type enumeration {
                        enum pcap;
                        enum text;
                    }
                    description "Output format";
                }
                leaf protocol {
                    type string;
                    description "Protocol filter";
                }
            }
        }
    }
}
