module ze-diag-cmd {
    namespace "urn:ze:diag:cmd";
    prefix diagcmd;
    import ze-extensions { prefix ze; }
    description "Diagnostic command tree: capture (control-plane, raw, interface) and tcp-check. Owned by the diag component. See ai/rules/plugin-self-containment.md.";
    revision 2026-06-06 { description "Relocated capture and tcp-check out of the central show schema (plugin self-containment)."; }

    container show {
        config false;
        ze:help "Read-only commands to inspect system, protocol, and network state.";

        container tcp-check {
            config false;
            ze:command "ze-show:tcp-check";
            description "Tries to open a TCP connection and reports success or failure with the
connection time. Use 'source <IP>' to bind a specific local address. Quick way
to verify a peer's BGP port is reachable.";
            ze:help "Test TCP connectivity to a remote host and port.";
            leaf host {
                type string;
                mandatory true;
                ze:help "Target host";
            }
            leaf port {
                type uint16;
                mandatory true;
                ze:help "Target port";
            }
            leaf source {
                type string;
                ze:help "Source IP address";
            }
            leaf timeout {
                type string {
                    pattern '\d+[smh]?';
                }
                ze:help "Connection timeout";
            }
        }

        container capture {
            config false;
            ze:command "ze-show:capture";
            description "Returns protocol messages you previously enabled capture for. Without a
protocol keyword, shows all protocols. Use this to debug session establishment
issues.";
            ze:help "Show captured control-plane messages.";
            leaf protocol {
                type enumeration {
                    enum l2tp;
                    enum bgp;
                }
                ze:help "Protocol filter";
            }
            leaf tunnel-id {
                // Identifiers are string-typed (ai/rules/cli-grammar.md "Identifiers
                // Are Strings"); the pattern keeps the 0-65535 numeric shape.
                type string {
                    pattern '[0-9]{1,5}';
                }
                ze:help "L2TP tunnel ID filter";
            }
            leaf count {
                type uint32;
                ze:help "Maximum number of messages";
            }
            leaf peer {
                type string;
                ze:help "Peer address filter";
            }

            container raw {
                config false;
                ze:command "ze-show:capture-raw";
                description "Actions: start (begin capturing), stop (halt), dump (retrieve). Protocols:
l2tp, bgp. Output formats: pcap (for Wireshark), json. Limit with count <N>.";
                ze:help "Control raw byte capture for protocol debugging.";
                leaf action {
                    type enumeration {
                        enum start;
                        enum stop;
                        enum dump;
                    }
                    ze:help "Capture action";
                }
                leaf protocol {
                    type enumeration {
                        enum l2tp;
                        enum bgp;
                    }
                    ze:help "Protocol to capture";
                }
                leaf format {
                    type enumeration {
                        enum pcap;
                        enum json;
                    }
                    ze:help "Output format";
                }
                leaf count {
                    type uint32;
                    ze:help "Maximum number of messages";
                }
            }

            container interface {
                config false;
                ze:command "ze-show:capture-interface";
                description "Uses AF_PACKET for zero-copy capture. Filter by protocol and port. Limit with
count or duration. Output as pcap (for Wireshark) or text. Snap-len controls
how many bytes per packet are captured.";
                ze:help "Capture live packets on an interface (like tcpdump).";
                leaf iface {
                    type string;
                    ze:help "Interface name";
                }
                leaf count {
                    type uint32 {
                        range "1..10000";
                    }
                    ze:help "Packet count";
                }
                leaf duration {
                    type string {
                        pattern '\d+[smh]?';
                    }
                    ze:help "Capture duration";
                }
                leaf snap-len {
                    type uint32 {
                        range "64..65535";
                    }
                    ze:help "Snap length in bytes";
                }
                leaf format {
                    type enumeration {
                        enum pcap;
                        enum text;
                    }
                    ze:help "Output format";
                }
                leaf protocol {
                    type string;
                    ze:help "Protocol filter";
                }
            }
        }
    }
}
