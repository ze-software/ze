module ze-mpls-cmd {
    namespace "urn:ze:mpls:cmd";
    prefix mplscmd;
    import ze-extensions    { prefix ze; }
    import ze-cli-show-cmd  { prefix clishowcmd; }
    // Relocated from the central show schema, for plugin self-containment.
    description "MPLS show commands: forwarding table inspection.";
    // It replaces a handler-side row-limit flag.
    revision 2026-06-26 { description "Add the row-cap as a 'limit' keyword leaf, matching show route."; }
    revision 2026-06-03 { description "Initial revision: relocated from ze-cli-show-cmd."; }

    augment "/clishowcmd:show" {
        container mpls {
            config false;
            description "MPLS forwarding table and label operations.";
            ze:help "This is the forwarding state the dataplane uses. The protocol that installed a
                     label lives under show ldp or show rsvp-te.";

            container forwarding {
                config false;
                ze:command "ze-show:mpls-forwarding";
                description "Show MPLS forwarding entries installed in the kernel.";
                ze:help "Each entry shows the incoming label, swap/push/pop operation, and outgoing
next-hop. Pass 'limit N' to cap large tables. Linux only.";
                leaf limit {
                    type uint32;
                    description "Maximum number of entries";
                }
            }
        }
    }
}
