module ze-storage-cli-cmd {
    namespace "urn:ze:storage:cli:cmd";
    prefix storageclicmd;
    import ze-extensions { prefix ze; }
    description "show data command tree. Owned by the config storage subsystem because these handlers inspect the ZeFS blob store. See ai/rules/plugin-self-containment.md.";
    revision 2026-08-29 { description "Declare the value the description spelled in prose, so the model states the grammar and the generated usage line reads it."; }
    revision 2026-06-06 { description "Relocated show data out of the central show schema (plugin self-containment)."; }

    container show {
        config false;
        description "Read-only commands to inspect system, protocol, and network state";

        container data {
            config false;
            description "ZeFS blob store keys and content";

            container ls {
                config false;
                ze:command "ze-show:data-ls";
                description "List everything stored in the ZeFS blob store.
Shows all keys and their sizes. Use 'show data cat <key>' to see
the content of a specific entry.";
            }

            container cat {
                config false;
                ze:command "ze-show:data-cat";
                description "Print the raw content of a blob store entry.
Usage: show data cat <key>. Outputs the value for the given key,
like 'cat' for ZeFS.";
                leaf key { type string { length "1..512"; } mandatory true; description "Blob store key to print"; }
            }

            container registered {
                config false;
                ze:command "ze-show:data-registered";
                description "List the key patterns registered by all subsystems.
Shows you what types of data ZeFS knows about.";
            }
        }
    }
}
