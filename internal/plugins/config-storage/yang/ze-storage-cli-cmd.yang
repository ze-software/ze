module ze-storage-cli-cmd {
    namespace "urn:ze:storage:cli:cmd";
    prefix storageclicmd;
    import ze-extensions { prefix ze; }
    description "Commands to inspect stored keys and values. Owned by the config storage subsystem. See ai/rules/plugins.md.";
    revision 2026-11-14 { description "Added show data check, the store's integrity verdict, which the daemon serves too."; }
    revision 2026-08-31 { description "Renamed show data ls to show data list, so every command that enumerates a set spells the verb the same way."; }
    revision 2026-08-29 { description "Declare the value the description spelled in prose, so the model states the grammar and the generated usage line reads it."; }
    revision 2026-06-06 { description "Relocated show data out of the central show schema (plugin self-containment)."; }

    container show {
        config false;
        ze:help "Read-only commands to inspect system, protocol, and network state.";

        container data {
            config false;
            description "Inspect logical storage keys and their values. Use show config to read the configuration itself.";
            ze:help "Storage keys and values.";

            container list {
                config false;
                ze:command "ze-config-storage:show-data-list";
                description "Lists the keys in the selected store. Use 'show data cat <key>' to read one value.";
                ze:help "List the keys in the selected store.";
                leaf prefix {
                    type string { length "1..512"; }
                    description "Return only keys beginning with this prefix. Omit it to list every key.";
                    ze:help "Storage key prefix";
                }
            }

            container cat {
                config false;
                ze:command "ze-config-storage:show-data-cat";
                description "Outputs the decoded value for the given storage key.";
                ze:help "Print the value of a storage key.";
                leaf key {
                    type string { length "1..512"; }
                    mandatory true;
                    description "The key of one entry, as show data list prints it. The bytes stored
                                 under it are written out unchanged, and a key the store does not
                                 hold is an error.";
                    ze:help "Storage key to print";
                }
            }

            container registered {
                config false;
                ze:command "ze-config-storage:show-data-registered";
                description "Lists the storage key patterns registered by subsystems.";
                ze:help "List the key patterns registered by all subsystems.";
                leaf pattern {
                    type string { length "1..512"; }
                    description "Read one exact registered key pattern. An unknown pattern is refused.";
                    ze:help "Exact registered key pattern";
                }
            }

            container encode {
                config false;
                ze:command "ze-config-storage:show-data-encode";
                description "Encode supplied bytes with the same netcapstring producer as ze data encode.
No store is read or changed. The answer is the exact frame, header or CRC bytes.";
                ze:help "Encode supplied bytes as a ZeFS frame, header or checksum.";
                leaf content {
                    type string {
                        length "0..261120";
                        pattern "([A-Za-z0-9+/]{4})*([A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?";
                    }
                    mandatory true;
                    description "The bytes to encode, in padded base64. Empty input encodes an empty frame.
The encoded bound leaves space for the command within one SSH request.";
                    ze:help "Padded base64 input bytes";
                }
                leaf part {
                    type enumeration {
                        enum full { ze:help "Complete encoded frame"; }
                        enum header { ze:help "Frame header only"; }
                        enum crc { ze:help "CRC32c checksum only"; }
                    }
                    default full;
                    description "Choose the complete frame, its header or its checksum. Header and checksum
answers end with a newline, as the standalone command does.";
                    ze:help "Frame part to return";
                }
                leaf capacity {
                    type uint32 { range "0..8388480"; }
                    description "Reserved frame bytes, at least the input length. The default adds ten percent
to the input length. The maximum leaves room for a header in one remote answer.";
                    ze:help "Reserved frame capacity in bytes";
                }
            }

            container check {
                config false;
                ze:command "ze-config-storage:show-data-check";
                description "Checks every entry of the store and, when every entry decodes, its config
                             history. The answer is the entry count and one row per corrupt entry and
                             per history finding, with an error status when any row is an error. It
                             reads the store and changes nothing, so it runs while ze runs; the
                             daemon holds its own writes for the walk. ze data check prints the same
                             rows on the host that holds the store.";
                ze:help "Check the integrity of the store's entries and config history.";
            }
        }
    }
}
