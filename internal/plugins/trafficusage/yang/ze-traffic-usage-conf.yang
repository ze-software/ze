module ze-traffic-usage-conf {
    namespace "urn:ze:traffic-usage:conf";
    prefix trafficusageconf;

    import ze-traffic-control-conf { prefix tc; }
    import ze-extensions { prefix ze; }

    description "eBPF TCX per-port and per-IP byte accounting configuration.
                 Augments the shared `traffic` container (owned by
                 ze-traffic-control-conf) with the `usage` subtree.";
    revision 2026-07-02 { description "Nest under traffic/usage: augment /tc:traffic with container usage."; }
    revision 2026-06-24 { description "Initial revision."; }

    augment "/tc:traffic" {
        container usage {
            description "Per-interface eBPF TCX byte accounting (port/protocol always; per-IP via track-ip).";

            leaf enabled {
                type boolean;
                default false;
                description "Enable traffic-usage accounting.";
            }

            container interfaces {
                description "Interfaces to account on.";
                list interface {
                    key "name";
                    description "Per-interface traffic-usage accounting.";
                    leaf name {
                        type string {
                            length "1..255";
                            pattern '[A-Za-z0-9][A-Za-z0-9._@-]*';
                        }
                        description "Ze interface name that this accounting entry counts bytes for.";
                        ze:help "Ze resolves the name to its kernel device before the accounting attaches to that device. The
                            resolution honors the os-name selector and the mac-match selector.";
                    }
                    leaf enabled {
                        type boolean;
                        default true;
                        description "Account traffic on this interface.";
                    }
                    leaf track-ip {
                        type boolean;
                        description "Override the global track-ip for this interface (inherits the global value when unset).";
                    }
                    leaf stale-timeout {
                        type uint32;
                        description "Override the global stale-timeout for this interface, in milliseconds.";
                        ze:help "0 disables the cleanup for this interface. When the leaf is unset, this interface inherits the
                            global stale-timeout.";
                    }
                    leaf max-entries {
                        type uint32 {
                            range "1..4294967295";
                        }
                        description "Override the global max-entries (per-map LRU capacity) for this interface (inherits when unset).";
                    }
                }
            }

            leaf interval {
                type uint32 {
                    range "100..3600000";
                }
                default 1000;
                description "Map poll interval in milliseconds (100ms..1h).";
            }

            leaf stale-timeout {
                type uint32;
                default 300000;
                description "Remove a metric series unseen within this many milliseconds; 0 disables cleanup.";
            }

            leaf track-ip {
                type boolean;
                default false;
                description "Account bytes per IPv4 address as well as per interface.";
                ze:help "The address is the source address on ingress and the destination address on egress. The default is
                    false, which limits the number of metric series.";
            }

            leaf max-entries {
                type uint32 {
                    range "1..4294967295";
                }
                default 10240;
                description "Per-map LRU capacity; least-recently-used entries are evicted beyond this, keeping top talkers.";
            }
        }
    }
}
