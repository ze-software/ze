module ze-container-conf {
    namespace "urn:ze:container:conf";
    prefix containerconf;

    import ze-extensions { prefix ze; }
    import ze-types { prefix zt; }

    description
        "Configuration of the containers Ze runs from OCI images. Owned by the
         container plugin, so a build without the plugin has no container
         keyword. The words are the one table of the container work: every
         package of the plugin adds the nodes it realizes to this module, with
         the names, types and help texts that table gives them.";

    revision 2026-11-17 {
        description "The network list, the image leaf and the network attachment and
                     published port lists of an instance, and the registry list with
                     the transport, the mirror and the credentials of one registry.";
    }

    revision 2026-11-16 {
        description "Initial revision: the instance list with its name, enabled, stop-timeout
                     and stop-signal leaves.";
    }

    container container {
        description "A container is a workload Ze starts from an image and confines: its own
                     namespaces, a limited control group, a reduced capability set and a
                     system-call filter. Ze starts each configured container, restarts it
                     under its policy and removes it when the configuration no longer
                     holds it.";
        ze:help "Containers Ze runs from OCI images.";

        list instance {
            key "name";
            description "One entry is one container. Whether it runs is stated here and nowhere
                         else: Ze has no start command and no stop command, and the enabled
                         leaf says whether the container runs.";
            ze:help "A container Ze runs from an image.";

            leaf name {
                type string {
                    length "1..63";
                    pattern "[a-z0-9]([a-z0-9-]*[a-z0-9])?";
                }
                description "The name selects the container in every command and is its host name
                             unless one is configured. It holds lowercase letters, digits and
                             hyphens, and it neither starts nor ends with a hyphen.";
                ze:help "Name of the container.";
            }

            leaf image {
                type string {
                    length "1..255";
                }
                mandatory true;
                description "The image the container runs: a short name, which completes on the
                             public hub with the library prefix for a one-word name, a whole
                             reference with its registry host, or a reference by sha256 digest.
                             A reference with no tag and no digest takes the tag latest. The
                             image store must hold the image: create container image reference
                             fetches it, and a container whose image is absent waits for it.";
                ze:help "Image name; a short name is looked up on Docker Hub, and no tag means latest.";
            }

            leaf enabled {
                type boolean;
                default true;
                description "The default is true. False keeps every other statement of the
                             container in the configuration and keeps the container stopped,
                             in the disabled state, until the leaf is true again.";
                ze:help "Run this container; false keeps its config and stops it.";
            }

            leaf stop-timeout {
                type uint16 {
                    range "1..30";
                }
                units "seconds";
                default 10;
                description "A stop sends the container its stop signal, then waits this long for
                             it to end before Ze kills every process of it through its control
                             group. The top of the range is 30 because a daemon stop gives the
                             containers 30 seconds to obey their stop signals.";
                ze:help "Time between the stop signal and the kill.";
            }

            leaf stop-signal {
                type enumeration {
                    enum term;
                    enum int;
                    enum quit;
                    enum hup;
                    enum usr1;
                    enum usr2;
                }
                description "The signal a stop sends to the container's first process. When the
                             leaf is absent, the signal the image declares is sent, or the
                             termination signal when the image declares none.";
                ze:help "Signal that asks the container to stop.";
            }

            list network {
                key "name";
                ordered-by user;
                description "One entry attaches the container to one container network. The
                             container gets one link per entry, named eth0, eth1 and on in
                             the order the entries are written. An absent address is assigned
                             and an absent mac-address is derived; neither is written to the
                             configuration.";
                ze:help "Attachment to a container network.";

                leaf name {
                    type string {
                        length "1..11";
                        pattern "[a-z0-9]([a-z0-9-]*[a-z0-9])?";
                    }
                    description "The name of a network of the container network list. The
                                 plugin refuses a name the list does not hold.";
                    ze:help "Container network to attach to.";
                }

                leaf-list address {
                    type zt:ip-address;
                    description "At most one address per address family, inside the network's
                                 prefix, and not its network, broadcast or gateway address. A
                                 family with no address set is assigned the lowest free one, and
                                 the assignment stays the same across restarts.";
                    ze:help "Address of the container on the network.";
                }

                leaf mac-address {
                    type string {
                        pattern "[0-9a-fA-F]{2}(:[0-9a-fA-F]{2}){5}";
                    }
                    description "When absent, a locally administered address is derived from the
                                 network and container names, so it is the same at every start.";
                    ze:help "Hardware address of the container's end of the link.";
                }
            }

            list port {
                key "name";
                description "One entry publishes a port of the container on the router: a
                             connection to an address of the router on the listen port is
                             translated to the container's address on its first network and
                             the container port. Only traffic addressed to the router is
                             translated, never traffic the router forwards. The operator's
                             firewall policy must also allow the translated traffic.";
                ze:help "Port of the router that reaches a port of the container.";

                leaf name {
                    type string {
                        length "1..63";
                        pattern "[a-z0-9]([a-z0-9-]*[a-z0-9])?";
                    }
                    description "The name of the published port, which names its translation
                                 terms in the ruleset listing.";
                    ze:help "Name of the published port.";
                }

                leaf protocol {
                    type enumeration {
                        enum tcp;
                        enum udp;
                    }
                    default tcp;
                    description "The transport protocol the port is published for.";
                    ze:help "Transport protocol of the published port.";
                }

                leaf-list listen-address {
                    type zt:ip-address;
                    description "The addresses of the router the port is published on. When
                                 none is set, every address of the router is, in each family
                                 the container has an address of on its first network.";
                    ze:help "Address of the router the port is published on.";
                }

                leaf listen-port {
                    type string {
                        pattern "[0-9]{1,5}(-[0-9]{1,5})?";
                    }
                    mandatory true;
                    description "One port, or a first-last range, from 1 to 65535.";
                    ze:help "Port of the router that is published.";
                }

                leaf container-port {
                    type string {
                        pattern "[0-9]{1,5}(-[0-9]{1,5})?";
                    }
                    mandatory true;
                    description "One port, or a first-last range, of the same length as the
                                 listen port. A range is published onto the same range.";
                    ze:help "Port of the container the connection reaches.";
                }
            }
        }

        list network {
            key "name";
            ze:backend "netlink";
            description "One entry is one container network: a bridge device named zcn- plus
                         the name, holding the gateway address of each prefix. Each attached
                         container has one link whose host end is a member of the bridge.";
            ze:help "A network that containers attach to.";

            leaf name {
                type string {
                    length "1..11";
                    pattern "[a-z0-9]([a-z0-9-]*[a-z0-9])?";
                }
                description "The bridge device is named zcn- plus the name, and a kernel device
                             name holds 15 characters, so the name holds at most 11. A longer
                             name is refused, never shortened.";
                ze:help "Name of the container network.";
            }

            leaf-list prefix {
                type zt:ip-prefix;
                min-elements 1;
                description "At most one prefix per address family. An IPv4 prefix has a length
                             of 1 to 30 and an IPv6 prefix 1 to 126, and two networks must not
                             overlap.";
                ze:help "Address range of the network, one per address family.";
            }

            leaf-list gateway {
                type zt:ip-address;
                description "At most one per prefix, a host address of it. When absent, the
                             gateway of a prefix is its first host address.";
                ze:help "Address of the router on the network.";
            }

            leaf mtu {
                type uint16 {
                    range "68..16000";
                }
                default 1500;
                description "Set on the bridge and on both ends of every link. A network with an
                             IPv6 prefix needs at least 1280.";
                ze:help "Largest packet the network carries.";
            }

            leaf masquerade {
                type boolean;
                default true;
                description "True translates traffic leaving the network through another
                             interface to the router's address on that interface. Traffic
                             between two containers of the network keeps its source.";
                ze:help "Translate outbound traffic to the router's address.";
            }
        }

        list registry {
            key "name";
            description "One entry holds the settings of one image registry. A registry with
                         no entry is reached over HTTPS, verified through the system roots,
                         with no credentials and no mirror. The public hub needs no entry;
                         an entry named docker.io gives it a mirror or credentials like any
                         other registry. A change applies to the next fetch.";
            ze:help "Settings for one image registry.";

            leaf name {
                type string {
                    length "1..255";
                    pattern '[a-z0-9.:\[\]-]+';
                }
                description "The registry host, with its port when it has one, exactly as an
                             image reference writes it: a host in lower case that holds a
                             dot or a colon, or localhost. The public hub is docker.io, the
                             registry a short image name completes to.";
                ze:help "Registry host, as image references write it.";
            }

            leaf transport {
                type enumeration {
                    enum https;
                    enum http;
                }
                default https;
                description "The protocol applies to the registry and to its mirror. Over
                             https the server's certificate is always verified: there is no
                             unverified form.";
                ze:help "Protocol Ze speaks to the registry and to its mirror.";
            }

            container mirror {
                presence "Ask a mirror before the registry.";
                description "One mirror for the registry. Every manifest and blob is asked of
                             the mirror first, once and with no credentials, and of the
                             registry when the mirror fails in any way. What the mirror
                             serves passes the same digest and size checks.";
                ze:help "Server Ze asks first; the registry is asked when it fails.";

                leaf address {
                    type string {
                        length "1..253";
                    }
                    mandatory true;
                    description "An IP address or a host name in lower case. A loopback
                                 address is accepted.";
                    ze:help "IP address or host name of the mirror.";
                }

                leaf port {
                    type zt:port;
                    default 443;
                    description "The default is 443 whatever the transport, so a mirror
                                 reached over http names its port.";
                    ze:help "Port of the mirror.";
                }

                leaf path {
                    type string {
                        length "1..255";
                        pattern '/[^?# ]*';
                    }
                    default "/";
                    description "The path the mirror serves the registry protocol under. It
                                 starts with a slash and is placed before the /v2/ path of
                                 every request to the mirror.";
                    ze:help "Path prefix of the mirror, starting with a slash.";
                }
            }

            container authentication {
                presence "Present credentials to the registry.";
                description "The credentials are sent to the registry or to the token realm
                             it names, and never to the mirror. Both leaves are mandatory.";
                ze:help "Credentials Ze presents to the registry.";

                leaf username {
                    type string {
                        length "1..255";
                    }
                    mandatory true;
                    description "The user name of the account on the registry.";
                    ze:help "User name on the registry.";
                }

                leaf password {
                    type string {
                        length "1..4096";
                    }
                    mandatory true;
                    ze:sensitive;
                    description "The password or access token of the account. Every display
                                 of the configuration masks it.";
                    ze:help "Password or access token on the registry.";
                }
            }

            leaf description {
                type string {
                    length "1..255";
                }
                description "Free text for the operator. Ze does not interpret it.";
                ze:help "Free text shown with the registry.";
            }
        }
    }
}
