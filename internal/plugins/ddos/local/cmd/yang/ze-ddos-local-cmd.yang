module ze-ddos-local-cmd {
    namespace "urn:ze:ddos-local:cmd";
    prefix ddoslocalcmd;
    import ze-extensions { prefix ze; }
    description "show ddos local command. Owned by the ddos-local plugin; container-merges onto the shared show ddos namespace (owned by ddos-observe). Removing the plugin removes this node and its handler. See ai/rules/plugin-self-containment.md.";
    revision 2026-07-02 { description "Initial: show ddos local on-host mitigation status."; }

    container show {
        config false;
        description "Read-only commands to inspect system, protocol, and network state.";

        container ddos {
            config false;
            description "Distributed denial-of-service detection and mitigation subsystem.";

            container local {
                config false;
                ze:command "ze-show:ddos-local";
                description "Show the on-host DDoS mitigation status: whether an nft drop rule is currently installed and the target vector (prefix / proto / port) it covers.";
            }
        }
    }
}
