module ze-ddos-local-conf {
  namespace "urn:ze:ddos-local-conf";
  prefix ddos-local;

  import ze-ddos-detect-conf { prefix dd; }
  import ze-extensions { prefix ze; }

  description "Local (drop-rule) mitigation configuration. Augments the shared `ddos`
               container (owned by ze-ddos-detect-conf) with the `local` subtree.";
  revision 2026-07-12 { description "Replace the allowlist leaf-list with the shared ddos/detect traffic policy; add forward-mitigation for direction-based on-host FORWARD drops of transit victims."; }
  revision 2026-07-11 { description "Add confidence-min gate for the characterized mitigation path."; }
  revision 2026-07-02 { description "Nest under ddos/local: augment /dd:ddos with container local."; }

  augment "/dd:ddos" {
    container local {
      leaf response-level {
        type enumeration {
          enum alert;
          enum enforce;
        }
        default alert;
        description "Action on attack detection: alert (log only) or enforce (install drop rule).";
      }
      leaf max-mitigation-duration {
        type uint32 { range "0..86400"; }
        default 3600;
        description "Maximum seconds a drop rule stays installed (0 = no cap).";
      }
      leaf confidence-min {
        type uint8 { range "0..100"; }
        default 0;
        description "Minimum incident confidence, from 0 to 100, to install a drop rule.";
        ze:help "Ze installs a drop rule from a characterized attack only when the
confidence of the incident reaches this value. The default is 0, which disables the
check. A higher value stops mitigation on a borderline detection.";
      }
      leaf forward-mitigation {
        type boolean;
        default false;
        description "Drop the traffic of a remote transit victim on the netfilter FORWARD hook.";
        ze:help "The default is false. The responder then guards only a local victim, one
the box owns, on the netfilter INPUT hook. The responder leaves a remote victim to the
flowspec upstream announce. Set this leaf to true to protect a downstream host as well.
The ddos/detect policy makes the exempt decision and the mitigate decision.";
      }
    }
  }
}
