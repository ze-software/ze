module ze-ddos-detect-conf {
  namespace "urn:ze:ddos-detect-conf";
  prefix ddos-detect;

  import ze-types { prefix zt; }
  import ze-extensions { prefix ze; }

  description "DDoS detector configuration. Owns the top-level `ddos` container;
               the `detect` subtree configures the detector. Sibling subtrees
               (flowtriq, observe, local, flowspec) augment the same `ddos` parent.";
  revision 2026-07-12 { description "Add the allow/deny traffic policy (default-action + prefix-keyed rules, longest-prefix match) replacing the per-responder allowlists; the detector encodes the exempt/mitigate decision on the emitted event."; }
  revision 2026-07-11 { description "Add bandwidth (BPS) trigger leaves (bps-trigger-enable, bps-threshold-multiplier, bps-floor) to catch low-PPS/high-bandwidth amplification."; }
  revision 2026-07-02 { description "Nest under ddos/detect; the container now owns the shared ddos parent that the other ddos plugins augment."; }

  container ddos {
    description "Distributed denial-of-service detection and mitigation subsystem.";
    ze:help "Distributed denial-of-service detection and mitigation subsystem. This module declares the container,
             and the flowtriq, observe, local and flowspec plugins each augment it. The detect subtree decides
             that an attack is present, and a responder under one of those subtrees acts on the event.";

    container detect {
      description "Detect a volumetric attack from the traffic Ze already sees.";
      ze:help "Detection is separate from mitigation: this container decides that an
               attack is happening and emits an event. A responder under flowspec or
               local is what acts on that event, and none is armed by default.";

    leaf enabled {
      type boolean;
      default false;
      description "Enable the DDoS detector.";
      ze:help "Enable the DDoS detector. Left false, the detector subscribes to no rate feed, so it takes no sample
          and its baseline stays cold. A commit rebuilds the detector and restores the persisted baseline either
          way, and the subscription is what this leaf controls.";
    }
    leaf check-interval {
      type uint16 { range "1..3600"; }
      default 1;
      description "Seconds between detection evaluations.";
    }
    leaf confirm-duration {
      type uint16 { range "0..3600"; }
      default 3;
      description "Consecutive ticks above threshold before triggering.";
      ze:help "The count of consecutive ticks over the threshold that arms the detector. One tick is one second,
          because the traffic-statistics service publishes rates on a one-second ticker. The default 3 needs three unbroken
          seconds over the threshold. A value of 0 or 1 triggers on the first tick. One tick back under the
          threshold returns the detector to idle and restarts the count.";
    }
    leaf clear-consecutive-checks {
      type uint16 { range "1..100"; }
      default 10;
      description "Consecutive ticks below threshold before clearing.";
      ze:help "The count of consecutive ticks under the threshold that ends an attack. The first tick under the
          threshold moves an active detector to the clearing state and counts as the first check. The default 10
          therefore holds the attack live for ten seconds after the traffic stops. One tick back over the
          threshold returns the detector to active and drops the count.";
    }
    leaf baseline-window {
      type uint32 { range "10..86400"; }
      default 300;
      description "Rolling baseline window size in samples.";
      ze:help "Rolling baseline window size in samples, and one sample is one second. The window p99 is recalculated
          every 10 admitted samples, so a cold detector runs on absolute-floor alone for its first 10 seconds. A
          sample taken while the rate is over the threshold is refused, so an attack cannot raise the threshold
          that detects it. One sample in 3600 consecutive refused samples is admitted, which lets a lasting rise
          in traffic move the baseline. A persisted baseline is restored only when it carries 50 samples or
          more.";
    }
    leaf threshold-multiplier {
      type zt:decimal-2 { range "1.00..100.00"; }
      default "3.00";
      description "Baseline p99 multiplier for the dynamic threshold.";
      ze:help "Baseline p99 multiplier for the dynamic threshold. The threshold is the larger of two numbers: the
          window p99 multiplied by this leaf, and absolute-floor. The default 3.00 therefore triggers at three
          times the p99 of normal traffic. A changed value reaches the threshold at the next recalculation, which
          is within 10 admitted samples.";
    }
    leaf absolute-floor {
      type uint32 { range "1..max"; }
      default 5000;
      description "Minimum threshold in PPS regardless of baseline.";
      ze:help "Minimum threshold in PPS regardless of baseline, default 5000. A quiet link cannot trigger on a small
          burst, because the threshold never falls under this value. Five times this value is also the packet-rate
          escape from startup-grace, so a rate over 25000 PPS triggers at the default while the grace period
          runs.";
    }
    leaf startup-grace {
      type uint16 { range "0..3600"; }
      default 90;
      description "Seconds after startup where only extreme spikes trigger.";
      ze:help "Seconds after startup where only extreme spikes trigger, default 90. The count is one tick per second.
          A cold baseline warms during the grace period, and the grace stops that warm-up from firing on itself.
          Two things still trigger: a packet rate over five times absolute-floor, and the bandwidth trigger once
          its own baseline is ready.";
    }
    leaf bps-trigger-enable {
      type boolean;
      default true;
      description "Enable the bandwidth (BPS) trigger beside the PPS threshold.";
      ze:help "Enable the bandwidth (BPS) trigger alongside the PPS threshold. When this leaf is false, only the
          packet-rate threshold can trigger detection.";
    }
    leaf bps-threshold-multiplier {
      type zt:decimal-2 { range "1.00..100.00"; }
      default "3.00";
      description "Baseline p99 multiplier for the bandwidth (BPS) trigger.";
      ze:help "Baseline p99 multiplier for the bandwidth (BPS) trigger. The trigger catches low-PPS, high-bandwidth
          amplification, such as NTP, memcached and CLDAP, that the packet-rate threshold misses.";
    }
    leaf bps-floor {
      type uint64 { range "1..max"; }
      default 50000000;
      description "Minimum bandwidth in bits/sec below which the BPS trigger is inert.";
      ze:help "Minimum bandwidth in bits/sec below which the BPS trigger is inert. The default is 50 Mbps. The
          value is expressed in bits/sec, which is the operator unit. The detector's internal rate is
          bytes/sec, and it converts the value.";
    }
    leaf characterize-enable {
      type boolean;
      default true;
      description "Run Stage-2 flow characterization on a detected attack.";
      ze:help "Run Stage-2 flow characterization. The stage classifies the family and the narrowest vector from the
          flow-export recent-flow ring, and emits AttackCharacterized. When this leaf is false, the detector
          still emits the coarse AttackDetected target from traffic-usage.";
    }
    leaf top-n-sources {
      type uint16 { range "1..100"; }
      default 10;
      description "Maximum number of attacker source addresses ranked into TopSources by packet volume.";
      ze:help "Maximum number of attacker source addresses ranked into TopSources by packet volume, default 10. Ties
          are broken by address. The same ranked list is what a source-matching policy rule reads, and every
          address in it has to fall inside the rule prefix before that rule matches.";
    }
    leaf characterize-window {
      type uint16 { range "1..60"; }
      default 10;
      description "Seconds of recent flows to consider when characterizing an attack.";
      ze:help "Seconds of recent flows to consider when characterizing. Flows last seen before this window are
          ignored. Flows with no timestamp are always kept.";
    }
    leaf characterize-timeout {
      type uint16 { range "50..5000"; }
      default 2000;
      description "Milliseconds budget for the on-trigger queries.";
      ze:help "Milliseconds budget for the on-trigger traffic-usage and flow-recent queries. On timeout, the
          detector falls back to the best available target.";
    }
    leaf entropy-threshold {
      type zt:decimal-2 { range "0.00..16.00"; }
      default "2.00";
      description "Source-address Shannon entropy in bits that marks an attack distributed.";
      ze:help "Source-address Shannon entropy (bits) at or above which an attack is logged as distributed or
          spoofed. A value of 0 is a single source, and a higher value is more sources.";
    }
    container policy {
      description "Allow and deny traffic policy applied to a detected attack.";
      ze:help "Allow/deny traffic policy applied to detected attacks, indexed by prefix. Ze evaluates the policy by
          longest-prefix match, where the most specific rule wins, and not by config order. The policy
          replaces the removed per-responder allowlists. The detector enforces it once and encodes the exempt
          or mitigate decision on the emitted event, so the responders obey it with no config read.";
      leaf default-action {
        type enumeration {
          enum allow;
          enum deny;
        }
        default deny;
        description "Disposition when no rule matches the attack.";
        ze:help "Disposition when no rule matches. deny means defend, which is detection plus mitigation. allow means
            exempt from detection entirely.";
      }
      list rule {
        key "prefix";
        description "One allow or deny rule matched against an attack, keyed by prefix.";
        ze:help "One allow/deny rule matched against an attack, keyed by prefix. Precedence is longest-prefix match,
            so a /24 rule beats a covering /16 with no ordering.";
        leaf prefix {
          type zt:ip-prefix;
          description "IPv4/IPv6 prefix this rule matches (the rule's identity).";
          ze:help "IPv4 or IPv6 prefix this rule matches, and the key of the list. The prefix length sets the
              precedence, so a /24 rule wins over a covering /16 whatever the config order. Two matching rules of
              equal length are broken toward deny, so an allow cannot hide a deny by accident.";
        }
        leaf action {
          type enumeration {
            enum allow;
            enum deny;
          }
          default deny;
          description "allow exempts matching traffic and deny subjects it to DDoS handling.";
          ze:help "allow exempts the matched traffic and deny subjects it to DDoS handling. The scope leaf decides how
              far each one reaches. allow at mitigation scope records the incident and installs no block, and allow
              at detection scope suppresses the incident. deny at detection scope also records without a block, and
              deny at mitigation scope is full handling.";
        }
        leaf match {
          type enumeration {
            enum source;
            enum destination;
            enum any;
          }
          default any;
          description "Whether the prefix matches the attack source, the destination, or either.";
          ze:help "Whether the prefix matches the attack source, the victim destination, or either. A source rule takes
              effect once the attack sources are characterized.";
        }
        leaf scope {
          type enumeration {
            enum detection;
            enum mitigation;
          }
          default mitigation;
          description "Stage the action governs, mitigation or detection.";
          ze:help "Stage the action governs. mitigation means detect and record, and for allow it does not block.
              detection means that for allow the incident is suppressed entirely.";
        }
      }
    }
    }
  }
}
