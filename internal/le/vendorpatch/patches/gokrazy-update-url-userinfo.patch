+++ b/vendor/github.com/gokrazy/internal/updateflag/updateflag.go
@@ -45,10 +45,15 @@ func (v Value) BaseURL(httpPort, httpsPort, schema, hostname, pw string) (*url.URL,
 	if strings.HasPrefix(v.Update, ":") {
 		port = strings.TrimPrefix(v.Update, ":")
 	}
-	v.Update = schema + "://gokrazy:" + pw + "@" + hostname
+	v.Update = schema + "://" + hostname
 	if port != defaultPort {
 		v.Update += ":" + port
 	}
