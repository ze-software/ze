module ze-cli-show-cmd {
    namespace "urn:ze:cli:show:cmd";
    prefix clishowcmd;
    import ze-extensions { prefix ze; }
    description "Show command tree -- read-only introspection";
    revision 2026-03-26 { description "Initial revision"; }

    container show {
        config false;
        description "Read-only introspection commands";

        container version {
            config false;
            ze:command "ze-show:version";
            description "Show version and build date";
        }

        container uptime {
            config false;
            ze:command "ze-show:uptime";
            description "Show daemon start time and uptime duration";
        }

        container system {
            config false;
            description "Daemon process metadata";

            container memory {
                config false;
                ze:command "ze-show:system-memory";
                description "Show Go runtime memory statistics (alloc, heap, GC)";
            }

            container cpu {
                config false;
                ze:command "ze-show:system-cpu";
                description "Show goroutine count, logical CPU count, GOMAXPROCS";
            }

            container date {
                config false;
                ze:command "ze-show:system-date";
                description "Show current wall-clock time in the daemon's timezone";
            }

            container subsystem {
                config false;
                description "Subsystem operations";

                container list {
                    config false;
                    ze:command "ze-show:system-subsystem-list";
                    description "List available subsystems with their state";
                }
            }

            container ntp {
                config false;
                description "NTP synchronization operations";

                ze:command "ze-show:system-ntp";

                container peers {
                    config false;
                    ze:command "ze-show:system-ntp-peers";
                    description "Show per-server NTP state (offset, RTT, stratum, reach)";
                }
            }

            container conntrack {
                config false;
                ze:command "ze-show:system-conntrack";
                ze:backend "nft";
                description "Show netfilter conntrack table statistics, timeouts, and loaded modules";
            }

            container update {
                config false;
                ze:command "ze-show:system-update";
                description "Show firmware update check status: last check time, running version, available version";

                container history {
                    config false;
                    ze:command "ze-show:system-update-history";
                    description "Show firmware update history (last 20 events)";
                }
            }

            container sockets {
                config false;
                ze:command "ze-show:system-sockets";
                description "Show TCP/UDP socket state ([tcp|udp] [state <STATE>] [port <N>])";
            }

            container kernel-log {
                config false;
                ze:command "ze-show:system-kernel-log";
                description "Show kernel log messages from /dev/kmsg ([level <LEVEL>] [count <N>])";
            }

            container goroutines {
                config false;
                ze:command "ze-show:system-goroutines";
                description "Show goroutine dump ([summary|blocked|full])";
            }

            container file-descriptors {
                config false;
                ze:command "ze-show:system-file-descriptors";
                description "Show open file descriptors ([summary|detail])";
            }

            container profile {
                config false;
                ze:command "ze-show:system-profile";
                description "Capture runtime profile ([cpu|heap|goroutine|allocs] [duration <D>])";
            }

            container memory-map {
                config false;
                ze:command "ze-show:system-memory-map";
                description "Show process memory map from /proc/self/status (VmRSS, VmSize, VmSwap, Threads)";
            }
        }

        container host {
            config false;
            description "Hardware inventory: CPU, NICs, DMI, memory, thermal, storage, kernel";

            container cpu {
                config false;
                ze:command "ze-show:host-cpu";
                description "Show CPU inventory: vendor, model, topology, hybrid layout, scaling driver, frequencies, throttle counts";
            }

            container nic {
                config false;
                ze:command "ze-show:host-nic";
                description "Show physical network interfaces: driver, PCI IDs, link speed, queue counts, firmware version (virtual interfaces excluded)";
            }

            container dmi {
                config false;
                ze:command "ze-show:host-dmi";
                description "Show DMI/SMBIOS board identity: system vendor, board, BIOS, chassis";
            }

            container memory {
                config false;
                ze:command "ze-show:host-memory";
                description "Show physical memory sizes and ECC error counters (when edac driver present)";
            }

            container thermal {
                config false;
                ze:command "ze-show:host-thermal";
                description "Show hwmon temperature sensors and per-CPU thermal-throttle counters";
            }

            container storage {
                config false;
                ze:command "ze-show:host-storage";
                description "Show block devices: size, model, transport (nvme/sata/mmc/virtio), rotational, NVMe firmware";
            }

            container kernel {
                config false;
                ze:command "ze-show:host-kernel";
                description "Show Linux kernel release, cmdline, microcode revision, boot time, and security-relevant CPU flags";
            }

            container all {
                config false;
                ze:command "ze-show:host-all";
                description "Show the full host hardware inventory (all sections in one JSON response)";
            }
        }

        container warnings {
            config false;
            ze:command "ze-show:warnings";
            description "Show active operator-visible warnings from all subsystems (report bus snapshot)";
        }

        container aaa {
            config false;
            description "AAA operational state";

            container accounting {
                config false;
                ze:command "ze-show:aaa-accounting";
                description "Show AAA accounting counters, including dropped TACACS+ records";
            }
        }

        container audit {
            config false;
            ze:command "ze-show:audit";
            description "Show audit log entries ([action <type>] [actor <name>] [surface <name>] [since <RFC3339>] [until <RFC3339>] [count <N>])";
        }

        container errors {
            config false;
            ze:command "ze-show:errors";
            description "Show recent operator-visible error events from all subsystems (report bus ring buffer)";
        }

        container traffic {
            config false;
            ze:command "ze-show:traffic";
            description "Show traffic control (qdisc/class/filter) state per interface";
        }

        container ping {
            config false;
            ze:command "ze-show:ping";
            description "ICMP ping from the router (<dest> [count N] [timeout Ns])";
        }

        container traceroute {
            config false;
            ze:command "ze-show:traceroute";
            description "Trace path to target (<dest> [max-hops N] [timeout Ns] [probes N])";
        }

        container tcp-check {
            config false;
            ze:command "ze-show:tcp-check";
            description "TCP port connectivity test (<host> <port> [source <IP>] [timeout <D>])";
        }

        container probe-round {
            config false;
            ze:command "ze-show:probe-round";
            description "Batch probe round for parallel traceroute (<dest> [probes N] [max-hops N] [timeout <D>])";
        }

        container dns {
            config false;
            description "DNS diagnostics";

            container lookup {
                config false;
                ze:command "ze-show:dns-lookup";
                description "DNS lookup (<hostname> [type <A|AAAA|MX|NS|TXT|CNAME|PTR>])";
            }

            container cache {
                config false;
                ze:command "ze-show:dns-cache";
                description "DNS cache (stats | list | record <name>)";
            }
        }

        container l2tp-health {
            config false;
            ze:command "ze-show:l2tp-health";
            description "Show L2TP session health sorted by echo loss ratio";
        }

        container bgp-health {
            config false;
            ze:command "ze-show:bgp-health";
            description "Show BGP peer health sorted by state and activity";
        }

        container health {
            config false;
            ze:command "ze-show:health";
            description "Show aggregated component health status";
        }

        container metrics-query {
            config false;
            ze:command "ze-show:metrics-query";
            description "Query Prometheus metrics by name with optional label filter";
        }

        container capture {
            config false;
            ze:command "ze-show:capture";
            description "Show captured control messages (l2tp [tunnel-id N] [count N] [peer X])";

            container raw {
                config false;
                ze:command "ze-show:capture-raw";
                description "Raw byte capture: start/stop activation and pcap/json dump ([start|stop|dump] [l2tp|bgp] [pcap|json] [count N])";
            }

            container interface {
                config false;
                ze:command "ze-show:capture-interface";
                description "Live packet capture on an interface using AF_PACKET (<iface> [protocol <P> port <N>] [count <N>] [duration <D>] [snap-len <N>] [format pcap|text])";
            }
        }

        container event {
            config false;
            description "Event history";

            container recent {
                config false;
                ze:command "ze-show:event-recent";
                description "Show recent events from the global event ring (newest first)";
            }

            container namespaces {
                config false;
                ze:command "ze-show:event-namespaces";
                description "Show registered event namespaces with event counts";
            }
        }

        container bgp {
            config false;
            description "BGP introspection";

            container peer {
                config false;
                ze:command "ze-show:bgp-peer";
                description "Show peer(s) details";
            }

            container peer-history {
                config false;
                ze:command "ze-bgp:peer-history";
                description "Show FSM transition history for a peer";
            }

            container decode {
                config false;
                ze:command "ze-show:bgp-decode";
                description "Decode BGP message from hex to JSON";
            }

            container encode {
                config false;
                ze:command "ze-show:bgp-encode";
                description "Encode API route command to BGP hex";
            }

            container rib {
                config false;
                ze:command "ze-rib-api:routes";
                ze:task-support required;
                description "BGP RIB routes (scope + filters + terminal)";

                container best {
                    config false;
                    ze:command "ze-rib-api:best";
                    description "Best-path per prefix";

                    container status {
                        config false;
                        ze:command "ze-rib-api:best-status";
                        description "Best-path computation status";
                    }
                }

                container status {
                    config false;
                    ze:command "ze-rib-api:status";
                    description "RIB summary (peer count, route counts)";
                }
            }
        }

        container env {
            config false;
            description "Environment variable inspection";

            container list {
                config false;
                ze:command "ze-show:env-list";
                description "List registered environment variables";
            }

            container get {
                config false;
                ze:command "ze-show:env-get";
                description "Show details for a specific environment variable";
            }

            container registered {
                config false;
                ze:command "ze-show:env-registered";
                description "List all registered environment variables";
            }
        }

        container schema {
            config false;
            description "Schema discovery and introspection";

            container list {
                config false;
                ze:command "ze-show:schema-list";
                description "List all registered YANG schemas";
            }

            container methods {
                config false;
                ze:command "ze-show:schema-methods";
                description "List RPCs from YANG API modules";
            }

            container events {
                config false;
                ze:command "ze-show:schema-events";
                description "List notifications from YANG API modules";
            }

            container handlers {
                config false;
                ze:command "ze-show:schema-handlers";
                description "List handler to module mapping";
            }

            container protocol {
                config false;
                ze:command "ze-show:schema-protocol";
                description "Show protocol version and format info";
            }
        }

        container yang {
            config false;
            description "YANG tree analysis and documentation";

            container tree {
                config false;
                ze:command "ze-show:yang-tree";
                description "Display YANG tree for a module";
            }

            container completion {
                config false;
                ze:command "ze-show:yang-completion";
                description "Show YANG completion paths";
            }

            container doc {
                config false;
                ze:command "ze-show:yang-doc";
                description "Generate command documentation from YANG";
            }
        }

        container data {
            config false;
            description "ZeFS blob store inspection";

            container ls {
                config false;
                ze:command "ze-show:data-ls";
                description "List entries in the blob store";
            }

            container cat {
                config false;
                ze:command "ze-show:data-cat";
                description "Print entry content to stdout";
            }

            container registered {
                config false;
                ze:command "ze-show:data-registered";
                description "List registered key patterns";
            }
        }

        container config {
            config false;
            description "Configuration inspection";

            container dump {
                config false;
                ze:command "ze-show:config-dump";
                description "Parse and display configuration";
            }

            container diff {
                config false;
                ze:command "ze-show:config-diff";
                description "Compare two configurations";
            }

            container history {
                config false;
                ze:command "ze-show:config-history";
                description "List rollback revisions";
            }

            container ls {
                config false;
                ze:command "ze-show:config-ls";
                description "List configs in the database";
            }

            container cat {
                config false;
                ze:command "ze-show:config-cat";
                description "Print a database entry";
            }

            container fmt {
                config false;
                ze:command "ze-show:config-fmt";
                description "Format and normalize configuration";
            }
        }

        container policy {
            config false;
            description "Policy filter introspection";

            container list {
                config false;
                ze:command "ze-show:policy-list";
                description "List all registered filter types and named instances";
            }

            container chain {
                config false;
                ze:command "ze-show:policy-chain";
                description "Show effective filter chain for a peer (import/export)";
            }
        }

        container interface {
            config false;
            ze:command "ze-show:interface";
            description "List OS network interfaces (brief, detail, counters, type, errors dispatch to the same WireMethod; handler branches on args).";

            container brief {
                config false;
                ze:command "ze-show:interface";
                description "One-line-per-interface summary (name, state, IP, MTU)";
            }

            container scan {
                config false;
                ze:command "ze-show:interface-scan";
                description "Scan OS for interfaces and classify by Ze type.
                             Returns a JSON array of discovered interfaces with
                             name, type, and MAC. Pipe output to table, yaml, or
                             json for different views. The --config flag in the
                             standalone CLI (ze interface scan --config) is not
                             available via the daemon path; use the standalone
                             binary for config-syntax output.";
            }

            container type {
                config false;
                ze:command "ze-show:interface";
                description "Filter the interface list by type (ethernet, bridge, vxlan, wireguard, tunnel, bond, ...). Usage: show interface type <type>";
            }

            container errors {
                config false;
                ze:command "ze-show:interface";
                description "Show only interfaces with non-zero Rx/Tx error or drop counters";
            }

            container rate {
                config false;
                ze:command "ze-show:interface";
                description "Per-second rate data (rx/tx bytes/packets per second) for all interfaces or a named interface";
            }
        }

        container ip {
            config false;
            description "IP layer introspection (ARP/ND, routing table)";

            container arp {
                config false;
                ze:command "ze-show:ip-arp";
                description "Kernel neighbor table: IPv4 ARP and IPv6 ND entries. Optional --family ipv4|ipv6 narrows the dump. Equivalent to the top-level `show neighbors`; the two surface the same data and differ only in argument shape (--family vs positional).";
            }

            container route {
                config false;
                ze:command "ze-show:ip-route";
                description "Kernel routing table. Optional positional CIDR (or 'default') narrows the dump. Equivalent to the top-level `show kernel-routes`; same handler, same flags.";

                container lookup {
                    config false;
                    ze:command "ze-show:route-lookup";
                    description "Longest-prefix-match route lookup for a destination IP";
                }
            }
        }

        container neighbors {
            config false;
            ze:command "ze-show:neighbors";
            description "Kernel neighbor table (ARP/ND) via the iface backend. Optional positional 'ipv4', 'ipv6', or 'any' narrows the dump. Top-level shortcut for `show ip arp`; use whichever reads better in your session.";
        }

        container crashes {
            config false;
            ze:command "ze-show:crashes";
            description "Crash reports. No argument lists files. Positional 'latest' or a filename shows report content.";
        }

        container kernel-routes {
            config false;
            ze:command "ze-show:kernel-routes";
            description "Kernel routing table via the iface backend. Optional positional CIDR (or 'default') narrows the dump; --limit N caps the response size. Top-level shortcut for `show ip route`; same handler.";
        }

        container vpp {
            config false;
            ze:backend "vpp";
            description "VPP dataplane introspection";

            container trace {
                config false;
                description "VPP packet trace operations";

                container start {
                    config false;
                    ze:command "ze-show:vpp-trace-start";
                    description "Start VPP dataplane packet trace ([node <input-node>] [count N])";
                }

                container show {
                    config false;
                    ze:command "ze-show:vpp-trace-show";
                    description "Show captured VPP dataplane trace";
                }

                container clear {
                    config false;
                    ze:command "ze-show:vpp-trace-clear";
                    description "Clear VPP trace buffer";
                }
            }

            container runtime {
                config false;
                ze:command "ze-show:vpp-runtime";
                description "Show VPP node runtime counters";
            }
        }

        container static {
            config false;
            ze:command "ze-show:static";
            description "Show configured static routes";
        }

        container policy-routes {
            config false;
            ze:command "ze-show:policy-routes";
            description "Show policy-based routing rules";
        }

        container bmp {
            config false;
            description "BMP (BGP Monitoring Protocol) introspection";

            container sessions {
                config false;
                ze:command "ze-show:bmp-sessions";
                description "Show BMP receiver sessions";
            }

            container peers {
                config false;
                ze:command "ze-show:bmp-peers";
                description "Show BMP monitored BGP peers";
            }

            container collectors {
                config false;
                ze:command "ze-show:bmp-collectors";
                description "Show BMP sender collector status";
            }

            container rib {
                config false;
                ze:command "ze-show:bmp-rib";
                description "Show BMP-monitored routes";
            }
        }

        container rr {
            config false;
            description "Route reflector introspection";

            container status {
                config false;
                ze:command "ze-show:rr-status";
                description "Show route reflector running state";
            }

            container peers {
                config false;
                ze:command "ze-show:rr-peers";
                description "Show route reflector peer states";
            }
        }

        container firewall {
            config false;
            description "Firewall (nftables) introspection";

            container ruleset {
                config false;
                ze:command "ze-show:firewall-ruleset";
                ze:backend "nft";
                description "Rules in a named table with per-term packet/byte counters. Usage: show firewall ruleset <name>.";
            }

            container group {
                config false;
                ze:command "ze-show:firewall-group";
                ze:backend "nft";
                description "Members of a named firewall set (ze's firewall group). No argument lists all known groups; a positional name returns the set elements. Reads from the last applied config -- does not talk to the kernel.";
            }
        }

        container pki {
            config false;
            description "PKI certificate store introspection";

            container certificates {
                config false;
                ze:command "ze-show:pki-certificates";
                description "List all loaded certificates (CA and device) with name, type, subject, issuer, expiry, and validity.";
            }

            container certificate {
                config false;
                ze:command "ze-show:pki-certificate";
                description "Show full details of a named certificate. Usage: show pki certificate <name>.";
            }
        }

        container vpn {
            config false;
            description "VPN subsystem introspection";

            container ipsec {
                config false;
                description "IPsec tunnel introspection";

                container sa {
                    config false;
                    ze:command "ze-show:vpn-ipsec-sa";
                    description "List all IKE and Child Security Associations with peer, algorithms, bytes, rekey, uptime.";
                }

                container status {
                    config false;
                    ze:command "ze-show:vpn-ipsec-status";
                    description "Show IKE engine state, configured connection count, active IKE SA count.";
                }

                container peer {
                    config false;
                    ze:command "ze-show:vpn-ipsec-peer";
                    description "Show detailed peer info: IKE SA state, child SAs with traffic selectors, byte counts. Usage: show vpn ipsec peer <name>.";
                }
            }
        }
    }
}
