module ze-cli-set-cmd {
    namespace "urn:ze:cli:set:cmd";
    prefix clisetcmd;
    import ze-extensions { prefix ze; }
    description "Create or modify running configuration";
    revision 2026-03-23 { description "Initial revision"; }

    container set {
        config false;
        description "Modify running configuration parameters";

        container system {
            config false;
            description "System-level runtime tunables";

            container file-descriptors {
                config false;
                ze:command "ze-set:system-file-descriptors";
                description "Raise the file descriptor limit for the daemon process.
Pass a number or 'max' to go to the hard limit. Takes effect
immediately. Check current limits with 'show system file-descriptors'.";
                leaf limit {
                    type union {
                        type uint64;
                        type enumeration {
                            enum max;
                        }
                    }
                    description "New limit or max for hard limit";
                }
            }
        }

        container bgp {
            config false;
            description "BGP peer configuration changes";

            container peer {
                config false;
                description "Modify or persist peer parameters";

                container with {
                    config false;
                    ze:command "ze-set:bgp-peer-with";
                    description "Change a running peer's parameters on the fly.
Modifies ASN, local-as, timers, and other settings without tearing
down the session where possible. Usage: set bgp peer <selector>
with <key> <value>.";
                }

                container save {
                    config false;
                    ze:command "ze-set:bgp-peer-save";
                    description "Persist peer configuration to the config file.
Writes the current runtime peer config for matched peers back to
disk so changes survive a restart. Selector: IP, name, AS pattern,
glob, or *.";
                }
            }
        }
    }
}
