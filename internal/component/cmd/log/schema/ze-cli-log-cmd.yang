module ze-cli-log-cmd {
    namespace "urn:ze:cli:log:cmd";
    prefix clilogcmd;
    import ze-extensions { prefix ze; }
    description "BGP log command tree";
    revision 2026-03-16 { description "Initial revision"; }

    container log {
        config false;
        description "Log operations";

        container levels {
            config false;
            ze:command "ze-bgp:log-levels";
            description "Subsystem log levels";
        }

        container set {
            config false;
            ze:command "ze-bgp:log-set";
            description "Set subsystem log level at runtime";
            leaf logger {
                type string;
                description "Logger/subsystem name";
            }
            leaf level {
                type enumeration {
                    enum disabled;
                    enum debug;
                    enum info;
                    enum warn;
                    enum err;
                }
                description "Target log level";
            }
        }

        container recent {
            config false;
            ze:command "ze-bgp:log-recent";
            description "Show recent log entries (level <lvl> component <name> count <N>)";
            leaf level {
                type enumeration {
                    enum disabled;
                    enum debug;
                    enum info;
                    enum warn;
                    enum err;
                }
                description "Filter by log level";
            }
            leaf component {
                type string;
                description "Filter by component name";
            }
            leaf count {
                type uint32;
                description "Maximum number of entries";
            }
        }
    }
}
