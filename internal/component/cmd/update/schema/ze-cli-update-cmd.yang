module ze-cli-update-cmd {
    namespace "urn:ze:cli:update:cmd";
    prefix cliupdatecmd;
    import ze-extensions { prefix ze; }
    description "Update command tree -- refresh stale data from external sources";
    revision 2026-03-23 { description "Initial revision"; }

    container update {
        config false;
        description "Refresh stale data from external sources";

        container bgp {
            config false;
            description "BGP data updates";

            container peer {
                config false;
                description "Update BGP peer data";

                container prefix {
                    config false;
                    ze:command "ze-update:bgp-peer-prefix";
                    description "Update prefix maximums from PeeringDB for matched peer(s)";
                }
            }
        }

        container system {
            config false;
            description "System update operations";

            container firmware {
                config false;
                description "System firmware update operations";

                container check {
                    config false;
                    ze:command "ze-update:system-firmware-check";
                    description "Trigger immediate version check (bypass interval timer)";
                }

                container download {
                    config false;
                    ze:command "ze-update:system-firmware-download";
                    description "Download now (bypass spread and maintenance window)";
                }

                container apply {
                    config false;
                    ze:command "ze-update:system-firmware-apply";
                    description "Download, verify, stage, and restart where Ze manages updates";
                }

                container restart {
                    config false;
                    ze:command "ze-update:system-firmware-restart";
                    description "Restart into staged version now";
                }

                container rollback {
                    config false;
                    ze:command "ze-update:system-firmware-rollback";
                    description "Restore previous Ze binary and restart where supported";
                }
            }
        }
    }
}
