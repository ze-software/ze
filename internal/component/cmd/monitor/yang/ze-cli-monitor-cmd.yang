module ze-cli-monitor-cmd {
    namespace "urn:ze:cli:monitor:cmd";
    prefix climonitorcmd;
    import ze-extensions { prefix ze; }
    description "Live streaming commands that auto-refresh until you stop them. This is the generic, unowned monitor verb root: each owner (BGP, ping, traceroute, iface, ike) container-merges its own monitor subtree onto it. See ai/rules/plugin-self-containment.md.";
    revision 2026-06-03 { description "Relocate the monitor verb root out of the BGP plugin into an unowned central package; BGP keeps only monitor bgp."; }
    revision 2026-06-06 { description "Relocated event monitor (-> command component) and system-netlink (-> iface component). Bare anchor only."; }

    container monitor {
        config false;
        description "Continuous monitoring commands (Ctrl-C to stop).";
        ze:help "This container is the bare verb root and it carries no command of its own.
The BGP, ping, traceroute, interface and IPsec owners each merge their own subtree onto it.
What you can monitor therefore follows the plugins this box runs.";

        // NOTE: `monitor event` is owned by the command component.
        // See internal/component/command/schema/ze-command-monitor-cmd.yang.

        // NOTE: `monitor system netlink` is owned by the iface component.
        // See internal/component/iface/schema/ze-iface-monitor-cmd.yang.
    }
}
