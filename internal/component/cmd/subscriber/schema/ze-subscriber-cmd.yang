module ze-subscriber-cmd {
    namespace "urn:ze:subscriber:cmd";
    prefix subcmd;

    import ze-extensions    { prefix ze; }
    import ze-cli-show-cmd  { prefix clishowcmd; }

    description
        "Subscriber CLI command tree. Augments the global `show` verb with
         a `subscriber` sub-tree: `show subscriber summary`, `show subscriber
         detail <id>`. Each container maps to a ze-subscriber-api RPC.";

    revision 2026-05-22 {
        description "Initial revision (spec-subscriber-session-model).";
    }

    augment "/clishowcmd:show" {
        container subscriber {
            config false;
            ze:command "ze-subscriber-api:summary";
            description "Subscriber session summary across all access types.";

            container detail {
                config false;
                ze:command "ze-subscriber-api:detail";
                description "Show full detail for one subscriber session by ID.";
            }
        }
    }
}
