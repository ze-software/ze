module ze-cli-clear-cmd {
    namespace "urn:ze:cli:clear:cmd";
    prefix cliclearcmd;
    import ze-extensions { prefix ze; }
    description "Reset runtime counters and state without touching configuration";
    revision 2026-04-18 { description "Initial revision"; }

    container clear {
        config false;
        description "Reset counters, caches, and operational state. Config is never modified.";

        container interface {
            config false;
            description "Reset interface traffic counters.";

            container counters {
                config false;
                ze:command "ze-clear:interface-counters";
                description "Zero the Rx/Tx counters for every managed interface.
Usage: clear interface counters.";
            }

            container name {
                config false;
                description "Select one interface by name.";

                container counters {
                    config false;
                    ze:command "ze-clear:interface-counters";
                    description "Zero the Rx/Tx counters for one interface.
Usage: clear interface name <name> counters.";
                    leaf name {
                        type string;
                        mandatory true;
                        description "Interface name";
                    }
                }
            }
        }

        container dns {
            config false;
            description "DNS cache clearing operations";

            container cache {
                config false;
                ze:command "ze-clear:dns-cache";
                description "Clear the DNS cache.
With no argument, flushes everything. Use 'record <name>' to evict
one entry, or 'stats' to see hit/miss rates without flushing.";
            }
        }

    }
}
