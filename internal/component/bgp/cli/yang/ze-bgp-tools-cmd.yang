module ze-bgp-tools-cmd {
    namespace "urn:ze:bgp:tools:cmd";
    prefix bgptoolscmd;
    import ze-extensions { prefix ze; }
    // cmd/ze/bgp owns them, so removing the BGP command surface removes
    // show bgp decode and show bgp encode.
    // See ai/rules/plugin-self-containment.md.
    description "Offline BGP protocol tools: show bgp decode and show bgp encode.";
    revision 2026-06-02 { description "Relocated show bgp decode/encode out of the central show schema (plugin self-containment)."; }

    container show {
        config false;
        description "Read-only commands to inspect system, protocol, and network state.";

        container bgp {
            config false;
            description "BGP peers, sessions, RIB, and protocol tools.";
            ze:help "Typed with no subcommand, lists every peer with state, ASN,
prefixes received, and uptime. Optionally scope by address family: ipv4, ipv6,
or l2vpn.";

            container decode {
                config false;
                ze:command "ze-show:bgp-decode";
                description "Decode a hex-encoded BGP message into readable JSON.";
                ze:help "Paste a hex BGP UPDATE and get back parsed attributes,
NLRI, and withdrawn prefixes. Use it to read pcap captures or to debug wire
issues. The web UI carries the same tool under tools.";
            }

            container encode {
                config false;
                ze:command "ze-show:bgp-encode";
                description "Turn a route announcement into wire-format hex.";
                ze:help "Takes a route in API syntax and returns the BGP UPDATE
as a hex string. Use it to build a test payload, to feed ze-test, or to verify
that an announcement encodes correctly.";
            }
        }
    }
}
