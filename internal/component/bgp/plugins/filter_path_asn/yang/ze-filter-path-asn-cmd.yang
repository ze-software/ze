module ze-filter-path-asn-cmd {
    namespace "urn:ze:filter-path-asn:cmd";
    prefix fpacmd;
    import ze-extensions { prefix ze; }
    description "show bgp reject-asn ... command tree. Owned by the
                 bgp-filter-path-asn plugin so that removing the reject-asn
                 filter removes these command nodes together with the handlers
                 and the config schema. See ai/rules/plugin-self-containment.md.";
    revision 2026-09-03 { description "Initial revision."; }

    container show {
        config false;
        description "Read-only commands to inspect system, protocol, and network state.";

        container bgp {
            config false;
            description "BGP peers, sessions, RIB, and protocol tools.";

            container reject-asn {
                config false;
                ze:command "ze-show:reject-asn";
                description "Show every reject-asn list.";
                ze:help "Lists each configured reject-asn list with every ASN it holds, the
effective position set for that ASN, the network the curated table
names for it, and how many peers name the list on import and on
export. An ASN the curated table does not know prints with no
annotation.";

                container name {
                    config false;
                    ze:command "ze-show:reject-asn-name";
                    description "Show one reject-asn list.";
                    ze:help "The same answer for a single list, for a config that holds many.";
                    leaf name { type string; mandatory true; description "Reject-ASN list name"; }
                }

                container known {
                    config false;
                    description "Well-known ASN sets Ze can print for an operator to paste.";

                    container transit-free {
                        config false;
                        ze:command "ze-show:reject-asn-known-transit-free";
                        description "Print the curated transit-free ASNs as a config block.";
                        ze:help "Prints the well-known transit-free ASNs as one `indirect [ ... ];`
line to paste directly under `reject-asn NAME { }`, with the sources and
the curated date as comments. Ze acts on no ASN it was not configured
with, so this command is how the set reaches a config. After the paste
the config holds the numbers, and a later change to the curated table
cannot alter it.";
                    }
                }
            }
        }
    }
}
