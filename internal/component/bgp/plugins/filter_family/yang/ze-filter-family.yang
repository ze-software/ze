module ze-filter-family {
    namespace "urn:ze:filter-family";
    prefix ff;

    import ze-bgp-conf { prefix bgp; }
    import ze-extensions { prefix ze; }
    import ze-types { prefix zt; }

    description "Address-family policy filter for ZeBGP. Matches an AFI/SAFI in a
                 BGP UPDATE and either removes that family's NLRI (import + export)
                 or tears down the session (import only). Referenced from peer
                 filter chains as bgp-filter-family:NAME.";

    revision 2026-06-26 {
        description "Initial revision";
    }

    augment "/bgp:bgp/bgp:policy" {
        list family-filter {
            ze:filter;
            key "name";
            description "Named address-family filter instance.";
            ze:help "One instance matches one family, because family holds one value and is mandatory. A chain that
                must catch two families names two instances.";

            leaf name {
                type string;
                description "Filter instance name, used in a peer filter chain.";
                ze:help "A peer filter chain names this instance as bgp-filter-family:NAME,
where NAME is the value of this leaf.";
            }

            leaf family {
                type zt:address-family;
                mandatory true;
                description "Address family to match, for example ipv4/flowspec.";
                ze:help "Ze treats an UPDATE with no MP_REACH attribute and no MP_UNREACH
attribute as ipv4/unicast.";
            }

            leaf action {
                type enumeration {
                    enum remove {
                        description "Strip the MP_REACH NLRI and the MP_UNREACH NLRI of the matched family.";
                    }
                    enum tear-down {
                        description "Close the session with a BGP NOTIFICATION when a received UPDATE carries the family.";
                    }
                }
                mandatory true;
                description "Action to apply when the family matches.";
                ze:help "remove strips the MP_REACH NLRI and the MP_UNREACH NLRI of the
matched family from the UPDATE, on import and on export. If that removal empties the
UPDATE, Ze drops the whole UPDATE for that peer.

tear-down sends a BGP NOTIFICATION that carries the Cease code and the Connection
Rejected subcode, then closes the session. tear-down acts on import only.";
            }
        }
    }
}
