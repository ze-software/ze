module ze-graceful-restart {
    namespace "urn:ze:graceful-restart";
    prefix gr;

    import ze-bgp-conf { prefix bgp; }
    import ze-extensions { prefix ze; }
    import ze-types { prefix zt; }

    description
        "Graceful Restart capability plugin for Ze (RFC 4724, code 64;
         RFC 9494, code 71). Configures per-peer short-lived (GR) and
         per-family long-lived (LLGR) graceful restart.";

    revision 2026-11-22 {
        description "Split graceful-restart into symmetric short-lived and long-lived containers with per-family LLGR stale times.";
    }

    revision 2026-09-20 {
        description "graceful-restart > family names the address families the code-64 capability carries.";
    }

    revision 2025-01-31 {
        description "Initial revision.";
    }

    // Grouping for reuse across all augment paths
    grouping graceful-restart-config {
        container graceful-restart {
            presence "Graceful Restart capability enabled";
            description "The container carries presence, so writing it makes Ze send the Graceful Restart capability,
                code 64, to this peer. With no short-lived container, code 64 carries Restart Time 0 and no address
                family tuple, which RFC 4724 Section 3 reads as a Receiving Speaker that preserves nothing of its own
                and RFC 9494 Section 4.1 uses to skip the conventional GR phase when long-lived is configured. A
                container on the peer replaces the container on the group rather than adding to it.";
            ze:help "Graceful Restart capability configuration (codes 64 and 71).";

            container short-lived {
                presence "Conventional Graceful Restart phase enabled";
                description "Enables the conventional Graceful Restart phase (RFC 4724, code 64) for this peer. Ze
                    names every address family the peer carries in code 64 unless the family list below narrows the
                    set, so the peer retains Ze's routes while the session is down (RFC 4724 Section 4.2). The
                    Forwarding State bit is set at connection time when the forwarding plane kept Ze's routes across a
                    restart. Omitting this container sends code 64 with Restart Time 0 and no family tuples.";
                ze:help "Conventional Graceful Restart phase (RFC 4724, code 64).";

                leaf restart-time {
                    type uint16 {
                        range "0..4095";
                    }
                    units "seconds";
                    default "120";
                    description
                        "The value is what Ze advertises to the peer. It does not set the timer Ze runs when the peer
                        restarts: that timer takes the Restart Time the peer itself advertised. Ze deletes every stale
                        route of the peer when that timer expires, unless the peer also negotiated LLGR.";
                    ze:help "Restart Time in seconds (RFC 4724 Section 3, 0..4095).";
                }

                list family {
                    key "name";
                    description "Narrows the address families Ze names in the Graceful Restart capability, code 64.
                        When absent, code 64 names every family the peer carries. When present, code 64 names only the
                        listed families. Every listed family must be one the peer's session carries, and Ze omits any
                        family the RIB plugin cannot store with a warning (RFC 4724 Section 4). This list governs code
                        64 alone and never affects code 71.";
                    ze:help "Address families Ze names in the GR capability (code 64).";

                    leaf name {
                        type zt:address-family;
                        ze:validate "registered-address-family";
                        description "RFC 4724 Section 4: 'The presence and the setting of the Forwarding State bit
                            for an address family depend upon the actual forwarding state and configuration.' The
                            value must name a family the peer's own family list carries. Ze refuses the configuration
                            otherwise, because RFC 4724 Section 3 scopes a tuple to routes advertised with the same
                            AFI and SAFI.";
                        ze:help "Address family for code 64 (e.g. ipv4/unicast).";
                    }
                }
            }

            container long-lived {
                description "Configures the Long-Lived Graceful Restart capability (RFC 9494, code 71) per address
                    family. Nested inside graceful-restart so code 71 is never advertised without code 64 (RFC 9494
                    Section 4.1). LLGR is off by default and requires an explicit family entry with a stale-time for
                    each AFI/SAFI (RFC 9494 Section 5).";
                ze:help "Long-Lived Graceful Restart phase (RFC 9494, code 71).";

                list family {
                    key "name";
                    description "Address families advertised in the Long-Lived Graceful Restart capability, code 71,
                        each with its own 24-bit Long-Lived Stale Time (RFC 9494 Section 3.1). Every listed family must
                        be one the peer's session carries. Families absent from this list are omitted from code 71 and
                        do not run LLGR procedures even if the remote peer advertises them (RFC 9494 Section 5).";
                    ze:help "Per-family LLGR stale time configuration (code 71).";

                    leaf name {
                        type zt:address-family;
                        ze:validate "registered-address-family";
                        description "Address family enabled for Long-Lived Graceful Restart. Must match an address
                            family negotiated on this peer's session (including families inherited from its group and
                            excluding entries with mode disable).";
                        ze:help "Address family for code 71 (e.g. ipv4/unicast).";
                    }

                    leaf stale-time {
                        type uint32 {
                            range "0..16777215";
                        }
                        units "seconds";
                        mandatory true;
                        description "Long-Lived Stale Time in seconds for this address family (RFC 9494 Section 3.1).
                            The field is 24 bits, so the maximum value is 16777215 (about 194 days). Zero advertises
                            LLGR capability support for this family with a zero-second stale period.";
                        ze:help "Long-Lived Stale Time in seconds (0..16777215).";
                    }
                }
            }
        }
    }

    // Standalone peer capability
    augment "/bgp:bgp/bgp:peer/bgp:session/bgp:capability" {
        uses graceful-restart-config;
    }

    // Peer inside group capability
    augment "/bgp:bgp/bgp:group/bgp:peer/bgp:session/bgp:capability" {
        uses graceful-restart-config;
    }

    // Group-level capability
    augment "/bgp:bgp/bgp:group/bgp:session/bgp:capability" {
        uses graceful-restart-config;
    }
}
