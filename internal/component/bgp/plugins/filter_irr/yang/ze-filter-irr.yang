module ze-filter-irr {
    namespace "urn:ze:filter-irr";
    prefix firr;

    import ze-bgp-conf { prefix bgp; }
    import ze-types { prefix zt; }
    import ze-extensions { prefix ze; }

    description "IRR-based prefix-list filter for eBGP peers.
                 Queries IRR databases for AS-SET prefixes and applies them
                 as import filters. Referenced from peer filter chains as
                 bgp-filter-irr:$remote_as.";

    revision 2026-06-13 {
        description "Initial revision";
    }

    grouping irr-peer-config {
        container irr {
            description "Per-peer IRR filter settings.";
            ze:help "Ze resolves the prefixes of a peer only when the peer asked for it. A filter chain that names
                bgp-filter-irr asks for it, and so does an as-set written here. A peer that states no remote ASN is
                never resolved.";

            leaf as-set {
                type string;
                description "Explicit AS-SET name for the IRR prefix lookup.";
                ze:help "The IRR filter queries an IRR database for the prefixes of one AS-SET.
This leaf names that AS-SET. If this leaf is empty, Ze reads the remote ASN of the
peer and discovers the AS-SET from PeeringDB.";
            }

            leaf enable {
                type enumeration {
                    enum enable {
                        description "Enable IRR filtering for this peer (default).";
                    }
                    enum disable {
                        description "Disable IRR filtering for this peer.";
                    }
                }
                default "enable";
                description "Enable or disable IRR filtering for this peer.";
                ze:help "disable takes the peer out of the resolution, so Ze runs no whois query and no PeeringDB
                    query for it. The other peers of the same remote ASN keep their list.";
            }
        }
    }

    augment "/bgp:bgp/bgp:policy" {
        container irr {
            description "Global IRR filtering settings.";
            ze:help "The container holds the IRR server, the PeeringDB endpoint and the refresh period. One
                resolution serves every peer of the same remote ASN, so two peers of one ASN cost one query.";

            leaf server {
                type string;
                default "whois.radb.net";
                description "IRR whois server hostname or host:port.";
                ze:help "Ze speaks whois to the server and adds port 43 when the value carries no port. A query that
                    gets no answer in 10 seconds fails, and the prefix list of the last query stays in force.";
            }

            leaf peeringdb-url {
                type string {
                    pattern 'https?://.*';
                }
                default "https://www.peeringdb.com";
                description "Base URL of the PeeringDB API that Ze queries.";
                ze:help "Ze reads the AS-SET of a peer from the PeeringDB API when the
as-set leaf is empty. Set this leaf to the URL of a mock server to test the IRR filter
without a query to the public PeeringDB service.";
            }

            leaf source-address {
                type zt:ip-address;
                description "Source IP address for outbound IRR whois connections.";
                ze:help "Ze binds the address on the whois connection only. The PeeringDB query does not read the
                    leaf. When the leaf is absent, the kernel picks the source address of the route to the server.";
            }

            leaf refresh-interval {
                type uint32 {
                    range "60..86400";
                }
                default "3600";
                units "seconds";
                description "Seconds between automatic IRR re-queries.";
                ze:help "Ze re-queries every enrolled AS-SET on this period. The first query runs in the background
                    at startup, so a slow IRR server never blocks the start of Ze. A failed query leaves the prefix
                    list of the last query in force.";
            }
        }
    }

    augment "/bgp:bgp/bgp:peer/bgp:session" {
        uses irr-peer-config;
    }

    augment "/bgp:bgp/bgp:group/bgp:peer/bgp:session" {
        uses irr-peer-config;
    }

    augment "/bgp:bgp/bgp:group/bgp:session" {
        uses irr-peer-config;
    }
}
