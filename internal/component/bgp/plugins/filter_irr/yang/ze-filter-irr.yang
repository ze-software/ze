module ze-filter-irr {
    namespace "urn:ze:filter-irr";
    prefix firr;

    import ze-bgp-conf { prefix bgp; }
    import ze-extensions { prefix ze; }

    description "IRR-based prefix-list filter for eBGP peers.
                 Enforces the AS-SET prefix lists the irr plugin fetched and
                 stored as import filters. Referenced from peer filter chains as
                 bgp-filter-irr:$remote_as. The IRR server, the PeeringDB URL
                 and the refresh period are system irr and system peeringdb
                 config.";

    revision 2026-06-13 {
        description "Initial revision";
    }

    grouping irr-peer-config {
        container irr {
            description "Ze resolves the prefixes of a peer only when the peer asked for it. A filter chain that names
                bgp-filter-irr asks for it, and so does an as-set written here. A peer that states no remote ASN is
                never resolved.";
            ze:help "Per-peer IRR filter settings.";

            leaf as-set {
                type string;
                description "The AS-SET whose prefixes the IRR filter enforces for this peer. The irr plugin
fetches and stores that AS-SET's prefix list, and the filter reads the stored copy. If this leaf
is empty, the irr plugin asks PeeringDB which AS-SET the peer's remote ASN names.";
                ze:help "Explicit AS-SET name for the IRR prefix lookup.";
                // A completion, never a rule: the irr owner offers the AS-SET
                // names the store holds (internal/plugins/irr/register_completion.go).
                ze:validate "irr-as-set";
            }

            leaf enable {
                type enumeration {
                    enum enable {
                        ze:help "Enable IRR filtering for this peer (default).";
                    }
                    enum disable {
                        ze:help "Disable IRR filtering for this peer.";
                    }
                }
                default "enable";
                description "disable takes the peer out of the filter, so the filter does not ask the irr plugin to
                    fetch a list for it. The other peers of the same remote ASN keep their list.";
                ze:help "Enable or disable IRR filtering for this peer.";
            }
        }
    }

    augment "/bgp:bgp/bgp:peer/bgp:session" {
        uses irr-peer-config;
    }

    augment "/bgp:bgp/bgp:group/bgp:peer/bgp:session" {
        uses irr-peer-config;
    }

    augment "/bgp:bgp/bgp:group/bgp:session" {
        uses irr-peer-config;
    }
}
