module ze-filter-modify {
    namespace "urn:ze:filter-modify";
    prefix fm;

    import ze-bgp-conf { prefix bgp; }
    import ze-extensions { prefix ze; }
    import ze-types { prefix zt; }

    description "Route attribute modifier for the BGP policy framework.
                 Named modifier definitions with attribute operations.
                 A modifier applies the declared operations to every route that
                 reaches it or, when it states a match condition, only to the
                 routes that meet it. Routes that do not meet the condition pass
                 through unchanged.
                 Referenced from peer filter chains as modify:NAME.";

    revision 2026-08-15 {
        description
          "Add del med. RFC 4271 Section 5.1.4 requires a speaker to
           implement a mechanism, based on local configuration, that allows
           MULTI_EXIT_DISC to be removed from a route. Previously, med was a
           set target only, while removal was available only for the three
           community attributes.";
    }

    revision 2026-08-13 {
        description
          "Add the match container. A filter chain is a pipe in which a reject
           DROPS the route, so a match filter placed earlier can only express
           'modify these and discard the rest'. A route that must keep flowing
           untouched had nowhere to go. This is what lets a community select an
           action: a next-hop rewrite toward a discard address on a route
           carrying an operator's blackhole community, RFC 7999 among them,
           while every other route from the same peer forwards normally.";
    }

    revision 2026-05-25 {
        description "Add increment/decrement containers and community add/remove leaf-lists";
    }

    augment "/bgp:bgp/bgp:policy" {
        list modify {
            ze:filter;
            key "name";
            description "Named route attribute modifier instance.
                         Only declared leaves are modified; undeclared
                         attributes are preserved unchanged. Multiple
                         attributes can be changed in a single modifier.";

            leaf name {
                type string;
                description "Modifier instance name (referenced in peer filter
                             chains as modify:NAME).";
            }

            container match {
                description "Condition a route meets before the operations
                             apply. A route that meets none of the stated values
                             passes through UNCHANGED, not rejected: the chain
                             drops a rejected route, and a conditional modifier
                             exists so the routes it does not touch keep
                             flowing.
                             An absent match container applies the operations to
                             every route that reaches the modifier.
                             Values across the three leaf-lists are
                             alternatives: any one present in the route
                             satisfies the condition.";

                leaf-list community {
                    type string;
                    description "Apply only to a route whose COMMUNITIES
                                 attribute (RFC 1997, type 8) carries this
                                 value.
                                 ASN:VAL (e.g. 65001:666), or a well-known name
                                 (blackhole, no-export, no-advertise,
                                 no-export-subconfed, nopeer). The two spellings
                                 of a well-known value are equivalent: 65535:666
                                 and blackhole select the same community, which
                                 RFC 7999 registers and RFC 7999 Section 4 names
                                 with that suggested keyword.";
                }

                leaf-list large-community {
                    type string;
                    description "Apply only to a route whose LARGE COMMUNITIES
                                 attribute (RFC 8092, type 32) carries this
                                 value. GA:LD1:LD2 (e.g. 65001:100:200).";
                }

                leaf-list extended-community {
                    type string;
                    description "Apply only to a route whose EXTENDED
                                 COMMUNITIES attribute (RFC 4360, type 16)
                                 carries this value. target:ASN:NN,
                                 origin:ASN:NN, or a hex string.";
                }
            }

            container set {
                description "Attributes to set on matching routes.
                             Only present leaves are applied.";

                leaf local-preference {
                    type uint32;
                    description "Set LOCAL_PREF attribute (RFC 4271 type 5).";
                }

                leaf med {
                    type uint32;
                    description "Set MULTI_EXIT_DISC attribute (RFC 4271 type 4).";
                }

                leaf origin {
                    type enumeration {
                        enum igp {
                            description "IGP origin";
                        }
                        enum egp {
                            description "EGP origin";
                        }
                        enum incomplete {
                            description "Incomplete origin";
                        }
                    }
                    description "Set ORIGIN attribute (RFC 4271 type 1).";
                }

                leaf next-hop {
                    type zt:ip-address;
                    description "Set NEXT_HOP attribute (RFC 4271 type 3).
                                 IPv4 address only (IPv6 next-hop is in MP_REACH).";
                }

                leaf as-path-prepend {
                    type uint8 {
                        range "1..32";
                    }
                    description "Prepend local AS to AS_PATH this many times.
                                 The actual ASN prepended is the peer's local-as
                                 (from session config). Range 1-32 prevents
                                 excessive path inflation.";
                }

                leaf-list community-add {
                    type string;
                    description "Standard community values to add (ASN:VAL format).";
                }

                leaf-list community-remove {
                    type string;
                    description "Standard community values to remove (ASN:VAL format).";
                }

                leaf-list large-community-add {
                    type string;
                    description "Large community values to add (GA:LD1:LD2 format).";
                }

                leaf-list large-community-remove {
                    type string;
                    description "Large community values to remove (GA:LD1:LD2 format).";
                }

                leaf-list extended-community-add {
                    type string;
                    description "Extended community values to add (target:ASN:NN or hex).";
                }

                leaf-list extended-community-remove {
                    type string;
                    description "Extended community values to remove (target:ASN:NN or hex).";
                }
            }

            container del {
                description "Attributes to delete from matching routes.
                             Only present leaves are applied.";

                leaf med {
                    type empty;
                    description "Remove the MULTI_EXIT_DISC attribute (RFC 4271
                                 type 4) from the route.
                                 RFC 4271 Section 5.1.4 requires a mechanism,
                                 based on local configuration, that removes
                                 MULTI_EXIT_DISC from a route, and requires the
                                 removal to happen before the route reaches
                                 Decision Process phases 1 and 2. The del med
                                 operation is that mechanism, so it applies on
                                 an IMPORT chain only: the route enters the
                                 decision process with no metric. On an export
                                 chain it is refused with a log line, because
                                 Section 9.1.2.2 states that a comparison on
                                 MULTI_EXIT_DISC followed by advertisement
                                 without it causes route loops.
                                 Mutually exclusive with set med, increment med
                                 and decrement med.
                                 A metric received from one neighboring AS is
                                 already kept off another one without any
                                 configuration (RFC 4271 Section 5.1.4), so del
                                 med is for the operator who wants the metric
                                 gone from the route itself.";
                }
            }

            container increment {
                description "Attributes to increment on matching routes.
                             Adds the specified value to the current attribute
                             value. Saturates at uint32 max (4294967295).
                             Mutually exclusive with set for the same attribute.";

                leaf local-preference {
                    type uint32 {
                        range "1..4294967295";
                    }
                    description "Increment LOCAL_PREF by this value.";
                }

                leaf med {
                    type uint32 {
                        range "1..4294967295";
                    }
                    description "Increment MED by this value.";
                }

                leaf aigp {
                    type uint32 {
                        range "1..4294967295";
                    }
                    description "Increment AIGP metric by this value.";
                }
            }

            container decrement {
                description "Attributes to decrement on matching routes.
                             Subtracts the specified value from the current
                             attribute value. Floors at 0 (no underflow).
                             Mutually exclusive with set for the same attribute.";

                leaf local-preference {
                    type uint32 {
                        range "1..4294967295";
                    }
                    description "Decrement LOCAL_PREF by this value.";
                }

                leaf med {
                    type uint32 {
                        range "1..4294967295";
                    }
                    description "Decrement MED by this value.";
                }

                leaf aigp {
                    type uint32 {
                        range "1..4294967295";
                    }
                    description "Decrement AIGP metric by this value.";
                }
            }
        }
    }
}
