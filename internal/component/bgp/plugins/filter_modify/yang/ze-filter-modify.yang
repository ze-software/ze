module ze-filter-modify {
    namespace "urn:ze:filter-modify";
    prefix fm;

    import ze-bgp-conf { prefix bgp; }
    import ze-extensions { prefix ze; }
    import ze-types { prefix zt; }

    description "Route attribute modifier for the BGP policy framework.
                 Named modifier definitions with attribute operations.
                 A modifier applies the declared operations to every route that
                 reaches it or, when it states a match condition, only to the
                 routes that meet it. Routes that do not meet the condition pass
                 through unchanged.
                 Referenced from peer filter chains as modify:NAME.";

    revision 2026-08-15 {
        description
          "Add del med. RFC 4271 Section 5.1.4 requires a speaker to
           implement a mechanism, based on local configuration, that allows
           MULTI_EXIT_DISC to be removed from a route. Previously, med was a
           set target only, while removal was available only for the three
           community attributes.";
    }

    revision 2026-08-13 {
        description
          "Add the match container. A filter chain is a pipe in which a reject
           DROPS the route, so a match filter placed earlier can only express
           'modify these and discard the rest'. A route that must keep flowing
           untouched had nowhere to go. This is what lets a community select an
           action: a next-hop rewrite toward a discard address on a route
           carrying an operator's blackhole community, RFC 7999 among them,
           while every other route from the same peer forwards normally.";
    }

    revision 2026-05-25 {
        description "Add increment/decrement containers and community add/remove leaf-lists";
    }

    augment "/bgp:bgp/bgp:policy" {
        list modify {
            ze:filter;
            key "name";
            description "Named route attribute modifier instance.";
            ze:help "Ze modifies only the declared leaves, and keeps every undeclared
attribute unchanged. One modifier can change several attributes.";

            leaf name {
                type string;
                description "Modifier instance name, used in a peer filter chain.";
                ze:help "A peer filter chain names this instance as modify:NAME, where
NAME is the value of this leaf.";
            }

            container match {
                description "Condition a route meets before the operations apply.";
                ze:help "A route that meets none of the stated values passes through
unchanged, and Ze does not reject it. The chain drops a rejected route, and a
conditional modifier exists so that the routes it does not touch keep flowing. An
absent match container applies the operations to every route that reaches the modifier.
The values across the three leaf-lists are alternatives, so one value present in the
route satisfies the condition.";

                leaf-list community {
                    type string;
                    description "Apply only to a route whose COMMUNITIES attribute carries this value.";
                    ze:help "The COMMUNITIES attribute is RFC 1997, type 8. The value takes
the form ASN:VAL, for example 65001:666, or a well-known name. The well-known names are
blackhole, no-export, no-advertise, no-export-subconfed and nopeer. The two spellings
of a well-known value are equivalent, so 65535:666 and blackhole select the same
community. RFC 7999 registers that community, and RFC 7999 Section 4 names it with that
suggested keyword.";
                }

                leaf-list large-community {
                    type string;
                    description "Apply only to a route whose LARGE COMMUNITIES attribute carries this value.";
                    ze:help "The LARGE COMMUNITIES attribute is RFC 8092, type 32. The value
takes the form GA:LD1:LD2, for example 65001:100:200.";
                }

                leaf-list extended-community {
                    type string;
                    description "Apply only to a route whose EXTENDED COMMUNITIES attribute carries this value.";
                    ze:help "The EXTENDED COMMUNITIES attribute is RFC 4360, type 16. The
value takes the form target:ASN:NN or origin:ASN:NN, or it is a hex string.";
                }
            }

            container set {
                description "Attributes Ze sets on a matching route.";
                ze:help "Ze applies only the leaves that are present in this container,
and keeps every other attribute unchanged.";

                leaf local-preference {
                    type uint32;
                    description "Set LOCAL_PREF attribute (RFC 4271 type 5).";
                }

                leaf med {
                    type uint32;
                    description "Set MULTI_EXIT_DISC attribute (RFC 4271 type 4).";
                }

                leaf origin {
                    type enumeration {
                        enum igp {
                            description "The route started inside the local AS.";
                        }
                        enum egp {
                            description "The route came from the retired EGP protocol.";
                        }
                        enum incomplete {
                            description "The route came from another source, such as redistribution.";
                        }
                    }
                    description "Set ORIGIN attribute (RFC 4271 type 1).";
                }

                leaf next-hop {
                    type zt:ip-address;
                    description "Set the NEXT_HOP attribute of the route.";
                    ze:help "NEXT_HOP is RFC 4271 type 3, and it carries an IPv4 address
only. An IPv6 next-hop travels in the MP_REACH attribute instead, so this leaf does not
set one.";
                }

                leaf as-path-prepend {
                    type uint8 {
                        range "1..32";
                    }
                    description "Prepend the local AS to AS_PATH this many times.";
                    ze:help "Ze prepends the local-as of the peer, which the session config
holds. The range 1 to 32 stops the path from growing without a limit.";
                }

                leaf-list community-add {
                    type string;
                    description "Standard community values to add (ASN:VAL format).";
                }

                leaf-list community-remove {
                    type string;
                    description "Standard community values to remove (ASN:VAL format).";
                }

                leaf-list large-community-add {
                    type string;
                    description "Large community values to add (GA:LD1:LD2 format).";
                }

                leaf-list large-community-remove {
                    type string;
                    description "Large community values to remove (GA:LD1:LD2 format).";
                }

                leaf-list extended-community-add {
                    type string;
                    description "Extended community values to add (target:ASN:NN or hex).";
                }

                leaf-list extended-community-remove {
                    type string;
                    description "Extended community values to remove (target:ASN:NN or hex).";
                }
            }

            container del {
                description "Attributes Ze deletes from a matching route.";
                ze:help "Ze applies only the leaves that are present in this container,
and keeps every other attribute unchanged.";

                leaf med {
                    type empty;
                    description "Remove the MULTI_EXIT_DISC attribute (RFC 4271 type 4) from the route.";
                    ze:help "RFC 4271 Section 5.1.4 requires a mechanism, based on local
configuration, that removes MULTI_EXIT_DISC from a route. The same section requires the
removal to happen before the route reaches Decision Process phase 1 and phase 2. The
del med operation is that mechanism, so it applies on an IMPORT chain only, and the
route enters the decision process with no metric. Ze refuses del med on an export chain
and writes a log line, because Section 9.1.2.2 states that a comparison on
MULTI_EXIT_DISC followed by advertisement without it causes route loops. del med is
mutually exclusive with set med, increment med and decrement med. Ze already keeps a
metric received from one neighboring AS off another one with no configuration (RFC 4271
Section 5.1.4), so del med is for the operator who wants the metric removed from the
route itself.";
                }
            }

            container increment {
                description "Attributes to increment on a matching route.";
                ze:help "Ze adds the stated value to the current value of the attribute.
The result saturates at the uint32 maximum, 4294967295. increment is mutually exclusive
with set for the same attribute.";

                leaf local-preference {
                    type uint32 {
                        range "1..4294967295";
                    }
                    description "Increment LOCAL_PREF by this value.";
                }

                leaf med {
                    type uint32 {
                        range "1..4294967295";
                    }
                    description "Increment MED by this value.";
                }

                leaf aigp {
                    type uint32 {
                        range "1..4294967295";
                    }
                    description "Increment AIGP metric by this value.";
                }
            }

            container decrement {
                description "Attributes to decrement on a matching route.";
                ze:help "Ze subtracts the stated value from the current value of the
attribute. The result floors at 0, so it never underflows. decrement is mutually
exclusive with set for the same attribute.";

                leaf local-preference {
                    type uint32 {
                        range "1..4294967295";
                    }
                    description "Decrement LOCAL_PREF by this value.";
                }

                leaf med {
                    type uint32 {
                        range "1..4294967295";
                    }
                    description "Decrement MED by this value.";
                }

                leaf aigp {
                    type uint32 {
                        range "1..4294967295";
                    }
                    description "Decrement AIGP metric by this value.";
                }
            }
        }
    }
}
