module ze-raw-cmd {
    namespace "urn:ze:raw:cmd";
    prefix rawcmd;
    import ze-extensions { prefix ze; }
    description "Inject raw bytes into a BGP peer session (testing only)";
    revision 2026-03-16 { description "Initial revision"; }

    container peer {
        config false;
        // The top-level peer verb root. Its children come from three modules:
        // raw here, update in ze-update-cmd, and announce and withdraw in
        // ze-cli-announce-cmd. The summary names what all four share, because
        // a summary naming raw byte injection alone is false for the other
        // three. ze-cli-announce-cmd records that this module owns the text.
        description "Act on selected BGP peer sessions.";
        ze:help "The selector picks the sessions. A selector that matches no session acts on
                 nothing, and it does not act on every peer.";

        container raw {
            config false;
            ze:command "ze-bgp:peer-raw";
            description "Send raw bytes into a peer's TCP stream (dangerous).";
            ze:help "Injects arbitrary bytes with no BGP framing or validation. Intended
for conformance testing and fuzzing only. Will likely break the
session if used carelessly.";
            leaf selector { type string; mandatory true; description "Peer selector"; }
        }
    }
}
