module ze-bgp-cmd-commit-api {
    namespace "urn:ze:bgp:cmd:commit:api";
    prefix "bgp-commit-api";

    import ze-extensions { prefix ze; }

    organization "Ze Project";
    description "BGP named commit workflow RPCs.";
    revision 2026-03-08 {
        description "Initial revision.";
    }

    rpc commit {
        description "Named commit operations (list, start, end, eor, rollback, show, withdraw).";
        ze:help "Write the action before the name. 'commit end <name>' flushes the queued routes without an End-of-RIB marker, and 'commit eor <name>' flushes with one. 'commit rollback <name>' discards the queue instead. The older form 'commit <name> <action>' still runs, and the answer then carries a deprecated key.";
    }
}
