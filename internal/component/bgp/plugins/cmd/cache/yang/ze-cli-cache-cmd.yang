module ze-cli-cache-cmd {
    namespace "urn:ze:cli:cache:cmd";
    prefix clicachecmd;
    import ze-extensions { prefix ze; }
    description "BGP message cache for deferred forwarding and replay";
    revision 2026-03-16 { description "Initial revision"; }
    revision 2026-06-04 { description "Verb-first grammar: show cache (read), request cache (actions)."; }

    container show {
        config false;

        container cache {
            config false;
            ze:command "ze-bgp:cache-list";
            description "List the cached BGP UPDATE message IDs.";
            ze:help "The answer carries two keys, 'ids' and 'count'. An ID is listed while its entry
is retained, or while that entry has not expired. The IDs come alone, with no
retain flag and no consumer state beside them.";
        }
    }

    container request {
        config false;

        // The top-level request verb root, and this is the only module that
        // describes it. The summary names what every child does, because the
        // children come from a dozen owners: as112, bgp, cache, commit,
        // config, interface, l2tp, log, ospf, peer, quiesce and subscribe.
        // A summary naming the cache alone was false for the other eleven.
        description "Commands that act on the running system.";
        ze:help "This keyword runs nothing on its own. Thirteen modules merge their own children
onto it, and this module is the one that describes it.";

        container cache {
            config false;
            description "Manage cached BGP UPDATE messages.";
            ze:help "This keyword runs nothing on its own. Its four commands are retain, release,
expire and forward, and each one takes a cache entry ID. 'show cache' is what
lists the IDs.";

            container retain {
                config false;
                ze:command "ze-bgp:cache-retain";
                description "Prevent eviction of a cached message.";
                ze:help "A retained entry is not evicted when it expires, so it stays listed until
'release' undoes the retain or 'expire' removes it. The ID leaf accepts a
comma-separated list, and each ID is acted on in turn with a failure reported
per ID.";
                leaf id { type string; mandatory true; description "Cache entry ID or comma-separated IDs"; }
            }

            container release {
                config false;
                ze:command "ze-bgp:cache-release";
                description "Ack without forwarding (cache consumer) or undo retain (API).";
                ze:help "The meaning depends on the caller. A cache consumer acknowledges the message and
does not forward it. An API caller undoes an earlier retain. The ID leaf
accepts a comma-separated list, and each ID is acted on in turn.";
                leaf id { type string; mandatory true; description "Cache entry ID or comma-separated IDs"; }
            }

            container expire {
                config false;
                ze:command "ze-bgp:cache-expire";
                description "Remove a cached message immediately.";
                ze:help "The entry is removed at once rather than when its lifetime ends. The ID leaf
accepts a comma-separated list, and each ID is acted on in turn with a failure
reported per ID.";
                leaf id { type string; mandatory true; description "Cache entry ID or comma-separated IDs"; }
            }

            container forward {
                config false;
                ze:command "ze-bgp:cache-forward";
                description "Forward a cached UPDATE to peers matching a selector.";
                ze:help "The selector is a peer address, a peer name, or *, and the cached UPDATE goes to
every peer it matches. The ID leaf accepts a comma-separated list, and the same
selector is applied to each ID in that list.";
                leaf id { type string; mandatory true; description "Cache entry ID or comma-separated IDs"; }
                leaf selector { type string; mandatory true; description "Peer selector (IP, name, or *)"; }
            }
        }
    }
}
