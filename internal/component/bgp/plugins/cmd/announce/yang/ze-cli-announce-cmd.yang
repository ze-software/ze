module ze-cli-announce-cmd {
    namespace "urn:ze:cli:announce:cmd";
    prefix cliannouncecmd;
    import ze-extensions { prefix ze; }
    description "On-demand route origination and lifecycle management";
    revision 2026-08-30 { description "announce is three commands, one per form: unicast, blackhole and flowspec. The arguments after the form word differ between them, so one node could state at most one of the three and the description spelled the rest in prose. This is what withdraw was already split into. unicast and blackhole now state their whole grammar; flowspec states its trailing options only, because the match components are the flowspec NLRI plugin's vocabulary."; }
    revision 2026-08-29 { description "Declare the announce trailing groups: tag carries a key AND a value, so it is one group rather than two leaves, and for carries a duration whose keyword differs from its value name."; }
    revision 2026-08-29 { description "withdraw is three commands, one per form: tag, id and all. Each states its own arguments, so the grammar is in the model rather than in a handler's switch and in a description."; }
    revision 2026-06-27 { description "Initial revision"; }

    container announce {
        config false;
        description "Announce a route on demand to selected peers.
Each form is a command of its own: the arguments after the form word differ
between them, and one node cannot state three grammars.";

        container unicast {
            config false;
            ze:command "ze-bgp:announce-unicast";
            description "Originate a unicast route on demand.";
            leaf prefix { type string { length "1..49"; } mandatory true; description "Prefix to originate, in CIDR form"; }

            container next-hop {
                config false;
                ze:modifier "once";
                description "The next hop to advertise. Defaults to this router.";
                leaf address { type string { length "1..46"; } mandatory true; description "An address, or self for this router"; }
            }

            container community {
                config false;
                ze:modifier "repeat";
                description "A community to attach, repeated for each one.";
                leaf value { type string { length "1..32"; } mandatory true; description "Community, as ASN:value or a well-known name"; }
            }

            container tag {
                config false;
                ze:modifier "once";
                description "A key and a value carried with the announcement, so a later withdraw can name it.";
                leaf key { type string { length "1..64"; } mandatory true; description "Tag key"; }
                leaf value { type string { length "1..64"; } mandatory true; description "Tag value"; }
            }

            container for {
                config false;
                ze:modifier "once";
                description "How long the announcement lives before ze withdraws it.";
                leaf duration { type string { pattern '([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))+|[0-9]+'; } mandatory true; description "Lifetime, in Go duration syntax or in whole seconds"; }
            }
        }

        container blackhole {
            config false;
            ze:command "ze-bgp:announce-blackhole";
            description "Originate a blackhole route on demand.
The BLACKHOLE community is attached by this command, so RFC 7999 Section 3.1
narrows the fan-out to the sessions that recorded the agreement.";
            leaf prefix { type string { length "1..49"; } mandatory true; description "Prefix to blackhole, in CIDR form"; }

            container tag {
                config false;
                ze:modifier "once";
                description "A key and a value carried with the announcement, so a later withdraw can name it.";
                leaf key { type string { length "1..64"; } mandatory true; description "Tag key"; }
                leaf value { type string { length "1..64"; } mandatory true; description "Tag value"; }
            }

            container for {
                config false;
                ze:modifier "once";
                description "How long the announcement lives before ze withdraws it.";
                leaf duration { type string { pattern '([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))+|[0-9]+'; } mandatory true; description "Lifetime, in Go duration syntax or in whole seconds"; }
            }
        }

        container flowspec {
            config false;
            ze:command "ze-bgp:announce-flowspec";
            description "Originate a FlowSpec rule on demand (RFC 8955).
The match components come from ze-flowspec-cmd, which augments this container.
They are the FlowSpec codec vocabulary and the plugin that owns it declares
them, so this module never restates another plugin's words. An augmented
container carries no declaration order, so the components sort by name and land
in front of the action and the options declared here.
Usage: announce flowspec [destination <prefix> ...] [destination-ipv4 <prefix> ...] [destination-ipv6 <prefix> ...] [destination-port <value> ...] [dscp <value> ...] [flow-label <value> ...] [fragment <value> ...] [icmp-code <value> ...] [icmp-type <value> ...] [next-header <value> ...] [packet-length <value> ...] [port <value> ...] [protocol <value> ...] [rd <value>] [source <prefix> ...] [source-ipv4 <prefix> ...] [source-ipv6 <prefix> ...] [source-port <value> ...] [tcp-flags <value> ...] [community <value>] [rate-limit <bytes-per-second>] [discard] [tag <key> <value>] [for <duration>].";

            container community {
                config false;
                ze:modifier "once";
                description "The traffic action, as the extended community RFC 8955
Section 7 defines it. rate-limit and discard are spellings of one.";
                leaf value { type string { length "1..64"; } mandatory true; description "Action community, such as traffic-rate or redirect"; }
            }

            container rate-limit {
                config false;
                ze:modifier "once";
                description "Rate-limit the matched traffic. Sugar for a traffic-rate community.";
                leaf bytes-per-second { type string { pattern '[0-9]+'; length "1..20"; } mandatory true; description "Rate in bytes per second"; }
            }

            container discard {
                config false;
                ze:modifier "once";
                description "Discard the matched traffic. Sugar for a traffic-rate of zero.";
            }

            container tag {
                config false;
                ze:modifier "once";
                description "A key and a value carried with the announcement, so a later withdraw can name it.";
                leaf key { type string { length "1..64"; } mandatory true; description "Tag key"; }
                leaf value { type string { length "1..64"; } mandatory true; description "Tag value"; }
            }

            container for {
                config false;
                ze:modifier "once";
                description "How long the announcement lives before ze withdraws it.";
                leaf duration { type string { pattern '([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))+|[0-9]+'; } mandatory true; description "Lifetime, in Go duration syntax or in whole seconds"; }
            }
        }
    }

    container withdraw {
        config false;
        description "Withdraw on-demand announcements.";

        container tag {
            config false;
            ze:command "ze-bgp:withdraw-tag";
            description "Withdraw the announcements carrying a tag. A key of * withdraws every tagged announcement, and an absent value withdraws every value of the key.";
            leaf key { type string; mandatory true; description "Tag key, or * for every tagged announcement"; }
            leaf value { type string; description "Tag value; every value of the key when absent"; }
        }

        container id {
            config false;
            ze:command "ze-bgp:withdraw-id";
            description "Withdraw one announcement by the id that show announcements reports.";
            leaf id { type string { length "1..20"; } mandatory true; description "Announcement id, as show announcements reports it"; }
        }

        container all {
            config false;
            ze:command "ze-bgp:withdraw-all";
            description "Withdraw every on-demand announcement, or every one whose peer selector matches a pattern.";
            leaf selector { type string; description "Peer selector pattern; every announcement when absent"; }
        }
    }

    container show {
        config false;

        container announcements {
            config false;
            ze:command "ze-bgp:show-announcements";
            description "List active on-demand announcements.";
            leaf tag { type string { length "1..64"; } description "Show only announcements carrying this tag key"; }
            leaf selector { type string; description "Show only announcements whose peer selector matches this pattern"; }
            leaf family { type string { length "1..32"; } description "Show only announcements of this address family"; }
        }
    }
}
