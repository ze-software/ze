module ze-cli-announce-cmd {
    namespace "urn:ze:cli:announce:cmd";
    prefix cliannouncecmd;
    import ze-extensions { prefix ze; }
    description "On-demand route origination and lifecycle management";
    revision 2026-09-05 { description "Every announce and withdraw form answers at one path, send bgp <selector>, and the two paths each had before are gone. The bare form is gone with them, so a form with no selector is refused and send bgp * is how an operator reaches every peer. The announce keyword is gone too: send is the verb, and to send a route IS to announce it, so the token after the selector names what goes on the wire (owner decision, 2026-09-05). withdraw stays, because a withdraw is the opposite act rather than the same act named twice, and it is the word RFC 4271 and ExaBGP both use. The root peer container is deleted: both its children moved and nothing else declared it."; }
    revision 2026-09-05 { description "This module states the text of the top-level peer container. ze-raw-cmd stated it while raw and update answered under that keyword, and both forms have moved to send bgp. No announce or withdraw form changes."; }
    revision 2026-09-01 { description "The two-path declaration is restored, and the flowspec traffic action is a one-of. A replay of an older upstream snapshot dropped the announce-forms and withdraw-forms groupings and the peer container, while ze-flowspec-cmd kept augmenting /cliannouncecmd:peer/announce/flowspec. That augment then resolved against nothing, so every config load failed and the daemon started for nobody. The one-of the same replay introduced is kept: community, rate-limit and discard are three spellings of the one extended community RFC 8955 Section 7 defines, an operator supplies exactly one, and the generated line bracketed all three as if the command ran without any. They sit in an action container carrying ze:modifier one-of, which the renderer states as a required alternation. The container's name is never typed."; }
    revision 2026-08-31 { description "Every announce and withdraw form is reachable at two paths. A bare form reaches every peer. peer <selector> announce and peer <selector> withdraw reach the peers the selector matches. That is the ExaBGP order an operator already types. Each set of forms is one grouping instantiated twice, so the second path restates no grammar. The selector is declared on the peer container the operator types it after. withdraw all loses its own selector leaf: the peer prefix states that scope for every form rather than one form stating it in its tail."; }
    revision 2026-08-30 { description "announce is three commands, one per form: unicast, blackhole and flowspec. The arguments after the form word differ between them, so one node could state at most one of the three and the description spelled the rest in prose. This is what withdraw was already split into. unicast and blackhole now state their whole grammar; flowspec states its trailing options only, because the match components are the flowspec NLRI plugin's vocabulary."; }
    revision 2026-08-29 { description "Declare the announce trailing groups: tag carries a key AND a value, so it is one group rather than two leaves, and for carries a duration whose keyword differs from its value name."; }
    revision 2026-08-29 { description "withdraw is three commands, one per form: tag, id and all. Each states its own arguments, so the grammar is in the model rather than in a handler's switch and in a description."; }
    revision 2026-06-27 { description "Initial revision"; }

    grouping announce-forms {
        description "The three announce forms. Each answers at one path, send bgp <selector>, with no announce keyword in front of it. The grouping stays because ze-flowspec-cmd augments the flowspec form and a grouping is what that augment resolves against.";

        container unicast {
            config false;
            ze:command "ze-bgp:announce-unicast";
            description "Originate a unicast route on demand.";
            ze:help "The address family follows the prefix, so it is ipv4 unicast or ipv6
unicast. The ORIGIN is IGP, and the next hop is this router unless next-hop names one.";
            leaf prefix { type string { length "1..49"; } mandatory true; description "Prefix to originate, in CIDR form"; }

            container next-hop {
                config false;
                ze:modifier "once";
                description "The next hop to advertise.";
                ze:help "It defaults to this router.";
                leaf address { type string { length "1..46"; } mandatory true; description "An address, or self for this router"; }
            }

            container community {
                config false;
                ze:modifier "repeat";
                description "A community to attach, repeated for each one.";
                ze:help "The value is a standard community. Naming BLACKHOLE here meets
RFC 7999 Section 3.1 and its agreement gate. The fan-out then narrows to the sessions that
recorded the agreement.";
                leaf value { type string { length "1..32"; } mandatory true; description "Community, as ASN:value or a well-known name"; }
            }

            container tag {
                config false;
                ze:modifier "once";
                description "A key and a value carried with the announcement, so a later withdraw can name it.";
                ze:help "The tag is what puts the announcement in the registry. Without a
tag the announcement is not tracked, so show announcements never lists it and withdraw id
cannot reach it. Each half is 64 characters at most.";
                leaf key { type string { length "1..64"; } mandatory true; description "Tag key"; }
                leaf value { type string { length "1..64"; } mandatory true; description "Tag value"; }
            }

            container for {
                config false;
                ze:modifier "once";
                description "How long the announcement lives before ze withdraws it.";
                ze:help "The value is a Go duration such as 300s, or a whole number of
seconds. It is read only when the announcement also carries a tag, because the timer lives
with the registry entry.";
                leaf duration { type string { pattern '([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))+|[0-9]+'; } mandatory true; description "Lifetime, in Go duration syntax or in whole seconds"; }
            }
        }

        container blackhole {
            config false;
            ze:command "ze-bgp:announce-blackhole";
            description "Originate a blackhole route on demand.";
            ze:help "This command attaches the BLACKHOLE community itself, so
RFC 7999 Section 3.1 narrows the fan-out to the sessions that recorded the
agreement.";
            leaf prefix { type string { length "1..49"; } mandatory true; description "Prefix to blackhole, in CIDR form"; }

            container tag {
                config false;
                ze:modifier "once";
                description "A key and a value carried with the announcement, so a later withdraw can name it.";
                ze:help "The tag is what puts the announcement in the registry. Without a
tag the announcement is not tracked, so show announcements never lists it and withdraw id
cannot reach it. Each half is 64 characters at most.";
                leaf key { type string { length "1..64"; } mandatory true; description "Tag key"; }
                leaf value { type string { length "1..64"; } mandatory true; description "Tag value"; }
            }

            container for {
                config false;
                ze:modifier "once";
                description "How long the announcement lives before ze withdraws it.";
                ze:help "The value is a Go duration such as 300s, or a whole number of
seconds. It is read only when the announcement also carries a tag, because the timer lives
with the registry entry.";
                leaf duration { type string { pattern '([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))+|[0-9]+'; } mandatory true; description "Lifetime, in Go duration syntax or in whole seconds"; }
            }
        }

        container flowspec {
            config false;
            ze:command "ze-bgp:announce-flowspec";
            description "Originate a FlowSpec rule on demand (RFC 8955).";
            ze:help "The match components come from ze-flowspec-cmd, which
augments this container. They are the FlowSpec codec vocabulary, and the plugin
that owns it declares them, so this module never restates another plugin's
words. An augmented container carries no declaration order, so the components
sort by name and land in front of the action and the options declared here.";

            container action {
                config false;
                ze:modifier "one-of";
                description "The traffic action, which every FlowSpec rule must carry.";
                ze:help "RFC 8955 Section 7 makes it an extended community, so
the three containers below are three spellings of ONE community rather than
three mechanisms: community is the general case, and rate-limit and discard are
sugar over it. The operator types one of them and never types this container's
name.";

                container community {
                    config false;
                    ze:modifier "once";
                    description "The traffic action, as the extended community RFC 8955 Section 7 defines it.";
                    ze:help "rate-limit and discard are two spellings of this one
action.";
                    leaf value { type string { length "1..64"; } mandatory true; description "Action community, such as traffic-rate or redirect"; }
                }

                container rate-limit {
                    config false;
                    ze:modifier "once";
                    description "Rate-limit the matched traffic.";
                    ze:help "It is sugar for a traffic-rate community.";
                    leaf bytes-per-second { type string { pattern '[0-9]+'; length "1..20"; } mandatory true; description "Rate in bytes per second"; }
                }

                container discard {
                    config false;
                    ze:modifier "once";
                    description "Discard the matched traffic.";
                    ze:help "It is sugar for a traffic-rate of zero.";
                }
            }

            container tag {
                config false;
                ze:modifier "once";
                description "A key and a value carried with the announcement, so a later withdraw can name it.";
                ze:help "The tag is what puts the announcement in the registry. Without a
tag the announcement is not tracked, so show announcements never lists it and withdraw id
cannot reach it. Each half is 64 characters at most.";
                leaf key { type string { length "1..64"; } mandatory true; description "Tag key"; }
                leaf value { type string { length "1..64"; } mandatory true; description "Tag value"; }
            }

            container for {
                config false;
                ze:modifier "once";
                description "How long the announcement lives before ze withdraws it.";
                ze:help "The value is a Go duration such as 300s, or a whole number of
seconds. It is read only when the announcement also carries a tag, because the timer lives
with the registry entry.";
                leaf duration { type string { pattern '([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))+|[0-9]+'; } mandatory true; description "Lifetime, in Go duration syntax or in whole seconds"; }
            }
        }
    }

    grouping withdraw-forms {
        description "The three withdraw forms. Each answers at one path, send bgp <selector> withdraw.";

        container tag {
            config false;
            ze:command "ze-bgp:withdraw-tag";
            description "Withdraw the announcements carrying a tag.";
            ze:help "A key of * withdraws every tagged announcement. An absent
value withdraws every value of the key.";
            leaf key { type string; mandatory true; description "Tag key, or * for every tagged announcement"; }
            leaf value { type string; description "Tag value; every value of the key when absent"; }
        }

        container id {
            config false;
            ze:command "ze-bgp:withdraw-id";
            description "Withdraw one announcement by the id that show announcements reports.";
            ze:help "Only a tagged announcement carries an id. After peer <selector>, the
withdraw acts only when that selector is the one the announcement was made with, compared as
text.";
            leaf id { type string { length "1..20"; } mandatory true; description "Announcement id, as show announcements reports it"; }
        }

        container all {
            config false;
            ze:command "ze-bgp:withdraw-all";
            description "Withdraw every on-demand announcement.";
            ze:help "Type it after peer <selector> to withdraw only the
announcements made to those peers.";
        }
    }

    container send {
        config false;

        container bgp {
            config false;

            // No description on either container, and no selector leaf. The send
            // and bgp nodes are shared with ze-raw-cmd, which owns the text they
            // state and declares the selector every command below bgp inherits.
            // mergeYANGEntry warns when two modules describe one node differently.

            // The three announce forms sit directly under bgp. There is no
            // announce keyword, because send is already the verb and to send a
            // route IS to announce it (owner decision, 2026-09-05). The token
            // after the selector names WHAT goes on the wire.
            uses announce-forms;

            container withdraw {
                config false;
                description "Withdraw on-demand announcements.";
                ze:help "Only a tagged announcement can be withdrawn by these forms, because an
announcement made without a tag leaves no registry entry. The three forms are tag, id and
all. The word stays where announce went, because a withdraw is the opposite act rather
than the same act named twice, and it is the word RFC 4271 and ExaBGP both use.";
                uses withdraw-forms;
            }
        }
    }

    container show {
        config false;

        container announcements {
            config false;
            ze:command "ze-bgp:show-announcements";
            description "List active on-demand announcements.";
            ze:help "Each row carries the id, the tag, the family, the peer selector, the
source and the creation time. An expiry time is present only when the announcement was made
with for.";
            leaf tag { type string { length "1..64"; } description "Show only announcements carrying this tag key"; }
            leaf selector { type string; description "Show only announcements whose peer selector matches this pattern"; }
            leaf family { type string { length "1..32"; } description "Show only announcements of this address family"; }
        }
    }
}
