module ze-monitor-cmd {
    namespace "urn:ze:monitor:cmd";
    prefix moncmd;
    import ze-extensions { prefix ze; }
    description "monitor bgp command. Owned by the bgp-monitor plugin so that removing the BGP surface removes this node with its handler. The monitor verb root and all non-BGP monitor subcommands live outside this plugin (cmd/monitor and the per-feature owners). See ai/rules/plugin-self-containment.md.";
    revision 2026-06-03 { description "Trim to monitor bgp only; the verb root and non-BGP subcommands moved to cmd/monitor and per-feature owners."; }

    container monitor {
        config false;
        description "Continuous monitoring commands (Ctrl-C to stop).";

        container bgp {
            config false;
            ze:command "ze-bgp:monitor";
            ze:task-support required;
            description "Live BGP peer dashboard that refreshes automatically.";
            ze:help "Shows all peers with state, uptime, and prefix counts. State changes
highlight as they happen. Ctrl-C to stop.";
        }
    }
}
