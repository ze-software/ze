module ze-monitor-cmd {
    namespace "urn:ze:monitor:cmd";
    prefix moncmd;
    import ze-extensions { prefix ze; }
    description "Monitor command tree (verb-first: monitor <module>)";
    revision 2026-05-18 { description "Add monitor system netlink (kernel event streaming)"; }

    container monitor {
        config false;
        description "Long-running auto-refreshing commands";

        container bgp {
            config false;
            ze:command "ze-bgp:monitor";
            ze:task-support required;
            description "Live peer status dashboard";
        }

        container event {
            config false;
            ze:command "ze-event:monitor";
            ze:task-support required;
            description "Stream live events with optional include/exclude filters";
        }

        container ping {
            config false;
            ze:command "ze-monitor:ping";
            ze:task-support required;
            description "Continuous ping with live stats (<target> [interval Ns] [timeout Ns])";
        }

        container traceroute {
            config false;
            ze:command "ze-monitor:traceroute";
            ze:task-support required;
            description "Live mtr-style traceroute (<target> [max-hops N])";
        }

        container interface {
            config false;
            description "Interface monitoring commands";

            container rate {
                config false;
                ze:command "ze-monitor:interface-rate";
                ze:task-support required;
                description "Stream per-second interface rate data (rx/tx bytes and packets per second). Optional interface name filter.";
            }
        }

        container system {
            config false;
            description "System-level monitor commands";

            container netlink {
                config false;
                ze:command "ze-monitor:system-netlink";
                ze:task-support required;
                description "Stream kernel netlink events (route, link, address changes). Args: [route|link|address|all]";
            }
        }
    }
}
