module ze-hostname {
    namespace "urn:ze:hostname";
    prefix hostname;

    import ze-bgp-conf { prefix bgp; }
    import ze-extensions { prefix ze; }

    description
        "FQDN capability plugin for ZeBGP (draft-walton-bgp-hostname, code 73).
         Advertises hostname and domain name of the BGP speaker.";

    revision 2025-01-29 {
        description "Initial revision.";
    }

    // Standalone peers: augment capability container
    augment "/bgp:bgp/bgp:peer/bgp:session/bgp:capability" {
        container hostname {
            description "FQDN capability configuration.";
            ze:help "Ze sends the FQDN capability, code 73 of draft-walton-bgp-hostname, in the OPEN message. Ze
                sends no capability when host and domain are both empty. A container on the peer replaces the
                container on the group rather than adding to it.";

            leaf host {
                type string {
                    length "0..255";
                }
                description "System hostname (max 255 bytes).";
                ze:help "Ze writes the value with a 1-byte length in front of it, which is why 255 bytes is the
                    limit. Ze does not read the hostname of the box, so an empty leaf sends an empty string.";
            }

            leaf domain {
                type string {
                    length "0..255";
                }
                description "Domain name (max 255 bytes).";
                ze:help "The capability carries host and domain as two separate strings, and Ze joins neither. Ze
                    writes the domain after the host, with its own 1-byte length, which is why 255 bytes is the
                    limit.";
            }
        }
    }

    // Group-level capability
    augment "/bgp:bgp/bgp:group/bgp:session/bgp:capability" {
        container hostname {
            description "FQDN capability configuration.";
            ze:help "Ze sends the FQDN capability, code 73 of draft-walton-bgp-hostname, in the OPEN message. Ze
                sends no capability when host and domain are both empty. A container on the peer replaces the
                container on the group rather than adding to it.";

            leaf host {
                type string {
                    length "0..255";
                }
                description "System hostname (max 255 bytes).";
                ze:help "Ze writes the value with a 1-byte length in front of it, which is why 255 bytes is the
                    limit. Ze does not read the hostname of the box, so an empty leaf sends an empty string.";
            }

            leaf domain {
                type string {
                    length "0..255";
                }
                description "Domain name (max 255 bytes).";
                ze:help "The capability carries host and domain as two separate strings, and Ze joins neither. Ze
                    writes the domain after the host, with its own 1-byte length, which is why 255 bytes is the
                    limit.";
            }
        }
    }

    // Grouped peers: augment capability container
    augment "/bgp:bgp/bgp:group/bgp:peer/bgp:session/bgp:capability" {
        container hostname {
            description "FQDN capability configuration.";
            ze:help "Ze sends the FQDN capability, code 73 of draft-walton-bgp-hostname, in the OPEN message. Ze
                sends no capability when host and domain are both empty. A container on the peer replaces the
                container on the group rather than adding to it.";

            leaf host {
                type string {
                    length "0..255";
                }
                description "System hostname (max 255 bytes).";
                ze:help "Ze writes the value with a 1-byte length in front of it, which is why 255 bytes is the
                    limit. Ze does not read the hostname of the box, so an empty leaf sends an empty string.";
            }

            leaf domain {
                type string {
                    length "0..255";
                }
                description "Domain name (max 255 bytes).";
                ze:help "The capability carries host and domain as two separate strings, and Ze joins neither. Ze
                    writes the domain after the host, with its own 1-byte length, which is why 255 bytes is the
                    limit.";
            }
        }
    }

    // Standalone peers: legacy syntax (in session container)
    augment "/bgp:bgp/bgp:peer/bgp:session" {
        leaf host-name {
            type string {
                length "0..255";
            }
            description "Legacy: Host name for FQDN capability.";
            ze:help "Ze reads the leaf after capability > hostname > host and replaces that value with it, so a
                peer that writes both leaves sends this one. The capability writes a 1-byte length in front of the
                host name, which is the 255-byte limit. Write capability > hostname > host in a new config:
                ze exabgp migrate produces that spelling and never this one.";
        }

        leaf domain-name {
            type string {
                length "0..255";
            }
            description "Legacy: Domain name for FQDN capability.";
            ze:help "Ze reads the leaf after capability > hostname > domain and replaces that value with it, so a
                peer that writes both leaves sends this one. The capability writes a 1-byte length in front of the
                domain name, which is the 255-byte limit. Write capability > hostname > domain in a new config:
                ze exabgp migrate produces that spelling and never this one.";
        }
    }

    // Grouped peers: legacy syntax (in session container)
    augment "/bgp:bgp/bgp:group/bgp:peer/bgp:session" {
        leaf host-name {
            type string {
                length "0..255";
            }
            description "Legacy: Host name for FQDN capability.";
            ze:help "Ze reads the leaf after capability > hostname > host and replaces that value with it, so a
                peer that writes both leaves sends this one. The capability writes a 1-byte length in front of the
                host name, which is the 255-byte limit. Write capability > hostname > host in a new config:
                ze exabgp migrate produces that spelling and never this one.";
        }

        leaf domain-name {
            type string {
                length "0..255";
            }
            description "Legacy: Domain name for FQDN capability.";
            ze:help "Ze reads the leaf after capability > hostname > domain and replaces that value with it, so a
                peer that writes both leaves sends this one. The capability writes a 1-byte length in front of the
                domain name, which is the 255-byte limit. Write capability > hostname > domain in a new config:
                ze exabgp migrate produces that spelling and never this one.";
        }
    }

    // Group-level: legacy syntax (in session container)
    augment "/bgp:bgp/bgp:group/bgp:session" {
        leaf host-name {
            type string {
                length "0..255";
            }
            description "Legacy: Host name for FQDN capability (group default).";
            ze:help "A member peer that states no host-name of its own takes this value. Ze reads the leaf after
                capability > hostname > host and replaces that value with it. The capability writes a 1-byte length
                in front of the host name, which is the 255-byte limit. Write capability > hostname > host in a new
                config: ze exabgp migrate produces that spelling and never this one.";
        }

        leaf domain-name {
            type string {
                length "0..255";
            }
            description "Legacy: Domain name for FQDN capability (group default).";
            ze:help "A member peer that states no domain-name of its own takes this value. Ze reads the leaf after
                capability > hostname > domain and replaces that value with it. The capability writes a 1-byte length
                in front of the domain name, which is the 255-byte limit. Write capability > hostname > domain in a new
                config: ze exabgp migrate produces that spelling and never this one.";
        }
    }
}
