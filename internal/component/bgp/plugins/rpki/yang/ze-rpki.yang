module ze-rpki {
  namespace "urn:ze:rpki";
  prefix rpki;

  import ze-bgp-conf {
    prefix bgp;
  }

  import ze-types {
    prefix zt;
  }

  // Action applied to a route in a given RPKI validation state.
  // Shared by the global and per-peer/group action blocks so the set of
  // choices stays identical everywhere. Order is display-only.
  typedef validation-action {
    type enumeration {
      enum reject { description "Exclude the route from the Adj-RIB-In and decision process"; }
      enum log-only { description "Keep the route (still marked with its state) but log it"; }
      enum accept { description "Keep the route with no log"; }
    }
    description "RPKI validation-state action (RFC 6811 Section 3: operator-configurable per state)";
  }

  // Per-peer / per-group policy overrides. A subset of rpki-config: only the
  // action blocks, and the leaves carry NO defaults so an unset leaf falls
  // through to the group then the global value (per-leaf inheritance). The
  // transport/enable settings (cache-server, validation-timeout, aspa
  // validation) are global-only and deliberately absent here.
  grouping rpki-peer-policy {
    container rpki {
      description "Per-peer/group RPKI action overrides (peer > group > global, resolved per leaf)";

      container action {
        description "Origin-validation action overrides for this peer/group";
        leaf invalid {
          type validation-action;
          description "Action for routes with Invalid validation state (unset: inherit group then global)";
        }
        leaf not-found {
          type validation-action;
          description "Action for routes with NotFound validation state (unset: inherit group then global)";
        }
      }

      leaf blackhole-exempt {
        type boolean;
        default "false";
        description
          "Keep a route that carries the RFC 7999 BLACKHOLE community when its
           only origin-validation fault is that the prefix is longer than a
           covering VRP allows.

           RFC 7999 Section 3.3 states that an operator MUST ensure origin
           validation does not inadvertently block legitimate announcements
           carrying BLACKHOLE. A blackhole prefix is as long as possible,
           typically a /32 or a /128, while a ROA for the covering block carries
           its maxLength at the aggregate. RFC 6811 then makes the announcement
           Invalid, and a session running action invalid reject drops it before
           anything can honor it.

           The exemption is narrow. It applies only when a covering VRP names
           the route's own origin AS and disagrees on nothing but length. A
           wrong origin AS stays Invalid, which is the hijack RFC 6811 exists to
           catch. A prefix with no covering VRP is NotFound rather than Invalid,
           so this never reaches it.

           The default is false. Turn it on together with the peer's blackhole
           honor leaf, on the same session: on its own it accepts a route it
           would have rejected and discards nothing.";
      }

      container aspa {
        description "ASPA action overrides for this peer/group (only applies when ASPA validation is enabled globally)";
        container action {
          leaf invalid {
            type validation-action;
            description "Action for routes with ASPA Invalid path state (unset: inherit group then global)";
          }
          leaf unknown {
            type validation-action;
            description "Action for routes with ASPA Unknown path state (unset: inherit group then global)";
          }
        }
      }
    }
  }

  grouping rpki-config {
    container rpki {
      presence "RPKI origin validation enabled";

      list cache-server {
        key "address";
        leaf address {
          type string;
          description "Cache server IP or hostname";
        }
        leaf port {
          type uint16;
          default "323";
          description "RTR TCP port";
        }
        leaf preference {
          type uint8;
          default "100";
          description "Server preference (lower = preferred)";
        }
        leaf source-address {
          type zt:ip-address;
          description "Source IP address for outbound RTR connections";
        }
      }

      leaf validation-timeout {
        type uint16;
        default "30";
        units "seconds";
        description "Fail-open timeout for pending routes";
      }

      container action {
        description "Global origin-validation actions (RFC 6811 Section 3)";
        leaf invalid {
          type validation-action;
          default "reject";
          description "Action for routes with Invalid validation state";
        }
        leaf not-found {
          type validation-action;
          default "accept";
          description "Action for routes with NotFound validation state";
        }
      }

      container aspa {
        leaf validation {
          type boolean;
          default "false";
          description "Enable ASPA path verification using RTR v2 ASPA records";
        }
        container action {
          leaf invalid {
            type validation-action;
            default "log-only";
            description "Action for routes with ASPA Invalid path verification state";
          }
          leaf unknown {
            type validation-action;
            default "accept";
            description "Action for routes with ASPA Unknown path verification state";
          }
        }
      }
    }
  }

  augment "/bgp:bgp" {
    uses rpki-config;
  }

  // Per-peer and per-group action overrides (same three levels the role plugin uses).
  augment "/bgp:bgp/bgp:peer" {
    uses rpki-peer-policy;
  }

  augment "/bgp:bgp/bgp:group/bgp:peer" {
    uses rpki-peer-policy;
  }

  augment "/bgp:bgp/bgp:group" {
    uses rpki-peer-policy;
  }
}
