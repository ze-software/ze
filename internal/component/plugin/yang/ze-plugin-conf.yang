module ze-plugin-conf {
    namespace "urn:ze:plugin:conf";
    prefix plug;

    import ze-types { prefix zt; }
    import ze-extensions { prefix ze; }

    description "Plugin configuration for ZeBGP";

    revision 2026-01-01 {
        description "Initial revision";
    }

    container plugin {
        description "Plugin configuration";

        container hub {
            description "Plugin transport and auth configuration";

            list server {
                key "name";
                ze:listener;
                description "Named hub server instances (TLS listeners)";

                leaf name {
                    type string { length "1..64"; }
                    description "Server block name (e.g., local, central)";
                }

                uses zt:listener;

                leaf secret {
                    type string;
                    ze:sensitive;
                    description "Auth token for plugin connections (min 32 chars)";
                }

                leaf certificate {
                    type string { length "1..64"; }
                    description "Name of the pki certificate the managed-client listener on this block serves.";
                    ze:help "Name of a pki certificate the managed-client listener on this block serves. An empty name serves a
                        certificate this daemon's own certificate authority issues, and reissues as it ages. Export that
                        authority root with 'show pki local-ca pem' and name it in each client's pki ca block, so a client
                        validates the chain rather than one certificate.";
                }

                list client {
                    key "name";
                    description "Accepted remote managed clients";

                    leaf name {
                        type string { length "1..64"; }
                        description "Client identity name";
                    }

                    leaf secret {
                        type string;
                        ze:sensitive;
                        description "Per-client auth token (min 32 chars)";
                    }
                }
            }

            list client {
                key "name";
                description "Outbound hub connections (managed client mode)";

                leaf name {
                    type string { length "1..64"; }
                    description "Client identity name";
                }

                leaf host {
                    type string;
                    description "Remote hub address";
                }

                leaf port {
                    type uint16;
                    description "Remote hub port";
                }

                leaf secret {
                    type string;
                    ze:sensitive;
                    description "Auth token (min 32 chars)";
                }

                leaf source-address {
                    type zt:ip-address;
                    description "Source IP address for outbound hub connections.";
                }

                leaf ca {
                    type string {
                        length "1..255";
                        pattern '[A-Za-z0-9._-]+';
                    }
                    description "Name of the pki ca entry holding the hub certificate authority root.";
                    ze:help "Name of a pki ca entry holding the certificate authority root of the hub this client connects to.
                        The client validates the hub certificate chain against that root and refuses any other chain, so it
                        sends no token to a hub it did not authenticate. Export the root from the hub and paste it into a
                        pki ca block on this client. A leaf the hub reissues still validates, because the root is the anchor
                        and not the certificate.";
                }
            }
        }

        list internal {
            key "name";
            description "Built-in plugin running in-process";

            leaf name {
                type string {
                    length "1..64";
                }
                description "Plugin name";
            }

            leaf use {
                type string {
                    length "1..64";
                }
                ze:validate "internal-plugin-name";
                description "Name of a built-in plugin to run in-process";
            }
        }

        list external {
            key "name";
            description "External plugin process";

            leaf name {
                type string {
                    length "1..64";
                }
                description "Plugin name";
            }

            leaf run {
                type string;
                description "Command to execute plugin as external process (with args)";
            }

            leaf use {
                type string;
                description "Name of a built-in plugin to run in-process (mutually exclusive with run)";
            }

            leaf encoder {
                type enumeration {
                    enum json { description "JSON encoding"; }
                    enum text { description "Human-readable text encoding"; }
                }
                description "Event encoding format";
            }

            leaf respawn {
                type boolean;
                description "Respawn on exit";
            }

            leaf timeout {
                type string;
                description "Startup timeout (e.g., 10s, 1m)";
            }
        }
    }

}
