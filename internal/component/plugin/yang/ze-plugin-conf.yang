module ze-plugin-conf {
    namespace "urn:ze:plugin:conf";
    prefix plug;

    import ze-types { prefix zt; }
    import ze-extensions { prefix ze; }

    description "Message bus, endpoint, participant filter, and hub transport configuration for Ze.";

    revision 2026-11-24 {
        description "Replace container plugin with container bus (ze:first-pass) and reusable grouping participant-bus.";
    }

    revision 2026-01-01 {
        description "Initial revision";
    }

    grouping participant-bus {
        description "Direction-separated message bus delivery and filtering rules shared by bus endpoints,
            central participant overrides, and participant schema nodes augmented with a bus block.";

        container receive {
            presence "Configure inbound bus delivery rules.";
            description "Inbound bus delivery rules controlling which messages this participant may receive,
                which senders may address it, and optional per-message sender or tag filters.";
            ze:help "Inbound message bus delivery and filtering rules.";

            leaf-list allow {
                type string;
                ze:validate "bus-message-or-none";
                ze:replace-whole;
                description "Message names this participant is allowed to receive. Absent allows every message
                    the participant kind declared receiving. A listed set narrows to those message names only.
                    Writing 'none' allows no inbound messages and cannot be combined with other names.";
                ze:help "Allowed inbound message names, or 'none' to block all inbound messages.";
            }

            leaf-list from {
                type string;
                ze:validate "bus-path-or-none";
                ze:replace-whole;
                description "Participant paths (short form) allowed to address this participant for every
                    message. Absent allows every sender. A listed set narrows to those senders and their
                    descendants. Writing 'none' allows nobody and cannot be combined with other paths.";
                ze:help "Allowed sender participant paths, or 'none' to accept from nobody.";
            }

            list message {
                key "name";
                ze:replace-whole;
                description "Per-message inbound overrides. Each entry replaces an inherited entry for the
                    same message name whole while sibling message entries remain inherited.";
                ze:help "Per-message inbound sender and tag filters.";

                leaf name {
                    type string;
                    ze:validate "bus-message-name";
                    description "Qualified message name in '<namespace>:<message>' form (or 'cli:<path>')
                        declared as receivable by this participant kind.";
                    ze:help "Message name to filter inbound.";
                }

                leaf-list from {
                    type string;
                    ze:validate "bus-path-or-none";
                    ze:replace-whole;
                    description "Sender participant paths allowed for this message alone, overriding the
                        block-level receive > from list. Writing 'none' blocks every sender for this message.";
                    ze:help "Allowed sender paths for this message, or 'none'.";
                }

                list tag {
                    key "name";
                    ze:replace-whole;
                    description "Inbound tag filters for this message. Multiple tag entries must all match.
                        Writing a tag entry replaces an inherited entry for the same tag name whole.";
                    ze:help "Tag filter narrowing inbound delivery of this message.";

                    leaf name {
                        type string;
                        description "Tag name declared on this message by its sending participant kinds.";
                        ze:help "Tag name to filter on.";
                    }

                    leaf-list value {
                        type string;
                        ze:replace-whole;
                        description "Allowed values for this tag. The participant receives the message only
                            when the message carries one of the listed values.";
                        ze:help "Allowed tag values.";
                    }
                }
            }
        }

        container send {
            presence "Configure outbound bus delivery rules.";
            description "Outbound bus delivery rules controlling which messages this participant may send,
                where its messages go, and optional per-message destination or tag filters.";
            ze:help "Outbound message bus delivery and filtering rules.";

            leaf-list allow {
                type string;
                ze:validate "bus-message-or-none";
                ze:replace-whole;
                description "Message names this participant is allowed to send. Absent allows every message
                    the participant kind declared sending. A listed set narrows to those message names only.
                    Writing 'none' allows no outbound messages and cannot be combined with other names.";
                ze:help "Allowed outbound message names, or 'none' to block all outbound messages.";
            }

            leaf-list to {
                type string;
                ze:validate "bus-path-or-none";
                ze:replace-whole;
                description "Destination participant paths (short form) for every message this participant
                    sends. Absent uses the destinations registered by the participant kind. A listed set
                    replaces the registered destinations entirely. Writing 'none' sends to nobody and cannot
                    be combined with other paths.";
                ze:help "Destination participant paths replacing defaults, or 'none' to send to nobody.";
            }

            list message {
                key "name";
                ze:replace-whole;
                description "Per-message outbound overrides. Each entry replaces an inherited entry for the
                    same message name whole while sibling message entries remain inherited.";
                ze:help "Per-message outbound destination and tag filters.";

                leaf name {
                    type string;
                    ze:validate "bus-message-name";
                    description "Qualified message name in '<namespace>:<message>' form (or 'cli:<path>')
                        declared as sendable by this participant kind.";
                    ze:help "Message name to filter outbound.";
                }

                leaf-list to {
                    type string;
                    ze:validate "bus-path-or-none";
                    ze:replace-whole;
                    description "Destination participant paths for this message alone, overriding the
                        block-level send > to list. Writing 'none' sends this message to nobody.";
                    ze:help "Destination paths for this message, or 'none'.";
                }

                list tag {
                    key "name";
                    ze:replace-whole;
                    description "Outbound tag filters for this message. Multiple tag entries must all match.
                        Writing a tag entry replaces an inherited entry for the same tag name whole.";
                    ze:help "Tag filter narrowing outbound emission of this message.";

                    leaf name {
                        type string;
                        description "Tag name declared on this message by this participant kind.";
                        ze:help "Tag name to filter on.";
                    }

                    leaf-list value {
                        type string;
                        ze:replace-whole;
                        description "Allowed values for this tag. The bus admits the outbound message only
                            when the message carries one of the listed values.";
                        ze:help "Allowed tag values.";
                    }
                }
            }
        }
    }

    container bus {
        ze:first-pass;
        description "Declares message bus endpoints, central participant filters, and the hub transport
            listener and client connections. Built-in plugins load automatically when their configuration
            roots are present; declare an endpoint entry to run a built-in plugin under a chosen name or
            in a separate process, to run an external program, or to override its bus delivery rules.
            Declare a participant entry to apply bus filters centrally to any participant by its path.";
        ze:help "Message bus endpoints, participant filters, and hub transport.";

        list endpoint {
            key "name";
            description "Declares one program on the message bus, either a compiled-in plugin (internal)
                or a program Ze did not ship (external). Its participant path is '/bus/endpoint/<name>'.
                A compiled-in plugin keeps its compiled registration identity under any endpoint name
                and on either transport. internal and external are mutually exclusive.";
            ze:help "Program endpoint connected to the message bus.";

            leaf name {
                type string;
                ze:validate "external-plugin-name";
                description "The key of the endpoint, forming the participant path '/bus/endpoint/<name>'
                    and passed to a forked process as ZE_PLUGIN_NAME. The hub binds the connect-back token
                    to this name, so one endpoint's token authenticates no other. The name is 1 to 64
                    letters, digits and hyphens, starting with a letter or digit.";
                ze:help "Endpoint name (1..64 alphanumeric or hyphen characters).";
            }

            leaf internal {
                type string;
                ze:validate "internal-plugin-name";
                description "Registry name of a compiled-in plugin shipped inside the ze binary. The
                    endpoint keeps the compiled registration's identity, state grants, and defaults
                    regardless of endpoint name or process mode. Mutually exclusive with external.";
                ze:help "Registered name of a compiled-in plugin.";
            }

            leaf process {
                type enumeration {
                    enum in-daemon {
                        ze:help "Run the compiled-in plugin inside the ze daemon over an in-memory pipe.";
                    }
                    enum separate {
                        ze:help "Fork the ze binary to run the compiled-in plugin over TLS connect-back.";
                    }
                }
                default "in-daemon";
                description "Execution mode for a compiled-in plugin (valid with internal only).
                    in-daemon runs the plugin as a goroutine of the ze daemon with no fork. separate
                    forks the running ze binary for that plugin over TLS connect-back while keeping the
                    same registration identity and grants. Refused for plugins that declare
                    RunsInProcessOnly.";
                ze:help "Process execution mode for an internal endpoint (in-daemon or separate).";
            }

            container external {
                presence "Run an external program not shipped by Ze.";
                description "Runs an external program not shipped by Ze as a separate subprocess. Its
                    identity is the endpoint name alone, and it inherits no grants from any compiled-in
                    plugin of the same name. Mutually exclusive with internal.";
                ze:help "External program process settings.";

                leaf run {
                    type string;
                    description "Command line that starts the external program. The engine runs it with
                        '/bin/sh -c', so arguments, quoting and PATH lookup work as in a shell. The
                        directory of the running ze binary is added to PATH as a fallback. The child
                        reads ZE_PLUGIN_HUB_HOST, ZE_PLUGIN_HUB_PORT, ZE_PLUGIN_HUB_TOKEN,
                        ZE_PLUGIN_CA_PEM and ZE_PLUGIN_NAME from its environment and connects back
                        over TLS.";
                    ze:help "Shell command line to launch the external program.";
                }

                leaf respawn {
                    type boolean;
                    description "Controls whether Ze restarts this external program when its process
                        exits. When absent, the program's own Stage 1 declaration decides. Setting false
                        leaves the endpoint stopped on exit even when the program declared respawnable.
                        Setting true against a program that declared non-respawnable is refused at start.
                        Restarts are bounded at 5 in 60 seconds and 20 in the life of the daemon.";
                    ze:help "Restart the external program when it exits.";
                }

                leaf timeout {
                    type string;
                    description "Bounds a stall in the startup handshake across endpoints starting
                        together in one tier. Write a duration with a unit, such as 10s or 1m; a value
                        with no unit or a negative value is refused. When absent, Ze uses the
                        ze.plugin.stage.timeout environment variable (default 5s).";
                    ze:help "Startup handshake stall timeout (e.g., 10s, 1m).";
                }

                leaf on-exit {
                    type enumeration {
                        enum withdraw {
                            ze:help "Withdraw routes originated by this endpoint when its process exits (default).";
                        }
                        enum keep {
                            ze:help "Keep routes originated by this endpoint after its process exits (ExaBGP compatibility).";
                        }
                    }
                    default "withdraw";
                    description "Controls what happens to routes originated by this external endpoint
                        when its process disappears. withdraw (the default) withdraws every route the
                        endpoint originated. keep leaves its originated routes in place after exit and
                        exists solely for ExaBGP compatibility.";
                    ze:help "Disposition of routes originated by this endpoint when it exits (withdraw or keep).";
                }
            }

            leaf encoding {
                type enumeration {
                    enum json {
                        ze:help "JSON event encoding (default).";
                    }
                    enum text {
                        ze:help "Human-readable text event encoding.";
                    }
                }
                default "json";
                description "Wire encoding of events delivered to this endpoint: json for JSON objects
                    or text for line-oriented text.";
                ze:help "Wire encoding format for events delivered to this endpoint (json or text).";
            }

            leaf delivery-queue-max {
                type uint32 {
                    range "64..1048576";
                }
                description "Upper bound on the bounded lossless FIFO event delivery queue for this
                    endpoint. When unset, ordinary endpoints default to 65536 events and cache-consumer
                    forwarding plugins (such as bgp-rs and bgp-rr) default to 256 events. Events are
                    never dropped; producers wait when the queue reaches this ceiling. Allowed range
                    is 64..1048576.";
                ze:help "Maximum queued events before lossless delivery backpressure (64..1048576).";
            }

            uses participant-bus;
        }

        list participant {
            key "path";
            description "Applies bus delivery and filtering rules centrally to any participant or bus
                subtree identified by its short-form path (for example '/bus/endpoint/collector').
                Compiles with any bus block written directly on the participant into one filter;
                disagreeing content for the same field is refused at commit naming both lines, while
                identical content is accepted.";
            ze:help "Central bus delivery and filtering rules for a participant path.";

            leaf path {
                type string;
                ze:validate "bus-participant-path";
                description "Short-form participant path naming a configured participant or bus subtree.";
                ze:help "Short-form participant path.";
            }

            uses participant-bus;
        }

        container hub {
            description "Sets the TLS listener that plugin processes connect back to, and the outbound connection this
                daemon makes to a remote hub for its config. With no server block the daemon opens one on 127.0.0.1,
                with a kernel-chosen port and a random secret. Each plugin process reads that address and a per-plugin
                token from its environment. Declare a server block when a process the daemon did not start must
                connect, such as the plugin CLI or a remote managed client. Declare a client block when this daemon
                takes its config from a remote hub.";
            ze:help "Plugin transport and auth configuration";

            list server {
                key "name";
                ze:listener;
                description "Each block is one TLS listener. The plugin acceptor binds the first block in configuration
                    order and no other, so a second block exists for the managed clients it names. Every block that
                    carries client entries also starts the managed config server, which needs blob-backed config
                    storage. Give such a block a port of its own. A block whose address the plugin acceptor already
                    binds fails to listen, and 'ze doctor' reports that collision. Set ip and port to the listen
                    address, and secret to the token a connection presents.";
                ze:help "Named hub server instances (TLS listeners)";

                leaf name {
                    type string { length "1..64"; }
                    description "Names the block in log lines and in the 'ze doctor' collision message. It selects nothing
                        at runtime, because the plugin acceptor takes the first block in configuration order whatever
                        it is called. Common names are 'local' for the loopback listener that plugin processes use,
                        and 'central' for the listener remote managed clients dial.";
                    ze:help "Server block name (e.g., local, central)";
                }

                uses zt:listener;

                leaf secret {
                    type string;
                    ze:sensitive;
                    description "The token this listener accepts from a connection whose name matches no plugin this
                        daemon started and no client entry in this block. A plugin the daemon starts receives a random
                        per-name token in its environment instead, so no operator copies this value into a plugin. It
                        holds at least 32 characters and the config is refused below that length. With no server block
                        the daemon generates a random secret at each start, which no process outside it can know. The
                        CLI masks the value on display, and the committed config file holds it in the clear.";
                    ze:help "Auth token for plugin connections (min 32 chars)";
                }

                leaf certificate {
                    ze:reference "pki-certificate";
                    type string { length "1..64"; }
                    description "Name of a pki certificate the managed-client listener on this block serves. An empty name serves a
                        certificate this daemon's own certificate authority issues, and reissues as it ages. Export that
                        authority root with 'show pki local-ca pem' and name it in each client's pki ca block, so a client
                        validates the chain rather than one certificate.";
                    ze:help "Name of the pki certificate the managed-client listener on this block serves.";
                }

                list client {
                    key "name";
                    description "Each entry names a managed client this hub accepts, and the token that client presents.
                        One entry turns the block into a managed config listener. That listener answers a config
                        fetch. It pushes a change notice when the client's stored config is written. The config it
                        serves is the stored file 'client-<name>.conf', so the entry name is what routes a config to a
                        client. Every server block that carries client entries serves one certificate, and a config
                        that names two different ones is refused.";
                    ze:help "Accepted remote managed clients";

                    leaf name {
                        type string { length "1..64"; }
                        description "The identity the remote client sends at authentication, and the name of the config
                            this hub serves it. It matches the name of the client block on the remote daemon, and it
                            selects the stored file 'client-<name>.conf'. The token in the secret leaf is checked
                            against this name, so each client authenticates with its own token.";
                        ze:help "Client identity name";
                    }

                    leaf secret {
                        type string;
                        ze:sensitive;
                        description "The token this named client presents at authentication. It holds at least 32
                            characters, and the config is refused below that length with the client name in the error.
                            An entry with no secret is refused as well. Write the same value in the secret leaf of the
                            client block on the remote daemon. This per-client token is checked before the block
                            secret. The CLI masks the value on display, and the committed config file holds it in the
                            clear.";
                        ze:help "Per-client auth token (min 32 chars)";
                    }

                    list label {
                        key "key";
                        max-elements 32;
                        description "Operator labels for this managed device. Give the device the same
                            labels on every server block that declares it.";
                        ze:help "Labels assigned to the device";

                        leaf key {
                            type string {
                                length "1..63";
                                pattern '[a-z][a-z0-9-]*';
                            }
                            description "Start with a lowercase letter. Subsequent characters can be
                                lowercase letters, digits or hyphens.";
                            ze:help "Label key, for example site";
                        }

                        leaf value {
                            type string { length "1..128"; }
                            mandatory true;
                            description "A value of 1 to 128 printable characters.";
                            ze:help "Value of this label";
                        }
                    }
                }
            }

            list client {
                key "name";
                description "Each block is an outbound connection to the hub that holds this daemon's config. The daemon
                    dials the first block only, and never dials a second block. The client validates the hub
                    certificate, sends its name and secret, then fetches its config and commits it. A heartbeat every
                    30 seconds holds the connection open. It reconnects with a delay that grows from 1 second to 60
                    seconds, and it stops when this instance is no longer marked as managed. The daemon dials nothing
                    here unless it runs as a managed instance with blob-backed config storage.";
                ze:help "Outbound hub connections (managed client mode)";

                leaf name {
                    type string { length "1..64"; }
                    description "The identity this daemon sends to the hub. The hub matches it against a client entry
                        under its own server block, and serves the config stored for that name. This name and the name
                        of that client entry MUST be the same string. The secret leaf on both sides MUST hold the same
                        token.";
                    ze:help "Client identity name";
                }

                leaf host {
                    type string;
                    description "The address of the remote hub, as an IP address or a hostname. It joins the port leaf
                        into the dial address, and it also sets the TLS server name the client verifies. The value
                        MUST therefore appear in the hub certificate. A certificate that names a different host is
                        refused, and the client sends its secret to no such hub.";
                    ze:help "Remote hub address";
                }

                leaf port {
                    type uint16;
                    description "The TCP port of the remote hub. It MUST equal the port of the hub server block that
                        carries this client's entry. There is no default: a block with no port dials port 0, and no
                        hub listens there.";
                    ze:help "Remote hub port";
                }

                leaf secret {
                    type string;
                    ze:sensitive;
                    description "The token this daemon sends to the hub at authentication. It holds at least 32 characters
                        and the config is refused below that length. It MUST equal the secret of the matching client
                        entry in the hub's server block, so rotate both sides in one change. The CLI masks the value
                        on display, and the committed config file holds it in the clear.";
                    ze:help "Auth token (min 32 chars)";
                }

                leaf source-address {
                    type zt:ip-address;
                    description "Binds the outbound hub connection to this local IP address. Set it when the route to the
                        hub leaves an interface whose address the hub does not expect. One example is a hub that
                        accepts one management address only. The address MUST exist on this host, because the
                        connection fails when the kernel cannot bind it. With no value the kernel picks the source
                        address of the outgoing route. 'ze doctor' probes the hub through the same source address, so
                        its verdict matches what the daemon does.";
                    ze:help "Source IP address for outbound hub connections.";
                }

                leaf ca {
                    ze:reference "pki-ca";
                    type string {
                        length "1..255";
                        pattern '[A-Za-z0-9._-]+';
                    }
                    description "Name of a pki ca entry holding the certificate authority root of the hub this client connects to.
                        The client validates the hub certificate chain against that root and refuses any other chain, so it
                        sends no token to a hub it did not authenticate. Export the root from the hub and paste it into a
                        pki ca block on this client. A leaf the hub reissues still validates, because the root is the anchor
                        and not the certificate.";
                    ze:help "Name of the pki ca entry holding the hub certificate authority root.";
                }
            }

            container history {
                description "Configures periodic device metric sampling and the bounded hub-side metric history store.
                    The hub advertises the configured interval to managed clients on each successful config fetch.
                    Setting interval to 0 disables sample collection while leaving configuration sync intact.";
                ze:help "Managed device sample interval, retention, and storage budgets.";

                leaf interval {
                    type uint32 {
                        range "0..3600";
                    }
                    default 60;
                    units "seconds";
                    description "Interval in seconds between periodic metric sample reports advertised to connected
                        managed clients. Setting 0 disables metric sampling. Allowed range is 0..3600.";
                    ze:help "Sample report interval in seconds (0 disables sampling).";
                }

                leaf retention-days {
                    type uint8 {
                        range "1..7";
                    }
                    default 7;
                    units "days";
                    description "Maximum number of days the hub retains coarse metric history per managed device
                        before expiring older buckets. Allowed range is 1..7.";
                    ze:help "Maximum metric history retention in days (1..7).";
                }

                leaf device-budget-bytes {
                    type uint64 {
                        range "4096..max";
                    }
                    default 1048576;
                    units "bytes";
                    description "Hard persisted byte cap for one managed device's metric history, including indices,
                        the retained latest observation, and write headroom. Older buckets are evicted first when
                        this budget is reached.";
                    ze:help "Maximum persisted history bytes per managed device.";
                }

                leaf hub-budget-bytes {
                    type uint64 {
                        range "4096..max";
                    }
                    default 2147483648;
                    units "bytes";
                    description "Hard persisted byte cap across all managed devices on the hub. Must reserve at least
                        4096 bytes per declared managed device for latest observations and metadata.";
                    ze:help "Maximum total persisted history bytes across the hub.";
                }
            }
        }
    }
}
