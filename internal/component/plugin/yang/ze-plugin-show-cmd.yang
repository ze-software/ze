module ze-plugin-show-cmd {
    namespace "urn:ze:plugin:show";
    prefix plugshow;
    import ze-extensions { prefix ze; }
    description "show plugin list command tree. Owned by internal/component/plugin because the handler reads the internal plugin registry. See ai/rules/plugins.md. The name ends in -cmd because that suffix is how a command tree is found: BuildCommandTree (internal/component/config/yang/command.go) merges only the modules whose name carries it, so a module outside that set puts no node in the CLI tree and no row in the command contract. It is ze-plugin-show-cmd rather than ze-plugin-cmd because internal/core/ipc/yang already declares a module of that name, for the plugin help, command and session trees. Two modules with one name is a collision a loader can accept quietly rather than refuse, which leaves nobody able to say which module a node came from.";
    revision 2026-09-08 { description "Spell the enumerating action list: the command is show plugin list. The module name gains the -cmd suffix the command-tree loader discovers, which the show plugins spelling never had."; }
    revision 2026-08-31 { description "Carry the setup outcome each plugin recorded from its own init() on the show plugin list rows."; }
    revision 2026-08-30 { description "Declare the command that replaces the root plugin-listing flag."; }

    container show {
        config false;
        description "Read-only commands to inspect system, protocol, and network state.";

        container plugin {
            config false;
            description "Plugin inspection.";
            ze:help "It reports the plugins this binary carries. It reads a registry the
process filled before main(), so it answers with no daemon running.";

            container list {
                config false;
                ze:command "ze-show:plugin-list";
                description "List the plugins compiled into this binary.";
                ze:help "Each row carries the plugin name, what it does, the address
families it handles, the RFCs it implements, the BGP capability codes it owns,
the setup outcome its own init() recorded (succeeded, soft-failure,
hard-failure or unknown) and the reason the plugin gave. A plugin that
recorded nothing is listed as unknown, never omitted, and a plugin that
recorded and then did not register keeps its row.
The outcome replays a past event: it was recorded once, before main(),
and this command reads it back. 'show health' answers the other question,
by running a probe now and reporting what the daemon is doing at this
moment.";
            }
        }
    }
}
