module ze-policy-conf {
    namespace "urn:ze:policy:conf";
    prefix policy;

    import ze-extensions { prefix ze; }

    description
        "The top-level policy root shared by Ze's route policy and policy
         routing. Each route policy filter type adds its list here through an
         augment and marks it ze:filter; policy routing adds its route list.";

    revision 2026-10-30 {
        description "Initial revision: the policy root moves out of bgp.";
    }

    grouping rib-import-filter {
        description "The import chain a route source, or the rib root for every source, applies at the
                     Loc-RIB. Declared once here and used by isis, ospf, static, connected and rib.";
        container filter {
            description "A name references a filter instance defined under the top-level policy root. The
                         chain judges routes as they enter the Loc-RIB; a protocol's own database (an IS-IS
                         LSDB, an OSPF LSDB) is never filtered.";
            ze:help "Route filter chains into the Loc-RIB.";
            container import {
                presence "Configure the import policy into the Loc-RIB.";
                description "A rejected route stays in the Loc-RIB as a hidden path that is never selected,
                             so relaxing the chain re-admits it without the protocol sending it again. The
                             source's chain runs first, then the rib chain.";
                ze:help "Import policy into the Loc-RIB";
                leaf-list filters {
                    type string { length "1..max"; }
                    ordered-by user;
                    description "Run these filter instances in order. Each one passes the route on or
                                 rejects it; a filter type with no Loc-RIB route evaluator is refused.";
                    ze:help "Ordered filter instance references";
                }
                leaf final {
                    type enumeration {
                        enum accept { ze:help "Accept a route that passes every filter"; }
                        enum reject { ze:help "Reject a route that passes every filter"; }
                    }
                    mandatory true;
                    description "Every present import policy must set final accept or final reject, even with no filters.";
                    ze:help "Decision after every filter passes";
                }
            }
        }
    }

    container policy {
        description "Each filter type is a list that its plugin adds through an augment and marks
                     ze:filter. An entry of such a list is a named filter instance, and an import or
                     export chain references it by name. One name belongs to one filter type only.
                     Policy routing adds its route list here too; a route entry is never a filter.";
        ze:help "Route policy filters and policy routing.";
    }
}
