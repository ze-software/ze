module ze-lg-conf {
    namespace "urn:ze:lg:conf";
    prefix lg;

    import ze-types { prefix zt; }
    import ze-extensions { prefix ze; }

    description "Looking glass configuration for Ze";

    revision 2026-01-01 {
        description "Initial revision";
    }

    container environment {
        description "Environment settings for looking glass";

        container looking-glass {
            description "Looking glass HTTP server settings";

            leaf enabled {
                type boolean;
                default false;
                description "Enable looking glass";
            }

            list server {
                key "name";
                ze:listener;
                description "Looking glass listen endpoints";

                leaf name {
                    type string;
                    description "Server instance name";
                }

                uses zt:listener {
                    refine ip {
                        default "0.0.0.0";
                    }
                    refine port {
                        default 8443;
                    }
                }
            }

            leaf tls {
                type boolean;
                default true;
                description "Enable TLS (requires blob storage for certificates).
                             Default true: the looking glass binds 0.0.0.0 and
                             publishes route data. Set false to serve plaintext,
                             for example behind a TLS-terminating proxy.
                             Override with the ze.looking-glass.tls variable.";
            }

            leaf token {
                type string;
                ze:sensitive;
                description "Bearer token that gates every /api/ and /lg/ route.
                             Compared constant-time (sha256 +
                             subtle.ConstantTimeCompare). Empty leaves the
                             looking glass open, which is the default: a looking
                             glass is a public read-only surface. Override with
                             the ze.looking-glass.token variable.";
            }
        }
    }
}
