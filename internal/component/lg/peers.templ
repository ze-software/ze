// Design: docs/architecture/web-interface.md -- looking glass peer dashboard

package lg

import "strconv"

//ze:page
// peersPage is the BGP peer dashboard.
templ peersPage(v peersView) {
	<h1>BGP Peers</h1>
	@errorBanner(v.Error)
	@peersContent(v)
	if len(v.BMPPeers) > 0 {
		<h2>BMP Monitored Peers</h2>
		@bmpPeersContent(v.BMPPeers)
	}
	@peerDetailArea()
}

// peersContent is the peer table. Its body is swapped by server-sent events.
// The header is peersColumns (view.go), one entry per cell of a row.
//
// The stream sends UNNAMED messages: htmx 4 swaps one of those into the
// element carrying hx-sse:connect and only dispatches a named event, which
// nothing here listens for. `swapEmpty:true` keeps the empty message
// meaningful, because the extension makes an unnamed message swapEmpty:false
// unless the element says otherwise, and zero peers is a state the browser
// must be told about.
templ peersContent(v peersView) {
	<table class="peers-table">
		<thead>
			<tr>
				for _, column := range peersColumns {
					<th>{ column }</th>
				}
			</tr>
		</thead>
		<tbody hx-sse:connect="/lg/events" hx-swap="innerHTML swapEmpty:true">@peersTableBody(v.Peers)</tbody>
	</table>
}

// peersTableBody is the row set handleUIEvents pushes over SSE.
//
// The two session history cells carry a class, state-changed and
// connections-dropped, which is how a reader tells the drop count from the
// other numbers of the row. Each is empty when the engine sent no value: an
// absent drop count is never shown as a zero. The last error has no column,
// because its text is long: the peer header a row opens shows it
// (peerRoutesContent).
//
// The remote AS cell shows the number alone. The AS name, when the resolve
// command gives one (as_names.go), is the cell's title, shown on mouse-over;
// an AS with no name has no title, never an empty one.
templ peersTableBody(rows []peerRow) {
	for _, p := range rows {
		<tr class={ stateClass(p.State) } hx-get={ "/lg/peer/" + p.Address } hx-target="#peer-detail" hx-swap="innerHTML" hx-sync="#peer-detail:replace" hx-indicator="#peer-detail">
			<td>{ p.Address }</td>
			<td
				if p.RemoteASName != "" {
					title={ p.RemoteASName }
				}
			>{ p.RemoteAS }</td>
			<td class="state">{ p.State }</td>
			<td>{ formatUptime(p.Uptime) }</td>
			<td class="state-changed">{ p.StateChanged }</td>
			<td class="connections-dropped">{ p.ConnectionsDropped.Text() }</td>
			<td>{ formatNum(p.RoutesReceived) }</td>
			<td>{ formatNum(p.RoutesAccepted) }</td>
			<td>{ formatNum(p.RoutesSent) }</td>
			<td>{ formatNum(p.UpdatesReceived) }</td>
			<td>{ formatNum(p.UpdatesSent) }</td>
			<td
				class="peer-description"
				if p.Group != "" {
					title={ "Group " + p.Group }
				}
			>{ p.Description }</td>
		</tr>
	}
}

// peersStreamError is the body the event stream sends when the engine cannot
// answer. The stream carries one kind of message, so the reason travels inside
// the table body rather than in a second event: the operator reads it where the
// rows would be, and the next good tick replaces it with rows again. The cell
// spans every column of peersColumns, so it follows the table when a column is
// added.
templ peersStreamError(message string) {
	<tr class="stream-error">
		<td colspan={ strconv.Itoa(len(peersColumns)) }>{ message }</td>
	</tr>
}

// bmpPeersContent is the BMP monitored-peer table. Its remote AS cell is
// written as peersTableBody writes one: the number, with the AS name as title.
templ bmpPeersContent(rows []bmpPeerRow) {
	<table class="peers-table bmp-peers-table">
		<thead>
			<tr>
				<th>Router</th><th>Peer BGP ID</th><th>Remote AS</th><th>State</th><th>Family</th>
			</tr>
		</thead>
		<tbody>
			for _, p := range rows {
				<tr class={ bmpStateClass(p.State) }>
					<td>{ p.Router }</td>
					<td>{ p.BGPID }</td>
					<td
						if p.PeerASName != "" {
							title={ p.PeerASName }
						}
					>{ p.PeerAS }</td>
					<td class="state">{ p.State }</td>
					<td>
						if p.IPv6 {
							IPv6
						} else {
							IPv4
						}
					</td>
				</tr>
			}
		</tbody>
	</table>
}

// peerDetailArea is the empty target a peer row swaps its routes into.
templ peerDetailArea() {
	<div id="peer-detail" class="peer-detail-area"></div>
}
