module ze-firewall-irr-cmd {
    namespace "urn:ze:firewall-irr:cmd";
    prefix fwirrcmd;
    import ze-extensions { prefix ze; }
    description "show firewall irr ... command tree.
                 Owned by the firewall-irr plugin so that removing the plugin
                 directory removes these command nodes together with the handlers
                 and config schema. See ai/rules/plugin-self-containment.md.
                 Fetching and removing a stored list are the irr plugin's
                 update irr and clear irr.";
    revision 2026-06-17 { description "Initial revision."; }
    revision 2026-08-18 { description "Add clear firewall irr asn/as-set: the deliberate way to drop cached prefixes, now that a refresh which learns nothing keeps them."; }
    revision 2026-11-15 { description "Remove update firewall irr and clear firewall irr: the irr plugin fetches and stores every list, through update irr and clear irr."; }

    container show {
        config false;
        ze:help "Read-only commands to inspect system, protocol, and network state.";

        container firewall {
            config false;
            // Repeat the canonical description owned by ze-firewall-cmd.yang
            // verbatim so the command-tree merge does not warn on a mismatch.
            // This module only attaches the `irr` subtree to the shared node.
            description "Ze programs nftables, so what is reported is the state Ze installed. A rule added
                         outside Ze is not managed here and is not shown.";
            ze:help "Firewall rules and groups (nftables).";

            container irr {
                config false;
                ze:command "ze-firewall:show-irr-status";
                description "Lists each configured reference with the stored
copy the firewall enforces for it: its status, prefix counts, server,
generation, check and refresh times. Use this to confirm that IRR prefix-lists
are stored and current before committing firewall config.";
                ze:help "Show the IRR lists the firewall enforces.";

                container prefix {
                    config false;
                    ze:command "ze-firewall:show-irr-prefix";
                    description "Lists all IPv4 and IPv6 prefixes the firewall
enforces for the given ASN or AS-SET.";
                    ze:help "Show the prefixes the firewall enforces for a reference.";
                    leaf name {
                        type string;
                        mandatory true;
                        description "The reference as the firewall config names it: an ASN
in the form AS64500, or an AS-SET name. A name no rule references, or one with
nothing stored, is an error.";
                        ze:help "ASN or AS-SET name";
                    }
                }
            }
        }
    }
}
