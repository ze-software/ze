module ze-firewall-irr {
    namespace "urn:ze:firewall-irr";
    prefix fwirr;

    import ze-extensions { prefix ze; }
    import ze-types { prefix zt; }
    import ze-firewall-conf { prefix fw; }

    description "IRR-based source/destination address filtering for the firewall.
                 Reads the prefix lists the irr plugin stored for ASN or AS-SET
                 references and populates nftables interval sets. Augments the
                 firewall from-block with source-asn, source-as-set, destination-asn,
                 and destination-as-set leaves, and adds a firewall irr container
                 for interface bindings. Its server, refresh-interval and
                 peeringdb-url leaves are no longer read: system irr holds them.";

    revision 2026-06-17 {
        description "Initial revision";
    }

    augment "/fw:firewall" {
        container irr {
            description "The irr plugin fetches, schedules and stores every IRR list the firewall
                         enforces, from the server and at the interval system irr names; the
                         BGP IRR filter enforces the same stored copy, so one query serves
                         both. A commit that names a reference with nothing stored is refused
                         with the update irr command that fetches it. The server,
                         peeringdb-url and refresh-interval leaves below are no longer read.";
            ze:help "IRR policy settings for firewall prefix-list resolution.";

            leaf server {
                type string;
                default "whois.radb.net";
                description "The default is whois.radb.net. Ze adds port 43 when the value names
                             no port, so a host:port value reaches the port you name. One query
                             waits 10 seconds at most, and Ze holds each answer for one hour.";
                ze:help "IRR whois server hostname or host:port.";
            }

            leaf peeringdb-url {
                type string {
                    pattern 'https?://.*';
                }
                default "https://www.peeringdb.com";
                description "The default is https://www.peeringdb.com. Ze adds /api/net?asn=<N>
                             to this value for each query, and holds each answer for one hour.
                             Ze skips TLS verification for the host 127.0.0.1 alone, which is
                             what makes a local test server work.";
                ze:help "Base URL for PeeringDB API queries.
                         Override for testing with a mock server.";
            }

            leaf refresh-interval {
                type uint32 {
                    range "0 | 60..86400";
                }
                default "0";
                units "seconds";
                description "No longer read: the irr plugin refreshes every stored list at
                             system irr refresh-interval, and 'update irr' fetches one by
                             hand.";
                ze:help "Seconds between automatic IRR re-queries.";
            }

            list interface {
                key "name";
                description "Ze drops a packet that arrives on this interface when its
                             source address is not in the IRR-resolved prefixes of the
                             AS-SET.";
                ze:help "Per-interface AS-SET binding for ingress source validation.";

                leaf name {
                    type string {
                        length "1..15";
                        pattern '[a-zA-Z0-9._-]+';
                    }
                    description "Ze matches the input interface by this name in the nftables
                                 rule, so a name no interface carries filters nothing. The
                                 15-character limit is the kernel limit on an interface name. A
                                 binding whose AS-SET resolved to no prefix produces no rule at
                                 all, and Ze logs a warning that names the interface.";
                    ze:help "Interface name (e.g. eth1, bond0.100).
                             Must match the kernel interface name exactly.";
                }

                leaf source-as-set {
                    type string {
                        length "1..255";
                        pattern '[A-Za-z0-9:._-]+';
                    }
                    mandatory true;
                    description "The prefixes the IRR resolves for this AS-SET form the
                                 allowed source-address set of the interface. The match
                                 needs a stored prefix list. A config commit is refused
                                 when nothing is stored.";
                    ze:help "AS-SET whose IRR-resolved prefixes are the allowed source addresses.";
                }
            }
        }
    }

    augment "/fw:firewall/fw:table/fw:chain/fw:term/fw:from" {
        leaf source-asn {
            type zt:asn {
                range "1..4294967294";
            }
            description "The match needs a prefix list the irr plugin stored, so run
                         'update irr asn <N>' first. A config commit is refused when
                         nothing is stored.";
            ze:help "Match the source address against the IRR-resolved prefixes of this ASN.";
        }

        leaf source-as-set {
            type string {
                length "1..255";
                pattern '[A-Za-z0-9:._-]+';
            }
            description "The match needs a prefix list the irr plugin stored, so run
                         'update irr as-set <name>' first. A config commit is refused
                         when nothing is stored.";
            ze:help "Match the source address against the IRR-resolved prefixes of this AS-SET.";
        }

        leaf destination-asn {
            type zt:asn {
                range "1..4294967294";
            }
            description "The stored-list rule is the one source-asn states. The match
                         needs a prefix list the irr plugin stored, so run 'update irr
                         asn <N>' first. A config commit is refused when nothing is
                         stored.";
            ze:help "Match the destination address against the IRR-resolved prefixes of this ASN.";
        }

        leaf destination-as-set {
            type string {
                length "1..255";
                pattern '[A-Za-z0-9:._-]+';
            }
            description "The stored-list rule is the one source-as-set states. The
                         match needs a prefix list the irr plugin stored, so run
                         'update irr as-set <name>' first. A config commit is refused
                         when nothing is stored.";
            ze:help "Match the destination address against the IRR-resolved prefixes of this AS-SET.";

        }
    }
}
