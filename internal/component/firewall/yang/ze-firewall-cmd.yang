module ze-firewall-cmd {
    namespace "urn:ze:firewall:cmd";
    prefix firewallcmd;
    import ze-extensions { prefix ze; }
    description "Firewall show commands: ruleset inspection and address/port group listing.
         Relocated from the central show schema for plugin self-containment.";
    revision 2026-11-27 { description "Add read-only show firewall trace decision-trace command."; }
    revision 2026-08-29 { description "Declare the value the description spelled in prose, so the model states the grammar and the generated usage line reads it."; }
    revision 2026-06-03 { description "Initial revision: relocated from ze-cli-show-cmd."; }
    revision 2026-06-06 { description "Standalone containers instead of augment (avoids duplicate system container)."; }

    container show {
        config false;
        ze:help "Read-only commands to inspect system, protocol, and network state.";

        container firewall {
            config false;
            description "Ze programs nftables, so what is reported is the state Ze installed. A rule added
                         outside Ze is not managed here and is not shown.";
            ze:help "Firewall rules and groups (nftables).";
            container ruleset {
                config false;
                ze:command "ze-firewall:show-ruleset";
                ze:backend "kernel";
                description "Joins applied desired state with kernel counters from
the kernel backend.";
                ze:help "Show the live firewall ruleset with per-term counters.";
                leaf name {
                    type string { length "1..64"; }
                    mandatory true;
                    description "The table name as the configuration spells it, without the
ze prefix the backend adds. A name no applied table carries is an error that lists the
tables applied.";
                    ze:help "Firewall table name";
                }
            }
            container group {
                config false;
                ze:command "ze-firewall:show-group";
                ze:backend "kernel";
                description "Without arguments, lists all known groups. With a name,
shows the set elements. Reads from the last applied config, not the
kernel.";
                ze:help "Show members of a firewall address/port group.";
            }
            container trace {
                config false;
                ze:command "ze-firewall:show-trace";
                description "Evaluates a synthetic packet against the last applied
firewall tables without sending traffic or mutating dataplane state. Works across
all firewall backends and returns per-term match steps, actions, and final verdict.";
                ze:help "Trace a synthetic packet through applied firewall rules.";
                leaf table {
                    type string { length "1..64"; }
                    mandatory true;
                    description "Bare name of the applied firewall table to trace,
without the ze_ backend prefix.";
                    ze:help "Applied firewall table name.";
                }
                leaf chain {
                    type string { length "1..64"; }
                    description "Optional entry chain name within the table. Defaults
to the lowest-priority base chain when omitted.";
                    ze:help "Entry chain name to start evaluation.";
                }
                leaf protocol {
                    type enumeration {
                        enum tcp { ze:help "Match TCP packets."; }
                        enum udp { ze:help "Match UDP packets."; }
                        enum icmp { ze:help "Match ICMPv4 packets."; }
                        enum icmpv6 { ze:help "Match ICMPv6 packets."; }
                    }
                    description "L4 protocol of the synthetic packet.";
                    ze:help "Packet L4 protocol.";
                }
                leaf source-address {
                    type string;
                    description "Source IPv4 or IPv6 host address of the synthetic packet.";
                    ze:help "Packet source IP address.";
                }
                leaf destination-address {
                    type string;
                    description "Destination IPv4 or IPv6 host address of the synthetic packet.";
                    ze:help "Packet destination IP address.";
                }
                leaf source-port {
                    type uint16 { range "1..65535"; }
                    description "Source transport port of the synthetic packet.";
                    ze:help "Packet source transport port.";
                }
                leaf destination-port {
                    type uint16 { range "1..65535"; }
                    description "Destination transport port of the synthetic packet.";
                    ze:help "Packet destination transport port.";
                }
                leaf input-interface {
                    type string;
                    description "Input interface name of the synthetic packet.";
                    ze:help "Packet input interface name.";
                }
                leaf output-interface {
                    type string;
                    description "Output interface name of the synthetic packet.";
                    ze:help "Packet output interface name.";
                }
                leaf connection-state {
                    type enumeration {
                        enum new { ze:help "New connection."; }
                        enum established { ze:help "Established connection."; }
                        enum related { ze:help "Related connection."; }
                        enum invalid { ze:help "Invalid connection state."; }
                    }
                    description "Connection tracking state of the synthetic packet.";
                    ze:help "Packet connection tracking state.";
                }
            }
        }

        container system {
            config false;
            container conntrack {
                config false;
                ze:command "ze-firewall:show-system-conntrack";
                ze:backend "kernel";
                description "Returns conntrack entry count, table size, timeouts,
and loaded modules. Requires the kernel backend. Check this when you suspect
conntrack table exhaustion is dropping traffic.";
                ze:help "Show the kernel connection tracking table.";
            }
        }
    }
}
