module ze-bfd-api {
    namespace "urn:ze:bfd:api";
    prefix bfdapi;

    import ze-extensions { prefix ze; }

    description
        "BFD API operations for Ze. RPCs for observing session state
         and resolved profiles. RFC 5880 sections 6.8.1 (state
         variables) and 6.8.4 (detection time) supply the field
         semantics.";

    revision 2026-04-11 {
        description "Initial BFD observability API (spec-bfd-4).";
    }

    rpc show-sessions {
        description "Return every live BFD session.";
        ze:help "Each row carries the peer, the state and the diagnostic code. It also
carries the two discriminators, the transmit, receive and detection intervals, the packet
counters and the recent state changes. The command fails with bfd: plugin not loaded when
BFD is not running.";
        output {
            leaf sessions {
                type string;
                description "JSON array of session objects.";
            }
        }
    }

    rpc show-session {
        description "Return one BFD session by peer address.";
        ze:help "The peer must be an IP address, and a value that does not parse is refused
before the lookup. A peer with no session is reported as no session for that peer.";
        input {
            leaf peer {
                type string;
                mandatory true;
                description "Peer IPv4 or IPv6 address.";
            }
        }
        output {
            leaf session {
                type string;
                description "JSON object with session detail.";
            }
        }
    }

    rpc show-profile {
        description "Return resolved BFD profile parameters.";
        ze:help "Without a name every profile is answered. Each one carries the detect
multiplier, the desired transmit interval and the required receive interval in microseconds,
and whether the profile is passive.";
        input {
            leaf name {
                type string;
                description "Profile name (empty returns every profile).";
            }
        }
        output {
            leaf profiles {
                type string;
                description "JSON array of profile objects.";
            }
        }
    }
}
