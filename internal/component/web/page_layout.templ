package web

// pageLayout is the Finder and CLI page chrome.
templ pageLayout(v LayoutData) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8">
			<meta name="viewport" content="width=device-width, initial-scale=1">
			<title>{ v.Title }</title>
			<link rel="stylesheet" href="/assets/style.css">
			<script src="/assets/cli.js"></script>
			for _, src := range pageAssets(pgPageLayout) {
				<script src={ src }></script>
			}
			<script src="/assets/sse-client.js"></script>
			<script src="/assets/notification.js"></script>
		</head>
		<body>
			<div class="layout">
				<nav class="breadcrumb-bar" id="breadcrumb">
					@breadcrumbInner(v.chrome())
				</nav>
				<main class="content-area" id="content-area">
					@templ.Raw(v.Content)
				</main>
				<aside class="notification-bar" id="notification-bar">
					@templ.Raw(v.NotificationHTML)
				</aside>
				if v.ActiveUI != uiModeTokenCLI {
					@commitBar(v)
				}
			</div>
			<div id="notification-area" class="notification-area"></div>
			@diffModal()
			@errorPanel()
		</body>
	</html>
}
