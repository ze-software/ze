// Design: docs/architecture/web-interface.md -- authorized recovery of corrupt pending changes.

package web

templ configRecovery(v configRecoveryData) {
	<section class="wb-panel" id="config-recovery">
		<h1>Recover unreadable pending changes</h1>
		<p>The pending change file for account <strong>{ v.Username }</strong> cannot be read. Normal review and discard cannot safely select its changes.</p>
		<p>This action discards the entire unreadable pending change file for this account. It can include browser, SSH and console changes, and structural instructions retained after Save draft. Individual changes cannot be selected because their ownership cannot be read.</p>
		<p>The separate saved draft file is kept, and running configuration stays unchanged. Saved draft changes can still depend on structural instructions in this unreadable pending change file; those instructions will be discarded. Other accounts' change files are kept.</p>
		<form method="post" action="/config/recover">
			<input type="hidden" name="fingerprint" value={ v.Fingerprint }>
			<label>
				<input type="checkbox" id="config-recovery-confirm" name="confirm" value="discard" required>
				I understand that all changes and structural instructions in this unreadable file will be lost.
			</label>
			<div class="diff-actions">
				<button class="commit-discard-btn" id="config-recovery-submit" type="submit">Discard unreadable pending change file</button>
				<a href="/show/" id="config-recovery-cancel">Cancel and keep changes</a>
			</div>
		</form>
	</section>
}

templ configRecoveryError() {
	<section class="wb-panel" id="config-recovery-error">
		<h1>Your pending changes cannot be opened</h1>
		<p>Your account's pending change file cannot be parsed. The file has been kept, and running configuration has not changed.</p>
		<p>An authorized operator can review the recovery action before discarding this account's unreadable pending change file.</p>
		<a href="/config/recover" id="config-recovery-link">Review pending-change recovery</a>
	</section>
}
