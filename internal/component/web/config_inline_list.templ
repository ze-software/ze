// Design: docs/architecture/web-interface.md -- web configuration component

package web

// configInlineList is the config view of a YANG inline list. It differs from
// configList in that the detail panel swaps through HTMX and the add button is
// disabled.
templ configInlineList(v *ConfigViewData) {
	<div class="config-list-layout">
		<div class="config-key-panel">
			<h3 class="config-section-title">Keys</h3>
			<ul class="config-key-list">
				for _, k := range v.Keys {
					<li>
						<a
							class={ configKeyItemClass(k == v.SelectedKey) }
							hx-get={ v.BasePath + k + "/" }
							hx-target="#detail-panel"
							hx-push-url="true"
							href={ v.BasePath + k + "/" }
						>{ k }</a>
					</li>
				}
			</ul>
			<div class="config-key-actions">
				<button class="config-btn config-btn-add" disabled title="Add (available in edit mode)">+ Add</button>
			</div>
		</div>
		<div class="config-detail-panel" id="detail-panel">
			if v.SelectedDetail != nil {
				<div class="config-container">
					if len(v.SelectedDetail.LeafFields) > 0 {
						<section class="config-section">
							<h3 class="config-section-title">Fields</h3>
							<div class="config-fields">
								for _, f := range v.SelectedDetail.LeafFields {
									@leafInput(f)
								}
							</div>
						</section>
					}
					if len(v.SelectedDetail.Children) > 0 {
						<section class="config-section">
							<h3 class="config-section-title">Children</h3>
							<ul class="config-nav-list">
								for _, c := range v.SelectedDetail.Children {
									<li>
										<a class="config-nav-link" hx-get={ c.URL } hx-target="#content-area" hx-push-url="true" href={ c.URL }>{ c.Name }</a>
									</li>
								}
							</ul>
						</section>
					}
				</div>
			} else {
				<div class="config-empty-detail">
					<p class="config-hint">Select an item from the list.</p>
				</div>
			}
		</div>
	</div>
}
