// Design: docs/architecture/web-components.md -- independent native backup forms.

package web

// pageBackupWorkspace intentionally has no live editor chrome, CLI, SSE or
// scripting. Every action carries the artifact workspace's explicit URL.
templ pageBackupWorkspace(v backupPageData) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8">
			<meta name="viewport" content="width=device-width, initial-scale=1">
			<title>Offline backup workspace — Ze</title>
			<link rel="stylesheet" href="/assets/style.css">
			<link rel="stylesheet" href="/assets/backup.css">
			for _, src := range pageAssets(pgPageBackupWorkspace) {
				<script src={ src }></script>
			}
		</head>
		<body>
			<main class="backup-page">
				<nav><a href="/show/">Return to live configuration</a> · <a href="/backups/">Upload another backup</a></nav>
				<h1>Offline backup workspace</h1>
				<p>Inspect and edit an uploaded Ze backup independently of the running configuration. Existing saved drafts stay in the backup and are not resumed here.</p>
				if v.Source != nil {
					@componentBackupSource(*v.Source)
				} else if v.Path == "" {
					<form method="POST" action="/backups/system-download" class="backup-panel">
						<h2>Back up this system</h2>
						<p>Download a complete .zefs copy of this system's store, including configuration history, saved drafts and credentials.</p>
						<p>Keep this backup private. Before opening it in the Ze CLI on Unix, restrict access to your account:</p>
						<pre><code>chmod 600 system-backup.zefs</code></pre>
						<button id="backup-system-download" type="submit">Create backup of this system</button>
					</form>
					<form method="POST" action="/backups/" enctype="multipart/form-data" class="backup-panel">
						<label for="backup-upload-file">Backup file (.zefs, at most 64 MiB)</label>
						<input id="backup-upload-file" type="file" name="backup" accept=".zefs" required>
						<button id="backup-upload-submit" type="submit">Open backup</button>
					</form>
					@componentBackupSourceUpload()
				} else {
					<p><strong>Backup:</strong> { v.Label }</p>
					<form method="GET" action={ v.Path } class="backup-panel">
						<label for="backup-config-select">Configuration</label>
						<select id="backup-config-select" name="config">
							for _, name := range v.Names {
								<option value={ name } selected?={ name == v.Selected }>{ name }</option>
							}
						</select>
						<button id="backup-config-open" type="submit">Open configuration</button>
					</form>
					if v.Error != "" {
						<pre id="backup-error" class="backup-error" role="alert">{ v.Error }</pre>
					}
					if v.Status != "" {
						<pre id="backup-status" class="backup-status" role="status">{ v.Status }</pre>
					}
					<form method="POST" action={ v.Path } class="backup-panel">
						<input type="hidden" name="config" value={ v.Selected }>
						<input type="hidden" name="base" value={ v.Base }>
						<input type="hidden" name="review" value={ v.Review }>
						<label for="backup-content">Configuration text</label>
						<textarea id="backup-content" name="content" rows="24" spellcheck="false">{ "\n" + v.Content }</textarea>
						<div class="backup-actions">
							<button id="backup-validate" name="action" value="validate" type="submit">Validate</button>
							<button id="backup-review" name="action" value="review" type="submit">Review changes</button>
							if v.CanSave {
								<button id="backup-save" name="action" value="save" type="submit">Save into backup</button>
							}
						</div>
					</form>
					if v.CanSave {
						<section class="backup-panel" aria-labelledby="backup-review-title">
							<h2 id="backup-review-title">Changes to save into this backup</h2>
							<pre id="backup-diff">{ v.Diff }</pre>
						</section>
					}
					<div class="backup-actions">
						<a id="backup-download" class="backup-download" href={ v.Path + "download" }>Download saved backup</a>
						<form method="POST" action={ v.Path }><button id="backup-close" name="action" value="close" type="submit">Close workspace</button></form>
					</div>
					<p>Download contains the last saved configuration and the backup's other keys, including credentials. Keep it in a private location. Unsaved text is not included.</p>
					<p>Before opening the downloaded backup in the Ze CLI on Unix, restrict access to your account:</p>
					<pre><code>chmod 600 updated-backup.zefs</code></pre>
				}
				if v.Source == nil {
					<p>Workspaces expire after one hour without use and are removed when the daemon stops. Download your updated backup before closing.</p>
				}
			</main>
		</body>
	</html>
}
