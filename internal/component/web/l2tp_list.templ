package web

// l2tpList is the L2TP session list page.
templ l2tpList(v l2tpListView) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8">
			<meta name="viewport" content="width=device-width, initial-scale=1">
			<title>L2TP Sessions</title>
			<link rel="stylesheet" href="/assets/style.css">
			for _, src := range pageAssets(pgL2tpList) {
				<script src={ src }></script>
			}
		</head>
		<body>
			<div class="layout">
				<nav class="breadcrumb-bar">
					<a href="/">ze</a> / <a href="/l2tp">l2tp</a>
				</nav>
				<main class="content-area">
					<h2>L2TP Sessions</h2>
					<p>Tunnels: { intText(v.TunnelCount) } | Sessions: { intText(v.SessionCount) }</p>
					if len(v.Sessions) > 0 {
						<table class="l2tp-table" id="session-table">
							<thead>
								<tr>
									<th>SID</th>
									<th>Tunnel</th>
									<th>Username</th>
									<th>Address</th>
									<th>Peer</th>
									<th>Interface</th>
									<th>State</th>
								</tr>
							</thead>
							<tbody>
								for _, s := range v.Sessions {
									<tr>
										<td><a href={ "/l2tp/" + intText(int(s.LocalSID)) }>{ intText(int(s.LocalSID)) }</a></td>
										<td>{ intText(int(s.TunnelTID)) }</td>
										<td>{ s.Username }</td>
										<td>{ s.AssignedAddr }</td>
										<td>{ s.PeerAddr }</td>
										<td>{ s.Interface }</td>
										<td>{ s.State }</td>
									</tr>
								}
							</tbody>
						</table>
					} else {
						<p>No active sessions.</p>
					}
				</main>
			</div>
		</body>
	</html>
}
