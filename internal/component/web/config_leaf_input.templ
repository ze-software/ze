// Design: docs/architecture/web-interface.md -- web configuration component

package web

// leafInput is one leaf editor inside a config view. The editor shape follows
// LeafField.InputType, which handler_config_leaf.go derives from the YANG type.
//
// This is the config VIEW's editor. The workbench detail panel has its own,
// resolved through the input registry (field_input.go) from a FieldMeta.
templ leafInput(f LeafField) {
	<div
		class={ leafFieldClass(f.Modified) }
		if f.Modified {
			data-old-value={ f.OldValue }
			title={ "Changed from: " + f.OldValue }
		}
	>
		<label class="config-label" for={ "field-" + f.Name } title={ f.ShortHelp }>{ f.Name }</label>
		// templ writes no whitespace before a switch, and the label and the
		// editor are both inline, so the space between them is an expression.
		{ " " }
		switch f.InputType {
			case "checkbox":
				<input
					type="checkbox"
					class="config-input config-checkbox"
					id={ "field-" + f.Name }
					name={ f.Name }
					if f.Value != "" {
						checked
					}
					title={ f.ShortHelp }
				>
			case leafInputSelect:
				<select
					class={ leafSelectClass(f.IsConfigured) }
					id={ "field-" + f.Name }
					name={ f.Name }
					title={ f.ShortHelp }
				>
					if f.Value == "" {
						<option value="" selected>{ enumBlankLabel(f.Default) }</option>
					}
					for _, opt := range f.Options {
						{ " " }
						<option
							value={ opt }
							if opt == f.Value {
								selected
							}
						>{ opt }</option>
					}
				</select>
			case "number":
				<input
					type="number"
					class={ leafInputClass(f.IsConfigured) }
					id={ "field-" + f.Name }
					name={ f.Name }
					value={ f.Value }
					if f.Min != "" {
						min={ f.Min }
					}
					if f.Max != "" {
						max={ f.Max }
					}
					if !f.IsConfigured && f.Default != "" {
						placeholder={ f.Default }
					}
					title={ f.ShortHelp }
				>
			default:
				<input
					type="text"
					class={ leafInputClass(f.IsConfigured) }
					id={ "field-" + f.Name }
					name={ f.Name }
					value={ f.Value }
					if f.Pattern != "" {
						pattern={ f.Pattern }
					}
					if !f.IsConfigured && f.Default != "" {
						placeholder={ f.Default }
					}
					if f.Placeholder != "" {
						placeholder={ f.Placeholder }
					}
					title={ f.ShortHelp }
				>
		}
		// The explanation is a block under the editor, never the tooltip: it is
		// a paragraph, and a title attribute shows its newlines raw. A leaf that
		// declares none renders no block, and nothing stands in for it.
		if f.Description != "" {
			<p class="config-help">{ f.Description }</p>
		}
	</div>
}
