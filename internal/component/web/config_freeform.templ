package web

// configFreeform is the config view of a freeform node: its lines, read only.
templ configFreeform(v *ConfigViewData) {
	<div class="config-freeform">
		<h3 class="config-section-title">Entries</h3>
		if len(v.Entries) > 0 {
			<ul class="config-freeform-list">
				for _, e := range v.Entries {
					<li class="config-freeform-entry">{ e }</li>
				}
			</ul>
		} else {
			<p class="config-hint">No entries configured.</p>
		}
	</div>
}
