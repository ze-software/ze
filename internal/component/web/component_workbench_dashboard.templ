// Design: docs/architecture/web-interface.md -- web interface component

package web

// workbenchDashboard is the workbench shell's dashboard. It carries no
// auto-refresh of its own and its system panel names two more values than the
// Finder's.
templ workbenchDashboard(v dashboardData) {
	<div class="wb-dashboard">
		<div class="wb-dashboard-grid">
			<div class="wb-dashboard-panel">
				<h3 class="wb-dashboard-panel-title">System</h3>
				<div class="wb-dashboard-panel-body">
					<div class="wb-dashboard-stat"><span class="wb-dashboard-stat-label">Hostname</span><span class="wb-dashboard-stat-value">{ dashText(v.System.Hostname) }</span></div>
					<div class="wb-dashboard-stat"><span class="wb-dashboard-stat-label">Uptime</span><span class="wb-dashboard-stat-value">{ v.System.Uptime }</span></div>
					<div class="wb-dashboard-stat"><span class="wb-dashboard-stat-label">Version</span><span class="wb-dashboard-stat-value">{ v.System.Version }</span></div>
					<div class="wb-dashboard-stat"><span class="wb-dashboard-stat-label">Built</span><span class="wb-dashboard-stat-value">{ v.System.BuildDate }</span></div>
					<div class="wb-dashboard-stat"><span class="wb-dashboard-stat-label">CPU Count</span><span class="wb-dashboard-stat-value">{ intText(v.System.CPUCount) }</span></div>
					if v.System.MemTotal != "" {
						<div class="wb-dashboard-stat"><span class="wb-dashboard-stat-label">Memory Available</span><span class="wb-dashboard-stat-value">{ v.System.MemTotal }</span></div>
					}
					<div class="wb-dashboard-stat"><span class="wb-dashboard-stat-label">Memory Used</span><span class="wb-dashboard-stat-value">{ v.System.MemAlloc }</span></div>
				</div>
			</div>
			<div class="wb-dashboard-panel">
				<h3 class="wb-dashboard-panel-title">BGP Summary</h3>
				<div class="wb-dashboard-panel-body">
					if v.BGP.Empty {
						<p class="wb-dashboard-empty-hint">No BGP peers configured. <a href={ v.BGP.HintURL }>Add a peer</a></p>
					} else {
						<div class="wb-dashboard-stat"><span class="wb-dashboard-stat-label">Total Peers</span><span class="wb-dashboard-stat-value">{ intText(v.BGP.Total) }</span></div>
						<div class="wb-dashboard-stat"><span class="wb-dashboard-stat-label">Established</span><span class="wb-dashboard-stat-value wb-dashboard-stat--green">{ intText(v.BGP.Established) }</span></div>
						<div class="wb-dashboard-stat"><span class="wb-dashboard-stat-label">Active</span><span class="wb-dashboard-stat-value wb-dashboard-stat--yellow">{ intText(v.BGP.Active) }</span></div>
						<div class="wb-dashboard-stat"><span class="wb-dashboard-stat-label">Idle</span><span class="wb-dashboard-stat-value">{ intText(v.BGP.Idle) }</span></div>
						<div class="wb-dashboard-stat"><span class="wb-dashboard-stat-label">Down</span><span class="wb-dashboard-stat-value wb-dashboard-stat--red">{ intText(v.BGP.Down) }</span></div>
					}
				</div>
			</div>
			<div class="wb-dashboard-panel">
				<h3 class="wb-dashboard-panel-title">Interfaces</h3>
				<div class="wb-dashboard-panel-body">
					if v.Interfaces.Empty {
						<p class="wb-dashboard-empty-hint">No interfaces configured. <a href={ v.Interfaces.HintURL }>Configure interfaces</a></p>
					} else {
						<div class="wb-dashboard-stat"><span class="wb-dashboard-stat-label">Total</span><span class="wb-dashboard-stat-value">{ intText(v.Interfaces.Total) }</span></div>
						<div class="wb-dashboard-stat"><span class="wb-dashboard-stat-label">Up</span><span class="wb-dashboard-stat-value wb-dashboard-stat--green">{ intText(v.Interfaces.Up) }</span></div>
						<div class="wb-dashboard-stat"><span class="wb-dashboard-stat-label">Down</span><span class="wb-dashboard-stat-value wb-dashboard-stat--red">{ intText(v.Interfaces.Down) }</span></div>
						<div class="wb-dashboard-stat"><span class="wb-dashboard-stat-label">Admin Down</span><span class="wb-dashboard-stat-value wb-dashboard-stat--yellow">{ intText(v.Interfaces.AdminDown) }</span></div>
					}
				</div>
			</div>
			<div class="wb-dashboard-panel">
				<h3 class="wb-dashboard-panel-title">Recent Warnings</h3>
				<div class="wb-dashboard-panel-body">
					if len(v.Warnings) > 0 {
						<ul class="wb-dashboard-event-list">
							for _, e := range v.Warnings {
								<li class="wb-dashboard-event">
									<span class="wb-dashboard-event-time">{ e.Time }</span>
									<span class="wb-dashboard-event-component">{ e.Component }</span>
									{ e.Message }
								</li>
							}
						</ul>
					} else {
						<p class="wb-dashboard-empty-hint">No recent warnings</p>
					}
				</div>
			</div>
			<div class="wb-dashboard-panel">
				<h3 class="wb-dashboard-panel-title">Recent Errors</h3>
				<div class="wb-dashboard-panel-body">
					if len(v.Errors) > 0 {
						<ul class="wb-dashboard-event-list">
							for _, e := range v.Errors {
								<li class="wb-dashboard-event">
									<span class="wb-dashboard-event-time">{ e.Time }</span>
									<span class="wb-dashboard-event-component">{ e.Component }</span>
									{ e.Message }
								</li>
							}
						</ul>
					} else {
						<p class="wb-dashboard-empty-hint">No recent errors</p>
					}
				</div>
			</div>
		</div>
	</div>
}
