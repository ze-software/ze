module ze-web-conf {
    namespace "urn:ze:web:conf";
    prefix web;

    import ze-types { prefix zt; }
    import ze-extensions { prefix ze; }

    description "Web interface configuration for Ze";

    revision 2026-01-01 {
        description "Initial revision";
    }

    container environment {
        description "Environment settings for the web interface.";
        ze:help "The web container under it carries every web interface setting: the
                 enable switch, the listen endpoints, the certificate and the UI
                 mode.";

        container web {
            description "Web interface settings.";
            ze:help "The container holds the enable switch, the listen endpoints, the
                     insecure switch, the certificate name and the UI mode.";

            leaf enabled {
                type boolean;
                default false;
                description "Enable the web interface.";
                ze:help "The web interface does not start while this leaf is false,
                         and false is the default.";
            }

            list server {
                key "name";
                ze:listener;
                description "Web server listen endpoints.";
                ze:help "Each entry names one listen endpoint. The default endpoint
                         is 0.0.0.0 on port 3443.";

                leaf name {
                    type string;
                    description "Server instance name.";
                    ze:help "The name is the list key, so each server entry carries a
                             different one.";
                }

                uses zt:listener {
                    refine ip {
                        default "0.0.0.0";
                    }
                    refine port {
                        default 3443;
                    }
                }
            }

            leaf insecure {
                type boolean;
                default false;
                description "Disable authentication, which forces the host to 127.0.0.1.";
                ze:help "With true, the web interface asks for no credentials. Ze
                         then binds it to 127.0.0.1, so only a user on the host
                         reaches it.";
            }

            leaf certificate {
                type string {
                    length "1..255";
                    pattern '[A-Za-z0-9._-]+';
                }
                description
                    "Name of the PKI store certificate served on the HTTPS listener (ze.web.certificate).";
                ze:help
                    "The listener sends the leaf certificate and every
                     intermediate certificate the store entry holds, so a client
                     can build the full chain.
                     When this leaf is not set, ze generates a self-signed
                     certificate and serves that.
                     When this leaf is set and the store has no entry with that
                     name, or the entry holds no private key, the web server does
                     not start and the reload is rejected. ze never falls back to
                     a self-signed certificate for a configured name.
                     Environment variable: ze.web.certificate.";
            }

            leaf ui-mode {
                type enumeration {
                    enum finder { description "Default file-browser style UI."; }
                    enum workbench { description "Experimental workbench UI."; }
                }
                default "finder";
                description "Web UI mode.";
                ze:help "finder is the default file-browser UI. workbench is the
                         experimental one.";

            }
        }
    }
}
