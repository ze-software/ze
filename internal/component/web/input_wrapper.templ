// Design: docs/architecture/web-interface.md -- web configuration input component

package web

// fieldWrapper is the label and frame around one leaf editor. The editor comes
// in as a component, so the frame is one balanced element rather than the
// field_wrapper_start / field_wrapper_end pair it replaces. templ parses whole
// elements, so an open tag with no close is not expressible, and a pair that
// only the caller balances was the reason the old markup could half-render.
templ fieldWrapper(f FieldMeta, input templ.Component) {
	<div class="ze-field" id={ "field-" + f.Leaf }>
		// for= binds the label to the editor, which is what gives the editor an
		// accessible NAME. Without it a textbox falls back to its placeholder,
		// so a snapshot reader and a screen reader both hear the YANG
		// description, or the default value, where the leaf name belongs, and
		// clicking the label focuses nothing. The id is the editor's own
		// (view.go, fieldInputID), never the wrapper's field-<leaf>: the
		// wrapper holds no value, and a .wb that fills it posts nothing
		// (plan/journal/field-carries-two-meanings.md).
		<label class="ze-field-label" for={ fieldInputID(f.Path, f.Leaf) }>
			{ f.Leaf }
			if f.Description != "" {
				// The badge's glyph and its CSS-generated tooltip (style.css,
				// .ze-field-info::after takes content from data-tooltip) sit
				// inside the bound label, so both join the editor's accessible
				// NAME: a reader hears "pid i PID file path". The leaf name
				// comes first, which is the part that identifies the field, and
				// the description after it is the field's own help. Moving the
				// description out of the name means aria-describedby on each
				// input template, which is its own piece of work
				// (plan/journal/field-carries-two-meanings.md).
				<span class="ze-field-info" data-tooltip={ f.Description }>i</span>
			}
			if f.Decoration != "" {
				<span class="ze-field-decoration">({ f.Decoration })</span>
			}
		</label>
		// The pair this replaced ended one file and began the next, so a
		// newline separated the label from the editor and the browser drew a
		// space there. templ writes no whitespace before an @ call, and both
		// tags are inline, so the space has to be an expression to survive.
		{ " " }
		@input
	</div>
}
