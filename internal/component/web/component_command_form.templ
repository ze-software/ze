// Design: docs/architecture/web-interface.md -- web interface component

package web

// commandForm is the parameter form for a leaf admin command. It posts into
// the detail panel, which is where its result lands.
templ commandForm(v *FragmentData) {
	<div class="command-form">
		<h3 class="command-form-title">{ v.CommandForm.CommandName }</h3>
		if v.CommandForm.ShortHelp != "" {
			<p class="command-form-description">{ v.CommandForm.ShortHelp }</p>
		}
		if v.CommandForm.Description != "" {
			<p class="command-form-help">{ v.CommandForm.Description }</p>
		}
		<form
			method="post"
			action={ v.CommandForm.ActionURL }
			hx-post={ v.CommandForm.ActionURL }
			hx-target="#detail"
			hx-swap="innerHTML"
		>
			for _, p := range v.CommandForm.Parameters {
				<div class="command-form-field">
					<label class="command-form-label" for={ "param-" + p.Name }>{ p.Name }</label>
					<input
						type="text"
						class="command-form-input"
						id={ "param-" + p.Name }
						name={ p.Name }
						value={ p.Value }
						placeholder={ p.Placeholder }
					>
					if p.ShortHelp != "" {
						<span class="command-form-field-summary">{ p.ShortHelp }</span>
					}
					if p.Description != "" {
						<p class="command-form-field-help">{ p.Description }</p>
					}
				</div>
			}
			<button type="submit" class="command-form-execute">Execute</button>
		</form>
	</div>
}
