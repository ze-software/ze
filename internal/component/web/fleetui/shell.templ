// Design: docs/architecture/fleet-interface.md -- the fleet shell markup
// Related: shell_view.go -- the views these components render
// Related: tree.templ -- the tree of the sidebar
// Related: assets/fleet.js -- the script that reads the data attributes written here
// Related: assets/fleet-shell.css -- the styles of every class written here

package fleetui

// The ids of the regions the script and the out-of-band answers name.
const (
	idSidebar     = "fleet-sidebar"
	idObject      = "fleet-object"
	idContent     = "fleet-content"
	idContentBody = "fleet-content-body"
	idSidePanel   = "fleet-side-panel"
	idPanelBody   = "fleet-panel-body"
	idTree        = "fleet-tree"
	idTreeView    = "fleet-tree-view"
	idAdminList   = "fleet-admin-list"
	idHeaderTasks = "fleet-header-tasks"
)

// fragmentBase is the prefix of every fragment address. The content region
// carries it with fleetPath and EventsPath, so the script builds every address
// from what the page says and never from the browser's location.
const fragmentBase = fleetPath + fragmentSegment + "/"

// The values of the data attributes a region carries. A live event names a
// region, and the script fetches again the fragment each element of that
// region names.
const (
	regionKeyTree    = "tree"
	regionKeyContent = "content"
	regionKeyHeader  = "header"
)

// Shell renders one fleet page: the header, the sidebar, the main pane around
// content, the side panel region around side, the task panel and the toast
// area. side is read only while the panel is open.
templ Shell(view ShellView, content templ.Component, side templ.Component) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ view.Main.Title }</title>
			<link rel="stylesheet" href="/fleet/assets/fleet-shell.css"/>
			<link rel="stylesheet" href="/fleet/assets/fleet-components.css"/>
			<link rel="stylesheet" href="/fleet/assets/fleet-devices.css"/>
			<link rel="stylesheet" href="/fleet/assets/fleet-dashboard.css"/>
			<link rel="stylesheet" href="/fleet/assets/fleet-device.css"/>
			<link rel="stylesheet" href="/fleet/assets/fleet-activity.css"/>
			<link rel="stylesheet" href="/fleet/assets/fleet-manage.css"/>
			<link rel="stylesheet" href="/assets/uPlot.min.css"/>
			<script src="/fleet/assets/fleet-theme.js"></script>
			<script src="/assets/htmx.min.js" defer></script>
			<script src="/assets/uPlot.min.js" defer></script>
			<script src="/fleet/assets/fleet.js" defer></script>
			<script src="/fleet/assets/fleet-components.js" defer></script>
			<script src="/fleet/assets/fleet-chart.js" defer></script>
			<script src="/fleet/assets/fleet-terminal.js" defer></script>
		</head>
		<body class="fleet-shell">
			@shellHeader(view.Header)
			@shellSidebar(view.Sidebar)
			@shellMain(view.Main, content)
			@sidePanel(view.Panel, side, false)
			@TaskPanel(view.Tasks)
			@ToastArea()
		</body>
	</html>
}

// pageUpdate renders what a navigation inside the shell changes: the content
// region, which htmx swaps into its target, then the regions that follow the
// page, each swapped out of band into the element of the same id.
templ pageUpdate(view ShellView, content templ.Component, side templ.Component) {
	@contentRegion(view.Main, content)
	<div id={ idObject } hx-swap-oob="innerHTML">
		@objectRegion(view.Main)
	</div>
	<div id={ idTree } hx-swap-oob="innerHTML">
		@treeRows(view.Sidebar.Tree.Rows)
	</div>
	<select id={ idTreeView } hx-swap-oob="innerHTML">
		@treeViewOptions(view.Sidebar.Tree)
	</select>
	<ul id={ idAdminList } hx-swap-oob="innerHTML">
		@adminLinks(view.Sidebar)
	</ul>
	@sidePanel(view.Panel, side, true)
}

// shellHeader renders the header region: the sidebar toggle, the product
// name linking to the estate, the hub name, the sample tag and the script
// controls of a scripted source, the search field, the Tasks button and the
// account menu.
templ shellHeader(view HeaderView) {
	<header class="fleet-header">
		<button type="button" class="fleet-header-button" data-fleet-action="sidebar-toggle" aria-controls={ idSidebar } aria-expanded="true" aria-label="Toggle the sidebar" title="Toggle the sidebar">
			@Icon("menu")
		</button>
		<a class="fleet-product" href="/fleet/">Ze Fleet</a>
		<span class="fleet-hub-name">{ view.EstateName }</span>
		if view.Sample {
			<span class="fleet-sample-tag" title="This estate is invented: no real device is shown or changed">Sample data</span>
		}
		if view.Script != nil {
			@headerScript(*view.Script)
		}
		<div class="fleet-search" role="search">
			<input type="search" class="fleet-search-field" id="fleet-search" name="search" placeholder="Search devices and pages" aria-label="Search devices and pages" aria-controls="fleet-search-results" aria-expanded="false" autocomplete="off" role="combobox" data-fleet-fragment={ view.SearchURL }/>
			<span class="fleet-field-icon">
				@Icon("search")
			</span>
			<div class="fleet-search-results" id="fleet-search-results" hidden></div>
		</div>
		<div class="fleet-header-tasks" id={ idHeaderTasks } data-fleet-region={ regionKeyHeader } data-fleet-name={ fragmentHeader }>
			@headerTasks(view.Tasks)
		</div>
		<div class="fleet-menu fleet-account" data-fleet-menu="true">
			<button type="button" class="fleet-header-button fleet-menu-button" aria-expanded="false" aria-label="Account menu" title="Account" data-fleet-menu-button="true">
				@Icon("user")
				<span class="fleet-account-name">{ view.Username }</span>
			</button>
			<ul class="fleet-menu-list" hidden>
				<li>
					<button type="button" class="fleet-menu-item" data-fleet-action="theme-toggle">
						<span class="fleet-theme-to-light">
							@Icon("sun")
						</span>
						<span class="fleet-theme-to-dark">
							@Icon("moon")
						</span>
						<span class="fleet-action-label">Switch theme</span>
					</button>
				</li>
				<li>
					<a class="fleet-menu-item" href="/">
						@Icon("external")
						<span class="fleet-action-label">Other web modes</span>
					</a>
				</li>
			</ul>
		</div>
	</header>
}

// headerTasks renders the Tasks button: an icon with the count of the tasks
// that are not over, and a dot in the error colour when a task failed. The
// dot is never the only carrier: the button's name says it in words.
templ headerTasks(view HeaderTasksView) {
	<button type="button" class="fleet-header-button fleet-tasks-button" data-fleet-toggle={ taskPanelID } aria-controls={ taskPanelID } aria-label={ view.Label } title={ view.Label }>
		@Icon("tasks")
		if view.Running > 0 {
			<span class="fleet-tasks-count">{ countText(view.Running) }</span>
		}
		if view.Failed {
			<span class="fleet-tasks-failed"></span>
		}
	</button>
}

// The ids of the header's script controls and of the forms they submit. A
// browser test steps the estate by them.
const (
	idProtoStep     = "fleet-proto-step"
	idProtoHold     = "fleet-proto-hold"
	idProtoStepForm = "fleet-proto-step-form"
	idProtoHoldForm = "fleet-proto-hold-form"
)

// headerScript renders the script controls of the header: Step and Hold,
// each submitting its own form to its prototype-only route through htmx. The
// answer swaps nothing in the page: its toast lands out of band, and the
// event the step published reaches every region through the page's stream.
templ headerScript(view HeaderScriptView) {
	<div class="fleet-header-script" role="group" aria-label="Sample script">
		<form class="fleet-header-script-form" id={ idProtoStepForm } method="post" action={ templ.URL(view.StepAction) } hx-post={ view.StepAction } hx-target="this" hx-swap="none">
			@ActionButton(ActionView{ID: idProtoStep, Label: "Step", Icon: "next", Form: idProtoStepForm})
		</form>
		<form class="fleet-header-script-form" id={ idProtoHoldForm } method="post" action={ templ.URL(view.HoldAction) } hx-post={ view.HoldAction } hx-target="this" hx-swap="none">
			@ActionButton(ActionView{ID: idProtoHold, Label: "Hold", Icon: "pin", Form: idProtoHoldForm})
		</form>
	</div>
}

// shellSidebar renders the sidebar region: its two tabs with the pin control
// at the right end of their row, the Estate pane with the tree, the
// Administration pane with its pages, and the handle that resizes it.
templ shellSidebar(view SidebarView) {
	<nav class="fleet-sidebar" id={ idSidebar } aria-label="Estate navigation">
		<div class="fleet-sidebar-tabs" role="tablist" aria-label="Sidebar">
			<button type="button" class={ "fleet-sidebar-tab", templ.KV("fleet-sidebar-tab--active", !view.AdminActive) } id="fleet-tab-estate" role="tab" aria-selected={ boolText(!view.AdminActive) } aria-controls="fleet-pane-estate" data-fleet-action="sidebar-tab">Estate</button>
			<button type="button" class={ "fleet-sidebar-tab", templ.KV("fleet-sidebar-tab--active", view.AdminActive) } id="fleet-tab-admin" role="tab" aria-selected={ boolText(view.AdminActive) } aria-controls="fleet-pane-admin" data-fleet-action="sidebar-tab">Administration</button>
			<button type="button" class="fleet-header-button fleet-sidebar-pin" data-fleet-action="sidebar-pin" aria-pressed="true" aria-label="Keep the sidebar open" title="Keep the sidebar open">
				@Icon("pin")
			</button>
		</div>
		<div class="fleet-sidebar-pane" id="fleet-pane-estate" role="tabpanel" aria-labelledby="fleet-tab-estate" hidden?={ view.AdminActive }>
			@treePane(view.Tree)
		</div>
		<div class="fleet-sidebar-pane" id="fleet-pane-admin" role="tabpanel" aria-labelledby="fleet-tab-admin" hidden?={ !view.AdminActive }>
			<ul class="fleet-admin-list" id={ idAdminList }>
				@adminLinks(view)
			</ul>
		</div>
		<div class="fleet-sidebar-handle" id="fleet-sidebar-handle" role="separator" aria-orientation="vertical" aria-label="Resize the sidebar" aria-controls={ idSidebar } aria-valuemin="12" aria-valuemax="28" aria-valuenow="17" tabindex="0"></div>
	</nav>
}

// adminLinks renders the administration pages as the rows of their list.
templ adminLinks(view SidebarView) {
	for _, link := range view.Admin {
		<li class={ "fleet-admin-row", templ.KV("fleet-admin-row--selected", link.Active) }>
			@NavLink(NavLinkView{Href: link.Href, Class: "fleet-admin-link", Current: link.Active}) {
				@Icon("config")
				<span class="fleet-admin-name">{ link.Title }</span>
			}
		</li>
	}
}

// shellMain renders the main pane: the banner that says live updates
// stopped, the object region and the content region.
templ shellMain(view MainView, content templ.Component) {
	<main class="fleet-main" id="fleet-main">
		@staleBanner()
		<div class="fleet-object" id={ idObject } data-fleet-region={ regionKeyContent } data-fleet-name={ fragmentObject }>
			@objectRegion(view)
		</div>
		<section class="fleet-content" id={ idContent } aria-label="Content">
			@contentRegion(view, content)
		</section>
	</main>
}

// staleBanner renders the banner shown over the content while the live event
// stream is lost. The script fills in the time and shows it.
templ staleBanner() {
	<div class="fleet-stale" id="fleet-stale" role="status" hidden>
		@Icon("alert")
		<span class="fleet-stale-text">Live updates stopped at <time id="fleet-stale-time"></time>. This page shows what was read then.</span>
		<button type="button" class="fleet-stale-action" data-fleet-action="events-reconnect">Reconnect</button>
	</div>
}

// objectRegion renders what names the object the page shows: its header, the
// breadcrumb when the object is not the estate, and the tab row.
templ objectRegion(view MainView) {
	@objectHeader(view.Object)
	if len(view.Crumbs) > 0 {
		@breadcrumb(view.Crumbs)
	}
	if len(view.Tabs) > 0 {
		@tabRow(view)
	}
}

// objectHeader renders the object's icon and name at the left, with its state
// word and a spinner while a task targets it, and at the right its primary
// action and its Actions menu.
templ objectHeader(view ObjectHeaderView) {
	<div class="fleet-object-header">
		@ObjectIcon(view.Icon)
		<h1 class="fleet-object-name">{ view.Name }</h1>
		if view.Stated {
			@StateWord(view.State)
		}
		if view.Busy {
			<span class="fleet-spinner" role="img" aria-label="A task is running on this object" title="A task is running on this object"></span>
		}
		<div class="fleet-object-actions">
			if view.HasPrimary {
				@ActionLink(view.Primary)
			}
			if len(view.Menu.Items) + len(view.Menu.Destructive) > 0 {
				@Menu(MenuView{Label: actionsMenuWord, Items: view.Menu.Items, Destructive: view.Menu.Destructive})
			}
		</div>
	</div>
}

// breadcrumb renders the way from the estate to the page in hand. Every step
// but the last is a link.
templ breadcrumb(crumbs []CrumbView) {
	<nav class="fleet-breadcrumb" aria-label="Breadcrumb">
		<ol class="fleet-breadcrumb-list">
			for _, crumb := range crumbs {
				<li class="fleet-breadcrumb-step">
					if crumb.Current {
						<span class="fleet-breadcrumb-current" aria-current="page">{ crumb.Title }</span>
					} else {
						@NavLink(NavLinkView{Href: crumb.Href, Class: "fleet-breadcrumb-link"}) {
							{ crumb.Title }
						}
					}
				</li>
			}
		</ol>
	</nav>
}

// tabRow renders the tabs of the object, the active one marked.
templ tabRow(view MainView) {
	<nav class="fleet-tab-row" aria-label={ view.TabsLabel }>
		for _, tab := range view.Tabs {
			@NavLink(NavLinkView{Href: tab.Href, Class: tabClass(tab), Current: tab.Active}) {
				{ tab.Title }
			}
		}
	</nav>
}

// contentRegion renders the body of the content region around content. It
// carries what the script applies after a navigation inside the shell: the
// document title of the page and the address of its live event stream. It
// also carries where the page is: its path, its address with the view, the
// fleet prefix and the fragment prefix. Every answer that changes the page
// carries this element, the whole shell and a navigation's answer alike, so
// the script reads the page in hand here and never from the browser's
// location. It is marked live unless the page holds state the browser owns.
templ contentRegion(view MainView, content templ.Component) {
	<div
		class="fleet-content-body"
		id={ idContentBody }
		data-fleet-title={ view.Title }
		data-fleet-path={ view.PagePath }
		data-fleet-address={ view.PageAddress }
		data-fleet-base={ fleetPath }
		data-fleet-fragments={ fragmentBase }
		if view.EventsURL != "" {
			data-fleet-events={ view.EventsURL }
		}
		if view.ContentLive {
			data-fleet-region={ regionKeyContent }
			data-fleet-name={ fragmentContent }
		}
	>
		@content
	</div>
}

// sidePanel renders the side panel region. It is hidden for a page that has
// no side panel, shows side while the address names a row, and the sentence
// that tells how to fill it otherwise. The panel is unpinned by default, so
// the stylesheet draws the region only while it holds a row, over the right
// edge of the content; the class fleet-theme.js sets before the first paint
// from the stored pin makes it stand beside the content, the sentence
// included. oob marks the answer of a navigation inside the shell, which
// replaces the region on the page.
templ sidePanel(view SidePanelView, side templ.Component, oob bool) {
	<aside
		class="fleet-side-panel"
		id={ idSidePanel }
		aria-label="Details"
		data-fleet-panel={ panelState(view) }
		if oob {
			hx-swap-oob="outerHTML"
		}
		hidden?={ !view.Present }
	>
		if view.Open {
			<div class="fleet-panel-body" id={ idPanelBody } data-fleet-region={ regionKeyContent } data-fleet-name={ fragmentPanel }>
				@side
			</div>
		} else if view.Present {
			<div class="fleet-panel-body" id={ idPanelBody }>
				@PanelContent(PanelView{Empty: true})
			</div>
		}
	</aside>
}
