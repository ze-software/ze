// Design: docs/architecture/fleet-interface.md -- the pages of the activity family: tasks, alarms, the states page
// Related: handler_tasks.go -- fills the task section and the task side panel
// Related: handler_prototype.go -- fills the states page
// Related: component_task.templ, component_table.templ, component_panel.templ -- the components composed here
// Related: assets/fleet-activity.css -- the layout of the states page's controls

package fleetui

// TasksSectionView is the table stack of a task table: its title, the query
// row, the pagination row above and below, and the tasks as a list of task
// and event rows, not a grid.
type TasksSectionView struct {
	Title string
	Query *QueryRowView
	Pager *PagerView
	List  TaskListView
}

// ActionFormView is the form an action control of the prototype submits once
// confirmed: it posts Item to the action at Action, and the answer, a toast,
// is swapped out of band into the toast area.
type ActionFormView struct {
	ID     string
	Action string
	Item   string
}

// TaskSideView is the side panel of one task: the forms its actions submit,
// then the panel itself.
type TaskSideView struct {
	Forms []ActionFormView
	Panel PanelView
}

// PrototypeScriptView is the control of the sample script: advance it by
// one event, or hold it. Steps is false over a source that follows no
// script, whose routes are not mounted. Output is the id of the element the
// answer of either route is written into.
type PrototypeScriptView struct {
	StepAction string
	HoldAction string
	Output     string
	Steps      bool
}

// ToastDemoView is one control of the states page that asks for a toast of
// one level, so lifetimes and stacking can be judged.
type ToastDemoView struct {
	Label string
	Href  string
}

// StatesPageView is the prototype's states page: the controls of the sample
// script, the toast demonstrations, and the gallery of every component in
// every state.
type StatesPageView struct {
	Script  PrototypeScriptView
	Toasts  []ToastDemoView
	Gallery GalleryView
}

// tasksSection draws the table stack of a task table. It is the table
// section of the umbrella, with the rows drawn as task and event rows.
templ tasksSection(v TasksSectionView) {
	<section class="fleet-section" aria-label={ v.Title }>
		<header class="fleet-section-head">
			<h2 class="fleet-section-title">{ v.Title }</h2>
		</header>
		if v.Query != nil {
			@QueryRow(*v.Query)
		}
		<div class="fleet-table-bar">
			if v.Pager != nil {
				@Pager(*v.Pager)
			}
		</div>
		@TaskList(v.List)
		<div class="fleet-table-bar">
			if v.Pager != nil {
				@Pager(*v.Pager)
			}
		</div>
	</section>
}

// actionForm draws the empty form an action control names in its form
// attribute. It holds only the item the action sends.
templ actionForm(v ActionFormView) {
	<form class="fleet-activity-form" id={ v.ID } method="post" action={ templ.URL(v.Action) } hx-post={ v.Action } hx-target="this" hx-swap="none">
		<input type="hidden" name={ paramItem } value={ v.Item }/>
	</form>
}

// taskSide draws the side panel of one task, after the forms its Cancel and
// Retry controls submit.
templ taskSide(v TaskSideView) {
	for _, form := range v.Forms {
		@actionForm(form)
	}
	@PanelContent(v.Panel)
}

// prototypeScript draws the two controls of the sample script and the line
// that shows what the last one answered.
templ prototypeScript(v PrototypeScriptView) {
	if v.Steps {
		<div class="fleet-activity-controls">
			<span class="fleet-activity-caption">Sample script</span>
			<form class="fleet-activity-form" method="post" action={ templ.URL(v.StepAction) } hx-post={ v.StepAction } hx-target={ "#" + v.Output } hx-swap="innerHTML">
				<button type="submit" class="fleet-button">
					@Icon("next")
					<span class="fleet-action-label">Advance the sample script by one event</span>
				</button>
			</form>
			<form class="fleet-activity-form" method="post" action={ templ.URL(v.HoldAction) } hx-post={ v.HoldAction } hx-target={ "#" + v.Output } hx-swap="innerHTML">
				<button type="submit" class="fleet-button">
					@Icon("pin")
					<span class="fleet-action-label">Hold the sample script</span>
				</button>
			</form>
			<output class="fleet-activity-event fleet-mono" id={ v.Output } aria-live="polite">No event was published from this page yet.</output>
		</div>
	} else {
		<p class="fleet-activity-note">This data source follows no script, so there is no event to advance and nothing to hold.</p>
	}
}

// statesPage draws the states page: the prototype controls, then the gallery
// of every component in every state, each group under its own heading.
templ statesPage(v StatesPageView) {
	<div class="fleet-activity-states">
		<section class="fleet-section" aria-label="Prototype controls">
			<header class="fleet-section-head">
				<h2 class="fleet-section-title">Prototype controls</h2>
			</header>
			@prototypeScript(v.Script)
			<div class="fleet-activity-controls">
				<span class="fleet-activity-caption">Toasts</span>
				for _, demo := range v.Toasts {
					<button type="button" class="fleet-button" hx-get={ demo.Href } hx-target={ "#" + toastAreaID } hx-swap="beforeend">{ demo.Label }</button>
				}
			</div>
		</section>
		@ComponentGallery(v.Gallery)
	</div>
}
