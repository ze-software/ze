package web

// sidebar is the legacy left navigation: a back link, then one section per
// child of the current node.
templ sidebar(v *FragmentData) {
	if v.ParentURL != "" {
		<div class="sidebar-back">
			<a
				class="sidebar-back-link"
				id="link-back"
				href={ v.ParentURL }
				hx-get={ "/fragment/detail?path=" + v.ParentHxPath }
				hx-target="#detail"
				hx-push-url={ v.ParentURL }
			>&larr; back</a>
		</div>
	}
	for _, s := range v.Sidebar {
		@sidebarSection(s)
	}
}

// sidebarSection is one level of the sidebar. A list shows its entries in a
// flyout and an add button. A container shows its heading alone.
//
// The flyout's add button takes its id from addEntryButtonID, not from the
// literal btn-add-entry. Each list section renders one, so the page carried the
// id once per list even before the list table added its own.
templ sidebarSection(s SidebarSection) {
	<div class="sidebar-section">
		if s.IsList {
			<div class="sidebar-list-group">
				<a
					class="sidebar-heading"
					href={ s.URL }
					hx-get={ "/fragment/detail?path=" + s.HxPath }
					hx-target="#detail"
					hx-push-url={ s.URL }
				>
					{ s.Name }
					if s.Description != "" {
						<span class="ze-field-info" data-tooltip={ s.Description }>i</span>
					}
					<span class="sidebar-count">{ intText(len(s.Entries)) }</span>
				</a>
				<div class="sidebar-flyout">
					for _, e := range s.Entries {
						<a
							class={ sidebarEntryClass(e.Selected) }
							href={ e.URL }
							hx-get={ "/fragment/detail?path=" + e.HxPath }
							hx-target="#detail"
							hx-push-url={ e.URL }
						>{ e.Key }</a>
					}
					<button class="sidebar-flyout-add" id={ addEntryButtonID("sidebar", s.AddURL) } data-action="add-entry" data-base-url={ s.AddURL }>+ new</button>
				</div>
			</div>
		} else {
			<a
				class="sidebar-heading"
				href={ s.URL }
				hx-get={ "/fragment/detail?path=" + s.HxPath }
				hx-target="#detail"
				hx-push-url={ s.URL }
			>
				{ s.Name }
				if s.Description != "" {
					<span class="ze-field-info" data-tooltip={ s.Description }>i</span>
				}
			</a>
		}
	</div>
}
