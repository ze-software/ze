module ze-pki-api {
    namespace "urn:ze:pki:api";
    prefix pkiapi;

    import ze-extensions { prefix ze; }

    description "PKI API operations for Ze. RPCs for inspecting
                 loaded certificates and CA trust anchors.";

    revision 2026-05-19 {
        description "Initial PKI show commands (spec-ipsec-1).";
    }

    rpc certificates {
        description "List all loaded certificates (CA and device).";
        output {
            leaf certificates {
                type string;
                description "JSON array of certificate summary objects.";
            }
        }
    }

    rpc certificate {
        description "Show details, PEM, bundle, or fingerprint of a named certificate.";
        ze:help "Sub-commands: pem, bundle pem, fingerprint
[sha256|sha384|sha512].";
        input {
            leaf name {
                type string;
                description "Certificate name to look up.";
            }
        }
        output {
            leaf certificate {
                type string;
                description "JSON object: certificate details, PEM text, or fingerprint
                             depending on sub-command.";
            }
        }
    }
}
