module ze-ssh-conf {
    namespace "urn:ze:ssh:conf";
    prefix ssh;

    import ze-authz-conf { prefix authz; }
    import ze-types { prefix zt; }
    import ze-extensions { prefix ze; }

    description "SSH server configuration for Ze";

    revision 2026-01-01 {
        description "Initial revision";
    }

    augment "/authz:system/authz:authentication/authz:user" {
        list public-keys {
            key "name";
            description "SSH public keys for key-based authentication.
                         Each entry is a named key (e.g. user@host).";

            leaf name {
                type string;
                description "Key identifier, for example jdoe@laptop.";
                ze:help "The name is the list key, so each key of one user carries a
                         different one.";
            }

            leaf type {
                type enumeration {
                    enum ssh-rsa;
                    enum ssh-ed25519;
                    enum ecdsa-sha2-nistp256;
                    enum ecdsa-sha2-nistp384;
                    enum ecdsa-sha2-nistp521;
                }
                description "SSH public key algorithm.";
                ze:help "The algorithm is the first field of an SSH public key line,
                         such as ssh-ed25519.";
            }

            leaf key {
                type string;
                description "Base64-encoded public key data.";
                ze:help "The value is the middle field of an SSH public key line.
                         It carries no type prefix and no comment suffix.";
            }
        }
    }

    container environment {
        description "Environment settings for the SSH server.";
        ze:help "The ssh container under it carries every SSH server setting: the
                 enable switch, the listen endpoints, the host key and the session
                 limits.";

        container ssh {
            description "SSH server settings.";
            ze:help "The container holds the enable switch, the listen endpoints, the
                     host key, the host certificate, the idle timeout and the session
                     limit.";

            leaf enabled {
                type boolean;
                default false;
                description "Enable the SSH server.";
                ze:help "The SSH server does not start while this leaf is false, and
                         false is the default.";
            }

            list server {
                key "name";
                ze:listener;
                description "SSH server listen endpoints.";
                ze:help "Each entry names one listen endpoint. The default endpoint
                         is 0.0.0.0 on port 2222.";

                leaf name {
                    type string;
                    description "Server instance name.";
                    ze:help "The name is the list key, so each server entry carries a
                             different one.";
                }

                uses zt:listener {
                    refine ip {
                        default "0.0.0.0";
                    }
                    refine port {
                        default 2222;
                    }
                }
            }

            leaf host-key {
                type string;
                description "Path to the SSH host key file.";
                ze:help "The default path is the config directory plus
                         ssh_host_ed25519_key. Ze generates that key when the
                         file is missing.";
            }

            leaf host-certificate {
                type string;
                description "Path to the SSH host certificate file, signed by a CA.";
                ze:help "A client that trusts the CA verifies the host on the
                         first connection. It does not have to trust the host key
                         on first use.";

            }

            leaf idle-timeout {
                type uint32;
                description "Idle timeout in seconds. The default is 600.";
                ze:help "Ze passes the value to the SSH server as the maximum
                         duration of one session. The default is 600 seconds.";
            }

            leaf max-sessions {
                type uint16;
                description "Maximum number of concurrent SSH sessions.";
                ze:help "Ze answers a session past this limit with 'maximum sessions
                         reached', and closes it. The default limit is 8 sessions.";

            }
        }
    }
}
