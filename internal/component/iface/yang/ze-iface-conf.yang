module ze-iface-conf {
    namespace "urn:ze:iface:conf";
    prefix iface;

    import ze-types { prefix zt; }
    import ze-extensions { prefix ze; }

    description "Network interface configuration for Ze";

    revision 2026-01-01 {
        description "Initial revision";
    }

    grouping interface-common {
        description "Interface properties common to all kinds (L2 and L3)";

        leaf description {
            type string {
                length "0..255";
            }
            description "Interface description";
            ze:help "Ze keeps the text in the config only, and it makes no kernel call for it. The
                     kernel link alias IFLA_IFALIAS carries ze's own ownership marker instead, so
                     a description never reaches it.";
        }

        leaf mtu {
            type uint16 {
                range "68..16000";
            }
            default 1500;
            description "Maximum transmission unit";
            ze:help "The range is 68 to 16000 bytes and the default is 1500. Ze applies the value
                     with the netlink call LinkSetMTU after it creates the interface. Ze restores
                     the previous value when a later step of the same apply fails.";
        }

        leaf os-name {
            type string;
            ze:validate "os-device-name";
            description "OS device this logical interface name binds to.";
            ze:help "When this leaf is omitted, ze uses the logical name as the OS device name, so
                     every interface whose name already matches its kernel device resolves
                     unchanged. Set the leaf to alias a readable interface name to a different
                     kernel device. The iface resolver then maps the logical name to this OS device.
                     ze init records the discovered OS name here.";
        }

        leaf disable {
            type empty;
            description "Administratively disable this interface";
            ze:help "Ze skips a disabled interface at every apply step, so it creates no device
                     and it installs no address. A device ze created before is deleted, because a
                     disabled interface leaves the managed set. The config block stays in place.";
        }
    }

    grouping interface-l2 {
        description "Interface properties for kinds that expose a MAC
                     address at the list level: ethernet, dummy, veth,
                     bridge. Tunnel L2 kinds (gretap, ip6gretap) carry
                     the mac/address leaf inside their per-case containers
                     instead. L3-only kinds with no MAC (e.g. wireguard,
                     L3 tunnels) use interface-common directly.";

        uses interface-common;

        container mac {
            description "Hardware MAC settings for this interface.";
            ze:help "address overrides the operational MAC address. match selects the kernel device
                     by its MAC. The two leaves are independent, so ze can match a NIC by its
                     permanent factory MAC and override its operational MAC at the same time.";
            leaf address {
                type string {
                    pattern '[0-9a-fA-F]{2}(:[0-9a-fA-F]{2}){5}';
                }
                ze:validate "mac-address";
                description "Override the kernel-assigned MAC with a colon-separated hex value.";
                ze:help "An example value is 02:42:ac:11:00:02. Ze applies the value when it creates
                         the interface. When the leaf is omitted, the kernel assigns a MAC by
                         itself.";
            }
            leaf match {
                type string {
                    pattern '[0-9a-fA-F]{2}(:[0-9a-fA-F]{2}){5}';
                }
                ze:validate "mac-address";
                description "Bind this logical interface to the kernel device that carries this hardware MAC.";
                ze:help "The binding is by MAC rather than by name. The resolver matches the
                         device's permanent factory address (IFLA_PERM_ADDRESS) when the device
                         reports one, so the binding survives an operational MAC override. For a
                         virtual device that reports no permanent address, the resolver matches the
                         current address. This leaf takes precedence over os-name. It applies to the
                         ethernet kind only, which is the matched physical kind. Ze identifies the
                         kinds it creates (dummy, veth, bridge and the rest) by the name ze assigns.
                         When the matching device is absent, the binding waits until the device
                         appears.";
            }
        }

        container offload {
            description "Network offload and packet steering features.";
            ze:help "Ze applies these features through a kernel ioctl, the ethtool SIOCETHTOOL
                     interface, or a sysfs write, after it creates the interface. The ethtool(8) CLI
                     program is not required, because ze talks to the kernel directly. For a boolean
                     leaf, true enables the feature explicitly, false disables it explicitly, and an
                     absent leaf preserves the OS default with no kernel call. Offload availability
                     depends on the NIC driver and the kernel version. Ze logs an unsupported
                     feature as a warning, and the config commit still succeeds.";

            leaf gro {
                type boolean;
                description "Generic Receive Offload: aggregate small incoming packets before the network stack.";
                ze:help "GRO aggregates small incoming packets into larger ones before it passes
                         them up the network stack, which reduces the CPU cost per packet. GRO is
                         software-based, so it works on all NIC types, including veth and dummy. Ze
                         applies it through the kernel ioctl ETHTOOL_SGRO. It is equivalent to
                         'ethtool -K <dev> gro on|off'.";
            }

            leaf gso {
                type boolean;
                description "Generic Segmentation Offload: delay segmentation until the NIC driver transmit path.";
                ze:help "GSO delays the segmentation of a large outgoing packet until just before
                         the NIC driver transmit path, which reduces CPU work in the upper stack. It
                         is the software-based counterpart of TSO. Ze applies it through the kernel
                         ioctl ETHTOOL_SGSO. It is equivalent to 'ethtool -K <dev> gso on|off'.";
            }

            leaf sg {
                type boolean;
                description "Scatter-Gather I/O: build one frame from several memory buffers.";
                ze:help "Scatter-Gather I/O lets the NIC assemble a single frame from multiple non-
                         contiguous memory buffers, which avoids data copies. Most drivers need it
                         for TSO and GSO. Ze applies it through the kernel ioctl ETHTOOL_SSG. It is
                         equivalent to 'ethtool -K <dev> sg on|off'.";
            }

            leaf tso {
                type boolean;
                description "TCP Segmentation Offload: the NIC splits large TCP segments into wire frames.";
                ze:help "TSO moves TCP segmentation to the NIC hardware, so the kernel hands off a
                         TCP segment of up to 64 KB and the NIC splits it into MTU-sized frames on
                         the wire. The feature needs NIC hardware support. Disable it when the
                         interface passes traffic to VPP, or to a virtual switch that cannot handle
                         an oversized frame. Ze applies it through the kernel ioctl ETHTOOL_STSO. It
                         is equivalent to 'ethtool -K <dev> tso on|off'.";
            }

            leaf lro {
                type boolean;
                description "Large Receive Offload: the NIC coalesces incoming TCP segments before DMA.";
                ze:help "LRO is the hardware-based counterpart of GRO. It can break forwarding and
                         bridging, because the coalesced frame no longer matches the original wire
                         format. Disable it on a router or a bridge that forwards traffic between
                         interfaces. Ze applies it through the kernel ioctl ETHTOOL_SLRO. It is
                         equivalent to 'ethtool -K <dev> lro on|off'.";
            }

            leaf hw-tc-offload {
                type boolean;
                description "Hardware Traffic Control Offload: run TC filter rules in the NIC.";
                ze:help "The feature lets the NIC run TC flower and u32 filter rules in hardware, so
                         a matched flow does not reach kernel processing. It needs NIC firmware
                         support, which is common on mlx5, bnxt and nfp. Ze applies it through the
                         kernel ioctl ETHTOOL_SFEATURES. It is equivalent to 'ethtool -K <dev> hw-
                         tc-offload on|off'.";
            }

            leaf rps {
                type boolean;
                description "Receive Packet Steering: spread incoming packets across CPUs in software.";
                ze:help "RPS hashes the packet header and steers the packet to a target CPU receive
                         queue. It helps when the NIC has fewer hardware RSS queues than the machine
                         has CPUs. When the leaf is true, ze writes a bitmask covering all online
                         CPUs to each rx queue sysfs entry, at
                         /sys/class/net/<dev>/queues/rx-*/rps_cpus. When the leaf is false, ze
                         writes 0 to each entry. RPS is not an ethtool feature, so ze uses sysfs
                         directly.";
            }

            leaf rfs {
                type boolean;
                description "Receive Flow Steering: steer a flow to the CPU that runs its application.";
                ze:help "RFS extends RPS. It steers an incoming packet to the CPU where the
                         application that consumes the flow runs, which improves cache locality and
                         reduces cross-CPU cache bounces. When the leaf is true, ze sets
                         /proc/sys/net/core/rps_sock_flow_entries to 32768, and it distributes per-
                         queue rps_flow_cnt evenly across the rx queues. Enable RPS as well, because
                         RFS is only effective with RPS. RFS is not an ethtool feature, so ze uses
                         sysfs directly.";
            }
        }
    }

    grouping interface-unit {
        description "Logical interface unit properties";

        list unit {
            key "name";
            description "Logical interface unit";
            ze:help "A unit holds the addresses, the VLAN tag and the sysctl settings of one
                     logical subinterface. A unit with a vlan-id creates a kernel subinterface
                     named <parent>.<vlan-id>. A unit without one puts its addresses on the parent
                     device.";

            leaf name {
                type zt:node-name;
                description "Unit name (lowercase alphanumeric and hyphens)";
                ze:help "The name is the list key and it identifies the unit in the config. It
                         does not reach the kernel. The OS device name comes from the parent
                         device and the vlan-id.";
            }

            leaf vlan-id {
                type uint16 {
                    range "1..4094";
                }
                description "VLAN identifier";
                ze:help "The range is 1 to 4094, which is what IEEE 802.1Q allows. Ze creates a
                         kernel 802.1Q subinterface named <parent>.<vlan-id>. An L3 tunnel refuses
                         a unit that carries this leaf, because only gretap and ip6gretap carry
                         Ethernet frames.";
            }

            leaf description {
                type string {
                    length "0..255";
                }
                description "Unit description";
                ze:help "Ze keeps the text in the config only, and it makes no kernel call for it.
                         The limit is 255 characters.";
            }

            leaf disable {
                type empty;
                description "Administratively disable this unit";
                ze:help "Ze skips a disabled unit at apply, so it installs none of its addresses
                         and it installs no mirror for the unit. A VLAN subinterface ze created
                         for the unit is deleted. The config block stays in place.";
            }

            leaf route-priority {
                type uint32 {
                    range "0..4294966271";
                }
                default 254;
                description "Route metric for default routes learned on this unit through DHCP or router advertisement.";
                ze:help "A lower value is preferred. On link-down, ze increases the metric by 1024,
                         which deprioritizes the interface. The default 254 ranks a learned default
                         below a static default and below a protocol-learned one, the way rib admin-
                         distance ranks connected 0, static 10 and ebgp 20. Write 0 to put a learned
                         default on the kernel metric that an operator's static default also uses.
                         The two then share one kernel route, and the last writer owns it. A value
                         above 0 also makes ze own the IPv6 default routes of the interface: ze sets
                         accept_ra_defrtr=0 and installs the ::/0 routes itself.";
            }

            leaf vrf {
                type string;
                ze:validate "unimplemented-vrf";
                description "Not implemented. Ze refuses a config that sets this leaf.";
                ze:help "Ze creates no VRF device and enslaves no interface, so a unit cannot use a
                         routing table other than the main table. The leaf stays in the schema so
                         that the refusal can say why. It becomes functional when VRF support ships.";
            }

            leaf-list sysctl-profile {
                type zt:node-name;
                max-elements 10;
                ze:syntax "bracket";
                description "Named sysctl profiles to apply to this unit.";
                ze:help "The built-in profiles are dsr, router, hardened, multihomed and proxy. A
                         user-defined profile comes from a sysctl { profile ... } config block. Ze
                         applies the profiles in order, and the last one wins on a key that two
                         profiles both set.";
            }

            container ipv4 {
                description "IPv4 addressing, forwarding, ARP behavior, and DHCP client for this unit.";
                ze:help "The container holds one unit's IPv4 state. Ze installs the addresses
                         through netlink. Ze turns each other leaf into a net.ipv4.conf.<iface>
                         sysctl write, which it emits on the event bus for the sysctl plugin to
                         perform.";

                leaf-list address {
                    type string {
                        pattern '[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}/[0-9]{1,2}';
                    }
                    ze:syntax "bracket";
                    description "IPv4 addresses in CIDR notation (e.g., 10.0.0.1/24)";
                    ze:help "Ze installs each address on the unit's OS device through netlink. An
                             address that leaves the list is removed on the next apply, because ze
                             reconciles the whole set rather than adding to it. A unit with a
                             vlan-id puts its addresses on <parent>.<vlan-id>.";
                }

                leaf forwarding {
                    type boolean;
                    description "Allow this interface to forward IPv4 packets between interfaces.";
                    ze:help "The leaf sets net.ipv4.conf.<iface>.forwarding. Routing needs it. When
                             it is disabled, the kernel drops a packet that is not destined for a
                             local address.";
                }

                leaf arp-filter {
                    type boolean;
                    description "Only answer ARP requests for addresses on the receiving interface.";
                    ze:help "The leaf sets net.ipv4.conf.<iface>.arp_filter. It stops the interface
                             from answering for an address that is assigned to another interface.
                             Use it on a multi-homed host.";
                }

                leaf arp-accept {
                    type boolean;
                    description "Accept gratuitous ARP frames and add their entries to the ARP cache.";
                    ze:help "The leaf sets net.ipv4.conf.<iface>.arp_accept. It helps a failover,
                             where a peer announces a new MAC for an existing IP address.";
                }

                leaf proxy-arp {
                    type boolean;
                    description "Answer ARP requests for other hosts that are reachable through this router.";
                    ze:help "The leaf sets net.ipv4.conf.<iface>.proxy_arp. Use it to bridge subnets
                             that have no L2 connectivity between them, or for an unnumbered
                             interface.";
                }

                leaf arp-announce {
                    type uint8 {
                        range "0..2";
                    }
                    default 0;
                    description "ARP announce level: 0=any, 1=prefer subnet, 2=best only";
                    ze:help "Ze writes the value to net.ipv4.conf.<iface>.arp_announce. Level 0
                             puts any local address in the ARP request. Level 1 prefers an address
                             on the target's subnet. Level 2 uses the best local address only,
                             which the dsr sysctl profile also sets.";
                }

                leaf arp-ignore {
                    type uint8 {
                        range "0..2";
                    }
                    default 0;
                    description "ARP ignore level, which selects the ARP requests this interface answers.";
                    ze:help "0 replies to any request. 1 replies only when the target address is on
                             the incoming interface. 2 adds a sender subnet check to level 1.";
                }

                leaf rpf-check {
                    type enumeration {
                        enum disable;
                        enum strict;
                        enum loose;
                    }
                    description "Reverse path filtering mode";
                    ze:help "Ze writes the value to net.ipv4.conf.<iface>.rp_filter, where disable
                             is 0, strict is 1 and loose is 2. strict drops a packet whose source
                             address would not route back through this interface. loose drops a
                             packet whose source address has no route at all.";
                }

                container dhcp {
                    ze:backend "netlink";
                    description "DHCPv4 client configuration";
                    ze:help "Ze runs its own DHCPv4 client, so no dhclient process and no udhcpc
                             process is needed. The client installs the leased address, the
                             default route and the resolvers that the server sends.";

                    leaf enabled {
                        type boolean;
                        default false;
                        description "Enable DHCPv4 client";
                        ze:help "Ze starts one client when this leaf is true, and it stops the
                                 client when the leaf goes false. The client is keyed by the
                                 interface name and the unit name, so two units on one interface
                                 run two clients.";
                    }

                    leaf client-id {
                        type string;
                        description "DHCP option 61 client identifier, sent in DISCOVER and REQUEST messages.";
                        ze:help "When the leaf is omitted, ze uses the MAC address. Set it for an
                                 environment where the DHCP server keys a lease on the client-id
                                 rather than on the MAC.";
                    }

                    leaf hostname {
                        type string;
                        description "Hostname in DHCP requests";
                        ze:help "Ze sends the value as DHCP option 12 in the DISCOVER message and
                                 in the REQUEST message. When the leaf is omitted, ze sends no
                                 option 12 at all.";
                    }
                }
            }

            container ipv6 {
                description "IPv6 addressing, forwarding, autoconfiguration, and DHCPv6 client for this unit.";
                ze:help "The container holds one unit's IPv6 state. Ze installs the addresses
                         through netlink. Ze turns autoconf, accept-ra and forwarding into
                         net.ipv6.conf.<iface> sysctl writes, which it emits on the event bus for
                         the sysctl plugin to perform.";

                leaf-list address {
                    type string {
                        pattern '[0-9a-fA-F:]{2,39}/[0-9]{1,3}';
                    }
                    ze:syntax "bracket";
                    description "IPv6 addresses in CIDR notation (e.g., fd00::1/64)";
                    ze:help "Ze installs each address on the unit's OS device through netlink. An
                             address that leaves the list is removed on the next apply, because ze
                             reconciles the whole set rather than adding to it.";
                }

                leaf autoconf {
                    ze:backend "netlink";
                    type boolean;
                    description "Enable IPv6 stateless autoconfiguration.";
                    ze:help "The kernel learns an address only when a Router Advertisement reaches
                             the device it owns, so this leaf needs the netlink backend. On the vpp
                             backend, the NIC belongs to VPP, and no advertisement reaches the Linux
                             Control Plane tap.";
                }

                leaf accept-ra {
                    ze:backend "netlink";
                    type uint8 {
                        range "0..2";
                    }
                    default 0;
                    description "Accept RA level: 0 disables, 1 accepts when not forwarding, 2 accepts even when forwarding.";
                    ze:help "This leaf needs the netlink backend, for the same reason as autoconf:
                             the two leaves describe one behavior.";
                }

                leaf forwarding {
                    type boolean;
                    description "Allow this interface to forward IPv6 packets between interfaces.";
                    ze:help "The leaf sets net.ipv6.conf.<iface>.forwarding. Forwarding disables RA
                             acceptance, unless accept-ra is set to 2.";
                }

                leaf rpf-check {
                    type enumeration {
                        enum disable;
                        enum strict;
                        enum loose;
                    }
                    description "Reverse path filtering mode, on the VPP data plane only for IPv6.";
                    ze:help "strict drops a packet whose source address would not be routed back
                             through this interface. loose drops a packet whose source address has
                             no route at all. disable performs no source address validation.";
                }

                container dhcpv6 {
                    ze:backend "netlink";
                    description "DHCPv6 stateful client (RFC 8415).";
                    ze:help "The client requests addresses, delegated prefixes, or both, from a
                             DHCPv6 server. It runs alongside SLAAC when autoconf is also enabled.";

                    leaf enabled {
                        type boolean;
                        default false;
                        description "Enable DHCPv6 client";
                        ze:help "Ze starts a DHCPv6 client on this unit when the leaf is true. The
                                 client sends a Solicit that carries the Rapid Commit option, and
                                 it takes a Reply directly when the server answers with one.
                                 Otherwise it sends a Request after the Advertise.";
                    }

                    container pd {
                        description "Prefix delegation";

                        leaf length {
                            type uint8 {
                                range "48..64";
                            }
                            description "Requested prefix length";
                        }
                    }

                    leaf duid {
                        type string;
                        description "Override the DHCPv6 Unique Identifier (RFC 8415 Section 11).";
                        ze:help "When the leaf is omitted, ze generates a DUID-LL from the interface
                                 MAC. Set the leaf when the DHCP server binds a lease to a specific
                                 DUID.";
                    }
                }

                container router-advertisement {
                    ze:os "linux";
                    ze:backend "netlink";
                    description "Router Advertisement sender (RFC 4861).";
                    ze:help "Ze advertises prefixes, flags and resolvers on this link, so that a
                             host autoconfigures. That is the role radvd fills on another system.
                             Sending is separate from accepting: set forwarding true on an
                             advertising interface, and leave accept-ra at 0 unless this interface
                             also learns from another router.";

                    leaf enabled {
                        type boolean;
                        default false;
                        description "Send Router Advertisements on this unit.";
                        ze:help "RFC 4861 Section 6.2.1 requires AdvSendAdvertisements to default to
                                 false, so a node never becomes a router by accident.";
                    }

                    leaf maximum-interval {
                        type uint16 {
                            range "4..1800";
                        }
                        units seconds;
                        default 600;
                        description "Longest time between unsolicited Router Advertisements (MaxRtrAdvInterval).";
                        ze:help "RFC 4861 Section 6.2.1 defines MaxRtrAdvInterval. Ze picks each
                                 interval at random between minimum-interval and this value.";
                    }

                    leaf minimum-interval {
                        type uint16 {
                            range "3..1350";
                        }
                        units seconds;
                        default 200;
                        description "Shortest time between unsolicited Router Advertisements (MinRtrAdvInterval).";
                        ze:help "RFC 4861 Section 6.2.1 defines MinRtrAdvInterval. The value must
                                 not exceed 0.75 x maximum-interval, and config verify rejects a
                                 larger value.";
                    }

                    leaf router-lifetime {
                        type uint16 {
                            range "0..9000";
                        }
                        units seconds;
                        default 1800;
                        description "How long a host keeps Ze in its default router list (AdvDefaultLifetime).";
                        ze:help "RFC 4861 Section 6.2.1 defines AdvDefaultLifetime. 0 says that Ze
                                 is not a default router, and the prefixes and the resolvers in the
                                 advertisement still apply. Any other value must be at least
                                 maximum-interval, and config verify rejects a smaller one.";
                    }

                    leaf hop-limit {
                        type uint8;
                        default 64;
                        description "Value a host places in the Hop Limit field of its outgoing packets.";
                        ze:help "RFC 4861 Section 4.2 defines AdvCurHopLimit. 0 means that this
                                 router states no value.";
                    }

                    leaf managed {
                        type boolean;
                        default false;
                        description "Set the M flag: hosts get their addresses from DHCPv6
                                     (RFC 4861 Section 4.2).";
                        ze:help "Ze sets bit 0x80 of the flags octet in the Router Advertisement.
                                 Set the flag only where a DHCPv6 server answers on this link,
                                 because the flag alone gives a host no address.";
                    }

                    leaf other-config {
                        type boolean;
                        default false;
                        description "Set the O flag: hosts get other configuration, such as DNS,
                                     from DHCPv6 (RFC 4861 Section 4.2).";
                        ze:help "Ze sets bit 0x40 of the flags octet in the Router Advertisement.
                                 The flag does not change how a host builds its addresses. Use the
                                 rdnss container instead where no DHCPv6 server runs on this
                                 link.";
                    }

                    leaf reachable-time {
                        type uint32 {
                            range "0..3600000";
                        }
                        units milliseconds;
                        default 0;
                        description "How long a host treats a neighbor as reachable after a reachability confirmation.";
                        ze:help "RFC 4861 Section 6.2.1 defines AdvReachableTime. 0 means that this
                                 router states no value.";
                    }

                    leaf retransmit-timer {
                        type uint32;
                        units milliseconds;
                        default 0;
                        description "Time between retransmitted Neighbor Solicitations on this link.";
                        ze:help "RFC 4861 Section 6.2.1 defines AdvRetransTimer. 0 means that this
                                 router states no value.";
                    }

                    list prefix {
                        key "prefix";
                        description "Prefixes advertised in Prefix Information options (RFC 4861 Section 4.6.2).";
                        ze:help "Ze sends the host bits below the prefix length as zero.";

                        leaf prefix {
                            type zt:prefix-ipv6;
                            description "Advertised IPv6 prefix in CIDR notation, for example 2001:db8:1::/64.";
                            ze:help "Stateless autoconfiguration needs a 64-bit prefix (RFC 4862
                                     Section 5.5.3).";
                        }

                        leaf on-link {
                            type boolean;
                            default true;
                            description "Set the L flag: hosts treat addresses in this prefix as
                                         on-link (RFC 4861 Section 4.6.2).";
                            ze:help "Ze sets bit 0x80 of the flags octet in the Prefix Information
                                     option. With the flag clear, a host sends a packet for an
                                     address in this prefix to the router rather than straight to
                                     the neighbor.";
                        }

                        leaf autonomous {
                            type boolean;
                            default true;
                            description "Set the A flag in the Prefix Information option.";
                            ze:help "With the A flag set, a host builds addresses from this prefix
                                     by stateless autoconfiguration (RFC 4862).";
                        }

                        leaf valid-lifetime {
                            type uint32;
                            units seconds;
                            default 2592000;
                            description "How long the prefix stays valid (RFC 4861 Section 4.6.2).";
                            ze:help "4294967295 means that the prefix never expires. The default is
                                     30 days.";
                        }

                        leaf preferred-lifetime {
                            type uint32;
                            units seconds;
                            default 604800;
                            description "How long an address built from the prefix stays preferred.";
                            ze:help "RFC 4861 Section 4.6.2 defines the preferred lifetime. The
                                     value must not exceed valid-lifetime, and config verify rejects
                                     a larger value. The default is 7 days.";
                        }
                    }

                    container rdnss {
                        description "Recursive DNS servers advertised to hosts (RFC 8106 Section 5.1).";
                        ze:help "The option points a link at a resolver without a DHCPv6 server.";

                        leaf-list server {
                            type zt:ipv6-address;
                            ze:syntax "bracket";
                            max-elements 8;
                            description "Resolver addresses. All of them share lifetime.";
                            ze:help "Ze puts every address in ONE RDNSS option, which is why they
                                     share one lifetime. The option carries 8 addresses at most,
                                     and it grows by 16 bytes for each address.";
                        }

                        leaf lifetime {
                            type uint32;
                            units seconds;
                            description "How long a host can use these resolvers (RFC 8106 Section 5.1).";
                            ze:help "0 tells a host to stop using the resolvers, and an operator can
                                     set it. 4294967295 means that the resolvers never expire. This
                                     leaf has no default: leave it out, and Ze sends 3 x maximum-
                                     interval, the value RFC 8106 Section 5.1 recommends. 0 is not
                                     the default for that reason, because Ze could not then tell an
                                     operator who retires a resolver from one who set nothing.";
                        }
                    }
                }
            }

            container mirror {
                ze:os "linux";
                ze:backend "netlink vpp";
                description "Traffic mirroring for this interface.";
                ze:help "The netlink backend mirrors through tc mirred. The vpp backend programs
                         SPAN, through sw_interface_span_enable_disable, and it maps the ingress
                         direction and the egress direction onto the RX SPAN state and the TX SPAN
                         state, as a device-level port mirror.";

                leaf ingress {
                    type string;
                    description "Mirror ingress traffic to this interface";
                    ze:help "Ze installs a tc mirred filter that copies each received frame toward
                             the named interface. Ze resolves the name through the same selector
                             map as the source, so a capture port bound by mac/match or aliased by
                             os-name works. An unbound name installs no mirror.";
                }

                leaf egress {
                    type string;
                    description "Mirror egress traffic to this interface";
                    ze:help "Ze installs a tc mirred filter that copies each transmitted frame
                             toward the named interface. Ze resolves the name through the same
                             selector map as the source, so a capture port bound by mac/match or
                             aliased by os-name works. An unbound name installs no mirror.";
                }
            }

            container mpls {
                ze:os "linux";
                description "MPLS forwarding on this interface (RFC 3031 LSR).";
                ze:help "Ze turns the enable leaf below into a net.mpls.conf.<iface>.input sysctl
                         write. The size of the global label table is a separate sysctl,
                         net.mpls.platform_labels, which the sysctl config block sets.";

                leaf enable {
                    type boolean;
                    default false;
                    description "Enable MPLS label input on this interface.";
                    ze:help "The leaf sets net.mpls.conf.<iface>.input. net.mpls.platform_labels
                             sets the size of the global label table.";
                }
            }
        }
    }

    grouping tunnel-v4-endpoints {
        description "IPv4 underlay endpoints for a tunnel.";

        container local {
            description "Local IPv4 endpoint or source interface (one of ip or interface)";
            ze:help "Set exactly one of ip and interface. Ze refuses both together with 'local ip
                     and local interface are mutually exclusive', and it refuses neither with
                     'local ip or local interface required'.";

            leaf ip {
                type zt:ipv4-address;
                description "Local IPv4 endpoint";
                ze:help "Ze writes the address into the netlink Local field, so it becomes the
                         source address of the outer IPv4 header. Use interface instead where the
                         underlay address is learned by DHCP and can change.";
            }

            leaf interface {
                type string;
                description "Local interface to take the source address from";
                ze:help "Ze looks the device up and passes its kernel index as the netlink parent
                         field, so the kernel takes the source address from that device. The vxlan
                         case refuses this leaf and needs a local ip.";
            }
        }

        container remote {
            description "Remote IPv4 endpoint";
            ze:help "The remote endpoint is mandatory, so ze builds no unnumbered tunnel and no
                     multipoint tunnel. One tunnel interface reaches one remote endpoint.";

            leaf ip {
                type zt:ipv4-address;
                mandatory true;
                description "Remote IPv4 endpoint";
                ze:help "Ze writes the address into the netlink Remote field, so it becomes the
                         destination address of the outer IPv4 header. For a vxlan tunnel this
                         address is the remote VTEP.";
            }
        }
    }

    grouping tunnel-v6-endpoints {
        description "IPv6 underlay endpoints for a tunnel.";

        container local {
            description "Local IPv6 endpoint or source interface (one of ip or interface)";
            ze:help "Set exactly one of ip and interface. Ze refuses both together with 'local ip
                     and local interface are mutually exclusive', and it refuses neither with
                     'local ip or local interface required'.";

            leaf ip {
                type zt:ipv6-address;
                description "Local IPv6 endpoint";
                ze:help "Ze writes the address into the netlink Local field, so it becomes the
                         source address of the outer IPv6 header. Use interface instead where the
                         underlay address is learned by a Router Advertisement and can change.";
            }

            leaf interface {
                type string;
                description "Local interface to take the source address from";
                ze:help "Ze looks the device up and passes its kernel index as the netlink parent
                         field, so the kernel takes the source address from that device.";
            }
        }

        container remote {
            description "Remote IPv6 endpoint";
            ze:help "The remote endpoint is mandatory, so ze builds no unnumbered tunnel and no
                     multipoint tunnel. One tunnel interface reaches one remote endpoint.";

            leaf ip {
                type zt:ipv6-address;
                mandatory true;
                description "Remote IPv6 endpoint";
                ze:help "Ze writes the address into the netlink Remote field, so it becomes the
                         destination address of the outer IPv6 header.";
            }
        }
    }

    container interface {
        description "Network interface configuration.";
        ze:help "An interface name must not be one of the CLI reserved keywords: brief, scan, type,
                 errors, counters. Each of these collides with the 'show interface' and 'clear
                 interface' command grammar. 'show interface counters' would be ambiguous if an
                 interface were named counters. iface.ValidateIfaceName rejects a reserved name at
                 apply time, with a clear error. The kernel does not enforce this on its own.";

        leaf backend {
            type string;
            default "netlink";
            description "Interface management backend: netlink or vpp.";
            ze:help "Ze loads the backend this name selects, and it refuses an unknown name with
                     'unknown backend' and the list of registered names. netlink drives the Linux
                     kernel through rtnetlink. vpp drives the VPP data plane, and it is linked in
                     only under the ze_vpp build tag.";
        }

        leaf dhcp-auto {
            type boolean;
            default false;
            description "Auto-discover the first ethernet interface and run DHCP on it.";
            ze:help "Use this leaf when the interface name is not known at config time, for example
                     on a gokrazy appliance. Ze ignores the leaf when any explicit DHCP config
                     exists.";
        }

        list ethernet {
            key "name";
            unique "mac/address";
            unique "mac/match";
            description "Physical or virtual Ethernet interface.";
            ze:help "Ze manages the interface's addresses, MTU, offload settings and units. The
                     interface must already exist in the OS, because ze does not create a physical
                     interface.";

            leaf name {
                type string;
                description "OS interface name (e.g., eth0, ens3). Must match an existing kernel interface.";
                ze:help "Ze creates no physical interface, so the name must match a device the OS
                         already carries. Where the logical name and the kernel device differ, set
                         os-name to alias the device, or set mac/match to bind by hardware
                         address.";
            }

            uses interface-l2;
            uses interface-unit;
        }

        list dummy {
            key "name";
            description "Dummy interface, which behaves like a loopback.";
            ze:help "Ze creates the interface when it does not exist. Use it to host a service
                     address that is not tied to a physical link, for example a router-id or an
                     anycast VIP.";

            leaf name {
                type string;
                description "Interface name (e.g., dummy0). Ze creates the interface at apply time.";
                ze:help "Ze creates the device with the netlink call LinkAdd and sets it up. The
                         length is 1 to 15 characters, and a slash, a space and the sequence '..'
                         are refused.";
            }

            uses interface-l2;
            uses interface-unit;
        }

        list veth {
            key "name";
            unique "mac/address";
            ze:backend "netlink";
            description "Virtual ethernet pair interface";
            ze:help "A veth is a pair of connected devices, and a packet that enters one end
                     leaves the other. Ze creates both ends in one netlink call and sets both up.
                     The pair exists only while ze manages it, so ze deletes it when the entry
                     leaves the config.";

            leaf name {
                type string;
                description "Veth interface name (e.g., veth0). Ze creates the pair at apply time.";
                ze:help "This name is the end ze manages: it carries the addresses, the units and
                         the MTU. Ze creates the pair with one netlink LinkAdd call, then it sets
                         the link state of both ends to up.";
            }

            leaf peer {
                type string;
                description "Veth peer name";
                ze:help "Ze validates the peer name with the same rules as name. Ze sets the peer
                         link state to up right after it creates the pair. The schema gives the
                         peer end no units, so ze puts no address on it.";
            }

            uses interface-l2;
            uses interface-unit;
        }

        list bridge {
            key "name";
            unique "mac/address";
            ze:backend "netlink";
            description "Linux bridge interface, which forwards Ethernet frames between member ports at L2.";
            ze:help "Ze creates the bridge when it does not exist. Ze enslaves the member interfaces
                     at apply time.";

            leaf name {
                type string;
                description "Bridge interface name (e.g., br0). Ze creates the bridge at apply time.";
                ze:help "Ze creates the bridge with the netlink call LinkAdd when the device is
                         absent. The member leaf-list then enslaves each port to this device.";
            }

            leaf stp {
                ze:os "linux";
                type boolean;
                default false;
                description "Enable Spanning Tree Protocol";
                ze:help "Ze writes 1 or 0 to /sys/class/net/<bridge>/bridge/stp_state. The default
                         false leaves the bridge with no loop protection, so it forwards a frame
                         as soon as a port comes up. Set it true where two ports can reach the
                         same L2 segment.";
            }

            leaf-list member {
                ze:os "linux";
                type string;
                ze:syntax "bracket";
                description "Member port interface names";
                ze:help "Ze enslaves each named port with the netlink call LinkSetMaster. A port
                         that leaves the list is released with LinkSetNoMaster on the next apply.
                         Each name must be an interface the config or the OS already carries.";
            }

            uses interface-l2;
            uses interface-unit;
        }

        list tunnel {
            key "name";
            ze:backend "netlink";
            description "Tunnel interface, in the GRE, GRETAP, IPIP, SIT or IP6TNL family.";
            ze:help "The choice below selects the encapsulation kind, and each case carries only the
                     leaves that are valid for that kind. The local endpoint and remote endpoint
                     pattern matches bgp peer connection { local { ip ... } remote { ip ... } }.";

            leaf name {
                type string;
                description "Interface name (free-form, validated by iface naming rules)";
                ze:help "Ze creates the kernel netdev under this name. The length is 1 to 15
                         characters. A slash, a space and the sequence '..' are refused, because
                         the name reaches a /proc/sys/net/ipv4/conf/<name>/ path.";
            }

            container encapsulation {
                description "Tunnel encapsulation kind and per-kind parameters";
                ze:help "The container holds exactly one case of the kind choice below, and that
                         choice is mandatory. A tunnel with no case is refused with 'encapsulation
                         block has no kind selected'. A tunnel with no encapsulation container is
                         refused with 'missing encapsulation block'.";

                choice kind {
                    mandatory true;
                    description "Encapsulation kind of this tunnel.";
                    ze:help "The schema cannot represent an invalid combination, for example a key
                             on ipip.";

                    case gre {
                        description "GRE over IPv4 (RFC 2784, key extension RFC 2890). L3.";
                        ze:help "The case selects the Linux gre kind, which puts a GRE header
                                 between the outer IPv4 header and the inner packet. RFC 2890 adds
                                 the optional Key field, and the key leaf below sets it.";
                        container gre {
                            ze:backend "netlink vpp";
                            description "GRE-over-IPv4 parameters";
                            ze:help "Ze builds a netlink Gretun link over IPv4 endpoints. The kind
                                     is L3, so a unit that carries a vlan-id on this tunnel is
                                     refused. Use the gretap kind where the tunnel must carry
                                     Ethernet frames.";
                            uses tunnel-v4-endpoints;

                            leaf key {
                                type uint32;
                                description "32-bit GRE key (RFC 2890). Symmetric: same
                                             value used for input and output";
                                ze:help "Ze writes the value into the netlink IKey field and the
                                         netlink OKey field, so one key covers the input direction
                                         and the output direction. The value 0 cannot be set,
                                         because the netlink library reads 0 as no key and leaves
                                         the GRE Key flag clear.";
                            }

                            leaf ttl {
                                type uint8;
                                default 0;
                                description "Outer-header TTL. 0 = inherit from inner";
                                ze:help "Ze writes the value into the outer IPv4 TTL field,
                                         through the netlink field Ttl. 0 makes the kernel take
                                         the value from the inner packet instead.";
                            }

                            leaf tos {
                                type uint8;
                                default 0;
                                description "Outer-header Type of Service. 0 = inherit";
                                ze:help "Ze writes the value into the outer IPv4 Type of Service
                                         field, through the netlink field Tos. 0 makes the kernel
                                         copy the inner packet's own value, which carries a DSCP
                                         marking across the tunnel.";
                            }

                            leaf no-pmtu-discovery {
                                type empty;
                                description "Disable Path MTU Discovery on the outer header";
                                ze:help "Ze sets the netlink field PMtuDisc to 0 when this leaf is
                                         present, and to 1 when it is absent. Path MTU Discovery
                                         is therefore on by default. Set the leaf where the
                                         underlay path drops the ICMP Fragmentation Needed message
                                         that discovery needs.";
                            }
                        }
                    }

                    case gretap {
                        description "GRE over IPv4, L2 (Ethernet over GRE, bridgeable). RFC 2784.";
                        ze:help "The case selects the Linux gretap kind, which carries whole
                                 Ethernet frames over GRE. It is one of the two kinds ze counts as
                                 bridgeable. A unit on it can therefore carry a vlan-id, and the
                                 case carries its own mac container.";
                        container gretap {
                            ze:backend "netlink vpp";
                            description "GRETAP-over-IPv4 parameters";
                            ze:help "Ze builds a netlink Gretap link over IPv4 endpoints. The
                                     kernel selects the GRE protocol type 0x6558, Transparent
                                     Ethernet Bridging, from the link kind alone, so no leaf sets
                                     it.";
                            uses tunnel-v4-endpoints;

                            leaf key {
                                type uint32;
                                description "32-bit GRE key (RFC 2890)";
                                ze:help "Ze writes the value into the netlink IKey field and the
                                         netlink OKey field, so one key covers the input direction
                                         and the output direction. The value 0 cannot be set,
                                         because the netlink library reads 0 as no key and leaves
                                         the GRE Key flag clear.";
                            }

                            leaf ttl {
                                type uint8;
                                default 0;
                                description "Outer-header TTL. 0 = inherit";
                                ze:help "Ze writes the value into the outer IPv4 TTL field,
                                         through the netlink field Ttl. 0 makes the kernel take
                                         the value from the inner packet instead.";
                            }

                            leaf tos {
                                type uint8;
                                default 0;
                                description "Outer-header Type of Service. 0 = inherit";
                                ze:help "Ze writes the value into the outer IPv4 Type of Service
                                         field, through the netlink field Tos. 0 makes the kernel
                                         copy the inner packet's own value, which carries a DSCP
                                         marking across the tunnel.";
                            }

                            leaf no-pmtu-discovery {
                                type empty;
                                description "Disable Path MTU Discovery on the outer header";
                                ze:help "Ze sets the netlink field PMtuDisc to 0 when this leaf is
                                         present, and to 1 when it is absent. Path MTU Discovery
                                         is therefore on by default. Set the leaf where the
                                         underlay path drops the ICMP Fragmentation Needed message
                                         that discovery needs.";
                            }

                            container mac {
                                description "Hardware MAC settings (L2 tunnel kinds only)";
                                ze:help "An L2 tunnel kind carries its MAC leaf here rather than
                                         in the shared interface-l2 grouping, because an L3 kind
                                         has no MAC at all. Ze reads the container for the gretap
                                         kind and the ip6gretap kind only.";
                                leaf address {
                                    type string {
                                        pattern '[0-9a-fA-F]{2}(:[0-9a-fA-F]{2}){5}';
                                    }
                                    ze:validate "mac-address";
                                    description "Hardware MAC address (L2 tunnel kinds only)";
                                    ze:help "Ze applies the value after it creates the netdev,
                                             with the netlink call LinkSetHardwareAddr. When the
                                             leaf is omitted, ze makes no MAC call, and the device
                                             keeps the address the kernel gave it.";
                                }
                            }
                        }
                    }

                    case ip6gre {
                        description "GRE over IPv6 (RFC 2784, key extension RFC 2890). L3.";
                        ze:help "The case selects the Linux ip6gre kind, which puts the GRE header
                                 in an outer IPv6 header. Ze builds it from the same netlink
                                 Gretun type as gre, and the endpoint family selects the kernel
                                 kind.";
                        container ip6gre {
                            description "GRE-over-IPv6 parameters";
                            ze:help "The endpoints are IPv6, so this container carries hoplimit
                                     and tclass where an IPv4 kind carries ttl and tos. The kind
                                     is L3, so a unit that carries a vlan-id on this tunnel is
                                     refused.";
                            uses tunnel-v6-endpoints;

                            leaf key {
                                type uint32;
                                description "32-bit GRE key (RFC 2890)";
                                ze:help "Ze writes the value into the netlink IKey field and the
                                         netlink OKey field, so one key covers the input direction
                                         and the output direction. The value 0 cannot be set,
                                         because the netlink library reads 0 as no key and leaves
                                         the GRE Key flag clear.";
                            }

                            leaf hoplimit {
                                type uint8;
                                default 64;
                                description "Outer IPv6 hop limit (RFC 2473 Section 6.3)";
                                ze:help "Ze writes the value into the outer IPv6 Hop Limit field,
                                         through the netlink field Ttl. The field limits how many
                                         underlay routers the encapsulated packet can cross before
                                         one of them drops it.";
                            }

                            leaf tclass {
                                type uint8;
                                default 0;
                                description "Outer IPv6 traffic class (RFC 2473 Section 6.4)";
                                ze:help "Ze writes the value into the outer IPv6 Traffic Class
                                         field, through the netlink field Tos. The field carries
                                         the DSCP marking of the encapsulated packet across the
                                         underlay.";
                            }
                        }
                    }

                    case ip6gretap {
                        description "GRE over IPv6, L2 (Ethernet over GRE bridgeable). RFC 2784.";
                        ze:help "The case selects the Linux ip6gretap kind, which carries whole
                                 Ethernet frames over GRE in an outer IPv6 header. It is the
                                 second of the two kinds ze counts as bridgeable.";
                        container ip6gretap {
                            description "GRETAP-over-IPv6 parameters";
                            ze:help "Ze builds a netlink Gretap link over IPv6 endpoints. The
                                     endpoints are IPv6, so the container carries hoplimit and
                                     tclass where the gretap case carries ttl and tos.";
                            uses tunnel-v6-endpoints;

                            leaf key {
                                type uint32;
                                description "32-bit GRE key (RFC 2890)";
                                ze:help "Ze writes the value into the netlink IKey field and the
                                         netlink OKey field, so one key covers the input direction
                                         and the output direction. The value 0 cannot be set,
                                         because the netlink library reads 0 as no key and leaves
                                         the GRE Key flag clear.";
                            }

                            leaf hoplimit {
                                type uint8;
                                default 64;
                                description "Outer IPv6 hop limit";
                                ze:help "Ze writes the value into the outer IPv6 Hop Limit field,
                                         through the netlink field Ttl. The field limits how many
                                         underlay routers the encapsulated packet can cross before
                                         one of them drops it.";
                            }

                            leaf tclass {
                                type uint8;
                                default 0;
                                description "Outer IPv6 traffic class";
                                ze:help "Ze writes the value into the outer IPv6 Traffic Class
                                         field, through the netlink field Tos. The field carries
                                         the DSCP marking of the encapsulated packet across the
                                         underlay.";
                            }

                            container mac {
                                description "Hardware MAC settings (L2 tunnel kinds only)";
                                ze:help "An L2 tunnel kind carries its MAC leaf here rather than
                                         in the shared interface-l2 grouping, because an L3 kind
                                         has no MAC at all. Ze reads the container for the gretap
                                         kind and the ip6gretap kind only.";
                                leaf address {
                                    type string {
                                        pattern '[0-9a-fA-F]{2}(:[0-9a-fA-F]{2}){5}';
                                    }
                                    ze:validate "mac-address";
                                    description "Hardware MAC address (L2 tunnel kinds only)";
                                    ze:help "Ze applies the value after it creates the netdev,
                                             with the netlink call LinkSetHardwareAddr. When the
                                             leaf is omitted, ze makes no MAC call, and the device
                                             keeps the address the kernel gave it.";
                                }
                            }
                        }
                    }

                    case ipip {
                        description "IPv4 in IPv4 (RFC 2003). No GRE header, no key. L3.";
                        ze:help "The case selects the Linux ipip kind, which puts an IPv4 packet
                                 directly in an outer IPv4 header with Protocol 4. There is no GRE
                                 header, so no key can separate two tunnels between the same
                                 endpoint pair.";
                        container ipip {
                            ze:backend "netlink vpp";
                            description "IPv4-in-IPv4 tunnel parameters (RFC 2003). Minimal overhead, no key support.";
                            ze:help "Ze builds a netlink Iptun link and sets Proto to
                                     IPPROTO_IPIP. The kind is L3, so a unit that carries a
                                     vlan-id on this tunnel is refused at parse time.";
                            uses tunnel-v4-endpoints;

                            leaf ttl {
                                type uint8;
                                default 0;
                                description "Outer-header TTL. 0 = inherit";
                                ze:help "Ze writes the value into the outer IPv4 TTL field,
                                         through the netlink field Ttl. 0 makes the kernel take
                                         the value from the inner packet instead.";
                            }

                            leaf tos {
                                type uint8;
                                default 0;
                                description "Outer-header Type of Service. 0 = inherit";
                                ze:help "Ze writes the value into the outer IPv4 Type of Service
                                         field, through the netlink field Tos. 0 makes the kernel
                                         copy the inner packet's own value, which carries a DSCP
                                         marking across the tunnel.";
                            }

                            leaf no-pmtu-discovery {
                                type empty;
                                description "Disable Path MTU Discovery on the outer header";
                                ze:help "Ze sets the netlink field PMtuDisc to 0 when this leaf is
                                         present, and to 1 when it is absent. Path MTU Discovery
                                         is therefore on by default. Set the leaf where the
                                         underlay path drops the ICMP Fragmentation Needed message
                                         that discovery needs.";
                            }
                        }
                    }

                    case sit {
                        description "IPv6 in IPv4 (6in4, RFC 4213 Section 3). L3.";
                        ze:help "The case selects the Linux sit kind, which carries IPv6 in an
                                 outer IPv4 header with Protocol 41. Ze sets the netlink field
                                 Proto to IPPROTO_IPV6. Use the kind to reach an IPv6 network over
                                 an IPv4-only underlay.";
                        container sit {
                            description "SIT (6in4) parameters";
                            ze:help "Ze builds a netlink Sittun link. The endpoints are IPv4 and
                                     the payload is IPv6, so the container carries no key leaf.
                                     The kind is L3, so a unit that carries a vlan-id on this
                                     tunnel is refused.";
                            uses tunnel-v4-endpoints;

                            leaf ttl {
                                type uint8;
                                default 0;
                                description "Outer-header TTL. 0 = inherit";
                                ze:help "Ze writes the value into the outer IPv4 TTL field,
                                         through the netlink field Ttl. 0 makes the kernel take
                                         the value from the inner packet instead.";
                            }

                            leaf tos {
                                type uint8;
                                default 0;
                                description "Outer-header Type of Service. 0 = inherit";
                                ze:help "Ze writes the value into the outer IPv4 Type of Service
                                         field, through the netlink field Tos. 0 makes the kernel
                                         copy the inner packet's own value, which carries a DSCP
                                         marking across the tunnel.";
                            }

                            leaf no-pmtu-discovery {
                                type empty;
                                description "Disable Path MTU Discovery on the outer header";
                                ze:help "Ze sets the netlink field PMtuDisc to 0 when this leaf is
                                         present, and to 1 when it is absent. Path MTU Discovery
                                         is therefore on by default. Set the leaf where the
                                         underlay path drops the ICMP Fragmentation Needed message
                                         that discovery needs.";
                            }
                        }
                    }

                    case ip6tnl {
                        description "IPv6 in IPv6 (RFC 2473). Also covers ip6ip6. L3.";
                        ze:help "The case selects the Linux ip6tnl kind, and ze sets the netlink
                                 field Proto to IPPROTO_IPV6, which is 41. The same kernel kind
                                 serves the ipip6 case, and the inner protocol number is the only
                                 thing that separates the two.";
                        container ip6tnl {
                            description "IPv6-in-IPv6 tunnel parameters (RFC 2473). Also handles ip6ip6 encapsulation.";
                            ze:help "Ze builds a netlink Ip6tnl link over IPv6 endpoints. A
                                     read-back of an existing device reports the kind as ip6tnl
                                     for this case and for ipip6, because the kernel drops the
                                     inner protocol number. Ze therefore cannot separate the two
                                     from kernel state alone.";
                            uses tunnel-v6-endpoints;

                            leaf hoplimit {
                                type uint8;
                                default 64;
                                description "Outer IPv6 hop limit (RFC 2473 Section 6.3)";
                                ze:help "Ze writes the value into the outer IPv6 Hop Limit field,
                                         through the netlink field Ttl. The field limits how many
                                         underlay routers the encapsulated packet can cross before
                                         one of them drops it.";
                            }

                            leaf tclass {
                                type uint8;
                                default 0;
                                description "Outer IPv6 traffic class (RFC 2473 Section 6.4)";
                                ze:help "Ze writes the value into the outer IPv6 Traffic Class
                                         field, through the netlink field Tos. The field carries
                                         the DSCP marking of the encapsulated packet across the
                                         underlay.";
                            }

                            leaf encaplimit {
                                type uint8;
                                default 4;
                                description "Tunnel encapsulation limit (RFC 2473 Section 4.1.1)";
                                ze:help "RFC 2473 Section 4.1.1 defines the value as how many
                                         further levels of encapsulation are permitted for the
                                         packet. Ze writes it into the netlink field EncapLimit,
                                         and the kernel sends it as an IPv6 destination option.";
                            }
                        }
                    }

                    case ipip6 {
                        description "IPv4 in IPv6 (RFC 2473 with Next Header = 4). L3.";
                        ze:help "Ze implements this case through the ip6tnl Linux kind, with
                                 Proto=IPPROTO_IPIP.";
                        container ipip6 {
                            description "IPv4-in-IPv6 tunnel parameters (RFC 2473, Next Header = 4). Uses the ip6tnl kernel kind.";
                            ze:help "Ze builds the same netlink Ip6tnl link as the ip6tnl case,
                                     and it sets Proto to IPPROTO_IPIP, which is 4. The endpoints
                                     are IPv6 and the payload is IPv4. The kernel reports the
                                     device kind as ip6tnl either way.";
                            uses tunnel-v6-endpoints;

                            leaf hoplimit {
                                type uint8;
                                default 64;
                                description "Outer IPv6 hop limit";
                                ze:help "Ze writes the value into the outer IPv6 Hop Limit field,
                                         through the netlink field Ttl. The field limits how many
                                         underlay routers the encapsulated packet can cross before
                                         one of them drops it.";
                            }

                            leaf tclass {
                                type uint8;
                                default 0;
                                description "Outer IPv6 traffic class";
                                ze:help "Ze writes the value into the outer IPv6 Traffic Class
                                         field, through the netlink field Tos. The field carries
                                         the DSCP marking of the encapsulated packet across the
                                         underlay.";
                            }

                            leaf encaplimit {
                                type uint8;
                                default 4;
                                description "Tunnel encapsulation limit";
                                ze:help "RFC 2473 Section 4.1.1 defines the value as how many
                                         further levels of encapsulation are permitted for the
                                         packet. Ze writes it into the netlink field EncapLimit,
                                         and the kernel sends it as an IPv6 destination option.";
                            }
                        }
                    }

                    case vxlan {
                        description "VXLAN overlay: L2 Ethernet frames over a UDP/IPv4 underlay, keyed by a 24-bit VNI.";
                        ze:help "The case is implemented in the netlink backend and in the VPP
                                 backend.";
                        container vxlan {
                            ze:backend "netlink vpp";
                            description "VXLAN parameters. local ip is the tunnel
                                         source, remote ip the (unicast) VTEP
                                         destination.";
                            ze:help "Ze builds a netlink Vxlan link, and it refuses a local
                                     interface source, so the local endpoint must be an ip. The
                                     VPP backend implements the same kind through
                                     VxlanAddDelTunnelV3. A unit that carries a vlan-id on this
                                     tunnel is refused, because ze counts only gretap and
                                     ip6gretap as bridgeable.";
                            uses tunnel-v4-endpoints;

                            leaf vni {
                                type uint32 {
                                    range "1..16777215";
                                }
                                mandatory true;
                                description "VXLAN Network Identifier (24-bit, 1..16777215)";
                                ze:help "The VNI separates overlays that share one underlay, so
                                         two VXLAN tunnels between the same endpoints need
                                         different values. Ze refuses 0 and any value more
                                         than 16777215, in the netlink backend and in the VPP
                                         backend.";
                            }

                            leaf port {
                                type zt:port;
                                default 4789;
                                description "UDP destination port (IANA-assigned default 4789)";
                                ze:help "4789 is the port IANA assigns to VXLAN. Ze sends the
                                         value as the netlink destination port, and 0 selects
                                         4789. Change it only where an underlay device or a
                                         firewall expects another port.";
                            }
                        }
                    }
                }
            }

            uses interface-common;
            uses interface-unit;
        }

        list wireguard {
            key "name";
            ze:listener;
            ze:backend "netlink vpp";
            description "WireGuard interface, configured declaratively.";
            ze:help "The interface level carries listen-port, fwmark and private-key, and a nested
                     peer list. Each peer carries public-key, endpoint, allowed-ips, preshared-key
                     and persistent-keepalive. WireGuard is an L3 kind with no MAC address, so it
                     uses interface-common rather than interface-l2. Ze reconciles each peer in
                     place, through the wgctrl ConfigureDevice call. Adding a peer, removing one, or
                     rekeying one does not disturb the netdev or any other peer.";

            leaf name {
                type string;
                description "Interface name (free-form, validated by iface naming rules)";
                ze:help "Ze creates the kernel netdev under this name. The length is 1 to 15
                         characters. A slash, a space and the sequence '..' are refused, because
                         the name reaches a /proc/sys/net/ipv4/conf/<name>/ path.";
            }

            leaf listen-port {
                type zt:port;
                description "UDP port WireGuard binds on 0.0.0.0 and :: for handshake and data traffic.";
                ze:help "When the leaf is unset, the kernel chooses an ephemeral port on the first
                         outbound handshake.";
            }

            leaf fwmark {
                type uint32;
                default 0;
                description "Firewall mark applied to outgoing encapsulated
                             packets for policy routing. 0 means unset.";
                ze:help "Ze passes the value to the kernel through the wgctrl call
                         ConfigureDevice. The kernel then sets the mark on each encapsulated UDP
                         packet, and a policy routing rule or an nftables rule can match it. Ze
                         always sends the leaf, so a config that clears the mark clears the kernel
                         state too.";
            }

            leaf private-key {
                mandatory true;
                type string;
                ze:sensitive;
                description "Base64-encoded 32-byte Curve25519 private key.";
                ze:help "Ze stores the key $9$-encoded on disk, through the standard ze sensitive-
                         leaf pattern, and it decodes the key to plaintext base64 at parse time. 'ze
                         config show' and 'ze config dump' always emit the $9$ form, never the
                         plaintext. The $9$ form is obfuscation and not encryption, so protect the
                         config file at the filesystem level with chmod 600, the same way as a BGP
                         MD5 password.";
            }

            list peer {
                key "name";
                description "WireGuard peer, identified by its public key.";
                ze:help "Each peer has its own set of allowed-ips, which define the traffic that is
                         routed through the tunnel.";

                leaf name {
                    type string;
                    description "Config-level peer name (free-form label, used as list key). Not sent on the wire.";
                    ze:help "The kernel matches a peer by its public key, and this name never
                             reaches the kernel. Ze uses the name as the list key, and in the
                             error message of a peer that fails to apply. A rename therefore
                             produces the same kernel peer set.";
                }

                leaf public-key {
                    type string;
                    mandatory true;
                    description "Base64-encoded 32-byte Curve25519 peer public key";
                    ze:help "The kernel matches an inbound handshake to a peer by this key. The
                             key is public, so it carries no ze:sensitive marker, and ze stores it
                             in plaintext where private-key and preshared-key are $9$-encoded.";
                }

                leaf preshared-key {
                    type string;
                    ze:sensitive;
                    description "Optional base64-encoded 32-byte symmetric preshared key.";
                    ze:help "The key is mixed into the handshake for post-quantum resistance. Ze
                             stores it $9$-encoded on disk, the same pattern as private-key.";
                }

                container endpoint {
                    description "Remote UDP endpoint for this peer.";
                    ze:help "Both leaves are required together. The kernel uses this address on the
                             first outbound handshake, and it updates the address on every inbound
                             handshake from a new source address.";

                    leaf ip {
                        type zt:ip-address;
                        description "Remote IPv4 or IPv6 address (numeric, not
                                     a hostname -- DNS resolution is not performed)";
                        ze:help "Ze parses the value with net.ParseIP, so a hostname is refused at
                                 apply time. When the endpoint is absent, ze sends no address to
                                 the kernel, and the peer must start the handshake.";
                    }

                    leaf port {
                        type zt:port;
                        description "Remote UDP port";
                        ze:help "The value is the listen-port the peer sets on its own side. Ze
                                 combines the port with ip into one UDP address for the kernel, so
                                 a port with no ip reaches nothing.";
                    }
                }

                leaf-list allowed-ips {
                    type string {
                        pattern '[0-9a-fA-F:][0-9a-fA-F:.]*(/[0-9]{1,3})?';
                    }
                    ze:syntax "bracket";
                    description "CIDR prefixes routed into the tunnel for this peer.";
                    ze:help "An inbound packet from this peer must have a source address inside one
                             of these prefixes. That check is cryptokey routing.";
                }

                leaf persistent-keepalive {
                    type uint16 {
                        range "0..65535";
                    }
                    default 0;
                    description "Seconds between unsolicited keepalive packets that maintain NAT state.";
                    ze:help "0 disables the keepalives. A usual value is 25.";
                }

                leaf disable {
                    type empty;
                    description "Administratively disable this peer.";
                    ze:help "Ze removes the peer from the kernel peer set on reload, and the peer
                             stays in the config.";
                }
            }

            uses interface-common;
            uses interface-unit;
        }

        list xfrm {
            key "name";
            ze:os "linux";
            ze:backend "netlink";
            description "XFRM interface, for route-based IPsec (Linux 4.19 and later).";
            ze:help "The kernel XFRM subsystem encrypts and decrypts the traffic that is routed into
                     this interface. The if-id binds security associations to the interface. XFRM is
                     an L3 kind with no MAC address.";

            leaf name {
                type string;
                description "Interface name (free-form, validated by iface naming rules)";
                ze:help "Ze creates the XFRM netdev under this name. The length is 1 to 15
                         characters. A slash, a space and the sequence '..' are refused, because
                         the name reaches a /proc/sys/net/ipv4/conf/<name>/ path.";
            }

            leaf if-id {
                mandatory true;
                type uint32 {
                    range "1..4294967295";
                }
                description "XFRM identifier that binds security associations to this interface.";
                ze:help "A bound security association carries the same if_id. The value must be non-
                         zero, because 0 means unset in the kernel.";
            }

            leaf dev {
                type string;
                description "Optional parent device that this XFRM interface binds to.";
                ze:help "When the leaf is set, ze binds the XFRM interface to this physical device.
                         When the leaf is omitted, the interface is unbound, and it uses the routing
                         table to select the underlay.";
            }

            uses interface-common;
            uses interface-unit;
        }

        list pppoe-client {
            key "name";
            ze:os "linux";
            ze:backend "netlink";
            description "PPPoE client interface (RFC 2516).";
            ze:help "The client dials an access concentrator over a physical Ethernet interface,
                     negotiates LCP, authentication and IPCP, and presents the PPP session as a
                     routable interface with server-assigned addresses. The kernel creates the pppN
                     interface dynamically. The name leaf is a config key only, and the OS interface
                     name is pppN.";

            leaf name {
                type string;
                description "Config-level interface name (e.g. pppoe0)";
                ze:help "The name is the list key and it never reaches the kernel. The kernel
                         names the session device pppN, and ze reports that OS name in the show
                         output.";
            }

            leaf source-interface {
                mandatory true;
                type string;
                description "Physical Ethernet interface for PPPoE discovery
                             (e.g. eth2). Must exist and be admin-up.";
                ze:help "Ze opens a raw discovery socket bound to this device and sends the PADI
                         frame on it. The source MAC of the frame is the device's own hardware
                         address.";
            }

            container authentication {
                description "PPPoE authentication credentials (PAP or CHAP)";
                ze:help "LCP negotiation decides which of PAP and CHAP ze uses. Ze answers PAP
                         with an Authenticate-Request that carries the username as the Peer-ID. Ze
                         answers CHAP with a Response that carries the MD5 digest and the
                         username.";

                leaf username {
                    mandatory true;
                    type string {
                        length "1..255";
                    }
                    description "Authentication username sent to the AC";
                    ze:help "Ze puts the value in the Peer-ID field of a PAP Authenticate-Request,
                             or in the Name field of a CHAP Response. The length is 1 to 255
                             characters.";
                }

                leaf password {
                    mandatory true;
                    type string {
                        length "1..255";
                    }
                    ze:sensitive;
                    description "Authentication password. Stored $9$-encoded
                                 on disk via the standard ze sensitive-leaf
                                 pattern.";
                    ze:help "The $9$ form is obfuscation and not encryption, so protect the config
                             file at the filesystem level with chmod 600. Ze sends the password in
                             a PAP Authenticate-Request. For CHAP, ze sends no password. It
                             computes the MD5 digest over the Identifier, the password and the
                             Challenge Value.";
                }
            }

            leaf service-name {
                type string {
                    length "0..255";
                }
                description "Desired PPPoE service name. Empty or absent
                             means accept any service (RFC 2516 Section 5.1).";
                ze:help "Ze puts the value in the Service-Name tag of the PADI frame and of the
                         PADR frame. An empty value sends a zero-length tag, which every access
                         concentrator answers.";
            }

            leaf ac-name {
                type string {
                    length "0..255";
                }
                description "Desired access concentrator name.";
                ze:help "When the leaf is set, ze accepts a PADO frame only from this access
                         concentrator. An empty or absent value accepts any access concentrator.";
            }

            leaf no-default-route {
                type empty;
                description "Do not install a default route through the PPP interface.";
                ze:help "When the leaf is absent, which is the default, ze installs a default route
                         after IPCP completes.";
            }

            leaf route-priority {
                type uint32 {
                    range "0..4294966271";
                }
                default 254;
                description "Route metric of the default route installed after IPCP completes.";
                ze:help "A lower value is preferred. The default 254 ranks this learned default
                         below a static default and below a protocol-learned one, and it matches the
                         route-priority default on a unit. Write 0 to put the route on the kernel
                         metric that an operator's static default also uses. The two then share one
                         kernel route, and the last writer owns it.";
            }

            uses interface-common;
        }

        container loopback {
            description "The system loopback interface (lo).";
            ze:help "The interface is always present, and ze manages its addresses and units. Use it
                     to host a router-id address that is reachable from any interface.";

            uses interface-unit;
        }

        container monitor {
            description "Interface monitoring settings";

            leaf loopback {
                type boolean;
                default false;
                description "Monitor loopback interface";
            }
        }
    }
}
