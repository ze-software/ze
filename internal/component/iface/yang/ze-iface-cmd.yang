module ze-iface-cmd {
    namespace "urn:ze:iface:cmd";
    prefix ifacecmd;
    import ze-extensions { prefix ze; }
    description "Create, configure, and manage network interfaces";
    revision 2026-08-30 { description "Declare the five values request interface migrate takes, as the keyword groups an operator types: from, to and address are required, create and timeout are not. The grammar is in the model, so completion offers each keyword and the published usage line states the form."; }
    revision 2026-08-29 { description "Declare the values the descriptions spelled in prose: the VLAN id of every unit command, the CIDR prefix of every address command, the veth peer, the MTU byte count and the MAC address. The grammar is in the model, so the renderer states it and the dispatcher types it. The interface name of request interface up, down, mtu and mac moves to the interface container, which is the keyword the operator types it after; request interface migrate names two interfaces of its own, so it states ze:inherit none."; }
    revision 2026-07-03 { description "Typed name selector on create/delete interface (create interface dummy name <n>, delete interface name <n>) per cli-grammar.md Typed Selectors."; }
    revision 2026-06-04 { description "Verb-first grammar: create/delete/request interface"; }

    typedef ip-prefix {
        type union {
            type string { pattern '([0-9]{1,3}\.){3}[0-9]{1,3}(/[0-9]{1,2})?'; }
            type string { pattern '[0-9a-fA-F:.]+(%[a-zA-Z0-9_.-]+)?(/[0-9]{1,3})?'; }
        }
        description "An IPv4 or IPv6 address, with an optional prefix length.";
    }

    typedef iface-unit {
        type string { pattern '[^ /?]+\.[0-9]+'; }
        description "An interface and one of its units, written as name.unit. Unit 0 is
the interface itself.";
    }

    typedef duration {
        type string { pattern '([0-9]+(\.[0-9]+)?(ns|us|ms|s|m|h))+'; }
        description "A time span, written as a number and a unit: 30s, 2m, 1h30m.";
    }

    container create {
        config false;
        description "Create new resources";

        container interface {
            config false;
            description "Create interfaces, units, and addresses";

            container dummy {
                config false;
                description "Create a dummy (loopback-style) interface.";

                container name {
                    config false;
                    ze:command "ze-iface:interface-create-dummy";
                    ze:backend "netlink";
                    ze:ensure-exists "ze-iface:interface-delete";
                    description "Create a dummy (loopback-style) interface.";
                    leaf name { type string; mandatory true; description "Interface name"; }

                    container unit {
                        config false;
                        ze:command "ze-iface:interface-unit-add";
                        ze:backend "netlink";
                        description "Add a VLAN sub-interface to the dummy.";
                        leaf name { type string; mandatory true; description "Parent interface name"; }
                        leaf vid { type uint16 { range "1..4094"; } mandatory true; description "VLAN ID"; }
                    }

                    container address {
                        config false;
                        ze:command "ze-iface:interface-addr-add";
                        ze:backend "netlink";
                        description "Add an IP address to the dummy.";
                        leaf name { type string; mandatory true; description "Interface name"; }
                        leaf prefix { type ip-prefix; mandatory true; description "Address in CIDR form"; }
                    }
                }
            }

            container veth {
                config false;
                description "Create a veth pair (two linked virtual Ethernet interfaces).";

                container name {
                    config false;
                    ze:command "ze-iface:interface-create-veth";
                    ze:backend "netlink";
                    description "Create a veth pair (two linked virtual Ethernet interfaces).";
                    leaf name { type string; mandatory true; description "Interface name"; }
                    leaf peer { type string; mandatory true; description "Peer interface name"; }
                }
            }

            container bridge {
                config false;
                description "Create a Linux bridge for L2 forwarding.";

                container name {
                    config false;
                    ze:command "ze-iface:interface-create-bridge";
                    ze:backend "netlink";
                    ze:ensure-exists "ze-iface:interface-delete";
                    description "Create a Linux bridge for L2 forwarding.";
                    leaf name { type string; mandatory true; description "Interface name"; }

                    container unit {
                        config false;
                        ze:command "ze-iface:interface-unit-add";
                        ze:backend "netlink";
                        description "Add a VLAN sub-interface to the bridge.";
                        leaf name { type string; mandatory true; description "Parent interface name"; }
                        leaf vid { type uint16 { range "1..4094"; } mandatory true; description "VLAN ID"; }
                    }

                    container address {
                        config false;
                        ze:command "ze-iface:interface-addr-add";
                        ze:backend "netlink";
                        description "Add an IP address to the bridge.";
                        leaf name { type string; mandatory true; description "Interface name"; }
                        leaf prefix { type ip-prefix; mandatory true; description "Address in CIDR form"; }
                    }
                }
            }

            container unit {
                config false;
                ze:command "ze-iface:interface-unit-add";
                description "Add a VLAN sub-interface (802.1Q tagged).
Parent must already exist.";
                leaf name { type string; mandatory true; description "Parent interface name"; }
                leaf vid { type uint16 { range "1..4094"; } mandatory true; description "VLAN ID"; }
            }

            container address {
                config false;
                ze:command "ze-iface:interface-addr-add";
                description "Add an IP address to an interface.
Interface must already exist.";
                leaf name { type string; mandatory true; description "Interface name"; }
                leaf prefix { type ip-prefix; mandatory true; description "Address in CIDR form"; }
            }
        }
    }

    container delete {
        config false;

        container interface {
            config false;
            description "Delete an interface, unit, or address.";

            container name {
                config false;
                ze:command "ze-iface:interface-delete";
                description "Delete an interface from the kernel.";
                leaf name { type string; mandatory true; description "Interface name"; }

                container unit {
                    config false;
                    ze:command "ze-iface:interface-unit-del";
                    description "Remove a VLAN sub-interface.";
                    leaf name { type string; mandatory true; description "Sub-interface name (e.g. eth0.100)"; }
                    leaf vid { type uint16 { range "1..4094"; } mandatory true; description "VLAN ID"; }
                }

                container address {
                    config false;
                    ze:command "ze-iface:interface-addr-del";
                    description "Remove an IP address from an interface.";
                    leaf name { type string; mandatory true; description "Interface name"; }
                    leaf prefix { type ip-prefix; mandatory true; description "Address in CIDR form"; }
                }
            }
        }
    }

    container request {
        config false;

        container interface {
            config false;
            description "Interface operational state";

            // The interface every command below acts on. It is declared here,
            // on the keyword the operator types it after, and each of those
            // commands inherits it.
            leaf name { type string; mandatory true; description "Interface name"; }

            container up {
                config false;
                ze:command "ze-iface:interface-up";
                description "Bring an interface up.";
            }

            container down {
                config false;
                ze:command "ze-iface:interface-down";
                description "Shut down an interface.";
            }

            container mtu {
                config false;
                ze:command "ze-iface:interface-mtu";
                description "Set the MTU on an interface. Range: 68 to 65535.";
                leaf bytes { type uint16 { range "68..65535"; } mandatory true; description "MTU in bytes"; }
            }

            container mac {
                config false;
                ze:command "ze-iface:interface-mac";
                description "Set the MAC address on an interface.";
                leaf address { type string { pattern '[0-9a-fA-F]{2}(:[0-9a-fA-F]{2}){5}'; } mandatory true; description "MAC address, as xx:xx:xx:xx:xx:xx"; }
            }

            container migrate {
                config false;
                ze:command "ze-iface:interface-migrate";
                ze:inherit "none";
                description "Move IP addresses between interfaces with minimal downtime.
Takes a source interface, a target interface, and the address to move.
Adds addresses to the target before removing them from the source
(make-before-break).";

                container from {
                    config false;
                    ze:modifier "required";
                    description "Interface and unit the address moves off.";
                    leaf source { type iface-unit; mandatory true; description "Source interface and unit"; }
                }

                container to {
                    config false;
                    ze:modifier "required";
                    description "Interface and unit the address moves onto.";
                    leaf destination { type iface-unit; mandatory true; description "Destination interface and unit"; }
                }

                container address {
                    config false;
                    ze:modifier "required";
                    description "Address to move.";
                    leaf prefix { type ip-prefix; mandatory true; description "Address in CIDR form"; }
                }

                container create {
                    config false;
                    ze:modifier "once";
                    description "Create the destination interface before the address moves onto it.
Leave it out when the destination interface exists.";
                    leaf type {
                        type enumeration {
                            enum dummy;
                            enum veth;
                            enum bridge;
                        }
                        mandatory true;
                        description "Interface type to create";
                    }
                }

                container timeout {
                    config false;
                    ze:modifier "once";
                    description "How long to wait for BGP to become ready on the destination
address before the move is abandoned. The default is 30 seconds.";
                    leaf duration { type duration; mandatory true; description "Wait time, as a number and a unit"; }
                }
            }
        }
    }
}
