module ze-iface-interface-cmd {
    namespace "urn:ze:iface:interface:cmd";
    prefix ifaceifcmd;
    import ze-extensions { prefix ze; }
    // The show interface family holds interface, brief, scan, type, errors, rate,
    // and name detail/counters. The iface component owns the module because every
    // handler reads or resets interface state through the iface backend:
    // iface.ListInterfaces, GetInterface, DiscoverInterfaces, GetRate and
    // ClearCounters. The subtrees container-merge onto the show, monitor, and
    // clear verb roots. See ai/rules/plugin-self-containment.md.
    description "The show interface, monitor interface rate, and clear interface counters command tree.";
    // The model now states the grammar, and the generated usage line reads it.
    revision 2026-08-29 { description "Declare the value the description spelled in prose."; }
    // The show interface family, monitor interface rate, and clear interface
    // counters left the central show, monitor, and clear schemas, for plugin
    // self-containment.
    revision 2026-06-03 { description "Relocated the interface commands into the iface component."; }
    // They shared ze-show:interface with the parent container, so each became an
    // ALIAS path of one wire method. The dispatcher registers the longest path
    // and consumes the keyword, and the handler that switched on it never saw it.
    // show interface errors returned every interface, show interface brief
    // returned full detail, and show interface type <t> answered with usage text.
    // The wire methods now match the sibling scan, detail and counters pattern,
    // one path each.
    revision 2026-08-03 { description "Gave brief, type, errors, and rate their own wire methods."; }

    container show {
        config false;
        description "Read-only commands to inspect system, protocol, and network state.";

        container interface {
            config false;
            ze:command "ze-show:interface";
            description "Show network interfaces on this box.";
            ze:help "Without arguments, returns all interfaces with full detail.
Subcommands: brief, type <t>, errors, rate [<name>], name <name> detail,
name <name> counters.";

            container brief {
                config false;
                ze:command "ze-show:interface-brief";
                description "One-line summary per interface: name, state, IP, and MTU.";
                ze:help "It is the quick way to see what is up and what
addresses are assigned.";
            }

            container scan {
                config false;
                ze:command "ze-show:interface-scan";
                description "Discover and classify all OS interfaces.";
                ze:help "Returns name, Ze type (ethernet, bridge, vxlan, etc.),
and MAC for each interface found. Pipe to table, yaml, or json for different
views. Use it during initial setup to see what the box has.";
            }

            container type {
                config false;
                ze:command "ze-show:interface-type";
                description "Show only interfaces of a given type.";
                ze:help "Types include ethernet, bridge, vxlan, wireguard,
tunnel, bond, and more. If you pick an invalid type, the error lists all valid
ones.";
                leaf type { type string { length "1..32"; } mandatory true; description "Ze interface type to filter by"; }
            }

            container errors {
                config false;
                ze:command "ze-show:interface-errors";
                description "Show interfaces that have errors or drops.";
                ze:help "Filters to only interfaces with non-zero Rx/Tx error or
drop counters. It is the quick way to find troubled links.";
            }

            container rate {
                config false;
                ze:command "ze-show:interface-rate";
                description "Show per-second traffic rates on your interfaces.";
                ze:help "Returns rx/tx bytes and packets per second. Pass an
interface name to narrow the output. Requires the rate tracker. For continuous
monitoring, use 'monitor interface rate' instead.";
            }

            container name {
                config false;
                description "Select one interface by name.";
                ze:help "The keyword takes the interface name, and detail or counters
follows it. Without a name, show interface answers every interface.";

                container detail {
                    config false;
                    ze:command "ze-show:interface-detail";
                    description "Show full detail for one interface.";
                    ze:help "The answer is the whole record the backend holds for that
interface, and the counters are part of it. An unknown name is reported as the backend's own
error.";
                    leaf name {
                        type string;
                        mandatory true;
                        description "Interface name";
                    }
                }

                container counters {
                    config false;
                    ze:command "ze-show:interface-counters";
                    description "Show counters for one interface.";
                    ze:help "The answer is the interface name and its Rx and Tx statistics.
A backend that keeps no statistics for the interface answers no counters available rather
than an error.";
                    leaf name {
                        type string;
                        mandatory true;
                        description "Interface name";
                    }
                }
            }
        }
    }

    container monitor {
        config false;
        description "Continuous monitoring commands (Ctrl-C to stop).";

        container interface {
            config false;
            description "Interface traffic monitoring.";
            ze:help "Only rate sits under this keyword today, and it streams until you stop
it. show interface rate reads the same numbers once.";

            container rate {
                config false;
                ze:command "ze-monitor:interface-rate";
                ze:task-support required;
                description "Stream per-second traffic rates for your interfaces.";
                ze:help "Shows rx/tx bytes and packets per second, updating
every second. Optionally pass an interface name to watch just one link.";
            }
        }
    }

    container clear {
        config false;

        container interface {
            config false;
            description "Reset interface traffic counters.";
            ze:help "Without a name every managed interface is reset. clear interface name
<name> counters resets one instead.";

            container counters {
                config false;
                ze:command "ze-clear:interface-counters";
                description "Zero the Rx/Tx counters for every managed interface.";
                ze:help "One call resets every interface the backend manages, and the answer
reports the scope as all. Nothing else about the interfaces changes.";
            }

            container name {
                config false;
                description "Select one interface by name.";
                ze:help "The keyword takes the interface name, and counters follows it. The
answer reports that name as the scope it cleared.";

                container counters {
                    config false;
                    ze:command "ze-clear:interface-counters";
                    description "Zero the Rx/Tx counters for one interface.";
                    ze:help "Only the named interface is reset. Ze translates the name to
its kernel device first, so a name bound to hardware by a selector clears the right port.";
                    leaf name {
                        type string;
                        mandatory true;
                        description "Interface name";
                    }
                }
            }
        }
    }
}
