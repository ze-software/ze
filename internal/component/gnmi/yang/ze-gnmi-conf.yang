module ze-gnmi-conf {
    namespace "urn:ze:gnmi:conf";
    prefix gnmi;

    import ze-types { prefix zt; }
    import ze-extensions { prefix ze; }

    description "gNMI server configuration for Ze";

    revision 2026-05-28 {
        description "Initial revision";
    }

    container environment {
        description "Environment settings for gNMI server";

        container gnmi {
            description "gNMI (gRPC Network Management Interface) server settings";

            leaf enabled {
                type boolean;
                default false;
                description "Enable gNMI server";
            }

            leaf token {
                type string;
                ze:sensitive;
                description "Bearer token for gNMI authentication. Compared
                             constant-time (sha256 + subtle.ConstantTimeCompare).
                             Empty means no authentication.";
            }

            container tls {
                description "TLS certificate for gNMI gRPC transport";

                leaf cert {
                    type string;
                    description "Path to PEM-encoded certificate file (or chain)";
                }

                leaf key {
                    type string;
                    ze:sensitive;
                    description "Path to PEM-encoded private-key file";
                }
            }

            list server {
                key "name";
                ze:listener;
                description "gNMI server listen endpoints";

                leaf name {
                    type string;
                    description "Server instance name";
                }

                uses zt:listener {
                    refine ip {
                        default "0.0.0.0";
                    }
                    refine port {
                        default 9339;
                    }
                }
            }
        }
    }
}
