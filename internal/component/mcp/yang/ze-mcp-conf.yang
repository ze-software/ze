module ze-mcp-conf {
    namespace "urn:ze:mcp:conf";
    prefix mcp;

    import ze-types { prefix zt; }
    import ze-extensions { prefix ze; }

    description "MCP (Model Context Protocol) server configuration for Ze";

    revision 2026-04-19 {
        description "Add bind-remote, auth-mode, oauth, tls, identity[]. Legacy
                     token leaf preserved; maps to auth-mode=bearer for back-compat.";
    }

    revision 2026-01-01 {
        description "Initial revision";
    }

    container environment {
        description "Environment settings of the MCP server.";
        ze:help "The environment tree holds the settings of the services Ze runs, beside
the routing configuration rather than inside it.";

        container mcp {
            description "Settings of the MCP server.";
            ze:help "MCP is the Model Context Protocol. The Ze MCP server is the interface
an AI assistant uses to read state from Ze and to control it.";

            leaf enabled {
                type boolean;
                default false;
                description "Start the MCP server.";
                ze:help "The default is false, so Ze opens no MCP listener until this leaf
is true.";
            }

            leaf bind-remote {
                type boolean;
                default false;
                description "Allow the MCP server to bind to a non-loopback address.";
                ze:help "The default is false, which keeps the Phase 1 clamp. That clamp
forces every server entry to 127.0.0.1. When this leaf is true, Ze honors the ip the
operator configured, and auth-mode MUST be set to a value other than 'none'. The verify
step rejects a config that does not meet that condition.";
            }

            leaf auth-mode {
                type enumeration {
                    enum none {
                        description "No authentication, permitted on a loopback bind only.";
                    }
                    enum bearer {
                        description "One shared bearer token, read from the token leaf.";
                    }
                    enum bearer-list {
                        description "One bearer token for each entry of the identity list.";
                    }
                    enum oauth {
                        description "OAuth 2.1 resource server.";
                    }
                }
                description "Authentication strategy for the MCP server.";
                ze:help "In oauth mode, Ze validates a token locally against the JWKS of
the configured authorization server. If the token leaf is set and the auth-mode leaf is
absent, Ze infers 'bearer' for backward compatibility. In every other case the default
is 'none'.

bearer is the legacy mode, which reads one shared token from the token leaf. bearer-list
replaces it: each entry of the identity list names one principal and carries its own
token.";
            }

            leaf token {
                type string;
                ze:sensitive;
                description "Bearer token for auth-mode=bearer.";
                ze:help "When this leaf is set and no auth-mode leaf is present, Ze infers
auth-mode 'bearer'. Leave this leaf empty for bearer-list mode and for oauth mode.";
            }

            list identity {
                key "name";
                description "Per-identity bearer entries, for auth-mode=bearer-list.";
                ze:help "The token of each entry grants access to the named principal.
Authentication runs on every request, so the name and the scopes of the matching entry
ride that one authenticated request. A change takes effect on the next request.";

                leaf name {
                    type string;
                    description "Name of the principal this entry authenticates.";
                    ze:help "Ze writes the name to the log, and carries it on each request
the entry authenticates.";
                }

                leaf token {
                    type string;
                    ze:sensitive;
                    description "Bearer token value of this identity.";
                    ze:help "Ze compares the token in constant time, so the duration of a
comparison tells an attacker nothing about the value.";
                }

                leaf-list scope {
                    type string;
                    description "Scopes Ze carries on a request this identity authenticates.";
                    ze:help "This leaf-list is optional. An empty leaf-list carries no
scope.";
                }
            }

            container oauth {
                description "OAuth 2.1 resource-server settings, for auth-mode=oauth.";
                ze:help "Ze does not run an authorization server. Ze validates a bearer
token that the external authorization server issued.";

                leaf authorization-server {
                    type string;
                    description "HTTPS URL of the authorization server.";
                    ze:help "The resource server reads the metadata of the authorization
server from <url>/.well-known/oauth-authorization-server (RFC 8414), and discovers the
jwks_uri there.";
                }

                leaf audience {
                    type string;
                    description "Canonical URL that identifies this MCP endpoint (RFC 8707).";
                    ze:help "Ze rejects a token whose 'aud' claim does not match this URL.
Set this leaf explicitly. Ze never derives the value from the Host header of the
request.";
                }

                leaf-list required-scopes {
                    type string;
                    description "Scopes an accepted token MUST carry.";
                    ze:help "Ze rejects a token that does not carry every scope in this
list. An empty leaf-list accepts any valid token.";
                }
            }

            container tls {
                description "TLS certificate that serves the MCP endpoint over HTTPS.";
                ze:help "This container is required when auth-mode is oauth and a listen
endpoint is not a loopback address. ze config verify rejects a config that leaves the
cert leaf empty in that case, and one that sets cert without key.";

                leaf cert {
                    type string;
                    description "Path to PEM-encoded certificate file (or a chain).";
                }

                leaf key {
                    type string;
                    ze:sensitive;
                    description "Path to PEM-encoded private-key file.";
                }
            }

            list server {
                key "name";
                ze:listener;
                description "Listen endpoints of the MCP server.";
                ze:help "Each entry binds one address and one port. The address defaults
to 127.0.0.1 and the port defaults to 8080. The bind-remote leaf decides whether an
address other than loopback is kept.";

                leaf name {
                    type string;
                    description "Name of this server instance.";
                    ze:help "The name is the list key, and it identifies the entry in the
configuration and in the log.";
                }

                uses zt:listener {
                    refine ip {
                        default "127.0.0.1";
                    }
                    refine port {
                        default 8080;
                    }
                }
            }
        }
    }
}
