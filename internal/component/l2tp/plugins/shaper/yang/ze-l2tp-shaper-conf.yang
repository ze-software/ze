module ze-l2tp-shaper-conf {
    namespace "urn:ze:l2tp:shaper:conf";
    prefix l2tp-shaper;
    import ze-types { prefix zt; }
    import ze-extensions { prefix ze; }

    description
        "Traffic shaping for L2TP subscriber sessions.
         Applies TC (traffic control) rules on pppN interfaces
         when sessions come up. Supports TBF and HTB qdiscs.";

    container l2tp {
        // Repeat the canonical description owned by ze-l2tp-conf.yang verbatim,
        // so the tree merge does not warn on a mismatch. This module only
        // attaches its own subtree to the shared node.
        description "L2TPv2 tunnel subsystem settings (RFC 2661).";

        container shaper {
            description "Traffic shaping applied to each L2TP subscriber interface.";
            ze:help "Ze installs the queueing discipline on the pppN interface when the
                     session starts. A rate changed here reaches the sessions that start
                     after the change. A running session keeps the rate it was given.";
            leaf qdisc-type {
                type enumeration {
                    enum tbf {
                        description "Token Bucket Filter (single rate limiter).";
                    }
                    enum htb {
                        description "Hierarchical Token Bucket (classful).";
                    }
                }
                default tbf;
                description "Queueing discipline type for subscriber interfaces.";
            }
            leaf default-rate {
                type zt:rate;
                mandatory true;
                description "Default download rate applied to a new session.";
                ze:help "Default download rate applied to new sessions. The format is a number followed by a suffix, for
                    example 10mbit or 100kbit.";
            }
            leaf upload-rate {
                type zt:rate;
                description
                    "Default upload rate. When omitted, defaults to default-rate.";
            }
        }
    }
}
