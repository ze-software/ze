module ze-l2tp-auth-radius-conf {
    namespace "urn:ze:l2tp:auth:radius:conf";
    prefix l2tp-auth-radius;
    import ze-extensions { prefix ze; }
    import ze-types { prefix zt; }

    description
        "RADIUS authentication and accounting for L2TP PPP sessions.";

    container l2tp {
        // Repeat the canonical description owned by ze-l2tp-conf.yang verbatim,
        // so the tree merge does not warn on a mismatch. This module only
        // attaches its own subtree to the shared node.
        description "L2TPv2 tunnel subsystem settings (RFC 2661).";

        container auth {
            description "PPP authentication for L2TP subscriber sessions.";

            container radius {
                description "Authenticate and account subscriber sessions against a RADIUS server.";
                ze:help "Authentication and accounting are separate exchanges to the same
                         server. A session is authorized by an Access-Accept, and the
                         Accounting-Request packets that follow report its traffic.";
                leaf source-address {
                    type zt:ipv4-address;
                    description "Source IPv4 address for outbound RADIUS packets.";
                }
                leaf nas-identifier {
                    type string;
                    description "NAS-Identifier sent in RADIUS requests.";
                }
                leaf nas-port-id-format {
                    type string { length "1..253"; }
                    description "Template for the NAS-Port-Id attribute sent in RADIUS requests.";
                    ze:help "Ze sends the NAS-Port-Id attribute (RFC 2869 Section 5.17) in an
Access-Request packet and in an Accounting-Request packet. The placeholders are
{nas-id}, {tunnel-id} and {session-id}. Ze copies every other character. All three
values are known before the session has an interface. One session therefore sends one
text in its Access-Request and in all its accounting records. A billing system can
join them on it. The 253-octet limit is the largest value a RADIUS attribute can carry (RFC 2865
Section 5). The commit refuses an unknown placeholder, it refuses a {nas-id} when
nas-identifier is unset, and it refuses a template whose widest resolution passes 253
octets because the nas-identifier it expands is long. An unset leaf sends no
attribute.";
                }
                leaf timeout {
                    type uint8 { range "1..30"; }
                    default 3;
                    description "Per-request timeout in seconds.";
                }
                leaf retries {
                    type uint8 { range "1..10"; }
                    default 3;
                    description "Number of retransmit attempts per server.";
                }
                leaf acct-interval {
                    type uint16 { range "60..3600"; }
                    description "Accounting interim-update interval in seconds.";
                    ze:help "RFC 2869 Section 2.1 states that a locally configured value on
the NAS MUST override the value found in an Access-Accept. A leaf that is set pins the
cadence of every session, and the Acct-Interim-Interval attribute (type 85) of an
Access-Accept then changes nothing. This leaf has no default. An unset leaf is the
absent case, and it lets each Access-Accept set the cadence of that session. A session
runs at 300 seconds when neither side states an interval.";
                }
                leaf coa-port {
                    type uint16 { range "1..65535"; }
                    description "UDP port of the RADIUS CoA and Disconnect listener, usually 3799.";
                    ze:help "The listener implements RFC 5176. This leaf has no default on
purpose. An unset leaf keeps the listener off, so an existing deployment does not start
to accept CoA on upgrade. Ze accepts a request only from a configured RADIUS server
address.";
                }
                leaf require-message-authenticator {
                    type boolean;
                    default false;
                    description "Discard a CoA-Request or a Disconnect-Request that carries no Message-Authenticator.";
                    ze:help "RFC 5176 Section 3.4 makes the Message-Authenticator attribute
optional, so the default is false. Ze then processes a request without the attribute
once its Request Authenticator verifies against the shared secret. Set this leaf to
true when every Dynamic Authorization Client sends the attribute. The attribute is an
HMAC-MD5 keyed with the shared secret, and it is the mitigation for the Blast-RADIUS
class of attack (CVE-2024-3596), which forges a RADIUS UDP packet with a chosen-prefix
MD5 collision against the authenticator. A client that sends no attribute gets no
answer while this leaf is true.";
                }
                list server {
                    key "name";
                    ordered-by user;
                    description "One RADIUS server Ze sends requests to, tried in the order written.";
                    ze:help "The operator orders the list. Ze tries the first entry, and moves to
                             the next one when that server does not answer. Write the closest
                             server first.";

                    leaf name {
                        type string;
                        description "Logical name for this RADIUS server entry.";
                    }
                    leaf address {
                        type string;
                        mandatory true;
                        description "RADIUS server IP address or hostname.";
                    }
                    leaf port {
                        type uint16 { range "1..65535"; }
                        default 1812;
                        description "RADIUS server UDP port.";
                    }
                    leaf shared-key {
                        type string {
                            length "1..max";
                        }
                        ze:sensitive;
                        description "RADIUS shared secret.";
                        ze:help "RFC 2865 Section 3 states that the secret MUST NOT be
empty, that is length 0, because an empty secret makes a forged packet easy to
build.";
                    }
                }
            }
        }
    }
}
