module ze-l2tp-cmd {
    namespace "urn:ze:l2tp:cmd";
    prefix l2tpcmd;

    import ze-extensions    { prefix ze; }
    import ze-cli-show-cmd  { prefix clishowcmd; }
    import ze-cli-clear-cmd { prefix cliclearcmd; }

    description
        "L2TP tunnel and session operations for BNG subscriber access.
         Adds 'show l2tp' commands for inspection, 'clear l2tp' commands
         for teardown, and 'request l2tp' operator actions.";

    revision 2026-07-10 {
        description "Add 'request l2tp outgoing-call remote <name> called <number>' (spec-followup-l2tp-call AC-4).";
    }

    revision 2026-06-03 {
        description "Relocate show l2tp-health from central show schema (plugin self-containment).";
    }

    revision 2026-04-22 {
        description "Move destructive tree from top-level l2tp to clear verb (spec-l2tp-11-web).";
    }

    revision 2026-04-17 {
        description "Initial revision (spec-l2tp-7-subsystem).";
    }

    // -----------------------------------------------------------------
    // Read tree: `show l2tp ...`
    // -----------------------------------------------------------------
    augment "/clishowcmd:show" {
        container l2tp {
            config false;
            ze:command "ze-l2tp-api:summary";
            description "L2TP tunnel, session, and subscriber state.";
            ze:help "Without a subcommand, shows a summary of tunnels and
sessions.";

            container health {
                config false;
                ze:command "ze-show:l2tp-health";
                description "Find your worst L2TP sessions at a glance.";
                ze:help "Sorts sessions by echo loss ratio (worst first). Shows
subscriber login, session state, echo count, average RTT, and CQM bucket count.
Reports how many sessions are degraded.";
            }

            container tunnels {
                config false;
                ze:command "ze-l2tp-api:tunnels";
                description "List all active L2TP tunnels.";
                ze:help "One line per tunnel: local/remote ID, peer address,
session count, and uptime.";
            }

            container tunnel {
                config false;
                description "Show full detail for one L2TP tunnel.";

                container id {
                    config false;
                    ze:command "ze-l2tp-api:tunnel";
                    description "Show full detail for one L2TP tunnel.";
                    ze:help "Pass the local tunnel ID. Returns control channel
state, peer endpoint, hello interval, and all assigned sessions.";
                    leaf id {
                        type string;
                        mandatory true;
                        description "Local tunnel ID";
                    }
                }

                container history {
                    config false;
                    ze:command "ze-l2tp-api:tunnel-history";
                    description "Show state transitions for a tunnel over time.";
                    ze:help "Timestamped FSM entries showing how the tunnel
reached its current state. Use this to diagnose a tunnel establishment
failure.";
                }
            }

            container sessions {
                config false;
                ze:command "ze-l2tp-api:sessions";
                description "List all active L2TP sessions.";
                ze:help "One line per session: local/remote ID, parent tunnel,
subscriber login, and uptime.";
            }

            container session {
                config false;
                description "Show full detail for one L2TP session.";

                container id {
                    config false;
                    ze:command "ze-l2tp-api:session";
                    description "Show full detail for one L2TP session.";
                    ze:help "Pass the local session ID. Returns PPP state,
assigned addresses, negotiated LCP/NCP options, and traffic counters.";
                    leaf id {
                        type string;
                        mandatory true;
                        description "Local session ID";
                    }
                }

                container history {
                    config false;
                    ze:command "ze-l2tp-api:session-history";
                    description "Show state transitions for a session over time.";
                    ze:help "Timestamped FSM entries for session establishment.
Use this when a subscriber's session fails to come up.";
                }

                container traffic {
                    config false;
                    ze:command "ze-l2tp-api:session-traffic";
                    description "Show traffic counters for a subscriber's PPP interface.";
                    ze:help "Returns byte and packet counts, error counters, and
current rates. Compare with CQM data to get the full picture of subscriber
health.";
                }
            }

            container statistics {
                config false;
                ze:command "ze-l2tp-api:statistics";
                description "Show aggregate L2TP protocol counters.";
                ze:help "Tunnels and sessions established, control messages
sent and received, retransmits, and errors. It is the first command to run for
L2TP health.";
            }

            container listeners {
                config false;
                ze:command "ze-l2tp-api:listeners";
                description "Show which UDP sockets are listening for L2TP.";
                ze:help "Lists each bound address, port, and the number of
tunnels on it.";
            }

            container config {
                config false;
                ze:command "ze-l2tp-api:config";
                description "Show the resolved L2TP configuration.";
                ze:help "Returns the effective config after defaults and
overrides. Confirms what the daemon uses.";
            }

            container observer {
                config false;
                ze:command "ze-l2tp-api:observer";
                description "Show recent events for a session (debug aid).";
                ze:help "Returns the event ring buffer for one session ID or
'all'. Use it to find why a session failed to establish.";
            }

            container cqm {
                config false;
                ze:command "ze-l2tp-api:cqm";
                description "Show subscriber line quality (CQM latency buckets).";
                ze:help "Pass a login name for one subscriber or 'summary' for
an overview. Use it to diagnose a poor subscriber experience.";
            }

            container echo {
                config false;
                ze:command "ze-l2tp-api:echo";
                description "Show LCP echo health for a subscriber session.";
                ze:help "Returns echo request and reply counters and round-trip
times. Rising loss or high RTT indicates a degraded line.";
            }

            container reliable {
                config false;
                ze:command "ze-l2tp-api:reliable";
                description "Show the reliable transport window for a tunnel.";
                ze:help "Returns send and receive sequence numbers, window size,
and retransmit queue depth. Check here when tunnel control messages stop
moving.";
            }
        }
    }

    // -----------------------------------------------------------------
    // Destructive tree: `clear l2tp tunnel {id <id> | all}`, `clear l2tp
    // session {id <id> | all}`. Under `clear` verb because they reset
    // runtime/operational state without touching config.
    // -----------------------------------------------------------------
    augment "/cliclearcmd:clear" {
        container l2tp {
            config false;
            description "Tear down L2TP tunnels and sessions.";

            container tunnel {
                config false;
                description "Tear down L2TP tunnels.";

                container id {
                    config false;
                    ze:command "ze-l2tp-api:tunnel-teardown";
                    description "Gracefully tear down one L2TP tunnel.";
                    ze:help "Sends a StopCCN to the peer. Every session on this
tunnel is disconnected. Pass the local tunnel ID: clear l2tp tunnel id
<id>.";
                }

                container all {
                    config false;
                    ze:command "ze-l2tp-api:tunnel-teardown-all";
                    description "Tear down every L2TP tunnel on this box.";
                    ze:help "Sends StopCCN for all tunnels. Every subscriber
session is disconnected. Use with care during maintenance.";
                }
            }

            container session {
                config false;
                description "Tear down L2TP sessions.";

                container id {
                    config false;
                    ze:command "ze-l2tp-api:session-teardown";
                    description "Disconnect one subscriber session.";
                    ze:help "Sends a CDN to gracefully close the session. Pass
the local session ID: clear l2tp session id <id> [reason <text>] [cause
<code>].";
                }

                container all {
                    config false;
                    ze:command "ze-l2tp-api:session-teardown-all";
                    description "Disconnect every L2TP session on this box.";
                    ze:help "Sends CDN for all sessions across all tunnels. The
tunnels stay up. Use with care.";
                }
            }
        }
    }

    // -----------------------------------------------------------------
    // Operator action tree: `request l2tp outgoing-call remote <name>
    // called <number>`. Under the `request` verb because it performs a
    // runtime operational action (dial-out) without touching config.
    // Two typed selectors (remote, called) nest as a container per
    // keyword, with both leaves on the final ze:command node so each is
    // captured into ctx.Selectors (ai/rules/cli-grammar.md).
    // -----------------------------------------------------------------
    container request {
        config false;

        container l2tp {
            config false;
            description "L2TP operator actions (RFC 2661).";

            container outgoing-call {
                config false;
                description "Place an LNS-side outgoing call toward a remote.";

                container remote {
                    config false;
                    description "Select the configured remote to dial.";

                    container called {
                        config false;
                        ze:command "ze-l2tp-api:outgoing-call";
                        description "Place an LNS-side outgoing call (RFC 2661 S10.4).";
                        ze:help "Dials the named remote (which must have
outgoing-calls enabled), sends OCRQ, and blocks until the call establishes or
fails. On failure the cause and RFC 2661 Result Code are reported (auth reject,
tie-breaker loss, peer CDN, or timeout).";
                        leaf remote {
                            type string;
                            mandatory true;
                            description "Configured l2tp/remote dial-target name";
                        }
                        leaf called {
                            type string;
                            mandatory true;
                            description "Called Number for the OCRQ";
                        }
                    }
                }
            }
        }
    }
}
