module ze-pppoe-conf {
    namespace "urn:ze:pppoe:conf";
    prefix pppoe;

    import ze-extensions { prefix ze; }

    description "PPPoE access concentrator configuration for Ze (RFC 2516).";

    revision 2026-08-12 {
        description "Add auth-method and allow-no-auth: the AC had no way to
                     ask a subscriber to authenticate.";
    }

    revision 2026-05-08 {
        description "Initial revision (spec-bng-5-pppoe).";
    }

    container pppoe {
        description "PPPoE access concentrator settings (RFC 2516).";
        ze:help "This block with any content in it enables the subsystem.
                 Use 'enabled false' to disable it explicitly. Use
                 'enabled true' as a filler when no other settings are
                 needed.";

        leaf enabled {
            type boolean;
            default true;
            description "Enable the PPPoE subsystem.";
            ze:help "The default is true when the pppoe block is present.
                     Set it to false to disable the subsystem.";
        }

        leaf ac-name {
            type string;
            default "ze";
            description "Access Concentrator Name advertised in PADO (RFC 2516 Section 5.2).";
        }

        leaf-list service-name {
            type string;
            description "Accepted Service-Name values (RFC 2516 Section 5.1).";
            ze:help "An empty list accepts any Service-Name. The per-interface
                     service-name list overrides this global list.";
        }

        leaf auth-method {
            type enumeration {
                enum none;
                enum pap;
                enum chap-md5;
                enum ms-chap-v2;
            }
            default "chap-md5";
            description
                "PPP Auth-Protocol method the access concentrator advertises in LCP.";
            ze:help
                "The access concentrator advertises the method in its LCP
                 Configure-Request (RFC 1661 Section 6.2), for every subscriber
                 that completes PPPoE discovery. The auth handler verifies the
                 credential (l2tp-auth-local or l2tp-auth-radius). The default
                 requires CHAP-MD5 (RFC 1994). Set it to none only together
                 with allow-no-auth true.";
        }

        leaf allow-no-auth {
            type boolean;
            default false;
            description
                "Accept a subscriber whose LCP negotiation ends with no Auth-Protocol option.";
            ze:help
                "The default is false. A client that rejects the configured
                 method is then disconnected, and it is never admitted
                 unauthenticated.";
        }

        leaf cookie-timeout {
            type uint16 {
                range "1..300";
            }
            default 5;
            description "AC-Cookie validity duration in seconds. Cookies older
                         than this are rejected in PADR validation.";
        }

        leaf max-sessions {
            type uint16;
            default 65535;
            description "Maximum concurrent PPPoE sessions per interface.";
            ze:help "The 16-bit session ID range limits the count to 1 through
                     65535.";
        }

        leaf padi-rate-limit {
            type uint16 {
                range "1..10000";
            }
            default 100;
            description "Maximum PADI packets accepted per second per source MAC.
                         Excess PADIs are silently discarded.";
        }

        list interface {
            key "name";
            description "Access interfaces on which PPPoE discovery listens.";
            ze:help "Each interface has an independent session ID space.";

            leaf name {
                type string;
                description "Network interface name (e.g. eth0, eth0.100).";
            }

            leaf-list service-name {
                type string;
                description "Per-interface Service-Name filter. Overrides the
                             global service-name list when set.";
            }

            leaf max-sessions {
                type uint16;
                description "Per-interface session limit. Defaults to the global
                             max-sessions when unset.";
            }
        }
    }
}
