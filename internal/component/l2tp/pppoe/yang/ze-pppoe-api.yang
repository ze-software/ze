module ze-pppoe-api {
    namespace "urn:ze:pppoe:api";
    prefix pppoeapi;

    import ze-extensions { prefix ze; }

    description
        "PPPoE API operations for Ze. RPCs for observing session
         state and protocol counters. RFC 2516 supplies the field
         semantics (session ID, discovery tags).";

    revision 2026-05-08 {
        description "Initial PPPoE observability API (spec-bng-5-pppoe).";
    }

    rpc summary {
        description "Return subsystem summary: session count, interface count, aggregate state.";
        ze:help "The three numbers come from one snapshot, and the answer carries the time
that snapshot was taken. The command fails with pppoe: subsystem not running when PPPoE is
not started.";
        output {
            leaf summary {
                type string;
                description "JSON object with aggregate counters.";
            }
        }
    }

    rpc sessions {
        description "List every live PPPoE session across all interfaces.";
        ze:help "One snapshot answers every session. Each row carries the session id, the
client MAC address, the access interface, the service name, the state, the PPP unit and the
creation time.";
        output {
            leaf sessions {
                type string;
                description "JSON array of session objects.";
            }
        }
    }

    rpc session {
        description "Return one session by session ID.";
        ze:help "The state is discovery, session or teardown. Session id 0 is refused
because RFC 2516 reserves it, and an id no session holds is reported as no session with that
sid.";
        input {
            leaf session-id {
                type uint16;
                mandatory true;
                description "PPPoE session ID (1..65535).";
            }
        }
        output {
            leaf session {
                type string;
                description "JSON object with session detail.";
            }
        }
    }

    rpc statistics {
        description "Return protocol counters: active sessions per interface, discovery packet counts.";
        ze:help "The answer is the active session count and one row for each access
interface. Each row carries the interface name, its live session count and its configured
maximum.";
        output {
            leaf statistics {
                type string;
                description "JSON object with counter values.";
            }
        }
    }

    rpc interfaces {
        description "List configured PPPoE access interfaces.";
        ze:help "Each row carries the interface name, its kernel index, its live session
count, its configured maximum and the service names it accepts.";
        output {
            leaf interfaces {
                type string;
                description "JSON array of interface objects.";
            }
        }
    }
}
