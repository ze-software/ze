module ze-l2tp-conf {
    namespace "urn:ze:l2tp:conf";
    prefix l2tp;

    import ze-types { prefix zt; }
    import ze-extensions { prefix ze; }

    description "L2TPv2 (RFC 2661) subsystem configuration for Ze";

    revision 2026-04-15 {
        description "Split config: protocol settings at root l2tp{}, listeners under environment{l2tp{}}.";
    }

    container l2tp {
        description "L2TPv2 tunnel subsystem settings (RFC 2661).
                     Presence of this block with any content implies the
                     subsystem is enabled. Use 'enabled false' to disable
                     explicitly, or 'enabled true' as a filler when no
                     other settings are needed.";

        leaf enabled {
            type boolean;
            default true;
            description "Enable L2TP subsystem. Defaults to true when the
                         l2tp block is present; set to false to disable.";
        }

        leaf max-tunnels {
            type uint16;
            default 1024;
            description
                "Maximum concurrent L2TP tunnels. The default is a
                 finite deployment safety cap. A value of 0 explicitly
                 requests unbounded admission by this knob; the 65535
                 ceiling imposed by RFC 2661's 16-bit Tunnel ID field
                 still applies. New SCCRQs beyond a positive limit are
                 rejected with StopCCN Result Code 2.";
        }

        leaf max-sessions {
            type uint16;
            default 1024;
            description
                "Maximum concurrent sessions per tunnel. The default is
                 a finite deployment safety cap. A value of 0 explicitly
                 requests unbounded admission on each tunnel. New ICRQs
                 and OCRQs beyond a positive limit are rejected with CDN
                 Result Code 4 (no resources).";
        }

        leaf auth-method {
            type enumeration {
                enum none;
                enum pap;
                enum chap-md5;
                enum ms-chap-v2;
            }
            default "chap-md5";
            description
                "PPP Auth-Protocol method first advertised in LCP
                 Configure-Request. The default requires CHAP-MD5. Set
                 to none only together with allow-no-auth true.";
        }

        leaf allow-no-auth {
            type boolean;
            default false;
            description
                "Allow PPP LCP authentication negotiation to proceed
                 without an Auth-Protocol. The default is false, so a
                 peer that rejects all configured authentication methods
                 is disconnected instead of being accepted as no-auth.";
        }

        leaf shared-secret {
            type string;
            ze:sensitive;
            description
                "Shared secret used to compute CHAP-MD5 Challenge
                 Responses (RFC 2661 Section 5.1.1; the AVPs are
                 defined in Section 4.4.3). When unset and a
                 peer sends a Challenge AVP, the subsystem rejects the
                 tunnel with StopCCN Result Code 4 (Not Authorized).
                 Value is masked in CLI output and cleared from the
                 process environment after first read.";
        }

        leaf hello-interval {
            type uint16 {
                range "1..3600";
            }
            description
                "Seconds of peer silence before sending HELLO. RFC 2661
                 recommends 60s; values above 3600 (one hour) are
                 rejected because they effectively disable keepalive.";
        }

        leaf hello-retries {
            type uint8 {
                range "0..255";
            }
            default 2;
            description
                "Dead-peer detection threshold: consecutive unanswered HELLO
                 keepalive intervals tolerated before an established tunnel's
                 peer is declared dead and the tunnel is torn down. Effective
                 detection time is hello-retries x hello-interval, measured
                 from the last proof of peer liveness (a delivered control
                 message or an acknowledgement of one of our messages,
                 including a ZLB ACK of a HELLO). 0 disables dead-peer
                 detection, leaving reliable-transport retransmit exhaustion
                 (~31s) as the only teardown signal. Default 2.";
        }

        leaf cqm-enabled {
            type boolean;
            default false;
            description
                "Enable the CQM (Customer Quality Monitor) observer.
                 When true, pre-allocates per-session event rings and
                 per-login sample rings at subsystem start, and overrides
                 the PPP echo interval to 1s for RTT measurement.";
        }

        leaf max-logins {
            type uint32 {
                range "1..1000000";
            }
            default 1000;
            description
                "Maximum concurrent PPP logins tracked by the CQM observer.
                 Controls the size of the pre-allocated sample ring pool.
                 When exceeded, the least recently used login's data is evicted.";
        }

        leaf event-ring-size-per-session {
            type uint16 {
                range "16..4096";
            }
            default 256;
            description
                "Number of events in each per-session event ring.
                 When full, oldest events are overwritten.";
        }

        leaf sample-retention-seconds {
            type uint32 {
                range "100..86400";
            }
            default 86400;
            description
                "Duration of CQM sample retention per login, in seconds.
                 Divided by the 100-second bucket interval to determine
                 ring capacity. Default 86400 (24 hours) = 864 buckets.";
        }

        container authentication {
            description "PPP authentication phase settings for L2TP sessions.";

            leaf timeout {
                type uint16 {
                    range "1..3600";
                }
                default 30;
                description
                    "PPP auth-phase timeout in seconds. Sessions that do
                     not complete authentication within this window are
                     torn down. Default 30 seconds.";
            }

            leaf reauth-interval {
                type uint32 {
                    range "0 | 5..86400";
                }
                default 0;
                description
                    "Periodic re-authentication interval in seconds
                     (CHAP/MS-CHAPv2 only). Zero disables re-auth.
                     Values 1-4 are rejected to prevent re-auth storms.
                     Default 0 (disabled).";
            }
        }

        container ncp {
            description "NCP (Network Control Protocol) settings for L2TP sessions.";

            leaf enable-ipcp {
                type boolean;
                default true;
                description
                    "Enable the IPCP NCP (RFC 1332) for new L2TP sessions.
                     When false, no IPv4 address is negotiated.";
            }

            leaf enable-ipv6cp {
                type boolean;
                default true;
                description
                    "Enable the IPv6CP NCP (RFC 5072) for new L2TP sessions.
                     When false, no IPv6 interface identifier is negotiated.";
            }

            leaf timeout {
                type uint16 {
                    range "1..3600";
                }
                default 30;
                description
                    "NCP negotiation timeout in seconds. Sessions that do
                     not complete NCP within this window are torn down.
                     Default 30 seconds.";
            }
        }

        list remote {
            key "name";
            description
                "L2TP dial targets: remote LNS/LAC endpoints ze initiates
                 tunnels toward (sends SCCRQ to). Referenced by name from
                 'request l2tp outgoing-call remote <name>' and from PPPoE
                 relay bindings. Declaring a remote grants no dial by itself;
                 an operator action (RPC) or a relay binding drives the dial.";

            leaf name {
                type string {
                    length "1..64";
                }
                description "Operator-assigned remote name (dial-target key).";
            }

            leaf address {
                type zt:ip-address;
                mandatory true;
                description
                    "Remote control-plane IP address to dial. The SCCRQ
                     destination (RFC 2661 Section 6.1).";
            }

            leaf port {
                type uint16 {
                    range "1..65535";
                }
                default 1701;
                description
                    "Remote UDP port for the control channel. RFC 2661
                     assigns 1701; overridable for non-standard peers.";
            }

            leaf shared-secret {
                type string;
                ze:sensitive;
                description
                    "Per-remote CHAP-MD5 tunnel-authentication secret
                     (RFC 2661 Section 5.1.1). Overrides the subsystem-level
                     shared-secret for tunnels dialed to this remote. When
                     empty, this dial carries no Challenge AVP. Masked in CLI
                     output.";
            }

            leaf outgoing-calls {
                type boolean;
                default false;
                description
                    "Permit LNS-side outgoing calls ('request l2tp
                     outgoing-call') toward this remote. Default false: the
                     remote must be explicitly enabled for dial-out before an
                     operator can place a call, so a mistyped remote name is
                     rejected rather than dialed.";
            }
        }

        list relay {
            key "service";
            description
                "PPPoE-to-L2TP relay bindings (LAC role). A subscriber whose
                 PADI/PADR carries a matching PPPoE Service-Name is relayed
                 into an L2TP incoming call toward the named remote instead of
                 terminating PPP locally on this box. Removing a binding
                 restores local termination for that service.";

            leaf service {
                type string {
                    length "0..255";
                }
                description
                    "PPPoE Service-Name to match. The empty string matches a
                     subscriber that requests no specific service.";
            }

            leaf remote {
                type string {
                    length "1..64";
                }
                mandatory true;
                description
                    "Name of the L2TP remote (dial target) that matching
                     subscribers are relayed to. MUST reference a remote
                     declared under l2tp/remote; an unknown name is rejected
                     at config validation.";
            }
        }
    }

    container environment {
        description "Environment settings for L2TP subsystem";

        container l2tp {
            description "L2TP listener endpoints";

            list server {
                key "name";
                ze:listener;
                description "L2TP server listen endpoints (UDP)";

                leaf name {
                    type string;
                    description "Server instance name";
                }

                uses zt:listener {
                    refine ip {
                        default "0.0.0.0";
                    }
                    refine port {
                        default 1701;
                    }
                }
            }
        }
    }
}
