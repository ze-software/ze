module ze-l2tp-api {
    namespace "urn:ze:l2tp:api";
    prefix l2tpapi;

    import ze-extensions { prefix ze; }

    description
        "L2TP API operations for Ze. RPCs for observing tunnel and
         session state, bound listeners, effective configuration, and
         for operator-initiated teardown. RFC 2661 supplies the
         field semantics (tunnel/session state, AVP values).";

    revision 2026-04-17 {
        description "Initial L2TP observability + teardown API (spec-l2tp-7).";
    }

    // -----------------------------------------------------------------
    // Read operations (show l2tp ...). Every output value is a string
    // carrying the JSON payload; the CLI handler renders it directly.
    // -----------------------------------------------------------------

    rpc summary {
        description "Return subsystem summary: tunnel count, session count, listener count, aggregate state.";
        ze:help "The payload carries tunnel-count, session-count, listener-count, and
captured-at, which is the UTC time of the snapshot. When the L2TP subsystem is
not running, the RPC answers an error rather than a row of zeros.";
        output {
            leaf summary {
                type string;
                description "JSON object with aggregate counters.";
            }
        }
    }

    rpc tunnels {
        description "List every live tunnel.";
        ze:help "Each row is the summary form of one tunnel, and the 'tunnel' RPC returns the
detail form. Every row comes from one snapshot, so the whole table was read at
the same instant.";
        output {
            leaf tunnels {
                type string;
                description "JSON array of tunnel summary objects.";
            }
        }
    }

    rpc tunnel {
        description "Return one tunnel by local tunnel ID.";
        ze:help "The ID reaches the handler as the 'id' selector or as a bare argument, and both
forms parse the same way. The answer is the detail form of the tunnel rather
than the summary form 'tunnels' returns. An unknown ID is refused with 'no
tunnel with local-tid'.";
        input {
            leaf tunnel-id {
                type uint16;
                mandatory true;
                description "Local tunnel ID (1..65535).";
            }
        }
        output {
            leaf tunnel {
                type string;
                description "JSON object with tunnel detail.";
            }
        }
    }

    rpc sessions {
        description "List every live session across all tunnels.";
        ze:help "The rows are flattened across every tunnel, so a session's own tunnel is read
from the row and not from where the row sits. Each row is the summary form, and
the 'session' RPC returns the detail form.";
        output {
            leaf sessions {
                type string;
                description "JSON array of session summary objects.";
            }
        }
    }

    rpc session {
        description "Return one session by local session ID.";
        ze:help "The ID reaches the handler as the 'id' selector or as a bare argument. The
answer is the detail form of the session. An unknown ID is refused with 'no
session with local-sid'.";
        input {
            leaf session-id {
                type uint16;
                mandatory true;
                description "Local session ID (1..65535).";
            }
        }
        output {
            leaf session {
                type string;
                description "JSON object with session detail.";
            }
        }
    }

    rpc statistics {
        description "Return the L2TP protocol counters.";
        ze:help "The payload carries tunnels-active and sessions-active. Per-message counters are
not published here yet. Use 'listeners' for the bind state of each UDP endpoint.";
        output {
            leaf statistics {
                type string;
                description "JSON object with counter values.";
            }
        }
    }

    rpc listeners {
        description "List bound UDP listener endpoints.";
        ze:help "Each row carries the bound address and the UDP port. An empty array means that
no listener is bound, which is the state 'summary' reports as a listener-count
of 0.";
        output {
            leaf listeners {
                type string;
                description "JSON array of listener objects.";
            }
        }
    }

    rpc config {
        description "Return effective runtime configuration.";
        ze:help "Shared-secret is redacted to <set>/<unset>.";
        output {
            leaf config {
                type string;
                description "JSON object with effective config.";
            }
        }
    }

    // -----------------------------------------------------------------
    // Diagnostic operations (spec-diag-1-runtime-state).
    // -----------------------------------------------------------------

    rpc observer {
        description "Return per-session event ring snapshot.";
        ze:help "With a session-id argument, returns the full event list. With
'all', returns a summary of every active session ring.";
        input {
            leaf session-id {
                type uint16;
                description "Local session ID (1..65535), or omit for 'all'.";
            }
        }
        output {
            leaf observer {
                type string;
                description "JSON array of events or session summaries.";
            }
        }
    }

    rpc cqm {
        description "Return per-login CQM bucket history.";
        ze:help "With a login argument, returns the bucket list. With 'summary',
returns aggregate state across all tracked logins.";
        input {
            leaf login {
                type string;
                description "Login name, or 'summary' for aggregate view.";
            }
        }
        output {
            leaf cqm {
                type string;
                description "JSON array of CQM buckets or login summaries.";
            }
        }
    }

    rpc echo {
        description "Return the current echo state of one login.";
        ze:help "The state is derived from the CQM buckets and carries the last
RTT, the loss ratio, the echo interval, and the bucket state.";
        input {
            leaf login {
                type string;
                mandatory true;
                description "Login name.";
            }
        }
        output {
            leaf echo {
                type string;
                description "JSON object with echo state.";
            }
        }
    }

    rpc reliable {
        description "Return the reliable transport window state of one tunnel.";
        ze:help "The state carries Ns, Nr, peer-Nr, the outstanding count, the
retransmit count, cwnd, ssthresh, and the peer receive window size.";
        input {
            leaf tunnel-id {
                type uint16;
                mandatory true;
                description "Local tunnel ID (1..65535).";
            }
        }
        output {
            leaf reliable {
                type string;
                description "JSON object with reliable transport state.";
            }
        }
    }

    rpc tunnel-history {
        description
            "Return FSM transition history for a tunnel.";
        ze:help "Each transition carries the state it left, the state it reached, and a UTC
timestamp. A tunnel the subsystem holds no history for is refused with 'no
tunnel with local-tid'.";
        input {
            leaf tunnel-id {
                type uint16;
                mandatory true;
                description "Local tunnel ID (1..65535).";
            }
        }
        output {
            leaf history {
                type string;
                description "JSON array of FSM transitions.";
            }
        }
    }

    rpc session-history {
        description
            "Return FSM transition history for a session.";
        ze:help "Each transition carries the state it left, the state it reached, and a UTC
timestamp. A session the subsystem holds no history for is refused with 'no
session with local-sid'.";
        input {
            leaf session-id {
                type uint16;
                mandatory true;
                description "Local session ID (1..65535).";
            }
        }
        output {
            leaf history {
                type string;
                description "JSON array of FSM transitions.";
            }
        }
    }

    // -----------------------------------------------------------------
    // Destructive operations. All send either StopCCN (tunnel) or CDN
    // (session) with administrative Result Code and return a status
    // message.
    // -----------------------------------------------------------------

    rpc tunnel-teardown {
        description "Send StopCCN Result Code 6 (administrative) for the tunnel with the given local tunnel ID.";
        ze:help "The answer carries the tunnel ID and a status of 'sent', which reports that the
message left Ze and not that the peer answered. Use 'session-teardown' to stop
one session and leave the tunnel up.";
        input {
            leaf tunnel-id {
                type uint16;
                mandatory true;
                description "Local tunnel ID (1..65535).";
            }
        }
        output {
            leaf result {
                type string;
                description "JSON object describing the teardown outcome.";
            }
        }
    }

    rpc tunnel-teardown-all {
        description "Send StopCCN Result Code 6 (administrative) for every live tunnel on every listener.";
        ze:help "The answer carries 'tunnels-cleared', the number of tunnels the subsystem tore
down. The RPC takes no input, so one named tunnel needs 'tunnel-teardown' with
its local tunnel ID.";
        output {
            leaf result {
                type string;
                description "JSON object with the number of tunnels torn down.";
            }
        }
    }

    rpc session-teardown {
        description "Send CDN Result Code 3 (administrative) for the session with the given local session ID.";
        ze:help "The answer carries the session ID and a status of 'sent', which reports that the
message left Ze and not that the peer answered. Optional actor, reason and cause
keywords are recorded against the session before the CDN goes out, and they are
echoed in the answer. The tunnel stays up.";
        input {
            leaf session-id {
                type uint16;
                mandatory true;
                description "Local session ID (1..65535).";
            }
        }
        output {
            leaf result {
                type string;
                description "JSON object describing the teardown outcome.";
            }
        }
    }

    rpc session-teardown-all {
        description "Stop every live session on every tunnel on every listener.";
        ze:help "The RPC sends CDN Result Code 3 (administrative) for each
session. The tunnels stay open.";
        output {
            leaf result {
                type string;
                description "JSON object with the number of sessions torn down.";
            }
        }
    }

    // -----------------------------------------------------------------
    // Operator-initiated calls (spec-followup-l2tp-call AC-4).
    // -----------------------------------------------------------------

    rpc outgoing-call {
        description "Place an LNS-side outgoing call toward a configured remote (RFC 2661 Section 10.4).";
        ze:help "Dials the remote if no tunnel is up, sends OCRQ, and blocks
until the call establishes or fails. The response reports whether the call came
up and, on failure, the cause and RFC 2661 Result Code (tunnel authentication
reject, tie-breaker loss, peer CDN, or timeout). The named remote MUST have
outgoing-calls enabled.";
        input {
            leaf remote {
                type string;
                mandatory true;
                description "Name of a configured l2tp/remote dial target.";
            }
            leaf called {
                type string;
                mandatory true;
                description "Called Number placed in the OCRQ (RFC 2661 Section 7.9).";
            }
        }
        output {
            leaf result {
                type string;
                description "JSON object describing the call outcome.";
            }
        }
    }
}
