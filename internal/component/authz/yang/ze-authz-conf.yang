module ze-authz-conf {
    namespace "urn:ze:authz:conf";
    prefix authz;

    import ze-extensions { prefix ze; }

    description "Authentication and authorization configuration for Ze";

    revision 2026-01-01 {
        description "Initial revision";
    }

    container system {
        description "System-level settings";

        container authentication {
            description "System authentication settings";

            list user {
                key "name";
                description "Authenticated user (local)";

                leaf name {
                    type string;
                    description "Username";
                }

                leaf password {
                    type string;
                    ze:bcrypt;
                    description "Bcrypt-hashed password, in canonical form.";
                    ze:help "The canonical form carries a cost prefix, for
                             example $2a$10$ before the salt and the digest.
                             Write the plaintext password to plaintext-password.
                             On commit, ze hashes that value into this leaf and
                             then discards the plaintext.";
                }

                leaf plaintext-password {
                    type string;
                    ze:ephemeral;
                    ze:sensitive;
                    description "Write-only plaintext password.";
                    ze:help "On commit, the config system hashes this value with
                             bcrypt into the canonical password leaf, and it
                             removes this leaf from the tree. Ze never writes the
                             value to the config file. A display path renders the
                             secret placeholder in its place.";
                }

                leaf-list profile {
                    type string;
                    description "Authorization profile name(s) assigned to this user";
                }
            }
        }

        container authorization {
            description "Profile-based command authorization";

            list profile {
                key "name";
                description "Named authorization profile with run and edit sections";

                leaf name {
                    type string;
                    description "Profile identifier";
                }

                container run {
                    description "Operational command authorization (read-only commands)";

                    leaf default-action {
                        type enumeration {
                            enum allow;
                            enum deny;
                        }
                        description "Action when no entry matches";
                    }

                    list entry {
                        key "number";
                        description "Ordered authorization entry";

                        leaf number {
                            type uint32;
                            description "Sequence number (auto-assigned)";
                        }

                        leaf action {
                            type enumeration {
                                enum allow;
                                enum deny;
                            }
                            description "Authorization action";
                        }

                        leaf match {
                            type string;
                            description "Command path prefix or regex pattern";
                        }

                        leaf regex {
                            type boolean;
                            description "If true, match is a regular expression";
                        }
                    }
                }

                container edit {
                    description "Configuration command authorization (write commands)";

                    leaf default-action {
                        type enumeration {
                            enum allow;
                            enum deny;
                        }
                        description "Action when no entry matches";
                    }

                    list entry {
                        key "number";
                        description "Ordered authorization entry";

                        leaf number {
                            type uint32;
                            description "Sequence number (auto-assigned)";
                        }

                        leaf action {
                            type enumeration {
                                enum allow;
                                enum deny;
                            }
                            description "Authorization action";
                        }

                        leaf match {
                            type string;
                            description "Command path prefix or regex pattern";
                        }

                        leaf regex {
                            type boolean;
                            description "If true, match is a regular expression";
                        }
                    }
                }
            }
        }
    }
}
