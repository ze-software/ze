module ze-authz-conf {
    namespace "urn:ze:authz:conf";
    prefix authz;

    import ze-extensions { prefix ze; }

    description "Authentication and authorization configuration for Ze";

    revision 2026-01-01 {
        description "Initial revision";
    }

    container system {
        description "System-level settings";

        container authentication {
            description "System authentication settings";

            list user {
                key "name";
                description "Authenticated user (local)";

                leaf name {
                    type string;
                    description "Username";
                }

                leaf password {
                    type string;
                    ze:bcrypt;
                    description "Bcrypt-hashed password (canonical form, e.g. $2a$10$...).
                                 Write plaintext via plaintext-password -- it is hashed
                                 into this leaf on commit and then discarded.";
                }

                leaf plaintext-password {
                    type string;
                    ze:ephemeral;
                    ze:sensitive;
                    description "Write-only plaintext password. On commit, the config
                                 system bcrypt-hashes this value into the canonical
                                 password leaf and removes this one from the tree.
                                 The value is never written to the config file, and
                                 a display path renders the secret placeholder for
                                 it.";
                }

                leaf-list profile {
                    type string;
                    description "Authorization profile name(s) assigned to this user";
                }
            }
        }

        container authorization {
            description "Profile-based command authorization";

            list profile {
                key "name";
                description "Named authorization profile with run and edit sections";

                leaf name {
                    type string;
                    description "Profile identifier";
                }

                container run {
                    description "Operational command authorization (read-only commands)";

                    leaf default-action {
                        type enumeration {
                            enum allow;
                            enum deny;
                        }
                        description "Action when no entry matches";
                    }

                    list entry {
                        key "number";
                        description "Ordered authorization entry";

                        leaf number {
                            type uint32;
                            description "Sequence number (auto-assigned)";
                        }

                        leaf action {
                            type enumeration {
                                enum allow;
                                enum deny;
                            }
                            description "Authorization action";
                        }

                        leaf match {
                            type string;
                            description "Command path prefix or regex pattern";
                        }

                        leaf regex {
                            type boolean;
                            description "If true, match is a regular expression";
                        }
                    }
                }

                container edit {
                    description "Configuration command authorization (write commands)";

                    leaf default-action {
                        type enumeration {
                            enum allow;
                            enum deny;
                        }
                        description "Action when no entry matches";
                    }

                    list entry {
                        key "number";
                        description "Ordered authorization entry";

                        leaf number {
                            type uint32;
                            description "Sequence number (auto-assigned)";
                        }

                        leaf action {
                            type enumeration {
                                enum allow;
                                enum deny;
                            }
                            description "Authorization action";
                        }

                        leaf match {
                            type string;
                            description "Command path prefix or regex pattern";
                        }

                        leaf regex {
                            type boolean;
                            description "If true, match is a regular expression";
                        }
                    }
                }
            }
        }
    }
}
