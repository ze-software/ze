module ze-mtu-conf {
    namespace "urn:ze:mtu:conf";
    prefix mtu;
    import ze-types { prefix zt; }
    import ze-extensions { prefix ze; }
    // The reference address lives beside the other service settings under
    // environment, and this module container-merges onto that root.
    description "The settings of the path MTU diagnostic: the reference address show mtu measures.";
    revision 2026-09-16 { description "Declare environment mtu reference-address."; }

    container environment {
        description "The environment tree holds the settings of the services Ze runs, beside
the routing configuration rather than inside it.";
        ze:help "Environment settings of the path MTU diagnostic.";

        container mtu {
            description "The settings of show mtu. The command is operator-invoked and never
scheduled, so nothing here starts a measurement.";
            ze:help "Settings of the path MTU diagnostic.";

            leaf reference-address {
                type zt:ip-address;
                default "1.1.1.1";
                description "show mtu measures the path MTU to this address beside the peers. A
reference outside the tunnels is what tells a clamped access circuit from a
clamped peer path: when it measures the full interface MTU the circuit is not
clamped, and when it measures the same as the peers the whole circuit is. The
default is 1.1.1.1. The environment variable ze.mtu.reference-address
overrides this leaf.";
                ze:help "Address show mtu measures to tell a clamped circuit from a clamped peer path.";
            }
        }
    }
}
