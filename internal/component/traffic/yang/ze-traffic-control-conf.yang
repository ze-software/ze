module ze-traffic-control-conf {
    namespace "urn:ze:traffic:conf";
    prefix tc;

    import ze-extensions { prefix ze; }

    description "Traffic subsystem configuration for Ze.
                 Owns the top-level `traffic` container. The `control`
                 subtree configures queueing disciplines, classes, and
                 filters per network interface. Sibling subtrees (e.g.
                 `usage`, contributed by the traffic-usage plugin) augment
                 the same `traffic` parent.";

    revision 2026-07-02 {
        description "Nest traffic-control under traffic/control; the container
                     now owns the shared traffic parent that traffic-usage
                     augments.";
    }
    revision 2026-04-13 {
        description "Initial revision";
    }

    typedef qdisc-type {
        type enumeration {
            enum htb { description "The Hierarchical Token Bucket qdisc."; }
            enum hfsc { description "The Hierarchical Fair Service Curve qdisc."; }
            enum fq { description "The Fair Queue qdisc."; }
            enum fq_codel { description "The Fair Queue Controlled Delay qdisc."; }
            enum sfq { description "The Stochastic Fair Queue qdisc."; }
            enum tbf { description "The Token Bucket Filter qdisc."; }
            enum netem { description "The Network Emulator qdisc."; }
            enum prio { description "The Priority qdisc."; }
        }
        description "Queueing discipline type. The clsact and ingress hooks are
                     not offered: they attach at the ingress hook rather than at
                     the root, they carry no classes, and the mirror and the
                     sampling paths own that hook already. Ze still names them
                     when it reads an interface that carries one.";
    }

    typedef rate-bps {
        type string {
            pattern '[0-9]+(mbit|kbit|gbit|bit|mbps|kbps|gbps|bps)';
        }
        description "Rate in bits or bytes per second (e.g., 10mbit, 100kbps)";
    }

    typedef filter-type {
        type enumeration {
            enum mark { description "Match the packet mark, with the tc fw filter."; }
            enum dscp { description "Match the DSCP value of the packet."; }
            enum protocol { description "Match the protocol of the packet."; }
        }
        description "Traffic filter match type";
    }

    container traffic {
        description "Traffic subsystem: QoS control and byte-usage accounting.";
        ze:help "Two subtrees sit under it, and they are independent. control programs the
queueing disciplines of each interface, which decides which packet leaves first. usage
counts bytes with an eBPF program, and it changes no packet. Each subtree comes from its
own plugin, so removing one plugin removes that subtree alone.";

        container control {
            description "Traffic control configuration of each interface.";
            ze:help "One entry exists for each interface Ze programs. The backend leaf
names the program that applies the entries.";

            leaf backend {
                type string;
                default "tc";
                description "Traffic control backend that programs the queueing disciplines.";
                ze:help "The default backend is tc, the queueing disciplines of Linux iproute2.
Another backend declares itself through traffic.RegisterBackend. The ze:backend YANG
extension on a feature node declares which backend supports that feature. The
commit-time gate reads that extension and rejects a config that names a qdisc or a
filter type the backend does not support.";
            }

            list interface {
                key "name";
                description "Traffic control of one named interface.";
                ze:help "The list key is the interface name.";

                leaf name {
                    type string;
                    description "Name of the interface this entry controls.";
                    ze:help "The interface MUST exist in the interface configuration.";
                }

                container qdisc {
                    description "The root queueing discipline of the interface.";
                    ze:help "Ze attaches this qdisc at the root of the interface, and every
class hangs beneath it.";

                    leaf type {
                        type qdisc-type;
                        mandatory true;
                        description "Type of the queueing discipline.";
                        ze:help "The commit-time gate rejects a type the configured backend
does not support.";
                    }

                    leaf default-class {
                        type string;
                        description "Name of the class that takes the unclassified traffic.";
                        ze:help "The value is the name of a class in the class list of this
qdisc.";
                    }

                    list class {
                        key "name";
                        description "One traffic class of the queueing discipline.";
                        ze:help "The list key is the class name. A class carries a rate, a
ceil, a priority, and the filters that select its traffic.";

                        leaf name {
                            type string {
                                length "1..255";
                            }
                            description "Name of this class.";
                            ze:help "The name is the list key, and the default-class leaf
of the qdisc names one of them.";
                        }

                        leaf rate {
                            type rate-bps;
                            mandatory true;
                            description "Rate this class is guaranteed.";
                            ze:help "The value is a number and a unit, for example 10mbit
or 100kbps.";
                        }

                        leaf ceil {
                            type rate-bps;
                            description "Largest rate this class can reach.";
                            ze:help "An absent leaf takes the value of the rate leaf.";
                        }

                        leaf priority {
                            type uint8;
                            description "Scheduling priority of this class.";
                            ze:help "The value 0 is the highest priority.";
                        }

                        list match {
                            key "type";
                            description "A filter that classifies a packet into this class.";
                            ze:help "The list key is the match type, so one class carries at
most one match of each type.";

                            leaf type {
                                type filter-type;
                                description "Type of the match.";
                                ze:help "The commit-time gate rejects a filter type the
configured backend does not support.";
                            }

                            leaf value {
                                type string;
                                mandatory true;
                                description "Value the filter matches.";
                                ze:help "A mark filter takes a hex value. A dscp filter
takes a DSCP name. A protocol filter takes a protocol name.";
                            }
                        }
                    }
                }
            }
        }
    }
}
