module ze-ipsec-conf {
    namespace "urn:ze:ipsec:conf";
    prefix ipsec;

    import ze-extensions { prefix ze; }

    description "IPsec VPN configuration for Ze (spec-ipsec-3).";

    revision 2026-05-20 {
        description "Initial IPsec data model: ESP/IKE groups, site-to-site peers.";
    }

    typedef encryption-algo {
        type enumeration {
            enum aes128 { description "AES-CBC-128 (RFC 3602)"; }
            enum aes256 { description "AES-CBC-256 (RFC 3602)"; }
            enum aes128gcm { description "AES-GCM-128, 16-byte ICV (RFC 4106)"; }
            enum aes256gcm { description "AES-GCM-256, 16-byte ICV (RFC 4106)"; }
            enum chacha20poly1305 {
                description "ChaCha20-Poly1305 AEAD (RFC 7634). No build carries a
                    transform for it, so a proposal that names it is refused at commit.
                    The refusal lists the algorithms the build does implement.";
            }
            enum 3des {
                description "Triple-DES-CBC (RFC 2451), deprecated. No build carries a
                    transform for it, so a proposal that names it is refused at commit.
                    The refusal lists the algorithms the build does implement.";
            }
        }
    }

    typedef hash-algo {
        type enumeration {
            enum sha1 {
                description "HMAC-SHA-1-96 (RFC 2404). No build carries a transform for
                    it, so a proposal that names it is refused at commit. The refusal
                    lists the algorithms the build does implement.";
            }
            enum sha256 { description "HMAC-SHA-256-128 (RFC 4868)"; }
            enum sha384 { description "HMAC-SHA-384-192 (RFC 4868)"; }
            enum sha512 { description "HMAC-SHA-512-256 (RFC 4868)"; }
        }
    }

    container vpn {
        description "VPN subsystems.";

        container ipsec {
            description "IPsec site-to-site VPN configuration.";

            leaf interface {
                type string;
                description "WAN interface for IPsec traffic.";
            }

            leaf cookie-threshold {
                type uint32;
                default 0;
                description
                    "Number of half-open IKE SAs tolerated before an inbound
                     IKE_SA_INIT must answer a COOKIE challenge. RFC 7296
                     Section 2.6 makes the challenge the answer to state and CPU
                     exhaustion from forged source addresses. The default of 0
                     challenges every inbound initiation, which costs one extra
                     round trip and stops a single spoofed datagram taking a
                     peer's only half-open handshake slot. Raise it to tolerate
                     that many half-open handshakes before challenging.";
            }

            list esp-group {
                key "name";
                description "ESP (Encapsulating Security Payload) group.";

                leaf name {
                    type string;
                    description "ESP group name.";
                }

                leaf lifetime {
                    type uint32 {
                        range "0..86400";
                    }
                    default 3600;
                    description "SA lifetime in seconds. 0 disables expiry.";
                }

                leaf pfs {
                    type enumeration {
                        enum enable;
                        enum disable;
                    }
                    default "enable";
                    description "Perfect Forward Secrecy for Child SA rekeying.";
                }

                list proposal {
                    key "number";
                    max-elements 255;
                    description "ESP proposal. Lower number = higher priority. One group
                        offers at most 255 proposals, because RFC 7296 Section 3.3.1
                        numbers them in one octet.";

                    leaf number {
                        type uint16 {
                            range "1..65535";
                        }
                        description "Proposal priority number.";
                    }

                    leaf encryption {
                        type encryption-algo;
                        mandatory true;
                        description "Encryption algorithm.";
                    }

                    leaf hash {
                        type hash-algo;
                        description "Integrity algorithm. It is required beside a
                            non-AEAD cipher, and refused beside an AEAD cipher. RFC 7296
                            Section 3.3 gives an AEAD cipher its own integrity, so an ESP
                            proposal offers the integrity transform NONE. An ESP proposal
                            carries no PRF transform, so this leaf never names one.";
                    }
                }
            }

            list ike-group {
                key "name";
                description "IKE (Internet Key Exchange) group.";

                leaf name {
                    type string;
                    description "IKE group name.";
                }

                leaf key-exchange {
                    type enumeration {
                        enum ikev1;
                        enum ikev2;
                    }
                    default "ikev2";
                    description "IKE protocol version.";
                }

                leaf lifetime {
                    type uint32 {
                        range "0..86400";
                    }
                    default 28800;
                    description "IKE SA lifetime in seconds. 0 disables reauth.";
                }

                leaf close-action {
                    type enumeration {
                        enum none;
                        enum start;
                        enum restart;
                    }
                    default "none";
                    description "Action when peer closes the IKE SA.";
                }

                container dead-peer-detection {
                    description "Dead Peer Detection (DPD) settings (RFC 3706).";

                    leaf action {
                        type enumeration {
                            enum restart;
                            enum hold;
                            enum clear;
                        }
                        default "hold";
                        description "Action when DPD detects a dead peer.";
                    }

                    leaf interval {
                        type uint16 {
                            range "1..3600";
                        }
                        default 30;
                        description "DPD probe interval in seconds.";
                    }

                    leaf timeout {
                        type uint16 {
                            range "1..3600";
                        }
                        default 120;
                        description "DPD timeout in seconds before declaring peer dead.";
                    }
                }

                list proposal {
                    key "number";
                    max-elements 255;
                    description "IKE proposal. Lower number = higher priority. One group
                        offers at most 255 proposals, because RFC 7296 Section 3.3.1
                        numbers them in one octet.";

                    leaf number {
                        type uint16 {
                            range "1..65535";
                        }
                        description "Proposal priority number.";
                    }

                    leaf encryption {
                        type encryption-algo;
                        mandatory true;
                        description "Encryption algorithm.";
                    }

                    leaf hash {
                        type hash-algo;
                        mandatory true;
                        description "PRF and integrity algorithm. It is required beside
                            every cipher, and an AEAD cipher is no exception. RFC 7296
                            Section 3.3.3 makes the PRF a mandatory transform for an IKE
                            proposal, and this leaf names it. An ESP proposal reads the
                            same leaf as integrity alone, and refuses it beside an AEAD
                            cipher.";
                    }

                    leaf dh-group {
                        type uint8 {
                            range "1..31";
                        }
                        mandatory true;
                        description "Diffie-Hellman group number (RFC 7296 Section 3.3.2).";
                    }
                }
            }

            container remote-access {
                description "Remote access VPN for road warrior clients (EAP).";

                leaf ike-group {
                    type string;
                    mandatory true;
                    description "Reference to an IKE group name.";
                }

                leaf esp-group {
                    type string;
                    mandatory true;
                    description "Reference to an ESP group name.";
                }

                container authentication {
                    description "EAP authentication settings for remote access.";

                    leaf mode {
                        type enumeration {
                            enum eap-tls;
                            enum eap-mschapv2;
                        }
                        mandatory true;
                        description "EAP authentication method.";
                    }

                    container x509 {
                        description "Server certificate references for EAP. Ze parses
                            both leaves and no component reads them today, so neither
                            takes effect. Ze also leaves both unchecked, so a name that
                            no PKI store entry carries still commits here. The enforced
                            leaves of these names are the site-to-site peer ones.";

                        leaf ca-certificate {
                            type string;
                            description "Name of the CA certificate in the PKI store.
                                It has no effect today.";
                        }

                        leaf certificate {
                            type string;
                            description "Name of the server certificate in the PKI store.
                                It has no effect today.";
                        }
                    }
                }

                list pool {
                    key "name";
                    description "Virtual IP pool for client address assignment (IKEv2 Configuration Payload, RFC 7296 Section 2.19).";

                    leaf name {
                        type string;
                        description "Pool name.";
                    }

                    leaf range {
                        type string;
                        description "IPv4 CIDR for client addresses (e.g. 10.10.0.0/24). Prefix length /8-/30.";
                    }

                    leaf range6 {
                        type string;
                        description "IPv6 CIDR for client addresses (e.g. fd00::/64). Prefix length /48-/126.";
                    }

                    leaf dns {
                        type string;
                        description "DNS server pushed to clients via IKEv2 Configuration Payload.";
                    }

                    leaf domain {
                        type string;
                        description "Search domain pushed to clients.";
                    }
                }

                list eap-user {
                    key "name";
                    description "EAP user entry for remote access authentication.";

                    leaf name {
                        type string;
                        description "Username.";
                    }

                    leaf password {
                        type string;
                        ze:sensitive;
                        description "User password ($9$-encoded). Required for eap-mschapv2.";
                    }

                    leaf certificate {
                        type string;
                        description "Client certificate name in PKI store. Required for eap-tls.";
                    }
                }
            }

            container site-to-site {
                description "Site-to-site VPN peers.";

                list peer {
                    key "name";
                    description "Remote VPN peer.";

                    leaf name {
                        type string;
                        description "Peer name (used as connection identifier).";
                    }

                    leaf ike-group {
                        type string;
                        mandatory true;
                        description "Reference to an IKE group name.";
                    }

                    leaf esp-group {
                        type string;
                        mandatory true;
                        description "Reference to an ESP group name.";
                    }

                    leaf connection-type {
                        type enumeration {
                            enum initiate;
                            enum respond;
                        }
                        default "initiate";
                        description "Whether to initiate or wait for the remote peer.";
                    }

                    leaf local-address {
                        type string;
                        description "Local endpoint address or interface name.";
                    }

                    leaf remote-address {
                        type string;
                        description "Remote endpoint address or DNS hostname.";
                    }

                    container authentication {
                        description "Peer authentication settings.";

                        leaf mode {
                            type enumeration {
                                enum pre-shared-secret;
                                enum x509;
                                enum eap-tls;
                                enum eap-mschapv2;
                            }
                            mandatory true;
                            description "Authentication mode.";
                        }

                        leaf pre-shared-secret {
                            type string;
                            ze:sensitive;
                            description "Pre-shared key ($9$-encoded).";
                        }

                        leaf local-id {
                            type string;
                            description "Local identity for IKE negotiation.";
                        }

                        leaf remote-id {
                            type string;
                            description "Identity the remote endpoint must assert. When it is set,
                                Ze refuses an IKE_AUTH whose ID payload names another identity.
                                Comparable types are ID_IPV4_ADDR, ID_IPV6_ADDR, ID_FQDN,
                                ID_RFC822_ADDR, and ID_KEY_ID. An address value accepts the two
                                address types alone, and a distinguished name is refused at commit.
                                When it is empty Ze checks no identity, so every certificate the
                                ca-certificate issued authenticates as this peer. Set it whenever
                                that authority issues to more than one client.";
                        }

                        leaf ca-certificate {
                            type string;
                            description "Name of the CA certificate in the PKI store. Required for
                                every EAP mode and for X.509. It is the trust anchor the remote
                                certificate must chain to, through any intermediate certificates the
                                peer sends. Without it any self-signed certificate would
                                authenticate. The remote certificate must also carry the remote-id
                                identity in a subject alternative name. Ze reads the subject common
                                name only when the certificate has no such extension.";
                        }

                        leaf certificate {
                            type string;
                            description "Name of the device certificate in the PKI store. Required for
                                every EAP mode, because RFC 7296 Section 2.16 makes the responder sign
                                its AUTH with a public key. Also used by X.509 mode. Ze sends this
                                certificate first, then the intermediate certificate the PKI entry
                                carries.";
                        }

                        container x509 {
                            description "X.509 certificate references (deprecated, use
                                the direct leaves). Ze reads a leaf here only when the
                                direct leaf of the same name is empty. A name set here
                                therefore meets the same requirement the direct leaf
                                meets, and it is checked against the PKI store the same
                                way.";

                            leaf ca-certificate {
                                type string;
                                description "Name of the CA certificate in the PKI store.
                                    Ze reads it only when the direct ca-certificate leaf
                                    is empty. It then satisfies the trust anchor that
                                    every EAP mode and X.509 require.";
                            }

                            leaf certificate {
                                type string;
                                description "Name of the device certificate in the PKI
                                    store. Ze reads it only when the direct certificate
                                    leaf is empty. It then satisfies the certificate that
                                    every EAP mode and X.509 require.";
                            }
                        }
                    }

                    container vti {
                        description "Virtual Tunnel Interface binding.";

                        leaf bind {
                            type string;
                            description "VTI interface name to bind this peer's traffic to.";
                        }
                    }
                }
            }
        }
    }
}
