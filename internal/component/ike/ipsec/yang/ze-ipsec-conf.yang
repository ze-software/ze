module ze-ipsec-conf {
    namespace "urn:ze:ipsec:conf";
    prefix ipsec;

    import ze-extensions { prefix ze; }
    import ze-types { prefix zt; }

    description "IPsec VPN configuration for Ze (spec-ipsec-3).";

    revision 2026-05-20 {
        description "Initial IPsec data model: ESP/IKE groups, site-to-site peers.";
    }

    typedef encryption-algo {
        type enumeration {
            enum aes128 { description "AES-CBC-128 (RFC 3602)."; }
            enum aes256 { description "AES-CBC-256 (RFC 3602)."; }
            enum aes128gcm { description "AES-GCM-128, 16-byte ICV (RFC 4106)."; }
            enum aes256gcm { description "AES-GCM-256, 16-byte ICV (RFC 4106)."; }
            enum chacha20poly1305 {
                description "ChaCha20-Poly1305 AEAD (RFC 7634). No build implements it.";
            }
            enum 3des {
                description "Triple-DES-CBC (RFC 2451), deprecated. No build implements it.";
            }
        }
    }

    typedef hash-algo {
        type enumeration {
            enum sha1 {
                description "HMAC-SHA-1-96 (RFC 2404). No build implements it.";
            }
            enum sha256 { description "HMAC-SHA-256-128 (RFC 4868)."; }
            enum sha384 { description "HMAC-SHA-384-192 (RFC 4868)."; }
            enum sha512 { description "HMAC-SHA-512-256 (RFC 4868)."; }
        }
    }

    container vpn {
        description "VPN subsystems.";
        ze:help "Ze declares one subsystem under it today, which is ipsec. That subsystem holds the ESP
            groups, the IKE groups and the site-to-site peers.";

        container ipsec {
            description "IPsec VPN configuration.";
            ze:help "Ze speaks IKEv2 (RFC 7296) and installs each negotiated Child SA into the Linux XFRM
                stack. A peer references one ESP group and one IKE group, and those two carry the
                algorithms and the timers of the tunnel.";

            leaf interface {
                type string;
                description "WAN interface for IPsec traffic.";
                ze:help "Commit refuses a name no interface on the host carries. The first IPv4 address of
                    the interface fills the local-address of every peer that names none. It is also the
                    address the IKE socket on port 500 and the NAT-T socket on port 4500 bind to. A
                    reload whose interface holds no IPv4 address is refused, and the same case at
                    startup runs and writes a warning.";
            }

            leaf cookie-threshold {
                type uint32;
                default 0;
                description "Number of half-open IKE SAs tolerated before a COOKIE challenge.";
                ze:help
                    "Number of half-open IKE SAs tolerated before an inbound
                     IKE_SA_INIT must answer a COOKIE challenge. RFC 7296
                     Section 2.6 makes the challenge the answer to state and CPU
                     exhaustion from forged source addresses. The default of 0
                     challenges every inbound initiation, which costs one extra
                     round trip and stops a single spoofed datagram taking a
                     peer's only half-open handshake slot. Raise it to tolerate
                     that many half-open handshakes before challenging.";
            }

            list esp-group {
                key "name";
                description "ESP (Encapsulating Security Payload) group.";
                ze:help "The group carries the ESP proposals a peer offers for its Child SAs and the lifetime
                    those SAs run under. A group MUST hold at least one proposal, and commit refuses an
                    empty one. One group holds at most 255 proposals.";

                leaf name {
                    type string;
                    description "ESP group name.";
                    ze:help "The name holds 1 to 255 characters from the set a-z, A-Z, 0-9, hyphen,
                        underscore and period. A site-to-site peer references the group by this name.";
                }

                leaf lifetime {
                    type uint32 {
                        range "0..86400";
                    }
                    default 3600;
                    description "SA lifetime in seconds. 0 disables expiry.";
                    ze:help "The Child SA rekey trigger sits ahead of the lifetime by the larger of a
                        random 10 percent and one retransmit budget. That lead is capped at half the
                        lifetime. RFC 7296 Section 2.8 states the rule. 'When the lifetime of a
                        Security Association expires, the Security Association MUST NOT be used.' Ze
                        therefore tears the SA down at that point, even when a rekey is still in
                        flight. The value 0 starts no rekey and no expiry.";
                }

                leaf pfs {
                    type enumeration {
                        enum enable;
                        enum disable;
                    }
                    default "enable";
                    description "Perfect Forward Secrecy for Child SA rekeying.";
                    ze:help "With enable, Ze puts a KEi payload in the CREATE_CHILD_SA request, and the
                        replacement Child SA is keyed from a fresh Diffie-Hellman secret. With disable,
                        Ze sends no KEi, and the replacement is keyed from SK_d alone, so one leaked
                        SK_d reads every replacement Child SA. RFC 7296 Section 2.17 gives both KEYMAT
                        forms. An ESP proposal carries no Diffie-Hellman group of its own, so Ze offers
                        the group the IKE SA already negotiated. The default is enable, and Ze refuses a
                        response that disagrees with what its request carried.";
                }

                list proposal {
                    key "number";
                    max-elements 255;
                    description "ESP proposal, where a lower number is a higher priority.";
                    ze:help "ESP proposal. Lower number = higher priority. One group
                        offers at most 255 proposals, because RFC 7296 Section 3.3.1
                        numbers them in one octet.";

                    leaf number {
                        type uint16 {
                            range "1..65535";
                        }
                        description "Proposal priority number.";
                        ze:help "The number is a PRIORITY and it is not the Proposal Num of the wire. Ze
                            sorts the proposals of the group by this number and offers them lowest
                            first. The wire number comes from the position after that sort, which is how
                            the ike-group proposal number behaves as well.";
                    }

                    leaf encryption {
                        type encryption-algo;
                        mandatory true;
                        description "Encryption algorithm.";
                        ze:help "No build carries a transform for chacha20poly1305
                            or 3des, so a proposal that names one is refused at
                            commit. The refusal lists the algorithms the build does
                            implement.";
                    }

                    leaf hash {
                        type hash-algo;
                        description "Integrity algorithm.";
                        ze:help "Integrity algorithm. It is required beside a
                            non-AEAD cipher, and refused beside an AEAD cipher. RFC 7296
                            Section 3.3 gives an AEAD cipher its own integrity, so an ESP
                            proposal offers the integrity transform NONE. An ESP proposal
                            carries no PRF transform, so this leaf never names one.
                            No build carries a transform for sha1, so a proposal that
                            names it is refused at commit. The refusal lists the
                            algorithms the build does implement.";
                    }
                }
            }

            list ike-group {
                key "name";
                description "IKE (Internet Key Exchange) group.";
                ze:help "The group carries the IKE proposals, the IKE SA lifetime and the Dead Peer Detection
                    timers. A group MUST hold at least one proposal, and commit refuses an empty one.
                    One group holds at most 255 proposals.";

                leaf name {
                    type string;
                    description "IKE group name.";
                    ze:help "The name holds 1 to 255 characters from the set a-z, A-Z, 0-9, hyphen,
                        underscore and period. A site-to-site peer references the group by this name.";
                }

                leaf key-exchange {
                    type enumeration {
                        enum ikev1;
                        enum ikev2;
                    }
                    default "ikev2";
                    description "IKE protocol version.";
                }

                leaf lifetime {
                    type uint32 {
                        range "0..86400";
                    }
                    default 28800;
                    description "IKE SA lifetime in seconds, where 0 starts no rekey.";
                    ze:help "Ze rekeys the IKE SA before the lifetime runs out, on the trigger the ESP group
                        lifetime describes. It also rekeys the SA as the message id space nears its
                        ceiling. RFC 7296 Section 2.2 requires that. 'In the unlikely event that Message
                        IDs grow too large to fit in 32 bits, the IKE SA MUST be closed or rekeyed.' The
                        value 0 starts no rekey, so the SA runs until the peer or the operator ends
                        it.";
                }

                leaf close-action {
                    type enumeration {
                        enum none;
                        enum start;
                        enum restart;
                    }
                    default "none";
                    description "Action when peer closes the IKE SA.";
                }

                container dead-peer-detection {
                    description "Dead Peer Detection (DPD) settings (RFC 3706).";
                    ze:help "The timers run whether or not this container is present. A peer with no DPD
                        block probes every 30 seconds and waits 120 seconds for the answer. The probe is
                        an empty INFORMATIONAL request, which is the liveness check of RFC 7296 Sections
                        1.4 and 2.4.";

                    leaf action {
                        type enumeration {
                            enum restart;
                            enum hold;
                            enum clear;
                        }
                        default "hold";
                        description "Action when DPD detects a dead peer.";
                    }

                    leaf interval {
                        type uint16 {
                            range "1..3600";
                        }
                        default 30;
                        description "DPD probe interval in seconds.";
                        ze:help "Ze sends the next probe this long after the last one, and it sends none
                            while a probe is outstanding. The default is 30 seconds.";
                    }

                    leaf timeout {
                        type uint16 {
                            range "1..3600";
                        }
                        default 120;
                        description "DPD timeout in seconds before declaring peer dead.";
                        ze:help "The value bounds the whole liveness budget, so it covers the first probe and
                            every repeat of it. RFC 7296 Section 2.4 allows the verdict only when
                            'repeated attempts to contact it have gone unanswered for a timeout period'.
                            Ze repeats the probe on a growing backoff inside the budget and tears the SA
                            down when the budget runs out. The default is 120 seconds.";
                    }
                }

                list proposal {
                    key "number";
                    max-elements 255;
                    description "IKE proposal, where a lower number is a higher priority.";
                    ze:help "IKE proposal. Lower number = higher priority. One group
                        offers at most 255 proposals, because RFC 7296 Section 3.3.1
                        numbers them in one octet.";

                    leaf number {
                        type uint16 {
                            range "1..65535";
                        }
                        description "Proposal priority number.";
                        ze:help "The number is a PRIORITY and it is not the Proposal Num of the wire. Ze
                            sorts the proposals of the group by this number and offers them lowest
                            first. RFC 7296 Section 3.3 sets the wire number. 'The first Proposal in the
                            initiator's SA payload MUST have a Proposal Num of one (1).' Each later one
                            is one greater, so Ze takes that number from the position after the
                            sort.";
                    }

                    leaf encryption {
                        type encryption-algo;
                        mandatory true;
                        description "Encryption algorithm.";
                        ze:help "No build carries a transform for chacha20poly1305
                            or 3des, so a proposal that names one is refused at
                            commit. The refusal lists the algorithms the build does
                            implement.";
                    }

                    leaf hash {
                        type hash-algo;
                        mandatory true;
                        description "PRF and integrity algorithm.";
                        ze:help "It is required beside
                            every cipher, and an AEAD cipher is no exception. RFC 7296
                            Section 3.3.3 makes the PRF a mandatory transform for an IKE
                            proposal, and this leaf names it. An ESP proposal reads the
                            same leaf as integrity alone, and refuses it beside an AEAD
                            cipher.
                            No build carries a transform for sha1, so a proposal that
                            names it is refused at commit. The refusal lists the
                            algorithms the build does implement.";
                    }

                    leaf dh-group {
                        type uint8 {
                            range "1..31";
                        }
                        mandatory true;
                        description "Diffie-Hellman group number (RFC 7296 Section 3.3.2).";
                        ze:help "The number is Transform Type 4 of RFC 7296 Section 3.3.2. That section lists
                            the values current at publication, up to 18, and sends the reader to the
                            IANA registry for later ones. Ze takes 1 to 31 and refuses a group this
                            build carries no transform for. The refusal lists the numbers the build does
                            carry, which stops the reserved Transform ID 0 reaching the wire.";
                    }
                }
            }

            container remote-access {
                description "Remote access VPN for road warrior clients (EAP).";

                leaf ike-group {
                    type string;
                    mandatory true;
                    description "Reference to an IKE group name.";
                }

                leaf esp-group {
                    type string;
                    mandatory true;
                    description "Reference to an ESP group name.";
                }

                container authentication {
                    description "EAP authentication settings for remote access.";

                    leaf mode {
                        type enumeration {
                            enum eap-tls;
                            enum eap-mschapv2;
                            enum eap-md5 {
                                description "EAP MD5-Challenge, Type 4 (RFC 3748 Section 5.4).";
                            }
                        }
                        mandatory true;
                        description "EAP authentication method.";
                        ze:help "eap-md5 establishes no shared key, and RFC 7296
                            Section 2.16 discourages such a method: EAP methods that do
                            not establish a shared key SHOULD NOT be used, as they are
                            subject to a number of man-in-the-middle attacks. The IKEv2
                            AUTH payloads are then keyed by SK_pi and SK_pr instead of
                            by an EAP MSK. The method authenticates the client to Ze and
                            tells the client nothing about Ze. The daemon writes one
                            warning when this mode is adopted. Use eap-tls or
                            eap-mschapv2 unless the client runs no other method.";
                    }

                    container x509 {
                        description "Server certificate references for EAP.";
                        ze:help "Server certificate references for EAP. Ze parses
                            both leaves and no component reads them today, so neither
                            takes effect. Ze also leaves both unchecked, so a name that
                            no PKI store entry carries still commits here. The enforced
                            leaves of these names are the site-to-site peer ones.";

                        leaf ca-certificate {
                            type string;
                            description "Name of the CA certificate in the PKI store.
                                It has no effect today.";
                        }

                        leaf certificate {
                            type string;
                            description "Name of the server certificate in the PKI store.
                                It has no effect today.";
                        }
                    }
                }

                list pool {
                    key "name";
                    description "Virtual IP pool for client address assignment.";
                    ze:help "Virtual IP pool for client address assignment (IKEv2 Configuration Payload, RFC 7296 Section 2.19).";

                    leaf name {
                        type string;
                        description "Pool name.";
                    }

                    leaf range {
                        type string;
                        description "IPv4 CIDR for client addresses (e.g. 10.10.0.0/24). Prefix length /8-/30.";
                    }

                    leaf range6 {
                        type string;
                        description "IPv6 CIDR for client addresses (e.g. fd00::/64). Prefix length /48-/126.";
                    }

                    leaf dns {
                        type string;
                        description "DNS server pushed to clients via IKEv2 Configuration Payload.";
                    }

                    leaf domain {
                        type string;
                        description "Search domain pushed to clients.";
                    }
                }

                list eap-user {
                    key "name";
                    description "EAP user entry for remote access authentication.";

                    leaf name {
                        type string;
                        description "Username.";
                    }

                    leaf password {
                        type string;
                        ze:sensitive;
                        description "User password ($9$-encoded). Required for eap-mschapv2.";
                    }

                    leaf certificate {
                        type string;
                        description "Client certificate name in PKI store. Required for eap-tls.";
                    }
                }
            }

            container site-to-site {
                description "Site-to-site VPN peers.";
                ze:help "Each peer under it is one tunnel to one remote gateway. A peer carries its own
                    algorithms, its own identity, its own traffic selectors and its own rank in the
                    Security Policy Database.";

                list peer {
                    key "name";
                    description "Remote VPN peer.";
                    ze:help "Ze runs one session for each peer. A configuration reload stops and restarts
                        only the peers whose own configuration changed, so a peer left untouched keeps
                        its Child SAs up. A peer MUST reference one IKE group and one ESP group.";

                    leaf name {
                        type string;
                        description "Peer name (used as connection identifier).";
                        ze:help "The name holds 1 to 255 characters from the set a-z, A-Z, 0-9, hyphen,
                            underscore and period. Ze asserts the name as its own IKE identity when the
                            authentication local-id leaf is empty. The name also labels the peer in the
                            log and in the show output.";
                    }

                    leaf ike-group {
                        type string;
                        mandatory true;
                        description "Reference to an IKE group name.";
                        ze:help "The group MUST be declared under vpn ipsec ike-group, and commit refuses a
                            name no group carries. It supplies the IKE proposals, the IKE SA lifetime
                            and the Dead Peer Detection timers of this peer.";
                    }

                    leaf esp-group {
                        type string;
                        mandatory true;
                        description "Reference to an ESP group name.";
                        ze:help "The group MUST be declared under vpn ipsec esp-group, and commit refuses a
                            name no group carries. It supplies the ESP proposals Ze offers for this
                            peer's Child SAs and the lifetime those SAs run under.";
                    }

                    leaf connection-type {
                        type enumeration {
                            enum initiate;
                            enum respond;
                        }
                        default "initiate";
                        description "Whether to initiate or wait for the remote peer.";
                        ze:help "With `initiate` Ze starts the IKE_SA_INIT exchange toward remote-address.
                            With respond Ze starts nothing and waits. Ze matches an unsolicited
                            IKE_SA_INIT to a respond peer when the source address of the datagram
                            equals its remote-address. A respond peer that names no remote-address
                            therefore matches nothing.";
                    }

                    leaf local-address {
                        type string;
                        description "Local endpoint IP address.";
                        ze:help "The value is an IP address literal. Ze reads it with net.ParseIP, so an
                            interface name here resolves to nothing and the peer cannot build a Child
                            SA. Name the interface under vpn ipsec interface instead, and Ze fills this
                            leaf from the first IPv4 address of that interface.";
                    }

                    leaf remote-address {
                        type string;
                        description "Remote endpoint IPv4 address or DNS hostname.";
                        ze:help "Ze resolves the value with net.ResolveUDPAddr over udp4 and sends IKE to
                            port 500 there, so an IPv6 literal is refused with \"ike: resolve remote\".
                            Ze builds the NAT detection hashes of RFC 7296 Section 2.23 from this value.
                            It sends none when the value is not an address literal. An unsolicited
                            IKE_SA_INIT reaches a respond peer only when its source address equals this
                            leaf, character for character.";
                    }

                    leaf mode {
                        type enumeration {
                            enum tunnel {
                                description "Encapsulate the whole packet (RFC 4301 tunnel mode).";
                            }
                            enum transport {
                                description "Protect the payload and keep the outer IP header (RFC 4301 transport mode).";
                            }

                        }
                        default tunnel;
                        description "Encapsulation mode for this peer's Child SAs.";
                        ze:help
                            "Encapsulation mode for this peer's Child SAs.

                             RFC 7296 Section 1.3.1 states the default itself: 'Except when
                             using this option to negotiate transport mode, all Child SAs will
                             use tunnel mode.' Ze asks for transport mode by sending
                             USE_TRANSPORT_MODE with the Child SA request, and the peer can
                             decline. A declined request establishes a tunnel-mode Child SA
                             unless transport-required is set.

                             Transport mode constrains the traffic selectors. RFC 7296 Section
                             2.23.1 requires exactly one IP address in TSi and in TSr, so every
                             traffic-selector prefix under this peer must be a single host, and
                             a vti binding is refused because an XFRM interface carries tunnel
                             encapsulation.";
                    }

                    leaf transport-required {
                        type boolean;
                        default false;
                        description "Delete the SA when the peer declines transport mode.";
                        ze:help
                            "Whether a peer that declines transport mode is unacceptable.

                             RFC 7296 Section 1.3.1: 'If the responder declines the request, the
                             Child SA will be established in tunnel mode. If this is unacceptable
                             to the initiator, the initiator MUST delete the SA.' Only the
                             operator knows whether it is unacceptable, so this leaf carries that
                             decision. When it is true and the response omits USE_TRANSPORT_MODE,
                             Ze deletes the SA rather than run a tunnel-mode Child SA the
                             operator did not ask for. When it is false the SA stays up in
                             tunnel mode, which is the safe default.

                             It applies only when mode is transport.";
                    }

                    leaf policy-priority {
                        type uint32 {
                            range "101..2147483647";
                        }
                        default 2000;
                        description "Rank of this peer's Security Policy Database entries, lowest searched first.";
                        ze:help
                            "Where this peer's Security Policy Database entries sit in the
                             operator's ordering of that database. A LOWER value is searched
                             FIRST, in Ze and in the Linux kernel.

                             RFC 4301 Section 4.4.1: 'The ordering requirement arises because
                             entries often will overlap due to the presence of (non-trivial)
                             ranges as values for selectors. Thus, a user or administrator MUST
                             be able to order the entries to express a desired access control
                             policy.' The same section binds this interface: it 'MUST support
                             (total) ordering of these entries, as seen via this interface'.

                             Two peers whose traffic selectors overlap, 0.0.0.0/0 on both for
                             example, describe the same traffic. Give the one that must win the
                             lower value. Peers that share a value are ordered by whichever
                             established last, which is what every peer did before this leaf
                             existed, so the default 2000 keeps an unordered configuration
                             installing exactly what it installed before.

                             The range starts above 100, which is where the IKE control-plane
                             bypass sits. A peer entry at or above that rank captures the IKE
                             exchange that builds and rekeys the very SA it protects, and the
                             tunnel could then never renegotiate. It ends at 2147483647, the
                             largest rank Ze can carry to a dataplane.";
                    }

                    list traffic-selector {
                        key "number";
                        description "The traffic this peer's Child SAs carry.";
                        ze:help
                            "The traffic this peer's Child SAs carry, and the policy RFC 7296
                             Section 2.9 narrows a peer's proposal against.

                             When no entry is present the peer accepts whatever the remote
                             endpoint proposes, which is the behavior of every configuration
                             written before this list existed. Adding an entry restricts the
                             peer: a proposal Ze cannot narrow to a non-empty subset of these
                             entries is answered with TS_UNACCEPTABLE.

                             RFC 7296 Section 2.9 permits several selectors, so this is a list.";

                        leaf number {
                            type string {
                                length "1..16";
                                pattern '[0-9]+';
                            }
                            description "Selector identifier. Order is the order of proposal.";
                            ze:help "Ze proposes the entries in the order the configuration declares them,
                                and it does not sort them by this number. The number is the key of the
                                list, so commit refuses a peer that declares one number twice.";
                        }

                        container local {
                            description "The local side of the selector pair (TSi when Ze
                                initiates, TSr when Ze responds).";
                            ze:help "The prefix under it is mandatory once a traffic-selector entry exists,
                                and commit refuses an entry that leaves it out. The port under it takes
                                any unless the protocol leaf names a protocol that carries ports.";

                            leaf prefix {
                                type zt:ip-prefix;
                                mandatory true;
                                description "Local traffic the Child SA carries.";
                                ze:help "The value is a CIDR prefix, and Ze installs it as the local selector
                                    of the kernel policy. Under mode transport the prefix MUST cover
                                    exactly one address, a /32 or a /128. RFC 7296 Section 2.23.1
                                    requires one IP address in TSi and in TSr, so commit refuses
                                    anything wider there.";
                            }

                            leaf port {
                                type union {
                                    type uint16 { range "1..65535"; }
                                    type enumeration {
                                        enum any {
                                            description "Every port. RFC 7296 Section 3.13.1
                                                encodes it as start 0, end 65535.";
                                        }
                                    }
                                }
                                default any;
                                description "Local port of the selector.";
                                ze:help
                                    "Local port of the selector.

                                     RFC 7296 Section 3.13.1 requires the port fields to be 0 and
                                     65535 whenever the protocol is 0 or defines no port, so a
                                     value other than any needs the protocol leaf to name a
                                     protocol that has ports.";
                            }
                        }

                        container remote {
                            description "The remote side of the selector pair (TSr when Ze
                                initiates, TSi when Ze responds).";
                            ze:help "It obeys the rules the local container states. Ze narrows the peer's
                                proposal against the pair of prefixes, and it answers TS_UNACCEPTABLE
                                when no non-empty subset remains.";

                            leaf prefix {
                                type zt:ip-prefix;
                                mandatory true;
                                description "Remote traffic the Child SA carries.";
                                ze:help "The value is a CIDR prefix, and Ze installs it as the remote
                                    selector of the kernel policy. The single-address rule the local
                                    prefix states applies here as well under mode transport.";
                            }

                            leaf port {
                                type union {
                                    type uint16 { range "1..65535"; }
                                    type enumeration {
                                        enum any {
                                            description "Every port. RFC 7296 Section 3.13.1
                                                encodes it as start 0, end 65535.";
                                        }
                                    }
                                }
                                default any;
                                description "Remote port of the selector.";
                                ze:help
                                    "It follows the same rule as the local port: a value other
                                     than any needs the protocol leaf.";
                            }
                        }

                        leaf protocol {
                            type uint8;
                            default 0;
                            description "IP protocol number the selector matches.";
                            ze:help
                                "IP protocol number the selector matches, such as 6 for TCP and
                                 17 for UDP. Zero matches every protocol, which is RFC 7296
                                 Section 3.13.1's 'protocol 0'.";
                        }
                    }

                    container authentication {
                        description "Peer authentication settings.";
                        ze:help "The mode leaf decides which leaf below it Ze reads. A pre-shared-secret peer
                            and an EAP password mode read pre-shared-secret. X.509 and every EAP mode
                            read certificate and ca-certificate, and commit refuses a peer that leaves
                            either of those empty.";

                        leaf mode {
                            type enumeration {
                                enum pre-shared-secret;
                                enum x509;
                                enum eap-tls;
                                enum eap-mschapv2;
                                enum eap-md5 {
                                    description "EAP MD5-Challenge, Type 4 (RFC 3748 Section 5.4).";
                                }
                            }
                            mandatory true;
                            description "Authentication mode.";
                            ze:help "eap-md5 establishes no shared key, and RFC 7296
                                Section 2.16 discourages such a method: EAP methods that
                                do not establish a shared key SHOULD NOT be used, as
                                they are subject to a number of man-in-the-middle
                                attacks. The IKEv2 AUTH payloads are then keyed by SK_pi
                                and SK_pr instead of by an EAP MSK. The method
                                authenticates this peer to the far end and tells this
                                peer nothing about the far end. The daemon writes one
                                warning when this mode is adopted. Use eap-tls or
                                eap-mschapv2 unless the far end runs no other method.";
                        }

                        leaf pre-shared-secret {
                            type string;
                            ze:sensitive;
                            description "Pre-shared key ($9$-encoded).";
                            ze:help "Ze reads the leaf when the mode is pre-shared-secret, and when the mode
                                is an EAP method that carries a password. The $9$ wrapper is removed
                                first, and the pre-shared-secret-encoding leaf then decides whether the
                                result is ASCII text or hexadecimal digit pairs.";
                        }

                        leaf pre-shared-secret-encoding {
                            type enumeration {
                                enum ascii;
                                enum hex;
                            }
                            default ascii;
                            description "How to read the pre-shared-secret value.";
                            ze:help
                                "RFC 7296
                                 Section 2.15 requires the management interface to
                                 accept both an ASCII string and a hex encoding of
                                 the shared secret. Set this to hex to supply the
                                 secret as hexadecimal digit pairs, which is the way
                                 to configure a secret holding non-printable octets.

                                 The encoding is stated here and is never guessed from
                                 the value. A secret such as abcdef0123456789 is both
                                 valid ASCII and valid hex, so reading it as hex would
                                 silently change an existing secret. A hex value with
                                 an odd length or a non-hexadecimal character is
                                 refused at commit rather than read as ASCII.";
                        }

                        leaf local-id {
                            type string;
                            description "Local identity for IKE negotiation.";
                            ze:help "Ze derives the ID type it sends from the shape of the value. An IP
                                address literal goes out as ID_IPV4_ADDR or ID_IPV6_ADDR, and every
                                other value as ID_FQDN. There is no ID_DER_ASN1_DN form, so commit
                                refuses a distinguished name. Commit also refuses a subtree or an
                                address range, because this leaf names the one identity Ze asserts. An
                                empty leaf sends the peer name.";
                        }

                        leaf remote-id {
                            type string;
                            description "Identity the remote endpoint must assert.";
                            ze:help "When it is set,
                                Ze refuses an IKE_AUTH whose ID payload names another identity.
                                Comparable types are ID_IPV4_ADDR, ID_IPV6_ADDR, ID_FQDN,
                                ID_RFC822_ADDR, ID_KEY_ID, and ID_DER_ASN1_DN, and an address value
                                accepts the two address types alone. A distinguished name is
                                compared in RFC 4514 string form, and it binds against the
                                certificate subject exactly, octet for octet.

                                A value can name ONE peer or a SET of peers. RFC 4301 Section
                                4.4.3.1 requires both forms of Peer Authorization Database entry.
                                A set is written with the hierarchy separator in front, and it
                                admits the identities BELOW it and not the value itself:
                                '.example.com' admits vpn.example.com, '@example.com' admits
                                gateway@example.com, and ',ST=MA,C=US' admits every distinguished
                                name whose top relative distinguished names are ST=MA,C=US. An
                                address entry takes the same CIDR prefix the traffic-selector
                                leaves take, so '10.0.0.0/24' admits every address in that block.
                                ID_KEY_ID is always compared exactly, because an opaque octet
                                string has no hierarchy to cut.

                                The certificate binding stays per peer whichever form is used. A
                                peer admitted by a set must still assert an identity its own
                                certificate carries, so a set never widens what one certificate
                                proves.

                                When it is empty Ze checks no identity, so every certificate the
                                ca-certificate issued authenticates as this peer. Set it whenever
                                that authority issues to more than one client.";
                        }

                        leaf remote-id-type {
                            type enumeration {
                                enum ipv4-address;
                                enum ipv6-address;
                                enum fqdn;
                                enum rfc822-address;
                                enum key-id;
                                enum der-asn1-dn;
                            }
                            description "The one IKE ID type the remote endpoint CAN assert.";
                            ze:help
                                "The one IKE ID type the remote endpoint CAN assert, and when
                                 absent any type Ze CAN compare, which is the historical behavior.
                                 When it is set Ze refuses every other type, so a peer asserting
                                 ID_FQDN with the text of a configured mail address is refused.

                                 RFC 7296 Section 4 requires that it be possible to configure Ze to
                                 accept a PKIX certificate where the identity passed is ID_KEY_ID.
                                 An opaque key id corresponds to no certificate field, so Ze cannot
                                 derive that binding and refuses it by default. Setting this leaf to
                                 key-id is the operator stating that a chain to ca-certificate plus
                                 the exact key id IS the intended binding.

                                 It governs what Ze ACCEPTS, and the type Ze sends still follows
                                 the shape of local-id.";
                        }

                        leaf certificate-count {
                            type uint8 { range "1..4"; }
                            default 4;
                            description "The most X.509 certificates Ze sends to this peer and accepts from it.";
                            ze:help
                                "The most X.509 certificates Ze sends for this peer, and the most it
                                 accepts from it. RFC 7296 Section 3.6 requires an implementation be
                                 capable of being configured to send and accept up to four. The
                                 default is that figure, so an operator who never sets this leaf
                                 gets the conformant behavior.

                                 A peer that sends more than this is REFUSED, never truncated. A
                                 silent trim would pass a count check and hide from the operator
                                 that the limit was reached. It would also make which certificates
                                 survive depend on the order the peer chose.";
                        }

                        leaf hash-and-url {
                            type boolean;
                            default false;
                            description "Use the Hash and URL certificate encodings of RFC 7296 Section 3.6.";
                            ze:help
                                "When it is true Ze sends its certificate as a SHA-1 hash plus
                                 certificate-url, advertises HTTP_CERT_LOOKUP_SUPPORTED, and
                                 resolves a peer's Hash and URL payload.

                                 It defaults to false, and that default is a security property.
                                 Resolving a peer's payload fetches a URL that peer chose, and Ze
                                 must do that before it CAN authenticate the peer. With this leaf
                                 false Ze advertises nothing, a conforming peer sends no such
                                 payload, a non-conforming one is dropped, and no fetch is reachable.

                                 The enabled fetch takes the http scheme only, a 64 KiB cap, a
                                 5 second timeout, no redirects, denied destinations, and SHA-1
                                 verification before any parser.";
                        }

                        leaf certificate-url {
                            type string;
                            description "The http URL at which this device publishes its own certificate.";
                            ze:help
                                "The http URL at which this device's own certificate is published,
                                 sent beside the SHA-1 hash when hash-and-url is true. RFC 7296
                                 Section 3.6 requires support for the http scheme.";
                        }

                        leaf-list certificate-url-allow {
                            type zt:ip-prefix;
                            description "Extra destinations a certificate URL from this peer CAN resolve to.";
                            ze:help
                                "Destinations a certificate URL received from this peer CAN resolve
                                 to, beyond the fetcher's defaults. The fetcher refuses loopback,
                                 private, link-local and multicast addresses, and the cloud metadata
                                 address. It refuses them because the daemon runs on a router and
                                 holds routes an internet host does not. Naming a prefix here
                                 permits it.";
                        }

                        leaf ca-certificate {
                            type string;
                            description "Name of the CA certificate in the PKI store.";
                            ze:help "Name of the CA certificate in the PKI store. Required for
                                every EAP mode and for X.509. It is the trust anchor the remote
                                certificate must chain to, through any intermediate certificates the
                                peer sends. Without it any self-signed certificate would
                                authenticate. The remote certificate must also carry the remote-id
                                identity in a subject alternative name. Ze reads the subject common
                                name only when the certificate has no such extension.";
                        }

                        leaf certificate {
                            type string;
                            description "Name of the device certificate in the PKI store.";
                            ze:help "Name of the device certificate in the PKI store. Required for
                                every EAP mode, because RFC 7296 Section 2.16 makes the responder sign
                                its AUTH with a public key. Also used by X.509 mode. Ze sends this
                                certificate first, then the intermediate certificate the PKI entry
                                carries.";
                        }

                        container x509 {
                            description "X.509 certificate references, deprecated in favor of the direct leaves.";
                            ze:help "X.509 certificate references (deprecated, use
                                the direct leaves). Ze reads a leaf here only when the
                                direct leaf of the same name is empty. A name set here
                                therefore meets the same requirement the direct leaf
                                meets, and it is checked against the PKI store the same
                                way.";

                            leaf ca-certificate {
                                type string;
                                description "Name of the CA certificate in the PKI store.";
                                ze:help "Ze reads it only when the direct ca-certificate
                                    leaf is empty. It then satisfies the trust anchor that
                                    every EAP mode and X.509 require.";
                            }

                            leaf certificate {
                                type string;
                                description "Name of the device certificate in the PKI store.";
                                ze:help "Ze reads it only when the direct certificate
                                    leaf is empty. It then satisfies the certificate that
                                    every EAP mode and X.509 require.";

                            }
                        }
                    }

                    container vti {
                        description "Virtual Tunnel Interface binding.";

                        leaf bind {
                            type string;
                            description "VTI interface name to bind this peer's traffic to.";
                        }
                    }
                }
            }
        }
    }
}
