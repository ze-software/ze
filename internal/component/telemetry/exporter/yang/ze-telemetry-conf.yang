module ze-telemetry-conf {
    namespace "urn:ze:telemetry:conf";
    prefix tel;

    import ze-types { prefix zt; }
    import ze-extensions { prefix ze; }

    description "Telemetry configuration for Ze";

    revision 2026-01-01 {
        description "Initial revision";
    }

    grouping netdata-collector-settings {
        description "Netdata-compatible OS collector settings";

        leaf prefix {
            type string;
            default "netdata";
            description "Metric name prefix for Netdata-compatible OS collector metrics only.";
            ze:help "Ze puts the prefix in front of each Netdata-compatible OS
                     collector metric name. It does not change a Ze-native metric
                     name. The default is netdata.";
        }

        leaf interval {
            type uint16 {
                range "1..60";
            }
            default 1;
            description "Netdata-compatible OS collector sampling interval in seconds.";
            ze:help "Each Netdata-compatible OS collector samples the operating
                     system once in this interval. The range is 1 to 60 seconds, and
                     the default is 1.";
        }

        list collector {
            key "name";
            description "Per-Netdata-collector overrides of the enable state and the interval.";
            ze:help "Each entry names one collector, and it overrides the settings of
                     that collector alone.";

            leaf name {
                type string;
                description "Collector name.";
                ze:help "The collector names are cpu, memory, loadavg, netdev,
                         diskstats, stat, snmp, snmp6, conntrack, vmstat, sockstat,
                         sockstat6, softnet, softirqs, pressure, entropy, filenr,
                         uptime and diskspace.";
            }

            leaf enabled {
                type boolean;
                default true;
                description "Enable or disable this Netdata-compatible OS collector.";
                ze:help "With false, Ze runs every other collector and stops this
                         one. The default is true.";
            }

            leaf interval {
                type uint16 {
                    range "1..60";
                }
                description "Override the sampling interval of this collector, in seconds.";
                ze:help "When this leaf is not set, the collector uses the global
                         Netdata interval.";
            }
        }
    }

    container telemetry {
        description "Telemetry export configuration.";
        ze:help "The container holds the Prometheus export settings and the Netdata-
                 compatible collector settings.";

        container prometheus {
            description "Prometheus metrics HTTP export.";
            ze:help "The container holds the enable switch, the listen endpoints, the
                     metrics path, the HTTP Basic Authentication settings and the
                     collector settings.";

            leaf enabled {
                type boolean;
                default false;
                description "Enable the Prometheus metrics endpoint.";
                ze:help "Ze serves no metrics endpoint while this leaf is false, and
                         false is the default.";
            }

            list server {
                key "name";
                ze:listener;
                description "Prometheus listen endpoints.";
                ze:help "Each entry names one listen endpoint. The default endpoint
                         is 127.0.0.1 on port 9273.";

                leaf name {
                    type string;
                    description "Server instance name.";
                    ze:help "The name is the list key, so each server entry carries a
                             different one.";
                }

                uses zt:listener {
                    refine ip {
                        default "127.0.0.1";
                    }
                    refine port {
                        default 9273;
                    }
                }
            }

            leaf path {
                type string;
                default "/metrics";
                description "HTTP path of the metrics endpoint.";
                ze:help "A scraper reads the metrics at this path on each listen
                         endpoint. The default path is /metrics.";
            }

            container basic-auth {
                description "HTTP Basic Authentication for the Prometheus service.";
                ze:help "The container holds the enable switch, the realm, the
                         username and the two password leaves.";

                leaf enabled {
                    type boolean;
                    default false;
                    description "Require HTTP Basic Authentication on the metrics and health endpoints.";
                    ze:help "Ze asks for no credentials while this leaf is false, and
                             false is the default.";
                }

                leaf realm {
                    type string;
                    default "ze prometheus";
                    description "HTTP Basic Authentication realm.";
                    ze:help "A client shows the realm to the user when it asks for
                             the credentials. The default is 'ze prometheus'.";
                }

                leaf username {
                    type string;
                    description "HTTP Basic Authentication username.";
                    ze:help "The username pairs with the password leaf beside it.";
                }

                leaf password {
                    type string;
                    ze:bcrypt;
                    description "Bcrypt-hashed HTTP Basic Authentication password. Write plaintext via plaintext-password.";
                    ze:help "Ze compares the password of each request with this hash, and it
                             compares the username in constant time. A value that is not a
                             bcrypt hash stops the metrics server with an error, and the
                             config check warns about it at commit. With basic-auth enabled,
                             a username and this password are both required.";
                }

                leaf plaintext-password {
                    type string;
                    ze:ephemeral;
                    ze:sensitive;
                    description "Write-only password.";
                    ze:help "On commit, the config system hashes this value into
                             password and removes this leaf. The value is never
                             written to the config file, and a display path renders
                             the secret placeholder for it.";
                }
            }

            container netdata {
                description "Netdata-compatible OS collector metrics. These settings do not affect Ze-native metrics.";
                ze:help "The default of enabled is true, so an absent container still runs
                         the collectors. The three settings under it replace the deprecated
                         prefix, interval and collector leaves beside this container. Ze
                         reads a deprecated leaf only when the matching leaf here is absent,
                         and it logs the path it read.";

                leaf enabled {
                    type boolean;
                    default true;
                    description "Enable the Netdata-compatible OS collectors.";
                    ze:help "With false, Ze exports the Ze-native metrics alone. The
                             default is true.";
                }

                uses netdata-collector-settings;
            }

            leaf prefix {
                type string;
                default "netdata";
                status deprecated;
                description "Deprecated: use netdata/prefix.";
                ze:help "The leaf sets the metric name prefix for Netdata-compatible
                         OS collector metrics only.";
            }

            leaf interval {
                type uint16 {
                    range "1..60";
                }
                default 1;
                status deprecated;
                description "Deprecated: use netdata/interval. Netdata-compatible OS collector sampling interval in seconds.";
                ze:help "Write netdata/interval instead. Ze reads this leaf only when the
                         netdata container carries no interval leaf, and it then logs the
                         deprecated path it read. The range is 1 to 60 seconds and the
                         default is 1.";
            }

            list collector {
                key "name";
                status deprecated;
                description "Deprecated: use netdata/collector. Per-Netdata-collector overrides (enable/disable, interval).";
                ze:help "Write netdata/collector instead. Ze reads this list only when the
                         netdata container carries no collector list, and it then logs the
                         deprecated path it read. A netdata collector list replaces this one
                         whole, and the two are never merged.";

                leaf name {
                    type string;
                    description "Collector name.";
                    ze:help "The collector names are cpu, memory, loadavg, netdev,
                             diskstats, stat, snmp, snmp6, conntrack, vmstat,
                             sockstat, sockstat6, softnet, softirqs, pressure,
                             entropy, filenr, uptime and diskspace.";
                }

                leaf enabled {
                    type boolean;
                    default true;
                    description "Enable or disable this collector.";
                    ze:help "With false, Ze runs every other collector and stops this
                             one. The default is true.";
                }

                leaf interval {
                    type uint16 {
                        range "1..60";
                    }
                    description "Override sampling interval for this collector (seconds). Inherits global interval if not set.";
                    ze:help "The range is 1 to 60 seconds. An absent leaf gives the
                             collector the interval of the netdata container. The leaf lives
                             under a deprecated list, so write netdata/collector/interval
                             instead.";
                }
            }
        }
    }
}
