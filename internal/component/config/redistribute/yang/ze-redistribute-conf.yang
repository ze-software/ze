module ze-redistribute-conf {
    namespace "urn:ze:redistribute";
    prefix redist;

    import ze-extensions { prefix ze; }

    description "Route redistribution between protocols.
                 Protocols augment this container with their source types.
                 Hidden until redistribution is fully implemented.";

    revision 2026-04-09 {
        description "Initial revision";
    }

    container redistribute {
        ze:hidden true;
        description "Each destination protocol has its own container that holds the import
rules. To add a destination protocol, add a key here.";
        ze:help "Route redistribution between protocols.";

        list destination {
            key "protocol";
            description "Each entry names a consumer that registered itself, for example bgp
or ospf.";
            ze:help "Destination protocol for redistributed routes.";

            leaf protocol {
                type string;
                // No ze:validate here. A consumer registers at plugin startup,
                // which is after the YANG parse, so this leaf cannot be checked
                // against the consumer registry at parse time. Nothing checks it
                // at run time either: the orchestrator dispatches over the
                // consumers that registered, and a destination naming a protocol
                // nobody serves simply matches none of them. `ze doctor` reports
                // it instead, under doctor-redistribute-unknown-destination
                // (internal/component/config/doctor_redistribute.go).
                description "bgp, ospf and isis are examples. The leaf carries no ze:validate,
because a destination protocol registers its consumer at plugin startup, after the YANG
parse. Ze resolves the name against that registry when it redistributes a route.";
                ze:help "Name of the protocol that receives the redistributed routes.";
            }

            list import {
                key "source";
                description "If the family leaf-list is empty, Ze imports every family.";
                ze:help "Import routes from a source into this destination.";

                leaf source {
                    type string;
                    ze:validate "redistribute-source";
                    description "ibgp, ebgp, static and connected are examples.";
                    ze:help "Name of the route source this rule imports from.";
                }

                leaf-list family {
                    type string;
                    ze:validate "registered-address-family";
                    description "An empty leaf-list imports every family.";
                    ze:help "Address families Ze imports from this source.";
                }

                leaf tag {
                    type uint32;
                    description "The route tag is the value the source protocol attached to the route, for
example the tag leaf of a static route. A rule that names a tag imports the routes carrying exactly that
value and rejects the others. A rule with no tag leaf imports every route from the source, whatever tag
it carries. The value 0 is a tag like any other: a route with no tag carries 0, so tag 0 imports the
untagged routes alone.";
                    ze:help "Import only the routes that carry this route tag.";
                }
            }
        }
    }
}
