module ze-data-cmd {
    namespace "urn:ze:data:cmd";
    prefix datacmd;
    import ze-extensions { prefix ze; }
    description "Live maintenance of the daemon's own store: backup, config restore, a salvage
copy, the removal or the write of one runtime-state key, and the import of one
config as a new version, each through the store handle the daemon owns.";
    revision 2026-09-26 { description "Initial revision"; }
    revision 2026-11-14 { description "Added delete data key, the removal of one runtime-state key through the daemon, refused while a plugin granted the key runs, request data repair, a salvage copy of the live store, update data key, the write of one runtime-state key from base64 content, and update data config, the import of one config as a new version from base64 content, through the reload when it is the daemon's own config."; }
    revision 2026-11-17 { description "Add complete stored-configuration rename and indexed rollback through owner transactions, preserving version pointers, history and saved editor work."; }

    container delete {
        config false;

        container data {
            config false;
            description "This keyword runs nothing on its own. 'delete data key <key>' is the one
command under it.";
            ze:help "Remove a runtime-state key from the running daemon's store.";

            container key {
                config false;
                ze:command "ze-config:data-key-delete";
                description "Removes one runtime-state key (a key under meta/ outside meta/config/) through
the store the daemon owns, so it works while ze runs. A configuration key (under
file/ or meta/config/, or outside both) is refused before the store is touched,
because a raw removal bypasses its versions, pointers and history. A key a
plugin is granted is refused while that plugin runs, because the plugin manages
the key while it runs; the refusal names the plugin and its restart. Until the
daemon has started its plugins, such a key is refused, because the daemon
cannot tell yet whether the plugin runs. A key the store does not hold is an
error.";
                ze:help "Remove one runtime-state key from the daemon's store.";
                leaf key {
                    type string { length "1..512"; }
                    mandatory true;
                    description "The key to remove, as show data list prints it.";
                    ze:help "Store key, as show data list prints it";
                }
            }
        }
    }

    container update {
        config false;

        container data {
            config false;
            description "This keyword runs nothing on its own. 'update data key <key> content <base64>'
and 'update data config name <name> content <base64>' are the commands under
it.";
            ze:help "Write a runtime-state key or import a config into the running daemon's store.";

            container key {
                config false;
                ze:command "ze-config:data-key-update";
                description "Writes one runtime-state key (a key under meta/ outside meta/config/) through
the store the daemon owns, so it works while ze runs. The key is created, or
replaced when it exists, with the bytes content decodes to, and the answer
carries the key and the byte count. A configuration key (under file/ or
meta/config/, or outside both) is refused before the store is touched, because
a raw write bypasses its versions, pointers and history. A key a plugin is
granted is refused while that plugin runs, because the plugin manages the key
while it runs; the refusal names the plugin and its restart. Until the daemon
has started its plugins, such a key is refused, because the daemon cannot tell
yet whether the plugin runs. The content is never recorded: the audit log, the
accounting record, the SSH exec log and the session transcript hold a
placeholder in its place.";
                ze:help "Write one runtime-state key into the daemon's store.";
                leaf key {
                    type string { length "1..512"; }
                    mandatory true;
                    description "The key to write, as show data list prints it.";
                    ze:help "Store key, as show data list prints it";
                }
                leaf content {
                    // RFC 7950 Section 7.5.4.1: "If the constraint evaluates to "false", the
                    // string is passed as <error-message> in the <rpc-error> in NETCONF."
                    // An SSH exec command travels in one SSH packet, which carries at
                    // most 256 KiB, so 261,120 characters is the bound on every surface:
                    // it leaves room for the command around the value.
                    type string {
                        length "4..261120" {
                            error-message "content is the key's bytes in base64: 4 to 261,120 characters, which is 1 to 195,840 bytes of content, the most one SSH packet carries with the command around it. A key is removed with delete data key, never emptied. Write a larger value with ze data write <key> <file> while ze is stopped.";
                        }
                        pattern "([A-Za-z0-9+/]{4})*([A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?" {
                            error-message "content is base64 (RFC 4648 Section 4: the letters, the digits, + and /, with = padding), the encoding ze data write sends a file in. Encode the bytes as base64 and give the result.";
                        }
                    }
                    mandatory true;
                    description "The bytes to write, base64-encoded (RFC 4648 Section 4, with padding): 1 to
195,840 bytes, at most 261,120 characters. The value is never recorded.";
                    ze:help "Key bytes in base64, at most 195,840 bytes";
                    ze:keyword-only;
                }
            }

            container config {
                config false;
                ze:command "ze-config:data-config-update";
                description "Imports one config through the store the daemon owns, so it works while ze
runs. For the daemon's own config, the content is staged as the candidate and
the same reload a SIGHUP runs promotes it: the config becomes active only when
the reload accepts it, and a refused config leaves the active config, its
pointers and the daemon unchanged, with the reload's reason in the refusal.
The import is refused while a confirmed-commit window is open, with the
window's own refusal, and while another change is staged. For any other name,
the content is committed as a new active version, the previous one kept as
rollback, and nothing reloads. The answer carries the name, the version stamp
and the byte count. The content is never recorded: the audit log, the
accounting record, the SSH exec log and the session transcript hold a
placeholder in its place.";
                ze:help "Import one config into the daemon's store as a new version.";
                leaf name {
                    type string { length "1..255"; }
                    mandatory true;
                    description "The config's file name with no directory, as show config list prints it. A
path, . and .. are refused.";
                    ze:help "Config file name, with no directory";
                }
                leaf content {
                    // RFC 7950 Section 7.5.4.1: "If the constraint evaluates to "false", the
                    // string is passed as <error-message> in the <rpc-error> in NETCONF."
                    // The bound is update data key's: one SSH packet carries the
                    // command. The messages differ because a larger config has a
                    // route of its own, so the two leaves cannot share one typedef.
                    type string {
                        length "4..261120" {
                            error-message "content is the config's bytes in base64: 4 to 261,120 characters, which is 1 to 195,840 bytes of config, the most one SSH packet carries with the command around it. Restore a larger config from a backup file on the daemon's host with request data restore path <file> config.";
                        }
                        pattern "([A-Za-z0-9+/]{4})*([A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?" {
                            error-message "content is base64 (RFC 4648 Section 4: the letters, the digits, + and /, with = padding), the encoding ze data import sends a file in. Encode the bytes as base64 and give the result.";
                        }
                    }
                    mandatory true;
                    description "The config's bytes, base64-encoded (RFC 4648 Section 4, with padding): 1 to
195,840 bytes, at most 261,120 characters. The value is never recorded.";
                    ze:help "Config bytes in base64, at most 195,840 bytes";
                    ze:keyword-only;
                }
            }
        }
    }

    container request {
        config false;

        container data {
            config false;
            description "These act on the running daemon's store under its own store lock. File
paths refer to the daemon's host; config names select its stored configurations.";
            ze:help "Maintain the store and its stored configurations.";

            container config {
                config false;
                description "Maintain a named stored configuration with its versioned state.";
                ze:help "Maintain stored configuration identities and history.";
                container rollback {
                    config false;
                    ze:command "ze-config:data-config-rollback";
                    description "Publish a selected stored revision as a new active version, retaining
the previous active version as rollback. Revision numbers follow the existing
history listing: 1 is the most recent dated entry. A staged candidate, a pending
confirmed window or an unfinished file publication refuses the write. The running
daemon's own configuration is staged and reloaded through its normal transaction;
other configurations use the same guarded version publication as local rollback.";
                    ze:help "Restore one stored revision through the configuration owner.";
                    leaf name {
                        type string {
                            length "1..255";
                            pattern '[^/\\]+' {
                                error-message "name is a filename without a directory. Give the stored config's basename.";
                            }
                        }
                        mandatory true;
                        description "Stored configuration name, without a directory.";
                        ze:help "Stored config filename.";
                    }
                    leaf revision {
                        type uint32 { range "1..max"; }
                        mandatory true;
                        description "One-based revision number in the same descending timestamp order
as the existing configuration history list. No other revision is substituted.";
                        ze:help "History revision number, starting at 1 for the most recent.";
                    }
                }
                container rename {
                    config false;
                    ze:command "ze-config:data-config-rename";
                    description "Rename an inactive stored configuration with its dated history,
version pointers, active and candidate mirrors, and saved draft/account changes.
Shared content objects and unrelated audit/history records are preserved. Any
destination-owned state or unfinished identity transaction refuses the rename.
The running daemon's source and configured managed-client identities are refused
because their launch or fetch bindings cannot be safely rebound by this command.";
                    ze:help "Rename a stored configuration and preserve all its saved state.";
                    leaf old {
                        type string {
                            length "1..255";
                            pattern '[^/\\]+' {
                                error-message "old is a filename without a directory. Give the stored config's basename.";
                            }
                        }
                        mandatory true;
                        description "Existing stored configuration name, without a directory.";
                        ze:help "Existing stored config filename.";
                    }
                    leaf new {
                        type string {
                            length "1..255";
                            pattern '[^/\\]+' {
                                error-message "new is a filename without a directory. Give the new stored config's basename.";
                            }
                        }
                        mandatory true;
                        description "Unused destination configuration name, without a directory.
No mirror, pointer, version or saved editor state may already belong to it.";
                        ze:help "Unused new config filename.";
                    }
                }
            }

            container backup {
                config false;
                ze:command "ze-config:data-backup";
                description "Copies every key of the store into one blob artifact while the daemon runs. A
commit that lands meanwhile is in the backup whole or not at all. The file holds
credentials and private keys and is written 0600.";
                ze:help "Write a backup of the whole store to a file on the daemon's host.";
                leaf path {
                    type string { length "1..4096"; }
                    mandatory true;
                    description "Absolute path of the artifact. A relative path, a '..' element, a symlink, and
every name the store owns in its folder are refused, each naming the rule it
broke.";
                    ze:help "Absolute artifact path";
                }
                leaf spare {
                    type uint8 { range "0..100"; }
                    default 0;
                    description "Spare capacity in percent that each key and data slot carries. An artifact is
normally copied whole, so the default is 0.";
                    ze:help "Spare capacity percent (0-100)";
                }
                leaf force {
                    type empty;
                    description "Replace an existing file at path. It never lifts a refusal of a name the store
owns.";
                    ze:help "Replace an existing file";
                }
            }

            container restore {
                config false;
                ze:command "ze-config:data-restore";
                description "Select config to stage one configuration through the normal reload, or full
to accept every artifact key for recovery after a clean daemon shutdown and
successful store close. Full recovery verifies an independent immutable copy
before answering, then requests restart only after response delivery. A failed
shutdown prevents replacement. With config and client, a hub updates that served
client's configuration without reloading its own.";
                ze:help "Restore a configuration now or accept full-store recovery after shutdown.";
                leaf path {
                    type string { length "1..4096"; }
                    mandatory true;
                    description "Absolute path of the artifact, checked before it is read by the same rules as a
backup path.";
                    ze:help "Absolute artifact path";
                }
                leaf config {
                    type empty;
                    description "Restore one selected configuration through the normal reload. Select
exactly one mode, config or full.";
                    ze:help "Restore the config only";
                }
                leaf full {
                    type empty;
                    description "Accept a verified complete store replacement for the outer daemon
lifetime. It runs only after all runtime borrowers finish, the original store
closes successfully and the daemon returns its existing restart result. The
response confirms acceptance rather than completion. It cannot be combined
with config, name or client.";
                    ze:help "Accept full-store recovery after a clean shutdown and owner close.";
                }
                leaf name {
                    type string { length "1..255"; }
                    description "The config to take from an artifact that holds several. Without it, the
artifact's only config, or the config named like this device, is taken.";
                    ze:help "Config name inside the artifact";
                }
                leaf client {
                    type string { length "1..64"; }
                    description "The managed client whose served config (client-<name>.conf) the restore
writes. The daemon MUST be a hub with a client entry of this name. Without it,
the restore replaces this daemon's own config through the reload.";
                    ze:help "Managed client whose served config is restored";
                }
            }

            container repair {
                config false;
                ze:command "ze-config:data-repair";
                description "Writes a salvage copy of the live store to a new store at path, holding every
entry that reads, while the daemon runs. The daemon holds its own writes for
the walk, so the copy is one moment of the store. The history of the copy is
then repaired the way ze data repair repairs it. The answer carries the
recovered and skipped counts and the path. The live store is not changed:
installing the copy needs ze stopped.";
                ze:help "Write a salvage copy of the store to a new path on the daemon's host.";
                leaf path {
                    type string { length "1..4096"; }
                    mandatory true;
                    description "Absolute path of the new store. A relative path, a '..' element, a symlink, a
path that exists, every name the store owns in its folder and a path inside
the live tree are refused, each naming the rule it broke.";
                    ze:help "Absolute path of the new store";
                }
            }
        }
    }
}
