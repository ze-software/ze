  "plugins": [
    {
      "name": "anomaly-detect",
      "description": "Behavioral anomaly detector (report-only): per-entity pattern-of-life over trafficfeature"
    },
    {
      "name": "anomaly-observe",
      "description": "Behavioral anomaly observability: incident lifecycle store and show anomaly observe CLI"
    },
    {
      "name": "anomaly-shape",
      "description": "Shadow-first autonomous anomaly responder: per-source rate-limit with arm/auto-revert/kill-switch"
    },
    {
      "name": "as112",
      "description": "AS112 anycast DNS node: authoritative sink for misdirected RFC 1918 / link-local reverse-DNS queries (RFC 7534, RFC 7535)"
    },
    {
      "name": "bfd",
      "description": "Bidirectional Forwarding Detection (RFC 5880, 5881, 5883)"
    },
    {
      "name": "bgp",
      "description": "BGP routing daemon"
    },
    {
      "name": "bgp-adj-rib-in",
      "description": "Adj-RIB-In storage (raw hex replay)"
    },
    {
      "name": "bgp-aigp",
      "description": "Accumulated IGP Metric (RFC 7311)"
    },
    {
      "name": "bgp-bmp",
      "description": "BMP receiver and sender (RFC 7854, 8671)"
    },
    {
      "name": "bgp-capa",
      "description": "Core BGP capability decoding (multiprotocol, asn4, add-path, paths-limit, extended-nexthop, extended-message)"
    },
    {
      "name": "bgp-epe",
      "description": "Native BGP Egress Peer Engineering segments"
    },
    {
      "name": "bgp-filter-aspath",
      "description": "Named AS-path regex filter (ordered entries, first match wins, accept/reject)"
    },
    {
      "name": "bgp-filter-aspath-length",
      "description": "Named AS-path length filter (accept/reject based on hop count)"
    },
    {
      "name": "bgp-filter-community",
      "description": "Community tag/strip filter (standard, large, extended)"
    },
    {
      "name": "bgp-filter-community-match",
      "description": "Named community match filter (ordered entries, first match wins, accept/reject)"
    },
    {
      "name": "bgp-filter-family",
      "description": "Named address-family policy filter: remove a family's NLRI or tear down the session"
    },
    {
      "name": "bgp-filter-irr",
      "description": "IRR-based prefix-list filter for eBGP peers"
    },
    {
      "name": "bgp-filter-modify",
      "description": "Named route attribute modifier (set local-preference, med, origin, next-hop)"
    },
    {
      "name": "bgp-filter-path-asn",
