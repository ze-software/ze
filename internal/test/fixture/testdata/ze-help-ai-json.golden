      "name": "sysctl",
      "mode": "offline",
      "short-help": "Kernel sysctl helpers"
    },
    {
      "name": "tacacs",
      "mode": "offline",
      "short-help": "TACACS+ client helpers",
      "subs": "show"
    },
    {
      "name": "traffic",
      "mode": "offline",
      "short-help": "Linux tc / VPP policer helpers",
      "subs": "control"
    },
    {
      "name": "uninstall",
      "mode": "setup",
      "short-help": "Remove ze binary or systemd service",
      "subs": "local, systemd"
