module ze-fakel2tp-api {
  namespace "urn:ze:test:fakel2tp:api";
  prefix "fakel2tp-api";

  import ze-extensions { prefix ze; }

  organization "Ze Project";
  description "Test-only synthetic L2TP route producer RPCs.
               fakel2tp emits route-change events on the l2tp namespace
               so .ci tests can exercise the bgp-redistribute consumer
               without a real L2TP subsystem.";
  revision 2026-04-21 {
    description "Initial revision -- emit / help.";
  }

  rpc fakel2tp-emit {
    description "Args: <add|remove> <family> <prefix>.";
    ze:help "Emit one synthetic L2TP route-change batch.";
  }

  rpc fakel2tp-help {
    description "The answer lists the registered test commands and the route-emitter usage.";
      ze:help "Print the fakel2tp command surface.";
  }

  rpc fakel2tp-pool-address {
    description "Request an IPv4 address from the real pool handler for a synthetic subscriber.
Args: id <session-id> pool <default|name>. This fixture requires an internal plugin.";
    ze:help "Request a synthetic subscriber address.";
  }

  rpc fakel2tp-pool-pppoe-address {
    description "Request an IPv4 address from the real pool handler with an explicit PPPoE identity.
Args: id <session-id> pool <default|name>. This fixture requires an internal plugin.";
    ze:help "Request a synthetic PPPoE subscriber address.";
  }

  rpc fakel2tp-pool-release {
    description "Emit subscriber session-down on the real daemon bus.
Args: access <l2tp|pppoe> id <session-id>. This fixture requires an internal plugin.";
    ze:help "Release one explicit synthetic subscriber.";
  }

  rpc fakel2tp-pool-prefix {
    description "Request an IPv6 prefix from the real pool handler for a synthetic subscriber.
Args: id <session-id> pool <default|name>. This fixture requires an internal plugin.";
    ze:help "Request a synthetic subscriber prefix.";
  }
}
