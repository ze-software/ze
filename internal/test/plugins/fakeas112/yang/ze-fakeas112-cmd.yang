module ze-fakeas112-cmd {
    namespace "urn:ze:test:fakeas112:cmd";
    prefix fakeas112cmd;
    import ze-extensions { prefix ze; }
    description "Test-only synthetic AS112 route producer command tree.
                 Hidden behind ze:hidden so it does not pollute the
                 production CLI completion when an operator runs
                 `ze cli` against a daemon that loaded fakeas112.";
    revision 2026-07-05 { description "Initial revision."; }

    container fakeas112 {
        ze:hidden true;
        config false;
        description "Fakeas112 test commands.";

        container emit {
            config false;
            ze:command "ze-fakeas112-api:fakeas112-emit";
            description "Emit the AS112 covering prefixes as route-change batches.";
        }

        container help {
            config false;
            ze:command "ze-fakeas112-api:fakeas112-help";
            description "Print the fakeas112 command surface.";
        }
    }
}
