#cloud-config
# vim:syntax=yaml
growpart:
  mode: auto
  devices: ['/']
mounts:
- [vz-rosetta, /mnt/lima-rosetta, virtiofs, defaults, "0", "0"]
- [mount0, /Users/thomas, virtiofs, "rw", "0", "0"]
users:
  - name: "thomas"
    uid: "501"
    gecos: "Thomas Mangin"
    homedir: "/home/thomas.linux"
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    lock_passwd: true
    ssh-authorized-keys:
      - "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIExample1 thomas@mac"
      - "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIExample2 lima"
write_files:
 - content: |
      #!/bin/sh
      exec "${LIMA_CIDATA_MNT}"/boot.sh
   owner: root:root
   path: /var/lib/cloud/scripts/per-boot/00-lima.boot.sh
   permissions: '0755'
