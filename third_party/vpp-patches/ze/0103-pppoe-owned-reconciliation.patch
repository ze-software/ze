+  i32 retval;
+  bool present;
+  u8 owner[16];
+  vl_api_interface_index_t cp_sw_if_index;
+  vl_api_interface_index_t dp_sw_if_index;
+};
+
+/* direction: 1=RX/upload, 2=TX/download. An absent policer or binding is
+ * explicit; index zero remains a valid policer pool index.
+ */
+define pppoe_ze_policer
