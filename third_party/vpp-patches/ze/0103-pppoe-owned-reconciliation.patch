+  u32 context;
+};
+define pppoe_ze_server_reply
+{
+  u32 context;
+  i32 retval;
+  u8 incarnation[16];
+};
+
+/* operation: 1=query, 2=add, 3=delete; zero and other values are refused. */
+define pppoe_ze_session
+{
+  u32 client_index;
+  u32 context;
+  u8 operation;
+  u8 incarnation[16];
+  u8 owner[16];
+  vl_api_mac_address_t client_mac;
+  u16 session_id;
+  vl_api_interface_index_t dp_sw_if_index;
+  u32 decap_vrf_id;
+};
+define pppoe_ze_session_reply
+{
+  u32 context;
+  i32 retval;
+  bool present;
+  u8 owner[16];
+  vl_api_interface_index_t sw_if_index;
+  vl_api_interface_index_t dp_sw_if_index;
+  u32 decap_vrf_id;
+};
+
+define pppoe_ze_cp
+{
+  u32 client_index;
+  u32 context;
+  u8 operation;
+  u8 incarnation[16];
+  u8 owner[16];
+  vl_api_interface_index_t cp_sw_if_index;
+  vl_api_interface_index_t dp_sw_if_index;
+};
+define pppoe_ze_cp_reply
