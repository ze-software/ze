+define pppoe_ze_policer_reply
+{
+  u32 context;
+  i32 retval;
+  bool present;
+  bool owned;
+  u32 policer_index;
+  bool slot_allocated;
+  u8 feature_mask;
+  u32 bound_index;
+  u32 cir_kbps;
+  u64 cb_bytes;
+};
+
+/* Change only the observed expected slot. A repeated already-desired bind
+ * does not add another feature reference. ~0 desired_index means unbind.
+ */
+define pppoe_ze_policer_bind
+{
+  u32 client_index;
+  u32 context;
+  u8 incarnation[16];
+  u8 owner[16];
+  u8 policer_owner[16];
+  vl_api_interface_index_t sw_if_index;
+  u8 direction;
+  u32 expected_index;
+  u32 desired_index;
+};
+define pppoe_ze_policer_bind_reply
+{
+  u32 context;
+  i32 retval;
+};
+
+/* Session owner and independent policer-object owner are both required.
+ * operation: query=1, add=2, delete=3, update=4. An add names expected_index
+ * ~0. Update/delete require the exact observed index, including valid zero.
+ * The algorithm is explicit 1R2C, KBPS, round-down, transmit/drop/drop.
+ */
+define pppoe_ze_policer_mutate
+{
+  u32 client_index;
+  u32 context;
+  u8 operation;
+  u8 incarnation[16];
+  u8 owner[16];
+  u8 policer_owner[16];
+  vl_api_interface_index_t sw_if_index;
+  u8 direction;
+  u32 expected_index;
+  u32 cir_kbps;
+  u64 cb_bytes;
+};
+define pppoe_ze_policer_mutate_reply
+{
+  u32 context;
+  i32 retval;
+  bool present;
+  bool owned;
+  u32 policer_index;
+  u32 cir_kbps;
+  u64 cb_bytes;
+};
+
+/* operation: query=1, enable=2, disable=3. selector:
+ * 1..4 = IPv4 unicast/multicast, IPv6 unicast/multicast not-enabled gates;
+ * 5..9 = device-input and those four policer-input arcs;
+ * 10..11 = IPv4/IPv6 policer-output arcs. No arbitrary feature is accepted.
+ */
+define pppoe_ze_feature
+{
+  u32 client_index;
+  u32 context;
+  u8 operation;
+  u8 incarnation[16];
+  u8 owner[16];
+  u8 policer_owner[16];
+  vl_api_interface_index_t sw_if_index;
+  u8 selector;
+};
+define pppoe_ze_feature_reply
+{
+  u32 context;
+  i32 retval;
+  bool enabled;
+};
+
+/* One exact path on the native ze-pppoe source. Mutations are multipath and
+ * carry the live session token in the SAME request that changes the FIB.
+ */
+define pppoe_ze_route
+{
+  u32 client_index;
+  u32 context;
+  bool is_add;
+  u8 incarnation[16];
+  u8 owner[16];
+  vl_api_interface_index_t sw_if_index;
+  u32 table_id;
+  vl_api_prefix_t destination;
+  bool gateway_present;
+  vl_api_address_t gateway;
+  u8 preference;
+};
+define pppoe_ze_route_reply
+{
+  u32 context;
+  i32 retval;
+};
+
+/* kind: 1=L3MTU, 2=admin-up boolean, 3=IPv4tableID, 4=IPv6tableID.
+ * The owner token is checked in the SAME request that configures the index.
+ */
+define pppoe_ze_interface
+{
+  u32 client_index;
+  u32 context;
+  u8 incarnation[16];
+  u8 owner[16];
+  vl_api_interface_index_t sw_if_index;
+  u8 kind;
+  u32 value;
+};
+define pppoe_ze_interface_reply
+{
+  u32 context;
+  i32 retval;
+  u32 actual;
+};
