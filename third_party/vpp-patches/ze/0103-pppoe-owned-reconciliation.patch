+                                    index, 1, rx, 0, 0, &rate) && !rate.present,
+         "exact unbound orphan policer could not be released");
+  rx = ~0;
+  CHECK (!pppoe_ze_policer_mutate (PPPOE_ZE_DELETE, boot, owner, repeat,
+                                    index, 1, recycled, 0, 0, &rate),
+         "repeated orphan deletion did not return explicit absence"); PASSED ();
+  CHECK (!vnet_feature_enable_disable ("ip4-unicast", "ip4-not-enabled", index, 0, 0, 0),
+         "foreign session gate fixture failed");
+  CHECK (pppoe_ze_feature (PPPOE_ZE_ADD, boot, owner, zero, index, 1, &gate) &&
+         vnet_feature_is_enabled ("ip4-unicast", "ip4-not-enabled", index) == 0 &&
+         pppoe_ze_interface (boot, owner, index, 1, 1492, &interface_value),
+         "stale session receipt mutated a reused interface"); PASSED ();
+  fib_table_entry_path_add (0, &route4, pppoe_ze_route_source (),
+                            FIB_ENTRY_FLAG_NONE, DPO_PROTO_IP4, &gateway,
+                            index, 0, 1, 0, 0);
+  route4_installed = 1;
+  CHECK (pppoe_ze_route (0, boot, owner, index, 0, &route4, &gateway, 0) &&
+         fib_table_lookup_exact_match (0, &route4) != FIB_NODE_INDEX_INVALID,
+         "stale route receipt withdrew the replacement interface's path"); PASSED ();
+  fib_table_entry_path_remove (0, &route4, pppoe_ze_route_source (),
+                               DPO_PROTO_IP4, &gateway, index, 0, 1, 0);
+  route4_installed = 0;
+  args.is_add = 0;
+  CHECK (!vnet_pppoe_add_del_session (&args, 0), "foreign fixture session cleanup failed");
+  CHECK (!pppoe_ze_session (PPPOE_ZE_ADD, boot, owner, mac, sid, dp, 0, &session),
+         "owned session recreation failed");
+  pppoe_ze_test_link (mac, dp, 0); linked = 0;
+  CHECK (!pppoe_ze_session (PPPOE_ZE_DELETE, boot, owner, mac, sid, dp, 0, &session) &&
+         !session.present && pool_elts (pem->sessions) == 0,
+         "owned delete depended on the mutable learned link"); PASSED ();
+  CHECK (pppoe_ze_session (PPPOE_ZE_ADD, boot, zero, mac, sid, dp, 0, &session),
+         "zero session owner was accepted"); PASSED ();
+  CHECK (pppoe_ze_session (PPPOE_ZE_DELETE, other_boot, owner, mac, sid, dp, 0, &session),
+         "wrong process incarnation was accepted"); PASSED ();
+  CHECK (!pppoe_ze_session (PPPOE_ZE_QUERY, boot, owner, mac, sid, dp, 0, &session) &&
+         !session.present && session.sw_if_index == ~0,
+         "native session absence was represented by a valid index"); PASSED ();
+
+  /* A stock IPv6 session has no Ze token and no recorded FIB family. Its
+   * decap index must never be interpreted through the IPv4 FIB pool.
+   */
+  foreign_ip6_fib = fib_table_find_or_create_and_lock (
+    FIB_PROTOCOL_IP6, 0x2e1101, FIB_SOURCE_API);
+  CHECK (foreign_ip6_fib != ~0 &&
+         (foreign_ip6_fib >= vec_len (ip4_main.fibs) ||
+          pool_is_free_index (ip4_main.fibs, foreign_ip6_fib)),
+         "IPv6 fixture requires an index without an IPv4 FIB");
+  pppoe_ze_test_link (mac, dp, 1); linked = 1;
+  clib_memset (&args, 0, sizeof (args));
+  args.is_add = 1; args.is_ip6 = 1; args.disable_fib = 1;
+  args.session_id = sid; args.decap_fib_index = foreign_ip6_fib;
+  clib_memcpy (args.client_mac, mac, 6);
+  CHECK (!vnet_pppoe_add_del_session (&args, &index),
+         "stock IPv6 fixture session creation failed");
+  CHECK (!pppoe_ze_session (PPPOE_ZE_QUERY, boot, owner, mac, sid,
+                            dp, 0, &session) && session.present &&
+         session.sw_if_index == index && session.dp_sw_if_index == dp &&
+         session.table_id == ~0 && !memcmp (session.owner, zero, 16),
+         "foreign IPv6 session exposed an IPv4 table");
+  CHECK (pppoe_ze_session (PPPOE_ZE_ADD, boot, owner, mac, sid, dp, 0,
+                           &session) && session.present &&
+         pppoe_ze_session (PPPOE_ZE_DELETE, boot, owner, mac, sid, dp, 0,
+                           &session) && session.present &&
+         pool_elts (pem->sessions) == 1,
+         "foreign IPv6 session granted mutation ownership"); PASSED ();
+
+done:
+  if (shared_a || shared_b)
+    {
+      /* The source countercut deliberately writes our exact paths under API;
+       * the no-entry precondition above proves those paths are this fixture's.
+       */
+      fib_source_t sources[] = { owned_source, FIB_SOURCE_API };
+      for (u32 i = 0; i < ARRAY_LEN (sources); i++)
+        {
+          if (shared_a)
+            fib_table_entry_path_remove (fib4, &shared, sources[i],
+                                         DPO_PROTO_IP4, &gateway, index, 0, 1, 0);
+          if (shared_b)
+            fib_table_entry_path_remove (fib4, &shared, sources[i],
+                                         DPO_PROTO_IP4, &gateway, sibling, 0, 1, 0);
+        }
+    }
+  if (shared_foreign)
+    fib_table_entry_path_remove (fib4, &shared, FIB_SOURCE_API,
+                                 DPO_PROTO_IP4, &gateway, interfaces[2], 0, 1, 0);
+  if (sibling_live)
+    {
+      vnet_pppoe_add_del_session_args_t peer = { 0 };
+      peer.session_id = sid + 1; peer.decap_fib_index = fib4;
+      peer.disable_fib = !implicit_live;
+      clib_memcpy (peer.client_mac, mac, 6);
+      int clean = vnet_pppoe_add_del_session (&peer, 0);
+      if (clean) error = clib_error_return (error, "ownership sibling cleanup: %d", clean);
+    }
+  /* Also remove only the path the disable_fib countercut could have created.
+   * The initial exact-source absence check excludes another producer's path.
+   */
+  if (stock_source != FIB_SOURCE_INVALID && index != ~0)
+    fib_table_entry_path_remove (fib4, &implicit, stock_source,
+                                 DPO_PROTO_IP4, &implicit.fp_addr, index, ~0, 1, 0);
+  if (route4_installed)
+    fib_table_entry_path_remove (0, &route4, pppoe_ze_route_source (),
+                                 DPO_PROTO_IP4, &gateway, index, 0, 1, 0);
+  if (route6_installed)
+    fib_table_entry_path_remove (0, &route6, pppoe_ze_route_source (),
+                                 DPO_PROTO_IP6, &gateway, index, 0, 1, 0);
+  if (index != ~0 && vnet_sw_interface_is_api_valid (vnet_get_main (), index))
+    {
+      int clean = pppoe_ze_test_fence (index, 0);
+      if (!clean) clean = pppoe_ze_test_fence (index, 1);
+      if (clean) error = clib_error_return (error, "ownership feature cleanup: %d", clean);
+      for (u32 dir = 0; dir < VLIB_N_RX_TX; dir++)
+        if (index < vec_len (pm->policer_index_by_sw_if_index[dir]))
+          pm->policer_index_by_sw_if_index[dir][index] = ~0;
+    }
+  u32 policers[] = { rx, tx, unrelated };
+  for (u32 i = 0; i < ARRAY_LEN (policers); i++)
+    if (policers[i] != ~0 && !pool_is_free_index (pm->policers, policers[i]))
+      {
+        int clean = policer_del (vm, policers[i]);
+        if (clean) error = clib_error_return (error, "ownership policer cleanup: %d", clean);
+      }
+  if (pool_elts (pem->sessions))
+    {
+      args.is_add = 0; args.session_id = sid; args.disable_fib = 1;
+      clib_memcpy (args.client_mac, mac, 6);
+      int clean = vnet_pppoe_add_del_session (&args, 0);
+      if (clean) error = clib_error_return (error, "ownership session cleanup: %d", clean);
+    }
+  if (linked) pppoe_ze_test_link (mac, interfaces[0], 0);
+  if (foreign_ip6_fib != ~0)
+    fib_table_unlock (foreign_ip6_fib, FIB_PROTOCOL_IP6, FIB_SOURCE_API);
+  if (interfaces[0] != ~0 && interfaces[1] != ~0)
+    {
+      if (interfaces[0] < vec_len (pem->cp_if_index_by_sw_if_index) &&
+          pem->cp_if_index_by_sw_if_index[interfaces[0]] == interfaces[1])
+        {
+          int clean = pppoe_add_del_cp (interfaces[1], interfaces[0], 0);
+          if (clean) error = clib_error_return (error, "ownership map cleanup: %d", clean);
+        }
+    }
+  for (u32 i = 0; i < ARRAY_LEN (interfaces); i++)
+    if (interfaces[i] != ~0)
+      {
+        int clean = vnet_delete_loopback_interface (interfaces[i]);
+        if (clean) error = clib_error_return (error, "ownership loopback cleanup: %d", clean);
+      }
+  if (!error)
+    vlib_cli_output (vm, "PPPoE ownership: %u cases passed", cases);
+  return error;
+#undef PASSED
+#undef CHECK
+}
+
+VLIB_CLI_COMMAND (pppoe_ze_test_command, static) = {
+  .path = "test pppoe ownership",
+  .short_help = "test pppoe ownership",
+  .function = pppoe_ze_test,
+};
diff --git a/src/plugins/pppoe/pppoe_ze_vat.h b/src/plugins/pppoe/pppoe_ze_vat.h
new file mode 100644
--- /dev/null
+++ b/src/plugins/pppoe/pppoe_ze_vat.h
@@ -0,0 +1,359 @@
+/* Legacy VAT adapters for the additive owned APIs.
+ * Upstream: https://github.com/FDio/vpp at cbba0451bb0af02a3ab8e163f6f99062782258e6.
+ * Tokens are exactly 32 hexadecimal digits; indices use decimal, including
+ * 4294967295 for the absent binding sentinel. All fields are required in the
+ * order shown by each parser, so a partial request is never sent.
+ * SPDX-License-Identifier: Apache-2.0
+ */
+#include <pppoe/pppoe_ze.h>
+
+static uword
+unformat_pppoe_ze_token (unformat_input_t *input, va_list *args)
+{
+  u8 *out = va_arg (*args, u8 *);
+  u8 *bytes = 0;
+  if (!unformat (input, "%U", unformat_hex_string, &bytes))
+    return 0;
+  int valid = vec_len (bytes) == PPPOE_ZE_TOKEN_BYTES;
+  if (valid)
+    clib_memcpy (out, bytes, PPPOE_ZE_TOKEN_BYTES);
+  vec_free (bytes);
+  return valid;
+}
+
+static void
+pppoe_ze_vat_complete (i32 rv)
+{
+  vat_main_t *vam = &vat_main;
+  if (vam->async_mode)
+    vam->async_errors += rv < 0;
+  else
+    {
+      vam->retval = rv;
+      vam->result_ready = 1;
+    }
+}
+
+static void
+vl_api_pppoe_ze_server_reply_t_handler (vl_api_pppoe_ze_server_reply_t *mp)
+{
+  i32 rv = ntohl (mp->retval);
+  if (!rv)
+    print (vat_main.ofp, "incarnation %U", format_hex_bytes,
+           mp->incarnation, PPPOE_ZE_TOKEN_BYTES);
+  pppoe_ze_vat_complete (rv);
+}
+
+static void
+vl_api_pppoe_ze_session_reply_t_handler (vl_api_pppoe_ze_session_reply_t *mp)
+{
+  i32 rv = ntohl (mp->retval);
+  if (!rv)
+    print (vat_main.ofp, "present %u owner %U sw %u dp %u table %u",
+           mp->present, format_hex_bytes, mp->owner, PPPOE_ZE_TOKEN_BYTES,
+           ntohl (mp->sw_if_index), ntohl (mp->dp_sw_if_index),
+           ntohl (mp->decap_vrf_id));
+  pppoe_ze_vat_complete (rv);
+}
+
+static void
+vl_api_pppoe_ze_cp_reply_t_handler (vl_api_pppoe_ze_cp_reply_t *mp)
+{
+  i32 rv = ntohl (mp->retval);
+  if (!rv)
+    print (vat_main.ofp, "present %u owner %U cp %u dp %u", mp->present,
+           format_hex_bytes, mp->owner, PPPOE_ZE_TOKEN_BYTES,
+           ntohl (mp->cp_sw_if_index), ntohl (mp->dp_sw_if_index));
+  pppoe_ze_vat_complete (rv);
+}
+
+static void
+vl_api_pppoe_ze_policer_reply_t_handler (vl_api_pppoe_ze_policer_reply_t *mp)
+{
+  i32 rv = ntohl (mp->retval);
+  if (!rv)
+    print (vat_main.ofp,
+           "present %u policer %u slot-allocated %u feature-mask %u bound %u",
+           mp->present, ntohl (mp->policer_index), mp->slot_allocated,
+           mp->feature_mask, ntohl (mp->bound_index));
+  pppoe_ze_vat_complete (rv);
+}
+
+static void
+vl_api_pppoe_ze_policer_bind_reply_t_handler
+  (vl_api_pppoe_ze_policer_bind_reply_t *mp)
+{
+  pppoe_ze_vat_complete (ntohl (mp->retval));
+}
+
+static int
+api_pppoe_ze_server (vat_main_t *vam)
+{
+  vl_api_pppoe_ze_server_t *mp;
+  int ret;
+  if (unformat_check_input (vam->input) != UNFORMAT_END_OF_INPUT)
+    return VNET_API_ERROR_INVALID_VALUE;
+  M (PPPOE_ZE_SERVER, mp);
+  S (mp);
+  W (ret);
+  return ret;
+}
+
+static int
+api_pppoe_ze_session (vat_main_t *vam)
+{
+  vl_api_pppoe_ze_session_t *mp;
+  u8 incarnation[PPPOE_ZE_TOKEN_BYTES], owner[PPPOE_ZE_TOKEN_BYTES], mac[6];
+  u32 op, sid, dp, table;
+  int ret;
+  if (!unformat (vam->input,
+                 "incarnation %U owner %U operation %u mac %U sid %u dp %u table %u",
+                 unformat_pppoe_ze_token, incarnation, unformat_pppoe_ze_token,
+                 owner, &op, unformat_ethernet_address, mac, &sid, &dp, &table) ||
+      unformat_check_input (vam->input) != UNFORMAT_END_OF_INPUT ||
+      op > 255 || sid > 65535)
+    return VNET_API_ERROR_INVALID_VALUE;
+  M (PPPOE_ZE_SESSION, mp);
+  mp->operation = op;
+  clib_memcpy (mp->incarnation, incarnation, sizeof (incarnation));
+  clib_memcpy (mp->owner, owner, sizeof (owner));
+  clib_memcpy (mp->client_mac, mac, sizeof (mac));
+  mp->session_id = htons (sid);
+  mp->dp_sw_if_index = htonl (dp);
+  mp->decap_vrf_id = htonl (table);
+  S (mp);
+  W (ret);
+  return ret;
+}
+
+static int
+api_pppoe_ze_cp (vat_main_t *vam)
+{
+  vl_api_pppoe_ze_cp_t *mp;
+  u8 incarnation[PPPOE_ZE_TOKEN_BYTES], owner[PPPOE_ZE_TOKEN_BYTES];
+  u32 op, cp, dp;
+  int ret;
+  if (!unformat (vam->input,
+                 "incarnation %U owner %U operation %u cp %u dp %u",
+                 unformat_pppoe_ze_token, incarnation, unformat_pppoe_ze_token,
+                 owner, &op, &cp, &dp) ||
+      unformat_check_input (vam->input) != UNFORMAT_END_OF_INPUT || op > 255)
+    return VNET_API_ERROR_INVALID_VALUE;
+  M (PPPOE_ZE_CP, mp);
+  mp->operation = op;
+  clib_memcpy (mp->incarnation, incarnation, sizeof (incarnation));
+  clib_memcpy (mp->owner, owner, sizeof (owner));
+  mp->cp_sw_if_index = htonl (cp);
+  mp->dp_sw_if_index = htonl (dp);
+  S (mp);
+  W (ret);
+  return ret;
+}
+
+static int
+api_pppoe_ze_policer (vat_main_t *vam)
+{
+  vl_api_pppoe_ze_policer_t *mp;
+  u8 incarnation[PPPOE_ZE_TOKEN_BYTES], owner[PPPOE_ZE_TOKEN_BYTES];
+  u8 object[PPPOE_ZE_TOKEN_BYTES];
+  u32 sw, direction;
+  int ret;
+  if (!unformat (vam->input,
+                 "incarnation %U owner %U policer-owner %U sw %u direction %u",
+                 unformat_pppoe_ze_token, incarnation, unformat_pppoe_ze_token,
+                 owner, unformat_pppoe_ze_token, object, &sw, &direction) ||
+      unformat_check_input (vam->input) != UNFORMAT_END_OF_INPUT || direction > 255)
+    return VNET_API_ERROR_INVALID_VALUE;
+  M (PPPOE_ZE_POLICER, mp);
+  clib_memcpy (mp->policer_owner, object, sizeof (object));
+  clib_memcpy (mp->incarnation, incarnation, sizeof (incarnation));
+  clib_memcpy (mp->owner, owner, sizeof (owner));
+  mp->sw_if_index = htonl (sw);
+  mp->direction = direction;
+  S (mp);
+  W (ret);
+  return ret;
+}
+
+static int
+api_pppoe_ze_policer_bind (vat_main_t *vam)
+{
+  vl_api_pppoe_ze_policer_bind_t *mp;
+  u8 incarnation[PPPOE_ZE_TOKEN_BYTES], owner[PPPOE_ZE_TOKEN_BYTES];
+  u8 object[PPPOE_ZE_TOKEN_BYTES];
+  u32 sw, direction, expected, desired;
+  int ret;
+  if (!unformat (vam->input,
+                 "incarnation %U owner %U policer-owner %U sw %u direction %u expected %u desired %u",
+                 unformat_pppoe_ze_token, incarnation, unformat_pppoe_ze_token,
+                 owner, unformat_pppoe_ze_token, object,
+                 &sw, &direction, &expected, &desired) ||
+      unformat_check_input (vam->input) != UNFORMAT_END_OF_INPUT || direction > 255)
+    return VNET_API_ERROR_INVALID_VALUE;
+  M (PPPOE_ZE_POLICER_BIND, mp);
+  clib_memcpy (mp->policer_owner, object, sizeof (object));
+  clib_memcpy (mp->incarnation, incarnation, sizeof (incarnation));
+  clib_memcpy (mp->owner, owner, sizeof (owner));
+  mp->sw_if_index = htonl (sw);
+  mp->direction = direction;
+  mp->expected_index = htonl (expected);
+  mp->desired_index = htonl (desired);
+  S (mp);
+  W (ret);
+  return ret;
+}
+
+static void
+vl_api_pppoe_ze_policer_mutate_reply_t_handler
+  (vl_api_pppoe_ze_policer_mutate_reply_t *mp)
+{
+  i32 rv = ntohl (mp->retval);
+  if (!rv)
+    print (vat_main.ofp, "present %u owned %u policer %u cir %u cb %llu",
+           mp->present, mp->owned, ntohl (mp->policer_index),
+           ntohl (mp->cir_kbps), clib_net_to_host_u64 (mp->cb_bytes));
+  pppoe_ze_vat_complete (rv);
+}
+
+static void
+vl_api_pppoe_ze_feature_reply_t_handler (vl_api_pppoe_ze_feature_reply_t *mp)
+{
+  i32 rv = ntohl (mp->retval);
+  if (!rv)
+    print (vat_main.ofp, "enabled %u", mp->enabled);
+  pppoe_ze_vat_complete (rv);
+}
+
+static void
+vl_api_pppoe_ze_route_reply_t_handler (vl_api_pppoe_ze_route_reply_t *mp)
+{
+  pppoe_ze_vat_complete (ntohl (mp->retval));
+}
+
+static int
+api_pppoe_ze_policer_mutate (vat_main_t *vam)
+{
+  vl_api_pppoe_ze_policer_mutate_t *mp;
+  u8 incarnation[16], owner[16], object[16];
+  u32 operation, sw, direction, expected, cir;
+  u64 cb;
+  int ret;
+  if (!unformat (vam->input,
+                 "incarnation %U owner %U policer-owner %U operation %u sw %u direction %u expected %u cir %u cb %llu",
+                 unformat_pppoe_ze_token, incarnation, unformat_pppoe_ze_token,
+                 owner, unformat_pppoe_ze_token, object, &operation, &sw,
+                 &direction, &expected, &cir, &cb) ||
+      unformat_check_input (vam->input) != UNFORMAT_END_OF_INPUT ||
+      operation > 255 || direction > 255)
+    return VNET_API_ERROR_INVALID_VALUE;
+  M (PPPOE_ZE_POLICER_MUTATE, mp);
+  clib_memcpy (mp->incarnation, incarnation, sizeof (incarnation));
+  clib_memcpy (mp->owner, owner, sizeof (owner));
+  clib_memcpy (mp->policer_owner, object, sizeof (object));
+  mp->operation = operation;
+  mp->sw_if_index = htonl (sw);
+  mp->direction = direction;
+  mp->expected_index = htonl (expected);
+  mp->cir_kbps = htonl (cir);
+  mp->cb_bytes = clib_host_to_net_u64 (cb);
+  S (mp);
+  W (ret);
+  return ret;
+}
+
+static int
+api_pppoe_ze_feature (vat_main_t *vam)
+{
+  vl_api_pppoe_ze_feature_t *mp;
+  u8 incarnation[16], owner[16], object[16];
+  u32 operation, sw, selector;
+  int ret;
+  if (!unformat (vam->input,
+                 "incarnation %U owner %U policer-owner %U operation %u sw %u selector %u",
+                 unformat_pppoe_ze_token, incarnation, unformat_pppoe_ze_token,
+                 owner, unformat_pppoe_ze_token, object, &operation, &sw,
+                 &selector) ||
+      unformat_check_input (vam->input) != UNFORMAT_END_OF_INPUT ||
+      operation > 255 || selector > 255)
+    return VNET_API_ERROR_INVALID_VALUE;
+  M (PPPOE_ZE_FEATURE, mp);
+  clib_memcpy (mp->incarnation, incarnation, sizeof (incarnation));
+  clib_memcpy (mp->owner, owner, sizeof (owner));
+  clib_memcpy (mp->policer_owner, object, sizeof (object));
+  mp->operation = operation;
+  mp->sw_if_index = htonl (sw);
+  mp->selector = selector;
+  S (mp);
+  W (ret);
+  return ret;
+}
+
+/* The two addresses use exactly32hex digits in the API address-union layout.
+ * family0 is IPv4 and family1 IPv6; no host-endian address casting occurs.
+ */
+static int
+api_pppoe_ze_route (vat_main_t *vam)
+{
+  vl_api_pppoe_ze_route_t *mp;
+  u8 incarnation[16], owner[16], prefix[16], gateway[16];
+  u32 add, sw, table, family, length, has_gateway, preference;
+  int ret;
+  if (!unformat (vam->input,
+                 "incarnation %U owner %U add %u sw %u table %u family %u prefix %U length %u has-gateway %u gateway %U preference %u",
+                 unformat_pppoe_ze_token, incarnation, unformat_pppoe_ze_token,
+                 owner, &add, &sw, &table, &family, unformat_pppoe_ze_token,
+                 prefix, &length, &has_gateway, unformat_pppoe_ze_token,
+                 gateway, &preference) ||
+      unformat_check_input (vam->input) != UNFORMAT_END_OF_INPUT ||
+      add > 1 || family > 1 || length > (family ? 128 : 32) ||
+      has_gateway > 1 || preference > 255)
+    return VNET_API_ERROR_INVALID_VALUE;
+  M (PPPOE_ZE_ROUTE, mp);
+  clib_memcpy (mp->incarnation, incarnation, sizeof (incarnation));
+  clib_memcpy (mp->owner, owner, sizeof (owner));
+  mp->is_add = add;
+  mp->sw_if_index = htonl (sw);
+  mp->table_id = htonl (table);
+  mp->destination.address.af = family;
+  mp->destination.len = length;
+  clib_memcpy (&mp->destination.address.un, prefix, sizeof (prefix));
+  mp->gateway_present = has_gateway;
+  mp->gateway.af = family;
+  clib_memcpy (&mp->gateway.un, gateway, sizeof (gateway));
+  mp->preference = preference;
+  S (mp);
+  W (ret);
+  return ret;
+}
+
+static void
+vl_api_pppoe_ze_interface_reply_t_handler (vl_api_pppoe_ze_interface_reply_t *mp)
+{
+  i32 rv = ntohl (mp->retval);
+  if (!rv)
+    print (vat_main.ofp, "actual %u", ntohl (mp->actual));
+  pppoe_ze_vat_complete (rv);
+}
+
+static int
+api_pppoe_ze_interface (vat_main_t *vam)
+{
+  vl_api_pppoe_ze_interface_t *mp;
+  u8 incarnation[16], owner[16];
+  u32 sw, kind, value;
+  int ret;
+  if (!unformat (vam->input, "incarnation %U owner %U sw %u kind %u value %u",
+                 unformat_pppoe_ze_token, incarnation, unformat_pppoe_ze_token,
+                 owner, &sw, &kind, &value) ||
+      unformat_check_input (vam->input) != UNFORMAT_END_OF_INPUT || kind > 255)
+    return VNET_API_ERROR_INVALID_VALUE;
+  M (PPPOE_ZE_INTERFACE, mp);
+  clib_memcpy (mp->incarnation, incarnation, sizeof (incarnation));
+  clib_memcpy (mp->owner, owner, sizeof (owner));
+  mp->sw_if_index = htonl (sw);
+  mp->kind = kind;
+  mp->value = htonl (value);
+  S (mp);
+  W (ret);
+  return ret;
+}
