From: Ze contributors
Subject: [PATCH] pppoe: number session details replies from the plugin base

send_pppoe_session_details stamps each reply with the plugin-relative
VL_API_PPPOE_SESSION_DETAILS and never adds the plugin's message ID base,
so a pppoe_session_dump answer arrives under an unrelated core message ID
and no client can decode it as a session. Every other pppoe reply adds the
base, through REPLY_MSG_ID_BASE or explicitly (cp_binding_dump, 0031).

Upstream: https://github.com/FDio/vpp at cbba0451bb0af02a3ab8e163f6f99062782258e6
(the same line is unchanged on master).

diff --git a/src/plugins/pppoe/pppoe_api.c b/src/plugins/pppoe/pppoe_api.c
--- a/src/plugins/pppoe/pppoe_api.c
+++ b/src/plugins/pppoe/pppoe_api.c
@@ -75,11 +75,12 @@ static void send_pppoe_session_details
 {
   vl_api_pppoe_session_details_t *rmp;
+  pppoe_main_t *pem = &pppoe_main;
   ip4_main_t *im4 = &ip4_main;
   ip6_main_t *im6 = &ip6_main;
   u8 is_ipv6 = !ip46_address_is_ip4 (&t->client_ip);
 
   rmp = vl_msg_api_alloc (sizeof (*rmp));
   clib_memset (rmp, 0, sizeof (*rmp));
-  rmp->_vl_msg_id = ntohs (VL_API_PPPOE_SESSION_DETAILS);
+  rmp->_vl_msg_id = ntohs (pem->msg_id_base + VL_API_PPPOE_SESSION_DETAILS);
   ip_address_encode (&t->client_ip, is_ipv6 ? IP46_TYPE_IP6 : IP46_TYPE_IP4,
 		     &rmp->client_ip);
