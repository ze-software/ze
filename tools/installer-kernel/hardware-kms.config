# KMS display profile for the ze installer kernel.
#
# Extends hardware.config with Intel i915 KMS so the kernel can reprogram
# the display controller after ExitBootServices(). Required on Intel Alder
# Lake-N / Twin Lake iGPUs (N100, N150, N200, N305) where firmware drops
# monitor output at EBS handover.
#
# Cost: ~50-80 MB kernel size increase, ~1-3 s extra boot time, pulls in
# firmware blob loading. Use the plain "hardware" profile for headless or
# serial-console installs.

# DRM/KMS core (CONFIG_DRM=y already in hardware.config).
CONFIG_DRM_KMS_HELPER=y

# Intel i915 KMS driver.
CONFIG_DRM_I915=y

# Backlight support (required dependency for i915).
CONFIG_BACKLIGHT_CLASS_DEVICE=y

# Firmware loading (i915 needs GuC/HuC/DMC firmware blobs).
CONFIG_FW_LOADER=y
