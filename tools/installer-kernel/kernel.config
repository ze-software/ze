# Config fragment for the ze installer kernel.
#
# The installer initrd (tools/installer-initrd) is a busybox cpio that carries
# NO kernel modules and relies on the kernel having configured the network via
# `ip=dhcp` before /init runs. Everything it touches must therefore be built in
# (=y), not a module:
#
#   - kernel-level IP autoconfiguration (ze.server is reached over it)
#   - virtio NIC + virtio block (QEMU virt target disk)
#   - ext4 (the /perm partition the initrd mounts)
#   - initramfs + devtmpfs (so /init and /dev exist)
#
# Merged onto `make defconfig` via scripts/kconfig/merge_config.sh.

CONFIG_IP_PNP=y
CONFIG_IP_PNP_DHCP=y
CONFIG_IP_PNP_BOOTP=y

CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_BLK=y

CONFIG_BLK_DEV_SD=y
CONFIG_SCSI=y

CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y

CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Serial console for headless QEMU (arm64 virt = PL011 ttyAMA0; x86 = 8250 ttyS0).
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
