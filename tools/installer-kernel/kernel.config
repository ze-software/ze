# Base config fragment for the ze installer kernel.
#
# The installer initrd (tools/installer-initrd) is a busybox cpio that carries
# NO kernel modules and relies on the kernel having configured the network via
# `ip=dhcp` before /init runs. Everything it touches must therefore be built in
# (=y), not a module:
#
#   - kernel-level IP autoconfiguration (ze.server is reached over it)
#   - SCSI layer + ISO9660/ext4 (installer media and target disk)
#   - initramfs + devtmpfs (so /init and /dev exist)
#
# Profile-specific drivers (NIC, disk, framebuffer) are in qemu.config or
# hardware.config. Select them with `ze appliance kernel --profile <name>`.

CONFIG_IP_PNP=y
CONFIG_IP_PNP_DHCP=y
CONFIG_IP_PNP_BOOTP=y

CONFIG_BLK_DEV_SD=y
CONFIG_SCSI=y

CONFIG_CDROM=y
CONFIG_BLK_DEV_SR=y
CONFIG_ISO9660_FS=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y

CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Serial console (arm64 virt = PL011 ttyAMA0; x86 = 8250 ttyS0).
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
