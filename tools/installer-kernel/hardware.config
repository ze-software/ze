# Real hardware profile for the ze installer kernel.
#
# Adds EFI boot, framebuffer console, real NIC drivers, real disk
# controllers, USB mass storage, and Ventoy-compatible loop/FAT/exFAT
# support on top of the base config. Also includes virtio so the same
# kernel works under both QEMU and bare metal.

# Virtio (keep for mixed use).
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_BLK=y

# EFI boot (required for UEFI firmware and iPXE EFI chainload).
CONFIG_EFI=y
CONFIG_EFI_STUB=y

# Framebuffer console so console=tty0 produces visible output on EFI hardware.
CONFIG_FB=y
CONFIG_FB_EFI=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_X86_SYSFB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_DRM=y

# NIC drivers (server and desktop NICs for ip=dhcp).
CONFIG_NET_VENDOR_INTEL=y
CONFIG_E1000=y
CONFIG_E1000E=y
CONFIG_IGB=y
CONFIG_IGBVF=y
CONFIG_IGC=y
CONFIG_I40E=y
CONFIG_ICE=y
CONFIG_NET_VENDOR_REALTEK=y
CONFIG_R8169=y
CONFIG_NET_VENDOR_BROADCOM=y
CONFIG_BNXT=y
CONFIG_TIGON3=y
CONFIG_NET_VENDOR_MELLANOX=y
CONFIG_MLX4_EN=y
CONFIG_MLX5_CORE=y
CONFIG_MLX5_CORE_EN=y

# Disk controllers (SATA/NVMe for target disk).
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_BLK_DEV_NVME=y

# USB mass storage (Ventoy USB sticks, USB-attached install media).
CONFIG_USB=y
CONFIG_USB_SUPPORT=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_STORAGE=y

# Loop device + FAT/exFAT filesystems for Ventoy compatibility.
# Ventoy places the ISO as a file on a FAT32/exFAT partition; the initrd
# mounts that partition, then loop-mounts the ISO to access ze-install/.
CONFIG_BLK_DEV_LOOP=y
CONFIG_VFAT_FS=y
CONFIG_FAT_FS=y
CONFIG_EXFAT_FS=y
CONFIG_NLS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
