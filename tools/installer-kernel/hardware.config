# Real hardware profile for the ze installer kernel.
#
# Adds EFI boot, framebuffer console, real NIC drivers, and real disk
# controllers on top of the base config. Also includes virtio so the same
# kernel works under both QEMU and bare metal.

# Virtio (keep for mixed use).
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_BLK=y

# EFI boot (required for UEFI firmware and iPXE EFI chainload).
CONFIG_EFI=y
CONFIG_EFI_STUB=y

# Framebuffer console so console=tty0 produces visible output on EFI hardware.
CONFIG_FB=y
CONFIG_FB_EFI=y
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y

# NIC drivers (server and desktop NICs for ip=dhcp).
CONFIG_NET_VENDOR_INTEL=y
CONFIG_E1000=y
CONFIG_E1000E=y
CONFIG_IGB=y
CONFIG_IGBVF=y
CONFIG_I40E=y
CONFIG_ICE=y
CONFIG_NET_VENDOR_REALTEK=y
CONFIG_R8169=y
CONFIG_NET_VENDOR_BROADCOM=y
CONFIG_BNXT=y
CONFIG_TIGON3=y
CONFIG_NET_VENDOR_MELLANOX=y
CONFIG_MLX4_EN=y
CONFIG_MLX5_CORE=y
CONFIG_MLX5_CORE_EN=y

# Disk controllers (SATA/NVMe for target disk).
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_BLK_DEV_NVME=y
