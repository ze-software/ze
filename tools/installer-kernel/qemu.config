# QEMU/emulation profile for the ze installer kernel.
#
# Virtio NIC, block and SCSI: the drivers needed under QEMU virt. The arm64
# virt machine has no IDE, so an installer ISO reaches the guest as a SCSI
# CD-ROM on virtio-scsi; without SCSI_VIRTIO the kernel never sees its media.
# No framebuffer or EFI stub (QEMU uses serial console).

CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_BLK=y
CONFIG_SCSI_VIRTIO=y
