# Shared EFI framebuffer + Fintek serial console fragment.
#
# Pulled in by both the runtime kernel (gokrazy/kernel/kernel.config) and the
# installer "hardware" profile (tools/installer-kernel/hardware.config) via a
# `# ze-include: efi-console` directive, so the verified-identical console
# subset lives in exactly one place. Each profile keeps its OWN divergent
# symbols local (runtime: SERIAL_8250 / SERIAL_8250_CONSOLE / DRM_FBDEV_EMULATION;
# hardware: DRM); the installer "qemu" profile does NOT include this fragment.
#
# Fintek Super-IO serial (Alder Lake-N / Twin Lake N150 and similar): these
# boards expose ttyS0/ttyS1 via a Fintek Super-IO whose UARTs use a non-standard
# base clock; without this driver the generic 8250 programs the wrong divisor
# and console=ttyS0 is silent at the requested baud.
CONFIG_SERIAL_8250_FINTEK=y

# EFI framebuffer console. Linux 7 removed simplefb; simpledrm is the
# replacement. X86_SYSFB hands the EFI framebuffer to simpledrm on x86.
CONFIG_DRM_SIMPLEDRM=y
CONFIG_X86_SYSFB=y
CONFIG_FB=y
CONFIG_FB_EFI=y
CONFIG_FRAMEBUFFER_CONSOLE=y
