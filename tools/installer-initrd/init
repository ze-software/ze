#!/bin/sh
# PID 1 init script for ze installer initrd.
# Installs a gokrazy disk image onto a target disk. The default PXE source
# downloads image bytes from a ze-install HTTP server, injects a pre-provisioned
# zefs database onto partition 4 (/perm), and reboots. ISO source mode mounts
# the boot media read-only, writes the embedded appliance image unchanged, and
# powers off so the removable media can be removed before the next boot.
#
# Kernel cmdline parameters:
#   ze.source=http|iso   (optional) source mode, defaults to "http"
#   ze.server=<ip>       (required for http) ze-install server IP address
#   ze.image=<name>      (optional) image name, defaults to "ze.img"
#   ze.port=<port>       (optional for http) install HTTP port, defaults to 80
#   ze.target=<disk>     (optional) explicit target disk, for example /dev/vda
#   ze.wait=<N>          (optional) max server probe attempts, defaults to 30
#                        (set to 0 to skip; sites with portfast need 0)
#   ze.media-id=<hex32>  (required for iso) identifies the booted installer media

set -e

RETRY_MAX=3
RETRY_DELAY=5
WGET_TIMEOUT=10
ISO_SCAN_MAX=10
ISO_SCAN_DELAY=1

# Scratch files for transfer failure detection and checksum verification.
# A POSIX pipeline reports only the exit status of its LAST command, so a
# `wget | dd` would mask a wget failure: the marker file records it instead.
WGET_FAIL_MARKER="/tmp/ze-wget.fail"
HASH_FILE="/tmp/ze-image.sha256"
WGET_ERR="/tmp/ze-wget.err"
WGET_RC_FILE="/tmp/ze-wget.rc"
ISO_MOUNT="/mnt/iso"
VENTOY_DATA_MOUNT="/mnt/ventoy"
VENTOY_USB_DISK=""

# -- helpers --

log() {
    echo "[ze-install] $1"
}

fatal() {
    echo "[ze-install] FATAL: $1" >&2
    echo "[ze-install] Dropping to shell for debugging."
    exec /bin/sh
}

# -- cmdline parsing --

parse_cmdline() {
    ZE_SOURCE="http"
    ZE_SERVER=""
    ZE_IMAGE="ze.img"
    ZE_PORT="80"
    ZE_TARGET=""
    ZE_WAIT="30"
    ZE_MEDIA_ID=""

    if [ ! -f /proc/cmdline ]; then
        return
    fi

    for param in $(cat /proc/cmdline); do
        case "$param" in
            ze.source=*)
                ZE_SOURCE="${param#ze.source=}"
                ;;
            ze.server=*)
                ZE_SERVER="${param#ze.server=}"
                ;;
            ze.image=*)
                ZE_IMAGE="${param#ze.image=}"
                ;;
            ze.port=*)
                ZE_PORT="${param#ze.port=}"
                ;;
            ze.target=*)
                ZE_TARGET="${param#ze.target=}"
                ;;
            ze.wait=*)
                ZE_WAIT="${param#ze.wait=}"
                ;;
            ze.media-id=*)
                ZE_MEDIA_ID="${param#ze.media-id=}"
                ;;
        esac
    done
}

validate_ipv4() {
    case "$1" in
        ""|*[!0-9.]*)
            return 1
            ;;
    esac

    old_ifs="$IFS"
    IFS='.'
    set -- $1
    IFS="$old_ifs"

    [ $# -eq 4 ] || return 1

    for octet in "$@"; do
        [ -z "$octet" ] && return 1
        # Reject non-canonical leading zeros (e.g. 08, 00). This also keeps the
        # range test below from interpreting "08"/"09" as invalid octal.
        case "$octet" in
            0?*) return 1 ;;
        esac
        [ "$octet" -ge 0 ] 2>/dev/null && [ "$octet" -le 255 ] || return 1
    done

    return 0
}

# validate_port accepts a decimal TCP port in 1..65535. ze.port comes from the
# kernel cmdline; restricting it keeps a crafted value out of the download URL.
validate_port() {
    case "$1" in
        ""|*[!0-9]*) return 1 ;;
    esac
    [ "$1" -ge 1 ] 2>/dev/null && [ "$1" -le 65535 ] || return 1
    return 0
}

# validate_image_name accepts only safe filename characters. ze.image comes
# from the kernel cmdline (set by the DHCP/TFTP server); restricting it blocks
# path traversal, HTTP header injection via newlines, and terminal-escape
# injection into the serial console log if a rogue server sets it.
validate_image_name() {
    case "$1" in
        ""|*[!a-zA-Z0-9._-]*)
            return 1
            ;;
    esac
    return 0
}

validate_source() {
    case "$1" in
        http|iso)
            return 0
            ;;
    esac
    return 1
}

validate_media_id() {
    case "$1" in
        ""|*[!0-9a-f]*)
            return 1
            ;;
    esac
    [ ${#1} -eq 32 ]
}
validate_decimal() {
    case "$1" in
        ""|*[!0-9]*)
            return 1
            ;;
    esac
    return 0
}

validate_target_path() {
    case "$1" in
        /dev/*)
            ;;
        *)
            return 1
            ;;
    esac

    name="${1#/dev/}"
    case "$name" in
        ""|*[!a-zA-Z0-9_-]*)
            return 1
            ;;
        sd*[!a-z]*|vd*[!a-z]*|xvd*[!a-z]*|hd*[!a-z]*)
            return 1
            ;;
        sd?*|vd?*|xvd?*|hd?*)
            return 0
            ;;
        nvme*n*)
            controller="${name#nvme}"
            namespace="${controller#*n}"
            controller="${controller%%n*}"
            validate_decimal "$controller" && validate_decimal "$namespace"
            return
            ;;
        mmcblk*)
            index="${name#mmcblk}"
            validate_decimal "$index"
            return
            ;;
    esac
    return 1
}

validate_sha256() {
    sha="$1"
    [ ${#sha} -eq 64 ] || return 1
    case "$sha" in
        *[!0-9a-fA-F]*)
            return 1
            ;;
    esac
    return 0
}

read_expected_sha() {
    sha_file="$1"
    expected=""
    read -r expected _ < "$sha_file" || true
    validate_sha256 "$expected" || return 1
    printf '%s\n' "$expected"
}

# -- disk detection --

disk_name_from_path() {
    name="${1#/dev/}"
    case "$name" in
        nvme*p[0-9]*|mmcblk*p[0-9]*)
            echo "${name%p[0-9]*}"
            ;;
        sd*[0-9]|vd*[0-9]|xvd*[0-9]|hd*[0-9])
            while :; do
                case "$name" in
                    *[0-9]) name="${name%?}" ;;
                    *) break ;;
                esac
            done
            echo "$name"
            ;;
        *)
            echo "$name"
            ;;
    esac
}

is_skipped_disk_name() {
    case "$1" in
        loop*|ram*|dm-*|sr*|fd*|md*|zram*|mtdblock*)
            return 0
            ;;
    esac
    return 1
}

is_source_disk_name() {
    if [ -n "$ISO_SOURCE_DISK" ] && [ "$1" = "$ISO_SOURCE_DISK" ]; then
        return 0
    fi
    if [ -n "$VENTOY_USB_DISK" ] && [ "$1" = "$VENTOY_USB_DISK" ]; then
        return 0
    fi
    return 1
}

find_target_disk() {
    TARGET_DISK=""
    TARGET_DISK_ERROR=""

    if [ -n "$ZE_TARGET" ]; then
        if ! validate_target_path "$ZE_TARGET"; then
            TARGET_DISK_ERROR="ze.target '$ZE_TARGET' is not a supported whole-disk /dev path"
            return
        fi
        if [ ! -b "$ZE_TARGET" ]; then
            TARGET_DISK_ERROR="ze.target '$ZE_TARGET' is not a block device"
            return
        fi
        target_name="$(disk_name_from_path "$ZE_TARGET")"
        if is_source_disk_name "$target_name"; then
            TARGET_DISK_ERROR="ze.target '$ZE_TARGET' is the ISO source media"
            return
        fi
        TARGET_DISK="$ZE_TARGET"
        return
    fi

    count=0
    for dev in /sys/block/*; do
        [ -d "$dev" ] || continue
        name="$(basename "$dev")"

        if is_skipped_disk_name "$name"; then
            continue
        fi
        if is_source_disk_name "$name"; then
            continue
        fi

        if [ -f "$dev/removable" ]; then
            removable="$(cat "$dev/removable")"
            if [ "$removable" = "1" ]; then
                continue
            fi
        fi

        count=$((count + 1))
        if [ "$count" -eq 1 ]; then
            TARGET_DISK="/dev/$name"
            if [ "$ZE_SOURCE" != "iso" ]; then
                break
            fi
            continue
        fi
        if [ "$ZE_SOURCE" = "iso" ]; then
            TARGET_DISK=""
            TARGET_DISK_ERROR="multiple target disks found; set ze.target=/dev/<disk> on the kernel command line"
            return
        fi
    done
}

# -- partition detection --

find_partition_4() {
    PART4=""

    case "$TARGET_DISK" in
        /dev/nvme*|/dev/mmcblk*)
            PART4="${TARGET_DISK}p4"
            ;;
        *)
            PART4="${TARGET_DISK}4"
            ;;
    esac
}

# -- download with retry --

download() {
    url="$1"
    dest="$2"
    attempt=1
    dl_retry_delay="$RETRY_DELAY"

    while [ "$attempt" -le "$RETRY_MAX" ]; do
        log "Downloading $url (attempt $attempt/$RETRY_MAX)"
        dl_err="/tmp/ze-dl.err"
        if wget -T "$WGET_TIMEOUT" -q -O "$dest" "$url" 2>"$dl_err"; then
            return 0
        fi
        dl_rc=$?
        if [ -s "$dl_err" ]; then
            log "  wget failed (rc=$dl_rc): $(cat "$dl_err")"
        else
            log "  wget failed (rc=$dl_rc)"
        fi
        attempt=$((attempt + 1))
        if [ "$attempt" -le "$RETRY_MAX" ]; then
            sleep "$dl_retry_delay"
            dl_retry_delay=$((dl_retry_delay * 2))
        fi
    done

    return 1
}

# download_to_disk streams an image from $url straight onto block device
# $disk (no intermediate file, so it works in a RAM-constrained initrd) and,
# when $expected_sha is non-empty, verifies the bytes written match that
# SHA-256 before declaring success.
#
# Correctness note: `wget | dd` cannot be trusted on its own. Under POSIX sh
# (busybox ash) the pipeline's exit status is dd's, so a wget that dies
# mid-stream (connection reset, server error, truncated body) leaves dd
# exiting 0 -- a partial image silently accepted, then booted on a disk we
# just wiped. Two guards close that hole:
#   1. wget failure is captured into $WGET_FAIL_MARKER inside the pipe.
#   2. the streamed bytes are hashed in one pass via a FIFO and compared to
#      the server-provided checksum.
download_to_disk() {
    url="$1"
    disk="$2"
    expected_sha="$3"   # optional; empty disables checksum verification
    attempt=1
    local_retry_delay="$RETRY_DELAY"

    while [ "$attempt" -le "$RETRY_MAX" ]; do
        log "Streaming $url to $disk (attempt $attempt/$RETRY_MAX)"
        rm -f "$WGET_FAIL_MARKER" "$HASH_FILE" "$WGET_RC_FILE"

        fifo="$(mktemp -u)"
        mkfifo "$fifo"
        sha256sum < "$fifo" > "$HASH_FILE" &
        hash_pid=$!

        # tee fans the stream out to the hashing FIFO and onward to dd. wget's
        # own exit status is recorded into $WGET_RC_FILE inside the subshell so
        # it survives the pipeline (a POSIX pipeline reports only dd's status).
        # The pipeline lives in an `if` so `set -e` never aborts on a dd
        # failure here: failures must flow into the retry loop below, not kill
        # the script. (Do not rely on the caller's context to suppress -e.)
        if { wget -T "$WGET_TIMEOUT" -q -O - "$url" 2>"$WGET_ERR"; echo $? > "$WGET_RC_FILE"; } \
            | tee "$fifo" \
            | dd of="$disk" bs=4M 2>/dev/null; then
            dd_rc=0
        else
            dd_rc=$?
        fi

        wait "$hash_pid" 2>/dev/null || true
        rm -f "$fifo"

        read -r wget_rc < "$WGET_RC_FILE" 2>/dev/null || wget_rc=1
        if [ "$wget_rc" != "0" ]; then
            : > "$WGET_FAIL_MARKER"
        fi

        if [ "$dd_rc" -ne 0 ] || [ -f "$WGET_FAIL_MARKER" ]; then
            log "Transfer failed (dd status $dd_rc, wget rc ${wget_rc})"
            if [ -s "$WGET_ERR" ]; then
                log "wget: $(cat "$WGET_ERR")"
            fi
            if [ "$attempt" -eq 1 ]; then
                log "DIAG net: route=$(cat /proc/net/route 2>&1 | tr '\n' ';')"
                diag_n="$(wget -T "$WGET_TIMEOUT" -O - "$url" 2>/tmp/ze-diag.err | wc -c)"
                diag_rc=$?
                log "DIAG direct: bytes=${diag_n} piperc=${diag_rc} err=[$(cat /tmp/ze-diag.err 2>/dev/null)]"
            fi
        elif [ -z "$expected_sha" ]; then
            return 0
        else
            actual_sha=""
            read -r actual_sha _ < "$HASH_FILE" 2>/dev/null || true
            if [ "$actual_sha" = "$expected_sha" ]; then
                return 0
            fi
            log "Checksum mismatch: expected $expected_sha, got ${actual_sha:-<none>}"
        fi

        attempt=$((attempt + 1))
        if [ "$attempt" -le "$RETRY_MAX" ]; then
            sleep "$local_retry_delay"
            local_retry_delay=$((local_retry_delay * 2))
        fi
    done

    return 1
}


# -- ISO local media --

find_iso_media() {
    ISO_SOURCE_DEV=""
    ISO_SOURCE_DISK=""
    mkdir -p "$ISO_MOUNT"

    for dev in /sys/block/*; do
        [ -d "$dev" ] || continue
        name="$(basename "$dev")"
        is_skipped_disk_name "$name" && continue
        for node in "/dev/$name" /dev/"$name"[0-9]* /dev/"$name"p[0-9]*; do
            [ -b "$node" ] || continue
            if mount -t iso9660 -o ro "$node" "$ISO_MOUNT" 2>/dev/null; then
                media_id_path="$ISO_MOUNT/ze-install/media-id"
                if [ -f "$ISO_MOUNT/ze-install/manifest.json" ] && [ -f "$ISO_MOUNT/ze-install/images/$ZE_IMAGE" ] && [ -f "$media_id_path" ]; then
                    candidate_media_id="$(cat "$media_id_path" 2>/dev/null)"
                    if [ "$candidate_media_id" = "$ZE_MEDIA_ID" ]; then
                        ISO_SOURCE_DEV="$node"
                        ISO_SOURCE_DISK="$(disk_name_from_path "$node")"
                        return 0
                    fi
                fi
                umount "$ISO_MOUNT" 2>/dev/null || true
            fi
        done
    done

    return 1
}

# Search FAT/exFAT partitions for ISO files containing our installer media.
# Handles Ventoy and similar multi-boot USB tools where the ISO is a file on
# a FAT partition rather than written directly to the device. On success,
# sets ISO_SOURCE_DEV, ISO_SOURCE_DISK, VENTOY_USB_DISK and leaves the ISO
# mounted at ISO_MOUNT.
try_loop_mount_iso() {
    for i in 0 1 2 3 4 5 6 7; do
        [ -b "/dev/loop$i" ] || mknod "/dev/loop$i" b 7 "$i" 2>/dev/null || true
    done
    mkdir -p "$VENTOY_DATA_MOUNT"

    for dev in /sys/block/*; do
        [ -d "$dev" ] || continue
        name="$(basename "$dev")"
        is_skipped_disk_name "$name" && continue

        for node in /dev/"$name"[0-9]* /dev/"$name"p[0-9]*; do
            [ -b "$node" ] || continue

            part_mounted=0
            for fstype in vfat exfat; do
                if mount -t "$fstype" -o ro "$node" "$VENTOY_DATA_MOUNT" 2>/dev/null; then
                    part_mounted=1
                    break
                fi
            done
            [ "$part_mounted" = "1" ] || continue

            for iso in "$VENTOY_DATA_MOUNT"/*.iso "$VENTOY_DATA_MOUNT"/*/*.iso; do
                [ -f "$iso" ] || continue

                loop_dev=""
                for i in 0 1 2 3 4 5 6 7; do
                    if losetup "/dev/loop$i" "$iso" 2>/dev/null; then
                        loop_dev="/dev/loop$i"
                        break
                    fi
                done
                [ -n "$loop_dev" ] || continue

                if mount -t iso9660 -o ro "$loop_dev" "$ISO_MOUNT" 2>/dev/null; then
                    media_id_path="$ISO_MOUNT/ze-install/media-id"
                    if [ -f "$ISO_MOUNT/ze-install/manifest.json" ] && \
                       [ -f "$ISO_MOUNT/ze-install/images/$ZE_IMAGE" ] && \
                       [ -f "$media_id_path" ]; then
                        candidate_media_id="$(cat "$media_id_path" 2>/dev/null)"
                        if [ "$candidate_media_id" = "$ZE_MEDIA_ID" ]; then
                            ISO_SOURCE_DEV="$loop_dev"
                            ISO_SOURCE_DISK="$(disk_name_from_path "$loop_dev")"
                            VENTOY_USB_DISK="$name"
                            log "Found installer ISO on $node via $loop_dev"
                            return 0
                        fi
                    fi
                    umount "$ISO_MOUNT" 2>/dev/null || true
                fi
                losetup -d "$loop_dev" 2>/dev/null || true
            done

            umount "$VENTOY_DATA_MOUNT" 2>/dev/null || true
        done
    done

    return 1
}

local_image_to_disk() {
    image="$1"
    checksum="$2"
    disk="$3"

    expected_sha="$(read_expected_sha "$checksum")" || return 1
    if ! actual_line="$(sha256sum "$image" 2>/dev/null)"; then
        return 1
    fi
    actual_sha=""
    set -- $actual_line
    actual_sha="$1"
    if [ "$actual_sha" != "$expected_sha" ]; then
        log "Checksum mismatch: expected $expected_sha, got ${actual_sha:-<none>}"
        return 1
    fi

    log "Local image checksum verified: $expected_sha"
    case "$image" in
        *.gz)
            log "Decompressing gzip image to $disk..."
            gz_fail="/tmp/ze-gunzip.fail"
            rm -f "$gz_fail"
            { gunzip -c "$image" 2>/dev/null || : > "$gz_fail"; } | dd of="$disk" bs=4M 2>/dev/null
            if [ -f "$gz_fail" ]; then
                log "Decompression failed"
                rm -f "$gz_fail"
                return 1
            fi
            ;;
        *)
            dd if="$image" of="$disk" bs=4M 2>/dev/null
            ;;
    esac
}

# -- network fallback --
# Kernel ip=dhcp runs at driver-probe time, before NIC link is up on some
# hardware (e.g. Intel I226-V: driver binds at ~4 s, carrier at ~8 s).
# When that race loses, no interface has an address. This function brings
# up all NICs, waits for carrier, and runs udhcpc as a fallback.

has_default_route() {
    [ -f /proc/net/route ] || return 1
    while read -r iface dest _; do
        case "$iface" in Iface) continue ;; esac
        if [ "$dest" = "00000000" ]; then
            return 0
        fi
    done < /proc/net/route
    return 1
}

# link_up requires an ioctl; no sysfs-only alternative exists.
link_up() {
    ip link set "$1" up 2>/dev/null
}

ensure_network() {
    if has_default_route; then
        return 0
    fi

    log "No IPv4 address from kernel ip=dhcp, trying userspace DHCP..."

    for iface in /sys/class/net/*; do
        ifname=$(basename "$iface")
        case "$ifname" in lo) continue ;; esac
        link_up "$ifname"
    done

    carrier_found=0
    waited=0
    while [ "$waited" -lt 10 ]; do
        for carrier in /sys/class/net/*/carrier; do
            case "$carrier" in */lo/carrier) continue ;; esac
            if [ "$(cat "$carrier" 2>/dev/null)" = "1" ]; then
                carrier_found=1
                break 2
            fi
        done
        sleep 1
        waited=$((waited + 1))
    done

    if [ "$carrier_found" = "0" ]; then
        log "WARNING: no NIC carrier detected after ${waited}s"
        return 1
    fi

    for iface in /sys/class/net/*; do
        ifname=$(basename "$iface")
        case "$ifname" in lo) continue ;; esac
        if udhcpc -i "$ifname" -t 5 -n -q 2>/dev/null; then
            log "Got DHCP lease on $ifname"
            return 0
        fi
    done

    log "WARNING: userspace DHCP failed on all interfaces"
    return 1
}

log_network_state() {
    for iface in /sys/class/net/*; do
        ifname=$(basename "$iface")
        case "$ifname" in lo) continue ;; esac
        carrier="$(cat "$iface/carrier" 2>/dev/null || echo "?")"
        operstate="$(cat "$iface/operstate" 2>/dev/null || echo "?")"
        log "  $ifname: carrier=$carrier operstate=$operstate"
    done
    if [ -f /proc/net/route ]; then
        while read -r iface dest gw _ _ _ _ mask _; do
            case "$iface" in Iface) continue ;; esac
            log "  route: $iface dest=$dest gw=$gw mask=$mask"
        done < /proc/net/route
    fi
}

wait_for_server() {
    server="$1"
    port="$2"
    max_attempts="$3"
    attempt=0

    log "Checking connectivity to $server:$port..."
    while [ "$attempt" -lt "$max_attempts" ]; do
        probe_err="/tmp/ze-probe.err"
        if wget -T 2 --spider -q "http://${server}:${port}/" 2>"$probe_err"; then
            log "Server reachable (attempt $((attempt + 1))/$max_attempts)"
            return 0
        fi
        # --spider returns non-zero for HTTP errors too; a 404 still proves
        # the TCP connection succeeded. Only "can't connect" means unreachable.
        if [ -s "$probe_err" ] && ! grep -q "can't connect" "$probe_err" 2>/dev/null; then
            log "Server reachable (attempt $((attempt + 1))/$max_attempts, got HTTP response)"
            return 0
        fi
        if [ "$attempt" = "0" ] || [ "$((attempt % 10))" = "0" ]; then
            log "Waiting for server (attempt $((attempt + 1))/$max_attempts)..."
            if [ -s "$probe_err" ]; then
                log "  probe: $(cat "$probe_err")"
            fi
            log_network_state
        fi
        sleep 1
        attempt=$((attempt + 1))
    done

    log "Server not reachable after $max_attempts attempts"
    log_network_state
    return 1
}

# -- main --

main() {
    log "Ze installer initrd starting"

    # Defense in depth: symlink every applet busybox provides into /bin so a
    # command added to this script later cannot silently 404 at boot the way
    # `cut`/`mkfifo`/`sha256sum` once did. The Makefile also symlinks the known
    # set explicitly (deterministic even if this busybox lacks the installer
    # feature); this line covers anything that list misses.
    /bin/busybox --install -s /bin 2>/dev/null || true

    mount -t proc none /proc 2>/dev/null || true
    mount -t sysfs none /sys 2>/dev/null || true
    mount -t devtmpfs none /dev 2>/dev/null || true
    mkdir -p /mnt/perm "$ISO_MOUNT"

    parse_cmdline

    if ! validate_source "$ZE_SOURCE"; then
        fatal "ze.source '$ZE_SOURCE' is not supported (expected http or iso)"
    fi

    if [ "$ZE_SOURCE" = "iso" ] && ! validate_media_id "$ZE_MEDIA_ID"; then
        fatal "ze.media-id '$ZE_MEDIA_ID' is missing or invalid for ISO source mode"
    fi

    # Reject before logging or using in a URL/path: the raw value is not echoed
    # so a crafted name cannot inject terminal escapes into the console here.
    if ! validate_image_name "$ZE_IMAGE"; then
        fatal "ze.image contains invalid characters (allowed: a-z A-Z 0-9 . _ -)"
    fi

    log "Source: $ZE_SOURCE"
    log "Image: $ZE_IMAGE"

    if [ "$ZE_SOURCE" = "http" ]; then
        if [ -z "$ZE_SERVER" ]; then
            fatal "ze.server not set on kernel cmdline"
        fi
        if ! validate_ipv4 "$ZE_SERVER"; then
            fatal "ze.server '$ZE_SERVER' is not a valid IPv4 address"
        fi
        if ! validate_port "$ZE_PORT"; then
            fatal "ze.port '$ZE_PORT' is not a valid TCP port (1-65535)"
        fi
        ZE_BASE="http://${ZE_SERVER}:${ZE_PORT}"
        log "Server: $ZE_SERVER:$ZE_PORT"

        if ! ensure_network; then
            log "Network state at failure:"
            log_network_state
            fatal "No network connectivity; cannot proceed with HTTP install"
        fi

        if ! validate_decimal "$ZE_WAIT"; then
            fatal "ze.wait '$ZE_WAIT' is not a valid number"
        fi
        if [ "$ZE_WAIT" -gt 0 ]; then
            if ! wait_for_server "$ZE_SERVER" "$ZE_PORT" "$ZE_WAIT"; then
                fatal "Server $ZE_SERVER:$ZE_PORT not reachable after $ZE_WAIT attempts (ze.wait=$ZE_WAIT)"
            fi
        fi
    else
        iso_found=0
        iso_attempt=0
        while [ "$iso_attempt" -lt "$ISO_SCAN_MAX" ]; do
            iso_attempt=$((iso_attempt + 1))
            if find_iso_media; then
                iso_found=1
                break
            fi
            if [ "$iso_attempt" -eq 1 ]; then
                log "Direct ISO media not found, scanning FAT/exFAT partitions..."
            fi
            if try_loop_mount_iso; then
                iso_found=1
                break
            fi
            if [ "$iso_attempt" -lt "$ISO_SCAN_MAX" ]; then
                log "Waiting for ISO media (attempt $iso_attempt/$ISO_SCAN_MAX)..."
                sleep "$ISO_SCAN_DELAY"
            fi
        done
        if [ "$iso_found" = "0" ]; then
            fatal "No ze installer ISO media containing $ZE_IMAGE found after $ISO_SCAN_MAX attempts"
        fi
        log "ISO media: $ISO_SOURCE_DEV"
    fi

    find_target_disk
    if [ -n "$TARGET_DISK_ERROR" ]; then
        fatal "$TARGET_DISK_ERROR"
    fi
    if [ -z "$TARGET_DISK" ]; then
        fatal "No non-removable block device found"
    fi
    log "Target disk: $TARGET_DISK"

    if [ "$ZE_SOURCE" = "http" ]; then
        # Fetch the image checksum first (best-effort). When present it lets
        # download_to_disk reject a corrupt or truncated write before we reboot
        # onto it; when absent we fall back to transfer-success detection only.
        EXPECTED_SHA=""
        if download "${ZE_BASE}/install/image/${ZE_IMAGE}.sha256" /tmp/image.sha256.txt; then
            if ! EXPECTED_SHA="$(read_expected_sha /tmp/image.sha256.txt)"; then
                fatal "${ZE_IMAGE}.sha256 is present but does not contain a valid SHA-256"
            fi
            log "Expected image SHA-256: $EXPECTED_SHA"
        else
            log "WARNING: no ${ZE_IMAGE}.sha256 on server; skipping image checksum verification"
        fi

        log "Writing disk image..."
        if ! download_to_disk "${ZE_BASE}/install/image/${ZE_IMAGE}" "$TARGET_DISK" "$EXPECTED_SHA"; then
            fatal "Failed to download and write disk image after $RETRY_MAX attempts"
        fi
        sync
        log "Disk image written successfully"

        log "Re-reading partition table..."
        blockdev --rereadpt "$TARGET_DISK" 2>/dev/null || true
        sleep 1

        find_partition_4
        if [ ! -b "$PART4" ]; then
            fatal "Partition 4 ($PART4) not found after image write"
        fi

        log "Mounting partition 4 ($PART4)..."
        if ! mount -t ext4 "$PART4" /mnt/perm; then
            fatal "Failed to mount $PART4 as ext4"
        fi

        mkdir -p /mnt/perm/ze

        log "Downloading zefs database..."
        if ! download "${ZE_BASE}/install/database.zefs" /mnt/perm/ze/database.zefs; then
            umount /mnt/perm 2>/dev/null || true
            fatal "Failed to download database.zefs after $RETRY_MAX attempts"
        fi
        log "zefs database written to /mnt/perm/ze/database.zefs"

        umount /mnt/perm
        sync
    else
        image_path="$ISO_MOUNT/ze-install/images/$ZE_IMAGE"
        checksum_path="${image_path}.sha256"
        if [ ! -f "$checksum_path" ]; then
            fatal "ISO image checksum $ZE_IMAGE.sha256 not found"
        fi
        log "Writing disk image from ISO media..."
        if ! local_image_to_disk "$image_path" "$checksum_path" "$TARGET_DISK"; then
            umount "$ISO_MOUNT" 2>/dev/null || true
            fatal "Failed to verify and write local ISO image"
        fi
        sync
        log "Disk image written successfully"
        umount "$ISO_MOUNT" 2>/dev/null || true
        log "Installation complete. Powering off so install media can be removed safely."
        sleep 2
        poweroff -f 2>/dev/null || echo o > /proc/sysrq-trigger
        return
    fi

    log "Installation complete. Rebooting..."
    sleep 2
    reboot -f 2>/dev/null || echo b > /proc/sysrq-trigger
}

# Guard so test harnesses can source this script to exercise individual
# functions without running the installer. Production boot leaves the var
# unset, so main runs as PID 1.
if [ "${ZE_INIT_NO_MAIN:-}" != "1" ]; then
    main "$@"
fi
